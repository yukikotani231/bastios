// Secure computing (seccomp): classic BPF filters on system calls, and no_new_privs.
//
// A process (a thread has a row of its own) has a stack of filters. Each
// filter is a classic BPF program of up to SC_MAXI instructions; all of them
// share a pool of SC_POOL instructions in k.mns (from MNS_SC), in at most
// SC_N filters at once, system-wide. A new filter links to the
// process's previous top one as its parent; fork and clone give the child
// the same top, a count of holders (refs) keeps a filter while a process
// or a younger filter still points at it, and exec leaves the stack alone.
//
// Every system call a process with a filter makes first goes through
// sc_decide (called from linux_syscall): it builds a seccomp_data
// (nr, arch, instruction pointer, six arguments), runs the filters from the
// newest to the oldest, and takes the most restrictive action among them
// (kill the process, kill the thread, SIGSYS, an errno, then allow), the
// newest filter winning a tie, as Linux does.
//
// A program is checked once, when it is loaded (sc_valid), as Linux's
// seccomp_check_filter does: only the instructions seccomp allows, every
// load from seccomp_data aligned and inside its 64 bytes, scratch memory
// indexes below 16, no division by the constant 0, every jump forward and
// landing inside the program, and a return last. The interpreter (sc_run)
// does not rely on that: it checks each load, store and jump again, so what
// the prover shows is that no filter, valid or not, reads or writes outside
// seccomp_data, the scratch words and the program; a program that tries
// anyway is killed at that instruction. Jumps only go forward, so a run ends.
//
// SECCOMP_RET_USER_NOTIF: a filter loaded with SECCOMP_FILTER_FLAG_NEW_LISTENER
// has a notifier descriptor (kind OF_SECCOMP, x the filter). When that
// filter's action wins, the calling process records a notification in its
// own words (SP_ST..SP_FL) and sleeps, its call restarting on each wake. The
// supervisor's SECCOMP_IOCTL_NOTIF_RECV hands out the oldest notification
// that has not been received (it sleeps for one unless the descriptor is
// nonblocking), NOTIF_SEND answers it (an errno, a value, or CONTINUE to run
// the call after all), and NOTIF_ID_VALID says whether the caller still waits.
// Closing the descriptor ends every wait with ENOSYS.
//
// SECCOMP_RET_TRACE: a tracer that asked for PTRACE_O_TRACESECCOMP hears of
// the call in a stop before it, with SIGTRAP and PTRACE_EVENT_SECCOMP
// (pt_seccomp_stop, src/lxptrace.bastio); the call starts again when it goes
// on, and runs without the filters. Without such a tracer: -ENOSYS, as Linux
// gives.
//
// Not done: the load-time check that scratch memory is
// written before it is read (the interpreter starts every run with it
// zeroed), SECCOMP_RET_LOG (allowed, not logged), and siginfo details for
// SIGSYS (si_syscall and si_arch).

import "lxsig.bastio";
import "scfmt.bastio";
import "lxuser.bastio";

const SC_PR_SET_SECCOMP: u64 = 22;
const SC_PR_GET_SECCOMP: u64 = 21;
const SC_PR_SET_NNP: u64 = 38;
const SC_PR_GET_NNP: u64 = 39;

const SC_SET_STRICT: u64 = 0;
const SC_SET_FILTER: u64 = 1;
const SC_GET_ACTION: u64 = 2;
const SC_FLAG_TSYNC: u64 = 1;
const SC_FLAG_OK: u64 = 15;                // TSYNC, LOG, SPEC_ALLOW, NEW_LISTENER


const SCA_KILL_PROCESS: u64 = 0x80000000;
const SCA_KILL_THREAD: u64 = 0;
const SCA_TRAP: u64 = 0x00030000;
const SCA_ERRNO: u64 = 0x00050000;
const SCA_USER_NOTIF: u64 = 0x7fc00000;
const SCA_TRACE: u64 = 0x7ff00000;
const SCA_LOG: u64 = 0x7ffc0000;
const SCA_ALLOW: u64 = 0x7fff0000;

const SC_FLAG_LISTENER: u64 = 8;           // SECCOMP_FILTER_FLAG_NEW_LISTENER
const SC_IOC_RECV: u64 = 0xC0502100;       // SECCOMP_IOCTL_NOTIF_RECV
const SC_IOC_SEND: u64 = 0xC0182101;       // SECCOMP_IOCTL_NOTIF_SEND
const SC_IOC_VALID: u64 = 0x40082102;      // SECCOMP_IOCTL_NOTIF_ID_VALID
const SC_IOC_ADDFD: u64 = 0x40182103;      // SECCOMP_IOCTL_NOTIF_ADDFD
const SC_IOC_FLAGS: u64 = 0x40082104;      // SECCOMP_IOCTL_NOTIF_SET_FLAGS

// A process's notification, in its words from SP_ST: 0 none, 1 waiting to be
// received, 2 received, 3 answered; its id; the filter + 1 that issued it;
// then the answer (value, error, flags).
const SP_ST: u64 = 2;
const SPS_TRACED: u64 = 4;               // a SECCOMP_RET_TRACE call its tracer has seen: it runs when it starts again
const SP_ID: u64 = 3;
const SP_F: u64 = 4;
const SP_VAL: u64 = 5;
const SP_ERR: u64 = 6;
const SP_FL: u64 = 7;

const SCP_NNP: u64 = 1;                    // flags word: no_new_privs
const SCP_STRICT: u64 = 2;                 // flags word: SECCOMP_MODE_STRICT

/// Word i of the filter pool k.scf; 0 where there is none.
fn sc_get(k: &Kernel, i: u64) -> u64
  requires kok(k)
{
  if i < len(k.scf) {
    return get(k.scf, i);
  }
  return 0;
}

fn sc_put(k: &mut Kernel, i: u64, v: u64)
  requires kok(k)
  ensures kok(k)
{
  if i < len(k.scf) {
    k.scf = set(k.scf, i, v);
  }
}

/// Word w of the per-process words (SC_PW for each process, in k.mns).
fn sp_get(k: &Kernel, w: u64) -> u64
  requires kok(k) && w < NPROC * SC_PW
{
  return get(k.mns, MNS_SC + w);
}

fn sp_put(k: &mut Kernel, w: u64, v: u64)
  requires kok(k) && w < NPROC * SC_PW
  ensures kok(k)
{
  k.mns = set(k.mns, MNS_SC + w, v);
}

/// Process p's top filter plus one (0: it has none).
fn sc_top(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result <= SC_N
{
  return smaller(sp_get(k, p * SC_PW), SC_N);
}

fn sc_flags(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
{
  return sp_get(k, p * SC_PW + 1) % 4;
}

/// Has process p set no_new_privs?
fn sc_nnp(k: &Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
{
  return sc_flags(k, p) % 2 == 1;
}

/// Word w (below SC_HW) of filter f's header.
fn sch_get(k: &Kernel, f: u64, w: u64) -> u64
  requires kok(k) && f < SC_N && w < SC_HW
{
  return sc_get(k, f * SC_HW + w);
}

fn sch_put(k: &mut Kernel, f: u64, w: u64, v: u64)
  requires kok(k) && f < SC_N && w < SC_HW
  ensures kok(k)
{
  sc_put(&mut k, f * SC_HW + w, v);
}

/// Where instruction i of filter f is in the pool: SC_POOL for a place
/// outside it (which sc_get reads as 0, and nothing writes).
fn sc_slot(k: &Kernel, f: u64, i: u64) -> u64
  requires kok(k) && f < SC_N
  ensures result <= SC_POOL
{
  let base = smaller(sch_get(k, f, 4), SC_POOL);
  if i >= SC_POOL - base {
    return SC_POOL;
  }
  return base + i;
}

fn sc_at(k: &Kernel, f: u64, i: u64) -> u64
  requires kok(k) && f < SC_N
  ensures result < SCF_LEN
{
  return SC_INS + sc_slot(k, f, i);
}

/// The seccomp mode of process p: 0 none, 1 strict, 2 filter.
fn sc_mode(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result <= 2
{
  if sc_top(k, p) != 0 {
    return 2;
  }
  if sc_flags(k, p) / 2 == 1 {
    return 1;
  }
  return 0;
}

/// How many filters process p has.
fn sc_depth(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result <= SC_N
{
  let mut cur = sc_top(k, p);
  let mut n = 0;
  while cur != 0 && n < SC_N
    invariant cur <= SC_N && n <= SC_N && kok(k)
  {
    n = n + 1;
    cur = smaller(sch_get(k, cur - 1, 1), SC_N);
  }
  return n;
}

/// Room for a filter of n instructions: its slot, or SC_N if all slots are
/// in use or no gap in the pool is big enough. The filter is marked in use
/// with no holders and no parent.
fn sc_alloc(k: &mut Kernel, n: u64) -> u64
  requires kok(k) && n >= 1 && n <= SC_MAXI
  ensures kok(k) && result <= SC_N
{
  let mut free = SC_N;
  let mut f = 0;
  while f < SC_N
    invariant f <= SC_N && free <= SC_N && kok(k)
  {
    if free == SC_N && sch_get(k, f, 3) == 0 {
      free = f;
    }
    f = f + 1;
  }
  if free >= SC_N {
    return SC_N;
  }
  // The lowest start that does not overlap a filter in use: 0, or just
  // past one of them.
  let mut best = SC_POOL + 1;
  let mut c = 0;
  while c <= SC_N
    invariant c <= SC_N + 1 && best <= SC_POOL + 1 && free < SC_N && kok(k)
  {
    let mut s = 0;
    let mut ok = true;
    if c > 0 {
      if sch_get(k, c - 1, 3) == 1 {
        s = smaller(sch_get(k, c - 1, 4), SC_POOL) + smaller(sch_get(k, c - 1, 2), SC_MAXI);
      } else {
        ok = false;
      }
    }
    if ok && s + n <= SC_POOL && s < best {
      let mut j = 0;
      while j < SC_N
        invariant j <= SC_N && s + n <= SC_POOL && kok(k)
      {
        if sch_get(k, j, 3) == 1 {
          let b = smaller(sch_get(k, j, 4), SC_POOL);
          let e = b + smaller(sch_get(k, j, 2), SC_MAXI);
          if s < e && b < s + n {
            ok = false;
          }
        }
        j = j + 1;
      }
      if ok {
        best = s;
      }
    }
    c = c + 1;
  }
  if best > SC_POOL {
    return SC_N;
  }
  sch_put(&mut k, free, 0, 0);
  sch_put(&mut k, free, 1, 0);
  sch_put(&mut k, free, 2, n);
  sch_put(&mut k, free, 3, 1);
  sch_put(&mut k, free, 4, best);
  sch_put(&mut k, free, 5, 0);
  return free;
}

/// One more holder of filter f (plus one; 0 is none).
fn sc_hold(k: &mut Kernel, f1: u64)
  requires kok(k) && f1 <= SC_N
  ensures kok(k)
{
  if f1 != 0 {
    sch_put(&mut k, f1 - 1, 0, smaller(sch_get(k, f1 - 1, 0), 0xFFFFFF) + 1);
  }
}

/// One holder less of filter f1 - 1; a filter nobody holds goes, and so
/// lets go of its parent.
fn sc_drop(k: &mut Kernel, f1: u64)
  requires kok(k) && f1 <= SC_N
  ensures kok(k)
{
  let mut cur = f1;
  let mut i = 0;
  while cur != 0 && i < SC_N
    invariant cur <= SC_N && i <= SC_N && kok(k)
  {
    let r = sch_get(k, cur - 1, 0);
    if r > 1 {
      sch_put(&mut k, cur - 1, 0, r - 1);
      return;
    }
    let par = smaller(sch_get(k, cur - 1, 1), SC_N);
    sch_put(&mut k, cur - 1, 0, 0);
    sch_put(&mut k, cur - 1, 3, 0);
    cur = par;
    i = i + 1;
  }
}

/// A new process or thread c of p: the same filters, and no_new_privs.
fn sc_fork(k: &mut Kernel, p: u64, c: u64)
  requires kok(k) && p < NPROC && c < NPROC
  ensures kok(k)
{
  let t = sc_top(k, p);
  sp_put(&mut k, c * SC_PW, t);
  sp_put(&mut k, c * SC_PW + 1, sc_flags(k, p));
  sp_put(&mut k, c * SC_PW + SP_ST, 0);
  sc_hold(&mut k, t);
}

/// Process p is gone: its filters are let go.
fn sc_clear(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let t = sc_top(k, p);
  sp_put(&mut k, p * SC_PW, 0);
  sp_put(&mut k, p * SC_PW + 1, 0);
  sp_put(&mut k, p * SC_PW + SP_ST, 0);
  sc_drop(&mut k, t);
}

// ---------------------------------------------------------------- the interpreter

/// Word i of the scratch area: seccomp_data as 8 words, then the 16 BPF
/// memory words.
fn scr_get(k: &Kernel, i: u64) -> u64
  requires kok(k) && i < SC_SCRN
{
  return sc_get(k, SC_SCR + i);
}

fn scr_put(k: &mut Kernel, i: u64, v: u64)
  requires kok(k) && i < SC_SCRN
  ensures kok(k)
{
  sc_put(&mut k, SC_SCR + i, v);
}

/// The 32 bits at byte offset off (below 64, a multiple of 4) of seccomp_data.
fn sc_data(k: &Kernel, off: u64) -> u64
  requires kok(k) && off < 64
  ensures result <= 0xFFFFFFFF
{
  let w = scr_get(k, off / 8);
  if off % 8 == 0 {
    return w & 0xFFFFFFFF;
  }
  return w / 0x100000000;
}

/// Runs filter f on the data in the scratch area: the 32-bit value it
/// returns. A program that goes wrong is killed (SCA_KILL_PROCESS).
fn sc_run(k: &mut Kernel, f: u64) -> u64
  requires kok(k) && f < SC_N
  ensures kok(k) && result <= 0xFFFFFFFF
{
  let n = smaller(sch_get(k, f, 2), SC_MAXI);
  let mut i = 0;
  while i < 16
    invariant i <= 16 && kok(k)
  {
    scr_put(&mut k, 8 + i, 0);
    i = i + 1;
  }
  let mut pc = 0;
  let mut a = 0;
  let mut x = 0;
  let mut steps = 0;
  while pc < n && steps < SC_MAXI
    invariant pc <= n && n <= SC_MAXI && steps <= SC_MAXI && a <= 0xFFFFFFFF && x <= 0xFFFFFFFF && kok(k)
  {
    let insn = sc_get(k, sc_at(k, f, pc));
    let code = insn % 0x10000;
    let jt = insn / 0x10000 % 256;
    let jf = insn / 0x1000000 % 256;
    let kk = insn / 0x100000000;
    let cls = code % 8;
    steps = steps + 1;
    if code >= 256 {
      return SCA_KILL_PROCESS;
    }
    let mut next = pc + 1;
    if cls == 0 {
      // BPF_LD, word sized only
      let mode = code / 32 % 8;
      if code % 32 / 8 != 0 {
        return SCA_KILL_PROCESS;
      }
      if mode == 1 {
        if kk >= 64 || kk % 4 != 0 {
          return SCA_KILL_PROCESS;
        }
        a = sc_data(k, kk);
      } else if mode == 0 {
        a = kk;
      } else if mode == 3 {
        if kk >= 16 {
          return SCA_KILL_PROCESS;
        }
        a = scr_get(k, 8 + kk) & 0xFFFFFFFF;
      } else if mode == 4 {
        a = 64;
      } else {
        return SCA_KILL_PROCESS;
      }
    } else if cls == 1 {
      // BPF_LDX
      let mode = code / 32 % 8;
      if code % 32 / 8 != 0 {
        return SCA_KILL_PROCESS;
      }
      if mode == 0 {
        x = kk;
      } else if mode == 3 {
        if kk >= 16 {
          return SCA_KILL_PROCESS;
        }
        x = scr_get(k, 8 + kk) & 0xFFFFFFFF;
      } else if mode == 4 {
        x = 64;
      } else {
        return SCA_KILL_PROCESS;
      }
    } else if cls == 2 || cls == 3 {
      // BPF_ST, BPF_STX
      if kk >= 16 || code != cls {
        return SCA_KILL_PROCESS;
      }
      if cls == 2 {
        scr_put(&mut k, 8 + kk, a);
      } else {
        scr_put(&mut k, 8 + kk, x);
      }
    } else if cls == 4 {
      // BPF_ALU
      let op = code / 16;
      let mut v = kk;
      if code % 16 / 8 == 1 {
        v = x;
      }
      v = v & 0xFFFFFFFF;
      if op == 0 {
        a = (a + v) & 0xFFFFFFFF;
      } else if op == 1 {
        a = (a + 0x100000000 - v) & 0xFFFFFFFF;
      } else if op == 2 {
        a = (a * v) & 0xFFFFFFFF;
      } else if op == 3 {
        if v == 0 {
          return SCA_KILL_PROCESS;
        }
        a = (a / v) & 0xFFFFFFFF;
      } else if op == 4 {
        a = (a | v) & 0xFFFFFFFF;
      } else if op == 5 {
        a = (a & v) & 0xFFFFFFFF;
      } else if op == 6 {
        a = (a * pow2(v % 32)) & 0xFFFFFFFF;
      } else if op == 7 {
        a = (a / pow2(v % 32)) & 0xFFFFFFFF;
      } else if op == 8 {
        a = (0x100000000 - a) & 0xFFFFFFFF;
      } else if op == 9 {
        if v == 0 {
          return SCA_KILL_PROCESS;
        }
        a = (a % v) & 0xFFFFFFFF;
      } else if op == 10 {
        a = ((a | v) - (a & v)) & 0xFFFFFFFF;   // xor
      } else {
        return SCA_KILL_PROCESS;
      }
    } else if cls == 5 {
      // BPF_JMP
      let op = code / 16;
      let mut v = kk;
      if code % 16 / 8 == 1 {
        v = x;
      }
      v = v & 0xFFFFFFFF;
      if op == 0 {
        if kk >= n - pc - 1 {
          return SCA_KILL_PROCESS;
        }
        next = pc + 1 + kk;
      } else if op >= 1 && op <= 4 {
        let mut hit = false;
        if op == 1 {
          hit = a == v;
        } else if op == 2 {
          hit = a > v;
        } else if op == 3 {
          hit = a >= v;
        } else {
          hit = a & v != 0;
        }
        let mut d = jf;
        if hit {
          d = jt;
        }
        if d >= n - pc - 1 {
          return SCA_KILL_PROCESS;
        }
        next = pc + 1 + d;
      } else {
        return SCA_KILL_PROCESS;
      }
    } else if cls == 6 {
      // BPF_RET, of K or of A
      let src = code / 8 % 4;
      if src == 0 {
        return kk & 0xFFFFFFFF;
      }
      if src == 2 {
        return a;
      }
      return SCA_KILL_PROCESS;
    } else {
      // BPF_MISC: TAX and TXA
      if code == 7 {
        x = a;
      } else if code == 0x87 {
        a = x;
      } else {
        return SCA_KILL_PROCESS;
      }
    }
    pc = next;
  }
  return SCA_KILL_PROCESS;                  // ran off the end
}

/// 2^e for e below 32.
fn pow2(e: u64) -> u64
  requires e < 32
  ensures result >= 1 && result <= 0x80000000
{
  let mut r = 1;
  if e % 2 == 1 {
    r = r * 2;
  }
  if e / 2 % 2 == 1 {
    r = r * 4;
  }
  if e / 4 % 2 == 1 {
    r = r * 16;
  }
  if e / 8 % 2 == 1 {
    r = r * 256;
  }
  if e / 16 % 2 == 1 {
    r = r * 65536;
  }
  return r;
}

/// How restrictive an action is: lower is more.
fn sc_key(r: u64) -> u64
  requires r <= 0xFFFFFFFF
  ensures result < 0x10000
{
  return (r / 0x10000 + 0x8000) % 0x10000;
}

/// The action the filters of process pid take for system call nr, with the
/// registers it made it with.
fn sc_action(k: &mut Kernel, pid: u64, nr: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k) && result <= 0xFFFFFFFF
{
  scr_put(&mut k, 0, sc_number(k, pid, nr) + SC_ARCH * 0x100000000);
  scr_put(&mut k, 1, pget(k.procs, pid, F_REGS + R_RIP));
  scr_put(&mut k, 2, pget(k.procs, pid, F_REGS + R_RDI));
  scr_put(&mut k, 3, pget(k.procs, pid, F_REGS + R_RSI));
  scr_put(&mut k, 4, pget(k.procs, pid, F_REGS + R_RDX));
  scr_put(&mut k, 5, pget(k.procs, pid, F_REGS + R_R10));
  scr_put(&mut k, 6, pget(k.procs, pid, F_REGS + R_R8));
  scr_put(&mut k, 7, pget(k.procs, pid, F_REGS + R_R9));
  let mut best = SCA_ALLOW;
  let mut cur = sc_top(k, pid);
  let mut i = 0;
  while cur != 0 && i < SC_N
    invariant cur <= SC_N && i <= SC_N && best <= 0xFFFFFFFF && kok(k)
  {
    let r = sc_run(&mut k, cur - 1);
    if sc_key(r) < sc_key(best) {
      best = r;
      sp_put(&mut k, pid * SC_PW + SP_F, cur);   // for a notification: the filter that decided
    }
    cur = smaller(sch_get(k, cur - 1, 1), SC_N);
    i = i + 1;
  }
  return best;
}

/// What the system call nr that process pid just made comes to: 0 to go
/// ahead, or the result to give instead (an errno, or ENOSYS after a
/// signal), with `kill` set when the process dies of SIGSYS (or SIGKILL,
/// in strict mode).
struct ScVerdict { run: bool, ret: u64, wait: bool, stop: bool }

fn sc_decide(k: &mut Kernel, pid: u64, nr: u64) -> ScVerdict
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let go = ScVerdict { run: true, ret: 0, wait: false, stop: false };
  if sp_get(k, pid * SC_PW + SP_ST) == SPS_TRACED {
    sp_put(&mut k, pid * SC_PW + SP_ST, 0);   // its tracer saw the call at the stop: it runs, and is not filtered again
    return go;
  }
  if sp_get(k, pid * SC_PW + SP_ST) != 0 {
    return sc_pending(&mut k, pid);
  }
  if sc_top(k, pid) == 0 {
    // Strict mode: read, write, exit and rt_sigreturn only.
    if sc_flags(k, pid) / 2 == 1 && nr != 0 && nr != 1 && nr != 60 && nr != 15 {
      sc_force(&mut k, pid, 9);
      return ScVerdict { run: false, ret: ENOSYS, wait: false, stop: false };
    }
    return go;
  }
  let act = sc_action(&mut k, pid, nr);
  let hi = act / 0x10000;
  if hi == SCA_ALLOW / 0x10000 || hi == SCA_LOG / 0x10000 {
    return go;
  }
  if hi == SCA_ERRNO / 0x10000 {
    return ScVerdict { run: false, ret: wrap_sub(0, smaller(act % 0x10000, 4095)), wait: false, stop: false };
  }
  if hi == SCA_TRAP / 0x10000 {
    post_sig(&mut k, pid, 31);
    return ScVerdict { run: false, ret: ENOSYS, wait: false, stop: false };
  }
  if hi == SCA_USER_NOTIF / 0x10000 {
    let f1 = smaller(sp_get(k, pid * SC_PW + SP_F), SC_N);
    if f1 == 0 || sch_get(k, f1 - 1, 5) != 1 {
      return ScVerdict { run: false, ret: ENOSYS, wait: false, stop: false };   // no supervisor
    }
    sp_put(&mut k, pid * SC_PW + SP_ID, (k.ns % 0x3FFFFFFFFFFFFF) * 256 + pid);
    sp_put(&mut k, pid * SC_PW + SP_ST, 1);
    sleepers_wake(&mut k);                    // a supervisor waiting in NOTIF_RECV
    return ScVerdict { run: false, ret: 0, wait: true, stop: false };
  }
  if hi == SCA_TRACE / 0x10000 {
    if pt_wants_seccomp(k, pid) {
      pt_seccomp_stop(&mut k, pid, act % 0x10000);
      sp_put(&mut k, pid * SC_PW + SP_ST, SPS_TRACED);
      return ScVerdict { run: false, ret: 0, wait: false, stop: true };
    }
    return ScVerdict { run: false, ret: ENOSYS, wait: false, stop: false };   // no tracer
  }
  sc_force(&mut k, pid, 31);                         // kill, whatever the action's thread or process
  return ScVerdict { run: false, ret: ENOSYS, wait: false, stop: false };
}

/// A process that has a notification pending (state 1 or 2) tries its call
/// again: still waiting, or answered, or its supervisor is gone.
fn sc_pending(k: &mut Kernel, pid: u64) -> ScVerdict
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let at = pid * SC_PW;
  let st = sp_get(k, at + SP_ST);
  let f1 = smaller(sp_get(k, at + SP_F), SC_N);
  if f1 == 0 || sch_get(k, f1 - 1, 5) != 1 {
    sp_put(&mut k, at + SP_ST, 0);
    return ScVerdict { run: false, ret: ENOSYS, wait: false, stop: false };
  }
  if st != 3 {
    return ScVerdict { run: false, ret: 0, wait: true, stop: false };
  }
  sp_put(&mut k, at + SP_ST, 0);
  if sp_get(k, at + SP_FL) % 2 == 1 {
    // CONTINUE: the call runs, and is not filtered again.
    return ScVerdict { run: true, ret: 0, wait: false, stop: false };
  }
  let e = sp_get(k, at + SP_ERR) % 0x100000000;
  if e != 0 {
    if e >= 0x80000000 {
      return ScVerdict { run: false, ret: wrap_sub(0, 0x100000000 - e), wait: false, stop: false };
    }
    return ScVerdict { run: false, ret: wrap_sub(0, e), wait: false, stop: false };
  }
  return ScVerdict { run: false, ret: sp_get(k, at + SP_VAL), wait: false, stop: false };
}

/// The process (not yet freed) whose notification in state st was issued by
/// filter f, starting the search at process from: NPROC if none.
fn sc_find(k: &Kernel, f: u64, st: u64, from: u64) -> u64
  requires kok(k) && f < SC_N && from <= NPROC
  ensures result <= NPROC
{
  let mut q = from;
  while q < NPROC
    invariant q <= NPROC && kok(k)
  {
    if q >= 1 && state(k.procs, q) != FREE && state(k.procs, q) != ZOMBIE && sp_get(k, q * SC_PW + SP_ST) == st && sp_get(k, q * SC_PW + SP_F) == f + 1 {
      return q;
    }
    q = q + 1;
  }
  return NPROC;
}

/// The notifier of filter f is closed: whoever waits on it gets ENOSYS.
fn sc_listener_closed(k: &mut Kernel, f: u64)
  requires kok(k) && f < SC_N
  ensures kok(k)
{
  sch_put(&mut k, f, 5, 0);
  sc_drop(&mut k, f + 1);
  sleepers_wake(&mut k);
}

/// poll bits of the notifier of filter f: POLLIN while a notification waits
/// to be received, POLLOUT while one has been received and not answered.
fn sc_bits(k: &Kernel, f: u64) -> u64
  requires kok(k) && f < SC_N
{
  let mut r = 0;
  if sc_find(k, f, 1, 0) < NPROC {
    r = POLLIN;
  }
  if sc_find(k, f, 2, 0) < NPROC {
    r = r + POLLOUT;
  }
  return r;
}

/// ioctl on a notifier: NOTIF_RECV, NOTIF_SEND and NOTIF_ID_VALID.
fn sc_ioctl(k: &mut Kernel, pid: u64, f: u64, nonblock: bool, req: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC && f < SC_N
  ensures kok(k)
{
  if req == SC_IOC_RECV {
    // The buffer must be zero, as Linux requires.
    if arg == 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, &mut k.fs.xfer, 80) != 80 {
      return EFAULT;
    }
    let mut j = 0;
    while j < 10
      invariant j <= 10 && kok(k)
    {
      if get_u64(k.fs.xfer, j * 8) != 0 {
        return EINVAL;
      }
      j = j + 1;
    }
    let q = sc_find(k, f, 1, 1);
    if q >= NPROC {
      if nonblock {
        return EAGAIN;
      }
      return SC_WAIT;
    }
    xfer_u64(&mut k.fs.xfer, 0, sp_get(k, q * SC_PW + SP_ID));
    xfer_u64(&mut k.fs.xfer, 8, vpid_of(k, pid, q) % 0x100000000);   // pid, then flags 0
    xfer_u64(&mut k.fs.xfer, 16, sc_number(k, q, pget(k.procs, q, F_REGS + R_LXNR) % 0x100000000) + SC_ARCH * 0x100000000);
    xfer_u64(&mut k.fs.xfer, 24, wrap_add(pget(k.procs, q, F_REGS + R_RIP), SYSCALL_LEN));   // the call restarts: rip is back on the syscall
    xfer_u64(&mut k.fs.xfer, 32, pget(k.procs, q, F_REGS + R_RDI));
    xfer_u64(&mut k.fs.xfer, 40, pget(k.procs, q, F_REGS + R_RSI));
    xfer_u64(&mut k.fs.xfer, 48, pget(k.procs, q, F_REGS + R_RDX));
    xfer_u64(&mut k.fs.xfer, 56, pget(k.procs, q, F_REGS + R_R10));
    xfer_u64(&mut k.fs.xfer, 64, pget(k.procs, q, F_REGS + R_R8));
    xfer_u64(&mut k.fs.xfer, 72, pget(k.procs, q, F_REGS + R_R9));
    if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, k.fs.xfer, 80) != 80 {
      return EFAULT;
    }
    sp_put(&mut k, q * SC_PW + SP_ST, 2);
    return 0;
  }
  if req == SC_IOC_SEND {
    if arg == 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, &mut k.fs.xfer, 24) != 24 {
      return EFAULT;
    }
    let id = get_u64(k.fs.xfer, 0);
    let val = get_u64(k.fs.xfer, 8);
    let err = get_u64(k.fs.xfer, 16) % 0x100000000;
    let fl = get_u64(k.fs.xfer, 16) / 0x100000000;
    if fl > 1 || (fl == 1 && (val != 0 || err != 0)) || (err != 0 && val != 0) {
      return EINVAL;
    }
    let mut q = sc_find(k, f, 2, 1);
    while q < NPROC && sp_get(k, q * SC_PW + SP_ID) != id
      invariant q <= NPROC && kok(k)
    {
      q = sc_find(k, f, 2, q + 1);
    }
    if q >= NPROC {
      return ENOENT;
    }
    sp_put(&mut k, q * SC_PW + SP_VAL, val);
    sp_put(&mut k, q * SC_PW + SP_ERR, err);
    sp_put(&mut k, q * SC_PW + SP_FL, fl);
    sp_put(&mut k, q * SC_PW + SP_ST, 3);
    sleepers_wake(&mut k);
    return 0;
  }
  if req == SC_IOC_VALID {
    if arg == 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, &mut k.fs.xfer, 8) != 8 {
      return EFAULT;
    }
    let id = get_u64(k.fs.xfer, 0);
    let mut q = sc_find(k, f, 2, 1);
    while q < NPROC && sp_get(k, q * SC_PW + SP_ID) != id
      invariant q <= NPROC && kok(k)
    {
      q = sc_find(k, f, 2, q + 1);
    }
    if q >= NPROC {
      return ENOENT;
    }
    return 0;
  }
  if req == SC_IOC_ADDFD {
    // struct seccomp_notif_addfd { id: u64, flags: u32, srcfd: u32, newfd: u32, newfd_flags: u32 }
    if arg == 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, &mut k.fs.xfer, 24) != 24 {
      return EFAULT;
    }
    let id = get_u64(k.fs.xfer, 0);
    let fl = get_u64(k.fs.xfer, 8) % 0x100000000;
    let srcfd = get_u64(k.fs.xfer, 8) / 0x100000000;
    let newfd = get_u64(k.fs.xfer, 16) % 0x100000000;
    let nfl = get_u64(k.fs.xfer, 16) / 0x100000000;
    // SETFD = 1 (install at newfd), SEND = 2 (also answer the call with the new descriptor).
    if fl > 3 || (nfl != 0 && nfl != 0x80000) || (fl % 2 == 0 && newfd != 0) {
      return EINVAL;
    }
    let mut q = sc_find(k, f, 2, 1);
    while q < NPROC && sp_get(k, q * SC_PW + SP_ID) != id
      invariant q <= NPROC && kok(k)
    {
      q = sc_find(k, f, 2, q + 1);
    }
    if q >= NPROC {
      return ENOENT;
    }
    let v = fd_get(k.lxfd, pid, srcfd) % FD_CLOEXEC;
    if v == 0 {
      return EBADF;
    }
    let mut fd = newfd;
    if fl % 2 == 1 {
      if newfd >= fd_limit(k, q) {
        return EBADF;
      }
      lx_fd_close(&mut k, q, newfd);
    } else {
      fd = fd_free(k, q, 0);
      if fd >= LXNFD {
        return EMFILE;
      }
    }
    ref_value(&mut k, v);
    if nfl != 0 {
      fd_set_k(&mut k, q, fd, v + FD_CLOEXEC);
    } else {
      fd_set_k(&mut k, q, fd, v);
    }
    if fl / 2 == 1 {
      sp_put(&mut k, q * SC_PW + SP_VAL, fd);
      sp_put(&mut k, q * SC_PW + SP_ERR, 0);
      sp_put(&mut k, q * SC_PW + SP_FL, 0);
      sp_put(&mut k, q * SC_PW + SP_ST, 3);
      sleepers_wake(&mut k);
    }
    return fd;
  }
  if req == SC_IOC_FLAGS {
    // Only SECCOMP_USER_NOTIF_FD_SYNC_WAKE_UP exists; wake-ups here are never deferred, so it only validates.
    if arg == 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, &mut k.fs.xfer, 8) != 8 {
      return EFAULT;
    }
    if get_u64(k.fs.xfer, 0) > 1 {
      return EINVAL;
    }
    return 0;
  }
  return ENOTTY;
}

/// Makes signal s fatal to process p: its handler goes back to the default
/// and it is no longer blocked.
fn sc_force(k: &mut Kernel, p: u64, s: u64)
  requires kok(k) && 1 <= p && p < NPROC && 1 <= s && s <= NSIG
  ensures kok(k)
{
  sa_set(&mut k.sigact, p, s, 0, SIG_DFL);
  pset(&mut k.procs, p, F_SIGMASK, pget(k.procs, p, F_SIGMASK) & !sbit(s));
  post_sig(&mut k, p, s);
}

// ---------------------------------------------------------------- loading

/// Is the program of n instructions in slot f one seccomp accepts?
fn sc_valid(k: &Kernel, f: u64, n: u64) -> bool
  requires kok(k) && f < SC_N && n <= SC_MAXI
{
  if n == 0 {
    return false;
  }
  let mut pc = 0;
  while pc < n
    invariant pc <= n && n <= SC_MAXI && kok(k)
  {
    let insn = sc_get(k, sc_at(k, f, pc));
    let code = insn % 0x10000;
    let jt = insn / 0x10000 % 256;
    let jf = insn / 0x1000000 % 256;
    let kk = insn / 0x100000000;
    let cls = code % 8;
    let last = pc + 1 == n;
    if code >= 256 {
      return false;
    }
    if cls == 0 {
      let mode = code / 32 % 8;
      if code % 32 / 8 != 0 {
        return false;                       // word sized loads only
      }
      if mode == 1 {
        if kk >= 64 || kk % 4 != 0 {
          return false;                     // inside seccomp_data, aligned
        }
      } else if mode == 3 {
        if kk >= 16 {
          return false;
        }
      } else if mode != 0 && mode != 4 {
        return false;
      }
    } else if cls == 1 {
      let mode = code / 32 % 8;
      if code % 32 / 8 != 0 {
        return false;
      }
      if mode == 3 {
        if kk >= 16 {
          return false;
        }
      } else if mode != 0 && mode != 4 {
        return false;
      }
    } else if cls == 2 || cls == 3 {
      if kk >= 16 || code != cls {
        return false;
      }
    } else if cls == 4 {
      let op = code / 16;
      let src = code % 16 / 8;
      if op > 10 {
        return false;
      }
      if (op == 3 || op == 9) && src == 0 && kk == 0 {
        return false;                       // division by the constant 0
      }
      if (op == 6 || op == 7) && src == 0 && kk >= 32 {
        return false;
      }
      if op == 8 && src != 0 {
        return false;
      }
    } else if cls == 5 {
      let op = code / 16;
      if last {
        return false;
      }
      if op == 0 {
        if code != 5 || kk >= n - pc - 1 {
          return false;
        }
      } else if op >= 1 && op <= 4 {
        if jt >= n - pc - 1 || jf >= n - pc - 1 {
          return false;
        }
      } else {
        return false;
      }
    } else if cls == 6 {
      let src = code / 8 % 4;
      if code % 8 != 6 || (src != 0 && src != 2) || code / 32 != 0 {
        return false;
      }
    } else {
      if code != 7 && code != 0x87 {
        return false;
      }
    }
    if last && cls != 6 {
      return false;                         // it must end in a return
    }
    pc = pc + 1;
  }
  return true;
}

/// Is filter a (plus one; 0 is none) the one b (plus one) is, or an
/// ancestor of it?
fn sc_ancestor(k: &Kernel, a: u64, b: u64) -> bool
  requires kok(k) && a <= SC_N && b <= SC_N
{
  if a == 0 {
    return true;
  }
  let mut cur = b;
  let mut i = 0;
  while cur != 0 && i <= SC_N
    invariant cur <= SC_N && i <= SC_N + 1 && kok(k)
  {
    if cur == a {
      return true;
    }
    cur = smaller(sch_get(k, cur - 1, 1), SC_N);
    i = i + 1;
  }
  return false;
}

/// May process pid install a filter: it has set no_new_privs, or is
/// privileged in its user namespace.
fn sc_may(k: &Kernel, pid: u64) -> bool
  requires kok(k) && pid < NPROC
{
  return sc_nnp(k, pid) || ns_cap(k, pid, CAP_SYS_ADMIN);
}

/// Reads the instructions of the sock_fprog at user address uprog into slot
/// f, checks them, and links the filter on top of pid's: 0 or -errno.
fn sc_load(k: &mut Kernel, pid: u64, uprog: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if uprog == 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, uprog, &mut k.fs.xfer, 16) != 16 {
    return EFAULT;
  }
  let n = get_u64(k.fs.xfer, 0) % 0x10000;
  let ptr = get_u64(k.fs.xfer, 8);
  if n == 0 || n > SC_MAXI {
    return EINVAL;
  }
  if len(k.scf) == 0 {
    free(k.scf);
    k.scf = try_alloc(SCF_LEN);             // the first filter ever: the pool
    if len(k.scf) == 0 {
      return ENOMEM;
    }
  }
  let f = sc_alloc(&mut k, n);
  if f >= SC_N {
    return ENOMEM;
  }
  let mut done = 0;
  while done < n
    invariant done <= n && n <= SC_MAXI && f < SC_N && kok(k)
  {
    let chunk = smaller(n - done, 256);
    if ptr > 0xFFFFFFFFFFFF0000 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, ptr + done * 8, &mut k.fs.xfer, chunk * 8) != chunk * 8 {
      sc_drop(&mut k, f + 1);
      return EFAULT;
    }
    let mut j = 0;
    while j < chunk
      invariant j <= chunk && chunk <= 256 && done + chunk <= n && n <= SC_MAXI && f < SC_N && kok(k)
    {
      sc_put(&mut k, sc_at(k, f, done + j), get_u64(k.fs.xfer, j * 8));
      j = j + 1;
    }
    done = done + chunk;
  }
  if !sc_valid(k, f, n) {
    sc_drop(&mut k, f + 1);
    return EINVAL;
  }
  sch_put(&mut k, f, 0, 1);
  let mut lfd = 0;
  if flags & SC_FLAG_LISTENER != 0 {
    if flags & SC_FLAG_TSYNC != 0 {
      sc_drop(&mut k, f + 1);
      return EINVAL;
    }
    // One notifier on a stack of filters: none of the older ones has one.
    let mut cur = sc_top(k, pid);
    let mut i = 0;
    while cur != 0 && i < SC_N
      invariant cur <= SC_N && i <= SC_N && f < SC_N && kok(k)
    {
      if sch_get(k, cur - 1, 5) == 1 {
        sc_drop(&mut k, f + 1);
        return EBUSY;
      }
      cur = smaller(sch_get(k, cur - 1, 1), SC_N);
      i = i + 1;
    }
    lfd = ev_install(&mut k, pid, OF_SECCOMP, f, 0, true);
    if lfd >= LXNFD {
      sc_drop(&mut k, f + 1);
      return lfd;
    }
    sch_put(&mut k, f, 5, 1);
    sc_hold(&mut k, f + 1);                 // the descriptor keeps the filter
  }
  if flags & SC_FLAG_TSYNC == 0 {
    sch_put(&mut k, f, 1, sc_top(k, pid));
    sp_put(&mut k, pid * SC_PW, f + 1);
    return lfd;
  }
  // TSYNC: every thread of the group takes the new filter, when each one's
  // own are among the caller's; else the first that is not is the result.
  let g = tgid(k.procs, pid);
  let mine = sc_top(k, pid);
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if q != pid && state(k.procs, q) != FREE && state(k.procs, q) != ZOMBIE && tgid(k.procs, q) == g && !sc_ancestor(k, sc_top(k, q), mine) {
      sc_drop(&mut k, f + 1);
      return vpid_of(k, pid, q);
    }
    q = q + 1;
  }
  sch_put(&mut k, f, 1, mine);
  sp_put(&mut k, pid * SC_PW, f + 1);
  q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && f < SC_N && kok(k)
  {
    if q != pid && state(k.procs, q) != FREE && state(k.procs, q) != ZOMBIE && tgid(k.procs, q) == g {
      let prev = sc_top(k, q);
      sc_hold(&mut k, f + 1);
      sp_put(&mut k, q * SC_PW, f + 1);
      sc_drop(&mut k, prev);
    }
    q = q + 1;
  }
  return 0;
}

/// seccomp(op, flags, args), and the filter part of prctl(PR_SET_SECCOMP).
fn lx_seccomp(k: &mut Kernel, pid: u64, op: u64, flags: u64, uarg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if op == SC_SET_FILTER {
    if flags % 0x100000000 > SC_FLAG_OK {
      return EINVAL;
    }
    if !sc_may(k, pid) {
      // Linux reads the program header first, so a bad pointer is EFAULT
      // and a bad length EINVAL before the lack of rights is EACCES.
      if uarg == 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, uarg, &mut k.fs.xfer, 16) != 16 {
        return EFAULT;
      }
      let cnt = get_u64(k.fs.xfer, 0) % 0x10000;
      if cnt == 0 || cnt > SC_MAXI {
        return EINVAL;
      }
      return EACCES;
    }
    if sc_flags(k, pid) / 2 == 1 {
      return EINVAL;                        // strict mode takes no filters
    }
    return sc_load(&mut k, pid, uarg, flags % 0x100000000);
  }
  if op == SC_SET_STRICT {
    if flags != 0 || uarg != 0 || sc_top(k, pid) != 0 {
      return EINVAL;
    }
    sp_put(&mut k, pid * SC_PW + 1, sc_flags(k, pid) % 2 + 2);
    return 0;
  }
  if op == SC_GET_ACTION {
    if flags != 0 {
      return EINVAL;
    }
    if uarg == 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, uarg, &mut k.fs.xfer, 4) != 4 {
      return EFAULT;
    }
    let a = get_u64(k.fs.xfer, 0) % 0x100000000;
    let hi = a / 0x10000;
    if a == SCA_KILL_PROCESS || a == SCA_KILL_THREAD || a == SCA_TRAP || a == SCA_ALLOW || a == SCA_LOG || hi == SCA_ERRNO / 0x10000 {
      return 0;
    }
    return EOPNOTSUPP;
  }
  return EINVAL;
}

/// prctl and seccomp, which share one branch of the system call switch.
fn lx_prctl_seccomp(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_SECCOMP {
    return lx_seccomp(&mut k, pid, a, b, c);
  }
  return lx_prctl(&mut k, pid, a, b, c);
}

/// prctl(op, a, b) for the seccomp operations: the result, or NO_RESULT for
/// another operation.
fn sc_prctl(k: &mut Kernel, pid: u64, op: u64, a: u64, b: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if op == SC_PR_SET_NNP {
    if a != 1 || b != 0 {
      return EINVAL;
    }
    sp_put(&mut k, pid * SC_PW + 1, sc_flags(k, pid) / 2 * 2 + 1);
    return 0;
  }
  if op == SC_PR_GET_NNP {
    if a != 0 || b != 0 {
      return EINVAL;                        // the unused arguments must be 0, as on Linux
    }
    if sc_nnp(k, pid) {
      return 1;
    }
    return 0;
  }
  if op == SC_PR_GET_SECCOMP {
    return sc_mode(k, pid);
  }
  if op == SC_PR_SET_SECCOMP {
    if a == 1 {
      return lx_seccomp(&mut k, pid, SC_SET_STRICT, 0, 0);
    }
    if a == 2 {
      return lx_seccomp(&mut k, pid, SC_SET_FILTER, 0, b);
    }
    return EINVAL;
  }
  return NO_RESULT;
}
