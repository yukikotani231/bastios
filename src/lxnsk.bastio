// UTS and IPC namespaces, the /proc/PID/ns links, and setns.
//
// Besides its mount namespace (src/lxns.bastio), a process has a UTS, an
// IPC and a PID namespace, each a number kept in k.mns (MNS_KID, 0 the
// first namespace, which every process starts in). Numbers are never
// given twice, so a namespace no process is in any more is gone for good;
// a descriptor of /proc/PID/ns/* does not keep it alive, as it does on
// Linux, and setns to a namespace that is gone is -EINVAL.
//
//   UTS  the host and domain names. The first namespace's are in k.sys
//        (src/lxsys.bastio); each other one has a slot of UTS_W words in
//        k.mns, freed when no process is in it (UTS_N at once).
//   IPC  System V queues, semaphore sets and shared memory segments carry
//        the namespace they were made in (H_NS, src/lxipc.bastio), and so
//        do POSIX queues (MNS_PQ, src/lxmq.bastio); keys, ids and names
//        are looked up only among the caller's. When the last process of
//        a namespace has ended, its objects go the next time one of the
//        same kind is made.
//   PID  a process in a new one (clone or unshare with CLONE_NEWPID) has
//        an id there from a counter of its own, and sees only the processes
//        of its namespace, by those ids (see the PID section below); the
//        first namespace is everything made outside one, and sees every
//        process by its row.
//
// /proc/PID/ns/ holds a link per kind (cgroup, ipc, mnt, net, pid,
// pid_for_children, time, time_for_children, user, uts) whose target is "KIND:[INODE]", with
// Linux's inode numbers for the first namespaces and a distinct one for
// every other (ns_inode). Opening a link gives a descriptor that remembers
// the namespace (word 3 of its open file description, + 1); stat and
// fstat on it show the inode, as on nsfs, and setns joins it. setns also
// takes a pidfd and a mask of CLONE_NEW* flags, joining the process's
// namespaces of those kinds. The user link shows the first namespace;
// setns to it is accepted when it changes nothing. A network namespace is joined by its slot number (the
// stack reuses a slot once its namespace has ended, so a descriptor kept
// across that could name another namespace).

import "lxns.bastio";

const LX_SETNS: u64 = 308;

// The links of /proc/PID/ns/, in the order getdents lists them.
const NF_CGROUP: u64 = 0;
const NF_IPC: u64 = 1;
const NF_MNT: u64 = 2;
const NF_NET: u64 = 3;
const NF_PID: u64 = 4;
const NF_PIDC: u64 = 5;                    // pid_for_children
const NF_USER: u64 = 6;
const NF_UTS: u64 = 7;
const NF_TIME: u64 = 8;
const NF_TIMEC: u64 = 9;                   // time_for_children
const NS_INO0: u64 = 4026531835;           // the first cgroup namespace's inode (PROC_CGROUP_INIT_INO)
const NSK_INO: u64 = 4026532000;            // other namespaces' inodes start here
const S_IFREG_NS: u64 = 0x8124;            // what stat says an nsfs file is: r--r--r--

// ---------------------------------------------------------------- ids

fn nsk_at(kind: u64, pid: u64) -> u64
  requires kind < NSK_N && pid < NPROC
  ensures result < MNS_LEN
{
  return MNS_KID + kind * NPROC + pid;
}

/// The namespace of kind `kind` (NSK_*) process pid is in.
fn nsk_of(k: &Kernel, kind: u64, pid: u64) -> u64
  requires kok(k) && kind < NSK_N && pid < NPROC
  ensures result < MNS_MAX
{
  return smaller(get(k.mns, nsk_at(kind, pid)), MNS_MAX - 1);
}

fn nsk_set(k: &mut Kernel, kind: u64, pid: u64, id: u64)
  requires kok(k) && kind < NSK_N && pid < NPROC
  ensures kok(k)
{
  k.mns = set(k.mns, nsk_at(kind, pid), id);
}

/// A process the kernel starts is in the first namespaces.
fn nsk_reset(t: &mut Buf, pid: u64)
  requires len(t) == MNS_LEN && pid < NPROC
  ensures len(t) == old(len(t))
{
  let mut i = 0;
  while i < NSK_N
    invariant i <= NSK_N && len(t) == MNS_LEN && pid < NPROC
  {
    t = set(t, nsk_at(i, pid), 0);
    i = i + 1;
  }
}

/// A child starts in its parent's namespaces.
fn nsk_fork(t: &mut Buf, pid: u64, c: u64)
  requires len(t) == MNS_LEN && pid < NPROC && c < NPROC
  ensures len(t) == old(len(t))
{
  let mut i = 0;
  while i < NSK_N
    invariant i <= NSK_N && len(t) == MNS_LEN && pid < NPROC && c < NPROC
  {
    t = set(t, nsk_at(i, c), get(t, nsk_at(i, pid)));
    i = i + 1;
  }
  t = set(t, nsk_at(NSK_TIME, c), get(t, nsk_at(NSK_TIMEC, pid)));   // the child is in the namespace its parent made for children
}

/// execve from a thread: the thread takes over the leader's slot h.
fn nsk_swap(t: &mut Buf, h: u64, p: u64)
  requires len(t) == MNS_LEN && h < NPROC && p < NPROC
  ensures len(t) == old(len(t))
{
  let mut i = 0;
  while i < NSK_N
    invariant i <= NSK_N && len(t) == MNS_LEN && h < NPROC && p < NPROC
  {
    let a = get(t, nsk_at(i, h));
    t = set(t, nsk_at(i, h), get(t, nsk_at(i, p)));
    t = set(t, nsk_at(i, p), a);
    i = i + 1;
  }
}

/// Is a process (not a zombie) in namespace id of kind `kind`?
fn nsk_live(k: &Kernel, kind: u64, id: u64) -> bool
  requires kok(k) && kind < NSK_N
{
  if id == 0 {
    return true;
  }
  let mut q = 0;
  while q < NPROC
    invariant q <= NPROC && kok(k) && kind < NSK_N
  {
    let s = pget(k.procs, q, F_STATE);
    if s != FREE && s != ZOMBIE && get(k.mns, nsk_at(kind, q)) == id {
      return true;
    }
    q = q + 1;
  }
  return false;
}

/// A new namespace number of kind `kind`, or 0 if they ran out.
fn nsk_new(k: &mut Kernel, kind: u64) -> u64
  requires kok(k) && kind < NSK_N
  ensures kok(k) && result < MNS_MAX
{
  let n = get(k.mns, MNS_KNEXT + kind);
  if n >= MNS_MAX - 2 {
    return 0;                               // never, at one a microsecond for decades
  }
  k.mns = set(k.mns, MNS_KNEXT + kind, n + 1);
  return n + 1;
}

// ---------------------------------------------------------------- UTS

/// The k.mns slot of UTS namespace id, or UTS_N (the first namespace, or
/// one without a slot).
fn uts_slot(k: &Kernel, id: u64) -> u64
  requires kok(k) && id < MNS_MAX
  ensures result <= UTS_N
{
  if id == 0 {
    return UTS_N;
  }
  let mut s = 0;
  while s < UTS_N
    invariant s <= UTS_N && kok(k)
  {
    if get(k.mns, MNS_UTS + s * UTS_W) == id + 1 {
      return s;
    }
    s = s + 1;
  }
  return UTS_N;
}

/// The slot of pid's UTS namespace, or UTS_N for the first one.
fn uts_slot_of(k: &Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures result <= UTS_N
{
  return uts_slot(k, nsk_of(k, NSK_UTS, pid));
}

/// Frees the slots of UTS namespaces no process is in; returns a free
/// slot, or UTS_N if there is none.
fn uts_gc(k: &mut Kernel) -> u64
  requires kok(k)
  ensures kok(k) && result <= UTS_N
{
  let mut free = UTS_N;
  let mut s = 0;
  while s < UTS_N
    invariant s <= UTS_N && free <= UTS_N && kok(k)
  {
    let v = get(k.mns, MNS_UTS + s * UTS_W);
    if v != 0 && !nsk_live(k, NSK_UTS, v - 1) {
      k.mns = set(k.mns, MNS_UTS + s * UTS_W, 0);
    }
    if get(k.mns, MNS_UTS + s * UTS_W) == 0 && free == UTS_N {
      free = s;
    }
    s = s + 1;
  }
  return free;
}

/// Process pid moves to a new UTS namespace, with a copy of the names it
/// saw. 0, or -ENOMEM if every slot is taken.
fn uts_unshare(k: &mut Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let s = uts_gc(&mut k);
  if s >= UTS_N {
    return ENOMEM;
  }
  let id = nsk_new(&mut k, NSK_UTS);
  if id == 0 {
    return ENOMEM;
  }
  let mut w = 0;
  while w < UTS_W - 1
    invariant w <= UTS_W - 1 && s < UTS_N && pid < NPROC && kok(k)
  {
    k.mns = set(k.mns, MNS_UTS + s * UTS_W + 1 + w, uts_rd(k, pid, w));
    w = w + 1;
  }
  k.mns = set(k.mns, MNS_UTS + s * UTS_W, id + 1);
  nsk_set(&mut k, NSK_UTS, pid, id);
  return 0;
}

/// Is there a UTS slot for a new namespace?
fn uts_room(k: &mut Kernel) -> bool
  requires kok(k)
  ensures kok(k)
{
  return uts_gc(&mut k) < UTS_N;
}

/// Process pid moves to a new IPC namespace, empty. 0 or -ENOMEM.
fn ipc_unshare(k: &mut Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let id = nsk_new(&mut k, NSK_IPC);
  if id == 0 {
    return ENOMEM;
  }
  nsk_set(&mut k, NSK_IPC, pid, id);
  return 0;
}

/// unshare or clone's namespaces other than the mount one (flags holds
/// only CLONE_NEWUTS and CLONE_NEWIPC here) for process pid. The caller
/// checked uts_room for a new UTS namespace.
fn nsk_unshare(k: &mut Kernel, pid: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & CLONE_NEWUSER != 0 {
    let e = userns_unshare(&mut k, pid);    // first: the rest are made as a member of it (src/lxuser.bastio)
    if e != 0 {
      return e;
    }
  }
  if flags & CLONE_NEWUTS != 0 {
    let e = uts_unshare(&mut k, pid);
    if e != 0 {
      return e;
    }
  }
  if flags & CLONE_NEWIPC != 0 {
    let e = ipc_unshare(&mut k, pid);
    if e != 0 {
      return e;
    }
  }
  if flags & CLONE_NEWCGROUP != 0 {
    cgns_unshare(&mut k, pid);              // src/lxcgroup.bastio
  }
  if flags & CLONE_NEWTIME != 0 {
    let e = tm_unshare(&mut k, pid);
    if e != 0 {
      return e;
    }
  }
  if flags & CLONE_NEWPID != 0 {
    return pidns_unshare(&mut k, pid);
  }
  return 0;
}

// ---------------------------------------------------------------- time

// A time namespace shifts CLOCK_MONOTONIC (with its raw and coarse forms)
// and CLOCK_BOOTTIME by a fixed offset, written to
// /proc/PID/timens_offsets after unshare(CLONE_NEWTIME) and before the
// first process is in it. unshare moves the process's children only
// (NSK_TIMEC); a child starts in it (NSK_TIME), and setns changes both.
// clock_now applies the offset, so nanosleep, timers, timerfd and
// absolute deadlines all see it, as do sysinfo and /proc/uptime.

/// The slot of time namespace id, or TM_N for the first one or one that
/// has none.
fn tm_slot(k: &Kernel, id: u64) -> u64
  requires kok(k) && id < MNS_MAX
  ensures result <= TM_N
{
  if id == 0 {
    return TM_N;
  }
  let mut s = 0;
  while s < TM_N
    invariant s <= TM_N && kok(k)
  {
    if get(k.mns, MNS_TM + s * TM_W) == id + 1 {
      return s;
    }
    s = s + 1;
  }
  return TM_N;
}

/// Is a process (not a zombie) in time namespace id; with `own`, as its own
/// namespace only, else as its children's too?
fn tm_used(k: &Kernel, id: u64, own: bool) -> bool
  requires kok(k)
{
  if id == 0 {
    return true;
  }
  let mut q = 0;
  while q < NPROC
    invariant q <= NPROC && kok(k)
  {
    let s = pget(k.procs, q, F_STATE);
    if s != FREE && s != ZOMBIE
       && (get(k.mns, nsk_at(NSK_TIME, q)) == id || (!own && get(k.mns, nsk_at(NSK_TIMEC, q)) == id)) {
      return true;
    }
    q = q + 1;
  }
  return false;
}

fn tm_live(k: &Kernel, id: u64) -> bool
  requires kok(k)
{
  return tm_used(k, id, false);
}

/// Frees the slots of time namespaces nothing is in; returns a free slot,
/// or TM_N if there is none.
fn tm_gc(k: &mut Kernel) -> u64
  requires kok(k)
  ensures kok(k) && result <= TM_N
{
  let mut free = TM_N;
  let mut s = 0;
  while s < TM_N
    invariant s <= TM_N && free <= TM_N && kok(k)
  {
    let v = get(k.mns, MNS_TM + s * TM_W);
    if v != 0 && !tm_live(k, smaller(v - 1, MNS_MAX - 1)) {
      k.mns = set(k.mns, MNS_TM + s * TM_W, 0);
    }
    if get(k.mns, MNS_TM + s * TM_W) == 0 && free == TM_N {
      free = s;
    }
    s = s + 1;
  }
  return free;
}

/// unshare(CLONE_NEWTIME): a new namespace, offsets 0, for pid's children.
fn tm_unshare(k: &mut Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let s = tm_gc(&mut k);
  if s >= TM_N {
    return ENOMEM;
  }
  let id = nsk_new(&mut k, NSK_TIME);
  if id == 0 {
    return ENOMEM;
  }
  k.mns = set(k.mns, MNS_TM + s * TM_W + 1, 0);
  k.mns = set(k.mns, MNS_TM + s * TM_W + 2, 0);
  k.mns = set(k.mns, MNS_TM + s * TM_W, id + 1);
  nsk_set(&mut k, NSK_TIMEC, pid, id);
  return 0;
}

/// Is there a slot for a new time namespace?
fn tm_room(k: &mut Kernel) -> bool
  requires kok(k)
  ensures kok(k)
{
  return tm_gc(&mut k) < TM_N;
}

/// t shifted by off (two's complement ns), not below 0.
fn tm_shift(t: u64, off: u64) -> u64
  requires t < FOREVER
  ensures result < FOREVER
{
  if off < 0x8000000000000000 {
    return smaller(sat_add(t, off), FOREVER - 1);
  }
  let m = (0xFFFFFFFFFFFFFFFF - off) + 1;
  if t >= m {
    return t - m;
  }
  return 0;
}

/// Tells pid's vDSO page whether the process is in a time namespace other
/// than the first, in which the vDSO leaves the monotonic clocks to the
/// system call (user/vdso.c). A page the process does not own outright
/// stays as it is.
fn tm_vdso(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut on = 0;
  if nsk_of(k, NSK_TIME, pid) != 0 {
    on = 1;
  }
  xfer_u64(&mut k.fs.xfer, 0, on);
  let r = force_to_user(&mut k.spaces, pid, USER_BASE + VDSO_PAGE * 4096 + (VDSO_DATA + 4) * 8, k.fs.xfer, 8);
}

/// What clock clk (a clock_now clock below the CPU-time ones) reads for
/// pid, from the boot-relative time t.
fn tm_clock(k: &Kernel, pid: u64, clk: u64, t: u64) -> u64
  requires kok(k) && pid < NPROC && t < FOREVER
  ensures result < FOREVER
{
  let id = nsk_of(k, NSK_TIME, pid);
  if id == 0 {
    return t;
  }
  let s = tm_slot(k, id);
  if s >= TM_N {
    return t;
  }
  if clk == 1 || clk == 4 || clk == 6 {
    return tm_shift(t, get(k.mns, MNS_TM + s * TM_W + 1));
  }
  if clk == 7 || clk == 9 {
    return tm_shift(t, get(k.mns, MNS_TM + s * TM_W + 2));
  }
  return t;
}

/// What a write to pid's /proc/PID/timens_offsets (n bytes in the transfer
/// buffer: lines of "clock secs nsecs", clock 1 monotonic or 7 boottime)
/// sets, for the namespace pid's children get. n, or -errno.
fn tm_write(k: &mut Kernel, p: u64, n: u64) -> u64
  requires kok(k) && n <= 32 && p < NPROC
  ensures kok(k)
  ensures result <= n || result > XFER
{
  let id = nsk_of(k, NSK_TIMEC, p);
  let s = tm_slot(k, id);
  if s >= TM_N {
    return EACCES;                          // the first namespace's offsets are 0, for good
  }
  if tm_used(k, id, true) {
    return EACCES;                          // a process is in it: the offsets are frozen
  }
  let mut i = 0;
  let mut w1 = get(k.mns, MNS_TM + s * TM_W + 1);
  let mut w2 = get(k.mns, MNS_TM + s * TM_W + 2);
  while i < n
    invariant i <= n && n <= 32 && kok(k) && s < TM_N
  {
    // clock
    let mut clk = 0;
    let mut got = false;
    while i < n && bget(k.fs.xfer, i) >= 48 && bget(k.fs.xfer, i) <= 57 && clk < 100
      invariant i <= n && n <= 32 && clk <= 1000 && kok(k)
    {
      clk = clk * 10 + cast[u64](bget(k.fs.xfer, i)) - 48;
      got = true;
      i = i + 1;
    }
    if !got || i >= n || bget(k.fs.xfer, i) != 32 {
      return EINVAL;
    }
    while i < n && bget(k.fs.xfer, i) == 32
      invariant i <= n && n <= 32 && kok(k)
    {
      i = i + 1;
    }
    let mut neg = false;
    if i < n && bget(k.fs.xfer, i) == 45 {
      neg = true;
      i = i + 1;
    }
    let mut sec = 0;
    got = false;
    while i < n && bget(k.fs.xfer, i) >= 48 && bget(k.fs.xfer, i) <= 57 && sec <= 4000000000
      invariant i <= n && n <= 32 && sec <= 40000000099 && kok(k)
    {
      sec = sec * 10 + cast[u64](bget(k.fs.xfer, i)) - 48;
      got = true;
      i = i + 1;
    }
    if !got || sec > 4000000000 || i >= n || bget(k.fs.xfer, i) != 32 {
      return EINVAL;
    }
    while i < n && bget(k.fs.xfer, i) == 32
      invariant i <= n && n <= 32 && kok(k)
    {
      i = i + 1;
    }
    let mut ns = 0;
    got = false;
    while i < n && bget(k.fs.xfer, i) >= 48 && bget(k.fs.xfer, i) <= 57 && ns <= 1000000000
      invariant i <= n && n <= 32 && ns <= 10000000009 && kok(k)
    {
      ns = ns * 10 + cast[u64](bget(k.fs.xfer, i)) - 48;
      got = true;
      i = i + 1;
    }
    if !got || ns >= 1000000000 {
      return EINVAL;
    }
    while i < n && (bget(k.fs.xfer, i) == 10 || bget(k.fs.xfer, i) == 32)
      invariant i <= n && n <= 32 && kok(k)
    {
      i = i + 1;
    }
    // secs may be negative, nsecs is always added: "-2 500000000" is -1.5 s
    let m = sec * 1000000000;
    let mut off = m + ns;
    if neg && m > 0 {
      if ns >= m {
        off = ns - m;
      } else {
        off = (0xFFFFFFFFFFFFFFFF - (m - ns)) + 1;
      }
    }
    if clk == 1 {
      w1 = off;
    } else if clk == 7 {
      w2 = off;
    } else {
      return EINVAL;
    }
  }
  k.mns = set(k.mns, MNS_TM + s * TM_W + 1, w1);
  k.mns = set(k.mns, MNS_TM + s * TM_W + 2, w2);
  return n;
}

/// The text /proc/PID/timens_offsets reads: what the namespace pid is in
/// has, as "monotonic SECS NSECS" and "boottime SECS NSECS".
fn tm_text(k: &Kernel, p: u64, o: &mut Bytes) -> u64
  requires kok(k) && p < NPROC && blen(o) == PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let s = tm_slot(k, nsk_of(k, NSK_TIME, p));
  let mut a = put_s(&mut o, 0, "monotonic ");
  let mut w = 0;
  if s < TM_N {
    w = get(k.mns, MNS_TM + s * TM_W + 1);
  }
  a = tm_put(&mut o, a, w);
  a = put_s(&mut o, a, "boottime  ");
  w = 0;
  if s < TM_N {
    w = get(k.mns, MNS_TM + s * TM_W + 2);
  }
  return tm_put(&mut o, a, w);
}

/// " SECS NSECS\n" for the offset w (two's complement ns).
fn tm_put(o: &mut Bytes, at: u64, w: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  if w >= 0x8000000000000000 {
    let m = (0xFFFFFFFFFFFFFFFF - w) + 1;       // -w, at most 2^63
    let r = m % 1000000000;
    let mut q = m / 1000000000;                 // seconds, rounded away from 0
    let mut f = 0;
    if r != 0 {
      q = q + 1;
      f = 1000000000 - r;
    }
    a = put_c(&mut o, a, 45);
    a = put_n(&mut o, a, q);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, f);
    return put_c(&mut o, a, 10);
  }
  a = put_n(&mut o, a, w / 1000000000);
  a = put_c(&mut o, a, 32);
  a = put_n(&mut o, a, w % 1000000000);
  return put_c(&mut o, a, 10);
}

// ---------------------------------------------------------------- PID

// A process in a PID namespace other than the first has an id inside it
// (NSK_VPID), given from the namespace's counter (slot of PN_W words in
// k.mns: id + 1, the next id, 1 once its init has ended). The first process
// there has id 1, is its init, and when it ends so does everything else in
// the namespace. A process sees, and can signal and wait for, only the
// processes of its own namespace, by their ids there; one in the first
// namespace sees every process by its row, as before. A namespace made
// from inside another is refused (ENOSPC), so there are two levels.

/// The k.mns slot of PID namespace id, or PN_N (the first, or none).
fn pn_slot(k: &Kernel, id: u64) -> u64
  requires kok(k) && id < MNS_MAX
  ensures result <= PN_N
{
  if id == 0 {
    return PN_N;
  }
  let mut s = 0;
  while s < PN_N
    invariant s <= PN_N && kok(k)
  {
    if get(k.mns, MNS_PN + s * PN_W) == id + 1 {
      return s;
    }
    s = s + 1;
  }
  return PN_N;
}

/// Is a process (or its zombie) in PID namespace id, or about to start
/// children in it?
fn pn_used(k: &Kernel, id: u64) -> bool
  requires kok(k)
{
  let mut q = 0;
  while q < NPROC
    invariant q <= NPROC && kok(k)
  {
    if pget(k.procs, q, F_STATE) != FREE
       && (get(k.mns, nsk_at(NSK_PID, q)) == id || get(k.mns, nsk_at(NSK_PIDC, q)) == id) {
      return true;
    }
    q = q + 1;
  }
  return false;
}

/// Frees the slots of PID namespaces nothing uses; returns a free slot, or
/// PN_N if there is none.
fn pn_gc(k: &mut Kernel) -> u64
  requires kok(k)
  ensures kok(k) && result <= PN_N
{
  let mut free = PN_N;
  let mut s = 0;
  while s < PN_N
    invariant s <= PN_N && free <= PN_N && kok(k)
  {
    let v = get(k.mns, MNS_PN + s * PN_W);
    if v != 0 && !pn_used(k, v - 1) {
      k.mns = set(k.mns, MNS_PN + s * PN_W, 0);
    }
    if get(k.mns, MNS_PN + s * PN_W) == 0 && free == PN_N {
      free = s;
    }
    s = s + 1;
  }
  return free;
}

/// Opens slot s as the new PID namespace id, whose next id is `next`.
fn pn_open(k: &mut Kernel, s: u64, id: u64, next: u64)
  requires kok(k) && s < PN_N && id < MNS_MAX
  ensures kok(k)
{
  k.mns = set(k.mns, MNS_PN + s * PN_W, id + 1);
  k.mns = set(k.mns, MNS_PN + s * PN_W + 1, next);
  k.mns = set(k.mns, MNS_PN + s * PN_W + 2, 0);
}

/// Can a process start in PID namespace id (it has ids left, its init has
/// not ended)?
fn pn_open_for_new(k: &Kernel, id: u64) -> bool
  requires kok(k) && id < MNS_MAX
{
  if id == 0 {
    return true;
  }
  let s = pn_slot(k, id);
  return s < PN_N && get(k.mns, MNS_PN + s * PN_W + 2) == 0 && get(k.mns, MNS_PN + s * PN_W + 1) < 999999;
}

/// The next id of PID namespace id (taken), or 0 in the first.
fn pn_alloc(k: &mut Kernel, id: u64) -> u64
  requires kok(k) && id < MNS_MAX
  ensures kok(k)
{
  let s = pn_slot(k, id);
  if s >= PN_N {
    return 0;
  }
  let v = smaller(get(k.mns, MNS_PN + s * PN_W + 1), 999999);
  k.mns = set(k.mns, MNS_PN + s * PN_W + 1, v + 1);
  return v;
}

/// unshare(CLONE_NEWPID): pid's children will start in a new PID
/// namespace. 0, ENOSPC when pid is in one already, or ENOMEM.
fn pidns_unshare(k: &mut Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if nsk_of(k, NSK_PID, pid) != 0 || nsk_of(k, NSK_PIDC, pid) != 0 {
    return ENOSPC;
  }
  let s = pn_gc(&mut k);
  if s >= PN_N {
    return ENOMEM;
  }
  let id = nsk_new(&mut k, NSK_PID);
  if id == 0 {
    return ENOMEM;
  }
  pn_open(&mut k, s, id, 1);
  nsk_set(&mut k, NSK_PIDC, pid, id);
  return 0;
}

/// Is there a slot for a new PID namespace?
fn pn_room(k: &mut Kernel) -> bool
  requires kok(k)
  ensures kok(k)
{
  return pn_gc(&mut k) < PN_N;
}

/// Can pid start a child (or thread) now: the namespace its children
/// start in still has an init?
fn pidns_room(k: &Kernel, pid: u64) -> bool
  requires kok(k) && pid < NPROC
{
  return pn_open_for_new(k, nsk_of(k, NSK_PIDC, pid));
}

/// Child c of pid (nsk_fork has copied the namespaces): it starts in the
/// namespace pid's children do, with the next id there.
fn pidns_enter(k: &mut Kernel, pid: u64, c: u64)
  requires kok(k) && pid < NPROC && c < NPROC
  ensures kok(k)
{
  let n = nsk_of(k, NSK_PIDC, pid);
  nsk_set(&mut k, NSK_PID, c, n);
  nsk_set(&mut k, NSK_PIDC, c, n);
  let v = pn_alloc(&mut k, n);
  nsk_set(&mut k, NSK_VPID, c, v);
}

/// clone(CLONE_NEWPID): child c of pid is the init of a new namespace
/// (pn_room said there was a slot).
fn pidns_clone(k: &mut Kernel, c: u64)
  requires kok(k) && c < NPROC
  ensures kok(k)
{
  let s = pn_gc(&mut k);
  if s >= PN_N {
    return;
  }
  let id = nsk_new(&mut k, NSK_PID);
  if id == 0 {
    return;
  }
  pn_open(&mut k, s, id, 2);
  nsk_set(&mut k, NSK_PID, c, id);
  nsk_set(&mut k, NSK_PIDC, c, id);
  nsk_set(&mut k, NSK_VPID, c, 1);
}

/// A new thread c of pid's group: in the same namespace, with an id there.
fn pidns_thread(k: &mut Kernel, pid: u64, c: u64)
  requires kok(k) && pid < NPROC && c < NPROC
  ensures kok(k)
{
  let n = nsk_of(k, NSK_PID, pid);
  nsk_set(&mut k, NSK_PID, c, n);
  nsk_set(&mut k, NSK_PIDC, c, nsk_of(k, NSK_PIDC, pid));
  let v = pn_alloc(&mut k, n);
  nsk_set(&mut k, NSK_VPID, c, v);
}

/// Process row's id as process obs sees it: its row for a process in the
/// first namespace, else its id there, or 0 if it is not in obs's.
fn vpid_of(k: &Kernel, obs: u64, row: u64) -> u64
  requires kok(k) && obs < NPROC
{
  let o = nsk_of(k, NSK_PID, obs);
  if o == 0 {
    return row;
  }
  if row >= NPROC || nsk_of(k, NSK_PID, row) != o {
    return 0;
  }
  return get(k.mns, nsk_at(NSK_VPID, row));
}

/// The row of the process id v names for obs, or NPROC if there is none.
fn kpid_of(k: &Kernel, obs: u64, v: u64) -> u64
  requires kok(k) && obs < NPROC
  ensures result <= NPROC
{
  let o = nsk_of(k, NSK_PID, obs);
  if o == 0 {
    if v < NPROC {
      return v;
    }
    return NPROC;
  }
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if pget(k.procs, q, F_STATE) != FREE && nsk_of(k, NSK_PID, q) == o && get(k.mns, nsk_at(NSK_VPID, q)) == v {
      return q;
    }
    q = q + 1;
  }
  return NPROC;
}

/// A process id (a pid_t, or its negative for a group) that process obs
/// passed in, as the kernel's row number; a pid obs cannot see becomes one
/// no process has (NPROC). 0 and -1 stay as they are.
fn pidarg_k(k: &Kernel, obs: u64, v: u64) -> u64
  requires kok(k) && obs < NPROC
{
  let p32 = v % 0x100000000;
  if nsk_of(k, NSK_PID, obs) == 0 || p32 == 0 || p32 == 0xFFFFFFFF || p32 == 0x80000000 {
    return v;
  }
  if p32 > 0x80000000 {
    let r = kpid_of(k, obs, 0x100000000 - p32);
    return wrap_sub(0, r);
  }
  return kpid_of(k, obs, p32);
}

/// Argument idx (0 or 1) of system call n, as obs passed it: the kernel's
/// row for the process it names, if that argument is a process id. `first`
/// is argument 0 (getpriority's and waitid's "which" says whether the next
/// one is an id).
fn pidns_arg(k: &Kernel, obs: u64, n: u64, idx: u64, v: u64, first: u64) -> u64
  requires kok(k) && obs < NPROC
{
  if idx == 0 {
    if n == 62 || n == 200 || n == 129 || n == 121 || n == 124 || (n >= 142 && n <= 145)
       || n == 148 || n == 203 || n == 204 || n == 314 || n == 315 || n == 302
       || n == 310 || n == 311 || n == 434 || n == 274 || n == 61 || n == 256 || n == 279
       || n == 234 || n == 297 || n == 109 || n == 312 {
      return pidarg_k(k, obs, v);           // kill, tkill, ..., wait4, tgkill, setpgid, kcmp
    }
    return v;
  }
  if n == 234 || n == 297 || n == 109 || n == 312 || n == 101 {
    return pidarg_k(k, obs, v);             // tgkill's thread, setpgid's group, ptrace's pid
  }
  if (n == 140 || n == 141) && first <= 1 {
    return pidarg_k(k, obs, v);             // get/setpriority of a process or group
  }
  if (n == 251 || n == 252) && first >= 1 && first <= 2 {
    return pidarg_k(k, obs, v);             // ioprio_get/set
  }
  if n == 247 && first >= 1 && first <= 2 {
    return pidarg_k(k, obs, v);             // waitid's P_PID, P_PGID
  }
  return v;
}

/// The result r of a fork or clone by pid, as pid names the child: its id
/// if r is a child's row, else r (an error).
fn child_id(k: &Kernel, pid: u64, r: u64) -> u64
  requires kok(k) && pid < NPROC
{
  if r >= 1 && r < NPROC {
    return vpid_of(k, pid, r);
  }
  return r;
}

/// The live init of the PID namespace pid is in, other than pid; 0 if
/// pid is in the first namespace or there is none.
fn pidns_init(k: &Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures result < NPROC
{
  let o = nsk_of(k, NSK_PID, pid);
  if o == 0 {
    return 0;
  }
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    let s = pget(k.procs, q, F_STATE);
    if q != pid && s != FREE && s != ZOMBIE && nsk_of(k, NSK_PID, q) == o && get(k.mns, nsk_at(NSK_VPID, q)) == 1 {
      return q;
    }
    q = q + 1;
  }
  return 0;
}

/// Process pid has become a zombie. If it was the init of a PID
/// namespace, nothing can start there any more and everything in it is
/// killed.
fn pidns_exit(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let o = nsk_of(k, NSK_PID, pid);
  if o == 0 || get(k.mns, nsk_at(NSK_VPID, pid)) != 1 {
    return;
  }
  let s = pn_slot(k, o);
  if s < PN_N {
    k.mns = set(k.mns, MNS_PN + s * PN_W + 2, 1);
  }
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    let st = pget(k.procs, q, F_STATE);
    if q != pid && st != FREE && st != ZOMBIE && nsk_of(k, NSK_PID, q) == o {
      post_from(&mut k, q, SIGKILL, 0);
    }
    q = q + 1;
  }
}

// ---------------------------------------------------------------- /proc/PID/ns

/// The inode number of namespace id of link kind f (NF_*).
fn ns_inode(f: u64, id: u64) -> u64
  requires id < MNS_MAX
{
  if id == 0 {
    if f == NF_CGROUP {
      return NS_INO0;
    }
    if f == NF_IPC {
      return NS_INO0 + 4;                   // 4026531839
    }
    if f == NF_MNT {
      return NS_INO0 + 6;                   // 4026531841
    }
    if f == NF_NET {
      return NS_INO0 + 5;                   // 4026531840
    }
    if f == NF_PID || f == NF_PIDC {
      return NS_INO0 + 1;                   // 4026531836
    }
    if f == NF_USER {
      return NS_INO0 + 2;                   // 4026531837
    }
    if f == NF_TIME || f == NF_TIMEC {
      return NS_INO0 - 1;                   // 4026531834
    }
    return NS_INO0 + 3;                     // uts: 4026531838
  }
  let mut g = f;
  if f == NF_PIDC {
    g = NF_PID;
  }
  if f == NF_TIMEC {
    g = NF_TIME;
  }
  if g == NF_TIME {
    return NSK_INO + 0x10000000 + id;
  }
  return NSK_INO + id * 8 + g % 8;
}

/// The name of link f.
fn nf_name(f: u64) -> Str {
  if f == NF_CGROUP {
    return "cgroup";
  }
  if f == NF_IPC {
    return "ipc";
  }
  if f == NF_MNT {
    return "mnt";
  }
  if f == NF_NET {
    return "net";
  }
  if f == NF_PID {
    return "pid";
  }
  if f == NF_PIDC {
    return "pid_for_children";
  }
  if f == NF_USER {
    return "user";
  }
  if f == NF_TIME {
    return "time";
  }
  if f == NF_TIMEC {
    return "time_for_children";
  }
  return "uts";
}

/// The namespace process p's link f names.
fn nf_id(k: &Kernel, p: u64, f: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result < MNS_MAX
{
  if f == NF_MNT {
    return ns_of(k, p);
  }
  if f == NF_UTS {
    return nsk_of(k, NSK_UTS, p);
  }
  if f == NF_IPC {
    return nsk_of(k, NSK_IPC, p);
  }
  if f == NF_PID {
    return nsk_of(k, NSK_PID, p);
  }
  if f == NF_PIDC {
    return nsk_of(k, NSK_PIDC, p);
  }
  if f == NF_NET {
    return net_ns(k, p);                    // the network thread's slot, src/lxnetlink.bastio
  }
  if f == NF_USER {
    return nsk_of(k, NSK_USER, p);
  }
  if f == NF_TIME {
    return nsk_of(k, NSK_TIME, p);
  }
  if f == NF_TIMEC {
    return nsk_of(k, NSK_TIMEC, p);
  }
  return nsk_of(k, NSK_CGN, p);
}

/// Is /proc device d one of the /proc/PID/ns links?
fn is_ns_file(d: u64) -> bool
  ensures result == (d >= PROC_DEV + PSYS + SY_NS && d < PROC_DEV + PSYS + SY_NS + NPROC * NF_N)
{
  return d >= PROC_DEV + PSYS + SY_NS && d < PROC_DEV + PSYS + SY_NS + NPROC * NF_N;
}

/// The process of ns link d.
fn nsf_proc(d: u64) -> u64
  requires d >= PROC_DEV + PSYS + SY_NS && d < PROC_DEV + PSYS + SY_NS + NPROC * NF_N
  ensures result < NPROC
{
  return (d - PROC_DEV - PSYS - SY_NS) / NF_N;
}

fn nsf_kind(d: u64) -> u64
  ensures result < NF_N
{
  if d < PROC_DEV + PSYS + SY_NS {
    return 0;
  }
  return (d - PROC_DEV - PSYS - SY_NS) % NF_N;
}

/// The device of link `name` (x[from..to]) in /proc/P/ns, or 0.
fn nsf_at(x: &Bytes, from: u64, to: u64, p: u64) -> u64
  requires from <= to && to <= blen(x) && p < NPROC
{
  let mut f = 0;
  while f < NF_N
    invariant f <= NF_N
  {
    if xfer_is(x, from, to, nf_name(f)) {
      return PROC_DEV + PSYS + SY_NS + p * NF_N + f;
    }
    f = f + 1;
  }
  return 0;
}

/// The target of link d into o: "KIND:[INODE]".
fn nsf_text(k: &Kernel, d: u64, o: &mut Bytes) -> u64
  requires kok(k) && d >= PROC_DEV + PSYS + SY_NS && d < PROC_DEV + PSYS + SY_NS + NPROC * NF_N && blen(o) == PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let f = nsf_kind(d);
  let mut nm = nf_name(f);
  if f == NF_PIDC {
    nm = "pid";
  }
  let mut a = put_s(&mut o, 0, nm);
  a = put_s(&mut o, a, ":[");
  a = put_n(&mut o, a, ns_inode(f, nf_id(k, nsf_proc(d), f)));
  return put_c(&mut o, a, 93);
}

/// Entry i of /proc/P/ns, its name in the transfer buffer.
fn nsf_entry(k: &mut Kernel, i: u64) -> Ent
  requires kok(k)
  ensures kok(k) && result.len <= XFER
{
  if i >= NF_N {
    return Ent { len: 0, dir: false, end: true };
  }
  return Ent { len: name_out(&mut k.fs.xfer, nf_name(i)), dir: false, end: false };
}

/// A link was opened as description h: it keeps the namespace.
fn nsf_open(k: &mut Kernel, h: u64, d: u64)
  requires kok(k) && h < OFD_N && d >= PROC_DEV + PSYS + SY_NS && d < PROC_DEV + PSYS + SY_NS + NPROC * NF_N
  ensures kok(k)
{
  of_set(&mut k.ofd, h, 3, nf_id(k, nsf_proc(d), nsf_kind(d)) + 1);
}

/// The namespace an open link names, through description h.
fn nsf_held(k: &Kernel, h: u64) -> u64
  requires kok(k) && h < OFD_N
  ensures result < MNS_MAX
{
  let v = of_get(k.ofd, h, 3);
  if v == 0 {
    return 0;
  }
  return smaller(v - 1, MNS_MAX - 1);
}

/// What stat says about link d (followed: the namespace's nsfs file).
fn nsf_meta(k: &Kernel, d: u64) -> Meta
  requires kok(k) && d >= PROC_DEV + PSYS + SY_NS && d < PROC_DEV + PSYS + SY_NS + NPROC * NF_N
{
  let f = nsf_kind(d);
  return Meta { ok: true, mode: S_IFREG_NS, size: 0, ino: ns_inode(f, nf_id(k, nsf_proc(d), f)), mtime: 0, own: 0 };
}

/// What lstat says about link d: a symbolic link.
fn nsf_link_meta(d: u64) -> Meta {
  return Meta { ok: true, mode: S_IFLNK, size: 0, ino: INO_PROC + d % 4096, mtime: 0, own: 0 };
}

/// fstat on fd, a descriptor of link d.
fn nsf_fd_meta(k: &Kernel, pid: u64, fd: u64, d: u64) -> Meta
  requires kok(k) && pid < NPROC && d >= PROC_DEV + PSYS + SY_NS && d < PROC_DEV + PSYS + SY_NS + NPROC * NF_N
{
  let h = fd_ofd(k, pid, fd);
  let mut id = 0;
  if h < OFD_N {
    id = nsf_held(k, h);
  }
  return Meta { ok: true, mode: S_IFREG_NS, size: 0, ino: ns_inode(nsf_kind(d), id), mtime: 0, own: 0 };
}

// ---------------------------------------------------------------- setns

/// The CLONE_NEW* flag of link kind f.
fn nf_flag(f: u64) -> u64 {
  if f == NF_CGROUP {
    return CLONE_NEWCGROUP;
  }
  if f == NF_IPC {
    return CLONE_NEWIPC;
  }
  if f == NF_MNT {
    return CLONE_NEWNS;
  }
  if f == NF_NET {
    return CLONE_NEWNET;
  }
  if f == NF_PID || f == NF_PIDC {
    return CLONE_NEWPID;
  }
  if f == NF_USER {
    return CLONE_NEWUSER;
  }
  if f == NF_TIME || f == NF_TIMEC {
    return CLONE_NEWTIME;
  }
  return CLONE_NEWUTS;
}

/// Can pid join namespace id of link kind f? 0, or -errno.
fn ns_may_join(k: &Kernel, pid: u64, f: u64, id: u64) -> u64
  requires kok(k) && pid < NPROC && id < MNS_MAX
{
  if id == nf_id(k, pid, f) && f != NF_TIME && f != NF_TIMEC {
    return 0;                               // already there
  }
  if f == NF_MNT {
    if !mnt_ns_live(k, id) {
      return EINVAL;
    }
    return 0;
  }
  if f == NF_UTS {
    if !nsk_live(k, NSK_UTS, id) || (id != 0 && uts_slot(k, id) >= UTS_N) {
      return EINVAL;
    }
    return 0;
  }
  if f == NF_IPC {
    if !nsk_live(k, NSK_IPC, id) {
      return EINVAL;
    }
    return 0;
  }
  if f == NF_CGROUP {
    if id != 0 && !cg_used(k, smaller(id - 1, CG_N - 1)) {
      return EINVAL;                        // its root is gone
    }
    return 0;
  }
  if f == NF_NET {
    if id >= NNET || !nic_ns_live(k.nic, id) {
      return EINVAL;                        // it ended (its number may since be another's)
    }
    return 0;
  }
  if f == NF_TIME || f == NF_TIMEC {
    if !cap_has(k, pid, CAP_SYS_ADMIN) {
      return EPERM;
    }
    if !tm_live(k, id) || tm_slot(k, id) >= TM_N && id != 0 {
      if f == NF_USER {
    if id == 0 {
      if cap_has(k, pid, CAP_SYS_ADMIN) {
        return 0;
      }
      return EPERM;                         // the first one is joined by root alone
    }
    if usr_slot(k, id) >= USR_N {
      return EINVAL;                        // it ended, or it is the first
    }
    if !ns_cap_over(k, pid, id, CAP_SYS_ADMIN) {
      return EPERM;                         // only from a namespace it descends from (src/lxuser.bastio)
    }
    return 0;
  }
  return EINVAL;                            // a PID namespace not yet
}

/// pid joins mount namespace id: its root and working directory become
/// the root of a process in it (p, if it is still there).
fn mnt_join(k: &mut Kernel, pid: u64, id: u64, p: u64)
  requires kok(k) && pid < NPROC && p < NPROC
  ensures kok(k)
{
  let mut from = NPROC;
  if pget(k.procs, p, F_STATE) != FREE && ns_of(k, p) == id {
    from = p;
  }
  let mut q = 0;
  while q < NPROC && from == NPROC
    invariant q <= NPROC && from <= NPROC && kok(k)
  {
    let s = pget(k.procs, q, F_STATE);
    if s != FREE && s != ZOMBIE && ns_of(k, q) == id {
      from = q;
    }
    q = q + 1;
  }
  k.mns = set(k.mns, pid, id);
  if (pid + 1) * CWD_STRIDE > len(k.croot) || (pid + 1) * CWD_STRIDE > len(k.cwd) {
    return;                                 // no rows for it (not a live process)
  }
  let mut rl = 0;
  if from < NPROC && (from + 1) * CWD_STRIDE <= len(k.croot) {
    rl = root_len(k, from);
    let mut i = 0;
    while i < rl
      invariant i <= rl && rl <= FNAME_MAX && from < NPROC && pid < NPROC && kok(k)
        && (from + 1) * CWD_STRIDE <= len(k.croot) && (pid + 1) * CWD_STRIDE <= len(k.croot)
        && (pid + 1) * CWD_STRIDE <= len(k.cwd)
    {
      let c = get(k.croot, from * CWD_STRIDE + 1 + i);
      k.croot = set(k.croot, pid * CWD_STRIDE + 1 + i, c);
      k.cwd = set(k.cwd, pid * CWD_STRIDE + 1 + i, c);
      i = i + 1;
    }
  }
  k.croot = set(k.croot, pid * CWD_STRIDE, rl);
  k.cwd = set(k.cwd, pid * CWD_STRIDE, rl);
}

/// pid joins namespace id of link kind f, which ns_may_join allowed.
fn ns_join(k: &mut Kernel, pid: u64, f: u64, id: u64, p: u64)
  requires kok(k) && pid < NPROC && p < NPROC
  ensures kok(k)
{
  if id == nf_id(k, pid, f) && f != NF_TIME && f != NF_TIMEC {
    return;
  }
  if f == NF_TIME || f == NF_TIMEC {
    nsk_set(&mut k, NSK_TIME, pid, id);     // both: setns applies at once, unlike unshare
    nsk_set(&mut k, NSK_TIMEC, pid, id);
    tm_vdso(&mut k, pid);
    return;
  }
  if f == NF_MNT {
    mnt_join(&mut k, pid, id, p);
  } else if f == NF_UTS {
    nsk_set(&mut k, NSK_UTS, pid, id);
  } else if f == NF_IPC {
    nsk_set(&mut k, NSK_IPC, pid, id);
  } else if f == NF_CGROUP {
    nsk_set(&mut k, NSK_CGN, pid, id);
  } else if f == NF_NET {
    netns_exit(&mut k, pid);                // the namespace it leaves ends if it was the last one in
    pset(&mut k.procs, pid, F_NETNS, id);
  } else if f == NF_USER {
    nsk_set(&mut k, NSK_USER, pid, id);
  }
}

/// setns(fd, nstype): fd a /proc/PID/ns link (nstype 0 or its CLONE_NEW*
/// flag) or a pidfd (nstype the CLONE_NEW* flags of the namespaces to
/// join, all or none of them joined).
fn lx_setns(k: &mut Kernel, pid: u64, fd: u64, nstype: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let all = CLONE_NEWCGROUP + CLONE_NEWUTS + CLONE_NEWIPC + CLONE_NEWPID + CLONE_NEWNET + CLONE_NEWUSER + CLONE_NEWNS + CLONE_NEWTIME;
  let d = fd_look(k, pid, fd);
  if d.kind == K_BAD {
    return EBADF;
  }
  // Root joins any namespace; anyone else only a user namespace that they
  // have CAP_SYS_ADMIN over (ns_may_join).
  if !cap_has(k, pid, CAP_SYS_ADMIN) {
    let user_link = d.kind == K_DEV && is_ns_file(d.x) && nsf_kind(d.x) == NF_USER;
    if !user_link && !(d.kind == K_PIDFD && nstype == CLONE_NEWUSER) {
      return EPERM;
    }
  }
  // A thread joins the namespaces of its own row, as on Linux (its working
  // directory is its own here), except a user namespace, which needs a
  // single-threaded caller.
  let thread = pget(k.procs, pid, F_TGID) != 0;
  if d.kind == K_DEV && is_ns_file(d.x) {
    let f = nsf_kind(d.x);
    if thread && nf_flag(f) == CLONE_NEWUSER {
      return EINVAL;
    }
    if nstype != 0 && nstype != nf_flag(f) {
      return EINVAL;
    }
    let h = fd_ofd(k, pid, fd);
    if h >= OFD_N {
      return EBADF;
    }
    let id = nsf_held(k, h);
    let e = ns_may_join(k, pid, f, id);
    if e != 0 {
      return e;
    }
    ns_join(&mut k, pid, f, id, nsf_proc(d.x));
    return 0;
  }
  if d.kind != K_PIDFD {
    return EINVAL;
  }
  if nstype == 0 || nstype & all != nstype || (thread && nstype & CLONE_NEWUSER != 0) {
    return EINVAL;
  }
  let p = smaller(d.x, NPROC);
  if p >= NPROC || pget(k.procs, p, F_STATE) == FREE || pget(k.procs, p, F_STATE) == ZOMBIE {
    return ESRCH;
  }
  // Check every kind first, so that either all are joined or none.
  let mut f = 0;
  while f < NF_N
    invariant f <= NF_N && p < NPROC && kok(k) && pid < NPROC
  {
    if f != NF_PIDC && f != NF_TIMEC && nstype & nf_flag(f) != 0 {
      let e = ns_may_join(k, pid, f, nf_id(k, p, f));
      if e != 0 {
        return e;
      }
    }
    f = f + 1;
  }
  let mut g = 0;
  while g < NF_N
    invariant g <= NF_N && p < NPROC && kok(k) && pid < NPROC
  {
    if g != NF_PIDC && g != NF_TIMEC && nstype & nf_flag(g) != 0 {
      ns_join(&mut k, pid, g, nf_id(k, p, g), p);
    }
    g = g + 1;
  }
  return 0;
}

// ---------------------------------------------------------------- ioctl_ns

/// A new close-on-exec descriptor of process pid on namespace id of link
/// kind f. Returns it, or -errno.
fn ns_fd_new(k: &mut Kernel, pid: u64, f: u64, id: u64) -> u64
  requires kok(k) && pid < NPROC && f < NF_N && id < MNS_MAX
  ensures kok(k)
{
  let h = ofd_new(&mut k, OF_DEV, PROC_DEV + PSYS + SY_NS + pid * NF_N + f);
  if h >= OFD_N {
    return ENFILE;
  }
  of_set(&mut k.ofd, h, 3, id + 1);
  ofd_access(&mut k, h, 0);
  let fd = fd_install(&mut k, pid, h);
  if fd < LXNFD {
    fd_set_k(&mut k, pid, fd, FD_OFD + h + FD_CLOEXEC);
  }
  return fd;
}

/// ioctl on fd, a descriptor of /proc/PID/ns link d: NS_GET_USERNS (a
/// descriptor of the user namespace that owns the namespace, or of a user
/// namespace's parent), NS_GET_PARENT (the parent of a user or PID
/// namespace), NS_GET_NSTYPE (its CLONE_NEW* flag) and NS_GET_OWNER_UID
/// (the creator of a user namespace, as the caller sees ids). Parents and
/// owners are only given to a caller that is in them or inside one that
/// is, as on Linux, and namespaces are two levels deep, so every parent is
/// the first one. A namespace other than a user namespace is owned by the
/// user namespace of the process whose link was opened (the first
/// namespaces by the first one).
fn ns_ioctl(k: &mut Kernel, pid: u64, fd: u64, d: u64, req: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC && d >= PROC_DEV + PSYS + SY_NS && d < PROC_DEV + PSYS + SY_NS + NPROC * NF_N
  ensures kok(k)
{
  let f = nsf_kind(d);
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N {
    return EBADF;
  }
  let id = nsf_held(k, h);
  let mine = nsk_of(k, NSK_USER, pid);
  if req == NS_GET_NSTYPE {
    return nf_flag(f);
  }
  if req == NS_GET_USERNS {
    let mut owner = 0;
    if f == NF_USER {
      if id == 0 {
        return EPERM;                       // the first has no owner
      }
    } else if id != 0 {
      owner = nsk_of(k, NSK_USER, nsf_proc(d));
    }
    if mine != 0 && mine != owner {
      return EPERM;                         // out of the caller's reach
    }
    return ns_fd_new(&mut k, pid, NF_USER, owner);
  }
  if req == NS_GET_PARENT {
    if f != NF_USER && f != NF_PID && f != NF_PIDC {
      return EINVAL;                        // not hierarchical
    }
    let mut here = mine;
    if f != NF_USER {
      here = nsk_of(k, NSK_PID, pid);
    }
    if id == 0 || here != 0 {
      return EPERM;
    }
    let mut g = f;
    if f == NF_PIDC {
      g = NF_PID;
    }
    return ns_fd_new(&mut k, pid, g, 0);
  }
  if req == NS_GET_OWNER_UID {
    if f != NF_USER {
      return EINVAL;
    }
    let mut uid = 0;
    let s = usr_slot(k, id);
    if s < USR_N {
      uid = usr_get(k, s, 1);
    }
    xfer_u64(&mut k.fs.xfer, 0, id_out(k, pid, 0, uid % UM_BAD));
    return lx_put_out(&mut k, pid, arg, 4);
  }
  return ENOTTY;
}
