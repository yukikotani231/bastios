  }
  if i == 17 {
    return include_bytes("../build/user/mtime.elf");
  }
  if i == 18 {
    return include_bytes("../build/user/crashme.bin");
  }
  if i == 19 {
    return include_bytes("../build/user/mdir.elf");
  }
  if i == 20 {
    return include_bytes("../build/user/mmisc.elf");
  }
  if i == 21 {
    return include_bytes("../build/user/mspawn.elf");
  }
  if i == 22 {
    return include_bytes("../build/user/sysfuzz.elf");
  }
  if i == 23 {
    return include_bytes("../build/user/mthread.elf");
  }
  if i == 24 {
    return include_bytes("../build/user/mdyn.elf");
  }
  if i == 25 {
    return include_bytes("../build/user/ld-musl.so");
  }
