// Processes. The table is one buffer with a row of STRIDE words per
// process; the process id is the row number (1 to NPROC - 1). A process's
// address space is element `pid` of a vector of spaces.

import "console.bastio";
import "pages.bastio";
import "space.bastio";
import "elf.bastio";
import "fs.bastio";

const NPROC: u64 = 16;
const STRIDE: u64 = 32;
const PTAB_LEN: u64 = 512;           // NPROC * STRIDE

// Row fields.
const F_STATE: u64 = 0;
const F_WAIT: u64 = 1;               // the child a WAITING process waits for
const F_CODE: u64 = 2;               // exit code of a ZOMBIE
const F_PARENT: u64 = 3;
const F_PROG: u64 = 4;               // index into the program table
const F_TICKS: u64 = 5;              // timer ticks spent running
const F_BRK: u64 = 6;                // Linux: window offset of the program break
const F_MMAP: u64 = 7;               // Linux: window offset of the lowest mmap page
const F_REGS: u64 = 8;               // 21 saved words, in `cpu_get` order

// Saved register numbers.
const R_RAX: u64 = 0;
const R_RDX: u64 = 3;
const R_RSI: u64 = 4;
const R_RDI: u64 = 5;
const R_R10: u64 = 9;
const R_RIP: u64 = 15;
const R_RSP: u64 = 16;
const R_RFLAGS: u64 = 17;
const R_FSBASE: u64 = 20;

// States.
const FREE: u64 = 0;
const READY: u64 = 1;
const READING: u64 = 2;
const WAITING: u64 = 3;
const ZOMBIE: u64 = 4;
const LXREADING: u64 = 5;            // blocked in a Linux read of the console
const RUNNING: u64 = 6;              // on a processor: its space and FPU page are out
const KILLED: u64 = 7;               // RUNNING, and killed: ends when it comes back

const NO_RESULT: u64 = 18446744073709551615;

fn pget(procs: &Buf, pid: u64, f: u64) -> u64
  requires len(procs) == PTAB_LEN && pid < NPROC && f < STRIDE
{
  return get(procs, pid * STRIDE + f);
}

fn pset(procs: &mut Buf, pid: u64, f: u64, v: u64)
  requires len(procs) == PTAB_LEN && pid < NPROC && f < STRIDE
  ensures len(procs) == PTAB_LEN
{
  procs = set(procs, pid * STRIDE + f, v);
}

fn state(procs: &Buf, pid: u64) -> u64
  requires len(procs) == PTAB_LEN && pid < NPROC
{
  return pget(procs, pid, F_STATE);
}

/// Processes that are not FREE or ZOMBIE.
fn live_count(procs: &Buf) -> u64
  requires len(procs) == PTAB_LEN
{
  let mut n = 0;
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && n <= p
  {
    let s = state(procs, p);
    if s != FREE && s != ZOMBIE {
      n = n + 1;
    }
    p = p + 1;
  }
  return n;
}

/// The next READY process at or after `from` (round robin), or 0 if none.
fn pick(procs: &Buf, from: u64) -> u64
  requires len(procs) == PTAB_LEN
  ensures result < NPROC
{
  let mut k = 0;
  while k < NPROC
    invariant k <= NPROC
  {
    let p = (from % NPROC + k) % NPROC;
    if p != 0 && state(procs, p) == READY {
      return p;
    }
    k = k + 1;
  }
  return 0;
}

// ---------------------------------------------------------------- address spaces

/// One slot per process id; every address space is a level-4 table.
spec fn spaces_ok(s: &Vec[Space]) -> bool {
  vlen(s) == NPROC && forall i: u64 :: i < NPROC ==> (vget(s, i) is Space::Mapped ==> pt_level(vget(s, i).Mapped) == 4)
}

/// Takes process `pid`'s address space out, leaving its slot empty.
fn take_space(s: &mut Vec[Space], pid: u64) -> Space
  requires spaces_ok(s) && pid < NPROC
  ensures spaces_ok(s) && vget(s, pid) is Space::Empty
  ensures result is Space::Mapped ==> pt_level(result.Mapped) == 4
{
  return vec_swap(&mut s, pid, Space::Empty);
}

/// Puts an address space into an empty slot.
fn put_space(s: &mut Vec[Space], pid: u64, x: Space)
  requires spaces_ok(s) && pid < NPROC && vget(s, pid) is Space::Empty
  requires x is Space::Mapped ==> pt_level(x.Mapped) == 4
  ensures spaces_ok(s)
{
  match vec_swap(&mut s, pid, x) {
    Space::Empty => {},
    Space::Mapped(_t) => { unreachable; },     // the slot was empty
  }
}

/// Puts an address space back into slot `pid`. The slot is empty unless
/// the scheduler has a bug; whatever was there is freed.
fn restore_space(m: &mut Mem, s: &mut Vec[Space], mmu: &Mmu, pid: u64, x: Space)
  requires mem_ok(m) && spaces_ok(s) && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  requires x is Space::Mapped ==> pt_level(x.Mapped) == 4
  ensures mem_ok(m) && spaces_ok(s)
{
  match vec_swap(&mut s, pid, x) {
    Space::Empty => {},
    Space::Mapped(t) => { free_space(&mut m, mmu, t); },
  }
}

// ---------------------------------------------------------------- FPU state

// A process's x87/SSE registers, saved in a page of their own while it is
// not running. Element `pid` of a vector, like the address spaces.
enum Fpu { None, State(Frame) }

spec fn fpus_ok(s: &Vec[Fpu]) -> bool {
  vlen(s) == NPROC
}

/// Takes process `pid`'s FPU state out, leaving its slot empty.
fn take_fpu(s: &mut Vec[Fpu], pid: u64) -> Fpu
  requires fpus_ok(s) && pid < NPROC
  ensures fpus_ok(s) && vget(s, pid) is Fpu::None
{
  return vec_swap(&mut s, pid, Fpu::None);
}

/// Puts FPU state into an empty slot.
fn put_fpu(s: &mut Vec[Fpu], pid: u64, x: Fpu)
  requires fpus_ok(s) && pid < NPROC && vget(s, pid) is Fpu::None
  ensures fpus_ok(s)
{
  match vec_swap(&mut s, pid, x) {
    Fpu::None => {},
    Fpu::State(_f) => { unreachable; },     // the slot was empty
  }
}

/// Puts FPU state back into slot `pid`. The slot is empty unless the
/// scheduler has a bug; whatever was there goes back to the allocator.
fn restore_fpu(m: &mut Mem, s: &mut Vec[Fpu], pid: u64, x: Fpu)
  requires mem_ok(m) && fpus_ok(s) && pid < NPROC
  ensures mem_ok(m) && fpus_ok(s)
{
  drop_fpu(&mut m, vec_swap(&mut s, pid, x));
}

/// Gives the page of FPU state `x`, if any, back to the allocator.
fn drop_fpu(m: &mut Mem, x: Fpu)
  requires mem_ok(m)
  ensures mem_ok(m)
{
  match x {
    Fpu::None => {},
    Fpu::State(f) => { give_page(&mut m, f); },
  }
}

/// The x87/SSE state a Linux process starts with: control word 0x37F and
/// MXCSR 0x1F80 (every exception masked, round to nearest).
fn fpu_init(f: &mut Frame) {
  frame_write8(&mut f, 0, 0x7F);
  frame_write8(&mut f, 1, 0x03);
  frame_write8(&mut f, 24, 0x80);
  frame_write8(&mut f, 25, 0x1F);
}

// ---------------------------------------------------------------- input queue

// Bytes typed on the console, waiting for a READ: word 0 is the head,
// word 1 the count, words 2..258 a ring of 256 bytes.
const INQ_LEN: u64 = 258;

spec fn qok(q: &Buf) -> bool {
  len(q) == INQ_LEN && get(q, 0) < 256 && get(q, 1) <= 256
}

fn q_push(q: &mut Buf, b: u64)
  requires qok(q)
  ensures qok(q)
{
  let n = get(q, 1);
  if n < 256 {
    q = set(q, 2 + (get(q, 0) + n) % 256, b);
    q = set(q, 1, n + 1);
  }
}

/// The oldest byte, or 256 if there is none.
fn q_pop(q: &mut Buf) -> u64
  requires qok(q)
  ensures qok(q)
{
  let n = get(q, 1);
  if n == 0 {
    return 256;
  }
  let h = get(q, 0);
  let b = get(q, 2 + h);
  q = set(q, 0, (h + 1) % 256);
  q = set(q, 1, n - 1);
  return b;
}

/// Moves every byte the UART has received into the queue.
fn drain(con: &mut Uart, q: &mut Buf)
  requires uart_ok(con) && qok(q)
  ensures qok(q)
{
  let mut c = uart_poll(&mut con);
  while c < 256
    invariant qok(q)
  {
    q_push(&mut q, c);
    c = uart_poll(&mut con);
  }
}

/// Hands queued bytes to processes blocked in READ.
fn wake_readers(procs: &mut Buf, q: &mut Buf)
  requires len(procs) == PTAB_LEN && qok(q)
  ensures len(procs) == PTAB_LEN && qok(q)
{
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && len(procs) == PTAB_LEN && qok(q)
  {
    if state(procs, p) == READING && get(q, 1) > 0 {
      pset(&mut procs, p, F_REGS + R_RAX, q_pop(&mut q));
      pset(&mut procs, p, F_STATE, READY);
    }
    // A Linux read restarts its system call, which takes the bytes itself.
    if state(procs, p) == LXREADING && get(q, 1) > 0 {
      pset(&mut procs, p, F_STATE, READY);
    }
    p = p + 1;
  }
}

// ---------------------------------------------------------------- kernel state

// Everything the kernel owns, in one place. `mmu` and `cpu` stay with
// `main`, which lends them where they are needed.
struct Kernel {
  mem: Mem,             // the page allocator
  spaces: Vec[Space],   // element `pid` is that process's address space
  fpus: Vec[Fpu],       // element `pid` is that process's FPU state
  procs: Buf,           // the process table
  q: Buf,               // console input waiting for a READ
  ticks: u64,           // timer ticks since boot
  ns: u64,              // the HPET clock at the last system call, in nanoseconds
  cpus: u64,            // processors running, the bootstrap one included
  fs: Vfs,              // files and the open-file table
}

spec fn kok(k: &Kernel) -> bool {
  mem_ok(k.mem) && spaces_ok(k.spaces) && fpus_ok(k.fpus) && len(k.procs) == PTAB_LEN && qok(k.q) && vfs_ok(k.fs)
}

// ---------------------------------------------------------------- programs

const NPROGS: u64 = 15;

fn prog_name(i: u64) -> Str {
  if i == 0 {
    return "sh";
  }
  if i == 1 {
    return "hello";
  }
  if i == 2 {
    return "spin";
  }
  if i == 3 {
    return "true";
  }
  if i == 4 {
    return "bench";
  }
  if i == 5 {
    return "straddle";
  }
  if i == 6 {
    return "elfexec";
  }
  if i == 7 {
    return "elfpie";
  }
  if i == 8 {
    return "elfbad";
  }
  if i == 9 {
    return "fstest";
  }
  if i == 10 {
    return "mhello";
  }
  if i == 11 {
    return "fpucheck";
  }
  if i == 12 {
    return "mtest";
  }
  if i == 13 {
    return "ash";
  }
  return "fault";
}

fn prog_image(i: u64) -> Str {
  if i == 0 {
    return include_bytes("../build/user/sh.bin");
  }
  if i == 1 {
    return include_bytes("../build/user/hello.bin");
  }
  if i == 2 {
    return include_bytes("../build/user/spin.bin");
  }
  if i == 3 {
    return include_bytes("../build/user/true.bin");
  }
  if i == 4 {
    return include_bytes("../build/user/bench.bin");
  }
  if i == 5 {
    return include_bytes("../build/user/straddle.bin");
  }
  if i == 6 {
    return include_bytes("../build/user/elfexec.elf");
  }
  if i == 7 {
    return include_bytes("../build/user/elfpie.elf");
  }
  if i == 8 {
    return include_bytes("../build/user/elfbad.elf");
  }
  if i == 9 {
    return include_bytes("../build/user/fstest.bin");
  }
  if i == 10 {
    return include_bytes("../build/user/mhello.elf");
  }
  if i == 11 {
    return include_bytes("../build/user/fpucheck.elf");
  }
  if i == 12 {
    return include_bytes("../build/user/mtest.elf");
  }
  if i == 13 {
    return include_bytes("../build/user/ash.elf");
  }
  return include_bytes("../build/user/fault.bin");
}

/// The little-endian u64 at `at` in `s`.
fn read_u64(s: Str, at: u64) -> u64
  requires at <= 64 && at + 8 <= slen(s)
{
  return sget(s, at) + 0x100 * sget(s, at + 1) + 0x10000 * sget(s, at + 2)
    + 0x1000000 * sget(s, at + 3) + 0x100000000 * sget(s, at + 4)
    + 0x10000000000 * sget(s, at + 5) + 0x1000000000000 * sget(s, at + 6)
    + 0x100000000000000 * sget(s, at + 7);
}

// ---------------------------------------------------------------- life cycle

const MAGIC: u64 = 0x0A52455355545342;   // "BSTUSER\n"

/// Starts program `prog` as a child of `parent` (0 for none). Returns the
/// new process id, or 0 if the image is malformed or there is no room.
fn spawn(k: &mut Kernel, prog: u64, parent: u64) -> u64
  requires kok(k)
  ensures kok(k)
  ensures result < NPROC
{
  // An image is a Linux ELF executable or a BastiOS image; check its
  // headers before taking anything.
  let img = prog_image(prog);
  let elf = is_elf(img);
  let e = elf_parse(img);
  let mut size = 0;
  let mut entry = e.entry;
  let mut rsp = USER_BASE + ELF_SP;
  if elf {
    if !e.ok {
      return 0;
    }
  } else {
    // The BastiOS header: magic, bytes of memory the image needs, entry point.
    if slen(img) < 24 || slen(img) > IMAGE_MAX {
      return 0;
    }
    size = read_u64(img, 8);
    entry = read_u64(img, 16);
    rsp = USER_BASE + USER_SIZE;
    if read_u64(img, 0) != MAGIC || size < slen(img) || size > IMAGE_MAX {
      return 0;
    }
    if entry < USER_BASE + 24 || entry >= USER_BASE + slen(img) {
      return 0;
    }
  }
  let mut pid = 1;
  while pid < NPROC && state(k.procs, pid) != FREE
    invariant 1 <= pid && pid <= NPROC
  {
    pid = pid + 1;
  }
  if pid >= NPROC {
    return 0;
  }
  // A FREE process has no address space; check it rather than assume it.
  match take_space(&mut k.spaces, pid) {
    Space::Empty => {},
    Space::Mapped(t) => {
      put_space(&mut k.spaces, pid, Space::Mapped(t));
      return 0;
    },
  }
  let fp = find_free(&mut k.mem);
  if fp >= NPAGES {
    return 0;
  }
  let mut fpu = take_page(&mut k.mem, fp);
  fpu_init(&mut fpu);
  let sp = build_space(&mut k.mem, img, elf, e, size, prog_name(prog), k.ticks % 0x100000000 * NPROC + pid);
  let ok = sp is Space::Mapped;
  put_space(&mut k.spaces, pid, sp);
  if !ok {
    give_page(&mut k.mem, fpu);
    return 0;
  }
  drop_fpu(&mut k.mem, take_fpu(&mut k.fpus, pid));
  put_fpu(&mut k.fpus, pid, Fpu::State(fpu));
  let mut f = 0;
  while f < STRIDE
    invariant f <= STRIDE && len(k.procs) == PTAB_LEN
  {
    pset(&mut k.procs, pid, f, 0);
    f = f + 1;
  }
  pset(&mut k.procs, pid, F_PARENT, parent);
  pset(&mut k.procs, pid, F_PROG, prog);
  pset(&mut k.procs, pid, F_REGS + R_RIP, entry);
  pset(&mut k.procs, pid, F_REGS + R_RSP, rsp);
  pset(&mut k.procs, pid, F_REGS + R_RFLAGS, 0x202);
  if elf {
    // The heap starts on the page after the image; mmap takes pages
    // downward from the stack. Both stay in the window below the stack.
    pset(&mut k.procs, pid, F_BRK, (e.end + 4095) / 4096 * 4096);
    pset(&mut k.procs, pid, F_MMAP, STACK_FIRST * 4096);
  }
  pset(&mut k.procs, pid, F_STATE, READY);
  return pid;
}

/// The address space for a checked image: ELF, or a BastiOS image needing
/// `size` bytes of memory.
fn build_space(m: &mut Mem, img: Str, elf: bool, e: Elf, size: u64, name: Str, seed: u64) -> Space
  requires mem_ok(m) && (elf ==> (e.ok && elf_fits(img, e))) && (!elf ==> size <= IMAGE_MAX)
  ensures mem_ok(m)
  ensures result is Space::Mapped ==> pt_level(result.Mapped) == 4
{
  if elf {
    return elf_space(&mut m, img, e, name, seed);
  }
  return new_space(&mut m, img, size);
}

/// Ends process `pid` with exit `code`: frees its address space, closes its
/// files, hands the code to a parent waiting for it, and orphans its
/// children.
fn terminate(k: &mut Kernel, mmu: &Mmu, pid: u64, code: u64)
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  match take_space(&mut k.spaces, pid) {
    Space::Empty => {},
    Space::Mapped(t) => { free_space(&mut k.mem, mmu, t); },
  }
  drop_fpu(&mut k.mem, take_fpu(&mut k.fpus, pid));
  vfs_close_all(&mut k.fs, pid * NFD);
  pset(&mut k.procs, pid, F_STATE, ZOMBIE);
  pset(&mut k.procs, pid, F_CODE, code);
  let mut c = 1;
  while c < NPROC
    invariant 1 <= c && c <= NPROC && len(k.procs) == PTAB_LEN
  {
    if pget(k.procs, c, F_PARENT) == pid && state(k.procs, c) != FREE {
      pset(&mut k.procs, c, F_PARENT, 0);
      if state(k.procs, c) == ZOMBIE {
        pset(&mut k.procs, c, F_STATE, FREE);
      }
    }
    c = c + 1;
  }
  let par = pget(k.procs, pid, F_PARENT);
  if par == 0 || par >= NPROC {
    pset(&mut k.procs, pid, F_STATE, FREE);       // nobody will collect it
  } else if state(k.procs, par) == WAITING && pget(k.procs, par, F_WAIT) == pid {
    pset(&mut k.procs, par, F_REGS + R_RAX, code);
    pset(&mut k.procs, par, F_STATE, READY);
    pset(&mut k.procs, pid, F_STATE, FREE);
  } else if state(k.procs, par) == FREE || state(k.procs, par) == ZOMBIE {
    pset(&mut k.procs, pid, F_STATE, FREE);
  }
}

fn put_state(con: &mut Uart, s: u64)
  requires uart_ok(con)
{
  if s == READY {
    puts(&mut con, "ready  ");
  } else if s == READING || s == LXREADING {
    puts(&mut con, "reading");
  } else if s == WAITING {
    puts(&mut con, "waiting");
  } else if s == RUNNING || s == KILLED {
    puts(&mut con, "running");
  } else {
    puts(&mut con, "zombie ");
  }
}

fn print_ps(con: &mut Uart, procs: &Buf)
  requires uart_ok(con) && len(procs) == PTAB_LEN
{
  puts(&mut con, "  PID  PPID STATE    TICKS NAME\r\n");
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC
  {
    if state(procs, p) != FREE {
      put_num_pad(&mut con, p, 5);
      put_num_pad(&mut con, pget(procs, p, F_PARENT), 6);
      puts(&mut con, " ");
      put_state(&mut con, state(procs, p));
      put_num_pad(&mut con, pget(procs, p, F_TICKS), 6);
      puts(&mut con, " ");
      puts(&mut con, prog_name(pget(procs, p, F_PROG)));
      puts(&mut con, "\r\n");
    }
    p = p + 1;
  }
}
