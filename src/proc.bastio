  }
  if i == 30 {
    return include_bytes("../build/user/mns.elf");
  }
  if i == 31 {
    return include_bytes("../build/user/mseccomp.elf");
  }
  if i == 32 {
    return include_bytes("../build/user/mcont.elf");
  }
  return include_bytes("../build/user/fault.bin");
}

/// The little-endian u64 at `at` in `s`.
fn read_u64(s: Str, at: u64) -> u64
  requires at <= 64 && at + 8 <= slen(s)
{
  return cast[u64](sget(s, at)) + 0x100 * cast[u64](sget(s, at + 1)) + 0x10000 * cast[u64](sget(s, at + 2))
    + 0x1000000 * cast[u64](sget(s, at + 3)) + 0x100000000 * cast[u64](sget(s, at + 4))
    + 0x10000000000 * cast[u64](sget(s, at + 5)) + 0x1000000000000 * cast[u64](sget(s, at + 6))
    + 0x100000000000000 * cast[u64](sget(s, at + 7));
}

// ---------------------------------------------------------------- life cycle

const MAGIC: u64 = 0x0A52455355545342;   // "BSTUSER\n"
const ARGV0_MAX: u64 = 63;              // the most bytes of a program name in argv
const START_ENV_LEN: u64 = 84;           // start_env_str()'s length

/// Starts program `prog` as a child of `parent` (0 for none), with just
/// its name as argv. Returns the new process id, or 0 if the image is
/// malformed or there is no room.
fn spawn(k: &mut Kernel, prog: u64, parent: u64) -> u64
  requires kok(k)
  ensures kok(k)
  ensures result < NPROC
{
  return spawn_as(&mut k, prog, parent, prog_name(prog));
}

/// spawn, with `name` as the program's argv[0] (BusyBox picks its applet
/// by it).
fn spawn_as(k: &mut Kernel, prog: u64, parent: u64, name: Str) -> u64
  requires kok(k)
  ensures kok(k)
  ensures result < NPROC
{
  let pid = new_pid(&mut k);
  if pid == 0 {
    return 0;
  }
  pidfd_reuse(&mut k, pid);                 // pidfds on the slot's last process (src/lxpidfd.bastio)
  // A FREE process has no address space; check it rather than assume it.
  match take_space(&mut k.spaces, pid) {
    Space::Empty => {},
    Space::Mapped(t) => {
      put_space(&mut k.spaces, pid, Space::Mapped(t));
      return 0;
    },
  }
  let fp = find_free(&mut k.mem);
  if fp >= NPAGES {
    return 0;
  }
  let mut fpu = take_page(&mut k.mem, fp);
  fpu_init(&mut fpu);
  let mut f = 0;
  while f < STRIDE
    invariant f <= STRIDE && ptab_ok(k.procs)
  {
    pset(&mut k.procs, pid, f, 0);
    f = f + 1;
  }
  if 1 <= parent && parent < NPROC {
    // A child keeps its parent's user and group ids and umask: starting a
    // program must not make anyone root.
    f = F_UID;
    while f < F_GROUPS + NGROUPS_KEPT / 2
      invariant F_UID <= f && f <= F_GROUPS + NGROUPS_KEPT / 2 && ptab_ok(k.procs)
    {
      pset(&mut k.procs, pid, f, pget(k.procs, parent, f));
      f = f + 1;
    }
  }
  lx_fd_reset(&mut k.lxfd, pid);
  sig_reset(&mut k.sigact, pid, false);
  wset(&mut k.cwd, pid * CWD_STRIDE, 0);   // starts at "/"
  wset(&mut k.croot, pid * CWD_STRIDE, 0);
  k.mns = set(k.mns, pid, 0);               // in the first mount namespace
  nsk_reset(&mut k.mns, pid);               // and the first others (src/lxnsk.bastio)
  let mut args = balloc(ARGV0_MAX + 1 + START_ENV_LEN);
  let alen = name_arg(&mut args, name);
  let total = start_env(&mut args, alen);
  let src = Src { file: false, prog: prog, f: 0, size: slen(prog_image(prog)) };
  let sp = load_image(&mut k.mem, &mut k.txt, &mut k.fs, &mut k.procs, k.ticks % 0x100000000 * NPROC + pid, k.tsc, k.epoch, pid, src, Src { file: false, prog: NPROGS, f: 0, size: 0 }, args, alen, total, false);
  bfree(args);
  let ok = sp is Space::Mapped;
  put_space(&mut k.spaces, pid, sp);
  hole_clear(&mut k, pid);
  anon_clear(&mut k, pid);
  if !ok {
    give_page(&mut k.mem, fpu);
    return 0;
  }
  drop_fpu(&mut k.mem, take_fpu(&mut k.fpus, pid));
  put_fpu(&mut k.fpus, pid, Fpu::State(fpu));
  pset(&mut k.procs, pid, F_PARENT, parent);
  pset(&mut k.procs, pid, F_START, k.ns / 10000000 + 1);
  pset(&mut k.procs, pid, F_STATE, READY);
  return pid;
}

/// A FREE process id the table has a row for, or 0 if there is none.
fn free_pid(procs: &Buf) -> u64
  requires ptab_ok(procs)
  ensures result < NPROC
{
  let cap = len(procs) / STRIDE;
  let mut pid = 1;
  while pid < cap && state(procs, pid) != FREE
    invariant 1 <= pid && cap <= NPROC
  {
    pid = pid + 1;
  }
  if pid >= cap {
    return 0;
  }
  return pid;
}

/// Makes `t` at least `n` words long: its words stay, the new ones are 0.
/// False, with `t` as it was, when memory runs out.
fn zgrow(t: &mut Buf, n: u64) -> bool
  requires n <= 1152921504606846976
  ensures len(t) == len(old(t)) || len(t) == n
{
  if len(t) >= n {
    return true;
  }
  let mut nt = try_alloc(n);
  if len(nt) != n {
    free(nt);
    return false;
  }
  let mut i = 0;
  while i < len(t)
    invariant i <= len(t) && len(t) <= n && len(nt) == n
  {
    nt = set(nt, i, get(t, i));
    i = i + 1;
  }
  let prev = t;
  t = nt;
  free(prev);
  return true;
}

/// A FREE process id for a new process, or 0 if there is none. When every
/// row is taken, the per-process tables double, up to NPROC rows; when
/// memory runs out, there is none. Doubling and not a fixed step: the
/// kernel's allocator reuses a freed block only for a buffer of the same
/// size, so every table a growth leaves behind stays unused.
fn new_pid(k: &mut Kernel) -> u64
  requires kok(k)
  ensures kok(k) && result < NPROC
{
  let pid = free_pid(k.procs);
  if pid != 0 {
    return pid;
  }
  let cap = len(k.procs) / STRIDE;
  if cap >= NPROC {
    return 0;
  }
  let mut n = cap * 2;
  if n < PGROW {
    n = PGROW;
  }
  if n > NPROC {
    n = NPROC;
  }
  // The process table last: its length is how many rows every table has.
  if !zgrow(&mut k.sigact, n * SIGACT_ROW) || !zgrow(&mut k.cwd, n * CWD_STRIDE)
     || !zgrow(&mut k.croot, n * CWD_STRIDE) || !zgrow(&mut k.lxfd, n * LXNFD)
     || !zgrow(&mut k.fs.ftab, n * NFD * FD_STRIDE) || !zgrow(&mut k.sigsave, n * SIGSAVE_ROW) || !zgrow(&mut k.procs, n * STRIDE) {
    return 0;
  }
  return free_pid(k.procs);
}

/// Writes `name` (at most ARGV0_MAX bytes of it) and a NUL into `args`:
/// an argv of one. Returns the bytes written.
fn name_arg(args: &mut Bytes, name: Str) -> u64
  requires blen(args) == ARGV0_MAX + 1 + START_ENV_LEN
  ensures blen(args) == ARGV0_MAX + 1 + START_ENV_LEN && result <= ARGV0_MAX + 1
{
  let n = smaller(slen(name), ARGV0_MAX);
  let mut i = 0;
  while i < n
    invariant i <= n && n <= ARGV0_MAX && blen(args) == ARGV0_MAX + 1 + START_ENV_LEN
  {
    bset(&mut args, i, sget(name, i));
    i = i + 1;
  }
  bset(&mut args, n, 0);
  return n + 1;
}

/// The environment a program the kernel starts gets (the shell's ash, and
/// what it runs): where programs are, a home, and a terminal type that
/// curses programs know (Alpine's ncurses-terminfo-base has vt100). Each
/// string ends at a ";", which start_env makes a NUL.
fn start_env_str() -> Str
  ensures slen(result) == START_ENV_LEN
{
  return "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin;HOME=/;TERM=vt100;";
}

/// Puts start_env_str() in args after the first `from` bytes. Returns where it ends.
fn start_env(args: &mut Bytes, from: u64) -> u64
  requires blen(args) == ARGV0_MAX + 1 + START_ENV_LEN && from <= ARGV0_MAX + 1
  ensures blen(args) == ARGV0_MAX + 1 + START_ENV_LEN && from <= result && result <= blen(args)
{
  let env = start_env_str();
  let n = START_ENV_LEN;
  let mut i = 0;
  while i < n
    invariant i <= n && n == START_ENV_LEN && slen(env) == n && from <= ARGV0_MAX + 1 && blen(args) == ARGV0_MAX + 1 + n
  {
    let c = sget(env, i);
    if c == 59 {
      bset(&mut args, from + i, 0);
    } else {
      bset(&mut args, from + i, c);
    }
    i = i + 1;
  }
  return from + n;
}

/// Builds the address space for program `prog`, with the argument strings
/// in the first `alen` bytes of `args` and the environment strings from
/// there to `total` (each ending in a NUL), and the interpreter execve
/// found for it (elf_interp, src/lxproc.bastio; a file, or none), and sets
/// process `pid` up to start it: program, registers, program break.
/// Returns `Space::Empty`, changing nothing, if the image is malformed or
/// memory runs out. The caller installs the space.
fn load_image(m: &mut Mem, txt: &mut Store, v: &mut Vfs, procs: &mut Buf, seed: u64, t: Tsc, epoch: u64, pid: u64, src: Src, isrc0: Src, args: &Bytes, alen: u64, total: u64, lazy: bool) -> Space
  requires mem_ok(m) && store_ok(txt) && vfs_ok(v) && ptab_ok(procs) && pid < NPROC && alen <= total && total <= ARGS_MAX && total <= blen(args)
  ensures mem_ok(m) && store_ok(txt) && vfs_ok(v) && ptab_ok(procs)
  ensures result is Space::Mapped ==> pt_level(result.Mapped) == 4
{
  // A built-in image is a Linux ELF executable or a BastiOS image; a file
  // must be ELF. Check the headers before taking anything.
  let img = prog_image(src.prog);
  let elf = src.file || is_elf(img);
  let e = elf_parse(&mut v, src);
  let mut size = 0;
  let mut entry = e.entry;
  let mut rsp = USER_BASE + elf_sp(args, alen, total);
  let mut isrc = Src { file: false, prog: NPROGS, f: 0, size: 0 };
  let mut ie = bad_elf();
  let mut mmap_top = VDSO_PAGE * 4096;     // the vDSO's page is above it
  let mut lz = lz_none();
  if elf {
    if !e.ok {
      return Space::Empty;
    }
    if lazy {
      lz = lazy_plan(&mut v, src, e);
    }
    if e.ilen != 0 {
      // A dynamically linked program: its interpreter goes just below
      // where mmap starts, and runs first.
      isrc = isrc0;
      if !isrc.file {
        isrc = interp_src(&mut v, src, e);
      }
      if !isrc.file && isrc.prog >= NPROGS {
        return Space::Empty;
      }
      let probe = elf_parse(&mut v, isrc);
      let low = (e.end + 4095) / 4096 * 4096;
      if !probe.ok || probe.bias != USER_BASE || probe.ilen != 0 || low > VDSO_PAGE * 4096 || probe.end > VDSO_PAGE * 4096 - low {
        return Space::Empty;
      }
      let place = (VDSO_PAGE * 4096 - probe.end) / 4096 * 4096;
      ie = elf_parse_at(&mut v, isrc, place);
      if !ie.ok {
        return Space::Empty;
      }
      entry = ie.entry;
      mmap_top = place;
    }
  } else {
    // The BastiOS header: magic, bytes of memory the image needs, entry point.
    if slen(img) < 24 || slen(img) > IMAGE_MAX {
      return Space::Empty;
    }
    size = read_u64(img, 8);
    entry = read_u64(img, 16);
    rsp = USER_BASE + USER_SIZE;
    if read_u64(img, 0) != MAGIC || size < slen(img) || size > IMAGE_MAX {
      return Space::Empty;
    }
    if entry < USER_BASE + 24 || entry >= USER_BASE + slen(img) {
      return Space::Empty;
    }
  }
  let sp = build_space(&mut m, &mut txt, &mut v, src, img, elf, e, isrc, ie, lz, size, args, alen, total, seed, t, epoch);
  if sp is Space::Empty {
    return sp;
  }
  let mut r = 0;
  while r < 21
    invariant r <= 21 && ptab_ok(procs)
  {
    pset(&mut procs, pid, F_REGS + r, 0);
    r = r + 1;
  }
  pset(&mut procs, pid, F_PROG, NPROGS);       // a file: NPROGS + 1 + its handle, for /proc/PID/exe
  if src.file && src.f < HFILES {
    pset(&mut procs, pid, F_PROG, NPROGS + 1 + src.f);
  }
  if !src.file {
    pset(&mut procs, pid, F_PROG, src.prog);
  }
  pset(&mut procs, pid, F_REGS + R_RIP, entry);
  pset(&mut procs, pid, F_REGS + R_RSP, rsp);
  pset(&mut procs, pid, F_REGS + R_RFLAGS, 0x202);
  pset(&mut procs, pid, F_BRK, 0);
  pset(&mut procs, pid, F_BRK0, 0);
  pset(&mut procs, pid, F_MMAP, 0);
  if elf {
    // The heap starts on the page after the image; mmap takes pages
    // downward from the stack. Both stay in the window below the stack.
    pset(&mut procs, pid, F_BRK, (e.end + 4095) / 4096 * 4096);
    pset(&mut procs, pid, F_BRK0, (e.end + 4095) / 4096 * 4096);
    pset(&mut procs, pid, F_MMAP, mmap_top);
  }
  return sp;
}

/// The interpreter program `e` (from `src`) names: the file at that path,
/// or, for musl's /lib/ld-musl-x86_64.so.1 when no such file exists, the
/// built-in copy. Not found: a built-in Src with prog NPROGS.
fn interp_src(v: &mut Vfs, src: Src, e: Elf) -> Src
  requires vfs_ok(v) && e.ok && elf_fits(src.size, e)
  ensures vfs_ok(v)
{
  let none = Src { file: false, prog: NPROGS, f: 0, size: 0 };
  let ilen = e.ilen;
  if ilen < 2 || !src_read(&mut v, src, e.interp, ilen) {
    return none;
  }
  // The path ends in a NUL; a leading '/' is dropped, as the file layer
  // names files from the root.
  let mut n = ilen - 1;
  if cast[u64](bget(v.xfer, n)) != 0 {
    return none;
  }
  let mut skip = 0;
  if cast[u64](bget(v.xfer, 0)) == 47 {
    skip = 1;
  }
  let mut i = 0;
  while i + skip < n
    invariant i <= n && n < INTERP_MAX && skip <= 1 && vfs_ok(v)
  {
    bset(&mut v.xfer, i, bget(v.xfer, i + skip));
    i = i + 1;
  }
  n = n - skip;
  if n == 0 || n > FNAME_MAX {
    return none;
  }
  let musl = xfer_is(v.xfer, 0, n, "lib/ld-musl-x86_64.so.1");
  let f = vfs_lookup(&mut v, n);
  if f != NO_FILE {
    let size = vfs_size(&mut v, f);
    if size != NO_FILE {
      return Src { file: true, prog: NPROGS, f: f, size: size };
    }
  }
  if musl {
    return Src { file: false, prog: LDSO_PROG, f: 0, size: slen(prog_image(LDSO_PROG)) };
  }
  return none;
}

/// The address space for a checked image: ELF, or a BastiOS image needing
/// `size` bytes of memory.
fn build_space(m: &mut Mem, txt: &mut Store, v: &mut Vfs, src: Src, img: Str, elf: bool, e: Elf, isrc: Src, ie: Elf, lz: Lz, size: u64, args: &Bytes, alen: u64, total: u64, seed: u64, t: Tsc, epoch: u64) -> Space
  requires mem_ok(m) && store_ok(txt) && vfs_ok(v) && (elf ==> (e.ok && elf_fits(src.size, e) && elf_fits(isrc.size, ie))) && (!elf ==> size <= IMAGE_MAX)
  requires alen <= total && total <= ARGS_MAX && total <= blen(args)
  ensures mem_ok(m) && store_ok(txt) && vfs_ok(v)
  ensures result is Space::Mapped ==> pt_level(result.Mapped) == 4
{
  if elf {
    return elf_space(&mut m, &mut txt, &mut v, src, e, isrc, ie, lz, args, alen, total, seed, t, epoch);
  }
  return new_space(&mut m, img, size);
}

/// Ends process `pid` with exit `code`: frees its address space, closes its
/// files, hands the code to a parent waiting for it, and orphans its
/// children.
/// A child of the thread group led by g has ended: wakes each of its threads
/// in a wait4 or waitid, which tries again (a child belongs to the group,
/// not to the thread that made it).
fn wake_waiters(k: &mut Kernel, g: u64)
  requires kok(k) && g < NPROC
  ensures kok(k)
{
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if state(k.procs, q) == LXWAITING && (q == g || pget(k.procs, q, F_TGID) == g) {
      pset(&mut k.procs, q, F_STATE, READY);
    }
    q = q + 1;
  }
}

fn terminate(k: &mut Kernel, mmu: &Mmu, who: u64, code0: u64)
  requires kok(k) && 1 <= who && who < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  // A thread ends its whole group, which ends as its leader. If threads
  // on other processors must come back first, the leader keeps the code
  // (+ EXIT_PENDING): the first exit wins, as Linux's group exit code,
  // not the 137 of the last killed thread to come back.
  let mut code = code0;
  let mut g = 0;
  if pget(k.procs, who, F_TGID) != 0 {
    g = tgid(k.procs, who);
    let pend = pget(k.procs, g, F_CODE);
    if pend >= EXIT_PENDING && pend - EXIT_PENDING < EXIT_PENDING {
      code = pend - EXIT_PENDING;
    }
  }
  let pid = group_end(&mut k, mmu, who);
  if pid == 0 {
    if g != 0 && code < EXIT_PENDING {
      pset(&mut k.procs, g, F_CODE, code + EXIT_PENDING);
    }
    return;
  }
  map_drop_all(&mut k, pid);                 // shared file pages go back first
  vfork_give_back(&mut k, mmu, pid);         // a borrowed address space goes home
  match take_space(&mut k.spaces, pid) {
    Space::Empty => {},
    Space::Mapped(t) => { free_space(&mut k.mem, mmu, t); },
  }
  drop_fpu(&mut k.mem, take_fpu(&mut k.fpus, pid));
  k.alarms = set(k.alarms, 2 * pid, 0);   // its timers stop
  ptimer_clear(&mut k, pid);
  sem_exit(&mut k, pid);                   // its SEM_UNDO adjustments
  shm_drop_all(&mut k, pid);               // and its shared memory attachments
  lx_fd_close_all(&mut k, pid, false);
  close_unshared(&mut k, pid);
  pr_exit(&mut k, pid);                    // children asking for a parent-death signal
  netns_exit(&mut k, pid);                 // its network namespace ends with its last process
  pset(&mut k.procs, pid, F_STATE, ZOMBIE);
  pset(&mut k.procs, pid, F_CODE, code);
  pidns_exit(&mut k, pid);                 // the init of a PID namespace takes the rest with it
  let mut np = pidns_init(k, pid);         // orphans in a PID namespace go to its init
  if np == 0 {
    np = pr_reaper(k, pid);                // else to the nearest child subreaper (src/lxprctl.bastio)
  }
  let mut c = 1;
  while c < NPROC
    invariant 1 <= c && c <= NPROC && kok(k) && np < NPROC
  {
    if pget(k.procs, c, F_PARENT) == pid && state(k.procs, c) != FREE {
      if np != 0 && np != c {
        pset(&mut k.procs, c, F_PARENT, np);
        if state(k.procs, c) == ZOMBIE {
          wake_waiters(&mut k, np);           // its wait4 collects the zombie
          child_ended(&mut k, np, c);
        }
      } else {
        pset(&mut k.procs, c, F_PARENT, 0);
        if state(k.procs, c) == ZOMBIE {
          pset(&mut k.procs, c, F_STATE, FREE);
        }
      }
    }
    c = c + 1;
  }
  let par = pget(k.procs, pid, F_PARENT);
  if 1 <= par && par < NPROC {
    let pg = pget(k.procs, par, F_TGID);
    if pg != 0 && pg < NPROC {
      wake_waiters(&mut k, pg);
    } else {
      wake_waiters(&mut k, par);
    }
  }
  if par == 0 || par >= NPROC {
    pset(&mut k.procs, pid, F_STATE, FREE);       // nobody will collect it
  } else if state(k.procs, par) == WAITING && pget(k.procs, par, F_WAIT) == pid {
    pset(&mut k.procs, par, F_REGS + R_RAX, shown_code(code));
    pset(&mut k.procs, par, F_STATE, READY);
    pset(&mut k.procs, pid, F_STATE, FREE);
  } else if state(k.procs, par) == LXWAITING {
    // wait4 restarts its system call, which collects the zombie itself.
    wake_waiters(&mut k, par);
  } else if state(k.procs, par) == FREE || state(k.procs, par) == ZOMBIE {
    pset(&mut k.procs, pid, F_STATE, FREE);
  }
  let tw = tr_tracer(k, pid);
  if tw != 0 && tw <= NPROC && state(k.procs, pid) == ZOMBIE {
    // Its tracer, when not its parent, hears of the end too (wait4 reports it once).
    if tw - 1 != par && state(k.procs, tw - 1) == LXWAITING {
      pset(&mut k.procs, tw - 1, F_STATE, READY);
    }
  }
  if 1 <= par && par < NPROC {
    child_ended(&mut k, par, pid);
  }
}

fn put_state(con: &mut Con, s: u64)
  requires con_ok(con)
  ensures con_ok(con)
{
  if s == READY {
    puts(&mut con, "ready  ");
  } else if s == READING || s == LXREADING {
    puts(&mut con, "reading");
  } else if s == WAITING || s == LXWAITING {
    puts(&mut con, "waiting");
  } else if s == RUNNING || s == KILLED || s == EXITING {
    puts(&mut con, "running");
  } else if s == FUTEXWAIT {
    puts(&mut con, "futex  ");
  } else if s == CONWAIT {
    puts(&mut con, "writing");
  } else if s == NETWAIT {
    puts(&mut con, "netwait");
  } else if s == DISKWAIT {
    puts(&mut con, "disk   ");
  } else if s == SOCKWAIT {
    puts(&mut con, "socket ");
  } else if s == TIMEWAIT {
    puts(&mut con, "sleep  ");
  } else if s == LXVFORK {
    puts(&mut con, "vfork  ");
  } else {
    puts(&mut con, "zombie ");
  }
}

fn print_ps(con: &mut Con, procs: &Buf)
  requires con_ok(con) && ptab_ok(procs)
  ensures con_ok(con)
{
  puts(&mut con, "  PID  PPID STATE    TICKS NAME\r\n");
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && con_ok(con)
  {
    if state(procs, p) != FREE {
      put_num_pad(&mut con, p, 5);
      put_num_pad(&mut con, pget(procs, p, F_PARENT), 6);
      puts(&mut con, " ");
      put_state(&mut con, state(procs, p));
      put_num_pad(&mut con, pget(procs, p, F_TICKS), 6);
      puts(&mut con, " ");
      puts(&mut con, prog_name(pget(procs, p, F_PROG)));
      puts(&mut con, "\r\n");
    }
    p = p + 1;
  }
}
