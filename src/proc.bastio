// Processes. The table is one buffer with a row of STRIDE words per
// process; the process id is the row number (1 to NPROC - 1). A process's
// address space is element `pid` of a vector of spaces.

import "console.bastio";
import "pages.bastio";
import "space.bastio";
import "elf.bastio";
import "fs.bastio";
import "net.bastio";
import "tcp.bastio";
import "netns.bastio";
import "rtnl.bastio";
import "hda.bastio";

// The most processes; the tables grow to it (new_pid). Raising it: the
// literals FD_ROWS (src/fs.bastio), IPC_LEN, SYS_LEN and the SYS_* offsets,
// ALARMS_LEN and HOLES_LEN follow it, and a
// signal's sender word keeps the pid in 8 bits (post_from, src/lxsig.bastio).
const NPROC: u64 = 256;
const STRIDE: u64 = 72;
const PTAB_LEN: u64 = NPROC * STRIDE;   // the most the table grows to
const PGROW: u64 = 32;               // rows the process table starts with (it doubles from there)

// Row fields.
const F_STATE: u64 = 0;
const F_WAIT: u64 = 1;               // the child a WAITING process waits for
const F_CODE: u64 = 2;               // exit code of a ZOMBIE
const F_PARENT: u64 = 3;
const F_PROG: u64 = 4;               // index into the program table; NPROGS + 1 + a vfs handle for a file
const F_TICKS: u64 = 5;              // timer ticks spent running
const F_BRK: u64 = 6;                // Linux: window offset of the program break
const F_MMAP: u64 = 7;               // Linux: window offset of the lowest mmap page
const F_REGS: u64 = 8;               // 21 saved words, in `cpu_get` order
// Linux signals (src/lxsig.bastio): blocked and pending sets (bit s - 1
// for signal s), and nonzero while rip points back at a system call that
// will run again (a wait), which a signal handler may interrupt instead:
// 1, or 2 + the HPET time a timed wait ends at (src/lxtime.bastio).
const F_SIGMASK: u64 = 29;
const F_SIGPEND: u64 = 30;
const F_RESTART: u64 = 31;
// Linux threads (src/lxthread.bastio): the group's leader (0: no threads),
// the clear_child_tid address, and the address a futex wait waits on.
const F_TGID: u64 = 32;
const F_CTID: u64 = 33;
const F_FUTEX: u64 = 34;
// Linux process groups and sessions (src/lxsig.bastio): the group and the
// session, 0 meaning the process's own pid.
const F_PGID: u64 = 35;
const F_SID: u64 = 36;
// Nonzero while a Linux thread waits for the other threads of its group to
// leave the processors, to change their shared page tables (src/lxmem.bastio).
const F_QUIET: u64 = 37;
// Nonzero while a Linux process runs a system call again and again until
// what it waits for comes (lx_retry): /proc shows it asleep, as Linux would
// have it, though it is READY or RUNNING (src/lxprocfs.bastio).
const F_ASLEEP: u64 = 39;
// The personality(2) value, kept and handed back; nothing acts on it.
const F_PERSONA: u64 = 38;
// A Linux thread's alternate signal stack (sigaltstack): its address and
// size; size 0 means none (src/lxsig.bastio).
const F_ALTSP: u64 = 40;
const F_ALTSIZE: u64 = 41;
// setitimer's CPU-time timers (src/lxtime.bastio): ns left and the
// interval, for ITIMER_VIRTUAL and then ITIMER_PROF; 0 left is off.
const F_VTIMER: u64 = 42;
const F_PTIMER: u64 = 44;
// Credentials (src/lxcred.bastio), two 32-bit ids a word: real and
// effective user, saved and file-system user, then the same for groups.
// All 0 (root) at boot; a fork, a thread or a native spawn copies them
// (docs/security.md).
const F_UID: u64 = 46;
const F_SUID: u64 = 47;
const F_GID: u64 = 48;
const F_SGID: u64 = 49;
// While a semop waits: which semaphore, and for what (src/lxipc.bastio).
const F_IPCW: u64 = 50;
// A Linux process's umask plus 1; 0 means 0022 (src/lxperm.bastio).
const F_UMASK: u64 = 51;
// Supplementary groups (src/lxcred.bastio): how many, then up to
// NGROUPS_KEPT ids, two 32-bit ids a word.
const F_NGROUPS: u64 = 52;
const F_GROUPS: u64 = 53;
const NGROUPS_KEPT: u64 = 16;
// Scheduling (src/lxprio.bastio): the nice value plus 21, 0 meaning nice
// 0; and the policy plus 256 times its static priority. Only kept and
// handed back: the scheduler treats every process alike.
const F_NICE: u64 = 61;
const F_SCHED: u64 = 62;
const F_BRK0: u64 = 63;              // Linux: where the program break started (brk goes no lower)
// Namespaces: an index per kind, 0 the one the machine boots in. A fork or
// a thread keeps its parent's (the whole row is copied); a native spawn
// starts in the first ones. Words 65 .. 71 are for the other kinds.
const F_START: u64 = 65;             // when it started: centiseconds since boot, plus 1 (/proc/PID/stat)
const F_NETNS: u64 = 64;             // network (src/netns.bastio, src/lxnetlink.bastio)
// File permission bits (src/lxperm.bastio).
const MAY_X: u64 = 1;
const MAY_W: u64 = 2;
const MAY_R: u64 = 4;
const S_ISVTX: u64 = 512;            // sticky: only a name's owner may remove it
const S_ISGID: u64 = 1024;
const S_ISUID: u64 = 2048;
const SIG_DEATH: u64 = 256;          // F_CODE of a process a signal ended: 256 + the signal
const EXIT_PENDING: u64 = 4294967296;  // F_CODE of a group leader whose exit waits for its threads: 2^32 + the code

/// The exit code sys_wait reports for F_CODE `code`: 128 + the signal for
/// a process a signal ended, as a Linux shell shows it.
fn shown_code(code: u64) -> u64 {
  if code >= SIG_DEATH {
    return 128 + code % 128;
  }
  return code;
}

// Saved register numbers.
const R_RAX: u64 = 0;
const R_RDX: u64 = 3;
const R_RSI: u64 = 4;
const R_RDI: u64 = 5;
const R_R8: u64 = 7;
const R_R9: u64 = 8;
const R_R10: u64 = 9;
const R_RIP: u64 = 15;
const R_RSP: u64 = 16;
const R_RFLAGS: u64 = 17;
const R_FSBASE: u64 = 20;

// States.
const FREE: u64 = 0;
const READY: u64 = 1;
const READING: u64 = 2;
const WAITING: u64 = 3;
const ZOMBIE: u64 = 4;
const LXREADING: u64 = 5;            // blocked in a Linux read of the console
const LXWAITING: u64 = 6;            // blocked in a Linux wait4 for any child
const RUNNING: u64 = 7;              // on a processor (with a lease on its space): its FPU page is out
const KILLED: u64 = 8;               // RUNNING, and killed: ends when it comes back
const NETWAIT: u64 = 9;              // waiting for the network (a ping's reply)
const LXVFORK: u64 = 10;             // lent its address space to child F_WAIT (clone with CLONE_VM | CLONE_VFORK)
const CONWAIT: u64 = 11;             // writing to the console, whose ring is full
const FUTEXWAIT: u64 = 12;           // in a Linux futex wait with no timeout
const DISKWAIT: u64 = 13;            // waiting for the disk: F_WAIT says for what (disk_wake)
const EXITING: u64 = 14;             // RUNNING, a thread whose leader is in execve: freed when it comes back
const SOCKWAIT: u64 = 15;            // a Linux call that has to wait: a network socket, or a poll, epoll_wait or sigsuspend (sock_wake)
const STOPPED: u64 = 16;             // stopped by SIGSTOP, SIGTSTP, SIGTTIN or SIGTTOU until SIGCONT
const TIMEWAIT: u64 = 17;            // a timed Linux wait (wait_until) between two tries: see sleepers_wake

const NO_RESULT: u64 = 18446744073709551615;

// The table holds rows for the process ids below its capacity
// (len / STRIDE), and grows by whole rows (grow_procs) up to NPROC. A row
// past the end reads as all 0, a FREE process; writing one changes
// nothing, and new_pid hands out no id the table has no row for.
spec fn ptab_ok(procs: &Buf) -> bool {
  len(procs) <= PTAB_LEN
}

// The other per-process tables (k.sigact, k.cwd, k.sigsave) grow with the
// process table, and are read and written the same way: past the end, a
// word reads as 0 and a write changes nothing.
fn wget(t: &Buf, i: u64) -> u64 {
  if i < len(t) {
    return get(t, i);
  }
  return 0;
}

fn wset(t: &mut Buf, i: u64, v: u64)
  ensures len(t) == old(len(t))
{
  if i < len(t) {
    t = set(t, i, v);
  }
}

fn pget(procs: &Buf, pid: u64, f: u64) -> u64
  requires ptab_ok(procs) && pid < NPROC && f < STRIDE
{
  let i = pid * STRIDE + f;
  if i < len(procs) {
    return get(procs, i);
  }
  return 0;
}

fn pset(procs: &mut Buf, pid: u64, f: u64, v: u64)
  requires ptab_ok(procs) && pid < NPROC && f < STRIDE
  ensures len(procs) == old(len(procs))
{
  let i = pid * STRIDE + f;
  if i < len(procs) {
    procs = set(procs, i, v);
  }
}

fn state(procs: &Buf, pid: u64) -> u64
  requires ptab_ok(procs) && pid < NPROC
{
  return pget(procs, pid, F_STATE);
}

/// Processes that are not FREE or ZOMBIE.
fn live_count(procs: &Buf) -> u64
  requires ptab_ok(procs)
{
  let cap = len(procs) / STRIDE;     // past it, every process is FREE
  let mut n = 0;
  let mut p = 1;
  while p < cap
    invariant 1 <= p && n <= p && cap <= NPROC
  {
    let s = state(procs, p);
    if s != FREE && s != ZOMBIE {
      n = n + 1;
    }
    p = p + 1;
  }
  return n;
}

/// The next READY process at or after `from` (round robin), or 0 if none.
fn pick(procs: &Buf, from: u64) -> u64
  requires ptab_ok(procs)
  ensures result < NPROC
{
  let cap = len(procs) / STRIDE;     // past it, every process is FREE
  if cap == 0 {
    return 0;
  }
  let mut k = 0;
  while k < cap
    invariant k <= cap && cap <= NPROC
  {
    let p = (from % cap + k) % cap;
    if p != 0 && state(procs, p) == READY {
      return p;
    }
    k = k + 1;
  }
  return 0;
}

// ---------------------------------------------------------------- address spaces

/// One slot per process id; every address space is a level-4 table.
spec fn spaces_ok(s: &Vec[Space]) -> bool {
  vlen(s) == NPROC && forall i: u64 :: i < NPROC ==> (vget(s, i) is Space::Mapped ==> pt_level(vget(s, i).Mapped) == 4)
}

/// Takes process `pid`'s address space out, leaving its slot empty.
fn take_space(s: &mut Vec[Space], pid: u64) -> Space
  requires spaces_ok(s) && pid < NPROC
  ensures spaces_ok(s) && vget(s, pid) is Space::Empty
  ensures result is Space::Mapped ==> pt_level(result.Mapped) == 4
{
  return vec_swap(&mut s, pid, Space::Empty);
}

/// Puts an address space into an empty slot.
fn put_space(s: &mut Vec[Space], pid: u64, x: Space)
  requires spaces_ok(s) && pid < NPROC && vget(s, pid) is Space::Empty
  requires x is Space::Mapped ==> pt_level(x.Mapped) == 4
  ensures spaces_ok(s)
{
  match vec_swap(&mut s, pid, x) {
    Space::Empty => {},
    Space::Mapped(_t) => { unreachable; },     // the slot was empty
  }
}

/// Puts an address space back into slot `pid`. The slot is empty unless
/// the scheduler has a bug; whatever was there is freed.
fn restore_space(m: &mut Mem, s: &mut Vec[Space], mmu: &Mmu, pid: u64, x: Space)
  requires mem_ok(m) && spaces_ok(s) && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  requires x is Space::Mapped ==> pt_level(x.Mapped) == 4
  ensures mem_ok(m) && spaces_ok(s)
{
  match vec_swap(&mut s, pid, x) {
    Space::Empty => {},
    Space::Mapped(t) => { free_space(&mut m, mmu, t); },
  }
}

// ---------------------------------------------------------------- FPU state

// A process's x87/SSE registers, saved in a page of their own while it is
// not running. Element `pid` of a vector, like the address spaces.
enum Fpu { None, State(Frame) }

spec fn fpus_ok(s: &Vec[Fpu]) -> bool {
  vlen(s) == NPROC
}

/// Takes process `pid`'s FPU state out, leaving its slot empty.
fn take_fpu(s: &mut Vec[Fpu], pid: u64) -> Fpu
  requires fpus_ok(s) && pid < NPROC
  ensures fpus_ok(s) && vget(s, pid) is Fpu::None
{
  return vec_swap(&mut s, pid, Fpu::None);
}

/// Puts FPU state into an empty slot.
fn put_fpu(s: &mut Vec[Fpu], pid: u64, x: Fpu)
  requires fpus_ok(s) && pid < NPROC && vget(s, pid) is Fpu::None
  ensures fpus_ok(s)
{
  match vec_swap(&mut s, pid, x) {
    Fpu::None => {},
    Fpu::State(_f) => { unreachable; },     // the slot was empty
  }
}

/// Puts FPU state back into slot `pid`. The slot is empty unless the
/// scheduler has a bug; whatever was there goes back to the allocator.
fn restore_fpu(m: &mut Mem, s: &mut Vec[Fpu], pid: u64, x: Fpu)
  requires mem_ok(m) && fpus_ok(s) && pid < NPROC
  ensures mem_ok(m) && fpus_ok(s)
{
  drop_fpu(&mut m, vec_swap(&mut s, pid, x));
}

/// Gives the page of FPU state `x`, if any, back to the allocator.
fn drop_fpu(m: &mut Mem, x: Fpu)
  requires mem_ok(m)
  ensures mem_ok(m)
{
  match x {
    Fpu::None => {},
    Fpu::State(f) => { give_page(&mut m, f); },
  }
}

/// The x87/SSE state a Linux process starts with: control word 0x37F and
/// MXCSR 0x1F80 (every exception masked, round to nearest).
fn fpu_init(f: &mut Frame) {
  frame_write8(&mut f, 0, 0x7F);
  frame_write8(&mut f, 1, 0x03);
  frame_write8(&mut f, 24, 0x80);
  frame_write8(&mut f, 25, 0x1F);
}

// ---------------------------------------------------------------- input queue

// Bytes typed on the console, waiting for a READ: a core Queue of
// INQ_CAP bytes, one to a word. It holds a whole long line pasted at once
// (as Linux's 4096-byte tty buffer does), not just 256.
const INQ_CAP: u64 = 4096;

spec fn qok(q: &Queue) -> bool {
  queue_ok(q) && q.r.cap == INQ_CAP
}

// The terminal line for Linux programs: word 0 is how many bytes it holds
// (at most LINE_MAX), word 1 is 1 once it is finished (Enter or Ctrl-D;
// in noncanonical mode, as soon as it holds a byte), and the bytes follow
// from word 2. Like Linux's 4096-byte canonical line; one read moves it
// whole (XFER). After it, the terminal's settings: word TT_SET is 1 once a
// program has set them (TCSETS), and the TERMIOS_SIZE bytes of its struct
// termios follow from word TT0, one to a word (src/linux.bastio's tt_byte).
const LINE_MAX: u64 = 4095;
const TT_SET: u64 = 4097;             // LINE_MAX + 2
const TT0: u64 = 4098;
const TERMIOS_SIZE: u64 = 36;         // the kernel's struct termios
const LINE_LEN: u64 = 4134;           // TT0 + TERMIOS_SIZE

spec fn lineok(l: &Buf) -> bool {
  len(l) == LINE_LEN && get(l, 0) <= LINE_MAX && get(l, 1) <= 1
}

/// Appends byte b, or drops it when the queue is full.
fn q_push(q: &mut Queue, b: u64)
  requires qok(q)
  ensures qok(q)
{
  if q.r.n < INQ_CAP {
    queue_push(&mut q, b);
  }
}

/// The oldest byte, or 256 if there is none.
fn q_pop(q: &mut Queue) -> u64
  requires qok(q)
  ensures qok(q)
{
  if q.r.n == 0 {
    return 256;
  }
  return queue_pop(&mut q);
}

/// Hands queued bytes to processes blocked in READ, and wakes processes
/// blocked in a Linux read once a whole line is typed.
fn wake_readers(procs: &mut Buf, q: &mut Queue, line: &Buf)
  requires ptab_ok(procs) && qok(q) && lineok(line)
  ensures ptab_ok(procs) && qok(q)
{
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && ptab_ok(procs) && qok(q)
  {
    if state(procs, p) == READING && q.r.n > 0 {
      pset(&mut procs, p, F_REGS + R_RAX, q_pop(&mut q));
      pset(&mut procs, p, F_STATE, READY);
    }
    // A Linux read restarts its system call, which takes the line itself.
    if state(procs, p) == LXREADING && get(line, 1) == 1 {
      pset(&mut procs, p, F_STATE, READY);
    }
    p = p + 1;
  }
}

// ---------------------------------------------------------------- kernel state

// Everything the kernel owns, in one place. `mmu` and `cpu` stay with
// `main`, which lends them where they are needed.
// Linux file descriptors (src/lxfd.bastio).
const LXNFD: u64 = 256;
const LXFD_LEN: u64 = NPROC * LXNFD;
const FD_CONSOLE: u64 = 1;
const FD_OFD: u64 = 2;
const FD_CLOEXEC: u64 = 1024;

const OFD_N: u64 = 1024;
// Loop devices (src/lxloop.bastio): LOOP_N devices of LOOP_W words.
const LOOP_N: u64 = 8;
const LOOP_W: u64 = 13;
const LOOP_LEN: u64 = 104;             // LOOP_N * LOOP_W
const DEV_LOOPCTL: u64 = 6;            // OF_DEV device /dev/loop-control
const DEV_LOOP: u64 = 16;              // OF_DEV device /dev/loopN is DEV_LOOP + N
const S_IFBLK: u64 = 0x61B0;           // a block device, rw-rw----
// Pseudo-terminals (src/lxpty.bastio): PTY_N pairs of PTY_W words, and two
// rings of PTY_CAP bytes each.
const PTY_N: u64 = 4;
const PTY_W: u64 = 53;                 // 16 + TERMIOS_SIZE, then the window's size in pixels
const PTY_LEN: u64 = 212;              // PTY_N * PTY_W
const PTY_CAP: u64 = 4096;
const PTYB_LEN: u64 = 32768;          // 2 * PTY_N * PTY_CAP
const TCSETA: u64 = 0x5406;           // TCSETAW and TCSETAF follow
const TCSETAF: u64 = 0x5408;
const TIOCSETD: u64 = 0x5423;
const TIOCGETD: u64 = 0x5424;
const DEV_PTMX: u64 = 7;               // OF_DEV path /dev/ptmx (opening it makes a pair)
const DEV_PTSDIR: u64 = 8;             // /dev/pts, a directory to stat
const DEV_DSP: u64 = 9;                // OF_DEV device /dev/dsp, the sound card (src/lxsnd.bastio)
const DEV_MICE: u64 = 10;               // OF_DEV device /dev/input/mice and /dev/psaux (src/lxmouse.bastio)
const MICE_LEN: u64 = 824;              // its packets: a 56-byte header and 192 packets of 4 bytes
const DEV_PTM: u64 = 32;               // an OF_PTY master is DEV_PTM + N
const DEV_PTS: u64 = 48;               // and its slave, /dev/pts/N, DEV_PTS + N
const DISK_GID: u64 = 6;               // group disk (files/group): the loop devices'

// File locks (src/lxlock.bastio): LK_N entries of LK_W words, then for
// each process the record lock it waits for in F_SETLKW, LK_WW words.
const LK_N: u64 = 128;
const LK_W: u64 = 6;
const LK_WAITS: u64 = 768;            // LK_N * LK_W
const LK_WW: u64 = 4;
const LK_LEN: u64 = LK_WAITS + NPROC * LK_WW;
const IPC_LEN: u64 = 9984;            // System V IPC words: SA_BASE + NPROC * SA_N * SA_W (src/lxipc.bastio)
const RNG_LEN: u64 = 19;              // the random generator's words (src/lxdev.bastio)
const SYS_LEN: u64 = 16256;            // host and domain names, adjtimex state (src/lxsys.bastio), then from SYS_PQ the POSIX queues (src/lxmq.bastio), then from SYS_PR prctl state (src/lxprctl.bastio), then from SYS_RL resource limits, then from SYS_DL SCHED_DEADLINE parameters (src/lxprio.bastio), then from SYS_JC stop reports, then from SYS_TM CPU times, then from SYS_RB robust futex lists, then from SYS_CAP capabilities, then from SYS_IOP I/O priorities, then from SYS_AT access times (src/lxmisc.bastio), then from SYS_LR locked ranges (src/lxrlimit.bastio), then from SYS_PT a word per process for ptrace (src/lxptrace.bastio), then from SYS_SEAL the memfd seals (src/lxmore.bastio)
const SYS_PQ: u64 = 160;
const SYS_PR: u64 = 256;               // SYS_PQ + PQ_N * 12; NPROC * PR_W words
const SYS_RL: u64 = 1536;               // SYS_PR + NPROC * PR_W; NPROC * RL_W words (src/lxrlimit.bastio)
const SYS_DL: u64 = 10240;              // SYS_RL + NPROC * RL_W; NPROC * 3 words
const SYS_JC: u64 = 11008;              // SYS_DL + NPROC * 3; a word per process (job control, src/lxsig.bastio)
const SYS_TM: u64 = 11264;              // SYS_JC + NPROC; NPROC * 3 words (system and children's times, src/lxrlimit.bastio)
const SYS_RB: u64 = 12032;              // SYS_TM + NPROC * 3; a word per thread (robust futex list head, src/lxthread.bastio)
const SYS_CAP: u64 = 12288;             // SYS_RB + NPROC; NPROC * CAP_W words (capabilities, src/lxcap.bastio)
const SYS_PIPEMAX: u64 = 150;          // /proc/sys/fs/pipe-max-size (0: PIPE_CAP), past the adjtimex words (src/lxsys.bastio)
const SYS_AT: u64 = 13568;             // SYS_IOP + NPROC; AT_N entries of 3 words: handle + 1, access time, the modification time it was set against
const AT_N: u64 = 32;
const SYS_LR: u64 = 13664;             // SYS_AT + AT_N * 3; NPROC * LR_N ranges of 2 words
const LR_N: u64 = 4;
// ptrace (src/lxptrace.bastio): process p's word in k.sys from SYS_PT holds
// its tracer + 1 in the low 16 bits (0: not traced) and the flags below.
const SYS_PT: u64 = 15712;             // SYS_LR + NPROC * LR_N * 2; a word per process
const SYS_SEAL: u64 = 15968;           // SYS_PT + NPROC; SEAL_N memfds of 2 words: file + 1 (0: free), seals
const SEAL_N: u64 = 16;
// Its second word, from SYS_PT2, is for system call stops: TS_SYS to stop at
// each system call (PTRACE_SYSCALL), TS_ENTRY while stopped before one,
// TS_NOENT to let the next one start, TS_EXIT while stopped after one, and
// the call's number times TS_NR.
const SYS_PT2: u64 = 16000;            // SYS_SEAL + SEAL_N * 2; a word per process
const TS_SYS: u64 = 1;
const TS_ENTRY: u64 = 2;
const TS_NOENT: u64 = 4;
const TS_EXIT: u64 = 8;
const TS_STEP: u64 = 16;               // PTRACE_SINGLESTEP: the trap flag is set until the next stop
const TS_NR: u64 = 256;                // times a number below 1024
const TS_EV: u64 = 1048576;            // times the event of the stop (PTRACE_EVENT_*, below 16)
const TS_MSG: u64 = 16777216;          // times its message (PTRACE_GETEVENTMSG, below 65536)
const PT_ATTACHED: u64 = 65536;        // PTRACE_ATTACH or SEIZE rather than TRACEME
const PT_STOPPED: u64 = 131072;        // in a ptrace-stop: the tracer may read and change it
const PT_SKIP: u64 = 262144;           // the signal about to be delivered was injected: it does not stop again
const PT_SIG: u64 = 16777216;          // the signal that stopped it, times PT_SIG
const PT_OPT: u64 = 4294967296;        // PTRACE_SETOPTIONS: the low 8 bits, then bit 8 for PTRACE_O_EXITKILL, times PT_OPT
const SYS_IOP: u64 = 13312;            // SYS_CAP + NPROC * CAP_W; a word per thread (ioprio_set, src/lxprio.bastio)
// Capabilities the kernel checks (src/lxcap.bastio).
const CAP_SYS_TIME: u64 = 25;
const CAP_SYS_RESOURCE: u64 = 24;
const CAP_SYS_NICE: u64 = 23;
const CAP_IPC_LOCK: u64 = 14;
const CAP_NET_BIND_SERVICE: u64 = 10;
const CAP_SYS_ADMIN: u64 = 21;
const CAP_SETGID: u64 = 6;
const CAP_SETUID: u64 = 7;
const CAP_SYS_BOOT: u64 = 22;
const CAP_SETPCAP: u64 = 8;
const PQ_N: u64 = 8;                   // POSIX message queues (SYS_PQ + PQ_N * 12 words = SYS_LEN)
const IPCB_LEN: u64 = 411648;         // its message bytes, IPC_SETS * MQ_CAP; then the POSIX queues' names and messages, PQ_N * (256 + 16384)
const LK_EOF: u64 = 18446744073709551615;   // a range to the end of the file; no file
const LK_DESC: u64 = 4294967296;      // 2^32: lock owners from here are descriptions
const LKC_FCNTL: u64 = 0;             // record and OFD locks
const LKC_FLOCK: u64 = 1;
const LKC_LEASE: u64 = 3;             // a lease: the whole file, owned by a description
const F_SETLEASE: u64 = 1024;
const F_GETLEASE: u64 = 1025;
const LK_WAIT: u64 = 18446744073709551000;   // not an errno: wait and run the call again
const OFD_STRIDE: u64 = 9;
const OFD_LEN: u64 = 9216;            // OFD_N * OFD_STRIDE
const OF_OWNER: u64 = 4;              // who gets the I/O signal: 0, or (type + 1) * OWN_TYPE + id
const OF_SIG: u64 = 5;                // F_SETSIG's signal (0: SIGIO)
const OF_CRED: u64 = 6;               // the owner setter's real uid * ID_SPAN + effective uid
const OF_ASYNC: u64 = 7;              // 1 with O_ASYNC: signal the owner when input arrives
const OF_ACC: u64 = 8;                // the access an open did not ask for: ACC_NOWRITE, ACC_NOREAD (src/lxfd.bastio)
const ACC_NOWRITE: u64 = 1;
const ACC_NOREAD: u64 = 2;
const OWN_TYPE: u64 = 4294967296;     // 2^32
const OF_FREE: u64 = 0;
const OF_FILE: u64 = 1;
const OF_PIPE_R: u64 = 2;
const OF_PIPE_W: u64 = 3;
const PIPE_BOTH: u64 = 2;              // OF_PIPE_R word 3: also a writer (a FIFO opened O_RDWR)
const OF_DIR: u64 = 4;                // x: DIR_ROOT or DIR_BIN; word 3: next entry
// lx_recvfrom's answer when the caller must wait: no count or errno.
const SK_WAIT: u64 = 0x8000000000000000;
// What lx_write_fd returns when the console's ring has no room for the
// write: not an errno, and never returned to the process.
const CON_FULL: u64 = 0x8000000000000001;
// What a file read or write returns when the disk has not caught up
// (VFS_MISS): the caller sleeps in DISKWAIT and its call restarts.
const DISK_RETRY: u64 = 0x8000000000000002;
// Linux working directories: per process, word 0 the length of the path
// (without the leading "/", at most FNAME_MAX) and one byte a word after.
const CWD_STRIDE: u64 = 256;           // FNAME_MAX + 1
const CWD_LEN: u64 = NPROC * CWD_STRIDE;
const DPATH_LEN: u64 = 262144;        // OFD_N * CWD_STRIDE
const MT_N: u64 = 64;                 // mounts of mount namespaces, in all (src/lxns.bastio)
const ME_W: u64 = 5;                  // words per mount
// After the mounts, k.mns keeps the other namespaces (src/lxns.bastio):
// each process's UTS, IPC and PID namespace, the next id of each kind, the
// host and domain names of UTS namespaces other than the first (whose
// names are in k.sys), and the IPC namespace of each POSIX queue.
const NSK_N: u64 = 7;                 // kinds, per process:
const NSK_UTS: u64 = 0;
const NSK_IPC: u64 = 1;
const NSK_PID: u64 = 2;               //   the PID namespace it is in
const NSK_VPID: u64 = 3;              //   its id in it (0 in the first namespace: its row)
const NSK_PIDC: u64 = 4;              //   the PID namespace its children are in
const NSK_USER: u64 = 5;              //   the user namespace it is in
const NSK_CG: u64 = 6;                //   the cgroup it belongs to (src/lxcgroup.bastio)
const CG_N: u64 = 32;                 // cgroups in all (slot 0 is the root, always there)
const CG_W: u64 = 32;                 // words per cgroup: see CGW_*
const CGW_USED: u64 = 0;
const CGW_PARENT: u64 = 1;
const CGW_PIDS: u64 = 2;              // pids.max + 1 (0: max)
const CGW_MEM: u64 = 3;               // memory.max + 1 (0: max)
const CGW_SUB: u64 = 4;               // cgroup.subtree_control: 1 cpu, 2 memory, 4 pids
const CGW_CPUQ: u64 = 5;              // cpu.max quota + 1 (0: max)
const CGW_CPUP: u64 = 6;              // cpu.max period (0: 100000)
const CGW_WEIGHT: u64 = 7;            // cpu.weight (0: 100)
const CGW_NLEN: u64 = 8;              // length of the name, then its bytes one a word
const CGW_NAME: u64 = 9;
const CG_NAME_MAX: u64 = 22;
const OVERFLOW_ID: u64 = 65534;       // what an id with no map in the reader's user namespace shows as
const UM_BAD: u64 = 0x100000000;      // an id with no map (ID_SPAN)
const UMW_DENY: u64 = 3;              // user namespace slot word: setgroups denied
const UMW_CNT: u64 = 4;               // words 4 and 5: extents of the uid and gid map
const UMW_EXT: u64 = 6;               // then UM_N extents of 3 words (inside, outside, count) for each map
const USR_N: u64 = 8;                 // user namespaces besides the first
const UM_N: u64 = 5;                  // extents of an id map (Linux's UID_GID_MAP_MAX_EXTENTS)
const USR_W: u64 = 6 + 2 * UM_N * 3;  // id + 1 (0: free), owner uid, owner gid, setgroups denied, uid and gid extents, then the extents
const PN_N: u64 = 16;                 // PID namespaces besides the first
const PN_W: u64 = 3;                  // id + 1 (0: free), the next id to give, 1 once its init has ended
const UTS_N: u64 = 8;                 // UTS namespaces besides the first
const UTS_W: u64 = 132;               // id + 1 (0: free), then the names as k.sys keeps them
const MNS_KID: u64 = NPROC + 16 + MT_N * ME_W;   // [MNS_KID + kind * NPROC + pid]
const MNS_KNEXT: u64 = MNS_KID + NSK_N * NPROC;
const MNS_UTS: u64 = MNS_KNEXT + NSK_N;
const MNS_PN: u64 = MNS_UTS + UTS_N * UTS_W;
const MNS_USR: u64 = MNS_PN + PN_N * PN_W;
const MNS_CG: u64 = MNS_USR + USR_N * USR_W;
const MNS_PQ: u64 = MNS_CG + CG_N * CG_W;
const MNS_SC: u64 = MNS_PQ + PQ_N;          // the seccomp pool (src/lxseccomp.bastio)

// Seccomp (src/lxseccomp.bastio). Each process has SC_PW words in k.mns from
// MNS_SC (top filter + 1, flags). The filters live in k.scf, which is empty
// until the first one is loaded: SC_HW words for each of SC_N filters
// (holders, parent + 1, instruction count, in use, first instruction), the
// scratch words a run uses, then SC_POOL instructions for all of them.
const SC_PW: u64 = 2;
const SC_N: u64 = 8;
const SC_HW: u64 = 5;
const SC_MAXI: u64 = 4096;
const SC_SCR: u64 = SC_N * SC_HW;
const SC_SCRN: u64 = 24;
const SC_INS: u64 = SC_SCR + SC_SCRN;
const SC_POOL: u64 = 8192;               // instructions shared by all filters
const SCF_LEN: u64 = SC_INS + SC_POOL + 1;   // and one word that always reads 0
const MNS_LEN: u64 = MNS_SC + NPROC * SC_PW;
const MSTR_LEN: u64 = 256 + MT_N * 512 + 256;   // the last lookup's logical path, then a key and a source per mount, then a path kept by ovl_stash
const AT_FDCWD: u64 = 0xFFFFFF9C;     // -100, as the int it is

// Linux signal actions: per process, 64 signals of 4 words each (handler,
// flags, restorer, mask).
const SIGACT_ROW: u64 = 256;          // per process: four words per signal
const SIGACT_LEN: u64 = NPROC * SIGACT_ROW;
const SIGSAVE_ROW: u64 = 65;          // per process: the saved mask, then a sender per signal (1 + NSIG)
const SIGSAVE_LEN: u64 = NPROC * SIGSAVE_ROW;
const ALARMS_LEN: u64 = 4608;        // NPROC * 2, then PT_N POSIX timers of PT_W words per process
const PT_BASE: u64 = NPROC * 2;             // where the POSIX timers start in k.alarms (src/lxptimer.bastio)
const PT_N: u64 = 4;                 // POSIX timers per process
const PT_W: u64 = 4;                 // words per timer: deadline, interval, state, overruns
const MAP_N: u64 = 4;                // MAP_SHARED file mappings per process
const MAP_W: u64 = 4;                // words per mapping: first page + 1, pages, description, offset
const MAPS_LEN: u64 = NPROC * MAP_N * MAP_W;
const HOLE_N: u64 = 16;              // address space holes munmap left, per process
const HOLES_LEN: u64 = 8192;         // NPROC * HOLE_N * 2
const LZ_W: u64 = 4;                  // lazy code: first page + 1 (0: none), pages, file hold, file offset
const LAZY_LEN: u64 = NPROC * LZ_W;
const AN_N: u64 = 16;                  // anonymous memory not touched yet: records per process (src/lxanon.bastio)
const ANON_LEN: u64 = NPROC * AN_N * 2;  // first page + 1 (0: free), pages
const LX_PAUSE: u64 = 34;
const LX_RT_SIGSUSPEND: u64 = 130;
const LX_WAITID: u64 = 247;
const P_PIDFD: u64 = 3;               // waitid's idtype for a pidfd (src/lxpidfd.bastio)
const LX_TIMES: u64 = 100;
const OF_SOCK: u64 = 5;               // x: the kernel socket; word 3: 2 * peer + nonblocking
const OF_DEV: u64 = 7;                // x: the device (src/lxdev.bastio)
const OF_TCP: u64 = 6;                // x: the kernel connection (TCBS: none yet); word 3: see src/lxtcp.bastio
const OF_EVENT: u64 = 8;              // an eventfd: x the counter; word 3: nonblocking + 2 * semaphore (src/lxevent.bastio)
const OF_TIMER: u64 = 9;              // a timerfd: x the timer; word 3: nonblocking
const OF_EPOLL: u64 = 10;             // an epoll instance: x the instance; word 3: nonblocking
const TFD_N: u64 = 8;                 // timerfds, in k.evt from 0: TFD_STRIDE words each
const TFD_STRIDE: u64 = 4;
const TFD_MAYCANCEL: u64 = 2;         // word 0: 1 (in use), plus this (TFD_TIMER_CANCEL_ON_SET)
const TFD_CANCELED: u64 = 4;          // plus this once the wall clock was set
const EP_N: u64 = 8;                  // epoll instances, in k.evt from EP_AT: EP_STRIDE words each
const EP_FDS: u64 = 64;               // descriptors one epoll instance watches
const EP_ENTRY: u64 = 4;              // fd + 1 (0: empty), its description, events, data
const EP_STRIDE: u64 = 257;           // 1 + EP_FDS * EP_ENTRY
const EP_AT: u64 = 32;                // TFD_N * TFD_STRIDE
const FIFO_N: u64 = 4;                // open named pipes, in k.evt from FIFO_AT: FIFO_STRIDE words each
const FIFO_STRIDE: u64 = 2;           // the FIFO's file handle + 1 (0: free), its pipe + 1
const FIFO_AT: u64 = 2088;            // EP_AT + EP_N * EP_STRIDE
const INO_N: u64 = 8;                 // inotify instances, in k.evt from INO_AT: INO_STRIDE words each (src/lxinotify.bastio)
const INO_W: u64 = 16;                // watches per instance
const INO_WAT: u64 = 3;               // a watch: the handle + 1 (0: free), its mask, its descriptor
const INO_Q: u64 = 32;                // events an instance queues, IN_Q_OVERFLOW included
const INO_NAMEW: u64 = 32;            // words of an event's name: 8 bytes each
const INO_EV: u64 = 36;               // an event: wd, mask, cookie, name length, then INO_NAMEW words
const INO_HEAD: u64 = 4;              // in use, the next watch descriptor, events queued, the first
const INO_STRIDE: u64 = 1204;         // INO_HEAD + INO_W * INO_WAT + INO_Q * INO_EV
const INO_AT: u64 = 2096;             // FIFO_AT + FIFO_N * FIFO_STRIDE
const INO_G: u64 = 11728;             // INO_AT + INO_N * INO_STRIDE: what all instances share
const EVT_LEN: u64 = 11846;           // INO_G + 118
const OF_UNIX: u64 = 11;              // an AF_UNIX socket: see src/lxunix.bastio
const OF_PTY: u64 = 14;               // a pseudo-terminal end: x DEV_PTM + N or DEV_PTS + N; word 3: nonblocking (src/lxpty.bastio)
const OF_PQ: u64 = 13;                // a POSIX message queue: x the queue; word 3: nonblocking + 2 * access mode (src/lxmq.bastio)
const OF_SIGFD: u64 = 12;             // a signalfd: word 2 the signals it takes; word 3: nonblocking (src/lxevent.bastio)
const OF_INOTIFY: u64 = 16;           // an inotify instance: x the instance; word 3: nonblocking (src/lxinotify.bastio)
const OF_NETLINK: u64 = 17;           // a netlink socket: x its slot; word 3: nonblocking (src/lxnetlink.bastio)
const OF_PIDFD: u64 = 15;             // a pidfd: x the process, NPROC once its slot was reused; word 3: nonblocking (src/lxpidfd.bastio)
const DIR_ROOT: u64 = 0;
const DIR_BIN: u64 = 1;
const DIR_VFS: u64 = 2;               // DIR_VFS + a file layer directory handle
const DIR_CG: u64 = 0x4000000;        // DIR_CG + n: cgroup n's directory (src/lxcgroup.bastio)
const DIR_PROC: u64 = 0x10000;        // /proc; DIR_PROC + pid: /proc/PID (src/lxprocfs.bastio)
const PROC_DEV: u64 = 256;            // an OF_DEV device from here up is a /proc file: PROC_DEV + 16 * pid + PF_*
const PF_EXE: u64 = 7;                // /proc/PID/exe, a link
const EACCES: u64 = 18446744073709551603;   // 2^64 - 13
const AT_SYMLINK_NOFOLLOW: u64 = 0x100;

/// Whether /proc file f is a /proc/PID/exe link (the /proc/sys files above
/// the per-process ones are numbered on, so their f % 16 means nothing).
fn is_exe_file(f: u64) -> bool
  ensures result ==> f >= PROC_DEV
{
  return f >= PROC_DEV && f < PROC_DEV + 16 * NPROC && f % 16 == PF_EXE;
}

// AF_UNIX sockets (src/lxunix.bastio): UX_N one-way channels and UX_LIS
// names to connect to.
const UX_N: u64 = 16;
const UX_W: u64 = 4;                  // head, count, read end open, write end open
const UX_CAP: u64 = 4096;             // bytes a channel holds
const UX_LIS: u64 = 4;
const UX_BACKLOG: u64 = 4;            // connections waiting for accept
const UXL_W: u64 = 8;                 // 4 + UX_BACKLOG
const UX_PATH: u64 = 108;             // the longest name
const UX_LEN: u64 = 156;              // UX_N * UX_W + UX_LIS * UXL_W + UX_N, then 2 * (UX_N + UX_LIS) credential words, then UX_LIS socket files
const UXB_LEN: u64 = 65968;           // UX_N * UX_CAP + UX_LIS * UX_PATH

const NPIPES: u64 = 512;              // OFD_N / 2: each pipe has two descriptions
const PIPE_CAP: u64 = 65536;          // bytes a pipe holds, as on Linux
const PIPE_PAGE: u64 = 4096;          // the least F_SETPIPE_SZ gives a pipe
const PIPE_ATOM: u64 = 4096;          // PIPE_BUF: writes this small go in whole
const PIPE_STRIDE: u64 = 8;           // head, count, readers, writers, FIFO + 1 (0: none), a writer came, capacity, O_ASYNC reader
const PIPES_LEN: u64 = 4096;          // NPIPES * PIPE_STRIDE

// Pipe p's ring: PIPE_PAGE bytes it takes when it is opened, growing up
// to PIPE_CAP as it fills, and gives back when both ends are closed. Slot p of k.pipebuf, which grows by one as
// pipes come into use, so a new pipe takes the lowest free slot.
enum PipeBuf { None, Ring(Bytes) }

const LX_PIPE: u64 = 22;
const LX_FSTAT: u64 = 5;
const LX_GETDENTS64: u64 = 217;
const AT_EMPTY_PATH: u64 = 0x1000;
const AT_NO_AUTOMOUNT: u64 = 0x800;
const AT_REMOVEDIR: u64 = 0x200;
const DENT_BUF: u64 = 2048;           // the most getdents64 fills in one call
const ENOTDIR: u64 = 18446744073709551596;  // 2^64 - 20
const ENAMETOOLONG: u64 = 18446744073709551580;  // 2^64 - 36
const EIO: u64 = 18446744073709551611;       // 2^64 - 5
const ELOOP: u64 = 18446744073709551576;    // 2^64 - 40
const EEXIST: u64 = 18446744073709551599;   // 2^64 - 17
const EPERM: u64 = 18446744073709551615;    // 2^64 - 1
const LO_EXCL: u64 = 0x80;
const LO_DIRECTORY: u64 = 0x10000;
const LO_TMPFILE: u64 = 0x400000;      // with LO_DIRECTORY: an unnamed file, which BastiOS lacks
const EOPNOTSUPP: u64 = 18446744073709551521; // 2^64 - 95
const ENOSPC: u64 = 18446744073709551588;    // 2^64 - 28
const EFBIG: u64 = 18446744073709551589;     // 2^64 - 27
const EROFS: u64 = 18446744073709551586;     // 2^64 - 30
const ENOTBLK: u64 = 18446744073709551601;   // 2^64 - 15
const EBUSY: u64 = 18446744073709551600;     // 2^64 - 16
const ETXTBSY: u64 = 18446744073709551590;   // 2^64 - 26
const ASH_PROG: u64 = 13;             // BusyBox, which also answers to NAPPLETS names
const NAPPLETS: u64 = 39;
const NSUID_APPLETS: u64 = 2;          // su and passwd (bin_suid, src/lxproc.bastio)
const S_IFCHR: u64 = 0x2190;           // a character device, rw--w----
const S_IFIFO: u64 = 0x1180;           // a FIFO, rw-------
const S_IFSOCK: u64 = 0xC1B6;          // a socket, rw-rw-rw-
const LX_POLL: u64 = 7;
const LX_PPOLL: u64 = 271;
const LX_PSELECT6: u64 = 270;
const LX_SELECT: u64 = 23;
const LX_EPOLL_WAIT: u64 = 232;
const LX_EPOLL_PWAIT: u64 = 281;
const LX_EPOLL_PWAIT2: u64 = 441;
// In k.sigsave's word for a process: its mask was swapped by ppoll or
// pselect6 (bit 8 is SIGKILL's, which no saved mask holds).
const MASK_SWAPPED: u64 = 256;
const POLL_MAX: u64 = 64;
const POLLIN: u64 = 1;
const POLLOUT: u64 = 4;
const POLLERR: u64 = 8;
const POLLHUP: u64 = 16;
const POLLNVAL: u64 = 32;
const POLLRDHUP: u64 = 0x2000;         // the reading side is shut (a stream socket)
const LX_DUP: u64 = 32;
const LX_DUP2: u64 = 33;
const LX_FCNTL: u64 = 72;
const LX_PIPE2: u64 = 293;
const LX_DUP3: u64 = 292;

const F_DUPFD: u64 = 0;
const F_GETFD: u64 = 1;
const F_SETFD: u64 = 2;
const F_GETFL: u64 = 3;
const F_SETFL: u64 = 4;
const F_DUPFD_CLOEXEC: u64 = 1030;
const F_ADD_SEALS: u64 = 1033;
const F_GET_SEALS: u64 = 1034;
const F_SETPIPE_SZ: u64 = 1031;
const F_GETPIPE_SZ: u64 = 1032;
const F_GETLK: u64 = 5;
const F_SETLK: u64 = 6;
const F_SETLKW: u64 = 7;
const F_OFD_GETLK: u64 = 36;
const F_OFD_SETLK: u64 = 37;
const F_OFD_SETLKW: u64 = 38;
const F_SETOWN: u64 = 8;
const F_GETOWN: u64 = 9;
const F_SETSIG: u64 = 10;
const F_GETSIG: u64 = 11;
const F_SETOWN_EX: u64 = 15;
const F_GETOWN_EX: u64 = 16;
const F_OWNER_TID: u64 = 0;
const F_OWNER_PID: u64 = 1;
const F_OWNER_PGRP: u64 = 2;
const SIGIO: u64 = 29;
const F_UNLCK: u64 = 2;
const LO_CLOEXEC: u64 = 0x80000;
const LO_PATH: u64 = 0x200000;         // a handle for the name only: no permission needed
const LO_NOFOLLOW: u64 = 0x20000;      // a symbolic link at the end is ELOOP
const LO_NOATIME: u64 = 0x40000;       // for the owner and root only

const EMFILE: u64 = 18446744073709551592;   // 2^64 - 24
const ENFILE: u64 = 18446744073709551593;   // 2^64 - 23
const ESPIPE: u64 = 18446744073709551587;   // 2^64 - 29
const EPIPE: u64 = 18446744073709551584;    // 2^64 - 32

// What a descriptor refers to, once looked up.
const K_BAD: u64 = 0;
const K_CONSOLE: u64 = 1;
const K_FILE: u64 = 2;                // x: the native row
const K_PIPE_R: u64 = 3;              // x: the pipe
const K_PIPE_W: u64 = 4;
const K_DIR: u64 = 5;                 // x: DIR_ROOT or DIR_BIN
const K_SOCK: u64 = 6;                // x: the kernel socket
const K_DEV: u64 = 7;                 // x: the device (src/lxdev.bastio)
const K_EVENT: u64 = 8;               // x: the description (src/lxevent.bastio)
const K_TIMER: u64 = 9;               // x: the timer
const K_EPOLL: u64 = 10;              // x: the epoll instance
const K_SIGFD: u64 = 11;              // x: the description (src/lxevent.bastio)
const K_INOTIFY: u64 = 16;            // x: the instance (src/lxinotify.bastio)
const K_PIDFD: u64 = 15;              // x: the process, NPROC if it is gone (src/lxpidfd.bastio)


struct Kernel {
  mem: Mem,             // the page allocator
  spaces: Vec[Space],   // element `pid` is that process's address space
  fpus: Vec[Fpu],       // element `pid` is that process's FPU state
  procs: Buf,           // the process table
  q: Queue,             // console input waiting for a READ
  line: Buf,            // the line a Linux program is typing (see tty_cook)
  lxfd: Buf,            // Linux descriptors (src/lxfd.bastio)
  ofd: Buf,             // open file descriptions they share
  pipes: Buf,           // pipe state, PIPE_STRIDE words each
  pipebuf: Vec[PipeBuf],  // pipe rings (lxfd.bastio, pipe_ready)
  ticks: u64,           // timer ticks since boot
  ns: u64,              // the clock at the last system call, in nanoseconds since boot
  tsc: Tsc,             // how to read that clock (src/tsc.bastio), also copied into each vDSO
  epoch: u64,           // CLOCK_REALTIME minus the clock, in ns (src/rtc.bastio)
  rng: Buf,             // the generator behind /dev/urandom, RNG_LEN words (src/lxdev.bastio)
  cpus: u64,            // processors running, the bootstrap one included
  fs: Vfs,              // files and the open-file table
  nic: Nic,             // the network card and its UDP sockets, if any
  sigact: Buf,          // Linux signal actions (src/lxsig.bastio)
  cwd: Buf,             // Linux working directories (src/lxdir.bastio)
  croot: Buf,           // each process's root (chroot), laid out like cwd; length 0 is the top
  dpath: Buf,           // the path of each open directory description, laid out like cwd
  sigsave: Buf,         // per process, the mask rt_sigsuspend replaced; then each pending signal's sender (src/lxsig.bastio)
  alarms: Buf,          // Linux ITIMER_REAL per process: deadline (0: off) and interval (src/lxtime.bastio)
  evt: Buf,             // timerfds and epoll instances (src/lxevent.bastio)
  ux: Buf,              // AF_UNIX channels and names (src/lxunix.bastio)
  uxb: Bytes,           // their bytes
  maps: Buf,            // Linux MAP_SHARED file mappings, MAP_N per process (src/lxmem.bastio)
  holes: Buf,           // address space munmap gave back, HOLE_N ranges per process (src/lxmem.bastio)
  lazy: Buf,            // code pages read from a file when first touched, LZ_W words per process (src/lazy.bastio)
  anon: Buf,            // anonymous memory mapped when first touched, AN_N records per process (src/lxanon.bastio)
  inet6: Buf,           // word h: 1 if open file description h is an AF_INET6 socket (src/lxsock.bastio)
  locks: Buf,           // file locks held (src/lxlock.bastio)
  loops: Buf,           // loop devices (src/lxloop.bastio)
  ptys: Buf,            // pseudo-terminals (src/lxpty.bastio)
  ptyb: Bytes,          // their rings
  perr: u64,            // why lx_path_from last gave NO_RESULT: -ENOENT, -ENOTDIR, ... (src/linux.bastio)
  pdir: bool,           // the name lx_path_from last gave ended in "/" or "/." and names nothing yet: only a directory may be made there
  ipc: Buf,             // System V message queues and semaphores (src/lxipc.bastio)
  ipcb: Bytes,          // the queues' messages
  shm: Store,           // System V shared memory pages (src/lxipc.bastio)
  txt: Store,           // the built-in programs' read-only pages (src/text.bastio)
  sys: Buf,             // settings root may change: names, the clock discipline (src/lxsys.bastio)
  snd: Snd,             // the sound card, if any (src/hda.bastio)
  mice: Bytes,          // mouse packets for /dev/input/mice (src/lxmouse.bastio)
  mns: Buf,             // mount namespaces: each process's, and their mounts (src/lxns.bastio)
  scf: Buf,             // seccomp filters, empty until one is loaded (src/lxseccomp.bastio)
  mstr: Bytes,          // the mounts' paths, and the logical path of the last lookup
  naps: bool,           // a process may be in TIMEWAIT: false lets sleepers_wake skip its scan
}

/// Process p's ptrace word (see SYS_PT).
fn tr_get(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
{
  return get(k.sys, SYS_PT + p);
}

fn tr_put(k: &mut Kernel, p: u64, v: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_PT + p, v);
}

fn tr2_get(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
{
  return get(k.sys, SYS_PT2 + p);
}

fn tr2_put(k: &mut Kernel, p: u64, v: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_PT2 + p, v);
}

/// The process that traces p, or 0.
fn tr_tracer(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result <= 65536
{
  let t = tr_get(k, p) % 65536;
  return t;
}

/// A ptrace word from its parts (t: tracer + 1).
fn tr_make(t: u64, att: u64, stopped: u64, skip: u64, sig: u64, opt: u64) -> u64
  requires t < 65536 && att < 2 && stopped < 2 && skip < 2 && sig < 256 && opt < 512
  ensures result == t + att * PT_ATTACHED + stopped * PT_STOPPED + skip * PT_SKIP + sig * PT_SIG + opt * PT_OPT
{
  return t + att * PT_ATTACHED + stopped * PT_STOPPED + skip * PT_SKIP + sig * PT_SIG + opt * PT_OPT;
}

fn tr_att(w: u64) -> u64
  ensures result < 2
{
  return w / PT_ATTACHED % 2;
}
fn tr_stopped(w: u64) -> u64
  ensures result < 2
{
  return w / PT_STOPPED % 2;
}
fn tr_skip(w: u64) -> u64
  ensures result < 2
{
  return w / PT_SKIP % 2;
}
fn tr_sig(w: u64) -> u64
  ensures result < 256
{
  return w / PT_SIG % 256;
}
fn tr_opt(w: u64) -> u64
  ensures result < 512
{
  return w / PT_OPT % 512;
}

/// Whether process t traces process p.
fn traced_by(k: &Kernel, p: u64, t: u64) -> bool
  requires kok(k) && p < NPROC && t < NPROC
{
  return tr_get(k, p) % 65536 == t + 1;
}

spec fn kok(k: &Kernel) -> bool {
  mem_ok(k.mem) && spaces_ok(k.spaces) && fpus_ok(k.fpus) && ptab_ok(k.procs) && qok(k.q) && lineok(k.line) && len(k.lxfd) <= LXFD_LEN && len(k.ofd) == OFD_LEN && len(k.pipes) == PIPES_LEN && vlen(k.pipebuf) <= NPIPES && vfs_ok(k.fs) && nic_ok(k.nic) && len(k.sigact) <= SIGACT_LEN && len(k.cwd) <= CWD_LEN && len(k.croot) <= CWD_LEN && len(k.dpath) == DPATH_LEN && len(k.alarms) == ALARMS_LEN && len(k.sigsave) <= SIGSAVE_LEN && len(k.evt) == EVT_LEN && len(k.ux) == UX_LEN && blen(k.uxb) == UXB_LEN && len(k.maps) == MAPS_LEN && len(k.lazy) == LAZY_LEN && len(k.anon) == ANON_LEN && len(k.holes) == HOLES_LEN && len(k.locks) == LK_LEN && len(k.loops) == LOOP_LEN && len(k.ptys) == PTY_LEN && blen(k.ptyb) == PTYB_LEN && len(k.ipc) == IPC_LEN && blen(k.ipcb) == IPCB_LEN && len(k.sys) == SYS_LEN && len(k.rng) == RNG_LEN && len(k.inet6) == OFD_N && snd_ok(k.snd) && blen(k.mice) == MICE_LEN && len(k.mns) == MNS_LEN && blen(k.mstr) == MSTR_LEN
    && (k.shm is Store::Table ==> (pt_level(k.shm.Table) == 2 && pt_leases(k.shm.Table) == 0))
    && (k.txt is Store::Table ==> (pt_level(k.txt.Table) == 2 && pt_leases(k.txt.Table) == 0))
}

// ---------------------------------------------------------------- programs

const NPROGS: u64 = 33;
const LDSO_PROG: u64 = 25;            // musl's dynamic linker, the interpreter of musl programs

fn prog_name(i: u64) -> Str {
  if i == 0 {
    return "sh";
  }
  if i == 1 {
    return "hello";
  }
  if i == 2 {
    return "spin";
  }
  if i == 3 {
    return "true";
  }
  if i == 4 {
    return "bench";
  }
  if i == 5 {
    return "straddle";
  }
  if i == 6 {
    return "elfexec";
  }
  if i == 7 {
    return "elfpie";
  }
  if i == 8 {
    return "elfbad";
  }
  if i == 9 {
    return "fstest";
  }
  if i == 10 {
    return "mhello";
  }
  if i == 11 {
    return "fpucheck";
  }
  if i == 12 {
    return "mtest";
  }
  if i == 13 {
    return "ash";
  }
  if i == 14 {
    return "fault";
  }
  if i == 15 {
    return "mudp";
  }
  if i == 16 {
    return "mtcp";
  }
  if i == 17 {
    return "mtime";
  }
  if i == 18 {
    return "crashme";
  }
  if i == 19 {
    return "mdir";
  }
  if i == 20 {
    return "mmisc";
  }
  if i == 21 {
    return "mspawn";
  }
  if i == 22 {
    return "sysfuzz";
  }
  if i == 23 {
    return "mthread";
  }
  if i == 24 {
    return "mdyn";
  }
  if i == 25 {
    return "ld-musl-x86_64.so.1";
  }
  if i == 26 {
    return "diskbench";
  }
  if i == 27 {
    return "mkfs.bstdisk3";
  }
  if i == 28 {
    return "mtone";
  }
  if i == 29 {
    return "mmouse";
  }
  if i == 30 {
    return "mns";
  }
  if i == 31 {
    return "mseccomp";
  }
  if i == 32 {
    return "mcont";
  }
  return "(file)";                    // a program loaded from a file
}

