// mount(2) and umount2(2), for tmpfs and for BastiOS's own disk format
// (bstdisk3) on a disk image. The in-memory file system is already a
// tmpfs, so a tmpfs mount marks an in-memory directory in the file
// layer's mount table (vfs_mount, src/fs.bastio), and unmounting removes
// everything under it. MS_RDONLY makes everything under the directory
// read-only (EROFS for each call that would change it), and MS_REMOUNT
// switches that.
//
// A bstdisk3 mount takes a disk image made by mkfs.bstdisk3 (user/mkfs.c):
// the source is a loop device bound to an in-memory file, or the file
// itself. The file layer mounts it as a second disk file system
// (vfs_lo_mount); one at a time.
//
// Different from Linux: the directory must be in memory (not under
// /disk) and empty, since a mount here does not hide what was there; a
// mount cannot be renamed or removed while mounted (EBUSY, as Linux says
// for a mount point that is busy); a file that is open blocks umount2
// even with MNT_DETACH; and hard links across a tmpfs mount's edge are
// not refused. A bstdisk3 image's file cannot be written while it is
// mounted (EBUSY), and reads of it give zeros meanwhile.
//
// Bind mounts (MS_BIND), proc, devtmpfs, devpts, sysfs and mqueue mounted
// somewhere, and pivot_root are a mount namespace's own: src/lxns.bastio.

import "linux.bastio";
import "lxns.bastio";
import "lxnsk.bastio";
import "lxxattr.bastio";
import "ext4.bastio";

const LX_MOUNT: u64 = 165;
const LX_UMOUNT2: u64 = 166;
const MS_RDONLY: u64 = 1;
const MS_REMOUNT: u64 = 32;
const MS_KEPT: u64 = 3086;            // MS_NOSUID | MS_NODEV | MS_NOEXEC | MS_NOATIME | MS_NODIRATIME: kept for a tmpfs mount, reported by statfs, and the first three enforced
const UMOUNT_OK_FLAGS: u64 = 11;      // MNT_FORCE | MNT_DETACH | UMOUNT_NOFOLLOW
const UMOUNT_NOFOLLOW: u64 = 8;

const FST_NONE: u64 = 0;
const FST_TMPFS: u64 = 1;
const FST_BSTDISK: u64 = 2;
const FST_EXT4: u64 = 3;                // ext4, and ext2 and ext3 images without a journal to replay (src/ext4.bastio)
const FST_NS: u64 = 16;                 // FST_NS + MK_*: mounted per namespace (src/lxns.bastio)
const MS_BIND: u64 = 4096;
const MS_PROPAGATION: u64 = 0x1E0000;   // MS_UNBINDABLE | MS_PRIVATE | MS_SLAVE | MS_SHARED

/// Is the NUL-terminated string at user address va s?
fn type_is(k: &mut Kernel, pid: u64, va: u64, s: Str) -> bool
  requires kok(k) && pid < NPROC && va >= USER_BASE && va < USER_BASE + USER_SIZE - 9
  ensures kok(k)
{
  let l = slen(s);
  if l > 8 {
    return false;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, l + 1) != l + 1 {
    return false;
  }
  return xfer_is(k.fs.xfer, 0, l, s) && bget(k.fs.xfer, l) == 0;
}

/// Which file system type the NUL-terminated string at user address va
/// names: "tmpfs", "bstdisk3", one of the special file systems a mount
/// namespace mounts again ("proc", "devtmpfs", "devpts", "sysfs",
/// "mqueue"), or none.
fn fs_type(k: &mut Kernel, pid: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if va < USER_BASE || va >= USER_BASE + USER_SIZE - 9 {
    return FST_NONE;
  }
  if type_is(&mut k, pid, va, "proc") {
    return FST_NS + MK_PROC;
  }
  if type_is(&mut k, pid, va, "tmpfs") {
    return FST_TMPFS;
  }
  if type_is(&mut k, pid, va, "sysfs") {
    return FST_NS + MK_SYS;
  }
  if type_is(&mut k, pid, va, "devpts") {
    return FST_NS + MK_PTS;
  }
  if type_is(&mut k, pid, va, "mqueue") {
    return FST_NS + MK_MQUEUE;
  }
  if type_is(&mut k, pid, va, "devtmpfs") {
    return FST_NS + MK_DEV;
  }
  if type_is(&mut k, pid, va, "cgroup2") {
    return FST_NS + MK_CGROUP;
  }
  if type_is(&mut k, pid, va, "overlay") {
    return FST_NS + MK_OVERLAY;
  }
  if type_is(&mut k, pid, va, "bstdisk3") {
    return FST_BSTDISK;
  }
  if type_is(&mut k, pid, va, "ext4") || type_is(&mut k, pid, va, "ext2") || type_is(&mut k, pid, va, "ext3") {
    return FST_EXT4;
  }
  return FST_NONE;
}

/// The in-memory file holding the disk image that the path at user
/// address va names (a loop device bound to one, or the file itself):
/// or NFILES with the -errno in k.perr.
fn image_file(k: &mut Kernel, pid: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k) && result <= NFILES
{
  let n = lx_path_at(&mut k, pid, AT_FDCWD, va);
  if n == NO_RESULT {
    return NFILES;
  }
  let ld = loop_at(k.fs.xfer, n);
  if is_loop(ld) {
    // /dev/loopN: the file it is bound to, the whole of it.
    let row = loop_row(k, ld - DEV_LOOP);
    if row >= FD_ROWS {
      k.perr = ENXIO;                       // not bound to a file
      return NFILES;
    }
    if lo_get(k.loops, ld - DEV_LOOP, 1) != 0 || lo_get(k.loops, ld - DEV_LOOP, 2) != 0 {
      k.perr = EINVAL;                      // an offset or a size limit: not done
      return NFILES;
    }
    let lf = vfs_row_file(k.fs, row);
    if lf >= NFILES {
      k.perr = ENOTBLK;                     // only an image in memory mounts
      return NFILES;
    }
    return lf;
  }
  let f = vfs_lookup(&mut k.fs, n);
  if f == NO_FILE {
    k.perr = ENOENT;
    return NFILES;
  }
  if f >= NFILES || vfs_is_dir(&mut k.fs, f) {
    k.perr = ENOTBLK;                       // only an image in memory mounts
    return NFILES;
  }
  return f;
}

/// The file holding the ext4 image that the path at user address va names:
/// a loop device bound to an in-memory file, or any file (on the disk too).
/// NO_FILE with the -errno in k.perr if there is none.
fn ext_image(k: &mut Kernel, pid: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_at(&mut k, pid, AT_FDCWD, va);
  if n == NO_RESULT {
    return NO_FILE;
  }
  if is_loop(loop_at(k.fs.xfer, n)) {
    let lf = image_file(&mut k, pid, va);
    if lf >= NFILES {
      return NO_FILE;
    }
    return lf;
  }
  let f = vfs_lookup(&mut k.fs, n);
  if f == NO_FILE {
    k.perr = ENOENT;
    return NO_FILE;
  }
  if vfs_is_dir(&mut k.fs, f) {
    k.perr = EISDIR;
    return NO_FILE;
  }
  return f;
}

/// The -errno for a failed ex_import.
fn ext_errno(r: u64) -> u64 {
  if r == EX_FULL {
    return ENOSPC;
  }
  if r == EX_LONG {
    return ENAMETOOLONG;
  }
  if r == EX_BIG {
    return EFBIG;
  }
  if r == EX_MEM {
    return ENOMEM;
  }
  return EINVAL;
}

/// The loop device the source path at user address va names, or LO_NODEV
/// (a file, or nothing that mounts: image_file says why).
fn source_loop(k: &mut Kernel, pid: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_at(&mut k, pid, AT_FDCWD, va);
  if n == NO_RESULT {
    return LO_NODEV;
  }
  let ld = loop_at(k.fs.xfer, n);
  if is_loop(ld) {
    return ld - DEV_LOOP;
  }
  return LO_NODEV;
}

/// The in-memory directory node at the path in the first n bytes of the
/// transfer buffer, or NFILES with the -errno to return in k.perr.
fn mount_dir(k: &mut Kernel, n: u64) -> u64
  requires kok(k) && n <= FNAME_MAX
  ensures kok(k) && result <= NFILES
{
  if n == 0 || on_disk(k.fs, n) {
    k.perr = EBUSY;                         // "/", or the disk: not a tmpfs directory here
    return NFILES;
  }
  let i = ram_find(&mut k.fs.ram, k.fs.rix, k.fs.rhi, k.fs.xfer, n);
  if i < NFILES && ram_is_dir(&mut k.fs.ram, i) {
    return i;
  }
  if i < NFILES {
    k.perr = ENOTDIR;
    return NFILES;
  }
  if dir_at(&mut k, n) != NO_FILE {
    k.perr = EBUSY;                         // /bin, /proc, /dev, /disk
    return NFILES;
  }
  k.perr = ENOENT;
  return NFILES;
}

/// mount(source, target, fstype, flags, data): data is not used, and the
/// source only by a bind and a bstdisk3 mount.
fn lx_mount(k: &mut Kernel, pid: u64, source: u64, target: u64, fstype: u64, flags: u64, full: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  ns_reap(&mut k);
  let remount = flags & MS_REMOUNT != 0;
  if !remount && flags & MS_PROPAGATION != 0 {
    // A change of propagation: there is none between namespaces here, so
    // only the target is checked.
    let n = lx_path_at(&mut k, pid, AT_FDCWD, target);
    if n == NO_RESULT {
      return k.perr;
    }
    return 0;
  }
  if remount && flags & MS_BIND != 0 {
    return ns_remount(&mut k, pid, target, flags & MS_RDONLY != 0);
  }
  if flags & MS_BIND != 0 {
    return ns_mount(&mut k, pid, source, target, MK_BIND, flags);
  }
  if remount {
    // A namespace's own mount first, then the file layer's.
    let r = ns_remount(&mut k, pid, target, flags & MS_RDONLY != 0);
    if r != EINVAL {
      return r;
    }
    if !full {
      return EPERM;                         // the file layer's mounts are the machine's
    }
  }
  let mut t = FST_TMPFS;
  if !remount {
    t = fs_type(&mut k, pid, fstype);
  }
  if t == FST_NONE {
    return ENODEV;                          // no other file system type mounts
  }
  if t > FST_NS {
    return ns_mount(&mut k, pid, source, target, t - FST_NS, flags);
  }
  if !full && t != FST_TMPFS {
    return EPERM;                           // a disk image mounts for the machine, not for a user namespace
  }
  let mut img = NFILES;
  let mut eimg = NO_FILE;
  let mut ldev = LO_NODEV;
  if t == FST_EXT4 {
    eimg = ext_image(&mut k, pid, source);
    if eimg == NO_FILE {
      return k.perr;
    }
  }
  if t == FST_BSTDISK {
    ldev = source_loop(&mut k, pid, source);
    img = image_file(&mut k, pid, source);
    if img >= NFILES {
      return k.perr;
    }
  }
  let n = lx_path_at(&mut k, pid, AT_FDCWD, target);
  if n == NO_RESULT {
    return k.perr;
  }
  if !full && t == FST_TMPFS && !remount && n != 0 {
    return ns_tmpfs(&mut k, pid, n, flags & MS_RDONLY != 0);   // a user namespace's own mount
  }
  let i = mount_dir(&mut k, n);
  if i >= NFILES {
    if t == FST_TMPFS && !remount && n != 0 && on_disk(k.fs, n) {
      return ns_tmpfs(&mut k, pid, n, flags & MS_RDONLY != 0);   // over the disk: src/lxns.bastio
    }
    return k.perr;
  }
  if !full {
    return EPERM;                           // a tmpfs on a global mount point is the machine's
  }
  let s = vfs_mount_slot(k.fs, i);
  if remount {
    if i + 1 == k.fs.lo_at {
      k.fs.lo_ro = flags & MS_RDONLY != 0;
      return 0;
    }
    if s >= MNT_N {
      return EINVAL;                        // not a mount
    }
    if vfs_mount_ext(k.fs, s) && flags & MS_RDONLY == 0 {
      return EROFS;                         // an ext4 image is only read
    }
    vfs_set_ro(&mut k.fs, s, flags & MS_RDONLY != 0);
    vfs_set_mflags(&mut k.fs, s, flags & MS_KEPT);
    return 0;
  }
  if s < MNT_N || i + 1 == k.fs.lo_at || vfs_ram_has_children(&mut k.fs, n) {
    return EBUSY;
  }
  if t == FST_EXT4 {
    // The image is read now and copied into memory below the directory;
    // the mount is read-only. The transfer buffer still holds the path.
    if n == 0 || n > FNAME_MAX {
      return EINVAL;
    }
    if !vfs_mount(&mut k.fs, i, false) {
      return ENOMEM;
    }
    let r = ex_import(&mut k.fs, &mut k.mem, eimg, n);
    let ms = vfs_mount_slot(k.fs, i);
    if ms >= MNT_N {
      return EINVAL;
    }
    if r != EX_OK {
      vfs_umount(&mut k.fs, &mut k.mem, ms);
      return ext_errno(r);
    }
    vfs_set_ext(&mut k.fs, ms);
    vfs_set_mflags(&mut k.fs, ms, flags & MS_KEPT);
    return 0;
  }
  if t == FST_BSTDISK {
    let r = vfs_lo_mount(&mut k.fs, &mut k.mem, img, i, ldev, flags & MS_RDONLY != 0);
    if r == LO_BUSY {
      return EBUSY;
    }
    if r == LO_NOFS {
      return EINVAL;                        // as Linux says for an unformatted device
    }
    if r == LO_NOMEM {
      return ENOMEM;
    }
    return 0;
  }
  if !vfs_mount(&mut k.fs, i, flags & MS_RDONLY != 0) {
    return ENOMEM;                          // MNT_N mounts already
  }
  let ns = vfs_mount_slot(k.fs, i);
  if ns < MNT_N {
    vfs_set_mflags(&mut k.fs, ns, flags & MS_KEPT);
  }
  return 0;
}

/// umount2(target, flags).
fn lx_umount2(k: &mut Kernel, pid: u64, target: u64, flags: u64, full: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & UMOUNT_OK_FLAGS != flags {
    return EINVAL;
  }
  ns_reap(&mut k);
  let mut n = NO_RESULT;
  if flags & UMOUNT_NOFOLLOW != 0 {
    n = lx_path_at_nf(&mut k, pid, AT_FDCWD, target);
  } else {
    n = lx_path_at(&mut k, pid, AT_FDCWD, target);
  }
  if n == NO_RESULT {
    return k.perr;
  }
  if ns_umount(&mut k, pid) {
    return 0;                               // the namespace's own mount (src/lxns.bastio)
  }
  if !full {
    return EINVAL;
  }
  let i = mount_dir(&mut k, n);
  if i >= NFILES {
    if dir_at(&mut k, n) == NO_FILE && vfs_lookup(&mut k.fs, n) == NO_FILE {
      return ENOENT;                        // no such name
    }
    return EINVAL;                          // not a mount
  }
  if i + 1 == k.fs.lo_at {
    if !vfs_lo_umount(&mut k.fs, &mut k.mem) {
      return EBUSY;                         // a file in it is open
    }
    ux_forget_loop(&mut k);
    return 0;
  }
  let s = vfs_mount_slot(k.fs, i);
  if s >= MNT_N {
    return EINVAL;
  }
  if !vfs_umount(&mut k.fs, &mut k.mem, s) {
    return EBUSY;                           // a file in it is open
  }
  return 0;
}

/// EROFS if the path in the first n bytes of the transfer buffer is in a
/// read-only mount, else 0: for the calls that change what a path names.
fn ro_err(k: &mut Kernel, n: u64) -> u64
  requires kok(k) && n <= FNAME_MAX
  ensures kok(k)
{
  if path_ro(&mut k, n) {
    return EROFS;
  }
  return 0;
}

fn is_mount_call(n: u64) -> bool {
  return n == LX_MOUNT || n == LX_UMOUNT2 || n == LX_PIVOT_ROOT || n == LX_SETNS;
}

fn lx_mount_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_SETNS {
    return lx_setns(&mut k, pid, a, b);     // src/lxnsk.bastio
  }
  // Root's, while it holds CAP_SYS_ADMIN; and the mapped root of a user
  // namespace in a mount namespace of its own, which has only that
  // namespace's mounts to change (not the file layer's).
  let full = cap_has(k, pid, CAP_SYS_ADMIN);
  if !full && !mnt_admin(k, pid) {
    return EPERM;
  }
  if n == LX_MOUNT {
    return lx_mount(&mut k, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10), full);
  }
  if n == LX_PIVOT_ROOT {
    return lx_pivot_root(&mut k, pid, a, b);  // src/lxns.bastio
  }
  xa_clear(&mut k);                        // what the unmounted file system held (src/lxxattr.bastio)
  return lx_umount2(&mut k, pid, a, b, full);
}
