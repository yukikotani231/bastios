// An Intel gigabit network card of the e1000 families, which share a
// register layout and the legacy descriptors this driver uses:
//   E1K_8254X  the 8254x most PCs and hypervisors of their era offer
//              (82540EM 8086:100E, as QEMU's `-device e1000`; 82544GC and
//              82545EM, its `e1000-82544gc` and `e1000-82545em`);
//   E1K_82574  the 82574L (8086:10D3, QEMU's `e1000e`), which needs one
//              erratum bit set;
//   E1K_IGB    the 82576 (8086:10C9, QEMU's `igb`) and its successors
//              I350, I210 and I211 (untested: QEMU has none), whose queue 0
//              lives at 0xC000 / 0xE000 and must be enabled on its own, and
//              which take the advanced descriptors (QEMU's igb knows no
//              others). An advanced receive descriptor is written back with
//              the status at byte 8 and the length at byte 12, over the
//              buffer's address, which is therefore written again each time.
//   E1K_PCH    the I217, I218 and I219 (8086:153A ... 0DC8, the LAN of Intel's
//              PCH chipsets; E1K_PCH_LPT for the four older ones that need no
//              ULP exit). No QEMU model exists, so this path is written from
//              Linux's e1000e (ich8lan.c) and has never run on hardware: it
//              uses the legacy descriptors of the 8254x, but the PHY sits
//              behind the ME and the chipset's SMBus, and `e1k_pch_reset`
//              must run (x86-64 `nic_new` does it) before `e1k_new`.
//   E1K_IGC    the I225 and I226 (2.5 Gb/s; 8086:15F2 ... 125E). Untested: QEMU
//              has no model. Their queues, descriptors and reset are the igb's
//              (Linux's igc driver uses the same offsets); the PHY answers at
//              address 0, and the MAC address comes from the receive-address
//              registers the card loads from its NVM.
// Polled like the virtio card: its registers are a 128 KiB
// block of the device window, claimed as an `Mmio`, and every page it can
// touch is a `Dma` lent at start and taken back after a reset at power off.
//
// Memory, six pages: one for the two descriptor rings (eight receive
// descriptors at 0, eight transmit descriptors at 2048), four of receive
// buffers (eight of 2 KiB) and one for the frame being sent.

import "virtio_net.bastio";

const E1K_VENDOR: u64 = 0x8086;
const E1K_NONE: u64 = 0;              // e1k_model: not one of these
const E1K_8254X: u64 = 1;
const E1K_82574: u64 = 2;
const E1K_IGB: u64 = 3;
const E1K_PCH: u64 = 4;
const E1K_PCH_LPT: u64 = 5;           // I217 and two I218: no ultra-low-power state to leave
const E1K_IGC: u64 = 6;               // I225 and I226: the igb's queues and descriptors, another PHY
const E1K_LEN: u64 = 0x20000;         // the register block
const E1K_TOP: u64 = 0xFEC00000;      // its BAR must lie below the I/O APIC, HPET and local APIC
const E1K_PAGES: u64 = 6;
const E1K_DESCS: u64 = 8;             // per ring: the smallest ring is 128 bytes
const E1K_TXR: u64 = 2048;            // where the transmit ring starts in the ring page

// Registers.
const E1K_CTRL: u64 = 0x0000;
const E1K_EERD: u64 = 0x0014;         // EEPROM read
const E1K_ICR: u64 = 0x00C0;
const E1K_IMS: u64 = 0x00D0;          // interrupt mask set
const E1K_IMC: u64 = 0x00D8;          // interrupt mask clear
const E1K_RCTL: u64 = 0x0100;
const E1K_TCTL: u64 = 0x0400;
const E1K_TIPG: u64 = 0x0410;
const E1K_RQ: u64 = 0x2800;           // receive queue 0's registers, from:
const IGB_RQ: u64 = 0xC000;           //   (on igb)
const E1K_TQ: u64 = 0x3800;           // transmit queue 0's
const IGB_TQ: u64 = 0xE000;
const Q_BAL: u64 = 0x00;              // offsets in a queue's registers
const Q_BAH: u64 = 0x04;
const Q_LEN: u64 = 0x08;
const Q_SRRCTL: u64 = 0x0C;           // igb receive: buffer size and descriptor type
const Q_H: u64 = 0x10;
const Q_T: u64 = 0x18;
const Q_DCTL: u64 = 0x28;             // igb: bit 25 enables the queue
const E1K_MDIC: u64 = 0x0020;         // PHY register access
const E1K_GCR: u64 = 0x5B00;          // 82574: bit 22 must be set (erratum)
const E1K_STATUS: u64 = 0x0008;
const E1K_CTRL_EXT: u64 = 0x0018;
const E1K_TXDCTL0: u64 = 0x3828;      // PCH: write-back policy and errata bits
const E1K_TXDCTL1: u64 = 0x3928;
const E1K_TARC0: u64 = 0x3840;
const E1K_TARC1: u64 = 0x3940;
const E1K_RFCTL: u64 = 0x5008;
const E1K_PBECCSTS: u64 = 0x100C;
const E1K_KABGTXD: u64 = 0x3004;
const E1K_EXTCNF: u64 = 0x0F00;       // PCH: bit 5 is the software semaphore for the PHY
const E1K_FWSM: u64 = 0x5B54;         // PCH: bit 15 the ME is running, bit 10 it is configuring ULP, bit 6 PHY reset allowed
const E1K_H2ME: u64 = 0x5B50;
const E1K_FEXTNVM3: u64 = 0x003C;
const E1K_MTA: u64 = 0x5200;          // 128 words of multicast filter
const E1K_RAL: u64 = 0x5400;          // our MAC address, low 32 bits
const E1K_RAH: u64 = 0x5404;          // high 16 bits, and bit 31: valid

// Bits.
const CTRL_ASDE: u64 = 0x20;          // detect the link speed
const CTRL_SLU: u64 = 0x40;           // set link up
const CTRL_RST: u64 = 0x4000000;
const RCTL_ON: u64 = 0x4008012;       // enable, all multicast (IPv6 neighbor discovery), accept broadcast, strip the CRC; 2 KiB buffers
const TCTL_ON: u64 = 0x4010A;         // enable, pad short frames, collision threshold and distance
const TIPG_STD: u64 = 0x0060200A;
const RAH_AV: u64 = 0x80000000;
const EERD_DONE: u64 = 16;            // 8254x: bit 4; the others: bit 1, address from bit 2
const QD_ENABLE: u64 = 0x2000000;
const SRRCTL_ADV: u64 = 0x2000002;    // 2 KiB buffers, advanced one-buffer descriptors
const ADV_TX: u64 = 0x2B300000;       // advanced data descriptor: DEXT, RS, IFCS, EOP; type 3
const GCR_ERRATUM: u64 = 0x400000;
// PCH bits.
const CTRL_PHY_RST: u64 = 0x80000000;
const CTRL_MEHE: u64 = 0x80000;
const CTRL_LANPHYPC_OVR: u64 = 0x10000;
const CTRL_LANPHYPC_VAL: u64 = 0x20000;
const CTRL_GIO_MASTER_OFF: u64 = 4;
const STATUS_GIO_MASTER: u64 = 0x80000;
const STATUS_LAN_INIT: u64 = 0x200;
const STATUS_PHYRA: u64 = 0x400;
const CTRL_EXT_FORCE_SMBUS: u64 = 0x800;
const CTRL_EXT_PHYPDEN: u64 = 0x100000;
const CTRL_EXT_LPCD: u64 = 4;
const H2ME_ULP: u64 = 0x800;
const H2ME_ENFORCE: u64 = 0x1000;
const FWSM_ULP_DONE: u64 = 0x400;
const TIPG_PCH: u64 = 0x00602008;
const MDIC_READ_ID1: u64 = 0x08220000; // read register 2 of the PHY at address 1
// MDIC: write PHY 1's control register (0) with autonegotiation on and
// restarted (and power-down off), then bit 28 says it is done.
const MDIC_AUTONEG: u64 = 0x04201200;
const MDIC_AUTONEG_IGC: u64 = 0x04001200; // the same, to the PHY at address 0
const MDIC_READY: u64 = 0x10000000;
const TX_CMD: u64 = 0x0B;             // end of packet, insert the CRC, report status
const DESC_DD: u64 = 1;               // descriptor done
const DESC_EOP: u64 = 2;              // the whole frame is in this buffer
const ICR_RX: u64 = 0x84;             // the interrupts asked for: a frame received (RXT0), link change (LSC)

struct E1k {
  regs: Mmio,
  ring: Dma,          // both descriptor rings
  rb0: Dma,           // receive buffers 0-1
  rb1: Dma,           // 2-3
  rb2: Dma,           // 4-5
  rb3: Dma,           // 6-7
  tb: Dma,            // the frame being sent
  rx_next: u64,       // the next receive descriptor the card fills
  tx_next: u64,       // the next transmit descriptor
  model: u64,         // E1K_8254X, E1K_82574, E1K_IGB, E1K_IGC ...
  rq: u64,            // where queue 0's registers are
  tq: u64,
  mac: u64,
  live: bool,
  irq: bool,          // received frames can raise its PCI interrupt line (see e1k_irq)
}

spec fn e1k_ok(e: &E1k) -> bool {
  mmio_len(e.regs) == E1K_LEN && mmio_base(e.regs) % 4096 == 0
  && e.rx_next < E1K_DESCS && e.tx_next < E1K_DESCS && e.mac < 281474976710656
  && (e.rq == E1K_RQ || e.rq == IGB_RQ) && (e.tq == E1K_TQ || e.tq == IGB_TQ)
}

/// Which family PCI id `vendor:device` is, or E1K_NONE.
fn e1k_model(vendor: u64, device: u64) -> u64
  ensures result <= E1K_IGC
{
  if vendor != E1K_VENDOR {
    return E1K_NONE;
  }
  if device == 0x153A || device == 0x153B || device == 0x15A0 || device == 0x15A1 {
    return E1K_PCH_LPT;               // I217-LM/V, I218-LM2/V2
  }
  if device == 0x155A || device == 0x1559 || device == 0x15A2 || device == 0x15A3
    || device == 0x156F || device == 0x1570 || device == 0x15B7 || device == 0x15B8 || device == 0x15B9
    || device == 0x15D7 || device == 0x15D8 || device == 0x15E3 || device == 0x15D6
    || device == 0x15BD || device == 0x15BE || device == 0x15BB || device == 0x15BC
    || device == 0x15DF || device == 0x15E0 || device == 0x15E1 || device == 0x15E2
    || device == 0x0D4E || device == 0x0D4F || device == 0x0D4C || device == 0x0D4D || device == 0x0D53 || device == 0x0D55
    || device == 0x15FB || device == 0x15FC || device == 0x15F9 || device == 0x15FA || device == 0x15F4 || device == 0x15F5
    || device == 0x0DC5 || device == 0x0DC6 || device == 0x0DC7 || device == 0x0DC8
    || device == 0x1A1E || device == 0x1A1F || device == 0x1A1C || device == 0x1A1D
    || device == 0x550C || device == 0x550D {
    return E1K_PCH;                   // I218-LM/V (LPT-LP, 3), I219 up to Alder and Raptor Lake
  }
  if device == 0x100E || device == 0x100C || device == 0x100F {
    return E1K_8254X;                 // 82540EM, 82544GC, 82545EM
  }
  if device == 0x10D3 {
    return E1K_82574;
  }
  if device == 0x15F2 || device == 0x15F3 || device == 0x15F8 || device == 0x15F7 || device == 0x3100
    || device == 0x3101 || device == 0x3102 || device == 0x5502 || device == 0x5503 || device == 0x0D9F
    || device == 0x125B || device == 0x125C || device == 0x125D || device == 0x125E {
    return E1K_IGC;                   // I225-LM/V/I/K/K2/IT, I220-V, I226-K/LM/V/IT/LMVP, I221-V
  }
  if device == 0x10C9 || device == 0x1521 || device == 0x1533 || device == 0x157B || device == 0x1539 {
    return E1K_IGB;                   // 82576, I350, I210 (and without flash), I211
  }
  return E1K_NONE;
}

/// The first card of these families on the PCI bus, or PCI_NONE.
fn e1k_find(p: &mut Pci) -> u64
  requires pci_ok(p)
  ensures pci_ok(p) && result <= PCI_NONE
{
  let mut d = 0;
  while d < PCI_NONE
    invariant d <= PCI_NONE && pci_ok(p)
  {
    let id = pci_read(&mut p, d, PCI_ID);
    if e1k_model(id % 65536, id / 65536 % 65536) != E1K_NONE {
      return d;
    }
    d = pci_next(&mut p, d);
  }
  return PCI_NONE;
}

fn e1k_read(e: &mut E1k, r: u64) -> u64
  requires e1k_ok(e) && r % 4 == 0 && r + 4 <= E1K_LEN
  ensures e1k_ok(e) && result <= 4294967295
{
  return cast[u64](mmio_read32(&mut e.regs, r));
}

fn e1k_write(e: &mut E1k, r: u64, v: u64)
  requires e1k_ok(e) && r % 4 == 0 && r + 4 <= E1K_LEN && v <= 4294967295
  ensures e1k_ok(e)
{
  mmio_write32(&mut e.regs, r, cast[u32](v));
}

/// The address of receive buffer b (0-7).
fn e1k_rxbuf_addr(e: &E1k, b: u64) -> u64
  requires b < E1K_DESCS
  ensures result <= ADDR_LIMIT + RX_BUF
{
  let mut a = dma_addr(e.rb3);
  if b < 2 {
    a = dma_addr(e.rb0);
  } else if b < 4 {
    a = dma_addr(e.rb1);
  } else if b < 6 {
    a = dma_addr(e.rb2);
  }
  if a > ADDR_LIMIT {
    return 0;                         // never: the pool is below 256 MiB
  }
  return a + b % 2 * RX_BUF;
}

/// Copies the first n bytes of receive buffer `b` into pkt.
fn e1k_rxbuf_copy(e: &mut E1k, b: u64, pkt: &mut Bytes, n: u64)
  requires e1k_ok(e) && b < E1K_DESCS && n <= RX_BUF && n <= blen(pkt)
  ensures e1k_ok(e) && blen(pkt) == old(blen(pkt)) && e.live == old(e.live) && e.irq == old(e.irq)
  ensures e.rx_next == old(e.rx_next) && e.tx_next == old(e.tx_next)
{
  let at = b % 2 * RX_BUF;
  if b < 2 {
    dma_to_bytes(&mut pkt, 0, &mut e.rb0, at, n);
  } else if b < 4 {
    dma_to_bytes(&mut pkt, 0, &mut e.rb1, at, n);
  } else if b < 6 {
    dma_to_bytes(&mut pkt, 0, &mut e.rb2, at, n);
  } else {
    dma_to_bytes(&mut pkt, 0, &mut e.rb3, at, n);
  }
}

/// Word w of the EEPROM, or 65536 if the card never answered.
fn e1k_eeprom(e: &mut E1k, w: u64) -> u64
  requires e1k_ok(e) && w < 64
  ensures e1k_ok(e)
{
  let mut done = EERD_DONE;
  if e.model == E1K_8254X {
    e1k_write(&mut e, E1K_EERD, 1 + w * 256);
  } else {
    e1k_write(&mut e, E1K_EERD, 1 + w * 4);
    done = 2;
  }
  let mut spins = 0;
  while spins < VIO_SPINS
    invariant e1k_ok(e) && (done == 2 || done == EERD_DONE)
  {
    let v = e1k_read(&mut e, E1K_EERD);
    if v / done % 2 == 1 {
      return v / 65536;
    }
    spins = spins + 1;
  }
  return 65536;
}


// ---- The PCH parts (E1K_PCH, E1K_PCH_LPT) ----
// Their registers are the 8254x's, but the PHY is reached through the ME and
// the chipset's SMBus and may be asleep (ultra-low-power mode) or on the
// wrong bus, and a reset has to be done while holding the PHY semaphore.
// The delays here are reads of PCI configuration space, which are port
// accesses of about a microsecond each and do not touch the card (a read of
// the card's own registers right after the reset hangs some of them).

fn pch_r(r: &mut Mmio, o: u64) -> u64
  requires mmio_len(r) == E1K_LEN && mmio_base(r) % 4096 == 0 && o % 4 == 0 && o + 4 <= E1K_LEN
  ensures mmio_len(r) == E1K_LEN && mmio_base(r) == old(mmio_base(r)) && result <= 4294967295
{
  return cast[u64](mmio_read32(&mut r, o));
}

fn pch_w(r: &mut Mmio, o: u64, v: u64)
  requires mmio_len(r) == E1K_LEN && mmio_base(r) % 4096 == 0 && o % 4 == 0 && o + 4 <= E1K_LEN && v <= 4294967295
  ensures mmio_len(r) == E1K_LEN && mmio_base(r) == old(mmio_base(r))
{
  mmio_write32(&mut r, o, cast[u32](v));
}

/// Waits at least `ms` milliseconds.
fn pch_pause(p: &mut Pci, dev: u64, ms: u64)
  requires pci_ok(p) && dev < PCI_NONE && ms <= 3000
  ensures pci_ok(p)
{
  let mut n = 0;
  while n < ms * 1500
    invariant pci_ok(p) && ms <= 3000
  {
    pci_read(&mut p, dev, PCI_ID);
    n = n + 1;
  }
}

/// Takes the PHY semaphore (EXTCNF bit 5), waiting up to 200 ms for the ME
/// to let go of it; false if it could not.
fn pch_lock(r: &mut Mmio, p: &mut Pci, dev: u64) -> bool
  requires mmio_len(r) == E1K_LEN && mmio_base(r) % 4096 == 0 && pci_ok(p) && dev < PCI_NONE
  ensures mmio_len(r) == E1K_LEN && mmio_base(r) == old(mmio_base(r)) && pci_ok(p)
{
  let mut n = 0;
  while n < 200
    invariant n <= 200 && mmio_len(r) == E1K_LEN && mmio_base(r) == old(mmio_base(r)) && pci_ok(p)
  {
    let x = pch_r(&mut r, E1K_EXTCNF);
    if x / 32 % 2 == 0 {
      pch_w(&mut r, E1K_EXTCNF, x + 32);
      if pch_r(&mut r, E1K_EXTCNF) / 32 % 2 == 1 {
        return true;
      }
    }
    pch_pause(&mut p, dev, 1);
    n = n + 1;
  }
  return false;
}

fn pch_unlock(r: &mut Mmio)
  requires mmio_len(r) == E1K_LEN && mmio_base(r) % 4096 == 0
  ensures mmio_len(r) == E1K_LEN && mmio_base(r) == old(mmio_base(r))
{
  let x = pch_r(&mut r, E1K_EXTCNF);
  if x / 32 % 2 == 1 {
    pch_w(&mut r, E1K_EXTCNF, x - 32);
  }
}

/// Whether the PHY answers: its identifier register reads as something
/// other than 0 and 0xFFFF.
fn pch_phy_ok(r: &mut Mmio, p: &mut Pci, dev: u64) -> bool
  requires mmio_len(r) == E1K_LEN && mmio_base(r) % 4096 == 0 && pci_ok(p) && dev < PCI_NONE
  ensures mmio_len(r) == E1K_LEN && mmio_base(r) == old(mmio_base(r)) && pci_ok(p)
{
  if !pch_lock(&mut r, &mut p, dev) {
    return false;
  }
  pch_w(&mut r, E1K_MDIC, MDIC_READ_ID1);
  let mut ok = false;
  let mut n = 0;
  while n < 100
    invariant n <= 100 && mmio_len(r) == E1K_LEN && mmio_base(r) == old(mmio_base(r)) && pci_ok(p)
  {
    let m = pch_r(&mut r, E1K_MDIC);
    if m / MDIC_READY % 2 == 1 {
      ok = m / 1073741824 % 2 == 0 && m % 65536 != 0 && m % 65536 != 65535;
      n = 100;
    } else {
      pch_pause(&mut p, dev, 1);
      n = n + 1;
    }
  }
  pch_unlock(&mut r);
  return ok;
}

/// Toggles the LANPHYPC pin, which power-cycles the PHY and brings it out of
/// SMBus mode (and ultra-low-power mode), then waits for it to settle.
fn pch_toggle_phy(r: &mut Mmio, p: &mut Pci, dev: u64)
  requires mmio_len(r) == E1K_LEN && mmio_base(r) % 4096 == 0 && pci_ok(p) && dev < PCI_NONE
  ensures mmio_len(r) == E1K_LEN && mmio_base(r) == old(mmio_base(r)) && pci_ok(p)
{
  let f = pch_r(&mut r, E1K_FEXTNVM3);
  pch_w(&mut r, E1K_FEXTNVM3, ((f & 0xF3FFFFFF) | 0x08000000) & 0xFFFFFFFF);   // PHY config counter: 50 ms
  let c = pch_r(&mut r, E1K_CTRL);
  let mut v = c;
  if v / CTRL_LANPHYPC_OVR % 2 == 0 {
    v = v + CTRL_LANPHYPC_OVR;
  }
  if v / CTRL_LANPHYPC_VAL % 2 == 1 {
    v = v - CTRL_LANPHYPC_VAL;
  }
  pch_w(&mut r, E1K_CTRL, v);
  pch_pause(&mut p, dev, 1);
  pch_w(&mut r, E1K_CTRL, v - CTRL_LANPHYPC_OVR);
  // The power cycle is done when LPCD sets; wait for it up to 120 ms, then 30 ms more.
  let mut n = 0;
  while n < 24 && pch_r(&mut r, E1K_CTRL_EXT) / CTRL_EXT_LPCD % 2 == 0
    invariant n <= 24 && mmio_len(r) == E1K_LEN && mmio_base(r) == old(mmio_base(r)) && pci_ok(p)
  {
    pch_pause(&mut p, dev, 5);
    n = n + 1;
  }
  pch_pause(&mut p, dev, 30);
}

/// Brings an I217-I219 to the state `e1k_new` expects: leaves the
/// ultra-low-power state, makes the PHY reachable, and resets the whole
/// chip (MAC and PHY) the way e1000e does. `lpt_only` is E1K_PCH_LPT.
fn e1k_pch_reset(regs: Mmio, p: &mut Pci, dev: u64, lpt_only: bool) -> Mmio
  requires mmio_len(regs) == E1K_LEN && mmio_base(regs) % 4096 == 0 && pci_ok(p) && dev < PCI_NONE
  ensures mmio_len(result) == E1K_LEN && mmio_base(result) == mmio_base(regs) && pci_ok(p)
{
  let mut r = regs;
  let fwsm = pch_r(&mut r, E1K_FWSM);
  let me = fwsm / 32768 % 2 == 1;
  // With the ME running, ask it to take the PHY out of ULP and wait for it
  // (up to 2.5 s), as e1000_disable_ulp_lpt_lp does.
  if me && !lpt_only {
    let h = pch_r(&mut r, E1K_H2ME);
    let mut v = h;
    if v / H2ME_ULP % 2 == 1 {
      v = v - H2ME_ULP;
    }
    if v / H2ME_ENFORCE % 2 == 0 {
      v = v + H2ME_ENFORCE;
    }
    pch_w(&mut r, E1K_H2ME, v);
    let mut n = 0;
    while n < 250 && pch_r(&mut r, E1K_FWSM) / FWSM_ULP_DONE % 2 == 1
      invariant n <= 250 && mmio_len(r) == E1K_LEN && mmio_base(r) == mmio_base(regs) && pci_ok(p)
    {
      pch_pause(&mut p, dev, 10);
      n = n + 1;
    }
    let h2 = pch_r(&mut r, E1K_H2ME);
    if h2 / H2ME_ENFORCE % 2 == 1 {
      pch_w(&mut r, E1K_H2ME, h2 - H2ME_ENFORCE);
    }
  }
  // The reset allowed to touch the PHY (bit 6 of FWSM), which the ME may forbid.
  let phy_reset = fwsm / 64 % 2 == 1;
  if !pch_phy_ok(&mut r, &mut p, dev) {
    // Force the MAC onto SMBus, which is where the PHY may be; if it is
    // still silent, power-cycle it.
    let ce = pch_r(&mut r, E1K_CTRL_EXT);
    if ce / CTRL_EXT_FORCE_SMBUS % 2 == 0 {
      pch_w(&mut r, E1K_CTRL_EXT, ce + CTRL_EXT_FORCE_SMBUS);
    }
    pch_pause(&mut p, dev, 50);
    if !pch_phy_ok(&mut r, &mut p, dev) && phy_reset {
      pch_toggle_phy(&mut r, &mut p, dev);
      if !pch_phy_ok(&mut r, &mut p, dev) {
        let ce2 = pch_r(&mut r, E1K_CTRL_EXT);
        if ce2 / CTRL_EXT_FORCE_SMBUS % 2 == 1 {
          pch_w(&mut r, E1K_CTRL_EXT, ce2 - CTRL_EXT_FORCE_SMBUS);
        }
      }
    }
  }
  // Stop DMA, interrupts and the units, then the global reset with the
  // PHY semaphore held.
  let c0 = pch_r(&mut r, E1K_CTRL);
  if c0 / CTRL_GIO_MASTER_OFF % 2 == 0 {
    pch_w(&mut r, E1K_CTRL, c0 + CTRL_GIO_MASTER_OFF);
  }
  let mut n = 0;
  while n < 100 && pch_r(&mut r, E1K_STATUS) / STATUS_GIO_MASTER % 2 == 1
    invariant n <= 100 && mmio_len(r) == E1K_LEN && mmio_base(r) == mmio_base(regs) && pci_ok(p)
  {
    pch_pause(&mut p, dev, 1);
    n = n + 1;
  }
  pch_w(&mut r, E1K_IMC, 4294967295);
  pch_w(&mut r, E1K_RCTL, 0);
  pch_w(&mut r, E1K_TCTL, 8);
  pch_pause(&mut p, dev, 10);
  let mut c = pch_r(&mut r, E1K_CTRL);
  if phy_reset && c / CTRL_PHY_RST % 2 == 0 {
    c = c + CTRL_PHY_RST;
  }
  if c / CTRL_RST % 2 == 0 {
    c = c + CTRL_RST;
  }
  pch_lock(&mut r, &mut p, dev);
  pch_w(&mut r, E1K_CTRL, c);
  pch_pause(&mut p, dev, 20);
  // The chip is back when the LAN has initialized itself (STATUS bit 9).
  let mut k = 0;
  while k < 100 && pch_r(&mut r, E1K_STATUS) / STATUS_LAN_INIT % 2 == 0
    invariant k <= 100 && mmio_len(r) == E1K_LEN && mmio_base(r) == mmio_base(regs) && pci_ok(p)
  {
    pch_pause(&mut p, dev, 1);
    k = k + 1;
  }
  pch_unlock(&mut r);
  let st = pch_r(&mut r, E1K_STATUS);
  if st / STATUS_PHYRA % 2 == 1 {
    pch_w(&mut r, E1K_STATUS, st - STATUS_PHYRA);
  }
  pch_w(&mut r, E1K_IMC, 4294967295);
  pch_r(&mut r, E1K_ICR);
  let kb = pch_r(&mut r, E1K_KABGTXD);
  pch_w(&mut r, E1K_KABGTXD, (kb | 0x50000) & 0xFFFFFFFF);
  return r;
}

/// The errata bits and write-back policy e1000e sets in
/// e1000_initialize_hw_bits_ich8lan and e1000_init_hw_ich8lan.
fn e1k_pch_bits(e: &mut E1k)
  requires e1k_ok(e)
  ensures e1k_ok(e) && e.live == old(e.live) && e.irq == old(e.irq) && e.rx_next == old(e.rx_next) && e.tx_next == old(e.tx_next)
  ensures e.model == old(e.model) && e.rq == old(e.rq) && e.tq == old(e.tq)
{
  // CTRL_EXT: bit 22, PHY power-down when idle, relaxed ordering off.
  let ce = e1k_read(&mut e, E1K_CTRL_EXT);
  e1k_write(&mut e, E1K_CTRL_EXT, (ce | 0x520000) & 0xFFFFFFFF);
  // Both transmit queues: bit 22, full write-back (granularity in
  // descriptors, threshold 1) and a prefetch threshold of 31.
  let t0 = e1k_read(&mut e, E1K_TXDCTL0);
  e1k_write(&mut e, E1K_TXDCTL0, ((((t0 | 0x400000) & 0xFFC0FFC0) | 0x0101001F)) & 0xFFFFFFFF);
  let t1 = e1k_read(&mut e, E1K_TXDCTL1);
  e1k_write(&mut e, E1K_TXDCTL1, ((((t1 | 0x400000) & 0xFFC0FFC0) | 0x0101001F)) & 0xFFFFFFFF);
  // Transmit arbitration: bits 23, 24, 26 and 27 of queue 0; bits 24, 26
  // and 30 of queue 1, and bit 28 unless multiple requests are enabled.
  let a0 = e1k_read(&mut e, E1K_TARC0);
  e1k_write(&mut e, E1K_TARC0, (a0 | 0x0D800000) & 0xFFFFFFFF);
  let a1 = e1k_read(&mut e, E1K_TARC1);
  let tc = e1k_read(&mut e, E1K_TCTL);
  let mut b = a1 | 0x45000000;
  if tc / 268435456 % 2 == 0 {
    b = b | 0x10000000;
  } else {
    b = b & 0xEFFFFFFF;
  }
  e1k_write(&mut e, E1K_TARC1, b & 0xFFFFFFFF);
  // No NFS filtering (it corrupts descriptors); ECC and memory error
  // handling on, as for the Lynx Point and later.
  let rf = e1k_read(&mut e, E1K_RFCTL);
  e1k_write(&mut e, E1K_RFCTL, (rf | 0xC0) & 0xFFFFFFFF);
  let eb = e1k_read(&mut e, E1K_PBECCSTS);
  e1k_write(&mut e, E1K_PBECCSTS, (eb | 0x10000) & 0xFFFFFFFF);
  let c = e1k_read(&mut e, E1K_CTRL);
  e1k_write(&mut e, E1K_CTRL, (c | CTRL_MEHE) & 0xFFFFFFFF);
}

/// Resets the card (registers to their defaults, rings off).
fn e1k_reset(e: &mut E1k) -> bool
  requires e1k_ok(e)
  ensures e1k_ok(e)
{
  e1k_write(&mut e, E1K_IMC, 4294967295);
  let c = e1k_read(&mut e, E1K_CTRL);
  if c / CTRL_RST % 2 == 0 {
    e1k_write(&mut e, E1K_CTRL, c + CTRL_RST);
  }
  let mut spins = 0;
  while spins < VIO_SPINS
    invariant e1k_ok(e)
  {
    if e1k_read(&mut e, E1K_CTRL) / CTRL_RST % 2 == 0 {
      e1k_write(&mut e, E1K_IMC, 4294967295);   // reset unmasks them
      return true;
    }
    spins = spins + 1;
  }
  return false;
}

/// Takes the card's registers and six pages, resets it, sets up both rings
/// and reads its MAC address. A card that cannot be started is left with
/// `live` false: it sends nothing and receives nothing.
fn e1k_new(regs: Mmio, model: u64, r: Frame, b0: Frame, b1: Frame, b2: Frame, b3: Frame, t: Frame) -> E1k
  requires mmio_len(regs) == E1K_LEN && mmio_base(regs) % 4096 == 0
  ensures e1k_ok(result)
{
  let mut rq = E1K_RQ;
  let mut tq = E1K_TQ;
  if model == E1K_IGB || model == E1K_IGC {
    rq = IGB_RQ;
    tq = IGB_TQ;
  }
  let mut e = E1k { regs: regs, ring: dma_lend(r), rb0: dma_lend(b0), rb1: dma_lend(b1), rb2: dma_lend(b2),
    rb3: dma_lend(b3), tb: dma_lend(t), rx_next: 0, tx_next: 0, model: model, rq: rq, tq: tq, mac: 0, live: false, irq: false };
  let ra = dma_addr(e.ring);
  // (An I217-I219 was reset by e1k_pch_reset.)
  if ra > ADDR_LIMIT - 4096 || (model != E1K_PCH && model != E1K_PCH_LPT && !e1k_reset(&mut e)) {
    return e;
  }
  e1k_read(&mut e, E1K_ICR);           // clears anything pending
  let c = e1k_read(&mut e, E1K_CTRL);
  let mut up = c;
  if c / CTRL_SLU % 2 == 0 {
    up = up + CTRL_SLU;
  }
  if c / CTRL_ASDE % 2 == 0 {
    up = up + CTRL_ASDE;
  }
  e1k_write(&mut e, E1K_CTRL, up);
  // igb: the PHY negotiates the link only when told to (QEMU's waits
  // for it; a real one may be powered down), as Linux's igb does.
  if model == E1K_IGB || model == E1K_IGC {
    if model == E1K_IGC {
      e1k_write(&mut e, E1K_MDIC, MDIC_AUTONEG_IGC);
    } else {
      e1k_write(&mut e, E1K_MDIC, MDIC_AUTONEG);
    }
    let mut spins = 0;
    while spins < VIO_SPINS && e1k_read(&mut e, E1K_MDIC) / MDIC_READY % 2 == 0
      invariant e1k_ok(e) && e.rq == rq && e.tq == tq && !e.live
    {
      spins = spins + 1;
    }
  }
  if model == E1K_82574 {
    let g = e1k_read(&mut e, E1K_GCR);
    if g / GCR_ERRATUM % 2 == 0 {
      e1k_write(&mut e, E1K_GCR, g + GCR_ERRATUM);
    }
  }
  let mut i = 0;
  while i < 128
    invariant i <= 128 && e1k_ok(e)
  {
    e1k_write(&mut e, E1K_MTA + i * 4, 0);
    i = i + 1;
  }
  // The MAC address: in the receive-address registers after a reset (the
  // card loads them from its EEPROM), else read from the EEPROM directly.
  let mut lo = e1k_read(&mut e, E1K_RAL);
  let mut hi = e1k_read(&mut e, E1K_RAH);
  if hi / RAH_AV % 2 == 0 && (model >= E1K_PCH) {
    return e;                         // no EEPROM to read: the address lives in the flash the card loaded it from
  }
  if hi / RAH_AV % 2 == 0 {
    let w0 = e1k_eeprom(&mut e, 0);
    let w1 = e1k_eeprom(&mut e, 1);
    let w2 = e1k_eeprom(&mut e, 2);
    if w0 > 65535 || w1 > 65535 || w2 > 65535 {
      return e;
    }
    lo = w0 + w1 * 65536;
    hi = w2;
    e1k_write(&mut e, E1K_RAL, lo);
    e1k_write(&mut e, E1K_RAH, hi + RAH_AV);
  }
  // Stored least significant byte first: byte k of the address is byte k
  // of lo, then of hi.
  let m0 = lo % 256;
  let m1 = lo / 256 % 256;
  let m2 = lo / 65536 % 256;
  let m3 = lo / 16777216 % 256;
  let m4 = hi % 256;
  let m5 = hi / 256 % 256;
  let mac = ((((m0 * 256 + m1) * 256 + m2) * 256 + m3) * 256 + m4) * 256 + m5;
  e.mac = mac;
  // Receive: eight 2 KiB buffers, all offered (the tail is one behind the
  // head, which the card never passes).
  let mut d = 0;
  while d < E1K_DESCS
    invariant d <= E1K_DESCS && e1k_ok(e)
  {
    dma_write64(&mut e.ring, d * 16, e1k_rxbuf_addr(e, d));
    dma_write64(&mut e.ring, d * 16 + 8, 0);
    dma_write64(&mut e.ring, E1K_TXR + d * 16, 0);
    dma_write64(&mut e.ring, E1K_TXR + d * 16 + 8, 0);
    d = d + 1;
  }
  let rq0 = e.rq;
  let tq0 = e.tq;
  if model == E1K_PCH || model == E1K_PCH_LPT {
    e1k_pch_bits(&mut e);
  }
  e1k_write(&mut e, rq0 + Q_BAL, ra);
  e1k_write(&mut e, rq0 + Q_BAH, 0);
  e1k_write(&mut e, rq0 + Q_LEN, E1K_DESCS * 16);
  e1k_write(&mut e, rq0 + Q_H, 0);
  // igb: advanced descriptors, and the queue is enabled on its own,
  // before its tail is written.
  if model == E1K_IGB || model == E1K_IGC {
    e1k_write(&mut e, rq0 + Q_SRRCTL, SRRCTL_ADV);
  }
  if (model == E1K_IGB || model == E1K_IGC) && (!e1k_queue_on(&mut e, rq0) || !e1k_queue_on(&mut e, tq0)) {
    return e;
  }
  e1k_write(&mut e, rq0 + Q_T, E1K_DESCS - 1);
  e1k_write(&mut e, E1K_RCTL, RCTL_ON);
  // Transmit.
  e1k_write(&mut e, tq0 + Q_BAL, ra + E1K_TXR);
  e1k_write(&mut e, tq0 + Q_BAH, 0);
  e1k_write(&mut e, tq0 + Q_LEN, E1K_DESCS * 16);
  e1k_write(&mut e, tq0 + Q_H, 0);
  e1k_write(&mut e, tq0 + Q_T, 0);
  if model == E1K_PCH || model == E1K_PCH_LPT {
    e1k_write(&mut e, E1K_TIPG, TIPG_PCH);
  } else if model != E1K_IGC {      // the I225/I226 keep their default
    e1k_write(&mut e, E1K_TIPG, TIPG_STD);
  }
  e1k_write(&mut e, E1K_TCTL, TCTL_ON);
  e.live = true;
  return e;
}

/// igb: sets the enable bit of the queue whose registers start at `q` and
/// waits until the card says it is on.
fn e1k_queue_on(e: &mut E1k, q: u64) -> bool
  requires e1k_ok(e) && (q == IGB_RQ || q == IGB_TQ)
  ensures e1k_ok(e) && e.live == old(e.live) && e.rq == old(e.rq) && e.tq == old(e.tq)
  ensures e.rx_next == old(e.rx_next) && e.tx_next == old(e.tx_next) && e.model == old(e.model)
{
  let c = e1k_read(&mut e, q + Q_DCTL);
  if c / QD_ENABLE % 2 == 0 {
    e1k_write(&mut e, q + Q_DCTL, c + QD_ENABLE);
  }
  let mut spins = 0;
  while spins < VIO_SPINS
    invariant e1k_ok(e) && e.live == old(e.live) && e.rq == old(e.rq) && e.tq == old(e.tq)
      && e.rx_next == old(e.rx_next) && e.tx_next == old(e.tx_next) && e.model == old(e.model)
  {
    if e1k_read(&mut e, q + Q_DCTL) / QD_ENABLE % 2 == 1 {
      return true;
    }
    spins = spins + 1;
  }
  return false;
}

/// Resets the card, so it stops using the pages, and takes them back (at
/// power off). The registers go back to the caller.
fn e1k_free(e: E1k, m: &mut Mem) -> Mmio
  requires e1k_ok(e) && mem_ok(m)
  ensures mem_ok(m)
{
  let mut d = e;
  e1k_write(&mut d, E1K_RCTL, 0);
  e1k_write(&mut d, E1K_TCTL, 0);
  e1k_reset(&mut d);
  give_page(&mut m, dma_take(d.ring));
  give_page(&mut m, dma_take(d.rb0));
  give_page(&mut m, dma_take(d.rb1));
  give_page(&mut m, dma_take(d.rb2));
  give_page(&mut m, dma_take(d.rb3));
  give_page(&mut m, dma_take(d.tb));
  return d.regs;
}

/// The caller has unmasked the card's interrupt line at the 8259: from now
/// on `e1k_irq` may let the card raise it.
fn e1k_irq_on(e: &mut E1k)
  requires e1k_ok(e)
  ensures e1k_ok(e) && e.live == old(e.live)
{
  e.irq = e.live;
}

/// Whether a received frame raises the card's interrupt line, if it can.
/// Unmasking a cause the card already has pending raises it at once.
fn e1k_irq(e: &mut E1k, on: bool)
  requires e1k_ok(e)
  ensures e1k_ok(e) && e.live == old(e.live) && e.irq == old(e.irq)
{
  if e.irq && on {
    e1k_write(&mut e, E1K_IMS, ICR_RX);
  } else if e.irq {
    e1k_write(&mut e, E1K_IMC, ICR_RX);
  }
}

/// Reading the interrupt cause clears it, so the card lowers its line
/// (which is level-triggered) before the stack looks for frames.
fn e1k_ack(e: &mut E1k)
  requires e1k_ok(e)
  ensures e1k_ok(e) && e.live == old(e.live) && e.irq == old(e.irq)
{
  if e.irq {
    e1k_read(&mut e, E1K_ICR);
  }
}

/// Copies the next received frame into `pkt` and returns its length, or 0
/// if none has arrived. The buffer goes straight back to the card.
fn e1k_recv(e: &mut E1k, pkt: &mut Bytes) -> u64
  requires e1k_ok(e) && blen(pkt) >= RX_BUF
  ensures e1k_ok(e) && blen(pkt) == old(blen(pkt)) && result <= RX_BUF - NET_HDR
{
  if !e.live {
    return 0;
  }
  let b = e.rx_next;
  let mut st_at = 12;
  let mut len_at = 8;
  if e.model == E1K_IGB || e.model == E1K_IGC {
    st_at = 8;
    len_at = 12;
  }
  let st = cast[u64](dma_read8(&mut e.ring, b * 16 + st_at));
  if st % 2 != DESC_DD {
    return 0;
  }
  let got = cast[u64](dma_read16(&mut e.ring, b * 16 + len_at));
  let mut n = 0;
  if st / DESC_EOP % 2 == 1 && got <= RX_BUF - NET_HDR {
    n = got;                          // else a frame over several buffers: dropped
  }
  e1k_rxbuf_copy(&mut e, b, &mut pkt, n);
  // Back to the card: clear its status (and give the address again),
  // then move the tail onto it.
  if e.model == E1K_IGB || e.model == E1K_IGC {
    dma_write64(&mut e.ring, b * 16, e1k_rxbuf_addr(e, b));
  }
  dma_write64(&mut e.ring, b * 16 + 8, 0);
  let rq = e.rq;
  e1k_write(&mut e, rq + Q_T, b);
  e.rx_next = (b + 1) % E1K_DESCS;
  return n;
}

/// Sends the first `n` bytes of `pkt` as one frame and waits until the card
/// has taken it.
fn e1k_send(e: &mut E1k, pkt: &Bytes, n: u64) -> bool
  requires e1k_ok(e) && n <= FRAME_MAX && n <= blen(pkt)
  ensures e1k_ok(e)
{
  if !e.live {
    return false;
  }
  bytes_to_dma(&mut e.tb, 0, pkt, 0, n);
  let d = E1K_TXR + e.tx_next * 16;
  dma_write64(&mut e.ring, d, dma_addr(e.tb));
  if e.model == E1K_IGB || e.model == E1K_IGC {
    dma_write64(&mut e.ring, d + 8, n + ADV_TX + n * 70368744177664);   // the payload length at bit 46
  } else {
    dma_write64(&mut e.ring, d + 8, n + TX_CMD * 16777216);
  }
  e.tx_next = (e.tx_next + 1) % E1K_DESCS;
  let tq = e.tq;
  e1k_write(&mut e, tq + Q_T, e.tx_next);
  let mut spins = 0;
  while spins < VIO_SPINS
    invariant e1k_ok(e) && d + 16 <= 4096 && d % 16 == 0
  {
    if cast[u64](dma_read8(&mut e.ring, d + 12)) % 2 == DESC_DD {
      return true;
    }
    spins = spins + 1;
  }
  return false;
}
