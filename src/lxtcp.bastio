// Linux TCP sockets, over the kernel's connections in src/tcp.bastio. A
// stream socket names an open file description of kind OF_TCP whose x is
// the kernel connection or listener (TCBS before listen or connect), and
// whose word 3 packs nonblocking (bit 0), the bound port and the mode
// (TM_NEW, TM_LISTEN, TM_CONN): see tm_word. TM_RDSHUT is added once
// shutdown(SHUT_RD) shut its reading side: reads then end where the
// bytes already in run out, as on Linux.

import "linux.bastio";

const IPPROTO_TCP: u64 = 6;
const TM_NEW: u64 = 0;
const TM_LISTEN: u64 = 1;
const TM_CONN: u64 = 2;
const TM_RDSHUT: u64 = 524288;

const ECONNRESET: u64 = 18446744073709551512;      // 2^64 - 104
const EISCONN: u64 = 18446744073709551510;         // 2^64 - 106
const ECONNREFUSED: u64 = 18446744073709551505;    // 2^64 - 111
const EINPROGRESS: u64 = 18446744073709551501;     // 2^64 - 115
const EALREADY: u64 = 18446744073709551502;        // 2^64 - 114

// A stream socket descriptor: description h, connection t (TCBS: none
// yet), and the fields of word 3; or err.
struct Tk { err: u64, h: u64, t: u64, nb: u64, port: u64, mode: u64, rd: u64 }

fn tm_word(nb: u64, port: u64, mode: u64) -> u64
  requires nb <= 1 && port <= 65535 && mode <= TM_CONN
  ensures result < TM_RDSHUT
{
  return nb + 2 * port + 131072 * mode;
}

fn tk_look(k: &Kernel, pid: u64, fd: u64) -> Tk
  requires kok(k) && pid < NPROC
  ensures result.err == 0 ==> (result.h < OFD_N && result.t <= TCBS && result.nb <= 1 && result.port <= 65535 && result.mode <= TM_CONN && result.rd <= 1)
{
  let none = Tk { err: ENOTSOCK, h: 0, t: 0, nb: 0, port: 0, mode: 0, rd: 0 };
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  if v == 0 {
    return Tk { err: EBADF, h: 0, t: 0, nb: 0, port: 0, mode: 0, rd: 0 };
  }
  if v < FD_OFD || v - FD_OFD >= OFD_N {
    return none;
  }
  let h = v - FD_OFD;
  let t = of_get(k.ofd, h, 2);
  let w = of_get(k.ofd, h, 3);
  if of_get(k.ofd, h, 0) != OF_TCP || t > TCBS || w / 131072 % 4 > TM_CONN || w >= 2 * TM_RDSHUT {
    return none;
  }
  return Tk { err: 0, h: h, t: t, nb: w % 2, port: w / 2 % 65536, mode: w / 131072 % 4, rd: w / TM_RDSHUT };
}

fn is_tcp(k: &Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  return v >= FD_OFD && v - FD_OFD < OFD_N && of_get(k.ofd, v - FD_OFD, 0) == OF_TCP;
}

/// socket(AF_INET, SOCK_STREAM, 0 or IPPROTO_TCP): a description with no
/// connection yet.
fn lx_tcp_socket(k: &mut Kernel, pid: u64, kind: u64, proto: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if proto != 0 && proto != IPPROTO_TCP {
    return EPROTONOSUPPORT;
  }
  let h = ofd_new(&mut k, OF_TCP, TCBS);
  if h >= OFD_N {
    return ENFILE;
  }
  of_set(&mut k.ofd, h, 3, tm_word(kind / SOCK_NONBLOCK % 2, 0, TM_NEW));
  let fd = fd_install(&mut k, pid, h);
  if fd < LXNFD && kind / SOCK_CLOEXEC % 2 == 1 {
    fd_set_k(&mut k, pid, fd, FD_OFD + h + FD_CLOEXEC);
  }
  return fd;
}

/// bind on a stream socket: remembers the port for listen; port 0 picks
/// an ephemeral one now, so getsockname can report it before listen.
fn lx_tcp_bind(k: &mut Kernel, pid: u64, fd: u64, addr: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return tk.err;
  }
  if tk.mode != TM_NEW || tk.port != 0 {
    return EINVAL;
  }
  let sin = sin_in(&mut k, pid, addr, alen);
  if sin.err != 0 {
    return sin.err;
  }
  let why = bind_check(k, pid, sin.ip, sin.port);
  if why != 0 {
    return why;
  }
  if !may_bind(k, pid, sin.port) {
    return EACCES;
  }
  let mut port = sin.port;
  if port == 0 {
    port = tcp_pick_port(&mut k.nic, net_ns(k, pid));
    if port == 0 {
      return EADDRINUSE;
    }
  }
  of_set(&mut k.ofd, tk.h, 3, tm_word(tk.nb, port, TM_NEW));
  return 0;
}

/// An ephemeral TCP port no connection or listener uses, or 0.
fn tcp_pick_port(c: &mut Nic, ns: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c) && result <= 65535
{
  match c {
    Nic::None => { c = Nic::None; return 0; },
    Nic::Up(mut n) => {
      if ns < NNET {
        n.ns = ns;
      }
      let p = tcp_eph_port(&mut n);
      c = Nic::Up(n);
      return p;
    },
  }
}

/// listen(fd, backlog): the kernel listener on the bound port.
fn lx_listen(k: &mut Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return tk.err;
  }
  if tk.mode == TM_LISTEN {
    return 0;
  }
  if tk.mode != TM_NEW {
    return EINVAL;
  }
  let t = tcp_listen(&mut k.nic, net_ns(k, pid), tk.port, ofd_fam(k, tk.h));    // port 0: an ephemeral one
  if t >= TCBS {
    return EADDRINUSE;
  }
  of_set(&mut k.ofd, tk.h, 2, t);
  of_set(&mut k.ofd, tk.h, 3, tm_word(tk.nb, tcp_local_port(k.nic, t), TM_LISTEN));
  return 0;
}

/// accept4(fd, addr, lenp, flags): an established connection from the
/// listener, in a new descriptor; SK_WAIT if none has come in yet.
fn lx_accept(k: &mut Kernel, pid: u64, fd: u64, addr: u64, lenp: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return tk.err;
  }
  if tk.mode != TM_LISTEN {
    return EINVAL;
  }
  let c = tcp_accept(&mut k.nic, tk.t);
  if c >= TCBS {
    if tk.nb == 1 {
      return EAGAIN;
    }
    return SK_WAIT;
  }
  let h = ofd_new(&mut k, OF_TCP, c);
  if h >= OFD_N {
    tcp_close(&mut k.nic, c);
    return ENFILE;
  }
  of_set(&mut k.ofd, h, 3, tm_word(flags / SOCK_NONBLOCK % 2, tk.port, TM_CONN));
  if ofd_v6(k, tk.h) {
    k.inet6 = set(k.inet6, h, 1);           // an AF_INET6 listener's connections are too
  }
  let nfd = fd_install(&mut k, pid, h);
  if nfd >= LXNFD {
    return nfd;                             // -EMFILE; the description is gone
  }
  if flags / SOCK_CLOEXEC % 2 == 1 {
    fd_set_k(&mut k, pid, nfd, FD_OFD + h + FD_CLOEXEC);
  }
  let r = sin_out(&mut k, pid, addr, lenp, tcp_peer_ip(k.nic, c), tcp_peer_port(k.nic, c), ofd_v6(k, h));
  if r != 0 {
    return r;
  }
  return nfd;
}

/// connect on a stream socket: opens the connection, then waits (SK_WAIT,
/// the call runs again) until it is established or refused. The port
/// field of a connection's word 3 is 1 once a connect has reported it
/// established: a later connect is EISCONN. A refused attempt leaves the
/// socket unconnected, as on Linux, so it can try again.
fn lx_tcp_connect(k: &mut Kernel, pid: u64, fd: u64, addr: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return tk.err;
  }
  if is_unspec(&mut k, pid, addr, alen) {
    // AF_UNSPEC: dissolve the connection; the socket can bind again.
    if tk.mode == TM_CONN {
      tcp_close(&mut k.nic, tk.t);
      of_set(&mut k.ofd, tk.h, 2, TCBS);
      of_set(&mut k.ofd, tk.h, 3, tm_word(tk.nb, 0, TM_NEW));
    }
    return 0;
  }
  if tk.mode == TM_LISTEN {
    return EISCONN;
  }
  if tk.mode == TM_CONN && tk.port != 0 {
    return EISCONN;
  }
  let mut t = tk.t;
  let fresh = tk.mode == TM_NEW;
  if tk.mode == TM_NEW {
    let sin = sin_in(&mut k, pid, addr, alen);
    if sin.err != 0 {
      return sin.err;
    }
    t = tcp_connect(&mut k.nic, net_ns(k, pid), sin.ip, sin.port);
    if t >= TCBS {
      return ENETUNREACH;
    }
    of_set(&mut k.ofd, tk.h, 2, t);
    of_set(&mut k.ofd, tk.h, 3, tm_word(tk.nb, 0, TM_CONN));
  }
  let st = tcp_status(k.nic, t);
  if st == 1 {
    of_set(&mut k.ofd, tk.h, 3, tm_word(tk.nb, 1, TM_CONN));
    return 0;
  }
  if st == 2 {
    tcp_close(&mut k.nic, t);
    of_set(&mut k.ofd, tk.h, 2, TCBS);
    of_set(&mut k.ofd, tk.h, 3, tm_word(tk.nb, 0, TM_NEW));
    return ECONNREFUSED;
  }
  if tk.nb == 1 {
    if !fresh {
      return EALREADY;
    }
    return EINPROGRESS;
  }
  return SK_WAIT;
}

/// write / send on a connection: what the send buffer takes; SK_WAIT
/// while it is full (-EAGAIN when nonblocking); -EPIPE once the
/// connection cannot send. With `more` (MSG_MORE), a short segment waits
/// for more data.
fn lx_tcp_send(k: &mut Kernel, pid: u64, fd: u64, buf: u64, n: u64, more: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return tk.err;
  }
  if tk.mode != TM_CONN {
    return EPIPE;                           // Linux too: never connected is EPIPE on send
  }
  if n == 0 {
    return 0;
  }
  let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, &mut k.fs.xfer, smaller(n, XFER));
  if got == NO_RESULT || got == 0 {
    return EFAULT;
  }
  let w = tcp_send_xfer(&mut k, pid, fd, got, more);
  if w != got {
    return w;
  }
  // More than one transfer buffer's worth, while the send ring takes it.
  let mut total = got;
  let mut go = true;
  while go && buf < 0x800000000000 && total < n && total <= TCP_RING - XFER
    invariant kok(k) && pid < NPROC && total <= TCP_RING
  {
    let c = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf + total, &mut k.fs.xfer, smaller(n - total, XFER));
    if c == NO_RESULT || c == 0 {
      go = false;                           // as a short write
    } else {
      let r = tcp_send_xfer(&mut k, pid, fd, c, more);
      if r > c {
        go = false;                         // full, or an error: say it next time
      } else {
        total = total + r;
        go = r == c;
      }
    }
  }
  return total;
}

/// Sends the first n bytes of k.fs.xfer on connection fd (send, and
/// sendfile's put_xfer): what the send buffer takes; SK_WAIT while it is
/// full (-EAGAIN when the socket is nonblocking); -EPIPE once the
/// connection cannot send.
fn tcp_send_xfer(k: &mut Kernel, pid: u64, fd: u64, n: u64, more: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return tk.err;
  }
  if tk.mode != TM_CONN {
    return EPIPE;
  }
  if n == 0 {
    return 0;
  }
  nic_feed(&mut k.nic, &mut k.mem);
  tcp_cork(&mut k.nic, tk.t, more);
  let w = tcp_send(&mut k.nic, tk.t, k.fs.xfer, n);
  if w == NO_SOCK {
    return EPIPE;
  }
  if w == 0 && tk.nb == 1 {
    return EAGAIN;                          // full, and the caller will not wait
  }
  if w == 0 {
    return SK_WAIT;
  }
  return w;
}

/// read / recv on a connection: the bytes that arrived (left there with
/// peek), 0 at the end, SK_WAIT (or -EAGAIN when nonblocking) while none
/// have.
fn lx_tcp_recv(k: &mut Kernel, pid: u64, fd: u64, buf: u64, n: u64, dontwait: bool, peek: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return tk.err;
  }
  if tk.mode != TM_CONN {
    return ENOTCONN;
  }
  nic_feed(&mut k.nic, &mut k.mem);
  let got = tcp_recv(&mut k.nic, tk.t, &mut k.fs.xfer, smaller(n, XFER), peek);
  if got == NO_SOCK {
    return ECONNRESET;
  }
  if got == TCP_AGAIN {
    if tk.rd == 1 {
      return 0;                             // shut for reading: the end
    }
    if dontwait || tk.nb == 1 {
      return EAGAIN;
    }
    return SK_WAIT;
  }
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, k.fs.xfer, got) != got {
    return EFAULT;
  }
  // More than one transfer buffer's worth, while more has arrived.
  let mut total = got;
  let mut more = got == XFER && !peek;
  while more && buf < 0x800000000000 && total < n && total <= TCP_RING - XFER
    invariant kok(k) && pid < NPROC && total <= TCP_RING
  {
    let r = tcp_recv(&mut k.nic, tk.t, &mut k.fs.xfer, smaller(n - total, XFER), false);
    if r == 0 || r > XFER {
      more = false;                         // nothing more yet, the end, or reset: say it next time
    } else if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf + total, k.fs.xfer, r) != r {
      more = false;                         // as a short read
    } else {
      total = total + r;
      more = r == XFER;
    }
  }
  return total;
}

/// shutdown(fd, how) on a stream socket: SHUT_WR and SHUT_RDWR send the
/// FIN now (later sends are -EPIPE); SHUT_RD and SHUT_RDWR shut the
/// reading side, so reads end once the bytes already in are taken (Linux
/// too goes on taking what the peer sends).
fn lx_tcp_shutdown(k: &mut Kernel, pid: u64, fd: u64, how: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return tk.err;
  }
  if how > 2 {
    return EINVAL;
  }
  if tk.mode != TM_CONN {
    return ENOTCONN;
  }
  if how != 1 && tk.rd == 0 {
    of_set(&mut k.ofd, tk.h, 3, tm_word(tk.nb, tk.port, tk.mode) + TM_RDSHUT);
  }
  if how != 0 {
    tcp_shutdown(&mut k.nic, tk.t);
  }
  return 0;
}

/// getsockname / getpeername on a stream socket.
fn lx_tcp_name(k: &mut Kernel, pid: u64, fd: u64, addr: u64, lenp: u64, peer: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return tk.err;
  }
  if !peer {
    let mut port = tk.port;
    if tk.mode == TM_CONN {
      port = tcp_local_port(k.nic, tk.t);   // word 3 only says whether connect reported it
    }
    let mut me = 0;
    if tk.mode == TM_CONN && tk.t < TCBS && is_v6tok(tcp_peer_ip(k.nic, tk.t)) {
      me = V6_SELF;                         // connected over IPv6: our address there
    }
    return sin_out(&mut k, pid, addr, lenp, me, port, ofd_v6(k, tk.h));
  }
  if tk.mode != TM_CONN || tk.t >= TCBS {
    return ENOTCONN;
  }
  return sin_out(&mut k, pid, addr, lenp, tcp_peer_ip(k.nic, tk.t), tcp_peer_port(k.nic, tk.t), ofd_v6(k, tk.h));
}

/// What a poll on a stream socket finds now: a listener is readable when a
/// connection is waiting to be accepted, a connection when bytes or the
/// end have arrived, and writable while its send buffer has room.
fn tcp_poll_bits(k: &Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
{
  let tk = tk_look(k, pid, fd);
  if tk.err != 0 {
    return POLLNVAL;
  }
  if tk.mode == TM_NEW {
    return POLLOUT | POLLHUP;               // as Linux: not connected
  }
  match k.nic {
    Nic::None => { return POLLERR | POLLHUP; },
    Nic::Up(n) => {
      if tk.rd == 1 && tk.mode == TM_CONN {
        return tcb_poll_bits(n, tk.t, false) | POLLIN | POLLRDHUP;
      }
      return tcb_poll_bits(n, tk.t, tk.mode == TM_LISTEN);
    },
  }
}

fn tcb_poll_bits(n: &Net, t: u64, listener: bool) -> u64
  requires net_ok(n)
{
  if !tcb_held(n, t) {
    return POLLERR | POLLHUP;
  }
  if listener {
    let mut c = 0;
    while c < TCBS
      invariant c <= TCBS && net_ok(n)
    {
      if tw(n, c, W_PARENT) == t && tw(n, c, W_HELD) == 0 && synced(tw(n, c, W_STATE)) {
        return POLLIN;                      // what tcp_take would hand out
      }
      c = c + 1;
    }
    return 0;
  }
  let st = tw(n, t, W_STATE);
  if st == T_SYN_SENT || st == T_SYN_RCVD {
    return 0;
  }
  if tw(n, t, W_RESET) == 1 || st == T_CLOSED {
    return POLLIN | POLLERR | POLLHUP;
  }
  let mut b = 0;
  if tw(n, t, W_RXLEN) > 0 {
    b = POLLIN;
  }
  if tw(n, t, W_PEERFIN) == 1 {
    b = POLLIN | POLLRDHUP;                 // nothing more comes
  }
  if tw(n, t, W_PEERFIN) == 1 && tw(n, t, W_FIN) != 0 {
    b = b | POLLHUP;                        // closed both ways
  }
  if tw(n, t, W_FIN) == 0 && (st == T_ESTABLISHED || st == T_CLOSE_WAIT) && tw(n, t, W_TXLEN) < TCP_RING {
    b = b | POLLOUT;
  }
  return b;
}
