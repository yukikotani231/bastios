// A virtio network card, driven by polling through two virtqueues: queue 0
// receives (the driver offers empty buffers, the device fills them) and
// queue 1 transmits. Like the block driver, every page the card can touch
// is a `Dma` lent to it at start and taken back only after a reset at power
// off, and every access to those pages is proved inside the page.
//
// Memory, nine pages: two queues of three pages, two pages of receive
// buffers (four buffers of 2 KiB) and one transmit page (two buffers of
// 2 KiB, so a frame can be built while the card still sends the last). Each buffer starts
// with the 10-byte legacy virtio-net header, then the Ethernet frame.

import "virtq.bastio";
import "vt.bastio";
import "netconst.bastio";

const VIRTIO_NET: u64 = 0x1000;       // legacy (transitional) network device id
const NET_F_MAC: u64 = 32;            // feature bit 5: the card has a MAC address
const TX_BUF: u64 = 2048;             // the transmit page holds two
const NET_PAGES: u64 = 17;            // set aside for a card: a virtio one takes nine, an e1000 seventeen

struct VNet {
  io: Vt,
  rx: Vq,
  tx: Vq,
  rb0: Dma,           // receive buffers 0 and 1
  rb1: Dma,           // receive buffers 2 and 3
  tb: Dma,            // the two transmit buffers (descriptors 0 and 1)
  tx_busy0: bool,     // the card has not handed transmit buffer 0 back yet
  tx_busy1: bool,
  rx_kick: bool,      // buffers were offered again since the card was told
  hdr: u64,           // the header before each frame: 10 bytes (legacy) or 12 (modern)
  mac: u64,           // 48 bits, first byte most significant
  live: bool,
  irq: bool,          // a received frame can raise MSI-X message 0 (see vnet_irq)
}

spec fn vnet_ok(v: &VNet) -> bool {
  vt_ok(v.io) && vq_ok(v.rx) && vq_ok(v.tx) && v.mac < 281474976710656 && (v.hdr == NET_HDR || v.hdr == NET_HDR + 2)
}

/// Copies n bytes of receive buffer `b`, from offset `off`, into pkt.
fn rxbuf_copy(v: &mut VNet, b: u64, off: u64, pkt: &mut Bytes, n: u64)
  requires vnet_ok(v) && b < RX_BUFS && off + n <= RX_BUF && n <= blen(pkt)
  ensures vnet_ok(v) && blen(pkt) == old(blen(pkt)) && v.live == old(v.live)
{
  if b < 2 {
    dma_to_bytes(&mut pkt, 0, &mut v.rb0, b * RX_BUF + off, n);
  } else {
    dma_to_bytes(&mut pkt, 0, &mut v.rb1, (b - 2) * RX_BUF + off, n);
  }
}

/// Offers receive buffer `b` (descriptor `b`) to the card again.
fn rx_give(v: &mut VNet, b: u64)
  requires vnet_ok(v) && b < RX_BUFS
  ensures vnet_ok(v)
  ensures forall k: u64 :: vt_holds(v.io, k) == old(vt_holds(v.io, k))
  ensures forall a: u64 :: vt_claims(v.io, a) == old(vt_claims(v.io, a))
{
  vq_push(&mut v.rx, b);
  vt_notify(&mut v.io, 0);
}

/// Lends the card nine pages, posts the receive buffers and reads its MAC
/// address, over the transport `io` (its ports or registers, claimed by
/// the caller). A card that cannot be started is left with `live` false:
/// it sends nothing and receives nothing. `msix`: MSI-X is on at the card,
/// entry 0 aimed at V_NET; the receive queue is then given message 0,
/// still quiet until `vnet_irq` (sent frames are collected when the next
/// one is sent, so they raise nothing).
fn vnet_new(io: Vt, q0: Frame, q1: Frame, q2: Frame, t0: Frame, t1: Frame, t2: Frame, b0: Frame, b1: Frame, b2: Frame, msix: bool) -> VNet
  requires vt_ok(io)
  ensures vnet_ok(result)
  ensures forall k: u64 :: vt_holds(result.io, k) == old(vt_holds(io, k))
  ensures forall a: u64 :: vt_claims(result.io, a) == old(vt_claims(io, a))
{
  let mut v = VNet {
    io: io, rx: vq_new(q0, q1, q2), tx: vq_new(t0, t1, t2),
    rb0: dma_lend(b0), rb1: dma_lend(b1), tb: dma_lend(b2), tx_busy0: false, tx_busy1: false, rx_kick: false, hdr: NET_HDR, mac: 0, live: false, irq: false,
  };
  let a0 = dma_addr(v.rb0);
  let a1 = dma_addr(v.rb1);
  let at = dma_addr(v.tb);
  if a0 > ADDR_LIMIT || a1 > ADDR_LIMIT || at > ADDR_LIMIT || !vt_start(&mut v.io, NET_F_MAC)
    || !vq_setup(&mut v.io, &mut v.rx, 0) || !vq_setup(&mut v.io, &mut v.tx, 1) {
    vt_status(&mut v.io, 0);
    return v;
  }
  if v.rx.n < RX_BUFS {
    vt_status(&mut v.io, 0);
    return v;
  }
  vq_desc(&mut v.rx, 0, a0, RX_BUF, DESC_WRITE, 0);
  vq_desc(&mut v.rx, 1, a0 + RX_BUF, RX_BUF, DESC_WRITE, 0);
  vq_desc(&mut v.rx, 2, a1, RX_BUF, DESC_WRITE, 0);
  vq_desc(&mut v.rx, 3, a1 + RX_BUF, RX_BUF, DESC_WRITE, 0);
  if msix {
    // The device answers VIO_NO_VECTOR if it cannot take the message.
    v.irq = vt_msix(&mut v.io, 2);
  }
  let m0 = vt_cfg8(&mut v.io, 0, msix);
  let m1 = vt_cfg8(&mut v.io, 1, msix);
  let m2 = vt_cfg8(&mut v.io, 2, msix);
  let m3 = vt_cfg8(&mut v.io, 3, msix);
  let m4 = vt_cfg8(&mut v.io, 4, msix);
  let m5 = vt_cfg8(&mut v.io, 5, msix);
  v.mac = ((((m0 * 256 + m1) * 256 + m2) * 256 + m3) * 256 + m4) * 256 + m5;
  let ok = VIO_ACK + VIO_DRIVER + VIO_DRIVER_OK;
  if vt_modern(&mut v.io) {
    v.hdr = NET_HDR + 2;
    vt_status(&mut v.io, ok + VIO_FEATURES_OK);
  } else {
    vt_status(&mut v.io, ok);
  }
  v.live = true;
  let mut b = 0;
  while b < RX_BUFS
    invariant b <= RX_BUFS && vnet_ok(v)
    invariant forall k: u64 :: vt_holds(v.io, k) == old(vt_holds(io, k))
    invariant forall a: u64 :: vt_claims(v.io, a) == old(vt_claims(io, a))
  {
    rx_give(&mut v, b);
    b = b + 1;
  }
  return v;
}

/// Whether a received frame raises the card's message, if it can.
fn vnet_irq(v: &mut VNet, on: bool)
  requires vnet_ok(v)
  ensures vnet_ok(v)
{
  if v.irq && on {
    vq_interrupts(&mut v.rx);
  } else if v.irq {
    vq_quiet(&mut v.rx);
  }
}

/// Resets the card, so it stops using the pages, takes them back and gives
/// the ports or registers back (at power off).
fn vnet_free(v: VNet, m: &mut Mem) -> Vt
  requires vnet_ok(v) && mem_ok(m)
  ensures mem_ok(m)
{
  let mut d = v;
  vt_stop(&mut d.io, 0);
  vt_stop(&mut d.io, 1);
  vq_free(d.rx, &mut m);
  vq_free(d.tx, &mut m);
  give_page(&mut m, dma_take(d.rb0));
  give_page(&mut m, dma_take(d.rb1));
  give_page(&mut m, dma_take(d.tb));
  return d.io;
}

/// Copies the next received frame into `pkt` and returns its length, or 0
/// if none has arrived. The buffer goes straight back to the card, which
/// is told once per poll (vnet_rx_flush): each notice is a port write,
/// slow in a virtual machine, and made under the kernel lock.
fn vnet_recv(v: &mut VNet, pkt: &mut Bytes) -> u64
  requires vnet_ok(v) && blen(pkt) >= RX_BUF
  ensures vnet_ok(v) && blen(pkt) == old(blen(pkt)) && result <= RX_BUF - NET_HDR
{
  if !v.live || !vq_has_used(&mut v.rx) {
    return 0;
  }
  let b = vq_used_id(&mut v.rx);
  let got = vq_used_len(&mut v.rx);
  vq_next(&mut v.rx);
  if b >= RX_BUFS {
    return 0;                         // not one of ours: the card is confused
  }
  let mut n = 0;
  if got > v.hdr && got <= RX_BUF {
    n = got - v.hdr;
  }
  rxbuf_copy(&mut v, b, v.hdr, &mut pkt, n);
  vq_push(&mut v.rx, b);
  v.rx_kick = true;
  return n;
}

/// Tells the card about the receive buffers vnet_recv offered again.
fn vnet_rx_flush(v: &mut VNet)
  requires vnet_ok(v)
  ensures vnet_ok(v)
{
  if v.rx_kick {
    vt_notify(&mut v.io, 0);
    v.rx_kick = false;
  }
}

/// Takes back the transmit buffers the card has finished with.
fn tx_collect(v: &mut VNet)
  requires vnet_ok(v)
  ensures vnet_ok(v) && v.live == old(v.live)
{
  let mut k = 0;
  while k < 2 && vq_has_used(&mut v.tx)
    invariant vnet_ok(v) && v.live == old(v.live)
  {
    let b = vq_used_id(&mut v.tx);
    vq_next(&mut v.tx);
    if b == 0 {
      v.tx_busy0 = false;
    } else if b == 1 {
      v.tx_busy1 = false;
    }
    k = k + 1;
  }
}

/// Sends the first `n` bytes of `pkt` as one frame. It does not wait for
/// the card to take it, only, if both transmit buffers are still out, for
/// one of them to come back; false if the card never hands one back.
/// Before, every frame was waited for, and under QEMU the card sends from
/// its I/O thread, so the kernel lock was held across that thread's turn.
fn vnet_send(v: &mut VNet, pkt: &Bytes, n: u64) -> bool
  requires vnet_ok(v) && n <= FRAME_MAX && n <= blen(pkt)
  ensures vnet_ok(v)
{
  if !v.live {
    return false;
  }
  tx_collect(&mut v);
  let mut spins = 0;
  while v.tx_busy0 && v.tx_busy1 && spins < VIO_SPINS
    invariant vnet_ok(v) && v.live
  {
    tx_collect(&mut v);
    spins = spins + 1;
  }
  if v.tx_busy0 && v.tx_busy1 {
    return false;
  }
  let mut b = 0;
  if v.tx_busy0 {
    b = 1;
  }
  let at = b * TX_BUF;
  let mut i = 0;
  let hdr = v.hdr;
  while i < hdr
    invariant i <= hdr && at <= TX_BUF && hdr <= NET_HDR + 2
  {
    dma_write8(&mut v.tb, at + i, 0);  // no checksum offload, no segmentation
    i = i + 1;
  }
  bytes_to_dma(&mut v.tb, at + hdr, pkt, 0, n);
  let a = dma_addr(v.tb);
  if a > ADDR_LIMIT {
    return false;                     // vnet_new checked it: never
  }
  vq_desc(&mut v.tx, b, a + at, hdr + n, 0, 0);
  if b == 0 {
    v.tx_busy0 = true;
  } else {
    v.tx_busy1 = true;
  }
  vq_push(&mut v.tx, b);
  vt_notify(&mut v.io, 1);
  return true;
}
