// A virtio network card, driven by polling through two virtqueues: queue 0
// receives (the driver offers empty buffers, the device fills them) and
// queue 1 transmits. Like the block driver, every page the card can touch
// is a `Dma` lent to it at start and taken back only after a reset at power
// off, and every access to those pages is proved inside the page.
//
// Memory, nine pages: two queues of three pages, two pages of receive
// buffers (four buffers of 2 KiB) and one transmit page. Each buffer starts
// with the 10-byte legacy virtio-net header, then the Ethernet frame.

import "virtq.bastio";

const VIRTIO_NET: u64 = 0x1000;       // legacy (transitional) network device id
const NET_F_MAC: u64 = 32;            // feature bit 5: the card has a MAC address
const NET_HDR: u64 = 10;
const RX_BUFS: u64 = 4;
const RX_BUF: u64 = 2048;
const FRAME_MAX: u64 = 1514;          // Ethernet header + 1500 bytes
const NET_PAGES: u64 = 9;

struct VNet {
  io: PortIo,
  rx: Vq,
  tx: Vq,
  rb0: Dma,           // receive buffers 0 and 1
  rb1: Dma,           // receive buffers 2 and 3
  tb: Dma,            // the frame being sent
  mac: u64,           // 48 bits, first byte most significant
  live: bool,
  irq: bool,          // a received frame can raise MSI-X message 0 (see vnet_irq)
}

spec fn vnet_ok(v: &VNet) -> bool {
  port_count(v.io) == VIO_PORTS && vq_ok(v.rx) && vq_ok(v.tx) && v.mac < 281474976710656
}

/// Byte `off` of receive buffer `b`.
fn rxbuf_read8(v: &mut VNet, b: u64, off: u64) -> u8
  requires b < RX_BUFS && off < RX_BUF
{
  if b < 2 {
    return dma_read8(&mut v.rb0, b * RX_BUF + off);
  }
  return dma_read8(&mut v.rb1, (b - 2) * RX_BUF + off);
}

/// Offers receive buffer `b` (descriptor `b`) to the card again.
fn rx_give(v: &mut VNet, b: u64)
  requires vnet_ok(v) && b < RX_BUFS
  ensures vnet_ok(v)
{
  vq_push(&mut v.rx, b);
  pio_out16(&mut v.io, VIO_QUEUE_NOTIFY, 0);
}

/// Claims the card's ports, lends it nine pages, posts the receive buffers
/// and reads its MAC address. A card that cannot be started is left with
/// `live` false: it sends nothing and receives nothing. `msix`: MSI-X is
/// on at the card, entry 0 aimed at V_NET; the receive queue is then given
/// message 0, still quiet until `vnet_irq` (transmits are waited for, so
/// they raise nothing).
fn vnet_new(ports: &mut Ports, base: u64, q0: Frame, q1: Frame, q2: Frame, t0: Frame, t1: Frame, t2: Frame, b0: Frame, b1: Frame, b2: Frame, msix: bool) -> VNet
  requires base + VIO_PORTS <= 65536
  requires forall k: u64 :: base <= k && k < base + VIO_PORTS ==> port_free(ports, k)
  ensures vnet_ok(result)
{
  let mut v = VNet {
    io: port_claim(&mut ports, base, VIO_PORTS), rx: vq_new(q0, q1, q2), tx: vq_new(t0, t1, t2),
    rb0: dma_lend(b0), rb1: dma_lend(b1), tb: dma_lend(b2), mac: 0, live: false, irq: false,
  };
  let a0 = dma_addr(v.rb0);
  let a1 = dma_addr(v.rb1);
  let at = dma_addr(v.tb);
  if a0 > ADDR_LIMIT || a1 > ADDR_LIMIT || at > ADDR_LIMIT || !virtio_start(&mut v.io, NET_F_MAC)
    || !vq_setup(&mut v.io, &mut v.rx, 0) || !vq_setup(&mut v.io, &mut v.tx, 1) {
    pio_out8(&mut v.io, VIO_STATUS, 0);
    return v;
  }
  if v.rx.n < RX_BUFS {
    pio_out8(&mut v.io, VIO_STATUS, 0);
    return v;
  }
  vq_desc(&mut v.rx, 0, a0, RX_BUF, DESC_WRITE, 0);
  vq_desc(&mut v.rx, 1, a0 + RX_BUF, RX_BUF, DESC_WRITE, 0);
  vq_desc(&mut v.rx, 2, a1, RX_BUF, DESC_WRITE, 0);
  vq_desc(&mut v.rx, 3, a1 + RX_BUF, RX_BUF, DESC_WRITE, 0);
  let mut cfg = VIO_CONFIG;
  if msix {
    // The device answers VIO_NO_VECTOR if it cannot take the message.
    cfg = VIO_CONFIG_MSIX;
    pio_out16(&mut v.io, VIO_MSIX_CONFIG, cast[u16](VIO_NO_VECTOR));
    pio_out16(&mut v.io, VIO_QUEUE_SEL, 1);
    pio_out16(&mut v.io, VIO_MSIX_QUEUE, cast[u16](VIO_NO_VECTOR));
    pio_out16(&mut v.io, VIO_QUEUE_SEL, 0);
    pio_out16(&mut v.io, VIO_MSIX_QUEUE, 0);
    v.irq = cast[u64](pio_in16(&mut v.io, VIO_MSIX_QUEUE)) == 0;
  }
  let m0 = cast[u64](pio_in8(&mut v.io, cfg));
  let m1 = cast[u64](pio_in8(&mut v.io, cfg + 1));
  let m2 = cast[u64](pio_in8(&mut v.io, cfg + 2));
  let m3 = cast[u64](pio_in8(&mut v.io, cfg + 3));
  let m4 = cast[u64](pio_in8(&mut v.io, cfg + 4));
  let m5 = cast[u64](pio_in8(&mut v.io, cfg + 5));
  v.mac = ((((m0 * 256 + m1) * 256 + m2) * 256 + m3) * 256 + m4) * 256 + m5;
  pio_out8(&mut v.io, VIO_STATUS, cast[u8](VIO_ACK + VIO_DRIVER + VIO_DRIVER_OK));
  v.live = true;
  let mut b = 0;
  while b < RX_BUFS
    invariant b <= RX_BUFS && vnet_ok(v)
  {
    rx_give(&mut v, b);
    b = b + 1;
  }
  return v;
}

/// Whether a received frame raises the card's message, if it can.
fn vnet_irq(v: &mut VNet, on: bool)
  requires vnet_ok(v)
  ensures vnet_ok(v)
{
  if v.irq && on {
    vq_interrupts(&mut v.rx);
  } else if v.irq {
    vq_quiet(&mut v.rx);
  }
}

/// Resets the card, so it stops using the pages, takes them back and gives
/// the ports back (at power off).
fn vnet_free(ports: &mut Ports, v: VNet, m: &mut Mem)
  requires vnet_ok(v) && mem_ok(m)
  ensures mem_ok(m)
{
  let mut d = v;
  pio_out8(&mut d.io, VIO_STATUS, 0);
  pio_out16(&mut d.io, VIO_QUEUE_SEL, 0);
  pio_out32(&mut d.io, VIO_QUEUE_PFN, 0);
  pio_out16(&mut d.io, VIO_QUEUE_SEL, 1);
  pio_out32(&mut d.io, VIO_QUEUE_PFN, 0);
  vq_free(d.rx, &mut m);
  vq_free(d.tx, &mut m);
  give_page(&mut m, dma_take(d.rb0));
  give_page(&mut m, dma_take(d.rb1));
  give_page(&mut m, dma_take(d.tb));
  port_release(&mut ports, d.io);
}

/// Copies the next received frame into `pkt` and returns its length, or 0
/// if none has arrived. The buffer goes straight back to the card.
fn vnet_recv(v: &mut VNet, pkt: &mut Bytes) -> u64
  requires vnet_ok(v) && blen(pkt) >= RX_BUF
  ensures vnet_ok(v) && blen(pkt) == old(blen(pkt)) && result <= RX_BUF - NET_HDR
{
  if !v.live || !vq_has_used(&mut v.rx) {
    return 0;
  }
  let b = vq_used_id(&mut v.rx);
  let got = vq_used_len(&mut v.rx);
  vq_next(&mut v.rx);
  if b >= RX_BUFS {
    return 0;                         // not one of ours: the card is confused
  }
  let mut n = 0;
  if got > NET_HDR && got <= RX_BUF {
    n = got - NET_HDR;
  }
  let l = blen(pkt);
  let mut i = 0;
  while i < n
    invariant i <= n && n <= RX_BUF - NET_HDR && vnet_ok(v) && blen(pkt) == l && l >= RX_BUF && b < RX_BUFS
  {
    bset(&mut pkt, i, rxbuf_read8(&mut v, b, NET_HDR + i));
    i = i + 1;
  }
  rx_give(&mut v, b);
  return n;
}

/// Sends the first `n` bytes of `pkt` as one frame and waits until the card
/// has taken it.
fn vnet_send(v: &mut VNet, pkt: &Bytes, n: u64) -> bool
  requires vnet_ok(v) && n <= FRAME_MAX && n <= blen(pkt)
  ensures vnet_ok(v)
{
  if !v.live {
    return false;
  }
  let mut i = 0;
  while i < NET_HDR
    invariant i <= NET_HDR
  {
    dma_write8(&mut v.tb, i, 0);      // no checksum offload, no segmentation
    i = i + 1;
  }
  let mut j = 0;
  while j < n
    invariant j <= n && n <= FRAME_MAX && n <= blen(pkt)
  {
    dma_write8(&mut v.tb, NET_HDR + j, bget(pkt, j));
    j = j + 1;
  }
  let a = dma_addr(v.tb);
  vq_desc(&mut v.tx, 0, a, NET_HDR + n, 0, 0);
  vq_push(&mut v.tx, 0);
  pio_out16(&mut v.io, VIO_QUEUE_NOTIFY, 1);
  return vq_wait(&mut v.tx);
}
