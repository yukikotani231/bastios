// The disk's block cache and its queue of commands, so that a process
// waiting for the disk can sleep while others run.
//
// The cache holds NC blocks of 4 KiB. A slot is free, valid (it holds
// block tag[i] as the disk has it), reading (a read of tag[i] is queued or
// running), or dirty (it holds data a queued or running write will put on
// the disk). Reading and dirty slots are pinned: they cannot be evicted.
//
// The queue runs its operations in order, one device command at a time:
// reads, writes, flushes (a barrier: everything before it is on the
// medium when it finishes), and two that need no device: freeing a block
// (handed back to the file system, which owns the free map) and the end
// of a transaction (`done` becomes its number). A write call queues its
// blocks, a flush, its directory block, a flush, its frees and its end,
// so its directory entry is on the disk only after every block it points
// at, and the blocks it replaced are reused only after that.
//
// dq_pump moves the queue along without waiting; it is called whenever the
// kernel polls devices, and by an idle processor while the queue is not
// empty. dq_drain waits for the queue to empty, for code that still does
// its disk I/O synchronously.

import "blk.bastio";
import "blkconst.bastio";
import "core/ring.bastio";

const CBLOCK: u64 = 4096;            // a block
const NC: u64 = 256;                  // cache slots (1 MiB: more than BusyBox, re-read on each exec at 256 KiB)
const NQ: u64 = 128;                  // queued operations
const QW: u64 = 3;                    // words per operation: kind, slot, block
const DQ_NONE: u64 = 18446744073709551615;
const NOTAG: u64 = 18446744073709551615;   // a slot no lookup finds (a directory snapshot)
const DQ_SPINS: u64 = 200000000;      // dq_drain's patience
const DQ_TICKS: u64 = 1000;           // a command running 10 s means the disk is gone

const CS_FREE: u64 = 0;
const CS_VALID: u64 = 1;
const CS_READING: u64 = 2;
const CS_DIRTY: u64 = 3;
const CS_HOLD: u64 = 4;               // dirty, but no write is queued yet (dq_hold): pinned until dq_queue_held

const Q_READ: u64 = 0;
const Q_WRITE: u64 = 1;
const Q_FLUSH: u64 = 2;
const Q_FREE: u64 = 3;
const Q_DONE: u64 = 4;

// What dq_pump reports.
const DQ_IDLE: u64 = 0;               // nothing more to do until the device finishes
const DQ_MOVED: u64 = 1;              // something happened; call again
const DQ_FREED: u64 = 2;              // DQ_FREED + b: block b is free now

struct DiskQ {
  cache: Bytes,         // NC blocks
  tag: Buf,             // per slot: the block it holds, or NOTAG
  st: Buf,              // per slot: CS_*
  q: Buf,               // NQ operations, a ring
  r: Ring,              // the queue's head (the oldest operation) and count
                        // (operations queued, the one running included)
  running: bool,        // the head operation is on the device
  batch: u64,           // and with it the next batch - 1 reads, of the blocks after its (blk_begin_n)
  since: u64,           // the tick it started
  hand: u64,            // the eviction clock's hand
  next: u64,            // the number the next transaction gets
  done: u64,            // the last transaction finished
  moved: u64,           // counts operations finished, so sleepers know to look again
  dead: bool,           // a command failed or never finished: the disk is not used again
  good: u64,            // once dead: the last transaction that finished before it died
}

spec fn dq_ok(q: &DiskQ) -> bool {
  blen(q.cache) == NC * CBLOCK && len(q.tag) == NC && len(q.st) == NC && len(q.q) == NQ * QW
  && ring_ok(q.r) && q.r.cap == NQ && q.hand < NC && q.batch >= 1 && q.batch <= VIO_BATCH
}

fn dq_new() -> DiskQ
  ensures dq_ok(result)
{
  let mut q = DiskQ { cache: balloc(NC * CBLOCK), tag: alloc(NC), st: alloc(NC), q: alloc(NQ * QW),
    r: ring_new(NQ), running: false, batch: 1, since: 0, hand: 0, next: 1, done: 0, moved: 0, dead: false, good: 0 };
  let mut i = 0;
  while i < NC
    invariant i <= NC && dq_ok(q)
  {
    q.tag = set(q.tag, i, NOTAG);
    i = i + 1;
  }
  return q;
}

fn dq_free(q: DiskQ)
  requires dq_ok(q)
{
  bfree(q.cache);
  free(q.tag);
  free(q.st);
  free(q.q);
}

/// Has every queued operation finished?
fn dq_idle(q: &DiskQ) -> bool {
  return q.r.n == 0;
}

/// The disk failed: nothing more is sent to it. Transactions up to
/// `good` reached it whole; any later one did not, even once its end is
/// passed in the queue.
fn dq_kill(q: &mut DiskQ)
  requires dq_ok(q)
  ensures dq_ok(q) && q.dead
  ensures q.r.h == old(q.r.h) && q.r.n == old(q.r.n) && q.running == old(q.running)
  ensures q.next == old(q.next) && q.done == old(q.done) && q.moved == old(q.moved)
{
  if !q.dead {
    q.good = q.done;
    q.dead = true;
  }
}

/// The slot holding block b's data (valid or dirty), or NC.
fn dq_find(q: &DiskQ, b: u64) -> u64
  requires dq_ok(q)
  ensures result <= NC
  ensures result < NC ==> (get(q.st, result) == CS_VALID || get(q.st, result) == CS_DIRTY || get(q.st, result) == CS_HOLD)
{
  let mut i = 0;
  while i < NC
    invariant i <= NC && dq_ok(q)
  {
    let s = get(q.st, i);
    if get(q.tag, i) == b && (s == CS_VALID || s == CS_DIRTY || s == CS_HOLD) {
      return i;
    }
    i = i + 1;
  }
  return NC;
}

/// Is a read of block b queued or running?
fn dq_reading(q: &DiskQ, b: u64) -> bool
  requires dq_ok(q)
{
  let mut i = 0;
  while i < NC
    invariant i <= NC && dq_ok(q)
  {
    if get(q.tag, i) == b && get(q.st, i) == CS_READING {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// A slot to fill: a free one, else a valid one the clock passes over
/// (it is forgotten); NC if every slot is pinned.
fn dq_slot(q: &mut DiskQ) -> u64
  requires dq_ok(q)
  ensures dq_ok(q) && result <= NC
  ensures result < NC ==> get(q.st, result) == CS_FREE
{
  let mut i = 0;
  while i < NC
    invariant i <= NC && dq_ok(q)
  {
    if get(q.st, i) == CS_FREE {
      return i;
    }
    i = i + 1;
  }
  let mut n = 0;
  while n < NC
    invariant n <= NC && dq_ok(q)
  {
    let h = q.hand;
    q.hand = (q.hand + 1) % NC;
    if get(q.st, h) == CS_VALID {
      q.st = set(q.st, h, CS_FREE);
      q.tag = set(q.tag, h, NOTAG);
      return h;
    }
    n = n + 1;
  }
  return NC;
}

/// How many slots could be filled now without waiting.
fn dq_room(q: &DiskQ) -> u64
  requires dq_ok(q)
  ensures result <= NC
{
  let mut i = 0;
  let mut n = 0;
  while i < NC
    invariant i <= NC && n <= i && dq_ok(q)
  {
    let s = get(q.st, i);
    if s == CS_FREE || s == CS_VALID {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

/// Room for `slots` more slots and `ops` more operations?
fn dq_fits(q: &DiskQ, slots: u64, ops: u64) -> bool
  requires dq_ok(q)
{
  return ops <= NQ - q.r.n && slots <= dq_room(q);
}

/// Forgets any copy of block b (it was freed and is being reused): a
/// valid slot becomes free, a pinned one finishes untagged.
fn dq_forget(q: &mut DiskQ, b: u64)
  requires dq_ok(q)
  ensures dq_ok(q) && q.r.n == old(q.r.n)
{
  let mut i = 0;
  let c0 = q.r.n;
  while i < NC
    invariant i <= NC && dq_ok(q) && q.r.n == c0
  {
    if get(q.tag, i) == b {
      if get(q.st, i) == CS_VALID {
        q.st = set(q.st, i, CS_FREE);
      }
      q.tag = set(q.tag, i, NOTAG);
    }
    i = i + 1;
  }
}

/// Appends an operation.
fn dq_push(q: &mut DiskQ, kind: u64, slot: u64, b: u64)
  requires dq_ok(q) && q.r.n < NQ
  ensures dq_ok(q) && q.r.n == old(q.r.n) + 1
  ensures forall i: u64 :: get(q.st, i) == old(get(q.st, i))
  ensures forall i: u64 :: get(q.tag, i) == old(get(q.tag, i))
{
  let at = ring_push(&mut q.r) * QW;
  q.q = set(q.q, at, kind);
  q.q = set(q.q, at + 1, slot);
  q.q = set(q.q, at + 2, b);
}

/// Block b's slot if it is cached; otherwise queues a read of it (unless
/// one is queued already) and returns NC, or DQ_NONE if there is no room
/// to queue one (try again once the queue has moved).
fn dq_want(q: &mut DiskQ, b: u64) -> u64
  requires dq_ok(q)
  ensures dq_ok(q)
  ensures result < NC || result == NC || result == DQ_NONE
  ensures result < NC ==> (get(q.st, result) == CS_VALID || get(q.st, result) == CS_DIRTY || get(q.st, result) == CS_HOLD)
{
  let f = dq_find(q, b);
  if f < NC {
    return f;
  }
  if dq_reading(q, b) {
    return NC;
  }
  if q.r.n >= NQ {
    return DQ_NONE;
  }
  let s = dq_slot(&mut q);
  if s >= NC {
    return DQ_NONE;
  }
  q.tag = set(q.tag, s, b);
  q.st = set(q.st, s, CS_READING);
  dq_push(&mut q, Q_READ, s, b);
  return NC;
}

/// Queues writing src[at .. at + 4096] to block b: copies it into a slot,
/// which then answers lookups of b (unless `look` is false, for a
/// directory block, which is read from memory). Any older copy of b is
/// forgotten. False if there is no slot or no room in the queue.
fn dq_put(q: &mut DiskQ, b: u64, src: &Bytes, at: u64, look: bool) -> bool
  requires dq_ok(q) && at + CBLOCK <= blen(src)
  ensures dq_ok(q)
{
  if q.r.n >= NQ {
    return false;
  }
  if look {
    dq_forget(&mut q, b);
  }
  let s = dq_slot(&mut q);
  if s >= NC {
    return false;
  }
  bcopy(&mut q.cache, s * CBLOCK, src, at, CBLOCK);
  if look {
    q.tag = set(q.tag, s, b);
  } else {
    q.tag = set(q.tag, s, NOTAG);
  }
  q.st = set(q.st, s, CS_DIRTY);
  dq_push(&mut q, Q_WRITE, s, b);
  return true;
}

/// Queues a flush.
fn dq_flush(q: &mut DiskQ) -> bool
  requires dq_ok(q)
  ensures dq_ok(q)
{
  if q.r.n >= NQ {
    return false;
  }
  dq_push(&mut q, Q_FLUSH, 0, 0);
  return true;
}

/// Queues handing block b back to the file system.
fn dq_release(q: &mut DiskQ, b: u64) -> bool
  requires dq_ok(q)
  ensures dq_ok(q)
{
  if q.r.n >= NQ {
    return false;
  }
  dq_push(&mut q, Q_FREE, 0, b);
  return true;
}

/// Puts src[at .. at + 4096] in the cache as block b without queueing a
/// write: the slot answers lookups of b and is pinned until dq_queue_held.
/// A slot already held for b is overwritten in place; any other copy of b
/// is forgotten. False if there is no slot.
fn dq_hold(q: &mut DiskQ, b: u64, src: &Bytes, at: u64) -> bool
  requires dq_ok(q) && at + CBLOCK <= blen(src)
  ensures dq_ok(q)
{
  let mut i = 0;
  while i < NC
    invariant i <= NC && dq_ok(q)
  {
    if get(q.tag, i) == b && get(q.st, i) == CS_HOLD {
      bcopy(&mut q.cache, i * CBLOCK, src, at, CBLOCK);
      return true;
    }
    i = i + 1;
  }
  dq_forget(&mut q, b);
  let s = dq_slot(&mut q);
  if s >= NC {
    return false;
  }
  bcopy(&mut q.cache, s * CBLOCK, src, at, CBLOCK);
  q.tag = set(q.tag, s, b);
  q.st = set(q.st, s, CS_HOLD);
  return true;
}

/// Queues the write of the slot held for block b (dq_hold); it becomes an
/// ordinary dirty slot. False if no slot is held for b or the queue is full.
fn dq_queue_held(q: &mut DiskQ, b: u64) -> bool
  requires dq_ok(q)
  ensures dq_ok(q)
{
  if q.r.n >= NQ {
    return false;
  }
  let mut i = 0;
  while i < NC
    invariant i <= NC && dq_ok(q)
  {
    if get(q.tag, i) == b && get(q.st, i) == CS_HOLD {
      if q.r.n >= NQ {
        return false;
      }
      q.st = set(q.st, i, CS_DIRTY);
      dq_push(&mut q, Q_WRITE, i, b);
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Ends the transaction being queued; returns its number (0 if the queue
/// is full, which callers avoid by checking dq_fits first).
fn dq_end(q: &mut DiskQ) -> u64
  requires dq_ok(q)
  ensures dq_ok(q)
{
  if q.r.n >= NQ || q.next >= 0x4000000000000000 {
    return 0;                         // (2^62 transactions take centuries)
  }
  let t = q.next;
  q.next = q.next + 1;
  dq_push(&mut q, Q_DONE, 0, t);
  return t;
}

/// Drops the head operation.
fn dq_pop(q: &mut DiskQ)
  requires dq_ok(q) && q.r.n > 0
  ensures dq_ok(q)
{
  ring_pop_n(&mut q.r, 1);
  q.running = false;
  q.batch = 1;
  q.moved = (q.moved % 0x4000000000000000) + 1;
}

/// What a finished slot becomes: valid if a lookup can find it, else free.
fn dq_settle(q: &mut DiskQ, s: u64)
  requires dq_ok(q) && s < NC
  ensures dq_ok(q)
{
  if get(q.tag, s) == NOTAG {
    q.st = set(q.st, s, CS_FREE);
  } else {
    q.st = set(q.st, s, CS_VALID);
  }
}

/// Moves the queue along without waiting for the device. `now` is the
/// tick count, to notice a command that never finishes.
fn dq_pump(q: &mut DiskQ, dev: &mut Blk, now: u64) -> u64
  requires dq_ok(q) && blk_ok(dev)
  ensures dq_ok(q) && blk_ok(dev)
{
  if q.r.n == 0 {
    return DQ_IDLE;
  }
  let at = q.r.h * QW;
  let kind = get(q.q, at);
  let s = get(q.q, at + 1);
  let b = get(q.q, at + 2);
  if q.running {
    let r = blk_poll(&mut dev);
    if r == BIO_RUNNING {
      if !(now > q.since && now - q.since > DQ_TICKS) {
        return DQ_IDLE;
      }
      // It never finished: give it up. The driver still counts it as
      // running, so the device is given no more commands.
    }
    if r != BIO_OK {
      dq_kill(&mut q);
    }
    if q.batch > 1 {
      // A batched read (blk_begin_n): its blocks go to the slots of the
      // reads it took, which are the head and the operations after it.
      let n = q.batch;
      let mut j = 0;
      while j < n && q.r.n > 0
        invariant dq_ok(q) && blk_ok(dev)
      {
        let a2 = q.r.h * QW;
        let s2 = get(q.q, a2 + 1);
        if s2 < NC && get(q.q, a2) == Q_READ {
          if r == BIO_OK {
            blk_fetch_n(&mut dev, j, &mut q.cache, s2 * CBLOCK);
            dq_settle(&mut q, s2);
          } else {
            q.st = set(q.st, s2, CS_FREE);
            q.tag = set(q.tag, s2, NOTAG);
          }
        }
        dq_pop(&mut q);
        j = j + 1;
      }
      return DQ_MOVED;
    }
    if s < NC {
      if kind == Q_READ && r == BIO_OK {
        blk_fetch(&mut dev, &mut q.cache, s * CBLOCK);
        dq_settle(&mut q, s);
      } else if kind == Q_READ {
        q.st = set(q.st, s, CS_FREE);
        q.tag = set(q.tag, s, NOTAG);
      } else if kind == Q_WRITE {
        dq_settle(&mut q, s);
      }
    }
    dq_pop(&mut q);
    return DQ_MOVED;
  }
  if kind == Q_FREE {
    dq_pop(&mut q);
    if b >= 0x100000000000 {
      return DQ_MOVED;
    }
    return DQ_FREED + b;
  }
  if kind == Q_DONE {
    q.done = b;
    dq_pop(&mut q);
    return DQ_MOVED;
  }
  // A device command. On a dead disk it is dropped (a read's slot freed).
  if q.dead || s >= NC || b >= 0x100000000000 {
    if s < NC && kind == Q_READ {
      q.st = set(q.st, s, CS_FREE);
      q.tag = set(q.tag, s, NOTAG);
    } else if s < NC && kind == Q_WRITE {
      dq_settle(&mut q, s);
    }
    dq_kill(&mut q);
    dq_pop(&mut q);
    return DQ_MOVED;
  }
  let mut op = BIO_FLUSH;
  if kind == Q_READ {
    op = BIO_READ;
  } else if kind == Q_WRITE {
    op = BIO_WRITE;
  }
  if kind == Q_READ {
    // The reads queued after it of the blocks that follow b (read_ahead
    // queues them so) go along in one request where the device can.
    let mut want = 1;
    let mut more = true;
    while more && want < VIO_BATCH && want < q.r.n
      invariant want >= 1 && want <= VIO_BATCH && dq_ok(q)
    {
      let a2 = ((q.r.h + want) % NQ) * QW;
      if get(q.q, a2) == Q_READ && get(q.q, a2 + 1) < NC && get(q.q, a2 + 2) == b + want {
        want = want + 1;
      } else {
        more = false;
      }
    }
    let n = blk_room(dev, b * 8, want);
    if n > 1 && blk_begin_n(&mut dev, b * 8, n) {
      q.running = true;
      q.batch = n;
      q.since = now;
      return DQ_MOVED;
    }
  }
  if !blk_begin(&mut dev, op, b * 8, &mut q.cache, s * CBLOCK) {
    dq_kill(&mut q);
    return DQ_MOVED;                  // dropped on the next call
  }
  q.running = true;
  q.since = now;
  return DQ_MOVED;
}
