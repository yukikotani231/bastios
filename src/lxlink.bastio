// Symbolic links for Linux programs: symlink and symlinkat make them,
// readlink reads them (src/lxprocfs.bastio's lx_readlink calls link_out),
// and every path read from user memory has them followed (lx_follow, from
// lx_path_from). A link is a file of the file system whose mode has the
// link type bits (vfs_symlink, vfs_is_link) and whose contents are the
// target.
//
// Following is done on the already normalized path: each prefix that ends
// at a component is looked up, and a link found there is replaced by its
// target (from the top if it starts with "/", otherwise from the link's
// directory), the rest of the path is put back after it, and the result
// is normalized again. The last component is followed unless the call
// acts on a link itself (lx_path_at_nf). At most LINK_HOPS links are
// followed for one path; more is a loop, and the path does not resolve.
//
// One difference from Linux: ".." is taken away before links are
// followed, so "link/.." is the directory holding the link, not the
// parent of the link's target.

import "linux.bastio";

const LX_LINK: u64 = 86;
const LX_SYMLINK: u64 = 88;
const LX_LINKAT: u64 = 265;
const LX_SYMLINKAT: u64 = 266;
const LINK_HOPS: u64 = 8;
const SPLICE: u64 = 1024;             // 2 * PATH_OUT: a link's directory, its target and the rest
const AT_SYMLINK_FOLLOW: u64 = 0x400;

/// Normalizes src[..sl] into dst: empty parts and "." dropped, ".." going
/// up a level, no leading "/". Returns the length, or NO_RESULT if it is
/// longer than FNAME_MAX.
fn lex_norm(src: &Bytes, sl: u64, dst: &mut Bytes, floor: u64) -> u64
  requires sl <= blen(src) && blen(dst) == PATH_OUT
  ensures blen(dst) == PATH_OUT
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  let mut o = 0;
  let mut i = 0;
  while i < sl
    invariant i <= sl && sl <= blen(src) && o <= PATH_OUT && blen(dst) == PATH_OUT
  {
    if bget(src, i) == 47 {
      i = i + 1;
    } else {
      let mut j = i;
      while j < sl && bget(src, j) != 47
        invariant i <= j && j <= sl && sl <= blen(src)
      {
        j = j + 1;
      }
      let w = j - i;
      if w == 1 && bget(src, i) == 46 {
        // "." stays here
      } else if w == 2 && bget(src, i) == 46 && bget(src, i + 1) == 46 {
        while o > floor && bget(dst, o - 1) != 47
          invariant o <= PATH_OUT && blen(dst) == PATH_OUT
        {
          o = o - 1;
        }
        if o > floor {
          o = o - 1;
        }
      } else {
        if o + 1 + w > PATH_OUT {
          return NO_RESULT;
        }
        if o > 0 {
          bset(&mut dst, o, 47);
          o = o + 1;
        }
        let mut c = 0;
        while c < w
          invariant c <= w && i + w <= sl && sl <= blen(src) && o + w <= PATH_OUT && blen(dst) == PATH_OUT
        {
          bset(&mut dst, o + c, bget(src, i + c));
          c = c + 1;
        }
        o = o + w;
      }
      i = j;
    }
  }
  if o > FNAME_MAX {
    return NO_RESULT;
  }
  return o;
}

/// Follows the symbolic links in the normalized path in xfer[..n] (the
/// last component's too when `last`), leaving the result there. Returns
/// its length, or NO_RESULT (and k.perr) for a loop, a broken link, a
/// result too long, or a component under something not a directory.
/// xfer[..floor] is the caller's root (chroot): an absolute target starts
/// there, and ".." does not climb above it. The path is process pid's
/// logical one: each lookup goes through its mount namespace, and so does
/// the result (src/lxns.bastio).
fn lx_follow(k: &mut Kernel, pid: u64, n: u64, last: bool, floor: u64) -> u64
  requires kok(k) && pid < NPROC && floor <= n
  ensures kok(k)
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  if n > FNAME_MAX {
    k.perr = ENAMETOOLONG;
    return NO_RESULT;
  }
  let mut p = balloc(PATH_OUT);
  let mut q = balloc(1);                    // grown to SPLICE at the first link: most names have none
  bytes_copy_span(&mut p, 0, k.fs.xfer, 0, n);
  let ns = ns_of(k, pid);
  let mut pl = n;
  let mut e = 0;                            // where the component being looked at starts
  let mut hops = 0;
  let mut bad = false;
  while e < pl && !bad
    invariant e <= pl && pl <= FNAME_MAX && blen(p) == PATH_OUT && (blen(q) == SPLICE || blen(q) == 1) && kok(k)
  {
    let mut c = e;
    while c < pl && bget(p, c) != 47
      invariant e <= c && c <= pl && pl <= FNAME_MAX && blen(p) == PATH_OUT
    {
      c = c + 1;
    }
    let mut f = NO_FILE;
    let mut mt = NO_RESULT;                 // the target of a /proc/PID/fd/N link, in the transfer buffer
    if c < pl || last {
      // Looked up where the mount namespace maps it (src/lxns.bastio).
      let tl = ns_tr(&mut k, ns, p, c);
      if tl == NO_RESULT {
        bad = true;
      } else {
        mt = magic_link(&mut k, pid, tl);
        if mt == NO_RESULT {
          f = vfs_lookup(&mut k.fs, tl);
        }
      }
    }
    if bad {
      // the name is too long where the mount namespace maps it
    } else if mt != NO_RESULT || (f != NO_FILE && vfs_is_link(&mut k.fs, f)) {
      let mut t = mt;
      if mt == NO_RESULT {
        t = vfs_read_at(&mut k.fs, f, 0, FNAME_MAX);
      }
      if hops >= LINK_HOPS {
        bad = true;
        k.perr = ELOOP;
      } else if t == NO_FD || t == 0 || t > FNAME_MAX {
        bad = true;
        k.perr = ENOENT;
      } else {
        hops = hops + 1;
        if blen(q) != SPLICE {
          bfree(q);
          q = balloc(SPLICE);
        }
        // The link's directory (for a relative target), the target, then
        // the rest of the path.
        let mut ql = 0;
        let mut upto = smaller(floor, pl);  // an absolute target: from the root
        if bget(k.fs.xfer, 0) != 47 {
          upto = e;                         // a relative one: from the link's directory
        }
        while ql < upto
          invariant ql <= upto && upto <= pl && pl <= FNAME_MAX && blen(p) == PATH_OUT && blen(q) == SPLICE
        {
          bset(&mut q, ql, bget(p, ql));
          ql = ql + 1;
        }
        let mut a = 0;
        while a < t
          invariant a <= t && t <= FNAME_MAX && ql <= FNAME_MAX && blen(q) == SPLICE && kok(k)
        {
          bset(&mut q, ql + a, bget(k.fs.xfer, a));
          a = a + 1;
        }
        ql = ql + t;
        let mut r = c;
        while r < pl
          invariant c <= r && r <= pl && pl <= FNAME_MAX && ql <= 2 * FNAME_MAX && blen(p) == PATH_OUT && blen(q) == SPLICE
        {
          bset(&mut q, ql + r - c, bget(p, r));
          r = r + 1;
        }
        ql = ql + (pl - c);
        let nl = lex_norm(q, ql, &mut p, smaller(floor, pl));
        if nl == NO_RESULT {
          bad = true;
          k.perr = ENAMETOOLONG;
        } else {
          pl = nl;
          e = 0;                            // look again from the top
        }
      }
    } else if c < pl {
      if f != NO_FILE && !vfs_is_dir(&mut k.fs, f) {
        bad = true;                         // a file with something under it
        k.perr = ENOTDIR;
      }
      e = c + 1;
    } else {
      e = pl;
    }
  }
  bfree(q);
  if bad {
    bfree(p);
    return NO_RESULT;
  }
  // The logical path is kept (for a working directory, an open
  // directory's base or a root); the file layer's goes in the transfer
  // buffer.
  ns_keep(&mut k, p, pl);
  let tl = ns_tr_final(&mut k, ns, p, pl);
  bfree(p);
  if tl == NO_RESULT {
    return NO_RESULT;
  }
  let tv = cg_view(&mut k, tl, pid);        // the cgroup tree from the namespace's root (src/lxcgroup.bastio)
  if tv == NO_RESULT {
    return NO_RESULT;
  }
  let t1 = proc_vpid(&mut k, tv, pid);
  return proc_task(&mut k, proc_self(&mut k.fs.xfer, t1, pid));   // "proc/self" in a mounted proc too; a thread's fd and ns are its process's
}

/// readlink of the link with handle f: its target into user memory at va,
/// at most `size` bytes and no NUL. Returns the count or -errno.
fn link_out(k: &mut Kernel, pid: u64, f: u64, va: u64, size: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if size == 0 || size > 0x7FFFFFFF {
    return EINVAL;
  }
  let t = vfs_read_at(&mut k.fs, f, 0, smaller(size, FNAME_MAX));
  if t == NO_FD {
    return ENOENT;
  }
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, t) != t {
    return EFAULT;
  }
  return t;
}

/// symlink / symlinkat(target, dirfd, path): a link at path whose target
/// is the string at user address `tva`, kept as given. Returns 0 or -errno.
fn lx_symlink(k: &mut Kernel, pid: u64, tva: u64, dirfd: u64, path: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if tva < USER_BASE || tva >= USER_BASE + USER_SIZE {
    return EFAULT;
  }
  let want = smaller(PATH_MAX_LX, USER_SIZE - (tva - USER_BASE));
  let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, tva, &mut k.fs.xfer, want);
  if got == NO_RESULT {
    return EFAULT;
  }
  let mut tl = 0;
  while tl < got && bget(k.fs.xfer, tl) != 0
    invariant tl <= got && got <= XFER && kok(k)
  {
    tl = tl + 1;
  }
  if tl == 0 || tl >= got || tl > FNAME_MAX {
    return ENOENT;
  }
  let mut tb = balloc(FNAME_MAX);
  let mut i = 0;
  while i < tl
    invariant i <= tl && tl <= FNAME_MAX && tl <= XFER && blen(tb) == FNAME_MAX && kok(k)
  {
    bset(&mut tb, i, bget(k.fs.xfer, i));
    i = i + 1;
  }
  let n = lx_path_at_nf_w(&mut k, pid, dirfd, path);
  if n == NO_RESULT {
    bfree(tb);
    return k.perr;
  }
  if n == 0 {
    bfree(tb);
    return ENOENT;                          // an empty path names nothing to make
  }
  if vfs_lookup(&mut k.fs, n) != NO_FILE || dir_at(&mut k, n) != NO_FILE {
    bfree(tb);
    return EEXIST;
  }
  if path_ro(&mut k, n) {
    bfree(tb);
    return EROFS;
  }
  let e = may_dir(&mut k, pid, n);
  if e != 0 {
    bfree(tb);
    return e;
  }
  let own = new_owner(&mut k, pid, n);
  let mut j = 0;
  while j < tl
    invariant j <= tl && tl <= FNAME_MAX && n <= FNAME_MAX && blen(tb) == FNAME_MAX && kok(k)
  {
    bset(&mut k.fs.xfer, n + j, bget(tb, j));
    j = j + 1;
  }
  bfree(tb);
  let mut nb = balloc(FNAME_MAX);
  let mut q = 0;
  while q < n
    invariant q <= n && n <= FNAME_MAX && blen(nb) == FNAME_MAX && kok(k)
  {
    bset(&mut nb, q, bget(k.fs.xfer, q));
    q = q + 1;
  }
  if !vfs_symlink(&mut k.fs, &mut k.mem, n, tl) {
    bfree(nb);
    return ENOENT;                          // no such directory, or no room
  }
  q = 0;
  while q < n
    invariant q <= n && n <= FNAME_MAX && blen(nb) == FNAME_MAX && kok(k)
  {
    bset(&mut k.fs.xfer, q, bget(nb, q));   // vfs_symlink left the target where the name was
    q = q + 1;
  }
  bfree(nb);
  let f = vfs_lookup(&mut k.fs, n);
  if own != 0 && f < HFILES {
    vfs_set_owner(&mut k.fs, f, own % 0x100000000, own / 0x100000000 % 0x100000000);
  }
  return 0;
}

/// link / linkat(odir, opath, ndir, npath, flags): a hard link (vfs_link).
/// The old path's last link is followed only with AT_SYMLINK_FOLLOW, as on
/// Linux, so a hard link can name a symbolic link. Returns 0 or -errno.
fn lx_hardlink(k: &mut Kernel, pid: u64, odir: u64, opath: u64, ndir: u64, npath: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & !AT_SYMLINK_FOLLOW != 0 {
    return EINVAL;                          // AT_EMPTY_PATH is not offered
  }
  let mut n = NO_RESULT;
  if flags & AT_SYMLINK_FOLLOW != 0 {
    ovl_intent_write(&mut k, pid);       // the file is copied up in an overlay mount
    n = lx_path_at(&mut k, pid, odir, opath);
    ovl_intent_end(&mut k);
  } else {
    n = lx_path_at_nf_w(&mut k, pid, odir, opath);
  }
  if n == NO_RESULT {
    return k.perr;
  }
  if dir_at(&mut k, n) != NO_FILE {
    // Directories have one name; a read-only destination is reported first.
    let m0 = lx_path_at_nf(&mut k, pid, ndir, npath);
    if m0 != NO_RESULT && path_ro(&mut k, m0) {
      return EROFS;
    }
    return EPERM;
  }
  if vfs_lookup(&mut k.fs, n) == NO_FILE {
    let there = path_meta(&mut k, n);
    if there.ok {
      return EXDEV;                         // /proc, /dev or /bin: not in the file system
    }
    return ENOENT;
  }
  let src_dev = vfs_dev_of(&mut k.fs, n);
  let mut t = balloc(2 * FNAME_MAX);
  xfer_save(k, &mut t, 0, n);
  let m = lx_path_at_nf_w(&mut k, pid, ndir, npath);
  if m == NO_RESULT {
    bfree(t);
    return k.perr;
  }
  if dir_at(&mut k, m) != NO_FILE {
    bfree(t);
    return EEXIST;
  }
  if vfs_dev_of(&mut k.fs, m) != src_dev {
    bfree(t);
    return EXDEV;                           // another file system: a mount, the disk
  }
  if path_ro(&mut k, m) && vfs_lookup(&mut k.fs, m) == NO_FILE {
    bfree(t);
    return EROFS;
  }
  let e = may_dir(&mut k, pid, m);
  if e != 0 && vfs_lookup(&mut k.fs, m) == NO_FILE {
    bfree(t);
    return e;
  }
  xfer_save(k, &mut t, n, m);
  xfer_load(&mut k, t, 0, n + m);
  bfree(t);
  let r = vfs_link(&mut k.fs, n, m);
  if r == LINKED {
    return 0;
  }
  if r == LINK_EXISTS {
    return EEXIST;
  }
  if r == LINK_XDEV {
    return EXDEV;
  }
  if r == LINK_DIR {
    return EPERM;
  }
  if r == LINK_FULL {
    return ENOSPC;
  }
  return ENOENT;
}

fn is_link_call(n: u64) -> bool {
  return n == LX_SYMLINK || n == LX_SYMLINKAT || n == LX_LINK || n == LX_LINKAT;
}

/// symlink, symlinkat, link and linkat.
fn lx_link_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_LINK {
    return lx_hardlink(&mut k, pid, AT_FDCWD, a, AT_FDCWD, b, 0);
  }
  if n == LX_LINKAT {
    return lx_hardlink(&mut k, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10), pget(k.procs, pid, F_REGS + R_R8));
  }
  if n == LX_SYMLINK {
    return lx_symlink(&mut k, pid, a, AT_FDCWD, b);
  }
  return lx_symlink(&mut k, pid, a, b, c);
}
