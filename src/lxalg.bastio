// AF_ALG: the kernel's hash functions for a program, as Linux gives them.
//
//   fd = socket(AF_ALG, SOCK_SEQPACKET, 0);
//   bind(fd, {AF_ALG, "hash", 0, 0, "sha256"});    // or sha384, sha512,
//                                                  // hmac(sha256), hmac(sha384)
//   setsockopt(fd, SOL_ALG, ALG_SET_KEY, key, n);  // hmac only
//   op = accept(fd, 0, 0);
//   send(op, data, n, MSG_MORE); ...               // the message, in pieces
//   read(op, digest, size);                        // the digest; a new message begins
//
// The socket that is bound holds the algorithm and the key. An accepted
// socket has a copy of both and the data sent to it so far. Nothing is
// hashed until the digest is read: then the whole message is hashed from a
// copy of the bytes the program sent. Nothing a program gives the kernel is
// ever kept as a reference: the data are copied in at send and the digest is
// copied out at read, so no page of a program (or of a file it splices or
// sends) is used by the hash function after the call returns, and a program
// cannot change what is hashed by writing the memory it sent. That is the
// property the in-place cipher bugs of Linux's algif_* modules lacked.
//
// AEADs (type "aead": gcm(aes), rfc7539(chacha20,poly1305)) are given their
// ALG_SET_OP, ALG_SET_IV and ALG_SET_AEAD_ASSOCLEN in the control messages of
// sendmsg; the message is the associated data and the text (or ciphertext and
// tag), and the read gives the associated data again, then the result, all of
// it or none. A wrong tag is EBADMSG and no text comes out.
//
// Symmetric ciphers (type "skcipher": ctr(aes), cbc(aes), keys of 16 or 32
// bytes) take ALG_SET_OP and a 16-byte ALG_SET_IV in the control messages and
// are read as a whole. The operation and the IV stay on the socket and the IV
// moves on with each operation, so successive messages continue one chain, as
// in Linux; CBC needs whole 16-byte blocks. The input is a copy made at send
// and the output a copy made at read: nothing is encrypted or decrypted in
// place in a program's memory or in a page of a file.
//
// sendfile and splice (from a pipe) into an accepted socket add the bytes to
// the message like send: they are copied into the socket's buffer, never
// referenced, so a file's pages are neither read after the call returns nor
// ever written to, whatever the cipher does.
//
// ALG_N sockets at most, each with ALG_BUF bytes of message. Not done:
// AES-192, other modes (ecb, xts) and md5 and sha1, which the libraries here
// do not have. An hmac key may be ALG_KEYMAX
// bytes.

import "core/sha256.bastio";
import "core/sha512.bastio";
import "core/aesgcm.bastio";
import "core/aesmodes.bastio";
import "core/chacha20poly1305.bastio";

const SOL_ALG: u64 = 279;
const ALG_SET_KEY: u64 = 1;
const ENOKEY: u64 = 18446744073709551490;   // 2^64 - 126

const ALG_ST: u64 = 0;                  // 0 free, 1 made, 2 bound, 3 accepted
const ALG_ID: u64 = 1;                  // the algorithm: ALG_SHA256 ...
const ALG_KLEN: u64 = 2;                // key length
const ALG_KEYSET: u64 = 3;              // 1: a key was set
const ALG_KEY: u64 = 4;                 // the key, ALG_KEYW words of 8 bytes
const ALG_KEYW: u64 = 16;
const ALG_MLEN: u64 = 20;               // bytes of message so far
const ALG_OP: u64 = 21;                 // an AEAD: 0 no operation set, 1 decrypt, 2 encrypt (ALG_SET_OP + 1)
const ALG_ASSOC: u64 = 22;              // an AEAD: the length of the associated data
const ALG_IVSET: u64 = 23;              // an AEAD: 1 when ALG_SET_IV was given
const ALG_IV: u64 = 24;                 // an AEAD: the 12-byte IV, two words
const ALG_SET_IV: u64 = 2;
const ALG_SET_OP: u64 = 3;
const ALG_SET_AEAD_ASSOCLEN: u64 = 4;
const ALG_SET_AEAD_AUTHSIZE: u64 = 5;
const ALG_TAG: u64 = 16;
const ALG_MSGHDR: u64 = 56;             // struct msghdr (MSGHDR in src/lxmsg.bastio)
const EBADMSG: u64 = 18446744073709551542;   // 2^64 - 74

const ALG_SHA256: u64 = 1;
const ALG_SHA384: u64 = 2;
const ALG_SHA512: u64 = 3;
const ALG_HMAC256: u64 = 4;
const ALG_HMAC384: u64 = 5;
const ALG_GCM: u64 = 6;                 // aead: gcm(aes); the algorithms from here on are AEADs
const ALG_CHACHA: u64 = 7;              // aead: rfc7539(chacha20,poly1305)
const ALG_CTR: u64 = 8;                 // skcipher: ctr(aes); the algorithms from here on are skciphers
const ALG_CBC: u64 = 9;                 // skcipher: cbc(aes)

fn algr(s: u64, f: u64) -> u64
  requires s < ALG_N && f < ALG_W
  ensures result < SYS_LEN
{
  return SYS_ALG + s * ALG_W + f;
}

fn alg_get(k: &Kernel, s: u64, f: u64) -> u64
  requires kok(k) && s < ALG_N && f < ALG_W
{
  return get(k.sys, algr(s, f));
}

fn alg_set(k: &mut Kernel, s: u64, f: u64, v: u64)
  requires kok(k) && s < ALG_N && f < ALG_W
  ensures kok(k)
{
  k.sys = set(k.sys, algr(s, f), v);
}

/// The slot of the AF_ALG socket fd, or ALG_N.
fn alg_of(k: &Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures result <= ALG_N
{
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N || of_get(k.ofd, h, 0) != OF_ALG {
    return ALG_N;
  }
  let s = of_get(k.ofd, h, 2);
  if s >= ALG_N {
    return ALG_N;
  }
  return s;
}

fn is_alg(k: &Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
{
  return alg_of(k, pid, fd) < ALG_N;
}

/// Gives slot s back: its key is erased.
fn alg_free(k: &mut Kernel, s: u64)
  requires kok(k) && s < ALG_N
  ensures kok(k)
{
  let mut f = 0;
  while f < ALG_W
    invariant f <= ALG_W && kok(k)
  {
    alg_set(&mut k, s, f, 0);
    f = f + 1;
  }
}

/// A free slot, or ALG_N.
fn alg_slot(k: &Kernel) -> u64
  requires kok(k)
  ensures result <= ALG_N
{
  let mut s = 0;
  while s < ALG_N
    invariant s <= ALG_N
  {
    if alg_get(k, s, ALG_ST) == 0 {
      return s;
    }
    s = s + 1;
  }
  return ALG_N;
}

/// A new socket in slot s as a descriptor of pid, with the flags of
/// socket(2) or accept4(2) in kind.
fn alg_install(k: &mut Kernel, pid: u64, s: u64, kind: u64) -> u64
  requires kok(k) && pid < NPROC && s < ALG_N
  ensures kok(k)
{
  let h = ofd_new(&mut k, OF_ALG, s);
  if h >= OFD_N {
    alg_free(&mut k, s);
    return ENFILE;
  }
  of_set(&mut k.ofd, h, 3, kind / SOCK_NONBLOCK % 2);
  let fd = fd_install(&mut k, pid, h);
  if fd >= LXNFD {
    return fd;
  }
  if kind / SOCK_CLOEXEC % 2 == 1 {
    fd_set_k(&mut k, pid, fd, FD_OFD + h + FD_CLOEXEC);
  }
  return fd;
}

/// socket(AF_ALG, SOCK_SEQPACKET, 0).
fn alg_socket(k: &mut Kernel, pid: u64, kind: u64, proto: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if kind % 16 != SOCK_SEQPACKET {
    return 18446744073709551522;            // ESOCKTNOSUPPORT
  }
  if proto != 0 {
    return EINVAL;
  }
  let s = alg_slot(k);
  if s >= ALG_N {
    return ENOMEM;
  }
  alg_free(&mut k, s);
  alg_set(&mut k, s, ALG_ST, 1);
  return alg_install(&mut k, pid, s, kind);
}

/// Closes the description of slot s.
fn alg_close(k: &mut Kernel, s: u64)
  requires kok(k)
  ensures kok(k)
{
  if s < ALG_N {
    alg_free(&mut k, s);
  }
}

/// The length of the NUL-ended name at byte 24 of the transfer buffer
/// (at most 64).
fn alg_name_len(x: &Bytes) -> u64
  requires blen(x) >= 88
  ensures result <= 64
{
  let mut n = 0;
  while n < 64 && bget(x, 24 + n) != 0
    invariant n <= 64
  {
    n = n + 1;
  }
  return n;
}

/// The algorithm a name stands for, or 0.
fn alg_by_name(x: &Bytes) -> u64
  requires blen(x) >= 88
{
  let n = alg_name_len(x);
  if xfer_is(x, 24, 24 + n, "sha256") {
    return ALG_SHA256;
  }
  if xfer_is(x, 24, 24 + n, "sha384") {
    return ALG_SHA384;
  }
  if xfer_is(x, 24, 24 + n, "sha512") {
    return ALG_SHA512;
  }
  if xfer_is(x, 24, 24 + n, "hmac(sha256)") {
    return ALG_HMAC256;
  }
  if xfer_is(x, 24, 24 + n, "hmac(sha384)") {
    return ALG_HMAC384;
  }
  if xfer_is(x, 24, 24 + n, "gcm(aes)") {
    return ALG_GCM;
  }
  if xfer_is(x, 24, 24 + n, "rfc7539(chacha20,poly1305)") {
    return ALG_CHACHA;
  }
  if xfer_is(x, 24, 24 + n, "ctr(aes)") {
    return ALG_CTR;
  }
  if xfer_is(x, 24, 24 + n, "cbc(aes)") {
    return ALG_CBC;
  }
  return 0;
}

/// Whether algorithm id is an AEAD.
fn alg_aead_id(id: u64) -> bool {
  return id == ALG_GCM || id == ALG_CHACHA;
}

/// Whether algorithm id is a symmetric cipher with no tag.
fn alg_skc_id(id: u64) -> bool {
  return id >= ALG_CTR;
}

/// bind(fd, struct sockaddr_alg): the type "hash" with one of the hashes,
/// "aead" with gcm(aes) or rfc7539(chacha20,poly1305), or "skcipher" with
/// ctr(aes) or cbc(aes).
fn alg_bind(k: &mut Kernel, pid: u64, fd: u64, addr: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let s = alg_of(k, pid, fd);
  if s >= ALG_N {
    return ENOTSOCK;
  }
  if alg_get(k, s, ALG_ST) != 1 || alen < 24 || alen > 4096 {
    return EINVAL;
  }
  let take = smaller(alen, 88);
  lx_fill(&mut k, 0, 88);
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, addr, &mut k.fs.xfer, take) != take {
    return EFAULT;
  }
  if rd16(k.fs.xfer, 0) != AF_ALG {
    return EINVAL;
  }
  let hash = xfer_is(k.fs.xfer, 2, 6, "hash") && bget(k.fs.xfer, 6) == 0;
  let aead = xfer_is(k.fs.xfer, 2, 6, "aead") && bget(k.fs.xfer, 6) == 0;
  let skc = xfer_is(k.fs.xfer, 2, 10, "skcipher") && bget(k.fs.xfer, 10) == 0;
  if !hash && !aead && !skc {
    return ENOENT;
  }
  let id = alg_by_name(k.fs.xfer);
  if id == 0 || (hash && id >= ALG_GCM) || (aead && !alg_aead_id(id)) || (skc && !alg_skc_id(id)) {
    return ENOENT;                          // no such algorithm of that type
  }
  alg_set(&mut k, s, ALG_ID, id);
  alg_set(&mut k, s, ALG_ST, 2);
  return 0;
}

/// Whether algorithm id is an hmac.
fn alg_keyed(id: u64) -> bool {
  return id == ALG_HMAC256 || id == ALG_HMAC384 || id >= ALG_GCM;
}

/// Whether n bytes is a key length algorithm id takes.
fn alg_keylen_ok(id: u64, n: u64) -> bool {
  if id == ALG_GCM {
    return n == 16 || n == 32;
  }
  if id == ALG_CHACHA {
    return n == 32;
  }
  if alg_skc_id(id) {
    return n == 16 || n == 32;              // AES-128 and AES-256; no AES-192
  }
  return n <= ALG_KEYMAX;
}

/// setsockopt(fd, SOL_ALG, ALG_SET_KEY, key, n) on a bound socket.
fn alg_setsockopt(k: &mut Kernel, pid: u64, fd: u64, level: u64, name: u64, va: u64, len: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let s = alg_of(k, pid, fd);
  if s >= ALG_N {
    return ENOTSOCK;
  }
  if level % 4294967296 != SOL_ALG || alg_get(k, s, ALG_ST) != 2 {
    return ENOPROTOOPT;
  }
  let n = len % 4294967296;
  if name == ALG_SET_AEAD_AUTHSIZE && alg_aead_id(alg_get(k, s, ALG_ID)) {
    if n != ALG_TAG {
      return EINVAL;                        // only the full 16-byte tag
    }
    return 0;
  }
  if name != ALG_SET_KEY {
    return ENOPROTOOPT;
  }
  if !alg_keyed(alg_get(k, s, ALG_ID)) {
    return ENOSYS;                          // a hash with no key: as Linux says
  }
  if n > ALG_KEYMAX || !alg_keylen_ok(alg_get(k, s, ALG_ID), n) {
    return EINVAL;
  }
  lx_fill(&mut k, 0, ALG_KEYMAX);
  if n > 0 && copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, n) != n {
    lx_fill(&mut k, 0, ALG_KEYMAX);
    return EFAULT;
  }
  let mut w = 0;
  while w < ALG_KEYW
    invariant w <= ALG_KEYW && kok(k)
  {
    alg_set(&mut k, s, ALG_KEY + w, rd64(k.fs.xfer, w * 8));
    w = w + 1;
  }
  lx_fill(&mut k, 0, ALG_KEYMAX);           // the key is not left in the transfer buffer
  alg_set(&mut k, s, ALG_KLEN, n);
  alg_set(&mut k, s, ALG_KEYSET, 1);
  return 0;
}

/// accept(fd) on a bound socket: a socket with the algorithm, a copy of the
/// key and an empty message.
fn alg_accept(k: &mut Kernel, pid: u64, fd: u64, kind: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let s = alg_of(k, pid, fd);
  if s >= ALG_N {
    return ENOTSOCK;
  }
  if alg_get(k, s, ALG_ST) != 2 {
    return EINVAL;
  }
  let id = alg_get(k, s, ALG_ID);
  if alg_keyed(id) && alg_get(k, s, ALG_KEYSET) != 1 {
    return ENOKEY;
  }
  let t = alg_slot(k);
  if t >= ALG_N {
    return ENOMEM;
  }
  alg_free(&mut k, t);
  alg_set(&mut k, t, ALG_ID, id);
  alg_set(&mut k, t, ALG_KLEN, alg_get(k, s, ALG_KLEN));
  alg_set(&mut k, t, ALG_KEYSET, alg_get(k, s, ALG_KEYSET));
  let mut w = 0;
  while w < ALG_KEYW
    invariant w <= ALG_KEYW && kok(k)
  {
    alg_set(&mut k, t, ALG_KEY + w, alg_get(k, s, ALG_KEY + w));
    w = w + 1;
  }
  alg_set(&mut k, t, ALG_ST, 3);
  return alg_install(&mut k, pid, t, kind);
}

/// send on an accepted socket: n bytes at buf join the message.
fn alg_send(k: &mut Kernel, pid: u64, fd: u64, buf: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let s = alg_of(k, pid, fd);
  if s >= ALG_N {
    return ENOTSOCK;
  }
  if alg_get(k, s, ALG_ST) != 3 {
    return EOPNOTSUPP;
  }
  let have = alg_get(k, s, ALG_MLEN);
  if have > ALG_BUF || n > ALG_BUF - have {
    return EMSGSIZE;                        // more than the socket holds
  }
  if buf > 0xFFFFFFFFFFFF0000 {
    return EFAULT;
  }
  let mut done = 0;
  while done < n
    invariant done <= n && buf <= 0xFFFFFFFFFFFF0000 && n <= ALG_BUF - have && have <= ALG_BUF && s < ALG_N && kok(k)
  {
    let chunk = smaller(n - done, XFER);
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf + done, &mut k.fs.xfer, chunk) != chunk {
      return EFAULT;                        // nothing of this call joins the message
    }
    bcopy(&mut k.algb, s * ALG_BUF + have + done, k.fs.xfer, 0, chunk);
    done = done + chunk;
  }
  alg_set(&mut k, s, ALG_MLEN, have + n);
  return n;
}

/// n bytes of the transfer buffer join the message of the accepted socket fd:
/// what sendfile and splice give it, after they have copied the file's or the
/// pipe's bytes into the transfer buffer. The bytes are copied into the
/// socket's own buffer, so the file's pages are never the cipher's input or
/// output and are never written to. n bytes, or -errno.
fn alg_put_xfer(k: &mut Kernel, pid: u64, fd: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= XFER
  ensures kok(k) && (result <= n || result > XFER)
{
  let s = alg_of(k, pid, fd);
  if s >= ALG_N {
    return ENOTSOCK;
  }
  if alg_get(k, s, ALG_ST) != 3 {
    return EOPNOTSUPP;
  }
  let have = alg_get(k, s, ALG_MLEN);
  if have > ALG_BUF || n > ALG_BUF - have {
    return EMSGSIZE;                        // more than the socket holds
  }
  bcopy(&mut k.algb, s * ALG_BUF + have, k.fs.xfer, 0, n);
  alg_set(&mut k, s, ALG_MLEN, have + n);
  return n;
}

/// The key of slot s as bytes.
fn alg_key_bytes(k: &Kernel, s: u64) -> Bytes
  requires kok(k) && s < ALG_N
{
  let n = smaller(alg_get(k, s, ALG_KLEN), ALG_KEYMAX);
  let mut full = balloc(ALG_KEYMAX);
  let mut w = 0;
  while w < ALG_KEYW
    invariant w <= ALG_KEYW && blen(full) == ALG_KEYMAX && s < ALG_N && kok(k)
  {
    store_le64(&mut full, w * 8, alg_get(k, s, ALG_KEY + w));
    w = w + 1;
  }
  let key = bytes_slice(full, 0, n);
  let mut z = 0;
  while z < ALG_KEYMAX
    invariant z <= ALG_KEYMAX && blen(full) == ALG_KEYMAX
  {
    bset(&mut full, z, 0);
    z = z + 1;
  }
  bfree(full);
  return key;
}

/// The digest of msg under algorithm id (key only for an hmac).
fn alg_digest(id: u64, key: &Bytes, msg: &Bytes) -> Bytes {
  if id == ALG_SHA256 {
    return sha256(msg);
  }
  if id == ALG_SHA384 {
    return sha384(msg);
  }
  if id == ALG_SHA512 {
    return sha512(msg);
  }
  if id == ALG_HMAC256 {
    return hmac_sha256(key, msg);
  }
  return hmac_sha384(key, msg);
}

/// recv on an accepted socket: the digest of the message so far, at most n
/// bytes of it; the next message begins.
fn alg_recv(k: &mut Kernel, pid: u64, fd: u64, buf: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let s = alg_of(k, pid, fd);
  if s >= ALG_N {
    return ENOTSOCK;
  }
  if alg_get(k, s, ALG_ST) != 3 {
    return EOPNOTSUPP;
  }
  if n == 0 {
    return 0;
  }
  if alg_skc_id(alg_get(k, s, ALG_ID)) {
    return alg_skc_recv(&mut k, pid, s, buf, n);
  }
  if alg_get(k, s, ALG_ID) >= ALG_GCM {
    return alg_aead_recv(&mut k, pid, s, buf, n);
  }
  let mlen = smaller(alg_get(k, s, ALG_MLEN), ALG_BUF);
  let msg = bytes_slice(k.algb, s * ALG_BUF, s * ALG_BUF + mlen);
  let id = alg_get(k, s, ALG_ID);
  let key = alg_key_bytes(k, s);
  let digest = alg_digest(id, key, msg);
  let got = smaller(n, blen(digest));
  let r = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, digest, got);
  bfree(digest);
  bfree(key);
  bfree(msg);
  if r != got {
    return EFAULT;                          // the message stays for another try
  }
  alg_set(&mut k, s, ALG_MLEN, 0);
  return got;
}

/// The 12-byte IV of slot s.
fn alg_iv_bytes(k: &Kernel, s: u64) -> Bytes
  requires kok(k) && s < ALG_N
  ensures blen(result) == 12
{
  let mut iv = balloc(12);
  let lo = alg_get(k, s, ALG_IV);
  let hi = alg_get(k, s, ALG_IV + 1);
  let mut i = 0;
  while i < 12
    invariant i <= 12 && blen(iv) == 12
  {
    if i < 8 {
      bset(&mut iv, i, cast[u8](lo / (1 << (8 * i)) % 256));
    } else {
      bset(&mut iv, i, cast[u8](hi / (1 << (8 * (i - 8))) % 256));
    }
    i = i + 1;
  }
  return iv;
}

/// Seals (enc) or opens body under the AEAD id; None if the key or IV does
/// not fit it or, opening, the tag is wrong.
fn alg_aead(id: u64, enc: bool, key: &Bytes, iv: &Bytes, aad: &Bytes, body: &Bytes) -> Option[Bytes] {
  if blen(iv) != 12 || blen(body) >= 274877906944 || blen(aad) >= 274877906944 {
    return Option[Bytes]::None;
  }
  if id == ALG_GCM && (blen(key) == 16 || blen(key) == 32) {
    if enc {
      return Option[Bytes]::Some(gcm_seal(key, iv, aad, body));
    }
    return gcm_open(key, iv, aad, body);
  }
  if id == ALG_CHACHA && blen(key) == 32 {
    if enc {
      return Option[Bytes]::Some(aead_seal(key, iv, aad, body));
    }
    return aead_open(key, iv, aad, body);
  }
  return Option[Bytes]::None;
}

/// recv on an accepted AEAD socket. The message sent is the associated data
/// and then the text (encrypting) or the ciphertext and its tag
/// (decrypting). The result is the associated data again and then the
/// ciphertext and tag, or the text; the buffer must hold all of it. A tag
/// that does not match is EBADMSG and nothing of the text is given. The
/// message is used up either way.
fn alg_aead_recv(k: &mut Kernel, pid: u64, s: u64, buf: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && s < ALG_N
  ensures kok(k)
{
  let op = alg_get(k, s, ALG_OP);
  if op == 0 || alg_get(k, s, ALG_IVSET) != 1 {
    return EINVAL;
  }
  let mlen = smaller(alg_get(k, s, ALG_MLEN), ALG_BUF);
  let assoc = alg_get(k, s, ALG_ASSOC);
  let enc = op == 2;
  if assoc > mlen || (!enc && mlen - assoc < ALG_TAG) {
    return EINVAL;
  }
  let mut outlen = mlen + ALG_TAG;
  if !enc {
    if mlen < ALG_TAG {
      return EINVAL;
    }
    outlen = mlen - ALG_TAG;
  }
  if n < outlen {
    return EINVAL;                          // the whole result or none
  }
  let msg = bytes_slice(k.algb, s * ALG_BUF, s * ALG_BUF + mlen);
  let aad = bytes_slice(msg, 0, assoc);
  let body = bytes_slice(msg, assoc, mlen);
  let key = alg_key_bytes(k, s);
  let iv = alg_iv_bytes(k, s);
  let res = alg_aead(alg_get(k, s, ALG_ID), enc, key, iv, aad, body);
  bfree(body);
  bfree(msg);
  bfree(iv);
  bfree(key);
  alg_set(&mut k, s, ALG_MLEN, 0);          // used up, with its operation
  alg_set(&mut k, s, ALG_OP, 0);
  alg_set(&mut k, s, ALG_IVSET, 0);
  alg_set(&mut k, s, ALG_ASSOC, 0);
  match res {
    Option::None => {
      bfree(aad);
      return EBADMSG;
    },
    Option::Some(out) => {
      if blen(out) > ALG_BUF + ALG_TAG || assoc > ALG_BUF {
        bfree(out);
        bfree(aad);
        return EINVAL;                      // cannot happen: out is the message and a tag, at most
      }
      let total = assoc + blen(out);
      let mut full = balloc(total);
      bytes_copy_span(&mut full, 0, aad, 0, assoc);
      bytes_copy_span(&mut full, assoc, out, 0, blen(out));
      let r = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, full, total);
      bfree(full);
      bfree(out);
      bfree(aad);
      if r != total {
        return EFAULT;
      }
      return total;
    },
  }
}

/// The IV length a cipher takes: 16 for AES, 12 for an AEAD.
fn alg_ivlen(skc: bool) -> u64
  ensures result == 12 || result == 16
{
  if skc {
    return 16;
  }
  return 12;
}

/// The 16-byte IV of slot s.
fn alg_iv16(k: &Kernel, s: u64) -> Bytes
  requires kok(k) && s < ALG_N
  ensures blen(result) == 16
{
  let mut iv = balloc(16);
  store_le64(&mut iv, 0, alg_get(k, s, ALG_IV));
  store_le64(&mut iv, 8, alg_get(k, s, ALG_IV + 1));
  return iv;
}

/// iv plus `blocks`, as a 128-bit big-endian number (wrapping): the counter
/// block after CTR has used `blocks` blocks.
fn alg_ctr_next(iv: &Bytes, blocks: u64) -> Bytes
  requires blen(iv) == 16
  ensures blen(result) == 16
{
  let mut out = bytes_slice(iv, 0, 16);
  let mut carry: u64 = 0;
  let mut i = 0;
  while i < 16
    invariant i <= 16 && blen(out) == 16 && carry <= 1
  {
    let at = 15 - i;                        // from the last byte up
    let mut add: u64 = 0;
    if i < 8 {
      add = blocks / (1 << (8 * i)) % 256;
    }
    let sum = cast[u64](bget(iv, at)) + add + carry;
    bset(&mut out, at, cast[u8](sum % 256));
    carry = sum / 256;
    i = i + 1;
  }
  return out;
}

/// Encrypts (enc) or decrypts msg under the skcipher id; None if the key or
/// IV does not fit or a CBC message is not whole blocks.
fn alg_skc(id: u64, enc: bool, key: &Bytes, iv: &Bytes, msg: &Bytes) -> Option[Bytes] {
  if blen(iv) != 16 || blen(msg) >= 274877906944 || (blen(key) != 16 && blen(key) != 32) {
    return Option[Bytes]::None;
  }
  let a = gcm_key(key);
  if id == ALG_CTR {
    let out = aes_ctr(a, iv, msg);
    aes_free(a);
    return Option[Bytes]::Some(out);
  }
  if id == ALG_CBC && blen(msg) % 16 == 0 {
    if enc {
      let out = aes_cbc_encrypt(a, iv, msg);
      aes_free(a);
      return Option[Bytes]::Some(out);
    }
    let out = aes_cbc_decrypt(a, iv, msg);
    aes_free(a);
    return Option[Bytes]::Some(out);
  }
  aes_free(a);
  return Option[Bytes]::None;
}

/// The IV a socket goes on with after an operation, as Linux leaves it in the
/// socket: for CBC the last ciphertext block (the result when encrypting, the
/// message when decrypting), for CTR the counter after the blocks used.
fn alg_skc_next(id: u64, enc: bool, iv: &Bytes, msg: &Bytes, out: &Bytes) -> Bytes
  requires blen(iv) == 16 && blen(msg) == blen(out) && blen(msg) < 274877906944
  ensures blen(result) == 16
{
  if id == ALG_CTR {
    return alg_ctr_next(iv, (blen(msg) + 15) / 16);
  }
  if blen(msg) < 16 {
    return bytes_slice(iv, 0, 16);
  }
  if enc {
    return bytes_slice(out, blen(out) - 16, blen(out));
  }
  return bytes_slice(msg, blen(msg) - 16, blen(msg));
}

/// recv on an accepted skcipher socket: the message sent, encrypted or
/// decrypted as ALG_SET_OP says, all of it or nothing (a buffer that is too
/// small is EINVAL). CBC takes whole blocks only. The operation and the IV
/// stay on the socket, and the IV goes on from where the operation ended, so
/// a message sent in pieces over several operations is one chain, as in
/// Linux. The result is a copy: nothing of a program's memory, or of a file
/// spliced or sent in, is the cipher's input or output once the call returns.
fn alg_skc_recv(k: &mut Kernel, pid: u64, s: u64, buf: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && s < ALG_N
  ensures kok(k)
{
  let op = alg_get(k, s, ALG_OP);
  if op == 0 || alg_get(k, s, ALG_IVSET) != 1 {
    return EINVAL;
  }
  let id = alg_get(k, s, ALG_ID);
  let mlen = smaller(alg_get(k, s, ALG_MLEN), ALG_BUF);
  if (id == ALG_CBC && mlen % 16 != 0) || n < mlen {
    return EINVAL;
  }
  if mlen == 0 {
    return 0;
  }
  let enc = op == 2;
  let msg = bytes_slice(k.algb, s * ALG_BUF, s * ALG_BUF + mlen);
  let key = alg_key_bytes(k, s);
  let iv = alg_iv16(k, s);
  let res = alg_skc(id, enc, key, iv, msg);
  bfree(key);
  match res {
    Option::None => {
      bfree(iv);
      bfree(msg);
      return EINVAL;
    },
    Option::Some(out) => {
      if blen(out) != mlen {
        bfree(out);
        bfree(iv);
        bfree(msg);
        return EINVAL;                      // cannot happen: the result is as long as the message
      }
      let r = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, out, mlen);
      if r != mlen {
        bfree(out);
        bfree(iv);
        bfree(msg);
        return EFAULT;                      // the message stays for another try
      }
      let next = alg_skc_next(id, enc, iv, msg, out);
      alg_set(&mut k, s, ALG_IV, load_le64(next, 0));
      alg_set(&mut k, s, ALG_IV + 1, load_le64(next, 8));
      alg_set(&mut k, s, ALG_MLEN, 0);
      bfree(next);
      bfree(out);
      bfree(iv);
      bfree(msg);
      return mlen;
    },
  }
}

/// The control messages of a sendmsg on an AEAD or skcipher socket: ALG_SET_OP,
/// ALG_SET_IV (12 bytes) and ALG_SET_AEAD_ASSOCLEN.
fn alg_cmsgs(k: &mut Kernel, pid: u64, s: u64, ctl: u64, clen: u64) -> u64
  requires kok(k) && pid < NPROC && s < ALG_N
  ensures kok(k)
{
  if ctl > 0xFFFFFFFFFFFF0000 || clen > 4096 {
    return EINVAL;
  }
  let mut pos = 0;
  let mut i = 0;
  while i < 16 && pos + 16 <= clen
    invariant i <= 16 && pos <= clen && clen <= 4096 && ctl <= 0xFFFFFFFFFFFF0000 && s < ALG_N && kok(k)
  {
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, ctl + pos, &mut k.fs.xfer, 16) != 16 {
      return EFAULT;
    }
    let len = get_u64(k.fs.xfer, 0);
    let lt = get_u64(k.fs.xfer, 8);
    if len < 16 || len > clen - pos {
      return EINVAL;
    }
    if lt % 4294967296 == SOL_ALG {
      let t = lt / 4294967296;
      if len < 20 {
        return EINVAL;
      }
      lx_fill(&mut k, 0, 20);
      let skc = alg_skc_id(alg_get(k, s, ALG_ID));
      if t == ALG_SET_IV {
        // struct af_alg_iv: the length (12 for an AEAD, 16 for AES) and the IV
        let ivn = alg_ivlen(skc);
        if len < 20 + ivn || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, ctl + pos + 16, &mut k.fs.xfer, 4 + ivn) != 4 + ivn {
          return EINVAL;
        }
        if rd32(k.fs.xfer, 0) != ivn {
          return EINVAL;
        }
        alg_set(&mut k, s, ALG_IV, rd64(k.fs.xfer, 4));
        if skc {
          alg_set(&mut k, s, ALG_IV + 1, rd64(k.fs.xfer, 12));
        } else {
          alg_set(&mut k, s, ALG_IV + 1, rd32(k.fs.xfer, 12));
        }
        alg_set(&mut k, s, ALG_IVSET, 1);
      } else {
        if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, ctl + pos + 16, &mut k.fs.xfer, 4) != 4 {
          return EFAULT;
        }
        let v = rd32(k.fs.xfer, 0);
        if t == ALG_SET_OP {
          if v > 1 {
            return EINVAL;
          }
          alg_set(&mut k, s, ALG_OP, v + 1);
        } else if t == ALG_SET_AEAD_ASSOCLEN && !skc {
          alg_set(&mut k, s, ALG_ASSOC, v);
        } else {
          return EINVAL;
        }
      }
    }
    pos = smaller(pos + (len + 7) / 8 * 8, clen);   // the last message may be unpadded
    i = i + 1;
  }
  return 0;
}

/// sendmsg on an accepted socket: the control messages of an AEAD, then
/// each buffer in turn joins the message.
fn alg_sendmsg(k: &mut Kernel, pid: u64, fd: u64, msg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let s = alg_of(k, pid, fd);
  if s >= ALG_N {
    return ENOTSOCK;
  }
  if msg > 0xFFFFFFFFFFFF0000 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, msg, &mut k.fs.xfer, ALG_MSGHDR) != ALG_MSGHDR {
    return EFAULT;
  }
  let iov = get_u64(k.fs.xfer, 16);
  let cnt = get_u64(k.fs.xfer, 24);
  let ctl = get_u64(k.fs.xfer, 32);
  let clen = get_u64(k.fs.xfer, 40);
  if cnt > 1024 {
    return EMSGSIZE;
  }
  if alg_get(k, s, ALG_ST) != 3 {
    return EOPNOTSUPP;
  }
  if ctl != 0 && alg_get(k, s, ALG_ID) >= ALG_GCM {
    let r = alg_cmsgs(&mut k, pid, s, ctl, clen);
    if r != 0 {
      return r;
    }
  }
  let mut done = 0;
  let mut i = 0;
  while i < cnt
    invariant i <= cnt && cnt <= 1024 && s < ALG_N && kok(k)
  {
    if !iov_at(&mut k, pid, iov, i) {
      return EFAULT;
    }
    let base = get_u64(k.fs.xfer, 0);
    let len = get_u64(k.fs.xfer, 8);
    if len > 0 {
      let r = alg_send(&mut k, pid, fd, base, len);
      if r > 0x7FFFFFFFFFFFFFFF {
        if done == 0 {
          return r;
        }
        return done;
      }
      done = sat_add(done, r);
    }
    i = i + 1;
  }
  return done;
}
