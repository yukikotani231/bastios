// Loading static Linux x86-64 ELF executables (the first step toward
// running Linux programs). An image is either a fixed-address executable
// (ET_EXEC) whose segments lie in the user window, or a PIE (ET_DYN), which
// is placed at USER_BASE. A static PIE relocates itself. A dynamically
// linked one names an interpreter (PT_INTERP), the dynamic linker, which
// the kernel loads too, high in the window just below where mmap starts,
// and starts instead of the program; the linker relocates both. The kernel
// applies no relocations either way.
//
// The bytes come from a built-in image or a file (Src), read a piece at a
// time into the file layer's transfer buffer. Every field read from them
// is untrusted. The proof shows each read is inside the executable, and
// that every byte copied lands in a page of the window below the stack,
// whatever the file says.

import "pages.bastio";
import "space.bastio";
import "fs.bastio";
import "core/endian.bastio";
import "tsc.bastio";
import "text.bastio";

const ELF_HDR: u64 = 64;              // size of the ELF64 file header
const PH_SIZE: u64 = 56;              // size of an ELF64 program header
const PH_MAX: u64 = 64;               // most program headers we accept

const ET_EXEC: u64 = 2;
const ET_DYN: u64 = 3;
const PT_LOAD: u64 = 1;
const PT_INTERP: u64 = 3;

// Segment kinds, as `seg` reports them.
const SEG_SKIP: u64 = 0;              // not loaded (PT_NOTE, PT_GNU_STACK, ...)
const SEG_LOAD: u64 = 1;              // a PT_LOAD that fits the window
const SEG_BAD: u64 = 2;               // malformed, or something we cannot run
const SEG_INTERP: u64 = 3;            // PT_INTERP: from and filesz locate the interpreter's path
const INTERP_MAX: u64 = 256;          // the longest interpreter path, NUL included

// The initial stack, at the top of the window as on Linux: the 16 bytes
// AT_RANDOM points at on top, the argument and environment strings below
// them, then argc, argv, envp and the auxiliary vector, where rsp points.
// The stack grows down from there (stack_reach, src/linux.bastio).
const ARGS_MAX: u64 = 131072;         // string bytes, NULs included (Linux's ARG_MAX)
const ARGV_MAX: u64 = 8192;           // the most arguments
const ENVC_MAX: u64 = 1024;           // the most environment strings
const RANDOM_AT: u64 = 0x7FFFFFFFF0;  // USER_SIZE - 16
const AUX_WORDS: u64 = 32;            // the auxiliary vector: 16 pairs
// The vDSO (user/vdso.c): one read-only page just below the stack, holding
// the image and, from byte VDSO_DATA, the clock it reads (src/tsc.bastio).
const VDSO_PAGE: u64 = 134215679;     // STACK_FIRST - 1
const VDSO_DATA: u64 = 496;           // word of the page: mult, base, at, epoch
const AT_SYSINFO_EHDR: u64 = 33;
const AT_IGNORE: u64 = 1;

/// Where an executable's bytes come from: built-in image `prog`, or file
/// `f` of the file layer; `size` bytes either way.
struct Src { file: bool, prog: u64, f: u64, size: u64 }

/// Copies bytes off..off+n of `s` into the start of v.xfer. Returns false
/// if they are not all there (a file can shrink while it is read).
fn src_read(v: &mut Vfs, s: Src, off: u64, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if off > s.size || n > s.size - off {
    return false;
  }
  if s.file {
    return vfs_read_at(&mut v, s.f, off, n) == n;
  }
  let img = prog_image(s.prog);
  if off > slen(img) || n > slen(img) - off {
    return false;
  }
  let mut i = 0;
  while i < n
    invariant i <= n && n <= XFER && vfs_ok(v)
  {
    bset(&mut v.xfer, i, sget(img, off + i));
    i = i + 1;
  }
  return true;
}

/// What the headers say, once checked.
struct Elf {
  ok: bool,
  bias: u64,      // added to every p_vaddr: 0, or USER_BASE for a static PIE
  entry: u64,     // user address of the entry point
  end: u64,       // window offset where the highest segment ends
  phoff: u64,     // file offset of the program headers
  phnum: u64,
  phdr: u64,      // user address of the program headers once loaded, or 0
  interp: u64,    // file offset of the interpreter's path
  ilen: u64,      // and its length, NUL included; 0 when there is none
}

/// A program header, once checked.
struct Seg {
  kind: u64,
  from: u64,      // file offset of the bytes to copy
  filesz: u64,    // bytes to copy; the rest of the segment is zero
  off: u64,       // window offset of the segment
  memsz: u64,
  w: bool,        // writable (PF_W)
  x: bool,        // executable (PF_X)
}

/// The pages exec leaves out of a new address space for the program's
/// first touch of each to bring in (src/lazy.bastio): window pages first
/// .. first + pages, the first at file offset off. pages 0: none.
struct Lz { first: u64, pages: u64, off: u64 }

fn lz_none() -> Lz
  ensures result.pages == 0 && result.first == 0
{
  return Lz { first: 0, pages: 0, off: 0 };
}

spec fn seg_fits(size: u64, s: Seg) -> bool {
  (s.kind == SEG_LOAD ==> (s.filesz <= s.memsz && s.from + s.filesz <= size && s.off + s.memsz <= IMAGE_MAX))
  && (s.kind == SEG_INTERP ==> (s.filesz <= INTERP_MAX && s.from + s.filesz <= size))
}

spec fn elf_fits(size: u64, e: Elf) -> bool {
  e.ok ==> (e.phnum <= PH_MAX && e.phoff + e.phnum * PH_SIZE <= size
    && e.end <= IMAGE_MAX && e.bias <= USER_BASE + IMAGE_MAX
    && e.ilen <= INTERP_MAX && e.interp + e.ilen <= size
    && USER_BASE <= e.entry && e.entry < USER_BASE + e.end)
}

fn rd16(x: &Bytes, at: u64) -> u64
  requires at + 2 <= blen(x)
  ensures result < 0x10000
{
  return cast[u64](load_le16(x, at));
}

fn rd32(x: &Bytes, at: u64) -> u64
  requires at + 4 <= blen(x)
  ensures result < 0x100000000
{
  return cast[u64](load_le32(x, at));
}

fn rd64(x: &Bytes, at: u64) -> u64
  requires at + 8 <= blen(x)
{
  return load_le64(x, at);
}

/// Does `img` start with the ELF magic? Such an image is loaded as ELF or
/// not at all.
fn is_elf(img: Str) -> bool {
  return slen(img) >= 4 && sget(img, 0) == 0x7F && sget(img, 1) == 0x45
    && sget(img, 2) == 0x4C && sget(img, 3) == 0x46;
}

fn bad_seg() -> Seg
  ensures result.kind == SEG_BAD
{
  return Seg { kind: SEG_BAD, from: 0, filesz: 0, off: 0, memsz: 0, w: true, x: false };
}

/// Program header `i` of `src` (headers at `phoff`), placed with `bias`.
fn seg(v: &mut Vfs, src: Src, phoff: u64, i: u64, bias: u64) -> Seg
  requires vfs_ok(v) && i < PH_MAX && bias <= USER_BASE + IMAGE_MAX
  ensures vfs_ok(v) && seg_fits(src.size, result)
{
  if phoff > src.size || i * PH_SIZE > src.size - phoff || !src_read(&mut v, src, phoff + i * PH_SIZE, PH_SIZE) {
    return bad_seg();
  }
  let h = 0;
  let n = src.size;
  let t = rd32(v.xfer, h);
  let flags = rd32(v.xfer, h + 4);
  let from = rd64(v.xfer, h + 8);
  if t == PT_INTERP {
    let plen = rd64(v.xfer, h + 32);
    if plen < 2 || plen > INTERP_MAX || from > n || plen > n - from {
      return bad_seg();
    }
    return Seg { kind: SEG_INTERP, from: from, filesz: plen, off: 0, memsz: 0, w: true, x: false };
  }
  if t != PT_LOAD {
    return Seg { kind: SEG_SKIP, from: 0, filesz: 0, off: 0, memsz: 0, w: true, x: false };
  }
  let vaddr = rd64(v.xfer, h + 16);
  let filesz = rd64(v.xfer, h + 32);
  let memsz = rd64(v.xfer, h + 40);
  if filesz > memsz || from > n || filesz > n - from {
    return bad_seg();
  }
  // The segment must lie in the window, below the stack.
  if vaddr > USER_BASE + IMAGE_MAX || vaddr + bias < USER_BASE {
    return bad_seg();
  }
  let off = vaddr + bias - USER_BASE;
  if off > IMAGE_MAX || memsz > IMAGE_MAX - off {
    return bad_seg();
  }
  return Seg { kind: SEG_LOAD, from: from, filesz: filesz, off: off, memsz: memsz, w: flags % 4 >= 2, x: flags % 2 == 1 };
}

fn bad_elf() -> Elf
  ensures !result.ok
{
  return Elf { ok: false, bias: 0, entry: 0, end: 0, phoff: 0, phnum: 0, phdr: 0, interp: 0, ilen: 0 };
}

/// Checks the file header and every program header of `src`, placing a
/// PIE at USER_BASE.
fn elf_parse(v: &mut Vfs, src: Src) -> Elf
  requires vfs_ok(v)
  ensures vfs_ok(v) && elf_fits(src.size, result)
{
  return elf_parse_at(&mut v, src, 0);
}

/// elf_parse, placing a PIE at window offset `place` instead.
fn elf_parse_at(v: &mut Vfs, src: Src, place: u64) -> Elf
  requires vfs_ok(v) && place <= IMAGE_MAX
  ensures vfs_ok(v) && elf_fits(src.size, result)
{
  let n = src.size;
  if n < ELF_HDR || !src_read(&mut v, src, 0, ELF_HDR) {
    return bad_elf();
  }
  if bget(v.xfer, 0) != 0x7F || bget(v.xfer, 1) != 0x45 || bget(v.xfer, 2) != 0x4C || bget(v.xfer, 3) != 0x46 {
    return bad_elf();
  }
  // 64-bit, little-endian, version 1, this machine.
  if bget(v.xfer, 4) != 2 || bget(v.xfer, 5) != 1 || bget(v.xfer, 6) != 1 {
    return bad_elf();
  }
  let ty = rd16(v.xfer, 16);
  if rd16(v.xfer, 18) != EM_NATIVE || rd32(v.xfer, 20) != 1 {
    return bad_elf();
  }
  let mut bias = 0;
  if ty == ET_DYN {
    bias = USER_BASE + place;
  } else if ty != ET_EXEC {
    return bad_elf();
  }
  let entry = rd64(v.xfer, 24);
  let phoff = rd64(v.xfer, 32);
  let phnum = rd16(v.xfer, 56);
  if rd16(v.xfer, 54) != PH_SIZE || phnum == 0 || phnum > PH_MAX {
    return bad_elf();
  }
  if phoff > n || phnum * PH_SIZE > n - phoff {
    return bad_elf();
  }
  let mut end = 0;
  let mut phdr = 0;
  let mut loads = 0;
  let mut interp = 0;
  let mut ilen = 0;
  let mut i = 0;
  while i < phnum
    invariant i <= phnum && phnum <= PH_MAX && end <= IMAGE_MAX && loads <= i && vfs_ok(v)
    invariant ilen <= INTERP_MAX && interp + ilen <= n
  {
    let s = seg(&mut v, src, phoff, i, bias);
    if s.kind == SEG_BAD {
      return bad_elf();
    }
    if s.kind == SEG_INTERP {
      interp = s.from;
      ilen = s.filesz;
    }
    if s.kind == SEG_LOAD {
      loads = loads + 1;
      if s.off + s.memsz > end {
        end = s.off + s.memsz;
      }
      // The program headers, if this segment carries them (for AT_PHDR).
      if s.from <= phoff && phoff + phnum * PH_SIZE <= s.from + s.filesz {
        phdr = USER_BASE + s.off + (phoff - s.from);
      }
    }
    i = i + 1;
  }
  if loads == 0 {
    return bad_elf();
  }
  if entry > USER_BASE + IMAGE_MAX || entry + bias < USER_BASE || entry + bias >= USER_BASE + end {
    return bad_elf();
  }
  return Elf { ok: true, bias: bias, entry: entry + bias, end: end, phoff: phoff, phnum: phnum, phdr: phdr, interp: interp, ilen: ilen };
}

/// How many of the `left` bytes wanted from window offset `a` lie on a's page.
fn on_page(a: u64, left: u64) -> u64
  ensures result <= left && a % 4096 + result <= 4096
  ensures left > 0 ==> result > 0
{
  let room = 4096 - a % 4096;
  if room < left {
    return room;
  }
  return left;
}

/// Copies the `n` bytes at offset `from` of `src` to window offset `off`,
/// XFER bytes at a time. A page the window does not map is skipped, and
/// a whole one is not even read (a page left for the first touch, Lz);
/// so is a whole page mapped read-only (a shared page of program text,
/// share_text: it holds these bytes already). Returns false if the bytes could not all be read.
fn copy_in(l3: &mut PageTable, v: &mut Vfs, src: Src, from: u64, off: u64, n: u64) -> bool
  requires pt_level(l3) == 3 && vfs_ok(v) && off + n <= IMAGE_MAX && from + n <= src.size
  ensures pt_level(l3) == 3 && vfs_ok(v)
{
  let mut k = 0;
  while k < n
    invariant k <= n && pt_level(l3) == 3 && vfs_ok(v)
  {
    let c = smaller(n - k, XFER);
    if c == 4096 && (off + k) % 4096 == 0 && (w_readonly(&mut l3, (off + k) / 4096) || !w_has(&mut l3, (off + k) / 4096)) {
      k = k + c;
    } else {
      if !src_read(&mut v, src, from + k, c) {
        return false;
      }
      put_window(&mut l3, v.xfer, off + k, c);
      k = k + c;
    }
  }
  return true;
}

/// Copies the first `n` bytes of `x` to window offset `off`, a page at a
/// time; pages the window does not map are skipped.
fn put_window(l3: &mut PageTable, x: &Bytes, off: u64, n: u64)
  requires pt_level(l3) == 3 && n <= blen(x) && off + n <= USER_SIZE
  ensures pt_level(l3) == 3
{
  let mut k = 0;
  while k < n
    invariant k <= n && pt_level(l3) == 3
  {
    let a = off + k;
    let m = on_page(a, n - k);
    w_write(&mut l3, a, x, k, m);
    k = k + m;
  }
}

/// How many strings end (in a NUL) in args[from..to], counting at most `most`.
fn nul_count(args: &Bytes, from: u64, to: u64, most: u64) -> u64
  requires from <= to && to <= blen(args)
  ensures result <= most
{
  let mut n = 0;
  let mut i = from;
  while i < to
    invariant from <= i && i <= to && to <= blen(args) && n <= most
  {
    if bget(args, i) == 0 && n < most {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

/// The window offset the strings start at: below the AT_RANDOM bytes.
fn str_at(total: u64) -> u64
  requires total <= ARGS_MAX
  ensures result + total <= RANDOM_AT && result + ARGS_MAX + 16 >= RANDOM_AT
{
  return (RANDOM_AT - total) / 16 * 16;
}

/// The window offset of the initial rsp: below the strings, with room for
/// argc, argv, envp and the auxiliary vector, 16-aligned as the ABI wants.
/// `s` is where the strings start (str_at).
fn vec_at(s: u64, argc: u64, envc: u64) -> u64
  requires s <= RANDOM_AT && s + ARGS_MAX + 16 >= RANDOM_AT && argc <= ARGV_MAX && envc <= ENVC_MAX
  ensures result + 8 * (3 + argc + envc + AUX_WORDS) <= s
  ensures result >= STACK_FIRST * 4096 && result % 16 == 0
{
  return (s - 8 * (3 + argc + envc + AUX_WORDS)) / 16 * 16;
}

/// The window offset of rsp at the entry point, for the strings in the
/// first `total` bytes of `args`, the first `alen` of them the arguments.
fn elf_sp(args: &Bytes, alen: u64, total: u64) -> u64
  requires alen <= total && total <= ARGS_MAX && total <= blen(args)
  ensures result >= STACK_FIRST * 4096 && result < USER_SIZE
{
  return vec_at(str_at(total), nul_count(args, 0, alen, ARGV_MAX), nul_count(args, alen, total, ENVC_MAX));
}

/// Writes the initial stack the Linux ABI promises at the entry point,
/// mapping its pages: argc, argv, envp and the auxiliary vector at elf_sp.
/// The first `alen` bytes of `args` are the argument strings and the bytes
/// from there to `total` the environment strings, each ending in a NUL
/// (bytes after the last NUL, arguments past ARGV_MAX and strings past
/// ENVC_MAX are not passed). `seed` fills the AT_RANDOM bytes; it is not a
/// source of secure randomness. `base` is where the interpreter was placed,
/// or 0. False if memory ran out.
fn init_stack(m: &mut Mem, l3: &mut PageTable, e: Elf, base: u64, vdso: bool, args: &Bytes, alen: u64, total: u64, seed: u64) -> bool
  requires mem_ok(m) && pt_level(l3) == 3 && alen <= total && total <= ARGS_MAX && total <= blen(args)
  ensures mem_ok(m) && pt_level(l3) == 3
{
  let argc = nul_count(args, 0, alen, ARGV_MAX);
  let envc = nul_count(args, alen, total, ENVC_MAX);
  let s = str_at(total);
  let at = vec_at(s, argc, envc);
  let mut p = at / 4096;
  while p < WPAGES
    invariant pt_level(l3) == 3 && mem_ok(m)
  {
    if !w_map(&mut m, &mut l3, p, false) {
      return false;
    }
    p = p + 1;
  }
  let words = 3 + argc + envc + AUX_WORDS;
  let mut vec = balloc(8 * words);
  // argv[na] and envp[ne] point at the strings as they end; the counts
  // above bound them, so a string past ARGV_MAX or ENVC_MAX is skipped.
  let mut na = 0;
  let mut ne = 0;
  let mut start = 0;
  let mut i = 0;
  while i < total
    invariant i <= total && total <= ARGS_MAX && total <= blen(args) && start <= i
    invariant na <= argc && ne <= envc && blen(vec) == 8 * words && words == 3 + argc + envc + AUX_WORDS
  {
    if bget(args, i) == 0 {
      if i < alen && na < argc {
        put_u64(&mut vec, 8 * (1 + na), USER_BASE + s + start);
        na = na + 1;
      } else if i >= alen && ne < envc {
        put_u64(&mut vec, 8 * (2 + argc + ne), USER_BASE + s + start);
        ne = ne + 1;
      }
      start = i + 1;
    }
    i = i + 1;
  }
  put_u64(&mut vec, 0, argc);                      // argv and envp end in the zeros balloc gave
  let v = 3 + argc + envc;
  aux(&mut vec, v, 3, e.phdr);                     // AT_PHDR
  aux(&mut vec, v + 2, 4, PH_SIZE);                // AT_PHENT
  aux(&mut vec, v + 4, 5, e.phnum);                // AT_PHNUM
  aux(&mut vec, v + 6, 6, 4096);                   // AT_PAGESZ
  aux(&mut vec, v + 8, 7, base);                   // AT_BASE: the interpreter, if any
  aux(&mut vec, v + 10, 8, 0);                     // AT_FLAGS
  aux(&mut vec, v + 12, 9, e.entry);               // AT_ENTRY
  aux(&mut vec, v + 14, 11, 0);                    // AT_UID
  aux(&mut vec, v + 16, 12, 0);                    // AT_EUID
  aux(&mut vec, v + 18, 13, 0);                    // AT_GID
  aux(&mut vec, v + 20, 14, 0);                    // AT_EGID
  aux(&mut vec, v + 22, 17, 100);                  // AT_CLKTCK: the timer runs at 100 Hz
  aux(&mut vec, v + 24, 23, 0);                    // AT_SECURE
  aux(&mut vec, v + 26, 25, USER_BASE + RANDOM_AT); // AT_RANDOM
  if vdso {
    aux(&mut vec, v + 28, AT_SYSINFO_EHDR, USER_BASE + VDSO_PAGE * 4096);
  } else {
    aux(&mut vec, v + 28, AT_IGNORE, 0);
  }
  aux(&mut vec, v + 30, 0, 0);                     // AT_NULL
  let mut rnd = balloc(16);
  let mut x = seed % 0x80000000;
  let mut r = 0;
  while r < 16
    invariant r <= 16 && x < 0x80000000 && blen(rnd) == 16
  {
    x = (x * 1103515245 + 12345) % 0x80000000;
    bset(&mut rnd, r, cast[u8](x / 0x800000));
    r = r + 1;
  }
  put_window(&mut l3, vec, at, 8 * words);
  put_window(&mut l3, args, s, total);
  put_window(&mut l3, rnd, RANDOM_AT, 16);
  bfree(vec);
  bfree(rnd);
  return true;
}

/// Maps the vDSO, read-only, at window page VDSO_PAGE (which must not be
/// mapped yet). False if memory ran out.
fn vdso_map(m: &mut Mem, l3: &mut PageTable, t: Tsc, epoch: u64) -> bool
  requires mem_ok(m) && pt_level(l3) == 3 && pt_leases(l3) == 0
  ensures mem_ok(m) && pt_level(l3) == 3 && pt_leases(l3) == 0
{
  if !w_map(&mut m, &mut l3, VDSO_PAGE, false) {
    return false;
  }
  let t2 = VDSO_PAGE / L2_PAGES;
  let q = VDSO_PAGE % L2_PAGES;
  if pt_has(l3, t2) {
    let mut l2 = pt_take(&mut l3, t2);
    let i = q / 512;
    if pt_has(l2, i) {
      let mut l1 = pt_take(&mut l2, i);
      if pt_has(l1, q % 512) && !pt_shared(l1, q % 512) {
        let mut f = pt_take_frame(&mut l1, q % 512);
        vdso_fill(&mut f, t, epoch);
        pt_put_frame(&mut l1, q % 512, f, false);
      }
      pt_put(&mut l2, i, l1);
    }
    pt_put(&mut l3, t2, l2);
  }
  return true;
}

fn aux(vec: &mut Bytes, w: u64, key: u64, v: u64)
  requires 8 * (w + 2) <= blen(vec)
  ensures blen(vec) == old(blen(vec))
{
  put_u64(&mut vec, 8 * w, key);
  put_u64(&mut vec, 8 * (w + 1), v);
}

/// The window page cache for file h's page pg: maps it read-only at
/// window page p of l3 from the page cache (src/pcache.bastio), reading it
/// in first if no process has it. A page that cannot be cached (the file
/// is shorter than it was, or memory ran out) is left to be copied, so
/// this is false only if a level-1 table could not be made.
fn share_file_page(m: &mut Mem, v: &mut Vfs, h: u64, pg: u64, l3: &mut PageTable, p: u64) -> bool
  requires mem_ok(m) && vfs_ok(v) && pt_level(l3) == 3 && p < WPAGES && pg < 512
  ensures mem_ok(m) && vfs_ok(v) && pt_level(l3) == 3
{
  let mut slot = pc_get(&mut v.pc, h, pg);
  if slot >= PC_N {
    if vfs_read_at(&mut v, h, pg * 4096, XFER) != XFER {
      return true;
    }
    slot = pc_add(&mut v.pc, &mut m, h, pg, v.xfer, XFER, true);
    if slot >= PC_N {
      return true;
    }
  }
  if !w_tables(&mut m, &mut l3, p) {
    return false;
  }
  let t = p / L2_PAGES;
  if pt_has(l3, t) {
    pt_borrow(&mut l3, t, l2_map_text, &mut v.pc, slot, p % L2_PAGES);
  }
  return true;
}

fn l2_map_text(l2: &mut PageTable, c: &mut PCache, slot: u64, q: u64)
  requires pt_level(l2) == 2 && q < L2_PAGES && pc_ok(c) && slot < PC_N
  ensures pt_level(l2) == 2 && pc_ok(c)
{
  if pt_has(l2, q / 512) {
    pt_borrow(&mut l2, q / 512, pc_map_text, &mut c, slot, q % 512);
  }
}

/// Maps the pages of program `src` (checked headers `e`) that only its
/// read-only segments cover, read-only, into window `l3`: a built-in
/// program's from the cache k.txt (`st`, src/text.bastio), a file's from
/// the page cache. A page a writable segment touches, one past the
/// segment's file bytes, or one whose file offset is not page-aligned is
/// left to be copied. False if memory ran out.
fn share_text(m: &mut Mem, st: &mut PageTable, l3: &mut PageTable, v: &mut Vfs, src: Src, e: Elf) -> bool
  requires mem_ok(m) && pt_level(st) == 2 && pt_leases(st) == 0 && pt_level(l3) == 3 && vfs_ok(v)
  requires e.ok && elf_fits(src.size, e)
  ensures mem_ok(m) && pt_level(st) == 2 && pt_leases(st) == 0 && pt_level(l3) == 3 && vfs_ok(v)
{
  if !src.file && src.prog >= 512 {
    return true;
  }
  // The window pages the writable segments touch, lo .. hi.
  let mut lo = WPAGES;
  let mut hi = 0;
  let mut i = 0;
  while i < e.phnum
    invariant i <= e.phnum && e.phnum <= PH_MAX && vfs_ok(v)
  {
    let s = seg(&mut v, src, e.phoff, i, e.bias);
    if s.kind == SEG_LOAD && s.w {
      if s.off / 4096 < lo {
        lo = s.off / 4096;
      }
      if (s.off + s.memsz + 4095) / 4096 > hi {
        hi = (s.off + s.memsz + 4095) / 4096;
      }
    } else if s.kind == SEG_BAD {
      return true;                          // elf_space finds it and gives up
    }
    i = i + 1;
  }
  let mut ok = true;
  i = 0;
  while ok && i < e.phnum
    invariant i <= e.phnum && e.phnum <= PH_MAX && vfs_ok(v) && mem_ok(m)
    invariant pt_level(st) == 2 && pt_leases(st) == 0 && pt_level(l3) == 3
  {
    let s = seg(&mut v, src, e.phoff, i, e.bias);
    if s.kind == SEG_LOAD && !s.w {
      // Each whole page of the segment's file bytes.
      let mut a = s.off - s.off % 4096;
      if a < s.off {
        a = a + 4096;
      }
      while ok && a + 4096 <= s.off + s.filesz
        invariant s.off <= a && a <= IMAGE_MAX + 4096 && s.off + s.filesz <= IMAGE_MAX && s.from + s.filesz <= src.size
        invariant mem_ok(m) && pt_level(st) == 2 && pt_leases(st) == 0 && pt_level(l3) == 3 && vfs_ok(v)
      {
        let fo = s.from + (a - s.off);
        let p = a / 4096;
        if (p < lo || p >= hi) && fo % 4096 == 0 && fo / 4096 < 512 && src.file {
          ok = share_file_page(&mut m, &mut v, src.f, fo / 4096, &mut l3, p);
        } else if (p < lo || p >= hi) && fo % 4096 == 0 && fo / 4096 < 512 && src.prog < 512 {
          ok = share_page(&mut m, &mut st, src.prog, prog_image(src.prog), fo / 4096, &mut l3, p);
        }
        a = a + 4096;
      }
    }
    i = i + 1;
  }
  return ok;
}

/// The pages of program file `src` (headers `e`) to leave for the first
/// touch: the whole pages of its largest executable, read-only segment's
/// file bytes, if they sit at a whole-page file offset and no writable
/// segment shares a page with them. Programs touch a small part of their
/// code (Z3, 24 MiB of it, answers a query from a few hundred pages), so
/// exec reads and maps only the rest. None for a built-in program, whose
/// code is shared already.
fn lazy_plan(v: &mut Vfs, src: Src, e: Elf) -> Lz
  requires vfs_ok(v) && e.ok && elf_fits(src.size, e)
  ensures vfs_ok(v) && result.first + result.pages <= WPAGES
{
  if !src.file {
    return lz_none();
  }
  let mut lo = WPAGES;
  let mut hi = 0;
  let mut best = lz_none();
  let mut i = 0;
  while i < e.phnum
    invariant i <= e.phnum && e.phnum <= PH_MAX && vfs_ok(v) && best.first + best.pages <= WPAGES
  {
    let s = seg(&mut v, src, e.phoff, i, e.bias);
    if s.kind == SEG_BAD {
      return lz_none();
    }
    if s.kind == SEG_LOAD && s.w {
      if s.off / 4096 < lo {
        lo = s.off / 4096;
      }
      if (s.off + s.memsz + 4095) / 4096 > hi {
        hi = (s.off + s.memsz + 4095) / 4096;
      }
    } else if s.kind == SEG_LOAD && s.x {
      let a0 = (s.off + 4095) / 4096;
      let a1 = (s.off + s.filesz) / 4096;
      if a1 > a0 && a1 <= WPAGES && (s.from + (a0 * 4096 - s.off)) % 4096 == 0 && a1 - a0 > best.pages {
        best = Lz { first: a0, pages: a1 - a0, off: s.from + (a0 * 4096 - s.off) };
      }
    }
    i = i + 1;
  }
  if best.pages > 0 && best.first < hi && lo < best.first + best.pages {
    return lz_none();                       // a writable page among them
  }
  return best;
}

/// share_text with the cache, if there is one.
fn share_text_in(m: &mut Mem, txt: &mut Store, l3: &mut PageTable, v: &mut Vfs, src: Src, e: Elf) -> bool
  requires mem_ok(m) && store_ok(txt) && pt_level(l3) == 3 && vfs_ok(v)
  requires e.ok && elf_fits(src.size, e)
  ensures mem_ok(m) && store_ok(txt) && pt_level(l3) == 3 && vfs_ok(v)
{
  match txt {
    Store::None => {
      txt = Store::None;
      return true;
    },
    Store::Table(t) => {
      let mut st = t;
      let ok = share_text(&mut m, &mut st, &mut l3, &mut v, src, e);
      txt = Store::Table(st);
      return ok;
    },
  }
}

/// Builds an address space for the checked ELF image `src`: its loadable
/// segments, zero-filled to their memory size, those of the interpreter
/// `isrc` too when `ie` is ok, and a stack holding argv, envp and the
/// auxiliary vector. Returns `Space::Empty`, with every page given back,
/// when memory runs out.
fn elf_space(m: &mut Mem, txt: &mut Store, v: &mut Vfs, src: Src, e: Elf, isrc: Src, ie: Elf, lz: Lz, args: &Bytes, alen: u64, total: u64, seed: u64, clk: Tsc, epoch: u64) -> Space
  requires mem_ok(m) && store_ok(txt) && vfs_ok(v) && e.ok && elf_fits(src.size, e) && elf_fits(isrc.size, ie)
  requires alen <= total && total <= ARGS_MAX && total <= blen(args)
  ensures mem_ok(m) && store_ok(txt) && vfs_ok(v)
  ensures result is Space::Mapped ==> pt_level(result.Mapped) == 4
{
  match new_window(&mut m, "", 0) {
    Space::Empty => { return Space::Empty; },
    Space::Mapped(mut l3) => {
      // Shared read-only pages first; the rest of the image gets fresh
      // pages, and the copy below skips the read-only ones.
      let mut ok = share_text_in(&mut m, &mut txt, &mut l3, &mut v, src, e);
      if ok && ie.ok {
        ok = share_text_in(&mut m, &mut txt, &mut l3, &mut v, isrc, ie);
      }
      let mut q = 0;
      while ok && q < (e.end + 4095) / 4096
        invariant pt_level(l3) == 3 && mem_ok(m) && e.end <= IMAGE_MAX
      {
        if q < lz.first || q - lz.first >= lz.pages {
          ok = w_map(&mut m, &mut l3, q, false);   // not left for the first touch
        }
        q = q + 1;
      }
      let mut i = 0;
      while ok && i < e.phnum
        invariant i <= e.phnum && e.phnum <= PH_MAX && pt_level(l3) == 3 && vfs_ok(v)
      {
        let s = seg(&mut v, src, e.phoff, i, e.bias);
        if s.kind == SEG_LOAD {
          ok = copy_in(&mut l3, &mut v, src, s.from, s.off, s.filesz);
        } else if s.kind == SEG_BAD {
          ok = false;                       // the file changed since elf_parse
        }
        i = i + 1;
      }
      // The interpreter's segments, on pages of their own.
      let mut iph = 0;
      if ie.ok {
        iph = ie.phnum;
      }
      let mut j = 0;
      while ok && j < iph
        invariant j <= iph && iph <= PH_MAX && pt_level(l3) == 3 && vfs_ok(v) && mem_ok(m)
      {
        let s = seg(&mut v, isrc, ie.phoff, j, ie.bias);
        if s.kind == SEG_LOAD {
          let mut p = s.off / 4096;
          while ok && p < (s.off + s.memsz + 4095) / 4096
            invariant pt_level(l3) == 3 && mem_ok(m) && s.off + s.memsz <= IMAGE_MAX
          {
            ok = w_map(&mut m, &mut l3, p, false);
            p = p + 1;
          }
          if ok {
            ok = copy_in(&mut l3, &mut v, isrc, s.from, s.off, s.filesz);
          }
        } else if s.kind == SEG_BAD {
          ok = false;
        }
        j = j + 1;
      }
      // The vDSO, unless the program's own pages reach that high.
      let mut vdso = false;
      if ok && !w_has(&mut l3, VDSO_PAGE) {
        ok = vdso_map(&mut m, &mut l3, clk, epoch);
        vdso = true;
      }
      if !ok {
        free_l3(&mut m, l3);
        return Space::Empty;
      }
      let mut base = 0;
      if ie.ok {
        base = ie.bias;
      }
      if !init_stack(&mut m, &mut l3, e, base, vdso, args, alen, total, seed) {
        free_l3(&mut m, l3);
        return Space::Empty;
      }
      return space_from_l3(&mut m, l3);
    },
  }
}
