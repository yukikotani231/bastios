// A PS/2 keyboard on the i8042 controller (data port 0x60, status port
// 0x64), polled. The controller hands over scan code set 1 (it translates
// by default). Keys become the bytes a serial terminal would send: Enter
// is CR, Backspace is DEL, Ctrl with a letter is that control code (Ctrl-C
// is 3). On many PCs without a PS/2 port, the firmware emulates one for a
// USB keyboard.
//
// A PS/2 mouse on the controller's second (aux) port is turned on at start
// (enable the port, set defaults, ask for the wheel with the IntelliMouse
// sequence, enable reporting) and its bytes, which come through the same
// data port marked by the status register, are put together into 3-byte
// packets (buttons and sign bits; x; y), or 4-byte ones with the wheel if
// the mouse then says it is an IntelliMouse (id 3). kbd_poll answers a
// whole packet as MOUSE_PKT plus its four bytes (the wheel 0 without
// one); the console pump
// hands packets to the kernel, which gives them to Linux programs as
// /dev/input/mice (src/lxmouse.bastio). A byte that cannot start a packet
// (bit 3 clear) is dropped, so a lost byte costs a packet, not the stream.

import "blkconst.bastio";
const KBD_DATA: u64 = 0x60;
const KBD_STATUS: u64 = 0x64;
const KST_FULL: u64 = 1;              // a byte is waiting
const KST_AUX: u64 = 32;              // ... and it is from the mouse
const KST_BUSY: u64 = 2;              // the controller has not taken the last byte written
const AUX_SPINS: u64 = 100000;
const KBD_CAD: u64 = 255;             // kbd_poll's answer for Ctrl-Alt-Delete (no key gives a byte of 128 or more)

struct Kbd { data: PortIo, status: PortIo, shift: bool, ctrl: bool, alt: bool, ext: bool, present: bool,
  aux: bool,          // a PS/2 mouse answered and reports
  aux_irq: bool,      // ... and the controller raises IRQ 12 for its bytes (so no polling is needed to notice them)
  wheel: bool,        // ... with a wheel: 4-byte packets
  mb: u64,            // the bytes of the mouse packet so far, first in the high byte
  mn: u64 }           // how many (0 .. 3)

spec fn kbd_ok(k: &Kbd) -> bool {
  port_count(k.data) == 1 && port_count(k.status) == 1 && k.mn < 4 && k.mb < 16777216
}

// Scan codes 0x00-0x39 to characters (0: none or special).
fn keymap() -> Str {
  return "\0\01234567890-=\0\tqwertyuiop[]\r\0asdfghjkl;'`\0\\zxcvbnm,./\0*\0 ";
}

fn keymap_shift() -> Str {
  return "\0\0!@#$%^&*()_+\0\tQWERTYUIOP{}\r\0ASDFGHJKL:\"~\0|ZXCVBNM<>?\0*\0 ";
}

/// Empties anything the controller holds from before. Many recent PCs have
/// no i8042 at all (and no firmware emulation of one); its ports then read
/// 0xFF, which would say a mouse byte is always waiting, and the keyboard
/// is left alone from then on.
fn kbd_init(k: &mut Kbd)
  requires kbd_ok(k)
  ensures kbd_ok(k)
{
  if cast[u64](pio_in8(&mut k.status, 0)) == 0xFF {
    k.present = false;
    return;
  }
  let mut n = 0;
  while n < 64 && cast[u64](pio_in8(&mut k.status, 0)) % 2 == KST_FULL
    invariant n <= 64 && kbd_ok(k)
  {
    pio_in8(&mut k.data, 0);
    n = n + 1;
  }
  // The mouse: enable the aux port, then defaults, the wheel if it has
  // one, and reporting, each command acknowledged (0xFA) by the mouse.
  if kbd_ctl(&mut k, 0xA8) && aux_cmd(&mut k, 0xF6) {
    k.wheel = mouse_wheel(&mut k);
    k.aux = aux_cmd(&mut k, 0xF4);
    if k.aux {
      k.aux_irq = aux_irq_on(&mut k);
    }
  }
}

/// Sets the controller configuration byte's bit 1, which lets the mouse
/// raise IRQ 12. True if the byte was read and written back.
fn aux_irq_on(k: &mut Kbd) -> bool
  requires kbd_ok(k)
  ensures kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb)
{
  if !kbd_ctl(&mut k, 0x20) {
    return false;
  }
  let mut i = 0;
  while i < AUX_SPINS
    invariant kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb)
  {
    if cast[u64](pio_in8(&mut k.status, 0)) % 2 == KST_FULL {
      let cfg = cast[u64](pio_in8(&mut k.data, 0));
      if !kbd_ctl(&mut k, 0x60) || !kbd_idle(&mut k) {
        return false;
      }
      pio_out8(&mut k.data, 0, cast[u8](cfg % 2 + cfg / 4 % 64 * 4 + 2));
      return kbd_idle(&mut k);
    }
    i = i + 1;
  }
  return false;
}

/// The IntelliMouse sequence: sample rates 200, 100 and 80, after which a
/// mouse with a wheel says id 3 and sends 4-byte packets. The rate is set
/// back to 100 either way. True if it said 3.
fn mouse_wheel(k: &mut Kbd) -> bool
  requires kbd_ok(k)
  ensures kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb)
{
  if !(aux_cmd(&mut k, 0xF3) && aux_cmd(&mut k, 200) && aux_cmd(&mut k, 0xF3) && aux_cmd(&mut k, 100)
      && aux_cmd(&mut k, 0xF3) && aux_cmd(&mut k, 80) && aux_cmd(&mut k, 0xF2)) {
    return false;
  }
  let id = aux_read(&mut k);
  aux_cmd(&mut k, 0xF3);
  aux_cmd(&mut k, 100);
  return id == 3;
}

/// The next byte from the mouse, or 256 if none comes.
fn aux_read(k: &mut Kbd) -> u64
  requires kbd_ok(k)
  ensures kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb) && result <= 256
{
  let mut i = 0;
  while i < AUX_SPINS
    invariant kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb)
  {
    let st = cast[u64](pio_in8(&mut k.status, 0));
    if st % 2 == KST_FULL {
      let b = cast[u64](pio_in8(&mut k.data, 0));
      if st / KST_AUX % 2 == 1 {
        return b;
      }
    }
    i = i + 1;
  }
  return 256;
}

/// Waits until the controller has taken the last byte written; false on a
/// timeout.
fn kbd_idle(k: &mut Kbd) -> bool
  requires kbd_ok(k)
  ensures kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb)
{
  let mut i = 0;
  while i < AUX_SPINS
    invariant kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb)
  {
    if cast[u64](pio_in8(&mut k.status, 0)) / KST_BUSY % 2 == 0 {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Writes controller command c.
fn kbd_ctl(k: &mut Kbd, c: u64) -> bool
  requires kbd_ok(k) && c < 256
  ensures kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb)
{
  if !kbd_idle(&mut k) {
    return false;
  }
  pio_out8(&mut k.status, 0, cast[u8](c));
  return true;
}

/// Sends byte c to the mouse and waits for its acknowledgement; anything
/// else that comes meanwhile is dropped. False if none comes.
fn aux_cmd(k: &mut Kbd, c: u64) -> bool
  requires kbd_ok(k) && c < 256
  ensures kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb)
{
  if !kbd_ctl(&mut k, 0xD4) || !kbd_idle(&mut k) {
    return false;
  }
  pio_out8(&mut k.data, 0, cast[u8](c));
  let mut i = 0;
  while i < AUX_SPINS
    invariant kbd_ok(k) && k.mn == old(k.mn) && k.mb == old(k.mb)
  {
    let st = cast[u64](pio_in8(&mut k.status, 0));
    if st % 2 == KST_FULL {
      let b = cast[u64](pio_in8(&mut k.data, 0));
      if st / KST_AUX % 2 == 1 && b == 0xFA {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

/// Takes mouse byte b. Returns the packet it completes as MOUSE_PKT plus
/// its bytes, or 0.
fn mouse_byte(k: &mut Kbd, b: u64) -> u64
  requires kbd_ok(k) && b < 256
  ensures kbd_ok(k) && (result == 0 || (result >= MOUSE_PKT && result < 2 * MOUSE_PKT))
{
  if k.mn == 0 && b / 8 % 2 == 0 {
    return 0;                         // not a first byte: wait for one
  }
  let mut last = 2;
  if k.wheel {
    last = 3;
  }
  if k.mn < last {
    k.mb = k.mb % 65536 * 256 + b;
    k.mn = k.mn + 1;
    return 0;
  }
  let mut p = MOUSE_PKT + k.mb * 256 + b;      // b is the wheel
  if !k.wheel {
    p = MOUSE_PKT + k.mb % 65536 * 65536 + b * 256;
  }
  k.mb = 0;
  k.mn = 0;
  return p;
}

/// The next character typed (KBD_CAD for Ctrl-Alt-Delete), or a mouse packet (MOUSE_PKT plus its bytes),
/// or 256 if there is neither.
fn kbd_poll(k: &mut Kbd) -> u64
  requires kbd_ok(k)
  ensures kbd_ok(k) && (result <= 256 || (result >= MOUSE_PKT && result < 2 * MOUSE_PKT))
{
  if !k.present {
    return 256;
  }
  let mut n = 0;
  while n < 16
    invariant n <= 16 && kbd_ok(k)
  {
    let st = cast[u64](pio_in8(&mut k.status, 0));
    if st % 2 != KST_FULL {
      return 256;
    }
    let sc = cast[u64](pio_in8(&mut k.data, 0));
    n = n + 1;
    if st / KST_AUX % 2 == 1 {
      if k.aux {
        let p = mouse_byte(&mut k, sc);
        if p != 0 {
          return p;
        }
      }
    } else if sc == 0xE0 {
      k.ext = true;                   // the next code is an extended key
    } else {
      let ext = k.ext;
      k.ext = false;
      let up = sc >= 128;
      let code = sc % 128;
      if code == 0x2A || code == 0x36 {
        k.shift = !up;
      } else if code == 0x1D {
        k.ctrl = !up;                 // either Ctrl (the right one is extended)
      } else if code == 0x38 {
        k.alt = !up;                  // either Alt
      } else if code == 0x53 && !up && k.ctrl && k.alt {
        return KBD_CAD;               // Delete, with the keypad's or the editing block's
      } else if !up && !ext {
        if code == 0x01 {
          return 27;                  // Esc
        }
        if code == 0x0E {
          return 127;                 // Backspace, as DEL
        }
        let m = keymap();
        let ms = keymap_shift();
        if code < slen(m) && code < slen(ms) {
          let mut c = cast[u64](sget(m, code));
          if k.shift {
            c = cast[u64](sget(ms, code));
          }
          if k.ctrl && c >= 97 && c <= 122 {
            c = c - 96;               // Ctrl-A is 1
          }
          if c != 0 {
            return c;
          }
        }
      } else if !up && ext && code == 0x1C {
        return 13;                    // keypad Enter
      }
    }
  }
  return 256;
}
