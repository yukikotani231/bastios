// Linux munmap, mprotect and mremap on the window (src/space.bastio).
//
// munmap gives the pages back. mprotect makes them inaccessible, read-only
// or writable (pt_set_access); those bits are the page table's own, so fork
// keeps them (clone_l1), and the kernel neither reads a PROT_NONE page nor
// writes a read-only one for the program (w_read, w_write). A PROT_NONE
// page stays mapped, only hidden, so a MAP_SHARED page keeps being shared. mremap moves pages without copying them: each one
// leaves its old slot and goes to the new one. A stale TLB entry cannot
// outlive any of this: the threads of a process may run on several
// processors at once, so these calls first wait until none of them holds a
// lease on the space (win_quiet), and every entry to user mode reloads CR3.
//
// A fresh private anonymous PROT_NONE mmap maps no pages until mprotect
// makes them usable, so a large reservation costs nothing; touching it
// faults (and a system call given it fails with -EFAULT) as on Linux.
//
// Not done: an mprotect that allows access maps fresh pages into any hole munmap left
// in the mmap area, where Linux fails with -ENOMEM; PROT_EXEC is not enforced;
// the address space holes munmap leaves are not reused by later mmaps.

import "linux.bastio";

const PROT_READ: u64 = 1;
const PROT_WRITE: u64 = 2;
const PROT_EXEC: u64 = 4;
const MREMAP_MAYMOVE: u64 = 1;

/// Window page p out of l2: its frame goes back to m. Nothing if p is not
/// mapped.
fn w_unmap(m: &mut Mem, l2: &mut PageTable, p: u64)
  requires mem_ok(m) && pt_level(l2) == 2 && p < WPAGES && pt_leases(l2) == 0
  ensures mem_ok(m) && pt_level(l2) == 2 && pt_leases(l2) == 0
{
  let t = p / 512;
  if pt_has(l2, t) {
    let mut l1 = pt_take(&mut l2, t);
    if pt_has(l1, p % 512) && pt_shared(l1, p % 512) {
      drop_shared(&mut m, pt_take_shared(&mut l1, p % 512));
    } else if pt_has(l1, p % 512) {
      give_page(&mut m, pt_take_frame(&mut l1, p % 512));
    }
    pt_put(&mut l2, t, l1);
  }
}

/// Sets what the program may do with window page p, if it is mapped:
/// 0 nothing (PROT_NONE), 1 read, 2 read and write. False if not mapped.
fn w_protect(l2: &mut PageTable, p: u64, a: u64) -> bool
  requires pt_level(l2) == 2 && p < WPAGES && pt_leases(l2) == 0 && a <= 2
  ensures pt_level(l2) == 2 && pt_leases(l2) == 0
{
  let t = p / 512;
  if !pt_has(l2, t) {
    return false;
  }
  let mut l1 = pt_take(&mut l2, t);
  let mut ok = false;
  if pt_has(l1, p % 512) {
    pt_set_access(&mut l1, p % 512, a);
    ok = true;
  }
  pt_put(&mut l2, t, l1);
  return ok;
}

/// Moves the page at window page `from` to window page `to`, keeping its
/// permission; whatever was at `to` goes back to m first. A `from` with no
/// page leaves `to` empty. False if a level-1 table for `to` could not be
/// made.
fn w_move(m: &mut Mem, l2: &mut PageTable, from: u64, to: u64) -> bool
  requires mem_ok(m) && pt_level(l2) == 2 && from < WPAGES && to < WPAGES && pt_leases(l2) == 0
  ensures mem_ok(m) && pt_level(l2) == 2 && pt_leases(l2) == 0
{
  w_unmap(&mut m, &mut l2, to);
  let tf = from / 512;
  if !pt_has(l2, tf) {
    return true;
  }
  let tt = to / 512;
  if !pt_has(l2, tt) {
    let a = find_free(&mut m);
    if a >= NPAGES {
      return false;
    }
    pt_put(&mut l2, tt, pt_new(take_page(&mut m, a), 1));
  }
  let mut src = pt_take(&mut l2, tf);
  if !pt_has(src, from % 512) {
    pt_put(&mut l2, tf, src);
    return true;
  }
  let w = pt_writable(src, from % 512);
  let hidden = !pt_accessible(src, from % 512);    // PROT_NONE stays so
  if pt_shared(src, from % 512) {
    let s = pt_take_shared(&mut src, from % 512);
    pt_put(&mut l2, tf, src);
    let mut dst = pt_take(&mut l2, tt);
    if pt_has(dst, to % 512) {
      drop_shared(&mut m, s);                     // cannot happen: `to` was emptied
    } else {
      pt_put_shared(&mut dst, to % 512, s, w);
      if hidden {
        pt_set_access(&mut dst, to % 512, 0);
      }
    }
    pt_put(&mut l2, tt, dst);
    return true;
  }
  let f = pt_take_frame(&mut src, from % 512);
  if tf == tt {
    if pt_has(src, to % 512) {
      pt_put_frame(&mut src, from % 512, f, w);   // cannot happen: `to` was emptied
    } else {
      pt_put_frame(&mut src, to % 512, f, w);
      if hidden {
        pt_set_access(&mut src, to % 512, 0);
      }
    }
    pt_put(&mut l2, tf, src);
    return true;
  }
  pt_put(&mut l2, tf, src);
  let mut dst = pt_take(&mut l2, tt);
  if pt_has(dst, to % 512) {
    give_page(&mut m, f);                         // cannot happen: `to` was emptied
  } else {
    pt_put_frame(&mut dst, to % 512, f, w);
    if hidden {
      pt_set_access(&mut dst, to % 512, 0);
    }
  }
  pt_put(&mut l2, tt, dst);
  return true;
}

/// Whether no processor runs process pid's space now, so its mappings may
/// shrink or lose permissions (win_op). If one does, pid is marked F_QUIET:
/// the other threads of its group are not picked again (group_free) until
/// pid's retried call finds the space free and clears the mark.
fn win_quiet(k: &mut Kernel, pid: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut free = true;
  match take_space(&mut k.spaces, pid) {
    Space::Empty => {},
    Space::Mapped(mut root) => {
      free = pt_lease_count(&mut root) == 0;
      put_space(&mut k.spaces, pid, Space::Mapped(root));
    },
  }
  if free {
    pset(&mut k.procs, pid, F_QUIET, 0);
  } else {
    pset(&mut k.procs, pid, F_QUIET, 1);
  }
  return free;
}

/// Does `op` to window pages from .. to of process pid: unmap them,
/// protect them (arg: what w_protect takes), move them to arg ..., or only count them. Returns how many
/// of them were mapped, or WPAGES + 1 if the process has no window, a move
/// ran out of memory, or a processor runs the space (win_quiet says first).
fn win_op(m: &mut Mem, spaces: &mut Vec[Space], pid: u64, op: u64, from: u64, to: u64, arg: u64) -> u64
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC && from <= to && to <= WPAGES
  requires op == WOP_MOVE ==> arg + (to - from) <= WPAGES
  ensures mem_ok(m) && spaces_ok(spaces)
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return WPAGES + 1; },
    Space::Mapped(mut root) => {
      let mut r = WPAGES + 1;
      if pt_lease_count(&mut root) == 0 && pt_has(root, 1) {
        let mut l3 = pt_take(&mut root, 1);
        if pt_has(l3, 0) {
          let mut l2 = pt_take(&mut l3, 0);
          r = 0;
          let mut i = 0;
          let n = to - from;
          // A move to higher pages goes from the top, so a page is never
          // moved onto one not moved yet.
          let up = op == WOP_MOVE && arg > from;
          while i < n
            invariant i <= n && n == to - from && from <= to && to <= WPAGES && mem_ok(m) && pt_level(l2) == 2 && pt_leases(l2) == 0
            invariant op == WOP_MOVE ==> arg + n <= WPAGES
            invariant r <= WPAGES + 1
          {
            let mut j = i;
            if up {
              j = n - 1 - i;
            }
            let p = from + j;
            if op == WOP_UNMAP {
              if w_has(&mut l2, p) && r < WPAGES {
                r = r + 1;
              }
              w_unmap(&mut m, &mut l2, p);
            } else if op == WOP_COUNT {
              if w_has(&mut l2, p) && r < WPAGES {
                r = r + 1;
              }
            } else if op == WOP_PROTECT {
              if arg <= 2 && w_protect(&mut l2, p, arg) && r < WPAGES {
                r = r + 1;
              }
            } else if op == WOP_MOVE && r <= WPAGES {
              if !w_move(&mut m, &mut l2, p, arg + j) {
                r = WPAGES + 1;
              }
            }
            i = i + 1;
          }
          pt_put(&mut l3, 0, l2);
        }
        pt_put(&mut root, 1, l3);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return r;
    },
  }
}

/// The window pages addr .. addr + n cover, as first * 2^32 + end; or
/// 2^64 - 1 if addr is not page aligned, n is 0, or the range leaves the
/// part of the window below the stack.
fn win_range(addr: u64, n: u64) -> u64
  ensures result != 18446744073709551615 ==> (result / 4294967296 < result % 4294967296 && result % 4294967296 <= STACK_FIRST)
{
  if addr % 4096 != 0 || addr < USER_BASE || n == 0 || n > USER_SIZE {
    return 18446744073709551615;
  }
  let first = (addr - USER_BASE) / 4096;
  let pages = (n + 4095) / 4096;
  if first >= STACK_FIRST || pages > STACK_FIRST - first {
    return 18446744073709551615;
  }
  return first * 4294967296 + first + pages;
}

/// munmap(addr, n).
fn lx_munmap(k: &mut Kernel, pid: u64, addr: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r = win_range(addr, n);
  if r == 18446744073709551615 {
    return EINVAL;
  }
  if map_forget(&mut k, pid, r / 4294967296, r % 4294967296, true) == DISK_RETRY {
    return DISK_RETRY;                      // nothing unmapped yet: the call starts again
  }
  win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, r / 4294967296, r % 4294967296, 0);
  return 0;
}

/// What w_protect gives a page for `prot`: 2 with PROT_WRITE, else 1 with
/// PROT_READ or PROT_EXEC (an x86 page that can run can be read), else 0.
fn prot_access(prot: u64) -> u64
  ensures result <= 2
{
  if prot / PROT_WRITE % 2 == 1 {
    return 2;
  }
  if prot / PROT_READ % 2 == 1 || prot / PROT_EXEC % 2 == 1 {
    return 1;
  }
  return 0;
}

/// mprotect(addr, n, prot): writable with PROT_WRITE, read-only with only
/// PROT_READ or PROT_EXEC, inaccessible with neither.
/// Pages of a PROT_NONE mmap that were never mapped (lx_mmap) get fresh
/// zero pages when prot allows access. -ENOMEM if a page in the range is
/// not mapped (the others still change, where Linux would change none).
fn lx_mprotect(k: &mut Kernel, pid: u64, addr: u64, n: u64, prot: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if addr % 4096 != 0 {
    return EINVAL;
  }
  if n == 0 {
    return 0;
  }
  let r = win_range(addr, n);
  if r == 18446744073709551615 {
    return ENOMEM;                          // not memory the process has
  }
  let a = prot_access(prot);
  let from = r / 4294967296;
  let to = r % 4294967296;
  // Only pages mmap handed out can have been left unmapped by PROT_NONE.
  let low = pget(k.procs, pid, F_MMAP) / 4096;
  if prot != 0 && from >= low && !lx_map_pages(&mut k.mem, &mut k.spaces, pid, from, to, false) {
    return ENOMEM;
  }
  // PROT_NONE leaves mmap's reserved pages unmapped, so they do not count.
  let got = win_op(&mut k.mem, &mut k.spaces, pid, WOP_PROTECT, from, to, a);
  if got > to - from || (got != to - from && (a != 0 || from < low)) {
    return ENOMEM;
  }
  return 0;
}

/// mremap(addr, oldn, newn, flags): shrinking unmaps the tail; growing
/// moves the pages (with MREMAP_MAYMOVE) to a new place below the lowest
/// mmap, where the rest are fresh zero pages. Growing in place is not
/// tried: without MREMAP_MAYMOVE it is -ENOMEM.
fn lx_mremap(k: &mut Kernel, pid: u64, addr: u64, oldn: u64, newn: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r = win_range(addr, oldn);
  if r == 18446744073709551615 || newn == 0 || newn > USER_SIZE {
    return EINVAL;
  }
  let from = r / 4294967296;
  let oend = r % 4294967296;
  let have = oend - from;
  let want = (newn + 4095) / 4096;
  // A shared file mapping is written back and stops being shared where
  // pages leave (the tail) or move (all of them).
  if want <= have {
    map_forget(&mut k, pid, from + want, oend, false);
    win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, from + want, oend, 0);
    return addr;
  }
  if flags / MREMAP_MAYMOVE % 2 == 0 {
    return ENOMEM;
  }
  let brk = pget(k.procs, pid, F_BRK);
  let low = pget(k.procs, pid, F_MMAP);
  if low > STACK_FIRST * 4096 || brk > low || want * 4096 > low - brk {
    return ENOMEM;
  }
  let at = (low - want * 4096) / 4096;
  if at * 4096 < brk || at + want > STACK_FIRST {
    return ENOMEM;
  }
  // Fresh pages for the new tail first, so running out of memory leaves
  // the addr mapping as it was.
  if !lx_map_pages(&mut k.mem, &mut k.spaces, pid, at + have, at + want, false) {
    win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, at + have, at + want, 0);
    return ENOMEM;
  }
  map_forget(&mut k, pid, from, oend, false);
  if win_op(&mut k.mem, &mut k.spaces, pid, WOP_MOVE, from, oend, at) > WPAGES {
    return ENOMEM;
  }
  pset(&mut k.procs, pid, F_MMAP, at * 4096);
  return USER_BASE + at * 4096;
}

// ------------------------------------------------- shared file mappings
//
// A MAP_SHARED mapping of a file maps the page cache's pages
// (src/pcache.bastio, lx_map_file_shared below), so every process that
// maps the file shares them, and it is recorded, so msync and munmap write
// the pages back, and exit and execve do too. Each process has MAP_N
// records in k.maps: the first window page + 1 (0: free), the page count,
// the open file description (which the record holds a reference on, so the
// file stays open after close, and so its cached pages stay), and the file
// offset of the first page.
//
// Not done: a mapping beyond MAP_N is never written back, and its file can
// be closed under it (it keeps its pages, but they leave the cache); a row
// opened O_APPEND is not written back; the write-back at exit and
// execve gives up on blocks the disk has not cached.

const LX_MSYNC: u64 = 26;

/// Where word f of record i of process p is in k.maps.
fn mp_at(p: u64, i: u64, f: u64) -> u64
  requires p < NPROC && i < MAP_N && f < MAP_W
  ensures result < MAPS_LEN
{
  return (p * MAP_N + i) * MAP_W + f;
}

/// Records window pages first .. first + pages of process pid as a shared
/// mapping of the file open as fd, from offset off. Nothing if fd names
/// no file or every record is in use (the mapping is then never written
/// back).
fn map_record(k: &mut Kernel, pid: u64, fd: u64, first: u64, pages: u64, off: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N || of_get(k.ofd, h, 0) != OF_FILE || first >= WPAGES {
    return;
  }
  let mut i = 0;
  while i < MAP_N && get(k.maps, mp_at(pid, i, 0)) != 0
    invariant i <= MAP_N && kok(k)
  {
    i = i + 1;
  }
  if i >= MAP_N {
    return;
  }
  of_set(&mut k.ofd, h, 1, sat_add(of_get(k.ofd, h, 1), 1));
  k.maps = set(k.maps, mp_at(pid, i, 0), first + 1);
  k.maps = set(k.maps, mp_at(pid, i, 1), pages);
  k.maps = set(k.maps, mp_at(pid, i, 2), h);
  k.maps = set(k.maps, mp_at(pid, i, 3), off);
}

/// Writes the pages of record i of process pid that lie in window pages
/// from .. to back to its file, up to the file's end. 0, or DISK_RETRY if
/// the disk has not cached blocks it needs (the pages before are queued;
/// writing them again is harmless).
fn map_flush(k: &mut Kernel, pid: u64, i: u64, from: u64, to: u64) -> u64
  requires kok(k) && pid < NPROC && i < MAP_N
  ensures kok(k)
{
  let first1 = get(k.maps, mp_at(pid, i, 0));
  let h = get(k.maps, mp_at(pid, i, 2));
  if first1 == 0 || h >= OFD_N || of_get(k.ofd, h, 0) != OF_FILE {
    return 0;
  }
  let row = of_get(k.ofd, h, 2);
  if row >= FD_ROWS || fget(k.fs.ftab, row, FD_MODE) / O_WRITE % 2 == 0 || fget(k.fs.ftab, row, FD_MODE) / O_APPEND % 2 == 1 {
    return 0;
  }
  let size = vfs_size(&mut k.fs, row_file(k.fs, row));
  if size == NO_FILE {
    return 0;
  }
  let first = first1 - 1;
  let end = sat_add(first, get(k.maps, mp_at(pid, i, 1)));
  let off = get(k.maps, mp_at(pid, i, 3));
  let last = smaller(smaller(end, to), WPAGES);
  let mut p = first;
  if p < from {
    p = from;
  }
  if p > last || first > last {
    return 0;                               // nothing of it in the range
  }
  let was = vfs_offset(k.fs, row);
  let mut r = 0;
  while p < last && r == 0
    invariant p <= last && last <= WPAGES && first <= p && kok(k) && row < FD_ROWS
  {
    let foff = sat_add(off, (p - first) * 4096);
    if foff < size {
      let n = smaller(4096, size - foff);
      if copy_from_user(&mut k.spaces, pid, USER_BASE + p * 4096, &mut k.fs.xfer, n) == n {
        vfs_seek(&mut k.fs, row, foff);
        if vfs_write(&mut k.fs, &mut k.mem, row, n) == VFS_MISS {
          r = DISK_RETRY;
        }
      }
    }
    p = p + 1;
  }
  vfs_seek(&mut k.fs, row, was);
  return r;
}

/// Drops record i of process pid and its reference on the file.
fn map_drop(k: &mut Kernel, pid: u64, i: u64)
  requires kok(k) && pid < NPROC && i < MAP_N
  ensures kok(k)
{
  let first1 = get(k.maps, mp_at(pid, i, 0));
  let h = get(k.maps, mp_at(pid, i, 2));
  k.maps = set(k.maps, mp_at(pid, i, 0), 0);
  if first1 != 0 && h < OFD_N {
    unref_value(&mut k, FD_OFD + h);
  }
}

/// Window pages from .. to of process pid are going away (munmap, a
/// MAP_FIXED mapping over them, mremap moving them): writes them back,
/// then forgets them. With `wait`, a disk miss returns DISK_RETRY before
/// anything is forgotten, so the call can start again; without, the
/// write-back is best effort.
fn map_forget(k: &mut Kernel, pid: u64, from: u64, to: u64, wait: bool) -> u64
  requires kok(k) && pid < NPROC && from <= to && to <= WPAGES
  ensures kok(k)
{
  let mut i = 0;
  while i < MAP_N
    invariant i <= MAP_N && kok(k)
  {
    if map_flush(&mut k, pid, i, from, to) == DISK_RETRY && wait {
      return DISK_RETRY;
    }
    i = i + 1;
  }
  i = 0;
  while i < MAP_N
    invariant i <= MAP_N && kok(k)
  {
    let first1 = get(k.maps, mp_at(pid, i, 0));
    let pages = get(k.maps, mp_at(pid, i, 1));
    if first1 != 0 {
      let first = first1 - 1;
      let end = sat_add(first, pages);
      if from <= first && end <= to {
        map_drop(&mut k, pid, i);                     // all of it
      } else if from <= first && first < to {
        // The head goes: the record starts at `to`.
        k.maps = set(k.maps, mp_at(pid, i, 0), to + 1);
        k.maps = set(k.maps, mp_at(pid, i, 1), end - to);
        k.maps = set(k.maps, mp_at(pid, i, 3), sat_add(get(k.maps, mp_at(pid, i, 3)), (to - first) * 4096));
      } else if first < from && from < end && end <= to {
        k.maps = set(k.maps, mp_at(pid, i, 1), from - first);   // the tail goes
      } else if first < from && to < end {
        // A hole in the middle: one record cannot say that, and a page
        // mapped there later must never reach the file. The rest was
        // written back above; it is no longer shared.
        map_drop(&mut k, pid, i);
      }
    }
    i = i + 1;
  }
  return 0;
}

/// Exit or execve: writes back and drops every record of process pid,
/// while its old address space is still there.
fn map_drop_all(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  map_forget(&mut k, pid, 0, WPAGES, false);
}

/// fork: the child gets the parent's records, each with a reference of
/// its own on the file.
fn map_fork(k: &mut Kernel, pid: u64, c: u64)
  requires kok(k) && pid < NPROC && c < NPROC
  ensures kok(k)
{
  let mut i = 0;
  while i < MAP_N
    invariant i <= MAP_N && kok(k)
  {
    let first1 = get(k.maps, mp_at(pid, i, 0));
    let h = get(k.maps, mp_at(pid, i, 2));
    if first1 != 0 && h < OFD_N {
      of_set(&mut k.ofd, h, 1, sat_add(of_get(k.ofd, h, 1), 1));
      k.maps = set(k.maps, mp_at(c, i, 0), first1);
    } else {
      k.maps = set(k.maps, mp_at(c, i, 0), 0);
    }
    k.maps = set(k.maps, mp_at(c, i, 1), get(k.maps, mp_at(pid, i, 1)));
    k.maps = set(k.maps, mp_at(c, i, 2), h);
    k.maps = set(k.maps, mp_at(c, i, 3), get(k.maps, mp_at(pid, i, 3)));
    i = i + 1;
  }
}

/// msync(addr, n, flags): writes the shared file pages in the range back.
fn lx_msync(k: &mut Kernel, pid: u64, addr: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r = win_range(addr, n);
  if r == 18446744073709551615 {
    return EINVAL;
  }
  let mut i = 0;
  while i < MAP_N
    invariant i <= MAP_N && kok(k)
  {
    if map_flush(&mut k, pid, i, r / 4294967296, r % 4294967296) == DISK_RETRY {
      return DISK_RETRY;
    }
    i = i + 1;
  }
  return 0;
}

/// mincore(addr, n, vec): one byte per page, 1 for each (every mapped page
/// is resident). -EINVAL for a misaligned addr, -ENOMEM if a page in the
/// range is not mapped, -EFAULT if vec is not writable.
fn lx_mincore(k: &mut Kernel, pid: u64, addr: u64, n: u64, vec: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if addr % 4096 != 0 {
    return EINVAL;
  }
  if addr < USER_BASE || n > USER_SIZE || addr - USER_BASE > USER_SIZE - n {
    return ENOMEM;
  }
  if vec > 18446744073709551615 - USER_SIZE {
    return EFAULT;
  }
  let from = (addr - USER_BASE) / 4096;
  let to = smaller((addr - USER_BASE + n + 4095) / 4096, WPAGES);
  if from > to || win_op(&mut k.mem, &mut k.spaces, pid, WOP_COUNT, from, to, 0) != to - from {
    return ENOMEM;
  }
  let mut i = 0;
  while i < XFER
    invariant i <= XFER && kok(k)
  {
    bset(&mut k.fs.xfer, i, 1);
    i = i + 1;
  }
  let mut done = 0;
  let total = to - from;
  while done < total
    invariant done <= total && total <= WPAGES && vec <= 18446744073709551615 - USER_SIZE && kok(k)
  {
    let m = smaller(total - done, XFER);
    if copy_to_user(&mut k.spaces, pid, vec + done, k.fs.xfer, m) != m {
      return EFAULT;
    }
    done = done + m;
  }
  return 0;
}

// ------------------------------------------------ cached file pages

/// Maps the page cache's slot `slot` (src/pcache.bastio) at window page p
/// of process pid, making the level-1 table if need be. False if the
/// process has no window, memory ran out, or p is in use.
fn lx_map_cached(m: &mut Mem, spaces: &mut Vec[Space], pid: u64, p: u64, c: &mut PCache, slot: u64) -> bool
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC && p < WPAGES && pc_ok(c) && slot < PC_N
  ensures mem_ok(m) && spaces_ok(spaces) && pc_ok(c)
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return false; },
    Space::Mapped(mut root) => {
      let mut ok = false;
      if pt_has(root, 1) {
        ok = pt_borrow(&mut root, 1, cached_l3, &mut m, p, &mut c, slot);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return ok;
    },
  }
}

fn cached_l3(l3: &mut PageTable, m: &mut Mem, p: u64, c: &mut PCache, slot: u64) -> bool
  requires pt_level(l3) == 3 && mem_ok(m) && p < WPAGES && pc_ok(c) && slot < PC_N
  ensures mem_ok(m) && pc_ok(c)
{
  if !pt_has(l3, 0) {
    return false;
  }
  return pt_borrow(&mut l3, 0, cached_l2, &mut m, p, &mut c, slot);
}

fn cached_l2(l2: &mut PageTable, m: &mut Mem, p: u64, c: &mut PCache, slot: u64) -> bool
  requires pt_level(l2) == 2 && mem_ok(m) && p < WPAGES && pc_ok(c) && slot < PC_N
  ensures mem_ok(m) && pc_ok(c) && pt_level(l2) == 2
{
  let t = p / 512;
  if !pt_has(l2, t) {
    let a = find_free(&mut m);
    if a >= NPAGES {
      return false;
    }
    pt_put(&mut l2, t, pt_new(take_page(&mut m, a), 1));
  }
  return pt_borrow(&mut l2, t, pc_map_slot, &mut c, slot, p % 512);
}

/// mmap MAP_SHARED of file f from offset off at window pages first ..
/// first + pages: each page is the page cache's page for that part of the
/// file, read in now if no process has it yet. 0, or ENOMEM.
fn lx_map_file_shared(k: &mut Kernel, pid: u64, first: u64, pages: u64, f: u64, off: u64) -> u64
  requires kok(k) && pid < NPROC && first <= WPAGES && pages <= WPAGES - first && off % 4096 == 0
  ensures kok(k)
{
  let mut j = 0;
  while j < pages
    invariant j <= pages && kok(k) && pid < NPROC && first + pages <= WPAGES
  {
    let fpg = off / 4096 + j;
    let mut slot = pc_find(k.fs.pc, f, fpg);
    if slot >= PC_N {
      let mut got = 0;
      if fpg <= 0xFFFFFFFFFFFFF {
        got = vfs_read_at(&mut k.fs, f, fpg * 4096, XFER);
        if got == NO_FD {
          got = 0;
        }
      }
      slot = pc_add(&mut k.fs.pc, &mut k.mem, f, fpg, k.fs.xfer, got);
    }
    if slot >= PC_N || !lx_map_cached(&mut k.mem, &mut k.spaces, pid, first + j, &mut k.fs.pc, slot) {
      return ENOMEM;
    }
    j = j + 1;
  }
  return 0;
}
