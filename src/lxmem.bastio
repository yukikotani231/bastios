// Linux munmap, mprotect and mremap on the window (src/space.bastio).
//
// munmap gives the pages back. mprotect makes them inaccessible, read-only
// or writable (pt_set_access); those bits are the page table's own, so fork
// keeps them (clone_l1), and the kernel neither reads a PROT_NONE page nor
// writes a read-only one for the program (w_read, w_write). A PROT_NONE
// page stays mapped, only hidden, so a MAP_SHARED page keeps being shared. mremap moves pages without copying them: each one
// leaves its old slot and goes to the new one. A stale TLB entry cannot
// outlive any of this: the threads of a process may run on several
// processors at once, so these calls first wait until none of them holds a
// lease on the space (win_quiet), and every entry to user mode reloads CR3.
//
// A fresh private anonymous PROT_NONE mmap maps no pages until mprotect
// makes them usable, so a large reservation costs nothing; touching it
// faults (and a system call given it fails with -EFAULT) as on Linux.
//
// Not done: an mprotect that allows access maps fresh pages into any hole
// munmap left in the mmap area, where Linux fails with -ENOMEM; PROT_EXEC
// is not enforced.

import "linux.bastio";

const PROT_READ: u64 = 1;
const PROT_WRITE: u64 = 2;
const PROT_EXEC: u64 = 4;
const MREMAP_MAYMOVE: u64 = 1;
const MREMAP_FIXED: u64 = 2;
const MREMAP_DONTUNMAP: u64 = 4;

/// Window page p out of l2: its frame goes back to m. Nothing if p is not
/// mapped.
fn w_unmap(m: &mut Mem, l2: &mut PageTable, p: u64)
  requires mem_ok(m) && pt_level(l2) == 2 && p < WPAGES && pt_leases(l2) == 0
  ensures mem_ok(m) && pt_level(l2) == 2 && pt_leases(l2) == 0
{
  let t = p / 512;
  if pt_has(l2, t) {
    let mut l1 = pt_take(&mut l2, t);
    if pt_has(l1, p % 512) && pt_shared(l1, p % 512) {
      drop_shared(&mut m, pt_take_shared(&mut l1, p % 512));
    } else if pt_has(l1, p % 512) {
      give_page(&mut m, pt_take_frame(&mut l1, p % 512));
    }
    pt_put(&mut l2, t, l1);
  }
}

/// Sets what the program may do with window page p, if it is mapped:
/// 0 nothing (PROT_NONE), 1 read, 2 read and write. False if not mapped. A
/// shared page of program text (src/text.bastio) made writable is first
/// replaced by a private copy, so the process cannot write the others'
/// (it stays read-only if there is no page for the copy).
fn w_protect(m: &mut Mem, l2: &mut PageTable, p: u64, a: u64) -> bool
  requires mem_ok(m) && pt_level(l2) == 2 && p < WPAGES && pt_leases(l2) == 0 && a <= 2
  ensures mem_ok(m) && pt_level(l2) == 2 && pt_leases(l2) == 0
{
  let t = p / 512;
  if !pt_has(l2, t) {
    return false;
  }
  let mut l1 = pt_take(&mut l2, t);
  let mut ok = false;
  if pt_has(l1, p % 512) && pt_shared(l1, p % 512) {
    let s = pt_take_shared(&mut l1, p % 512);
    if a == 2 && is_text_page(m, s) {
      let b = find_free(&mut m);
      if b < NPAGES {
        let f = shared_copy(take_dirty(&mut m, b), s);
        drop_shared(&mut m, s);
        pt_put_frame(&mut l1, p % 512, f, true);
      } else {
        pt_put_shared(&mut l1, p % 512, s, false);
      }
    } else {
      pt_put_shared(&mut l1, p % 512, s, a == 2);
      pt_set_access(&mut l1, p % 512, a);
    }
    ok = true;
  } else if pt_has(l1, p % 512) {
    pt_set_access(&mut l1, p % 512, a);
    ok = true;
  }
  pt_put(&mut l2, t, l1);
  return ok;
}

/// Fills window page p with zeros if it is a private page, keeping its
/// permission; a shared page (MAP_SHARED) keeps what it holds. False if p
/// is not mapped.
fn w_zero(l2: &mut PageTable, p: u64) -> bool
  requires pt_level(l2) == 2 && p < WPAGES && pt_leases(l2) == 0
  ensures pt_level(l2) == 2 && pt_leases(l2) == 0
{
  let t = p / 512;
  if !pt_has(l2, t) {
    return false;
  }
  let mut l1 = pt_take(&mut l2, t);
  let mut ok = false;
  if pt_has(l1, p % 512) {
    ok = true;
    if !pt_shared(l1, p % 512) {
      let w = pt_writable(l1, p % 512);
      let mut f = pt_take_frame(&mut l1, p % 512);
      let mut i = 0;
      while i < 512
        invariant i <= 512
      {
        frame_write(&mut f, i, 0);
        i = i + 1;
      }
      pt_put_frame(&mut l1, p % 512, f, w);
    }
  }
  pt_put(&mut l2, t, l1);
  return ok;
}

/// Moves the page at window page `from` to window page `to`, keeping its
/// permission; whatever was at `to` goes back to m first. A `from` with no
/// page leaves `to` empty. False if a level-1 table for `to` could not be
/// made.
fn w_move(m: &mut Mem, l2: &mut PageTable, from: u64, to: u64) -> bool
  requires mem_ok(m) && pt_level(l2) == 2 && from < WPAGES && to < WPAGES && pt_leases(l2) == 0
  ensures mem_ok(m) && pt_level(l2) == 2 && pt_leases(l2) == 0
{
  w_unmap(&mut m, &mut l2, to);
  let tf = from / 512;
  if !pt_has(l2, tf) {
    return true;
  }
  let tt = to / 512;
  if !pt_has(l2, tt) {
    let a = find_free(&mut m);
    if a >= NPAGES {
      return false;
    }
    pt_put(&mut l2, tt, pt_new(take_page(&mut m, a), 1));
  }
  let mut src = pt_take(&mut l2, tf);
  if !pt_has(src, from % 512) {
    pt_put(&mut l2, tf, src);
    return true;
  }
  let w = pt_writable(src, from % 512);
  let hidden = !pt_accessible(src, from % 512);    // PROT_NONE stays so
  if pt_shared(src, from % 512) {
    let s = pt_take_shared(&mut src, from % 512);
    pt_put(&mut l2, tf, src);
    let mut dst = pt_take(&mut l2, tt);
    if pt_has(dst, to % 512) {
      drop_shared(&mut m, s);                     // cannot happen: `to` was emptied
    } else {
      pt_put_shared(&mut dst, to % 512, s, w);
      if hidden {
        pt_set_access(&mut dst, to % 512, 0);
      }
    }
    pt_put(&mut l2, tt, dst);
    return true;
  }
  let f = pt_take_frame(&mut src, from % 512);
  if tf == tt {
    if pt_has(src, to % 512) {
      pt_put_frame(&mut src, from % 512, f, w);   // cannot happen: `to` was emptied
    } else {
      pt_put_frame(&mut src, to % 512, f, w);
      if hidden {
        pt_set_access(&mut src, to % 512, 0);
      }
    }
    pt_put(&mut l2, tf, src);
    return true;
  }
  pt_put(&mut l2, tf, src);
  let mut dst = pt_take(&mut l2, tt);
  if pt_has(dst, to % 512) {
    give_page(&mut m, f);                         // cannot happen: `to` was emptied
  } else {
    pt_put_frame(&mut dst, to % 512, f, w);
    if hidden {
      pt_set_access(&mut dst, to % 512, 0);
    }
  }
  pt_put(&mut l2, tt, dst);
  return true;
}

/// Whether no processor runs process pid's space now, so its mappings may
/// shrink or lose permissions (win_op). If one does, pid is marked F_QUIET:
/// the other threads of its group are not picked again (group_free) until
/// pid's retried call finds the space free and clears the mark.
fn win_quiet(k: &mut Kernel, pid: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut free = true;
  match take_space(&mut k.spaces, pid) {
    Space::Empty => {},
    Space::Mapped(mut root) => {
      free = pt_lease_count(&mut root) == 0;
      put_space(&mut k.spaces, pid, Space::Mapped(root));
    },
  }
  if free {
    pset(&mut k.procs, pid, F_QUIET, 0);
  } else {
    pset(&mut k.procs, pid, F_QUIET, 1);
  }
  return free;
}

/// Does `op` to window pages from .. to of process pid: unmap them,
/// protect them (arg: what w_protect takes), move them to arg ..., zero
/// the private ones, or only count them. Returns how many
/// of them were mapped, or WPAGES + 1 if the process has no window, a move
/// ran out of memory, or a processor runs the space (win_quiet says first).
fn win_op(m: &mut Mem, spaces: &mut Vec[Space], pid: u64, op: u64, from: u64, to: u64, arg: u64) -> u64
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC && from <= to && to <= WPAGES
  requires op == WOP_MOVE ==> arg + (to - from) <= WPAGES
  ensures mem_ok(m) && spaces_ok(spaces)
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return WPAGES + 1; },
    Space::Mapped(mut root) => {
      let mut r = WPAGES + 1;
      if pt_lease_count(&mut root) == 0 && pt_has(root, 1) {
        let mut l3 = pt_take(&mut root, 1);
        if pt_has(l3, 0) {
          let mut l2 = pt_take(&mut l3, 0);
          r = 0;
          let mut i = 0;
          let n = to - from;
          // A move to higher pages goes from the top, so a page is never
          // moved onto one not moved yet.
          let up = op == WOP_MOVE && arg > from;
          while i < n
            invariant i <= n && n == to - from && from <= to && to <= WPAGES && mem_ok(m) && pt_level(l2) == 2 && pt_leases(l2) == 0
            invariant op == WOP_MOVE ==> arg + n <= WPAGES
            invariant r <= WPAGES + 1
          {
            let mut j = i;
            if up {
              j = n - 1 - i;
            }
            let p = from + j;
            if op == WOP_UNMAP {
              if w_has(&mut l2, p) && r < WPAGES {
                r = r + 1;
              }
              w_unmap(&mut m, &mut l2, p);
            } else if op == WOP_COUNT {
              if w_has(&mut l2, p) && r < WPAGES {
                r = r + 1;
              }
            } else if op == WOP_ZERO {
              if w_zero(&mut l2, p) && r < WPAGES {
                r = r + 1;
              }
            } else if op == WOP_PROTECT {
              if arg <= 2 && w_protect(&mut m, &mut l2, p, arg) && r < WPAGES {
                r = r + 1;
              }
            } else if op == WOP_MOVE && r <= WPAGES {
              if !w_move(&mut m, &mut l2, p, arg + j) {
                r = WPAGES + 1;
              }
            }
            i = i + 1;
          }
          pt_put(&mut l3, 0, l2);
        }
        pt_put(&mut root, 1, l3);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return r;
    },
  }
}

/// The window pages addr .. addr + n cover, as first * 2^32 + end; or
/// 2^64 - 1 if addr is not page aligned, n is 0, or the range leaves the
/// part of the window below the stack.
fn win_range(addr: u64, n: u64) -> u64
  ensures result != 18446744073709551615 ==> (result / 4294967296 < result % 4294967296 && result % 4294967296 <= STACK_FIRST)
{
  if addr % 4096 != 0 || addr < USER_BASE || n == 0 || n > USER_SIZE {
    return 18446744073709551615;
  }
  let first = (addr - USER_BASE) / 4096;
  let pages = (n + 4095) / 4096;
  if first >= STACK_FIRST || pages > STACK_FIRST - first {
    return 18446744073709551615;
  }
  return first * 4294967296 + first + pages;
}

// Holes: munmap gives back address space as well as pages. Each process
// records up to HOLE_N ranges of window pages it unmapped in its mmap area
// in k.holes (first page, end page; end 0 if the slot is free), and mmap
// takes the first one large enough before going lower. Without this, a
// program that maps and unmaps as it runs (musl's malloc does for every
// large block) uses up the window even though little is mapped at once.
// A range always leaves the list before it is used again (mmap,
// MAP_FIXED, mprotect), so no page is handed out twice; a range that
// finds no free slot is only address space lost, as before.

/// Where word f of hole slot i of process p is in k.holes.
fn hl_at(p: u64, i: u64, f: u64) -> u64
  requires p < NPROC && i < HOLE_N && f < 2
  ensures result < HOLES_LEN
{
  return (p * HOLE_N + i) * 2 + f;
}

/// Records pages first .. end as a hole of process pid in a free slot, if
/// there is one.
fn hole_put(k: &mut Kernel, pid: u64, first: u64, end: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if first >= end {
    return;
  }
  let mut i = 0;
  while i < HOLE_N
    invariant i <= HOLE_N && kok(k) && pid < NPROC
  {
    if get(k.holes, hl_at(pid, i, 1)) == 0 {
      k.holes = set(k.holes, hl_at(pid, i, 0), first);
      k.holes = set(k.holes, hl_at(pid, i, 1), end);
      return;
    }
    i = i + 1;
  }
}

/// Takes pages first .. end out of process pid's holes.
fn hole_cut(k: &mut Kernel, pid: u64, first: u64, end: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut i = 0;
  while i < HOLE_N
    invariant i <= HOLE_N && kok(k) && pid < NPROC
  {
    let a = get(k.holes, hl_at(pid, i, 0));
    let b = get(k.holes, hl_at(pid, i, 1));
    if b != 0 && a < end && first < b {
      if first <= a && b <= end {
        k.holes = set(k.holes, hl_at(pid, i, 1), 0);         // all of it
      } else if first <= a {
        k.holes = set(k.holes, hl_at(pid, i, 0), end);       // its low part
      } else if b <= end {
        k.holes = set(k.holes, hl_at(pid, i, 1), first);     // its high part
      } else {
        k.holes = set(k.holes, hl_at(pid, i, 1), first);     // its middle: two holes
        hole_put(&mut k, pid, end, b);
      }
    }
    i = i + 1;
  }
}

/// munmap (or mremap) left pages first .. end of process pid unmapped:
/// they become a hole, merged with the holes next to them.
fn hole_add(k: &mut Kernel, pid: u64, first: u64, end: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if first >= end {
    return;
  }
  hole_cut(&mut k, pid, first, end);
  let mut f = first;
  let mut e = end;
  let mut pass = 0;
  while pass < 2
    invariant pass <= 2 && kok(k) && pid < NPROC
  {
    let mut i = 0;
    while i < HOLE_N
      invariant i <= HOLE_N && kok(k) && pid < NPROC
    {
      let a = get(k.holes, hl_at(pid, i, 0));
      let b = get(k.holes, hl_at(pid, i, 1));
      if b != 0 && (b == f || a == e) {
        if a < f {
          f = a;
        }
        if b > e {
          e = b;
        }
        k.holes = set(k.holes, hl_at(pid, i, 1), 0);
      }
      i = i + 1;
    }
    pass = pass + 1;
  }
  // A hole at the bottom of the mmap area is free space below it again.
  if e <= STACK_FIRST && f < e && f * 4096 == pget(k.procs, pid, F_MMAP) {
    pset(&mut k.procs, pid, F_MMAP, e * 4096);
    return;
  }
  hole_put(&mut k, pid, f, e);
}

/// Window pages first .. end of process pid were just mapped where the
/// program asked (MAP_FIXED, shmat at an address, MREMAP_FIXED). mmap
/// without an address must never hand them out again: they stop being a
/// hole, and if they start in the free space between the break and the
/// mmap area, the mmap area starts at them from now on, and what was free
/// above them becomes a hole. Without that, mmap(NULL) or brk took pages
/// such a mapping held, and munmap of those unmapped it.
fn fixed_taken(k: &mut Kernel, pid: u64, first: u64, end: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  hole_cut(&mut k, pid, first, end);
  let low = pget(k.procs, pid, F_MMAP) / 4096;
  let b = pget(k.procs, pid, F_BRK);
  if b <= USER_SIZE && (b + 4095) / 4096 <= first && first < low && low <= STACK_FIRST {
    pset(&mut k.procs, pid, F_MMAP, first * 4096);
    if end < low {
      hole_add(&mut k, pid, end, low);
    }
  }
}

/// Takes `pages` pages from the first hole of process pid that has them
/// and returns where they start; STACK_FIRST if no hole does.
fn hole_take(k: &mut Kernel, pid: u64, pages: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result < STACK_FIRST ==> pages <= STACK_FIRST - result
{
  let mut i = 0;
  while i < HOLE_N
    invariant i <= HOLE_N && kok(k) && pid < NPROC
  {
    let a = get(k.holes, hl_at(pid, i, 0));
    let b = get(k.holes, hl_at(pid, i, 1));
    if b != 0 && a < b && b <= STACK_FIRST && pages > 0 && pages <= b - a {
      if pages == b - a {
        k.holes = set(k.holes, hl_at(pid, i, 1), 0);
      } else {
        k.holes = set(k.holes, hl_at(pid, i, 0), a + pages);
      }
      return a;
    }
    i = i + 1;
  }
  return STACK_FIRST;
}

/// Process pid starts with no holes (a new program, process or thread).
fn hole_clear(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut i = 0;
  while i < HOLE_N
    invariant i <= HOLE_N && kok(k) && pid < NPROC
  {
    k.holes = set(k.holes, hl_at(pid, i, 1), 0);
    i = i + 1;
  }
}

/// fork: the child's window is a copy, so are its holes.
fn hole_fork(k: &mut Kernel, pid: u64, c: u64)
  requires kok(k) && pid < NPROC && c < NPROC
  ensures kok(k)
{
  let mut i = 0;
  while i < HOLE_N
    invariant i <= HOLE_N && kok(k) && pid < NPROC && c < NPROC
  {
    k.holes = set(k.holes, hl_at(c, i, 0), get(k.holes, hl_at(pid, i, 0)));
    k.holes = set(k.holes, hl_at(c, i, 1), get(k.holes, hl_at(pid, i, 1)));
    i = i + 1;
  }
}

/// munmap(addr, n).
fn lx_munmap(k: &mut Kernel, pid: u64, addr: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r = win_range(addr, n);
  if r == 18446744073709551615 {
    return EINVAL;
  }
  if map_forget(&mut k, pid, r / 4294967296, r % 4294967296, true) == DISK_RETRY {
    return DISK_RETRY;                      // nothing unmapped yet: the call starts again
  }
  let from = r / 4294967296;
  let to = r % 4294967296;
  if win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, from, to, 0) <= WPAGES && from >= pget(k.procs, pid, F_MMAP) / 4096 {
    hole_add(&mut k, pid, from, to);        // address space mmap can use again
  }
  return 0;
}

/// What w_protect gives a page for `prot`: 2 with PROT_WRITE, else 1 with
/// PROT_READ or PROT_EXEC (an x86 page that can run can be read), else 0.
fn prot_access(prot: u64) -> u64
  ensures result <= 2
{
  if prot / PROT_WRITE % 2 == 1 {
    return 2;
  }
  if prot / PROT_READ % 2 == 1 || prot / PROT_EXEC % 2 == 1 {
    return 1;
  }
  return 0;
}

/// mprotect(addr, n, prot): writable with PROT_WRITE, read-only with only
/// PROT_READ or PROT_EXEC, inaccessible with neither; -EACCES for
/// PROT_WRITE on a shared mapping of a file opened read-only.
/// Pages of a PROT_NONE mmap that were never mapped (lx_mmap) get fresh
/// zero pages when prot allows access. -ENOMEM if a page in the range is
/// not mapped (the others still change, where Linux would change none).
fn lx_mprotect(k: &mut Kernel, pid: u64, addr: u64, n: u64, prot: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if addr % 4096 != 0 {
    return EINVAL;
  }
  if n == 0 {
    return 0;
  }
  let r = win_range(addr, n);
  if r == 18446744073709551615 {
    return ENOMEM;                          // not memory the process has
  }
  let a = prot_access(prot);
  let from = r / 4294967296;
  let to = r % 4294967296;
  // As on Linux: a MAP_SHARED mapping of a file opened without write
  // permission does not become writable (lx_mmap refuses it at mmap).
  if a == 2 && map_no_write(k, pid, from, to) {
    return EACCES;
  }
  lazy_fill(&mut k, pid, from, to);         // code not read yet: read it first
  // Only pages mmap handed out can have been left unmapped by PROT_NONE.
  let low = pget(k.procs, pid, F_MMAP) / 4096;
  if prot != 0 && from >= low {
    if !lx_map_pages(&mut k.mem, &mut k.spaces, pid, from, to, false) {
      return ENOMEM;
    }
    hole_cut(&mut k, pid, from, to);        // mapped now: not a hole to hand out
  }
  // PROT_NONE leaves mmap's reserved pages unmapped, so they do not count.
  let got = win_op(&mut k.mem, &mut k.spaces, pid, WOP_PROTECT, from, to, a);
  if got > to - from || (got != to - from && (a != 0 || from < low)) {
    return ENOMEM;
  }
  return 0;
}

/// mremap(addr, oldn, newn, flags): shrinking unmaps the tail; growing
/// (with MREMAP_MAYMOVE) moves the pages down into free space if the
/// mapping is the lowest, else to a hole or below the lowest mmap; the
/// rest are fresh zero pages. Growing at the same address is not tried:
/// without MREMAP_MAYMOVE it is -ENOMEM. MREMAP_FIXED moves the pages to
/// the address the caller chooses (remap_fixed).
fn lx_mremap(k: &mut Kernel, pid: u64, addr: u64, oldn: u64, newn: u64, flags: u64, to_addr: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r = win_range(addr, oldn);
  if addr % 4096 != 0 || oldn > USER_SIZE || newn == 0 || newn > USER_SIZE {
    return EINVAL;
  }
  let fl = flags % 0x100000000;
  // MREMAP_MAYMOVE, MREMAP_FIXED and MREMAP_DONTUNMAP; the last two only
  // with the first.
  if fl > 7 || (fl > 1 && fl % 2 == 0) {
    return EINVAL;
  }
  if r == 18446744073709551615 {
    return EFAULT;                          // not all in the mappable part of the window
  }
  // No mapping at addr (Linux finds no VMA there): EFAULT.
  let f0 = r / 4294967296;
  let e0 = r % 4294967296;
  if win_op(&mut k.mem, &mut k.spaces, pid, WOP_COUNT, f0, e0, 0) != e0 - f0 {
    return EFAULT;
  }
  if fl / MREMAP_FIXED % 2 == 1 {
    if to_addr % 4096 != 0 || to_addr < USER_BASE || to_addr - USER_BASE > USER_SIZE - newn
      || oldn > USER_SIZE || addr < USER_BASE || addr - USER_BASE > USER_SIZE - oldn {
      return EINVAL;                        // unaligned, or outside the user space
    }
    if to_addr < addr + oldn && addr < to_addr + newn {
      return EINVAL;                        // over the old pages
    }
    return remap_fixed(&mut k, pid, r, newn, to_addr);
  }
  if fl / MREMAP_DONTUNMAP % 2 == 1 {
    return EINVAL;                          // not supported
  }
  let from = r / 4294967296;
  let oend = r % 4294967296;
  let have = oend - from;
  let want = (newn + 4095) / 4096;
  // A shared file mapping is written back and stops being shared where
  // pages leave (the tail) or move (all of them).
  if want <= have {
    map_forget(&mut k, pid, from + want, oend, false);
    if win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, from + want, oend, 0) <= WPAGES && from + want >= pget(k.procs, pid, F_MMAP) / 4096 {
      hole_add(&mut k, pid, from + want, oend);
    }
    return addr;
  }
  if flags / MREMAP_MAYMOVE % 2 == 0 {
    return ENOMEM;
  }
  let brk = pget(k.procs, pid, F_BRK);
  let low = pget(k.procs, pid, F_MMAP);
  let extra = want - have;
  // The lowest mapping grows down into the free space below it: its pages
  // move down by `extra` and fresh ones follow them, so a buffer that
  // keeps doubling there (realloc of a big block) takes no more address
  // space than its size.
  if from * 4096 == low && low <= STACK_FIRST * 4096 && brk <= low && extra * 4096 <= low - brk && extra <= from {
    let at = from - extra;
    map_forget(&mut k, pid, from, oend, false);
    if win_op(&mut k.mem, &mut k.spaces, pid, WOP_MOVE, from, oend, at) > WPAGES {
      return ENOMEM;
    }
    pset(&mut k.procs, pid, F_MMAP, at * 4096);
    if !lx_map_pages(&mut k.mem, &mut k.spaces, pid, at + have, oend, false) {
      // Out of memory: the pages go back where they were.
      win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, at + have, oend, 0);
      if win_op(&mut k.mem, &mut k.spaces, pid, WOP_MOVE, at, at + have, from) <= WPAGES {
        pset(&mut k.procs, pid, F_MMAP, low);
      }
      return ENOMEM;
    }
    return USER_BASE + at * 4096;
  }
  // Elsewhere it moves: to a hole munmap or an earlier move left if one
  // is large enough, as mmap does, else below the lowest mapping.
  let mut at = hole_take(&mut k, pid, want);
  let fresh = at >= STACK_FIRST;
  if fresh {
    if low > STACK_FIRST * 4096 || brk > low || want * 4096 > low - brk {
      return ENOMEM;
    }
    at = (low - want * 4096) / 4096;
    if at * 4096 < brk || at + want > STACK_FIRST {
      return ENOMEM;
    }
  }
  // Fresh pages for the new tail first, so running out of memory leaves
  // the addr mapping as it was.
  if !lx_map_pages(&mut k.mem, &mut k.spaces, pid, at + have, at + want, false) {
    win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, at + have, at + want, 0);
    if !fresh {
      hole_add(&mut k, pid, at, at + want);
    }
    return ENOMEM;
  }
  map_forget(&mut k, pid, from, oend, false);
  if win_op(&mut k.mem, &mut k.spaces, pid, WOP_MOVE, from, oend, at) > WPAGES {
    return ENOMEM;
  }
  if fresh {
    pset(&mut k.procs, pid, F_MMAP, at * 4096);
  }
  if from >= low / 4096 {
    hole_add(&mut k, pid, from, oend);      // where the pages were
  }
  return USER_BASE + at * 4096;
}

/// mremap with MREMAP_FIXED: the pages of window range r (as win_range
/// gives it) move to to_addr, unmapping what was there; past the old
/// size, the rest are fresh zero pages. to_addr .. to_addr + newn is in
/// the user space and does not overlap the old range.
fn remap_fixed(k: &mut Kernel, pid: u64, r: u64, newn: u64, to_addr: u64) -> u64
  requires kok(k) && pid < NPROC && to_addr >= USER_BASE && newn <= USER_SIZE && to_addr - USER_BASE <= USER_SIZE - newn
  ensures kok(k)
{
  let from = r / 4294967296;
  let oend = r % 4294967296;
  if oend < from || oend > WPAGES {
    return EINVAL;
  }
  let have = oend - from;
  let want = (newn + 4095) / 4096;
  let at = (to_addr - USER_BASE) / 4096;
  if at + want > WPAGES {
    return ENOMEM;
  }
  map_forget(&mut k, pid, at, at + want, false);
  win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, at, at + want, 0);
  let mut keep = have;
  if want < have {
    keep = want;
    map_forget(&mut k, pid, from + want, oend, false);
    win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, from + want, oend, 0);
  } else if want > have {
    if !lx_map_pages(&mut k.mem, &mut k.spaces, pid, at + have, at + want, false) {
      win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, at + have, at + want, 0);
      return ENOMEM;
    }
  }
  map_forget(&mut k, pid, from, from + keep, false);
  if win_op(&mut k.mem, &mut k.spaces, pid, WOP_MOVE, from, from + keep, at) > WPAGES {
    return ENOMEM;
  }
  fixed_taken(&mut k, pid, at, at + want);
  return to_addr;
}

// ------------------------------------------------- shared file mappings
//
// A MAP_SHARED mapping of a file maps the page cache's pages
// (src/pcache.bastio, lx_map_file_shared below), so every process that
// maps the file shares them, and it is recorded, so msync and munmap write
// the pages back, and exit and execve do too. Each process has MAP_N
// records in k.maps: the first window page + 1 (0: free), the page count,
// the open file description (which the record holds a reference on, so the
// file stays open after close, and so its cached pages stay), and the file
// offset of the first page.
//
// Not done: a mapping beyond MAP_N is never written back, and its file can
// be closed under it (it keeps its pages, but they leave the cache); a row
// opened O_APPEND is not written back; the write-back at exit and
// execve gives up on blocks the disk has not cached.

const LX_MSYNC: u64 = 26;

/// Where word f of record i of process p is in k.maps.
fn mp_at(p: u64, i: u64, f: u64) -> u64
  requires p < NPROC && i < MAP_N && f < MAP_W
  ensures result < MAPS_LEN
{
  return (p * MAP_N + i) * MAP_W + f;
}

/// Whether a shared mapping recorded for process pid in window pages
/// from .. to comes from a description that may not write (a file or
/// /dev/zero opened read-only): it may never be made writable, as on
/// Linux, where such a mapping lacks VM_MAYWRITE.
fn map_no_write(k: &Kernel, pid: u64, from: u64, to: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let mut i = 0;
  while i < MAP_N
    invariant i <= MAP_N
  {
    let first1 = get(k.maps, mp_at(pid, i, 0));
    let h = get(k.maps, mp_at(pid, i, 2));
    let len = get(k.maps, mp_at(pid, i, 1));
    if first1 != 0 && h < OFD_N && first1 - 1 < to && (from < first1 - 1 || from - (first1 - 1) < len) {
      let kind = of_get(k.ofd, h, 0);
      let row = of_get(k.ofd, h, 2);
      if kind == OF_DEV && ofd_lacks(k, h, ACC_NOWRITE) {
        return true;
      }
      if kind == OF_FILE && row < FD_ROWS && fget(k.fs.ftab, row, FD_MODE) / O_WRITE % 2 == 0 {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

/// Records window pages first .. first + pages of process pid as a shared
/// mapping of the file open as fd, from offset off. Nothing if fd names
/// no file or every record is in use (the mapping is then never written
/// back).
fn map_record(k: &mut Kernel, pid: u64, fd: u64, first: u64, pages: u64, off: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N || (of_get(k.ofd, h, 0) != OF_FILE && of_get(k.ofd, h, 0) != OF_DEV) || first >= WPAGES {
    return;
  }
  let mut i = 0;
  while i < MAP_N && get(k.maps, mp_at(pid, i, 0)) != 0
    invariant i <= MAP_N && kok(k)
  {
    i = i + 1;
  }
  if i >= MAP_N {
    return;
  }
  of_set(&mut k.ofd, h, 1, sat_add(of_get(k.ofd, h, 1), 1));
  k.maps = set(k.maps, mp_at(pid, i, 0), first + 1);
  k.maps = set(k.maps, mp_at(pid, i, 1), pages);
  k.maps = set(k.maps, mp_at(pid, i, 2), h);
  k.maps = set(k.maps, mp_at(pid, i, 3), off);
}

/// Writes the pages of record i of process pid that lie in window pages
/// from .. to back to its file, up to the file's end. 0, or DISK_RETRY if
/// the disk has not cached blocks it needs (the pages before are queued;
/// writing them again is harmless).
fn map_flush(k: &mut Kernel, pid: u64, i: u64, from: u64, to: u64) -> u64
  requires kok(k) && pid < NPROC && i < MAP_N
  ensures kok(k)
{
  let first1 = get(k.maps, mp_at(pid, i, 0));
  let h = get(k.maps, mp_at(pid, i, 2));
  if first1 == 0 || h >= OFD_N || of_get(k.ofd, h, 0) != OF_FILE {
    return 0;
  }
  let row = of_get(k.ofd, h, 2);
  if row >= FD_ROWS || fget(k.fs.ftab, row, FD_MODE) / O_WRITE % 2 == 0 || fget(k.fs.ftab, row, FD_MODE) / O_APPEND % 2 == 1 {
    return 0;
  }
  let size = vfs_size(&mut k.fs, row_file(k.fs, row));
  if size == NO_FILE {
    return 0;
  }
  let first = first1 - 1;
  let end = sat_add(first, get(k.maps, mp_at(pid, i, 1)));
  let off = get(k.maps, mp_at(pid, i, 3));
  let last = smaller(smaller(end, to), WPAGES);
  let mut p = first;
  if p < from {
    p = from;
  }
  if p > last || first > last {
    return 0;                               // nothing of it in the range
  }
  let was = vfs_offset(k.fs, row);
  let mut r = 0;
  while p < last && r == 0
    invariant p <= last && last <= WPAGES && first <= p && kok(k) && row < FD_ROWS
  {
    let foff = sat_add(off, (p - first) * 4096);
    if foff < size {
      let n = smaller(4096, size - foff);
      if copy_from_user(&mut k.spaces, pid, USER_BASE + p * 4096, &mut k.fs.xfer, n) == n {
        vfs_seek(&mut k.fs, row, foff);
        if vfs_write(&mut k.fs, &mut k.mem, row, n) == VFS_MISS {
          r = DISK_RETRY;
        }
      }
    }
    p = p + 1;
  }
  vfs_seek(&mut k.fs, row, was);
  return r;
}

/// Drops record i of process pid and its reference on the file.
fn map_drop(k: &mut Kernel, pid: u64, i: u64)
  requires kok(k) && pid < NPROC && i < MAP_N
  ensures kok(k)
{
  let first1 = get(k.maps, mp_at(pid, i, 0));
  let h = get(k.maps, mp_at(pid, i, 2));
  k.maps = set(k.maps, mp_at(pid, i, 0), 0);
  if first1 != 0 && h < OFD_N {
    unref_value(&mut k, FD_OFD + h);
  }
}

/// Window pages from .. to of process pid are going away (munmap, a
/// MAP_FIXED mapping over them, mremap moving them): writes them back,
/// then forgets them. With `wait`, a disk miss returns DISK_RETRY before
/// anything is forgotten, so the call can start again; without, the
/// write-back is best effort.
fn map_forget(k: &mut Kernel, pid: u64, from: u64, to: u64, wait: bool) -> u64
  requires kok(k) && pid < NPROC && from <= to && to <= WPAGES
  ensures kok(k)
{
  let mut i = 0;
  while i < MAP_N
    invariant i <= MAP_N && kok(k)
  {
    if map_flush(&mut k, pid, i, from, to) == DISK_RETRY && wait {
      return DISK_RETRY;
    }
    i = i + 1;
  }
  i = 0;
  while i < MAP_N
    invariant i <= MAP_N && kok(k)
  {
    let first1 = get(k.maps, mp_at(pid, i, 0));
    let pages = get(k.maps, mp_at(pid, i, 1));
    if first1 != 0 {
      let first = first1 - 1;
      let end = sat_add(first, pages);
      if from <= first && end <= to {
        map_drop(&mut k, pid, i);                     // all of it
      } else if from <= first && first < to {
        // The head goes: the record starts at `to`.
        k.maps = set(k.maps, mp_at(pid, i, 0), to + 1);
        k.maps = set(k.maps, mp_at(pid, i, 1), end - to);
        k.maps = set(k.maps, mp_at(pid, i, 3), sat_add(get(k.maps, mp_at(pid, i, 3)), (to - first) * 4096));
      } else if first < from && from < end && end <= to {
        k.maps = set(k.maps, mp_at(pid, i, 1), from - first);   // the tail goes
      } else if first < from && to < end {
        // A hole in the middle: one record cannot say that, and a page
        // mapped there later must never reach the file. The rest was
        // written back above; it is no longer shared.
        map_drop(&mut k, pid, i);
      }
    }
    i = i + 1;
  }
  lazy_forget(&mut k, pid, from, to);       // code not read yet stays unread
  return 0;
}

/// Exit or execve: writes back and drops every record of process pid,
/// while its old address space is still there.
fn map_drop_all(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  map_forget(&mut k, pid, 0, WPAGES, false);
}

/// fork: the child gets the parent's records, each with a reference of
/// its own on the file.
fn map_fork(k: &mut Kernel, pid: u64, c: u64)
  requires kok(k) && pid < NPROC && c < NPROC
  ensures kok(k)
{
  let mut i = 0;
  while i < MAP_N
    invariant i <= MAP_N && kok(k)
  {
    let first1 = get(k.maps, mp_at(pid, i, 0));
    let h = get(k.maps, mp_at(pid, i, 2));
    if first1 != 0 && h < OFD_N {
      of_set(&mut k.ofd, h, 1, sat_add(of_get(k.ofd, h, 1), 1));
      k.maps = set(k.maps, mp_at(c, i, 0), first1);
    } else {
      k.maps = set(k.maps, mp_at(c, i, 0), 0);
    }
    k.maps = set(k.maps, mp_at(c, i, 1), get(k.maps, mp_at(pid, i, 1)));
    k.maps = set(k.maps, mp_at(c, i, 2), h);
    k.maps = set(k.maps, mp_at(c, i, 3), get(k.maps, mp_at(pid, i, 3)));
    i = i + 1;
  }
}

/// msync(addr, n, flags): writes the shared file pages in the range back.
/// -EINVAL for an unknown flag, a misaligned addr or MS_ASYNC with
/// MS_SYNC; -ENOMEM if part of the range is not mapped (after the rest is
/// written back), as on Linux.
fn lx_msync(k: &mut Kernel, pid: u64, addr: u64, n: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  // MS_ASYNC 1, MS_INVALIDATE 2, MS_SYNC 4
  if flags & !7 != 0 || addr % 4096 != 0 || flags & 1 != 0 && flags & 4 != 0 {
    return EINVAL;
  }
  if n == 0 {
    return 0;
  }
  let r = win_range(addr, n);
  if r == 18446744073709551615 {
    return ENOMEM;
  }
  let mut i = 0;
  while i < MAP_N
    invariant i <= MAP_N && kok(k)
  {
    if map_flush(&mut k, pid, i, r / 4294967296, r % 4294967296) == DISK_RETRY {
      return DISK_RETRY;
    }
    i = i + 1;
  }
  let from = r / 4294967296;
  let to = r % 4294967296;
  if win_op(&mut k.mem, &mut k.spaces, pid, WOP_COUNT, from, to, 0) != to - from {
    return ENOMEM;
  }
  return 0;
}

/// mincore(addr, n, vec): one byte per page, 1 for each (every mapped page
/// is resident). -EINVAL for a misaligned addr, -ENOMEM if a page in the
/// range is not mapped, -EFAULT if vec is not writable.
fn lx_mincore(k: &mut Kernel, pid: u64, addr: u64, n: u64, vec: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if addr % 4096 != 0 {
    return EINVAL;
  }
  if addr < USER_BASE || n > USER_SIZE || addr - USER_BASE > USER_SIZE - n {
    return ENOMEM;
  }
  if vec > 18446744073709551615 - USER_SIZE {
    return EFAULT;
  }
  let from = (addr - USER_BASE) / 4096;
  let to = smaller((addr - USER_BASE + n + 4095) / 4096, WPAGES);
  if from > to || win_op(&mut k.mem, &mut k.spaces, pid, WOP_COUNT, from, to, 0) != to - from {
    return ENOMEM;
  }
  let mut i = 0;
  while i < XFER
    invariant i <= XFER && kok(k)
  {
    bset(&mut k.fs.xfer, i, 1);
    i = i + 1;
  }
  let mut done = 0;
  let total = to - from;
  while done < total
    invariant done <= total && total <= WPAGES && vec <= 18446744073709551615 - USER_SIZE && kok(k)
  {
    let m = smaller(total - done, XFER);
    if copy_to_user(&mut k.spaces, pid, vec + done, k.fs.xfer, m) != m {
      return EFAULT;
    }
    done = done + m;
  }
  return 0;
}

const MADV_DONTNEED: u64 = 4;
const MADV_FREE: u64 = 8;
const MADV_REMOVE: u64 = 9;
const MADV_WIPEONFORK: u64 = 18;
const MADV_KEEPONFORK: u64 = 19;

/// Whether window page p of process pid belongs to a MAP_SHARED file
/// mapping (a record of k.maps).
fn map_covers(k: &Kernel, pid: u64, p: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let mut i = 0;
  while i < MAP_N
    invariant i <= MAP_N
  {
    let first1 = get(k.maps, mp_at(pid, i, 0));
    if first1 != 0 && first1 - 1 <= p && p - (first1 - 1) < get(k.maps, mp_at(pid, i, 1)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// madvise(addr, n, advice). Every page stays in memory, so most advice
/// changes nothing. MADV_DONTNEED drops what the private pages hold: they
/// read as zeros afterwards, as fresh anonymous pages do on Linux. (A
/// private file mapping reads zeros too, where Linux reads the file
/// again.) -EINVAL for a misaligned addr, advice there is not, or advice
/// that needs what this kernel lacks (KSM, huge pages, memory-failure
/// handling, hole punching for MADV_REMOVE, MADV_WIPEONFORK), and for
/// MADV_FREE on a shared mapping. -ENOMEM if a page in the range is not
/// mapped.
fn lx_madvise(k: &mut Kernel, pid: u64, addr: u64, n: u64, advice: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if addr % 4096 != 0 || n >= 0x8000000000000000 {
    return EINVAL;
  }
  // NORMAL, RANDOM, SEQUENTIAL, WILLNEED, DONTNEED; FREE, REMOVE,
  // DONTFORK, DOFORK; DONTDUMP, DODUMP, WIPEONFORK, KEEPONFORK, COLD,
  // PAGEOUT, POPULATE_READ, POPULATE_WRITE.
  if advice > 23 || (advice > 4 && advice < 8) || (advice > 11 && advice < 16) {
    return EINVAL;
  }
  if n == 0 {
    return 0;
  }
  if addr < USER_BASE || n > USER_SIZE || addr - USER_BASE > USER_SIZE - n {
    return ENOMEM;
  }
  let from = (addr - USER_BASE) / 4096;
  let to = smaller((addr - USER_BASE + n + 4095) / 4096, WPAGES);
  if from > to || win_op(&mut k.mem, &mut k.spaces, pid, WOP_COUNT, from, to, 0) != to - from {
    return ENOMEM;
  }
  if advice == MADV_REMOVE || advice == MADV_WIPEONFORK {
    return EINVAL;                          // not supported: no hole punching; a child would see the pages
  }
  if advice == MADV_FREE || advice == MADV_KEEPONFORK {
    // Only for private anonymous memory: Linux checks the first mapping
    // in the range.
    if map_covers(k, pid, from) || user_shared_page(&mut k.spaces, pid, USER_BASE + from * 4096) != NO_RESULT {
      return EINVAL;
    }
  }
  if advice == MADV_DONTNEED {
    let mut p = from;
    while p < to
      invariant from <= p && p <= to && to <= WPAGES && kok(k)
    {
      if !map_covers(k, pid, p) {
        win_op(&mut k.mem, &mut k.spaces, pid, WOP_ZERO, p, p + 1, 0);
      }
      p = p + 1;
    }
  }
  return 0;
}

/// mlock and munlock (which change nothing, as every page stays in
/// memory): ENOMEM when part of the range, rounded out to pages, is not
/// mapped.
fn lock_range(k: &mut Kernel, pid: u64, addr: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if addr < USER_BASE || n > USER_SIZE || addr - USER_BASE > USER_SIZE - n {
    return ENOMEM;
  }
  let from = (addr - USER_BASE) / 4096;
  let to = smaller((addr - USER_BASE + n + 4095) / 4096, WPAGES);
  if from > to || win_op(&mut k.mem, &mut k.spaces, pid, WOP_COUNT, from, to, 0) != to - from {
    return ENOMEM;
  }
  return 0;
}

// ------------------------------------------------ cached file pages

/// Maps the page cache's slot `slot` (src/pcache.bastio) at window page p
/// of process pid, making the level-1 table if need be, writable if `w`.
/// False if the process has no window, memory ran out, or p is in use
/// (for a read-only page, something there already counts as mapped).
fn lx_map_cached(m: &mut Mem, spaces: &mut Vec[Space], pid: u64, p: u64, c: &mut PCache, slot: u64, w: bool) -> bool
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC && p < WPAGES && pc_ok(c) && slot < PC_N
  ensures mem_ok(m) && spaces_ok(spaces) && pc_ok(c)
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return false; },
    Space::Mapped(mut root) => {
      let mut ok = false;
      if pt_has(root, 1) {
        ok = pt_borrow(&mut root, 1, cached_l3, &mut m, p, &mut c, slot, w);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return ok;
    },
  }
}

fn cached_l3(l3: &mut PageTable, m: &mut Mem, p: u64, c: &mut PCache, slot: u64, w: bool) -> bool
  requires pt_level(l3) == 3 && mem_ok(m) && p < WPAGES && pc_ok(c) && slot < PC_N
  ensures mem_ok(m) && pc_ok(c)
{
  if !pt_has(l3, 0) {
    return false;
  }
  return pt_borrow(&mut l3, 0, cached_l2, &mut m, p, &mut c, slot, w);
}

fn cached_l2(l2: &mut PageTable, m: &mut Mem, p: u64, c: &mut PCache, slot: u64, w: bool) -> bool
  requires pt_level(l2) == 2 && mem_ok(m) && p < WPAGES && pc_ok(c) && slot < PC_N
  ensures mem_ok(m) && pc_ok(c) && pt_level(l2) == 2
{
  let t = p / 512;
  if !pt_has(l2, t) {
    let a = find_free(&mut m);
    if a >= NPAGES {
      return false;
    }
    pt_put(&mut l2, t, pt_new(take_page(&mut m, a), 1));
  }
  return pt_borrow(&mut l2, t, pc_map, &mut c, slot, p % 512, w);
}

/// mmap MAP_SHARED of file f from offset off at window pages first ..
/// first + pages: each page is the page cache's page for that part of the
/// file, read in now if no process has it yet. 0, or ENOMEM.
fn lx_map_file_shared(k: &mut Kernel, pid: u64, first: u64, pages: u64, f: u64, off: u64) -> u64
  requires kok(k) && pid < NPROC && first <= WPAGES && pages <= WPAGES - first && off % 4096 == 0
  ensures kok(k)
{
  let mut j = 0;
  while j < pages
    invariant j <= pages && kok(k) && pid < NPROC && first + pages <= WPAGES
  {
    let fpg = off / 4096 + j;
    let mut slot = pc_get(&mut k.fs.pc, f, fpg);
    if slot >= PC_N {
      let mut got = 0;
      if fpg <= 0xFFFFFFFFFFFFF {
        got = vfs_read_at(&mut k.fs, f, fpg * 4096, XFER);
        if got == NO_FD {
          got = 0;
        }
      }
      slot = pc_add(&mut k.fs.pc, &mut k.mem, f, fpg, k.fs.xfer, got, false);
    }
    if slot >= PC_N || !lx_map_cached(&mut k.mem, &mut k.spaces, pid, first + j, &mut k.fs.pc, slot, true) {
      return ENOMEM;
    }
    j = j + 1;
  }
  return 0;
}
