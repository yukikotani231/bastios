// Anonymous memory mapped when first touched.
//
// A private, writable anonymous mmap maps no pages: it records the range,
// and a page fault in it maps a fresh zero page there and runs the
// instruction again (anon_fault), as Linux does. So a program can reserve
// more than the machine has (a large malloc, a sparse array, a JIT's code
// range) and pay only for the pages it touches. Each process has AN_N
// records in k.anon: the first window page + 1 (0: free) and the page
// count, plus AN_X if the pages may also run code (PROT_EXEC with
// PROT_WRITE; the fault maps such a page with the bit it needs,
// src/usermem.bastio). A record says the
// pages of its range that are not mapped read as zeros; pages it covers
// that are mapped are ordinary memory. Records never overlap: a range is
// forgotten (map_forget, src/lxmem.bastio) before anything is mapped over
// it.
//
// When the kernel is the first to touch such a page (read(2) into a fresh
// buffer, say), copy_from_user and copy_to_user (src/usermem.bastio) map it
// the same way, so system calls see no difference.
//
// brk's new pages are recorded the same way (lx_brk).
//
// What stays eager: shared and read-only anonymous mappings (and
// read-only executable ones),
// MAP_POPULATE and MAP_LOCKED, and a mapping that finds every record in use.
// mprotect, mremap, mlock and the calls that need the pages there map the
// rest of a recorded range first (anon_reach). A record split by an munmap
// in its middle, with no free record for the right part, maps the right
// part now.
//
// What is trusted: nothing new. The pages are mapped by w_map, as for
// every other fresh page.

import "linux.bastio";

/// Records that range from .. to of process pid is anonymous memory not
/// mapped yet: merged into a record it touches, or in a free one. False if
/// every record is in use (the caller maps the pages now).
fn anon_add(k: &mut Kernel, pid: u64, from: u64, to: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  return anon_add_x(&mut k, pid, from, to, false);
}

/// Whether the pages of record i of process pid may also run code.
fn anon_xbit(k: &Kernel, pid: u64, i: u64) -> bool
  requires kok(k) && pid < NPROC && i < AN_N
{
  return get(k.anon, an_at(pid, i, 1)) / AN_X == 1;
}

/// anon_add for memory that may run code as well if x.
fn anon_add_x(k: &mut Kernel, pid: u64, from: u64, to: u64, x: bool) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if from >= to || to > WPAGES {
    return false;
  }
  let mut xw = 0;
  if x {
    xw = AN_X;
  }
  let mut free = AN_N;
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && free <= AN_N && kok(k) && pid < NPROC && from < to && to <= WPAGES
  {
    let first1 = get(k.anon, an_at(pid, i, 0));
    let pages = get(k.anon, an_at(pid, i, 1)) % AN_X;
    if first1 == 0 {
      if free == AN_N {
        free = i;
      }
    } else if anon_xbit(k, pid, i) != x {
      // may run code or not: kept apart
    } else if first1 - 1 == to && pages <= WPAGES {
      // Just above the new range (mmap hands out space downwards).
      k.anon = set(k.anon, an_at(pid, i, 0), from + 1);
      k.anon = set(k.anon, an_at(pid, i, 1), pages + (to - from) + xw);
      return true;
    } else if first1 - 1 <= WPAGES && pages <= WPAGES && first1 - 1 + pages == from {
      k.anon = set(k.anon, an_at(pid, i, 1), pages + (to - from) + xw);
      return true;
    }
    i = i + 1;
  }
  if free == AN_N {
    if anon_grow(&mut k, pid, from, to, x) {
      return true;
    }
    free = anon_evict(&mut k, pid, to - from);
    if free >= AN_N {
      return false;
    }
  }
  k.anon = set(k.anon, an_at(pid, free, 0), from + 1);
  k.anon = set(k.anon, an_at(pid, free, 1), to - from + xw);
  return true;
}

/// Every record of process pid is in use: the record nearest below range
/// from .. to (or else the nearest above it) grows to take the range in, if
/// every page between them is mapped, none of them belongs to a MAP_SHARED
/// file mapping, and there are at most AN_GAP of them. A record may cover
/// mapped pages, which stay ordinary memory, so the pages between keep what
/// they hold; and no page that must fault (a hole munmap left, PROT_NONE,
/// code or a swapped page not there yet) comes under it. This is what keeps
/// a program that hands many scattered runs of pages back with
/// MADV_DONTNEED (jemalloc's purge in Firefox) from using up the records,
/// after which every mmap would map all its pages at once.
fn anon_grow(k: &mut Kernel, pid: u64, from: u64, to: u64, x: bool) -> bool
  requires kok(k) && pid < NPROC && from < to && to <= WPAGES
  ensures kok(k)
{
  let mut below = AN_N;
  let mut below_end = 0;
  let mut above = AN_N;
  let mut above_first = WPAGES + 1;
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && below <= AN_N && above <= AN_N && below_end <= from && above_first >= to && kok(k) && pid < NPROC && from < to && to <= WPAGES
  {
    let first1 = get(k.anon, an_at(pid, i, 0));
    let pages = get(k.anon, an_at(pid, i, 1)) % AN_X;
    if first1 != 0 && first1 - 1 <= WPAGES && pages <= WPAGES - (first1 - 1) && anon_xbit(k, pid, i) == x {
      let first = first1 - 1;
      let end = first + pages;
      if end <= from && (below == AN_N || end > below_end) {
        below = i;
        below_end = end;
      } else if first >= to && first < above_first {
        above = i;
        above_first = first;
      }
    }
    i = i + 1;
  }
  let mut xw = 0;
  if x {
    xw = AN_X;
  }
  if below < AN_N && anon_gap_ok(&mut k, pid, below_end, from) {
    let first1 = get(k.anon, an_at(pid, below, 0));
    if first1 != 0 && first1 - 1 <= below_end {
      let first = first1 - 1;
      k.anon = set(k.anon, an_at(pid, below, 1), to - first + xw);
      return true;
    }
  }
  if above < AN_N && above_first <= WPAGES && anon_gap_ok(&mut k, pid, to, above_first) {
    let pages = get(k.anon, an_at(pid, above, 1)) % AN_X;
    if pages <= WPAGES - above_first {
      k.anon = set(k.anon, an_at(pid, above, 0), from + 1);
      k.anon = set(k.anon, an_at(pid, above, 1), above_first + pages - from + xw);
      return true;
    }
  }
  return false;
}

/// Every record of process pid is in use and none can grow (anon_grow):
/// the record that spans the fewest pages, if fewer than want and at most
/// AN_EVICT, has its pages mapped now (anon_reach), and its slot is given
/// back for a range of want pages. AN_N if there is none. A few small runs
/// of pages handed back with MADV_DONTNEED cost their pages again; a large
/// mmap after them stays lazy.
fn anon_evict(k: &mut Kernel, pid: u64, want: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut best = AN_N;
  let mut best_pages = smaller(want, AN_EVICT + 1);
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && best <= AN_N && kok(k) && pid < NPROC
  {
    let first1 = get(k.anon, an_at(pid, i, 0));
    let pages = get(k.anon, an_at(pid, i, 1)) % AN_X;
    if first1 != 0 && pages < best_pages {
      best = i;
      best_pages = pages;
    }
    i = i + 1;
  }
  if best >= AN_N {
    return AN_N;
  }
  let first1 = get(k.anon, an_at(pid, best, 0));
  if first1 == 0 || first1 - 1 > WPAGES || best_pages > WPAGES - (first1 - 1) {
    return AN_N;
  }
  anon_reach(&mut k, pid, first1 - 1, first1 - 1 + best_pages);
  if get(k.anon, an_at(pid, best, 0)) != 0 {
    return AN_N;
  }
  return best;
}

/// Whether a record may grow over window pages from .. to of process pid
/// (anon_grow): at most AN_GAP pages, every one mapped, none in a MAP_SHARED
/// file mapping.
fn anon_gap_ok(k: &mut Kernel, pid: u64, from: u64, to: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if from > to || to > WPAGES || to - from > AN_GAP {
    return false;
  }
  if from == to {
    return true;
  }
  let mut i = 0;
  while i < MAP_N
    invariant i <= MAP_N && kok(k) && pid < NPROC
  {
    let first1 = wget(k.maps, mp_at(pid, i, 0));
    let pages = wget(k.maps, mp_at(pid, i, 1));
    if first1 != 0 && first1 - 1 < to && (first1 - 1 >= from || pages > from - (first1 - 1)) {
      return false;
    }
    i = i + 1;
  }
  return win_op(&mut k.mem, &mut k.spaces, pid, WOP_COUNT, from, to, 0) == to - from;
}

/// Window pages from .. to of process pid are going away or being replaced
/// (munmap, a mapping over them, mremap, exit, execve): no record covers
/// them any more.
fn anon_forget(k: &mut Kernel, pid: u64, from: u64, to: u64)
  requires kok(k) && pid < NPROC && from <= to && to <= WPAGES
  ensures kok(k)
{
  swap_forget(&mut k, tgid(k.procs, pid), from, to);   // swapped pages in the range have nothing to come back to
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && kok(k) && pid < NPROC && from <= to && to <= WPAGES
  {
    let first1 = get(k.anon, an_at(pid, i, 0));
    let pages = get(k.anon, an_at(pid, i, 1)) % AN_X;
    if first1 != 0 && first1 - 1 <= WPAGES && pages <= WPAGES - (first1 - 1) {
      let first = first1 - 1;
      let end = first + pages;
      let mut xw = 0;
      if anon_xbit(k, pid, i) {
        xw = AN_X;
      }
      if to <= first || end <= from {
        // none of it
      } else if from <= first && end <= to {
        k.anon = set(k.anon, an_at(pid, i, 0), 0);           // all of it
      } else if from <= first {
        k.anon = set(k.anon, an_at(pid, i, 0), to + 1);      // the head goes
        k.anon = set(k.anon, an_at(pid, i, 1), end - to + xw);
      } else if end <= to {
        k.anon = set(k.anon, an_at(pid, i, 1), from - first + xw);   // the tail goes
      } else {
        // A hole in the middle: the left part keeps the record, the right
        // part takes a free one, or gets its pages now.
        let x = xw != 0;
        k.anon = set(k.anon, an_at(pid, i, 1), from - first + xw);
        assert end <= WPAGES;
        if !anon_add_x(&mut k, pid, to, end, x) {
          lx_map_pages(&mut k.mem, &mut k.spaces, pid, to, end, false);
          if x {
            win_op(&mut k.mem, &mut k.spaces, pid, WOP_PROTECT, to, end, 6);   // read, write and run
          }
        }
      }
    }
    i = i + 1;
  }
}

/// Maps every page of window pages from .. to of process pid that a record
/// covers and that is not mapped yet, and forgets the records there: the
/// range is ordinary memory afterwards. For the calls that change or move
/// pages (mprotect, mremap, mlock), which need them there.
fn anon_reach(k: &mut Kernel, pid: u64, from: u64, to: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if from >= to || to > WPAGES {
    return;
  }
  swap_reach(&mut k, tgid(k.procs, pid), pid, from, to);   // swapped pages come back first (src/swap.bastio)
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && kok(k) && pid < NPROC && from < to && to <= WPAGES
  {
    let first1 = get(k.anon, an_at(pid, i, 0));
    let pages = get(k.anon, an_at(pid, i, 1)) % AN_X;
    if first1 != 0 && first1 - 1 <= WPAGES && pages <= WPAGES - (first1 - 1) {
      let a = larger(first1 - 1, from);
      let b = smaller(first1 - 1 + pages, to);
      if a < b {
        lx_map_pages(&mut k.mem, &mut k.spaces, pid, a, b, false);
        if anon_xbit(k, pid, i) {
          win_op(&mut k.mem, &mut k.spaces, pid, WOP_PROTECT, a, b, 6);   // read, write and run
        }
      }
    }
    i = i + 1;
  }
  anon_forget(&mut k, pid, from, to);
}

/// The pages process pid has, for /proc and getrusage. The count cannot be
/// taken while another processor runs the process's space; then the last
/// count that could be taken stands, never a made-up size.
fn anon_resident(k: &mut Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k) && result <= WPAGES
{
  let c = anon_count(&mut k, pid, 0, WPAGES);
  if c <= WPAGES {
    pset(&mut k.procs, pid, F_RSSC, c);
    return c;
  }
  return smaller(pget(k.procs, pid, F_RSSC), WPAGES);
}

/// How many of window pages from .. to of process pid are memory the
/// process has: mapped, or covered by a record.
fn anon_count(k: &mut Kernel, pid: u64, from: u64, to: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if from >= to || to > WPAGES {
    return 0;
  }
  let mut c = win_op(&mut k.mem, &mut k.spaces, pid, WOP_COUNT, from, to, 0);
  if c > to - from {
    return c;
  }
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && kok(k) && pid < NPROC && from < to && to <= WPAGES && c <= to - from
  {
    let first1 = get(k.anon, an_at(pid, i, 0));
    let pages = get(k.anon, an_at(pid, i, 1)) % AN_X;
    if first1 != 0 && first1 - 1 <= WPAGES && pages <= WPAGES - (first1 - 1) {
      let a = larger(first1 - 1, from);
      let b = smaller(first1 - 1 + pages, to);
      if a < b {
        let have = win_op(&mut k.mem, &mut k.spaces, pid, WOP_COUNT, a, b, 0);
        if have <= b - a && c + (b - a - have) <= to - from {
          c = c + (b - a - have);
        }
      }
    }
    i = i + 1;
  }
  return c;
}

/// A page fault of process p on anonymous memory not touched yet: maps
/// its zero page, and true says to run p again.
fn anon_fault(k: &mut Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let va = pget(k.procs, p, reg_word(R_FAULT));
  if va < USER_BASE || va - USER_BASE >= USER_SIZE {
    return false;
  }
  let q = (va - USER_BASE) / 4096;
  if !anon_covers(k.anon, p, q) || raw_from_user(&mut k.spaces, p, q * 4096, &mut k.fs.xfer, 0, 1) != 0 {
    return false;                           // not such memory, or mapped (a fault for another reason)
  }
  let ok = anon_touch(&mut k.mem, &mut k.spaces, k.anon, p, q);
  if ok && q % 256 == 0 {
    // A program that touches memory fast can finish before a timer tick
    // looks at its group, so every 256th page it faults in is a check too.
    cg_oom_tick(&mut k, p);
  }
  return ok;
}

/// fork: the child's window is a copy of the parent's, pages not touched
/// yet included, so it gets the records too.
fn anon_fork(k: &mut Kernel, pid: u64, c: u64)
  requires kok(k) && pid < NPROC && c < NPROC
  ensures kok(k)
{
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && kok(k) && pid < NPROC && c < NPROC
  {
    k.anon = set(k.anon, an_at(c, i, 0), get(k.anon, an_at(pid, i, 0)));
    k.anon = set(k.anon, an_at(c, i, 1), get(k.anon, an_at(pid, i, 1)));
    i = i + 1;
  }
}

/// A row with a new window, or a new thread's row (the group's records
/// stay with its holder): no records.
fn anon_clear(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && kok(k) && pid < NPROC
  {
    k.anon = set(k.anon, an_at(pid, i, 0), 0);
    i = i + 1;
  }
}
