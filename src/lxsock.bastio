// Linux UDP sockets, over the kernel's sockets in src/net.bastio. A socket
// descriptor names an open file description of kind OF_SOCK whose x is
// the kernel socket. Its word 3 is 2 * peer + nonblocking, where peer is
// 65536 * address + port as set by connect (0: not connected).

import "linux.bastio";

const PROT_SOCK: u64 = 1024;           // the first port anyone may bind
const LX_SOCKET: u64 = 41;
const LX_CONNECT: u64 = 42;
const LX_SENDTO: u64 = 44;
const LX_RECVFROM: u64 = 45;
const LX_BIND: u64 = 49;
const LX_GETSOCKNAME: u64 = 51;
const LX_GETPEERNAME: u64 = 52;
const LX_SETSOCKOPT: u64 = 54;
const LX_GETSOCKOPT: u64 = 55;
const LX_SOCKETPAIR: u64 = 53;
const SOL_SOCKET: u64 = 1;
const SOL_TCP: u64 = 6;                 // IPPROTO_TCP, as a level
const SO_TYPE: u64 = 3;
const SO_ERROR: u64 = 4;
const ENOPROTOOPT: u64 = 18446744073709551524;      // 2^64 - 92
const LX_ACCEPT: u64 = 43;
const LX_SHUTDOWN: u64 = 48;
const LX_LISTEN: u64 = 50;
const LX_ACCEPT4: u64 = 288;

const AF_INET: u64 = 2;
const SOCK_STREAM: u64 = 1;
const SOCK_DGRAM: u64 = 2;
const SOCK_SEQPACKET: u64 = 5;
const IPPROTO_UDP: u64 = 17;
const SOCK_RAW: u64 = 3;
const IPPROTO_ICMP: u64 = 1;
const IPPROTO_ICMPV6: u64 = 58;
const SOL_RAW: u64 = 255;
const IPV6_V6ONLY: u64 = 26;
const IPV6_2292HOPLIMIT: u64 = 8;
const IPV6_RECVHOPLIMIT: u64 = 51;
const IPV6_HOPLIMIT: u64 = 52;
const SOCK_NONBLOCK: u64 = 0x800;
const SOCK_CLOEXEC: u64 = 0x80000;
const MSG_DONTWAIT: u64 = 0x40;
const MSG_MORE: u64 = 0x8000;
const MSG_PEEK: u64 = 2;
const MSG_TRUNC: u64 = 0x20;
const MSG_NOSIGNAL: u64 = 0x4000;
const MSG_OOB: u64 = 1;
const MSG_ERRQUEUE: u64 = 0x2000;
const SOCKADDR_MAX: u64 = 128;         // sizeof(struct sockaddr_storage)
const SO_REUSEADDR: u64 = 2;
const SO_BROADCAST: u64 = 6;
const SO_KEEPALIVE: u64 = 9;
const SO_REUSEPORT: u64 = 15;
const SO_SNDBUF: u64 = 7;
const SO_RCVBUF: u64 = 8;
const SIN_LEN: u64 = 16;               // struct sockaddr_in
const SIN6_LEN: u64 = 28;              // struct sockaddr_in6
const AF_INET6: u64 = 10;
const AF_NETLINK: u64 = 16;
const EADDRNOTAVAIL: u64 = 18446744073709551517;   // 2^64 - 99

const ENOTSOCK: u64 = 18446744073709551528;        // 2^64 - 88
const EDESTADDRREQ: u64 = 18446744073709551527;    // 2^64 - 89
const EMSGSIZE: u64 = 18446744073709551526;        // 2^64 - 90
const EPROTONOSUPPORT: u64 = 18446744073709551523; // 2^64 - 93
const EAFNOSUPPORT: u64 = 18446744073709551519;    // 2^64 - 97
const EADDRINUSE: u64 = 18446744073709551518;      // 2^64 - 98
const ENETUNREACH: u64 = 18446744073709551515;     // 2^64 - 101
const ENOBUFS: u64 = 18446744073709551511;         // 2^64 - 105
const ENOTCONN: u64 = 18446744073709551509;        // 2^64 - 107

// A socket descriptor: its description h and kernel socket s, or err.
struct Sk { err: u64, h: u64, s: u64 }

// An address: ip and port, or err.
struct Sin { err: u64, ip: u64, port: u64 }

fn sk_look(k: &Kernel, pid: u64, fd: u64) -> Sk
  requires kok(k) && pid < NPROC
  ensures result.err == 0 ==> (result.h < OFD_N && result.s < SOCKS)
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  if v == 0 {
    return Sk { err: EBADF, h: 0, s: 0 };
  }
  if v < FD_OFD || v - FD_OFD >= OFD_N {
    return Sk { err: ENOTSOCK, h: 0, s: 0 };
  }
  let h = v - FD_OFD;
  let s = of_get(k.ofd, h, 2);
  if of_get(k.ofd, h, 0) != OF_SOCK || s >= SOCKS {
    return Sk { err: ENOTSOCK, h: 0, s: 0 };
  }
  return Sk { err: 0, h: h, s: s };
}

/// Reads the struct sockaddr_in at user address va (alen bytes long), or a
/// struct sockaddr_in6 whose address IPv4 can stand for: :: (any), ::1
/// (127.0.0.1) or ::ffff:a.b.c.d; any other IPv6 address becomes the
/// token that stands for it on the wire (src/net6.bastio), or
/// -EADDRNOTAVAIL without a network card.
fn sin_in(k: &mut Kernel, pid: u64, va: u64, alen: u64) -> Sin
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result.err == 0 ==> (result.ip <= 4294967295 && result.port <= 65535)
{
  if alen < 8 || alen % 4294967296 > SOCKADDR_MAX {
    return Sin { err: EINVAL, ip: 0, port: 0 };   // a socklen_t past sockaddr_storage too
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, 8) != 8 {
    return Sin { err: EFAULT, ip: 0, port: 0 };
  }
  let family = cast[u64](bget(k.fs.xfer, 0)) + 256 * cast[u64](bget(k.fs.xfer, 1));
  // The port and the address are in network byte order.
  let port = 256 * cast[u64](bget(k.fs.xfer, 2)) + cast[u64](bget(k.fs.xfer, 3));
  if family == AF_INET6 {
    if alen < SIN6_LEN - 4 {
      return Sin { err: EINVAL, ip: 0, port: 0 };
    }
    if va > 0xFFFFFFFFFFFFFF00 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + 8, &mut k.fs.xfer, 16) != 16 {
      return Sin { err: EFAULT, ip: 0, port: 0 };
    }
    let hi = get_u64(k.fs.xfer, 0);         // the first 8 bytes of the address
    let lo = get_u64(k.fs.xfer, 8);
    let ip = 0x1000000 * cast[u64](bget(k.fs.xfer, 12)) + 0x10000 * cast[u64](bget(k.fs.xfer, 13)) + 0x100 * cast[u64](bget(k.fs.xfer, 14)) + cast[u64](bget(k.fs.xfer, 15));
    if hi == 0 && lo == 0 {
      return Sin { err: 0, ip: 0, port: port };
    }
    if hi == 0 && lo % 0x100000000 == 0 && ip == 1 {
      return Sin { err: 0, ip: 0x7F000001, port: port };   // ::1
    }
    if hi == 0 && lo % 0x100000000 == 0xFFFF0000 {
      return Sin { err: 0, ip: ip, port: port };           // ::ffff:a.b.c.d
    }
    // Any other address: the token that stands for it (src/net6.bastio).
    let t = nic_v6_token(&mut k.nic, be64(k.fs.xfer, 0), be64(k.fs.xfer, 8));
    if t > 4294967295 {
      return Sin { err: EADDRNOTAVAIL, ip: 0, port: 0 };
    }
    return Sin { err: 0, ip: t, port: port };
  }
  if family != AF_INET {
    return Sin { err: EAFNOSUPPORT, ip: 0, port: 0 };
  }
  let ip = 0x1000000 * cast[u64](bget(k.fs.xfer, 4)) + 0x10000 * cast[u64](bget(k.fs.xfer, 5)) + 0x100 * cast[u64](bget(k.fs.xfer, 6)) + cast[u64](bget(k.fs.xfer, 7));
  return Sin { err: 0, ip: ip, port: port };
}

/// Whether open file description h is an AF_INET6 socket that was
/// connected to a ::ffff:a.b.c.d address.
fn ofd_mapped(k: &Kernel, h: u64) -> bool {
  return h < len(k.inet6) && get(k.inet6, h) % 8 == 2;
}

/// Whether the (already validated) address at va is a ::ffff:a.b.c.d
/// struct sockaddr_in6 or a struct sockaddr_in.
fn sin_mapped(k: &mut Kernel, pid: u64, va: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, 2) != 2 {
    return false;
  }
  if bget(k.fs.xfer, 0) == 2 && bget(k.fs.xfer, 1) == 0 {
    return true;                            // a struct sockaddr_in on an AF_INET6 socket
  }
  if va > 0xFFFFFFFFFFFFFF00 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + 8, &mut k.fs.xfer, 16) != 16 {
    return false;
  }
  return get_u64(k.fs.xfer, 0) == 0 && get_u64(k.fs.xfer, 8) % 0x100000000 == 0xFFFF0000;
}

/// Which hop limit control message the AF_INET6 socket of open file
/// description h wants with each datagram: 0 none, 1 the one IPV6_HOPLIMIT
/// (2292) asks for (cmsg type 8), 2 the one IPV6_RECVHOPLIMIT asks for (type
/// 52). It rides in the eights of the word k.inet6 keeps (0: not AF_INET6,
/// 1: AF_INET6, 2: connected to a ::ffff:a.b.c.d address, 3: IPV6_V6ONLY).
fn ofd_hlim(k: &Kernel, h: u64) -> u64
  ensures result <= 3
{
  if h < len(k.inet6) {
    return get(k.inet6, h) / 8 % 4;
  }
  return 0;
}

/// Whether open file description h is an AF_INET6 socket with
/// IPV6_V6ONLY set: it takes no IPv4 peers.
fn ofd_v6only(k: &Kernel, h: u64) -> bool {
  return h < len(k.inet6) && get(k.inet6, h) % 8 == 3;
}

/// The address family (FAM_*) the stack gives the socket of open file
/// description h.
fn ofd_fam(k: &Kernel, h: u64) -> u64
  ensures result <= 6
{
  if ofd_v6only(k, h) {
    return FAM_V6;
  }
  if ofd_v6(k, h) {
    return FAM_BOTH;
  }
  return FAM_V4;
}

/// Whether open file description h is an AF_INET6 socket.
fn ofd_v6(k: &Kernel, h: u64) -> bool {
  return h < len(k.inet6) && get(k.inet6, h) % 8 != 0;
}

/// Whether descriptor fd of process pid is an AF_INET6 socket.
fn fd_v6(k: &Kernel, pid: u64, fd: u64) -> bool
  requires fds_ok(k) && pid < NPROC
{
  return ofd_v6(k, fd_ofd(k, pid, fd));
}

/// Writes ip:port as a struct sockaddr_in to user address va, where the
/// u32 at user address lenp says how much room there is, and sets that to
/// SIN_LEN. With v6, a struct sockaddr_in6 instead (SIN6_LEN): 0.0.0.0 as
/// ::, 127.0.0.1 as ::1, an IPv6 peer's token (src/net6.bastio) as its
/// address, and any other address as ::ffff:a.b.c.d. Nothing if va is 0. Returns 0 or -EFAULT.
fn sin_out(k: &mut Kernel, pid: u64, va: u64, lenp: u64, ip: u64, port: u64, v6: bool) -> u64
  requires kok(k) && pid < NPROC && ip <= 4294967295 && port <= 65535
  ensures kok(k)
{
  return sin_out_m(&mut k, pid, va, lenp, ip, port, v6, false);
}

/// sin_out where, with `mapped`, 127.0.0.1 reads as ::ffff:127.0.0.1
/// instead of ::1 (a socket that was connected to a mapped address).
fn sin_out_m(k: &mut Kernel, pid: u64, va: u64, lenp: u64, ip: u64, port: u64, v6: bool, mapped: bool) -> u64
  requires kok(k) && pid < NPROC && ip <= 4294967295 && port <= 65535
  ensures kok(k)
{
  if va == 0 {
    return 0;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, &mut k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  let room = cast[u64](bget(k.fs.xfer, 0)) + 256 * cast[u64](bget(k.fs.xfer, 1)) + 65536 * cast[u64](bget(k.fs.xfer, 2)) + 16777216 * cast[u64](bget(k.fs.xfer, 3));
  let mut len = SIN_LEN;
  lx_fill(&mut k, 0, SIN6_LEN);
  bset(&mut k.fs.xfer, 2, cast[u8](port / 256));
  bset(&mut k.fs.xfer, 3, cast[u8](port % 256));
  if v6 {
    len = SIN6_LEN;
    bset(&mut k.fs.xfer, 0, cast[u8](AF_INET6));
    if ip == 0x7F000001 && !mapped {
      bset(&mut k.fs.xfer, 23, 1);          // ::1
    } else if is_v6tok(ip) {
      put64(&mut k.fs.xfer, 8, nic_v6_addr(k.nic, ip, 0));   // an IPv6 peer
      put64(&mut k.fs.xfer, 16, nic_v6_addr(k.nic, ip, 1));
    } else if ip == V6_SELF {
      put64(&mut k.fs.xfer, 8, nic_v6_addr(k.nic, ip, 2));   // our own IPv6 address
      put64(&mut k.fs.xfer, 16, nic_v6_addr(k.nic, ip, 3));
    } else if ip != 0 {
      bset(&mut k.fs.xfer, 18, 255);        // ::ffff:a.b.c.d
      bset(&mut k.fs.xfer, 19, 255);
      bset(&mut k.fs.xfer, 20, cast[u8](ip / 0x1000000));
      bset(&mut k.fs.xfer, 21, cast[u8](ip / 0x10000 % 256));
      bset(&mut k.fs.xfer, 22, cast[u8](ip / 0x100 % 256));
      bset(&mut k.fs.xfer, 23, cast[u8](ip % 256));
    }
  } else {
    bset(&mut k.fs.xfer, 0, cast[u8](AF_INET));
    bset(&mut k.fs.xfer, 4, cast[u8](ip / 0x1000000));
    bset(&mut k.fs.xfer, 5, cast[u8](ip / 0x10000 % 256));
    bset(&mut k.fs.xfer, 6, cast[u8](ip / 0x100 % 256));
    bset(&mut k.fs.xfer, 7, cast[u8](ip % 256));
  }
  let n = smaller(room, len);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, n) != n {
    return EFAULT;
  }
  lx_fill(&mut k, 0, 4);
  bset(&mut k.fs.xfer, 0, cast[u8](len));
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  return 0;
}

/// socket(domain, type, protocol): only AF_INET datagram (UDP) sockets.
/// Whether a socket type is one Linux knows: SOCK_STREAM to SOCK_PACKET,
/// with no flag but SOCK_NONBLOCK and SOCK_CLOEXEC.
fn sock_kind_ok(kind: u64) -> bool {
  let k = kind % 0x100000000;
  let fl = k - k % 16;
  return fl & (SOCK_NONBLOCK + SOCK_CLOEXEC) == fl && k % 16 <= 10;
}

fn lx_socket(k: &mut Kernel, pid: u64, domain: u64, kind: u64, proto: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if !sock_kind_ok(kind) {
    return EINVAL;
  }
  if domain == 1 {
    return ux_socket(&mut k, pid, kind, proto);   // AF_UNIX: src/lxunix.bastio
  }
  if domain == AF_NETLINK {
    return nl_socket(&mut k, pid, kind, proto);   // src/lxnetlink.bastio
  }
  // AF_INET6 is AF_INET underneath: its addresses are the IPv6 forms of
  // IPv4 ones (sin_in), and names come back as struct sockaddr_in6.
  if domain != AF_INET && domain != AF_INET6 {
    return EAFNOSUPPORT;
  }
  // A raw ICMPv6 socket (ping6) is a raw ICMP one that carries ICMPv6.
  let icmp6 = domain == AF_INET6 && kind % 16 == SOCK_RAW && proto == IPPROTO_ICMPV6;
  let mut p = proto;
  if icmp6 {
    p = IPPROTO_ICMP;
  }
  let fd = lx_inet_socket(&mut k, pid, kind, p);
  if domain == AF_INET6 {
    let h = fd_ofd(k, pid, fd);
    if h < OFD_N {
      k.inet6 = set(k.inet6, h, 1);
      if icmp6 {
        sock_make_raw6(&mut k.nic, of_get(k.ofd, h, 2));
      } else if kind % 16 != SOCK_STREAM {
        sock_set_fam(&mut k.nic, of_get(k.ofd, h, 2), FAM_BOTH);   // a dual-stack UDP socket
      }
    }
  }
  return fd;
}

/// An AF_INET socket of `kind`: UDP or TCP.
fn lx_inet_socket(k: &mut Kernel, pid: u64, kind: u64, proto: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if kind % 16 == SOCK_STREAM {
    return lx_tcp_socket(&mut k, pid, kind, proto);   // src/lxtcp.bastio
  }
  let raw = kind % 16 == SOCK_RAW;
  if raw && proto != IPPROTO_ICMP {
    return EPROTONOSUPPORT;                 // raw sockets: ICMP only (ping)
  }
  if raw && !cap_has(k, pid, CAP_NET_RAW) {
    return EPERM;
  }
  if !raw && (kind % 16 != SOCK_DGRAM || (proto != 0 && proto != IPPROTO_UDP)) {
    return EPROTONOSUPPORT;
  }
  let s = sock_new(&mut k.nic, net_ns(k, pid));
  if s >= SOCKS {
    return ENOBUFS;                         // every socket taken, or no network card
  }
  if raw {
    sock_make_raw(&mut k.nic, s);
  }
  let h = ofd_new(&mut k, OF_SOCK, s);
  if h >= OFD_N {
    sock_close(&mut k.nic, s);
    return ENFILE;
  }
  of_set(&mut k.ofd, h, 3, kind / SOCK_NONBLOCK % 2);
  let fd = fd_install(&mut k, pid, h);
  if fd < LXNFD && kind / SOCK_CLOEXEC % 2 == 1 {
    fd_set_k(&mut k, pid, fd, FD_OFD + h + FD_CLOEXEC);
  }
  return fd;
}

/// Whether process pid may bind port `port`: the ports below 1024 are
/// root's, and only while it holds CAP_NET_BIND_SERVICE (a refinement:
/// cap_has implies root); 0 asks for any free port.
fn may_bind(k: &Kernel, pid: u64, port: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures result ==> (port == 0 || port >= PROT_SOCK || is_root(k.procs, pid))
{
  return port == 0 || port >= PROT_SOCK || cap_has(k, pid, CAP_NET_BIND_SERVICE);
}

/// bind(fd, addr, len): the port only; the address is ignored (there is
/// one).
fn lx_bind(k: &mut Kernel, pid: u64, fd: u64, addr: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if is_tcp(k, pid, fd) {
    return lx_tcp_bind(&mut k, pid, fd, addr, alen);
  }
  if is_unix(k, pid, fd) {
    return ux_bind(&mut k, pid, fd, addr, alen);
  }
  if is_nl(k, pid, fd) {
    return nl_bind(&mut k, pid, fd, addr, alen);
  }
  let sk = sk_look(k, pid, fd);
  if sk.err != 0 {
    return sk.err;
  }
  let sin = sin_in(&mut k, pid, addr, alen);
  if sin.err != 0 {
    return sin.err;
  }
  if sock_is_raw(k.nic, sk.s) {
    return 0;                               // a raw socket has no port; any address will do
  }
  if sock_port(k.nic, sk.s) != 0 {
    return EINVAL;                          // already bound
  }
  let why = bind_check(k, pid, sin.ip, sin.port);
  if why != 0 {
    return why;
  }
  if !may_bind(k, pid, sin.port) {
    return EACCES;
  }
  if !sock_bind(&mut k.nic, sk.s, sin.port) {
    return EADDRINUSE;
  }
  sock_bound(&mut k, sk.h, sin.ip);
  return 0;
}

/// connect(fd, addr, len): sets where send and write go. Datagrams from
/// elsewhere are still received.
fn lx_connect(k: &mut Kernel, pid: u64, fd: u64, addr: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if is_tcp(k, pid, fd) {
    return lx_tcp_connect(&mut k, pid, fd, addr, alen);
  }
  if is_unix(k, pid, fd) {
    return ux_connect(&mut k, pid, fd, addr, alen);
  }
  if is_nl(k, pid, fd) {
    return nl_bind(&mut k, pid, fd, addr, alen);
  }
  let sk = sk_look(k, pid, fd);
  if sk.err != 0 {
    return sk.err;
  }
  if is_unspec(&mut k, pid, addr, alen) {
    let nb0 = of_get(k.ofd, sk.h, 3) % 2;
    of_set(&mut k.ofd, sk.h, 3, nb0);       // AF_UNSPEC: no peer any more
    if ofd_v6(k, sk.h) {
      k.inet6 = set(k.inet6, sk.h, 1 + 8 * ofd_hlim(k, sk.h));
    }
    return 0;
  }
  let sin = sin_in(&mut k, pid, addr, alen);
  if sin.err != 0 {
    return sin.err;
  }
  if sin.port == 0 {
    return EINVAL;
  }
  let nb = of_get(k.ofd, sk.h, 3) % 2;
  of_set(&mut k.ofd, sk.h, 3, 2 * (65536 * to_local(sin.ip) + sin.port) + nb);
  if ofd_v6(k, sk.h) {
    let mut mark = 1;
    if sin_mapped(&mut k, pid, addr) {
      mark = 2;
    }
    k.inet6 = set(k.inet6, sk.h, mark + 8 * ofd_hlim(k, sk.h));
  }
  return 0;
}

/// What a socket's description keeps in OF_ACC, whose low three bits no
/// socket uses: in bits 3..10 the SOL_SOCKET options that only read back
/// (SOF_*), from bit 11 the address bind was given, for getsockname (the
/// stack demultiplexes on the port alone).
const SOF_REUSEADDR: u64 = 1;
const SOF_REUSEPORT: u64 = 2;
const SOF_KEEPALIVE: u64 = 4;
const SOF_BROADCAST: u64 = 8;
const SOF_SPAN: u64 = 256;
const SOF_BASE: u64 = 8;
const SOF_IP: u64 = 2048;

/// Records that the socket of description h was bound to ip.
fn sock_bound(k: &mut Kernel, h: u64, ip: u64)
  requires kok(k) && h < OFD_N && ip <= 4294967295
  ensures kok(k)
{
  of_set(&mut k.ofd, h, OF_ACC, of_get(k.ofd, h, OF_ACC) % SOF_IP + SOF_IP * ip);
}

/// The address the socket of description h was bound to, 0 for none.
fn sock_bound_ip(k: &Kernel, h: u64) -> u64
  requires kok(k) && h < OFD_N
{
  return of_get(k.ofd, h, OF_ACC) / SOF_IP;
}

/// Whether option bit (SOF_*) is set on the socket of description h.
fn sock_flag(k: &Kernel, h: u64, bit: u64) -> bool
  requires kok(k) && bit >= 1 && bit <= 8
{
  return h < OFD_N && of_get(k.ofd, h, OF_ACC) % SOF_IP / SOF_BASE / bit % 2 == 1;
}

/// Sets or clears option bit (SOF_*) on the socket of description h.
fn sock_flag_set(k: &mut Kernel, h: u64, bit: u64, on: bool)
  requires kok(k) && h < OFD_N && bit >= 1 && bit <= 8
  ensures kok(k)
{
  let acc = of_get(k.ofd, h, OF_ACC);
  let low = acc % SOF_IP;
  let mut f = low / SOF_BASE;
  let had = f / bit % 2 == 1;
  if on && !had {
    f = f + bit;
  } else if !on && had && f >= bit {
    f = f - bit;
  }
  of_set(&mut k.ofd, h, OF_ACC, acc / SOF_IP % 0x100000000 * SOF_IP + f * SOF_BASE + low % SOF_BASE);
}

/// The SOF_* bit of SOL_SOCKET option name, or 0.
fn sof_of(name: u64) -> u64
  ensures result <= 8
{
  if name == SO_REUSEADDR {
    return SOF_REUSEADDR;
  }
  if name == SO_REUSEPORT {
    return SOF_REUSEPORT;
  }
  if name == SO_KEEPALIVE {
    return SOF_KEEPALIVE;
  }
  if name == SO_BROADCAST {
    return SOF_BROADCAST;
  }
  return 0;
}

/// Whether process pid may bind ip: 0, or -EADDRNOTAVAIL for an address
/// that is not this machine's. Linux checks this before the port
/// (may_bind).
fn bind_check(k: &Kernel, pid: u64, ip: u64, port: u64) -> u64
  requires kok(k) && pid < NPROC
{
  if ip != 0 && !addr_local(k.nic, net_ns(k, pid), ip) {
    return EADDRNOTAVAIL;
  }
  return 0;
}

/// Is ip one of network namespace ns's addresses (loopback, or an
/// interface's)?
fn addr_local(c: &Nic, ns: u64, ip: u64) -> bool
  requires nic_ok(c)
{
  match c {
    Nic::None => { return ip / 16777216 == LO_NET; },
    Nic::Up(n) => { return is_local_in(n, ns, ip); },
  }
}

/// Is the address at va (alen bytes) of family AF_UNSPEC? connect with
/// one undoes a connection.
fn is_unspec(k: &mut Kernel, pid: u64, va: u64, alen: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if alen < 2 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, 2) != 2 {
    return false;
  }
  return bget(k.fs.xfer, 0) == 0 && bget(k.fs.xfer, 1) == 0;
}

/// A destination of 0.0.0.0 means this host, as on Linux.
fn to_local(ip: u64) -> u64
  requires ip <= 4294967295
  ensures result <= 4294967295
{
  if ip == 0 {
    return 0x7F000001;
  }
  return ip;
}

/// sendto(fd, buf, n, flags, addr, alen); with addr 0, to the connected
/// peer (send and write). One datagram of at most UDP_MAX bytes.
fn lx_sendto(k: &mut Kernel, pid: u64, fd: u64, buf: u64, n: u64, addr: u64, alen: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let more = flags / MSG_MORE % 2 == 1;
  if is_tcp(k, pid, fd) {
    let r = lx_tcp_send(&mut k, pid, fd, buf, n, more);
    if r == SK_WAIT && flags / MSG_DONTWAIT % 2 == 1 {
      return EAGAIN;                        // MSG_DONTWAIT: a full send buffer does not wait
    }
    return r;
  }
  if is_unix(k, pid, fd) {
    return ux_send(&mut k, pid, fd, buf, n, false, addr, alen);
  }
  let q = nl_of(k, pid, fd);
  if q < NLS {
    return nl_send(&mut k, pid, q, buf, n);
  }
  let d = udp_dest(&mut k, pid, fd, addr, alen);
  if d.err != 0 {
    return d.err;
  }
  if sock_is_raw(k.nic, d.s) {
    if n > UDP_MAX + 8 {
      return EMSGSIZE;
    }
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, &mut k.fs.xfer, n) != n {
      return EFAULT;
    }
    if sock_raw_send(&mut k.nic, d.s, d.ip, k.fs.xfer, n) == NO_SOCK {
      return ENETUNREACH;
    }
    return n;
  }
  if n > UDP_MAX - sock_corked(k.nic, d.s) {
    return EMSGSIZE;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, &mut k.fs.xfer, n) != n {
    return EFAULT;
  }
  let r = sock_send_more(&mut k.nic, d.s, d.ip, d.port, k.fs.xfer, n, more);
  if r == NO_SOCK {
    return ENETUNREACH;                     // no route, no free port, or port 0
  }
  return r;
}

// Where a UDP datagram goes: the socket, and ip:port; or err.
struct Dest { err: u64, s: u64, ip: u64, port: u64 }

/// The destination of a datagram sent on UDP socket fd: the address at
/// addr (alen bytes), or the connected peer when addr is 0.
fn udp_dest(k: &mut Kernel, pid: u64, fd: u64, addr: u64, alen: u64) -> Dest
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let sk = sk_look(k, pid, fd);
  if sk.err != 0 {
    return Dest { err: sk.err, s: 0, ip: 0, port: 0 };
  }
  if addr == 0 {
    let peer = of_get(k.ofd, sk.h, 3) / 2;
    if peer == 0 {
      return Dest { err: EDESTADDRREQ, s: 0, ip: 0, port: 0 };
    }
    return Dest { err: 0, s: sk.s, ip: peer / 65536, port: peer % 65536 };
  }
  let sin = sin_in(&mut k, pid, addr, alen);
  if sin.err != 0 {
    return Dest { err: sin.err, s: 0, ip: 0, port: 0 };
  }
  return Dest { err: 0, s: sk.s, ip: to_local(sin.ip), port: sin.port };
}

/// recvfrom(fd, buf, n, flags, addr, alenp); recv and read too. Takes one
/// datagram (the part past n is dropped, as Linux does). Returns its
/// length, -EAGAIN if none is queued and the caller must not wait, or
/// SK_WAIT if it must.
fn lx_recvfrom(k: &mut Kernel, pid: u64, fd: u64, buf: u64, n: u64, flags: u64, addr: u64, alenp: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if is_tcp(k, pid, fd) {
    if flags % 2 == MSG_OOB {
      return EINVAL;                        // no urgent data is ever kept
    }
    if flags / MSG_ERRQUEUE % 2 == 1 {
      return EAGAIN;                        // the error queue is always empty
    }
    if addr != 0 && alenp != 0 {
      // A stream socket fills in no address, but a negative length is
      // still EINVAL, as on Linux.
      if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, alenp, &mut k.fs.xfer, 4) != 4 {
        return EFAULT;
      }
      if bget(k.fs.xfer, 3) >= 128 {
        return EINVAL;
      }
    }
    return lx_tcp_recv(&mut k, pid, fd, buf, n, flags / MSG_DONTWAIT % 2 == 1, flags / MSG_PEEK % 2 == 1);
  }
  if is_unix(k, pid, fd) {
    return ux_recv(&mut k, pid, fd, buf, n, flags / MSG_DONTWAIT % 2 == 1, flags / MSG_PEEK % 2 == 1, flags / 32 % 2 == 1, addr, alenp);
  }
  let q = nl_of(k, pid, fd);
  if q < NLS {
    return nl_recv(&mut k, pid, fd, q, buf, n, flags, addr, alenp);
  }
  let sk = sk_look(k, pid, fd);
  if sk.err != 0 {
    return sk.err;
  }
  let full = sock_head_len(&mut k.nic, sk.s);
  let got = sock_recvfrom(&mut k.nic, sk.s, &mut k.fs.xfer, smaller(n, XFER), flags / MSG_PEEK % 2 == 1);
  if got == NO_SOCK {
    if flags / MSG_DONTWAIT % 2 == 1 || of_get(k.ofd, sk.h, 3) % 2 == 1 {
      return EAGAIN;
    }
    return SK_WAIT;
  }
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, k.fs.xfer, got) != got {
    return EFAULT;
  }
  let ip = sock_peer_ip(k.nic, sk.s);
  let port = sock_peer_port(k.nic, sk.s);
  let r = sin_out(&mut k, pid, addr, alenp, ip, port, ofd_v6(k, sk.h));
  if r != 0 {
    return r;
  }
  if flags / MSG_TRUNC % 2 == 1 && full > got {
    return full;                            // MSG_TRUNC: the datagram's real length
  }
  return got;
}

/// The length of the datagram a receive on fd would take, if fd is a UDP
/// or raw socket with one queued, else 0.
fn udp_head(k: &mut Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k) && result <= UDP_MAX
{
  if is_tcp(k, pid, fd) || is_unix(k, pid, fd) || is_nl(k, pid, fd) {
    return 0;
  }
  let sk = sk_look(k, pid, fd);
  if sk.err != 0 {
    return 0;
  }
  return sock_head_len(&mut k.nic, sk.s);
}

/// getsockname (the bound address and port; 0.0.0.0 if bound to none) and
/// getpeername (the connected peer).
fn lx_sockname(k: &mut Kernel, pid: u64, fd: u64, addr: u64, lenp: u64, peer: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  // Linux reports a bad descriptor or an unconnected socket before a bad
  // address or length: those run first, writing nothing (no address).
  let bad = name_args(&mut k, pid, addr, lenp);
  if bad == 0 {
    return sockname_of(&mut k, pid, fd, addr, lenp, peer);
  }
  let r = sockname_of(&mut k, pid, fd, 0, lenp, peer);
  if r != 0 {
    return r;
  }
  return bad;
}

/// getsockname's and getpeername's address and length: EFAULT if the
/// length cannot be read or the address is null, EINVAL if the length is
/// negative, else 0.
fn name_args(k: &mut Kernel, pid: u64, addr: u64, lenp: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, &mut k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  let len = get_u64(k.fs.xfer, 0) % 0x100000000;
  if len >= 0x80000000 {
    return EINVAL;
  }
  if addr == 0 && len != 0 {
    return EFAULT;
  }
  return 0;
}

fn sockname_of(k: &mut Kernel, pid: u64, fd: u64, addr: u64, lenp: u64, peer: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if is_tcp(k, pid, fd) {
    return lx_tcp_name(&mut k, pid, fd, addr, lenp, peer);
  }
  if is_unix(k, pid, fd) {
    return ux_name(&mut k, pid, fd, addr, lenp, peer);
  }
  let q = nl_of(k, pid, fd);
  if q < NLS {
    return nl_name(&mut k, pid, q, addr, lenp, peer);
  }
  let sk = sk_look(k, pid, fd);
  if sk.err != 0 {
    return sk.err;
  }
  let p = of_get(k.ofd, sk.h, 3) / 2;
  if !peer {
    // A connected socket has the source address its route picked, which
    // C libraries read back (getaddrinfo sorts by it).
    let mut me = 0;
    let bound = sock_bound_ip(k, sk.h);
    if bound != 0 && bound <= 4294967295 {
      me = bound;
    } else if p / 65536 != 0 && p / 65536 <= 4294967295 {
      me = local_for(k.nic, p / 65536);
      if is_v6tok(p / 65536) && ofd_v6(k, sk.h) {
        me = V6_SELF;
      }
    }
    return sin_out_m(&mut k, pid, addr, lenp, me, sock_port(k.nic, sk.s), ofd_v6(k, sk.h), ofd_mapped(k, sk.h));
  }
  if p == 0 {
    return ENOTCONN;
  }
  let ip = p / 65536;
  if ip > 4294967295 {
    return ENOTCONN;
  }
  return sin_out_m(&mut k, pid, addr, lenp, ip, p % 65536, ofd_v6(k, sk.h), ofd_mapped(k, sk.h));
}

/// The address this machine sends from to dst (src_ip), or 0.
fn local_for(c: &Nic, dst: u64) -> u64
  requires nic_ok(c) && dst <= 4294967295
  ensures result <= 4294967295
{
  match c {
    Nic::None => {
      if dst / 16777216 == LO_NET {
        return dst;
      }
      return 0;
    },
    Nic::Up(n) => {
      let r = src_ip(n, dst);
      if r <= 4294967295 {
        return r;
      }
      return 0;
    },
  }
}

/// IP_ADD_MEMBERSHIP / IP_DROP_MEMBERSHIP / MCAST_JOIN_GROUP /
/// MCAST_LEAVE_GROUP on an IPv4 socket. The kernel keeps a count of the
/// groups each open file description joined in bits 5..8 of its `inet6`
/// word (only AF_INET6 sockets use that word otherwise, in bits 0..4): a
/// join raises it, a leave on a socket that joined nothing is
/// EADDRNOTAVAIL, as on Linux. Which group was joined is not recorded, so
/// leaving a different group than the joined one still succeeds.
fn mcast_opt(k: &mut Kernel, pid: u64, fd: u64, name: u64, va: u64, ln: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N {
    return EBADF;
  }
  let mut want = 136;
  if name == 35 || name == 36 {
    want = 8;
  }
  if ln < want {
    return EINVAL;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  let w = get(k.inet6, h);
  let n = w / 32 % 16;
  if name == 35 || name == 42 {
    if n >= 15 {
      return ENOBUFS;
    }
    k.inet6 = set(k.inet6, h, w % 32 + 32 * (n + 1));
    return 0;
  }
  if n == 0 {
    return EADDRNOTAVAIL;
  }
  k.inet6 = set(k.inet6, h, w % 32 + 32 * (n - 1));
  return 0;
}

/// setsockopt(fd, level, name, val, len): checked, then ignored
/// (TCP_NODELAY and the like change nothing here; SO_REUSEADDR and a few
/// more only read back). A
/// SOL_SOCKET option needs an int's room and a readable value; IP and
/// IPv6 options go on any internet socket, TCP ones on TCP and UDP ones
/// on UDP; anything else is ENOPROTOOPT.
fn lx_setsockopt(k: &mut Kernel, pid: u64, fd: u64, level: u64, name: u64, va: u64, len: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tcp = is_tcp(k, pid, fd);
  let unix = is_unix(k, pid, fd) || is_nl(k, pid, fd);
  if !tcp && !unix {
    let sk = sk_look(k, pid, fd);
    if sk.err != 0 {
      return sk.err;
    }
  }
  let lv = level % 0x100000000;
  let ln = len % 0x100000000;
  if lv == SOL_SOCKET {
    if ln < 4 || ln >= 0x80000000 {
      return EINVAL;
    }
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, 4) != 4 {
      return EFAULT;
    }
    let bit = sof_of(name);
    let h = fd_ofd(k, pid, fd);
    if bit >= 1 && h < OFD_N {
      sock_flag_set(&mut k, h, bit, get_u64(k.fs.xfer, 0) % 0x100000000 != 0);
    }
    return 0;
  }
  if lv == 41 && name % 0x100000000 == IPV6_V6ONLY && !unix {
    let h = fd_ofd(k, pid, fd);
    if h < OFD_N && ofd_v6(k, h) && !ofd_mapped(k, h) {
      if ln < 4 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, 4) != 4 {
        return EINVAL;
      }
      let only = get_u64(k.fs.xfer, 0) % 0x100000000 != 0;
      let mut mark = 1;
      if only {
        mark = 3;
      }
      k.inet6 = set(k.inet6, h, mark + 8 * ofd_hlim(k, h));
      if !tcp {
        let sk = sk_look(k, pid, fd);
        if sk.err == 0 {
          sock_set_fam(&mut k.nic, sk.s, ofd_fam(k, h));
        }
      }
      return 0;
    }
    return ENOPROTOOPT;                     // an AF_INET socket has no such option
  }
  if lv == 41 && (name % 0x100000000 == IPV6_2292HOPLIMIT || name % 0x100000000 == IPV6_RECVHOPLIMIT) && !unix && !tcp {
    let h = fd_ofd(k, pid, fd);
    if h < OFD_N && ofd_v6(k, h) {
      if ln < 4 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, 4) != 4 {
        return EINVAL;
      }
      let mut mode = 0;
      if get_u64(k.fs.xfer, 0) % 0x100000000 != 0 {
        mode = 1;
        if name % 0x100000000 == IPV6_RECVHOPLIMIT {
          mode = 2;
        }
      }
      k.inet6 = set(k.inet6, h, get(k.inet6, h) % 8 + 8 * mode);
      return 0;
    }
  }
  let nm = name % 0x100000000;
  if lv == 0 && !unix && (nm == 35 || nm == 36 || nm == 42 || nm == 45) {
    return mcast_opt(&mut k, pid, fd, nm, va, ln);
  }
  let inet = !unix && (lv == 0 || lv == 41 || (tcp && lv == SOL_TCP) || (!tcp && (lv == IPPROTO_UDP || lv == IPPROTO_ICMPV6 || lv == SOL_RAW)));
  if !inet || name % 0x100000000 >= 0x80000000 {
    return ENOPROTOOPT;
  }
  return 0;
}

/// getsockopt(fd, level, name, val, lenp): SO_TYPE says stream or
/// datagram; SO_SNDBUF and SO_RCVBUF the buffer sizes; SO_ERROR a refused
/// TCP connect (once); every other option the kernel accepts and ignores
/// (setsockopt) and SO_ERROR otherwise read as 0. Options at other levels than
/// SOL_SOCKET and (on TCP) SOL_TCP are -ENOPROTOOPT.
fn lx_getsockopt(k: &mut Kernel, pid: u64, fd: u64, level: u64, name: u64, va: u64, lenp: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let tcp = is_tcp(k, pid, fd) || is_unix(k, pid, fd);
  if !tcp && !is_nl(k, pid, fd) {
    let sk = sk_look(k, pid, fd);
    if sk.err != 0 {
      return sk.err;
    }
  }
  let v6only_opt = level == 41 && name % 0x100000000 == IPV6_V6ONLY && !is_unix(k, pid, fd) && ofd_v6(k, fd_ofd(k, pid, fd));
  if level != SOL_SOCKET && !(tcp && level == SOL_TCP) && !v6only_opt {
    // As Linux: an internet level this socket has, with an option it
    // does not know, is ENOPROTOOPT; any other level EOPNOTSUPP.
    let inet = !is_unix(k, pid, fd) && (level == 0 || level == 41 || (!tcp && (level == IPPROTO_UDP || level == IPPROTO_ICMPV6 || level == SOL_RAW)));
    if inet || (tcp && level == SOL_TCP) {
      return ENOPROTOOPT;
    }
    return EOPNOTSUPP;
  }
  if level == SOL_TCP && name % 0x100000000 >= 0x80000000 {
    return ENOPROTOOPT;
  }
  if level == SOL_SOCKET && name == 17 {     // SO_PEERCRED: struct ucred
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, &mut k.fs.xfer, 4) != 4 {
      return EFAULT;
    }
    let room = cast[u64](bget(k.fs.xfer, 0)) + 256 * cast[u64](bget(k.fs.xfer, 1)) + 65536 * cast[u64](bget(k.fs.xfer, 2)) + 16777216 * cast[u64](bget(k.fs.xfer, 3));
    if room >= 0x80000000 {
      return EINVAL;
    }
    ux_peercred(&mut k, pid, fd);
    let n = smaller(room, 12);
    if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, n) != n {
      return EFAULT;
    }
    xput(&mut k, 0, n, 4);
    if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, k.fs.xfer, 4) != 4 {
      return EFAULT;
    }
    return 0;
  }
  let mut v = 0;
  if level == SOL_SOCKET && name == SO_TYPE {
    v = 2;                                  // SOCK_DGRAM
    if tcp && !ux_dgram(k, pid, fd) {
      v = 1;                                // SOCK_STREAM
    }
  }
  if level == SOL_SOCKET && name == SO_ERROR && is_tcp(k, pid, fd) {
    v = lx_tcp_soerror(&mut k, pid, fd);
  }
  if level == 41 && name % 0x100000000 == IPV6_V6ONLY {
    let h = fd_ofd(k, pid, fd);
    if !ofd_v6(k, h) {
      return ENOPROTOOPT;
    }
    if ofd_v6only(k, h) {
      v = 1;
    }
  }
  let sof = sof_of(name);
  if level == SOL_SOCKET && sof >= 1 && sock_flag(k, fd_ofd(k, pid, fd), sof) {
    v = 1;
  }
  if level == SOL_SOCKET && (name == SO_SNDBUF || name == SO_RCVBUF) {
    v = 4096;                               // a unix channel; a TCP buffer is as big
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, &mut k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  let room = cast[u64](bget(k.fs.xfer, 0)) + 256 * cast[u64](bget(k.fs.xfer, 1)) + 65536 * cast[u64](bget(k.fs.xfer, 2)) + 16777216 * cast[u64](bget(k.fs.xfer, 3));
  lx_fill(&mut k, 0, 4);
  bset(&mut k.fs.xfer, 0, cast[u8](v % 256));
  bset(&mut k.fs.xfer, 1, cast[u8](v / 256 % 256));
  if room >= 0x80000000 {
    return EINVAL;                          // a negative length
  }
  let n = smaller(room, 4);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, n) != n {
    return EFAULT;
  }
  bset(&mut k.fs.xfer, 0, cast[u8](n));
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  return 0;
}

/// lx_sock_call's getsockopt, setsockopt, accept and shutdown, apart so
/// that each part proves on its own. Returns the result or SK_WAIT.
fn sock_call_rest(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64, d: u64, e: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let mut r = ENOSYS;
  if n == LX_GETSOCKOPT {
    r = lx_getsockopt(&mut k, pid, a, b, c, d, e);
  } else if n == LX_ACCEPT || n == LX_ACCEPT4 {
    let mut fl = 0;
    if n == LX_ACCEPT4 {
      fl = d;
    }
    let sk = sk_look(k, pid, a);
    if is_unix(k, pid, a) {
      r = ux_accept(&mut k, pid, a, b, c, fl);
    } else if sk.err == 0 || is_nl(k, pid, a) {
      r = EOPNOTSUPP;                       // a UDP socket takes no connections
    } else {
      r = lx_accept(&mut k, pid, a, b, c, fl);
    }
  } else if n == LX_SHUTDOWN && is_tcp(k, pid, a) {
    r = lx_tcp_shutdown(&mut k, pid, a, b);
  } else if n == LX_SHUTDOWN && is_unix(k, pid, a) {
    r = ux_shutdown(&mut k, pid, a, b);
  } else if n == LX_SETSOCKOPT {
    r = lx_setsockopt(&mut k, pid, a, b, c, d, e);
  } else if n == LX_SHUTDOWN {
    // Accepted and ignored: shutdown of a datagram socket.
    let sk = sk_look(k, pid, a);
    r = sk.err;
    if is_tcp(k, pid, a) || is_unix(k, pid, a) || is_nl(k, pid, a) {
      r = 0;
    }
  }
  return r;
}

/// The socket system calls. Returns KEEP or SWITCH, as linux_syscall does.
fn lx_sock_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let d = pget(k.procs, pid, F_REGS + R_R10);
  let e = pget(k.procs, pid, F_REGS + R_R8);
  let f = pget(k.procs, pid, F_REGS + R_R9);
  let mut r = ENOSYS;
  let dgram = sk_look(k, pid, a);
  if n == LX_SOCKET {
    r = lx_socket(&mut k, pid, a, b, c);
  } else if n == LX_BIND {
    r = lx_bind(&mut k, pid, a, b, c);
  } else if n == LX_CONNECT {
    r = lx_connect(&mut k, pid, a, b, c);
  } else if n == LX_SENDTO && d % 2 == MSG_OOB && dgram.err == 0 {
    r = EOPNOTSUPP;                         // a datagram has no out-of-band data
  } else if n == LX_SENDTO {
    r = lx_sendto(&mut k, pid, a, b, c, e, f, d);
  } else if n == LX_RECVFROM {
    r = lx_recvfrom(&mut k, pid, a, b, c, d, e, f);
  } else if n == LX_GETSOCKNAME || n == LX_GETPEERNAME {
    r = lx_sockname(&mut k, pid, a, b, c, n == LX_GETPEERNAME);
  } else if n == LX_LISTEN && is_unix(k, pid, a) {
    r = ux_listen(&mut k, pid, a);
  } else if n == LX_LISTEN && (dgram.err == 0 || is_nl(k, pid, a)) {
    r = EOPNOTSUPP;                         // a datagram socket cannot listen
  } else if n == LX_LISTEN {
    r = lx_listen(&mut k, pid, a);
  } else if n == LX_SOCKETPAIR {
    r = EINVAL;
    if sock_kind_ok(b) {
      r = ux_socketpair(&mut k, pid, a, b, c, d);
    }
    if r == EAFNOSUPPORT && a == AF_INET {
      // UDP and TCP have no pairs; any other protocol is unknown.
      r = EPROTONOSUPPORT;
      if (b % 16 == SOCK_DGRAM && (c == 0 || c == IPPROTO_UDP)) || (b % 16 == SOCK_STREAM && (c == 0 || c == 6)) {
        r = EOPNOTSUPP;
      }
    }
  } else {
    r = sock_call_rest(&mut k, pid, n, a, b, c, d, e);
  }
  assert kok(k);                            // a hint for the solver
  if r == SK_WAIT && !is_unix(k, pid, a) && !is_nl(k, pid, a) {
    return sock_retry(&mut k, pid, n);       // nothing yet: sleep until a frame comes in
  }
  if r == SK_WAIT {
    return lx_retry(&mut k, pid, n);         // nothing yet: a datagram, a connection, room
  }
  ret(&mut k.procs, pid, r);
  if r == EPIPE && !(n == LX_SENDTO && d / MSG_NOSIGNAL % 2 == 1) {
    post_sig(&mut k, pid, SIGPIPE);          // the connection cannot send any more
    return SWITCH;
  }
  return KEEP;
}

fn is_sock_call(n: u64) -> bool {
  return n == LX_SOCKET || n == LX_BIND || n == LX_CONNECT || n == LX_SENDTO || n == LX_RECVFROM
    || n == LX_GETSOCKNAME || n == LX_GETPEERNAME || n == LX_SETSOCKOPT || n == LX_GETSOCKOPT || n == LX_SOCKETPAIR || n == LX_LISTEN
    || n == LX_ACCEPT || n == LX_ACCEPT4 || n == LX_SHUTDOWN;
}
