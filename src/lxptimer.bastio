// Linux POSIX timers: timer_create, timer_settime, timer_gettime,
// timer_getoverrun and timer_delete.
//
// Each process has PT_N timers, kept in k.alarms after the ITIMER_REAL
// rows (src/lxtime.bastio): a deadline on k.ns (0: disarmed), an interval,
// and a state word, 0 for a free timer, else (clock + 1) * 128 + the signal
// it sends (0 for SIGEV_NONE), and the overrun count of its last expiry
// (the rounds of its interval that passed unseen, at most INT_MAX). The timer tick (lx_alarms) runs them out.
// A CLOCK_REALTIME timer set to an absolute time keeps PT_ABS in its state
// word, and setting the wall clock moves its deadline (ptimer_clock_set).
// A deadline is on k.ns, or for a CPU-time clock on the process's CPU
// time (pt_now), so such a timer only moves while the process runs.
// Like the itimer, they move with a thread group's shared state
// (src/lxthread.bastio), and exit and execve delete them.
//
// The state word also carries the low 32 bits of sigev_value (times 65536),
// which the signal's siginfo gives back with si_code SI_TIMER.
//
// Not done: SIGEV_THREAD and SIGEV_THREAD_ID are refused (-EINVAL).

import "lxtime.bastio";

const LX_TIMER_CREATE: u64 = 222;
const LX_TIMER_SETTIME: u64 = 223;
const LX_TIMER_GETTIME: u64 = 224;
const LX_TIMER_GETOVERRUN: u64 = 225;
const LX_TIMER_DELETE: u64 = 226;
const SIGEV_SIGNAL: u64 = 0;
const SIGEV_NONE: u64 = 1;
const OVERRUN_MAX: u64 = 2147483647;  // INT_MAX: timer_getoverrun returns an int
const PT_ABS_BIT: u64 = 256;          // the state word's (clock + 1) is below this; PT_ABS_BIT * 128 marks a CLOCK_REALTIME timer set with TIMER_ABSTIME
const PT_ABS: u64 = PT_ABS_BIT * 128;

/// Where word f of timer t of process p is in k.alarms.
fn pt_at(p: u64, t: u64, f: u64) -> u64
  requires p < NPROC && t < PT_N && f < PT_W
  ensures PT_BASE <= result && result < ALARMS_LEN
{
  return PT_BASE + (p * PT_N + t) * PT_W + f;
}

/// Deletes every timer of process p.
fn ptimer_clear(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let mut t = 0;
  while t < PT_N
    invariant t <= PT_N && kok(k)
  {
    k.alarms = set(k.alarms, pt_at(p, t, 0), 0);
    k.alarms = set(k.alarms, pt_at(p, t, 1), 0);
    k.alarms = set(k.alarms, pt_at(p, t, 2), 0);
    k.alarms = set(k.alarms, pt_at(p, t, 3), 0);
    t = t + 1;
  }
}

/// On a timer tick, with k.ns just read: each armed timer that has run out
/// sends its signal and, with an interval, is set going again.
fn ptimer_tick(k: &mut Kernel)
  requires kok(k)
  ensures kok(k)
{
  let cap = smaller(len(k.procs) / STRIDE, k.pid_hi);     // past it, every process is FREE and has no timer
  let mut p = 1;
  while p < cap
    invariant 1 <= p && cap <= NPROC && kok(k)
  {
    let mut t = 0;
    while t < PT_N
      invariant t <= PT_N && 1 <= p && p < cap && cap <= NPROC && kok(k)
    {
      let dl = get(k.alarms, pt_at(p, t, 0));
      let now = pt_now(k, p, t);
      if dl != 0 && now >= dl {
        let s = get(k.alarms, pt_at(p, t, 2)) % 128;
        let iv = get(k.alarms, pt_at(p, t, 1));
        let mut next = 0;
        let mut over = 0;
        if iv != 0 {
          // Rounds that passed before this tick are overruns; the next
          // deadline is the first round after now.
          over = smaller((now - dl) / iv, OVERRUN_MAX);
          if dl == 1 {
            over = OVERRUN_MAX;                 // an absolute time from before boot: the gap is beyond what the deadline can hold
          }
          next = sat_add(now, iv - (now - dl) % iv);
        }
        k.alarms = set(k.alarms, pt_at(p, t, 0), next);
        // While its signal is still pending, an expiry adds to the count
        // of the one waiting instead of sending another, as on Linux.
        let pending = 1 <= s && s <= NSIG && pget(k.procs, p, F_SIGPEND) & sbit(s) != 0;
        if pending {
          let had = smaller(get(k.alarms, pt_at(p, t, 3)), OVERRUN_MAX);
          k.alarms = set(k.alarms, pt_at(p, t, 3), smaller(had + over + 1, OVERRUN_MAX));
        } else {
          k.alarms = set(k.alarms, pt_at(p, t, 3), over);
          if 1 <= s && s <= NSIG {
            post_proc_wv(&mut k, p, s, t + TIMER_MARK + SW_QUEUE, get(k.alarms, pt_at(p, t, 2)) / 65536 % 0x100000000);
          }
        }
      }
      t = t + 1;
    }
    p = p + 1;
  }
}

/// What timer t of process p counts its deadline on: k.ns, or the
/// process's CPU time for a CPU-time clock.
fn pt_now(k: &Kernel, p: u64, t: u64) -> u64
  requires kok(k) && p < NPROC && t < PT_N
{
  let clk = wrap_sub(get(k.alarms, pt_at(p, t, 2)) / 128 % PT_ABS_BIT, 1);
  if clk == CLOCK_PROCESS_CPUTIME_ID || clk == CLOCK_THREAD_CPUTIME_ID {
    return clock_now(k, p, clk);
  }
  return k.ns;
}

/// The timer id names for process pid, or PT_N if it is not one in use.
fn pt_of(k: &Kernel, pid: u64, id: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures result <= PT_N
{
  if id >= PT_N || get(k.alarms, pt_at(pid, id, 2)) == 0 {
    return PT_N;
  }
  return id;
}

/// timer_create(clock, sevp, timerid).
fn lx_timer_create(k: &mut Kernel, pid: u64, clk: u64, sev: u64, idp: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if clk != CLOCK_REALTIME && clk != CLOCK_MONOTONIC && clk != CLOCK_BOOTTIME
    && clk != CLOCK_PROCESS_CPUTIME_ID && clk != CLOCK_THREAD_CPUTIME_ID {
    return EINVAL;
  }
  let mut sig = SIGALRM;
  let mut val = 0;
  if sev != 0 {
    // struct sigevent: sigval (8 bytes), int signo, int notify.
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, sev, &mut k.fs.xfer, 16) != 16 {
      return EFAULT;
    }
    val = get_u64(k.fs.xfer, 0);
    let w = get_u64(k.fs.xfer, 8);
    let notify = w / 0x100000000;
    sig = w % 0x100000000;
    if notify == SIGEV_NONE {
      sig = 0;
    } else if notify != SIGEV_SIGNAL || sig == 0 || sig > NSIG {
      return EINVAL;
    }
  }
  let mut t = 0;
  while t < PT_N && get(k.alarms, pt_at(pid, t, 2)) != 0
    invariant t <= PT_N && kok(k)
  {
    t = t + 1;
  }
  if t >= PT_N {
    return EAGAIN;
  }
  xfer_u64(&mut k.fs.xfer, 0, t);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, idp, k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  k.alarms = set(k.alarms, pt_at(pid, t, 0), 0);
  k.alarms = set(k.alarms, pt_at(pid, t, 1), 0);
  if sev == 0 {
    val = t;                                // sigev_value is the timer's id, as on Linux
  }
  k.alarms = set(k.alarms, pt_at(pid, t, 2), (clk + 1) * 128 + sig + 65536 * (val % 0x100000000));
  k.alarms = set(k.alarms, pt_at(pid, t, 3), 0);
  return 0;
}

/// Writes timer t's struct itimerspec to va: the interval, then the time
/// left until it next fires (0: disarmed).
fn pt_out(k: &mut Kernel, pid: u64, t: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC && t < PT_N
  ensures kok(k)
{
  if va > VA_LAST {
    return EFAULT;
  }
  let dl = get(k.alarms, pt_at(pid, t, 0));
  let iv = get(k.alarms, pt_at(pid, t, 1));
  let now = pt_now(k, pid, t);
  let mut left = 0;
  if dl != 0 && now < dl {
    left = dl - now;
  }
  if time_out(&mut k, pid, va, iv, 1) != 0 {
    return EFAULT;
  }
  return time_out(&mut k, pid, va + 16, left, 1);
}

/// timer_settime(id, flags, new, old).
fn lx_timer_settime(k: &mut Kernel, pid: u64, id: u64, flags: u64, nv: u64, ov: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let t = pt_of(k, pid, id);
  if t >= PT_N || flags > TIMER_ABSTIME || nv == 0 {
    return EINVAL;                          // no such timer, a bad flag, or no new setting
  }
  if nv > VA_LAST {
    return EFAULT;
  }
  let iv = ts_in(&mut k, pid, nv);
  if iv.err != 0 {
    return iv.err;
  }
  let val = ts_in(&mut k, pid, nv + 16);
  if val.err != 0 {
    return val.err;
  }
  if ov != 0 && pt_out(&mut k, pid, t, ov) != 0 {
    return EFAULT;
  }
  let mut dl = 0;
  if val.ns != 0 {
    let now = clock_now(k, pid, wrap_sub(get(k.alarms, pt_at(pid, t, 2)) / 128 % PT_ABS_BIT, 1));
    let base = pt_now(k, pid, t);
    if flags & TIMER_ABSTIME == 0 {
      dl = sat_add(base, val.ns);
    } else if now == FOREVER {
      dl = base;
    } else if val.ns <= now {
      // Already past: it fires at once, and with an interval the rounds
      // since val count as overruns.
      if now - val.ns < base {
        dl = base - (now - val.ns);
      } else {
        dl = 1;
      }
    } else {
      dl = sat_add(base, val.ns - now);
    }
    if dl == 0 {
      dl = 1;                               // 0 means disarmed
    }
  }
  k.alarms = set(k.alarms, pt_at(pid, t, 0), dl);
  k.alarms = set(k.alarms, pt_at(pid, t, 1), iv.ns);
  k.alarms = set(k.alarms, pt_at(pid, t, 3), 0);
  // Only a REALTIME timer set to an absolute time follows the wall clock.
  let st = get(k.alarms, pt_at(pid, t, 2));
  let mut kept = st % PT_ABS + st / (PT_ABS * 2) * (PT_ABS * 2);
  if flags & TIMER_ABSTIME != 0 && dl != 0 && wrap_sub(st / 128 % PT_ABS_BIT, 1) == CLOCK_REALTIME {
    kept = kept + PT_ABS;
  }
  k.alarms = set(k.alarms, pt_at(pid, t, 2), kept);
  return 0;
}

/// The wall clock was set from epoch `was_ep` to k.epoch: the deadline of each
/// armed absolute CLOCK_REALTIME timer is a wall time, so on k.ns it moves
/// the other way, and a timer whose time has now passed runs out at once.
fn ptimer_clock_set(k: &mut Kernel, was_ep: u64)
  requires kok(k)
  ensures kok(k)
{
  let cap = smaller(len(k.procs) / STRIDE, k.pid_hi);
  let mut p = 1;
  while p < cap
    invariant 1 <= p && cap <= NPROC && kok(k)
  {
    let mut t = 0;
    while t < PT_N
      invariant t <= PT_N && 1 <= p && p < cap && cap <= NPROC && kok(k)
    {
      let dl = get(k.alarms, pt_at(p, t, 0));
      if dl != 0 && get(k.alarms, pt_at(p, t, 2)) / PT_ABS % 2 == 1 {
        let mut nd = 1;
        if k.epoch >= was_ep {
          if dl > k.epoch - was_ep {
            nd = dl - (k.epoch - was_ep);
          }
        } else {
          nd = sat_add(dl, was_ep - k.epoch);
        }
        k.alarms = set(k.alarms, pt_at(p, t, 0), nd);
      }
      t = t + 1;
    }
    p = p + 1;
  }
}

fn is_ptimer_call(n: u64) -> bool {
  return LX_TIMER_CREATE <= n && n <= LX_TIMER_DELETE;
}

/// POSIX timer system call n of process pid.
fn lx_ptimer_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64, r10: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut r = 0;
  if n == LX_TIMER_CREATE {
    r = lx_timer_create(&mut k, pid, a, b, c);
  } else if n == LX_TIMER_SETTIME {
    r = lx_timer_settime(&mut k, pid, a % 0x100000000, b, c, r10);
  } else {
    let t = pt_of(k, pid, a % 0x100000000);
    if t >= PT_N {
      r = EINVAL;
    } else if n == LX_TIMER_GETTIME {
      r = pt_out(&mut k, pid, t, b);
    } else if n == LX_TIMER_DELETE {
      k.alarms = set(k.alarms, pt_at(pid, t, 0), 0);
      k.alarms = set(k.alarms, pt_at(pid, t, 1), 0);
      k.alarms = set(k.alarms, pt_at(pid, t, 2), 0);
      k.alarms = set(k.alarms, pt_at(pid, t, 3), 0);
    } else {
      r = get(k.alarms, pt_at(pid, t, 3));  // timer_getoverrun
    }
  }
  ret(&mut k.procs, pid, r);
  return KEEP;
}
