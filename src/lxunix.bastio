// Linux AF_UNIX stream sockets: socketpair, and bind / listen / connect /
// accept on a name. A socket names an open file description of kind
// OF_UNIX; its word 3 is nonblocking (bit 0) plus 2 * mode plus 16 for a
// datagram socket (SOCK_DGRAM or SOCK_SEQPACKET), and its word 2 depends
// on the mode:
//   UM_NEW     nothing yet
//   UM_BOUND   bound to a name: the listener slot holding it
//   UM_LISTEN  listening: the same slot
//   UM_CONN    connected: rx + UX_N * tx, the channels it reads and writes
//   UM_DGRAM   a datagram socket from socket(): own + 8 * peer + 64 * stamp,
//              where own is 1 + the slot it is bound to (0: unbound) and
//              peer is 1 + the slot it is connected to (0: none), bound
//              at `stamp`, so a slot freed and bound again is not taken
//              for the old peer
//
// A slot of a bound datagram socket (UL_DGRAM) holds no backlog: its
// word 2 is the channel every sender to the name writes into and the
// socket reads, and word 3 the stamp of the bind.
//
// k.ux holds UX_N channels of UX_W words (head, count, read end open:
// 1, or 2 once shut for reading; write end open: 1, or 2 once shut for
// writing), then UX_LIS listener slots of UXL_W words (state,
// name length, backlog head, backlog count, then UX_BACKLOG descriptions
// waiting to be accepted), then one word per channel: a description sent
// over it with SCM_RIGHTS and not yet received (its number + 1), or 0.
// Then two words per channel, the credentials of the process at its
// write end (pid, then effective uid + 2^32 * effective gid), and two per
// listener slot, those of the process that called listen: SO_PEERCRED.
// Last, one word per listener slot: the socket file it is bound to (its
// file handle + 1), or 0 for a name in the abstract namespace.
// k.uxb holds each channel's ring of UX_CAP bytes, then each slot's name.
// A datagram channel keeps each message as its length (two bytes, low
// first), the sender's slot + 1 (0: no name), and then its bytes.
//
// A name that starts with a byte other than 0 is a path. bind makes a
// socket file there (type S_IFSOCK, rwxrwxrwx less the umask, owned by its
// maker), with the same checks as making any file, and keeps the path the
// name resolves to in the slot; connect resolves its name the same way and
// needs write permission on the socket file, as on Linux, so chmod on the
// file says who may connect. connect finds the socket by the file, not
// by its path, so a socket file that is renamed or has another hard link
// still leads to its socket, as on Linux. The file outlives the socket, as
// on Linux: a program removes it before binding the name again. A name
// that starts with 0 is in Linux's abstract namespace: no file and no
// permissions, matched byte for byte.
//
// Different from Linux: a datagram receiver learns the sender's name from
// its slot when it reads, so a sender that closed by then shows as
// unnamed; and no descriptors or credentials travel with datagrams to a
// name. A name reads back (in getsockname and recvfrom) as the canonical
// path, not as bound.

import "linux.bastio";

const AF_UNIX: u64 = 1;
const UM_NEW: u64 = 0;
const UM_BOUND: u64 = 1;
const UM_LISTEN: u64 = 2;
const UM_CONN: u64 = 3;
const UL_FREE: u64 = 0;
const UL_BOUND: u64 = 1;
const UL_LISTEN: u64 = 2;
const UL_DGRAM: u64 = 3;
const UM_DGRAM: u64 = 4;
const STAMP_SPAN: u64 = 1099511627776;  // 2^40: bind stamps are below it
const EPROTOTYPE: u64 = 18446744073709551525;      // 2^64 - 91
const UXL0: u64 = 64;                  // UX_N * UX_W: the first listener word
const UXP0: u64 = 65536;               // UX_N * UX_CAP: the first name byte
const UXF0: u64 = 96;                  // UXL0 + UX_LIS * UXL_W: the in-flight words
const UXC0: u64 = 112;                 // UXF0 + UX_N: the channels' credentials
const UXLC0: u64 = 144;                // UXC0 + 2 * UX_N: the listeners' credentials
const UXH0: u64 = 152;                 // UXLC0 + 2 * UX_LIS: the listeners' socket files
const SO_PEERCRED: u64 = 17;
const UX_DG: u64 = 16;                 // word 3: a datagram socket
const SUN_LEN: u64 = 110;              // sizeof(struct sockaddr_un)
const ECONNABORTED: u64 = 18446744073709551513;    // 2^64 - 103

// A unix socket descriptor: description h, word 2 x, nonblocking, mode;
// or err.
struct Ux { err: u64, h: u64, x: u64, nb: u64, mode: u64, dg: bool }

fn uc_get(k: &Kernel, c: u64, f: u64) -> u64
  requires kok(k) && c < UX_N && f < UX_W
{
  return get(k.ux, c * UX_W + f);
}

fn uc_set(k: &mut Kernel, c: u64, f: u64, v: u64)
  requires kok(k) && c < UX_N && f < UX_W
  ensures kok(k)
{
  k.ux = set(k.ux, c * UX_W + f, v);
}

/// Channel c's head and count as a core Ring over its UX_CAP bytes of
/// k.uxb. The stored words are clamped, so the ring is well formed
/// whatever they hold.
fn uc_ring(k: &Kernel, c: u64) -> Ring
  requires kok(k) && c < UX_N
  ensures ring_ok(result) && result.cap == UX_CAP
{
  return Ring { h: uc_get(k, c, 0) % UX_CAP, n: smaller(uc_get(k, c, 1), UX_CAP), cap: UX_CAP };
}

/// Stores ring r back as channel c's head and count.
fn uc_keep(k: &mut Kernel, c: u64, r: &Ring)
  requires kok(k) && c < UX_N
  ensures kok(k)
{
  uc_set(&mut k, c, 0, r.h);
  uc_set(&mut k, c, 1, r.n);
}

fn ul_get(k: &Kernel, l: u64, f: u64) -> u64
  requires kok(k) && l < UX_LIS && f < UXL_W
{
  return get(k.ux, UXL0 + l * UXL_W + f);
}

fn ul_set(k: &mut Kernel, l: u64, f: u64, v: u64)
  requires kok(k) && l < UX_LIS && f < UXL_W
  ensures kok(k)
{
  k.ux = set(k.ux, UXL0 + l * UXL_W + f, v);
}

/// Listener l's backlog head and count as a core Ring over its
/// UX_BACKLOG description words (clamped, so always well formed).
fn ul_ring(k: &Kernel, l: u64) -> Ring
  requires kok(k) && l < UX_LIS
  ensures ring_ok(result) && result.cap == UX_BACKLOG
{
  return Ring { h: ul_get(k, l, 2) % UX_BACKLOG, n: smaller(ul_get(k, l, 3), UX_BACKLOG), cap: UX_BACKLOG };
}

/// Stores ring r back as listener l's backlog head and count.
fn ul_keep(k: &mut Kernel, l: u64, r: &Ring)
  requires kok(k) && l < UX_LIS
  ensures kok(k)
{
  ul_set(&mut k, l, 2, r.h);
  ul_set(&mut k, l, 3, r.n);
}

/// The description in flight on channel c (SCM_RIGHTS): its number + 1,
/// or 0.
fn uc_fly(k: &Kernel, c: u64) -> u64
  requires kok(k) && c < UX_N
{
  return get(k.ux, UXF0 + c);
}

fn uc_set_fly(k: &mut Kernel, c: u64, v: u64)
  requires kok(k) && c < UX_N
  ensures kok(k)
{
  k.ux = set(k.ux, UXF0 + c, v);
}

/// Process pid's credentials as SO_PEERCRED reports them: effective uid
/// + 2^32 * effective gid.
fn ux_ids(k: &Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
{
  return pget(k.procs, pid, F_UID) / 0x100000000 + 0x100000000 * (pget(k.procs, pid, F_GID) / 0x100000000);
}

/// Process pid writes into channel c.
fn uc_set_cred(k: &mut Kernel, c: u64, pid: u64, ids: u64)
  requires kok(k) && c < UX_N
  ensures kok(k)
{
  k.ux = set(k.ux, UXC0 + 2 * c, pid);
  k.ux = set(k.ux, UXC0 + 2 * c + 1, ids);
}

/// getsockopt(SO_PEERCRED) on unix socket fd: struct ucred of the process
/// at the other end (as it was when it connected, or listened) into
/// xfer[0..12]. A socket with no peer gets pid 0 and the overflow ids, as
/// on Linux.
fn ux_peercred(k: &mut Kernel, pid: u64, fd: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let u = ux_look(k, pid, fd);
  let mut p = 0;
  let mut ids = 65534 + 0x100000000 * 65534;
  if u.err == 0 && u.mode == UM_CONN {
    let rx = u.x % UX_N;
    p = get(k.ux, UXC0 + 2 * rx);
    ids = get(k.ux, UXC0 + 2 * rx + 1);
  }
  xput(&mut k, 0, p, 4);
  xput(&mut k, 4, ids % 0x100000000, 4);
  xput(&mut k, 8, ids / 0x100000000, 4);
}

fn ux_look(k: &Kernel, pid: u64, fd: u64) -> Ux
  requires kok(k) && pid < NPROC
  ensures result.err == 0 ==> (result.h < OFD_N && result.nb <= 1 && result.mode <= UM_DGRAM)
  ensures result.err == 0 && result.mode == UM_DGRAM ==> (result.x % 8 <= UX_LIS && result.x / 8 % 8 <= UX_LIS && result.dg)
  ensures result.err == 0 && result.mode == UM_CONN ==> result.x < UX_N * UX_N
  ensures result.err == 0 && (result.mode == UM_BOUND || result.mode == UM_LISTEN) ==> result.x < UX_LIS
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  if v == 0 {
    return Ux { err: EBADF, h: 0, x: 0, nb: 0, mode: 0, dg: false };
  }
  let none = Ux { err: ENOTSOCK, h: 0, x: 0, nb: 0, mode: 0, dg: false };
  if v < FD_OFD || v - FD_OFD >= OFD_N {
    return none;
  }
  let h = v - FD_OFD;
  if of_get(k.ofd, h, 0) != OF_UNIX {
    return none;
  }
  let w = of_get(k.ofd, h, 3);
  let x = of_get(k.ofd, h, 2);
  let mode = w / 2 % 8;
  let dg = w / UX_DG % 2 == 1;
  if mode > UM_DGRAM || (mode == UM_CONN && x >= UX_N * UX_N)
    || ((mode == UM_BOUND || mode == UM_LISTEN) && x >= UX_LIS)
    || (mode == UM_DGRAM && (x % 8 > UX_LIS || x / 8 % 8 > UX_LIS || !dg)) {
    return none;
  }
  return Ux { err: 0, h: h, x: x, nb: w % 2, mode: mode, dg: dg };
}

/// A datagram (or seqpacket) unix socket.
fn ux_dgram(k: &Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let u = ux_look(k, pid, fd);
  return u.err == 0 && u.dg;
}

fn is_unix(k: &Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  return v >= FD_OFD && v - FD_OFD < OFD_N && of_get(k.ofd, v - FD_OFD, 0) == OF_UNIX;
}

/// A free channel, open at both ends and empty; UX_N if none is free.
fn uc_new(k: &mut Kernel) -> u64
  requires kok(k)
  ensures kok(k) && result <= UX_N
{
  let mut c = 0;
  while c < UX_N && (uc_get(k, c, 2) != 0 || uc_get(k, c, 3) != 0)
    invariant c <= UX_N
  {
    c = c + 1;
  }
  if c >= UX_N {
    return UX_N;
  }
  uc_set(&mut k, c, 0, 0);
  uc_set(&mut k, c, 1, 0);
  uc_set(&mut k, c, 2, 1);
  uc_set(&mut k, c, 3, 1);
  uc_set_fly(&mut k, c, 0);
  return c;
}

/// Two descriptions joined to each other, each OF_UNIX and connected:
/// 2^32 * b + a, or OFD_N if channels or descriptions ran out.
fn ux_pair(k: &mut Kernel, nb: u64, dg: u64) -> u64
  requires kok(k) && nb <= 1 && (dg == 0 || dg == UX_DG)
  ensures kok(k)
  ensures result != OFD_N ==> (result % 4294967296 < OFD_N && result / 4294967296 < OFD_N)
{
  let c1 = uc_new(&mut k);
  if c1 >= UX_N {
    return OFD_N;
  }
  let c2 = uc_new(&mut k);
  if c2 >= UX_N {
    uc_set(&mut k, c1, 2, 0);
    uc_set(&mut k, c1, 3, 0);
    return OFD_N;
  }
  let a = ofd_new(&mut k, OF_UNIX, c1 + UX_N * c2);
  let b = ofd_new(&mut k, OF_UNIX, c2 + UX_N * c1);
  if a >= OFD_N || b >= OFD_N {
    if a < OFD_N {
      of_set(&mut k.ofd, a, 0, OF_FREE);
      of_set(&mut k.ofd, a, 1, 0);
    }
    if b < OFD_N {
      of_set(&mut k.ofd, b, 0, OF_FREE);
      of_set(&mut k.ofd, b, 1, 0);
    }
    uc_set(&mut k, c1, 2, 0);
    uc_set(&mut k, c1, 3, 0);
    uc_set(&mut k, c2, 2, 0);
    uc_set(&mut k, c2, 3, 0);
    return OFD_N;
  }
  of_set(&mut k.ofd, a, 3, nb + 2 * UM_CONN + dg);
  of_set(&mut k.ofd, b, 3, nb + 2 * UM_CONN + dg);
  return a + 4294967296 * b;
}

/// The last reference to description h (OF_UNIX, word 2 x, word 3 w) is
/// gone: a connection closes its read end and its write end; a bound or
/// listening socket frees its name, and closes every connection still
/// waiting to be accepted. Returns the descriptor value of a description
/// that was in flight to the closed read end, for the caller to drop
/// (unref_value), or 0.
fn ux_close(k: &mut Kernel, x: u64, w: u64) -> u64
  requires kok(k)
  ensures kok(k)
{
  let mode = w / 2 % 8;
  if mode == UM_DGRAM && x % 8 >= 1 && x % 8 <= UX_LIS {
    // A bound datagram socket: its name and its channel go, with any
    // datagrams nobody read.
    let l = x % 8 - 1;
    let c = ul_get(k, l, 2);
    if ul_get(k, l, 0) == UL_DGRAM && c < UX_N {
      uc_set(&mut k, c, 2, 0);
      uc_set(&mut k, c, 3, 0);
    }
    ul_set(&mut k, l, 0, UL_FREE);
    ul_set(&mut k, l, 3, 0);
    return 0;
  }
  if mode == UM_CONN && x < UX_N * UX_N {
    let rx = x % UX_N;
    uc_set(&mut k, rx, 2, 0);             // nobody reads what comes in
    uc_set(&mut k, x / UX_N, 3, 0);       // nobody writes what goes out
    let f = uc_fly(k, rx);
    uc_set_fly(&mut k, rx, 0);
    if f > 0 && f <= OFD_N {
      return FD_OFD + f - 1;              // nobody will receive it now
    }
    return 0;
  } else if (mode == UM_BOUND || mode == UM_LISTEN) && x < UX_LIS {
    let r = ul_ring(k, x);
    let count = r.n;
    let mut i = 0;
    while i < count
      invariant i <= count && count == r.n && ring_ok(r) && r.cap == UX_BACKLOG && kok(k) && x < UX_LIS
    {
      let h = ul_get(k, x, 4 + ring_slot(r, i));
      // Only the backlog holds a reference to a connection not yet
      // accepted: close it here.
      if h < OFD_N && of_get(k.ofd, h, 0) == OF_UNIX {
        let cx = of_get(k.ofd, h, 2);
        if cx < UX_N * UX_N {
          uc_set(&mut k, cx % UX_N, 2, 0);
          uc_set(&mut k, cx / UX_N, 3, 0);
          // A description sent to it before the accept loses a
          // reference; if that was its last, it stays allocated (a
          // leak, bounded by the table; Linux has a collector for this).
          let f = uc_fly(k, cx % UX_N);
          if f > 0 && f <= OFD_N {
            let refs = of_get(k.ofd, f - 1, 1);
            if refs > 1 {
              of_set(&mut k.ofd, f - 1, 1, refs - 1);
            }
          }
          uc_set_fly(&mut k, cx % UX_N, 0);
        }
        of_set(&mut k.ofd, h, 0, OF_FREE);
        of_set(&mut k.ofd, h, 1, 0);
      }
      i = i + 1;
    }
    ul_set(&mut k, x, 0, UL_FREE);
    ul_set(&mut k, x, 3, 0);
  }
  return 0;
}

/// socket(AF_UNIX, SOCK_STREAM or SOCK_DGRAM, 0).
fn ux_socket(k: &mut Kernel, pid: u64, kind: u64, proto: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if (kind % 16 != SOCK_STREAM && kind % 16 != SOCK_DGRAM) || proto != 0 {
    return EPROTONOSUPPORT;
  }
  let h = ofd_new(&mut k, OF_UNIX, 0);
  if h >= OFD_N {
    return ENFILE;
  }
  let mut w = 2 * UM_NEW;
  if kind % 16 == SOCK_DGRAM {
    w = 2 * UM_DGRAM + UX_DG;
  }
  of_set(&mut k.ofd, h, 3, kind / SOCK_NONBLOCK % 2 + w);
  let fd = fd_install(&mut k, pid, h);
  if fd < LXNFD && kind / SOCK_CLOEXEC % 2 == 1 {
    fd_set(&mut k.lxfd, pid, fd, FD_OFD + h + FD_CLOEXEC);
  }
  return fd;
}

/// socketpair(AF_UNIX, SOCK_STREAM, SOCK_DGRAM or SOCK_SEQPACKET, 0, sv):
/// two connected sockets. The last two keep message boundaries.
fn ux_socketpair(k: &mut Kernel, pid: u64, domain: u64, kind: u64, proto: u64, sv: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if domain != AF_UNIX {
    return EAFNOSUPPORT;
  }
  let ty = kind % 16;
  if (ty != SOCK_STREAM && ty != SOCK_DGRAM && ty != SOCK_SEQPACKET) || proto != 0 {
    return EPROTONOSUPPORT;
  }
  let mut dg = 0;
  if ty != SOCK_STREAM {
    dg = UX_DG;
  }
  let a = fd_free(k, pid, 0);
  if a >= LXNFD {
    return EMFILE;
  }
  let b = fd_free(k, pid, a + 1);
  if b >= LXNFD {
    return EMFILE;
  }
  lx_fill(&mut k, 0, 8);
  bset(&mut k.fs.xfer, 0, cast[u8](a));
  bset(&mut k.fs.xfer, 4, cast[u8](b));
  if lx_put_out(&mut k, pid, sv, 8) != 0 {
    return EFAULT;
  }
  let p = ux_pair(&mut k, kind / SOCK_NONBLOCK % 2, dg);
  if p == OFD_N {
    return ENFILE;
  }
  let mut ce = 0;
  if kind / SOCK_CLOEXEC % 2 == 1 {
    ce = FD_CLOEXEC;
  }
  fd_set(&mut k.lxfd, pid, a, FD_OFD + p % 4294967296 + ce);
  fd_set(&mut k.lxfd, pid, b, FD_OFD + p / 4294967296 + ce);
  let x = of_get(k.ofd, p % 4294967296, 2);
  uc_set_cred(&mut k, x % UX_N, pid, ux_ids(k, pid));
  uc_set_cred(&mut k, x / UX_N % UX_N, pid, ux_ids(k, pid));
  return 0;
}

/// Reads the name in the struct sockaddr_un at user address va (alen bytes
/// long) into the transfer buffer: its length (up to the first NUL, or
/// all of it for an abstract name, which starts with one), or an error.
fn sun_in(k: &mut Kernel, pid: u64, va: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result <= UX_PATH || result >= 18446744073709547520   // -4096: an error
{
  if alen <= 2 || alen > SUN_LEN {
    return EINVAL;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, alen) != alen {
    return EFAULT;
  }
  if cast[u64](bget(k.fs.xfer, 0)) + 256 * cast[u64](bget(k.fs.xfer, 1)) != AF_UNIX {
    return EAFNOSUPPORT;
  }
  let mut n = alen - 2;
  if bget(k.fs.xfer, 2) != 0 {
    let mut i = 0;
    while i < alen - 2 && bget(k.fs.xfer, 2 + i) != 0
      invariant i <= alen - 2 && alen <= SUN_LEN && kok(k)
    {
      i = i + 1;
    }
    n = i;
  }
  if n == 0 || n > UX_PATH || n + 2 > alen {
    return EINVAL;
  }
  // Move the name to the front of the transfer buffer.
  let mut j = 0;
  while j < n
    invariant j <= n && n <= UX_PATH && kok(k)
  {
    bset(&mut k.fs.xfer, j, bget(k.fs.xfer, j + 2));
    j = j + 1;
  }
  return n;
}

/// The slot whose name is the first n transfer bytes, or UX_LIS.
fn ul_find(k: &Kernel, n: u64) -> u64
  requires kok(k) && n <= UX_PATH
  ensures result <= UX_LIS
{
  let mut l = 0;
  while l < UX_LIS
    invariant l <= UX_LIS
  {
    if ul_get(k, l, 0) != UL_FREE && ul_get(k, l, 1) == n {
      let mut i = 0;
      while i < n && bget(k.uxb, UXP0 + l * UX_PATH + i) == bget(k.fs.xfer, i)
        invariant i <= n && n <= UX_PATH && l < UX_LIS
      {
        i = i + 1;
      }
      if i == n {
        return l;
      }
    }
    l = l + 1;
  }
  return UX_LIS;
}

/// The listener slot bound to socket file h, or UX_LIS.
fn ul_find_file(k: &Kernel, h: u64) -> u64
  requires kok(k)
  ensures result <= UX_LIS
{
  if h >= HFILES {
    return UX_LIS;
  }
  let mut l = 0;
  while l < UX_LIS
    invariant l <= UX_LIS
  {
    if ul_get(k, l, 0) != UL_FREE && get(k.ux, UXH0 + l) == h + 1 {
      return l;
    }
    l = l + 1;
  }
  return UX_LIS;
}

/// The socket file at canonical path xfer[0..n] (the transfer buffer is
/// kept): its handle, or NO_FILE.
fn ux_file(k: &mut Kernel, n: u64) -> u64
  requires kok(k) && n <= UX_PATH && UX_PATH <= FNAME_MAX
  ensures kok(k)
{
  let mut t = balloc(2 * FNAME_MAX);
  xfer_save(k, &mut t, 0, n);
  let h = vfs_lookup(&mut k.fs, n);
  xfer_load(&mut k, t, 0, n);
  bfree(t);
  return h;
}

/// Loop mount gone (src/lxmount.bastio): sockets bound to files in it
/// are found by no file now. Another image could put a socket file of
/// its own at the same handle.
fn ux_forget_loop(k: &mut Kernel)
  requires kok(k)
  ensures kok(k)
{
  let mut l = 0;
  while l < UX_LIS
    invariant l <= UX_LIS && kok(k)
  {
    if get(k.ux, UXH0 + l) > LO0 {
      k.ux = set(k.ux, UXH0 + l, 0);
      ul_set(&mut k, l, 1, UX_PATH + 1);
    }
    l = l + 1;
  }
}

/// For a path name (sun_in has put it at the start of the transfer
/// buffer): resolves the path at sockaddr va + 2 from the working
/// directory, through links on the way (and the last one too unless
/// `bind`), checking search permission. The canonical path is then the
/// first `result` transfer bytes; or an error.
fn ux_resolve(k: &mut Kernel, pid: u64, va: u64, bind: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures (1 <= result && result <= UX_PATH) || result >= 18446744073709547520
{
  if va > 0xFFFFFFFFFFFF0000 {
    return EFAULT;
  }
  let mut n = NO_RESULT;
  if bind {
    n = lx_path_at_nf(&mut k, pid, AT_FDCWD, va + 2);
  } else {
    n = lx_path_at(&mut k, pid, AT_FDCWD, va + 2);
  }
  if n == NO_RESULT {
    if k.perr < 18446744073709547520 {
      return EINVAL;
    }
    return k.perr;
  }
  if n == 0 {
    return ENOENT;
  }
  if n > UX_PATH {
    return ENAMETOOLONG;                    // the canonical path does not fit a slot
  }
  return n;
}

/// bind on a path name, at canonical path xfer[0..n]: makes the socket
/// file. 0 or an error; the transfer buffer still starts with the path.
fn ux_mkfile(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && 1 <= n && n <= UX_PATH && UX_PATH <= FNAME_MAX
  ensures kok(k)
{
  let mut t = balloc(2 * FNAME_MAX);
  xfer_save(k, &mut t, 0, n);
  let there = path_meta(&mut k, n);
  xfer_load(&mut k, t, 0, n);
  let mut e = 0;
  if there.ok {
    e = EADDRINUSE;                         // a file, or a socket file left behind
  } else if path_ro(&mut k, n) {
    e = EROFS;
  } else {
    e = may_dir(&mut k, pid, n);
  }
  if e == 0 {
    xfer_load(&mut k, t, 0, n);
    let own = new_owner(&mut k, pid, n);
    xfer_load(&mut k, t, 0, n);
    if !vfs_mknode(&mut k.fs, &mut k.mem, n, T_SOCK + 511) {
      e = ENOENT;                           // no such directory, or no room
    } else {
      xfer_load(&mut k, t, 0, n);
      let h = vfs_lookup(&mut k.fs, n);
      if h != NO_FILE {
        made_by(&mut k, pid, h, own, 511, false);   // the umask and owner (src/lxperm.bastio)
      }
    }
  }
  xfer_load(&mut k, t, 0, n);
  bfree(t);
  return e;
}

/// connect on a path name, at canonical path xfer[0..n]: the file must be
/// a socket file the caller may write. 0 or an error; the transfer buffer
/// still starts with the path.
fn ux_may_connect(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= UX_PATH && UX_PATH <= FNAME_MAX
  ensures kok(k)
{
  let mut t = balloc(2 * FNAME_MAX);
  xfer_save(k, &mut t, 0, n);
  let m = path_meta(&mut k, n);
  xfer_load(&mut k, t, 0, n);
  bfree(t);
  if !m.ok {
    return ENOENT;
  }
  if m.mode % 65536 / 4096 * 4096 != T_SOCK {
    return ECONNREFUSED;                    // not a socket
  }
  if !may_meta(k.procs, pid, m.mode, m.own, MAY_W) {
    return EACCES;
  }
  return 0;
}

/// bind on a unix socket: claims the name.
fn ux_bind(k: &mut Kernel, pid: u64, fd: u64, addr: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let u = ux_look(k, pid, fd);
  if u.err != 0 {
    return u.err;
  }
  if u.mode != UM_NEW && (u.mode != UM_DGRAM || u.x % 8 != 0) {
    return EINVAL;                          // bound already, or connected
  }
  let mut n = sun_in(&mut k, pid, addr, alen);
  if n > UX_PATH {
    return n;
  }
  let mut l = 0;
  while l < UX_LIS && ul_get(k, l, 0) != UL_FREE
    invariant l <= UX_LIS
  {
    l = l + 1;
  }
  if l >= UX_LIS {
    return ENOBUFS;
  }
  // A datagram socket reads from a channel of its own.
  let mut c = UX_N;
  if u.mode == UM_DGRAM {
    c = uc_new(&mut k);
    if c >= UX_N {
      return ENOBUFS;
    }
  }
  let e = ux_claim(&mut k, pid, addr, n);
  if e > UX_PATH {
    if c < UX_N {
      uc_set(&mut k, c, 2, 0);
      uc_set(&mut k, c, 3, 0);
    }
    return e;
  }
  n = e;
  // A path name's socket file: connect and sendto find the socket by it.
  let mut file = NO_FILE;
  if bget(k.fs.xfer, 0) != 0 {
    file = ux_file(&mut k, n);
  }
  if file < HFILES {
    k.ux = set(k.ux, UXH0 + l, file + 1);
  } else {
    k.ux = set(k.ux, UXH0 + l, 0);
  }
  let mut i = 0;
  while i < n
    invariant i <= n && n <= UX_PATH && l < UX_LIS && kok(k)
  {
    bset(&mut k.uxb, UXP0 + l * UX_PATH + i, bget(k.fs.xfer, i));
    i = i + 1;
  }
  ul_set(&mut k, l, 1, n);
  if c < UX_N {
    let stamp = k.ns % (STAMP_SPAN - 1) + 1;   // never 0
    ul_set(&mut k, l, 0, UL_DGRAM);
    ul_set(&mut k, l, 2, c);
    ul_set(&mut k, l, 3, stamp);
    of_set(&mut k.ofd, u.h, 2, u.x + l + 1);
    return 0;
  }
  ul_set(&mut k, l, 0, UL_BOUND);
  ul_set(&mut k, l, 2, 0);
  ul_set(&mut k, l, 3, 0);
  of_set(&mut k.ofd, u.h, 2, l);
  of_set(&mut k.ofd, u.h, 3, u.nb + 2 * UM_BOUND);
  return 0;
}

/// bind's name, which sun_in left at the start of the transfer buffer
/// (n bytes): a path name gets its socket file (and a socket still bound
/// to a file removed since loses the name); an abstract name must be
/// free. The name's length, or an error; the name is then at the start of
/// the transfer buffer.
fn ux_claim(k: &mut Kernel, pid: u64, addr: u64, n0: u64) -> u64
  requires kok(k) && pid < NPROC && n0 <= UX_PATH
  ensures kok(k)
  ensures result <= UX_PATH || result >= 18446744073709547520
{
  let mut n = n0;
  if bget(k.fs.xfer, 0) != 0 {
    n = ux_resolve(&mut k, pid, addr, true);
    if n > UX_PATH {
      return n;
    }
    let e = ux_mkfile(&mut k, pid, n);
    if e >= 18446744073709547520 {
      return e;
    }
    if e != 0 {
      return EINVAL;                        // never: ux_mkfile gives 0 or -errno
    }
    // A socket still bound to a socket file removed since, whose handle
    // the new file now has: no longer found by it.
    let stale = ul_find_file(k, ux_file(&mut k, n));
    if stale < UX_LIS {
      k.ux = set(k.ux, UXH0 + stale, 0);
      ul_set(&mut k, stale, 1, UX_PATH + 1);
    }
  } else if ul_find(k, n) < UX_LIS {
    return EADDRINUSE;
  }
  return n;
}

/// listen on a bound unix socket.
fn ux_listen(k: &mut Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let u = ux_look(k, pid, fd);
  if u.err != 0 {
    return u.err;
  }
  if u.mode == UM_LISTEN {
    return 0;
  }
  if u.mode != UM_BOUND {
    return EINVAL;                          // no autobind
  }
  ul_set(&mut k, u.x, 0, UL_LISTEN);
  k.ux = set(k.ux, UXLC0 + 2 * u.x, pid);
  k.ux = set(k.ux, UXLC0 + 2 * u.x + 1, ux_ids(k, pid));
  of_set(&mut k.ofd, u.h, 3, u.nb + 2 * UM_LISTEN);
  return 0;
}

/// The slot of the bound datagram socket named by the struct sockaddr_un
/// at va (alen bytes), with the checks connect makes; or an error:
/// -ECONNREFUSED if no socket has the name, -EPROTOTYPE if a stream
/// socket has it.
fn ux_dg_target(k: &mut Kernel, pid: u64, addr: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result < UX_LIS || result >= 18446744073709547520
{
  let mut n = sun_in(&mut k, pid, addr, alen);
  if n > UX_PATH {
    return n;
  }
  if bget(k.fs.xfer, 0) != 0 {
    n = ux_resolve(&mut k, pid, addr, false);
    if n > UX_PATH {
      return n;
    }
    let e = ux_may_connect(&mut k, pid, n);
    if e >= 18446744073709547520 {
      return e;
    }
    if e != 0 {
      return EINVAL;                        // never: ux_may_connect gives 0 or -errno
    }
  }
  let mut l = UX_LIS;
  if bget(k.fs.xfer, 0) != 0 {
    l = ul_find_file(k, ux_file(&mut k, n));
  } else {
    l = ul_find(k, n);
  }
  if l >= UX_LIS {
    return ECONNREFUSED;
  }
  if ul_get(k, l, 0) != UL_DGRAM {
    return EPROTOTYPE;
  }
  return l;
}

/// The channel that datagram slot l + 1 == `peer`, bound at `stamp`,
/// reads; UX_N if that socket is gone.
fn ux_dg_chan(k: &Kernel, peer: u64, stamp: u64) -> u64
  requires kok(k)
  ensures result <= UX_N
{
  if peer == 0 || peer > UX_LIS {
    return UX_N;
  }
  let l = peer - 1;
  let c = ul_get(k, l, 2);
  if ul_get(k, l, 0) != UL_DGRAM || ul_get(k, l, 3) % STAMP_SPAN != stamp || c >= UX_N {
    return UX_N;
  }
  return c;
}

/// connect on a unix socket: joins it to a new description that waits in
/// the listener's backlog for accept. Never waits for accept itself. A
/// datagram socket only takes the name as where its sends go.
fn ux_connect(k: &mut Kernel, pid: u64, fd: u64, addr: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let u = ux_look(k, pid, fd);
  if u.err != 0 {
    return u.err;
  }
  if u.mode == UM_DGRAM {
    let l = ux_dg_target(&mut k, pid, addr, alen);
    if l >= UX_LIS {
      return l;
    }
    of_set(&mut k.ofd, u.h, 2, u.x % 8 + 8 * (l + 1) + 64 * (ul_get(k, l, 3) % STAMP_SPAN));
    return 0;
  }
  if u.mode == UM_CONN {
    return EISCONN;
  }
  if u.mode != UM_NEW {
    return EINVAL;
  }
  let mut n = sun_in(&mut k, pid, addr, alen);
  if n > UX_PATH {
    return n;
  }
  let path = bget(k.fs.xfer, 0) != 0;
  if path {
    n = ux_resolve(&mut k, pid, addr, false);
    if n > UX_PATH {
      return n;
    }
    let e = ux_may_connect(&mut k, pid, n);
    if e != 0 {
      return e;
    }
  }
  let mut l = UX_LIS;
  if path {
    l = ul_find_file(k, ux_file(&mut k, n));
  } else {
    l = ul_find(k, n);
  }
  if l >= UX_LIS {
    if path {
      return ECONNREFUSED;                  // a socket file no socket listens on
    }
    return ENOENT;
  }
  if ul_get(k, l, 0) != UL_LISTEN {
    return ECONNREFUSED;
  }
  let mut r = ul_ring(k, l);
  if ring_full(r) {
    if u.nb == 1 {
      return EAGAIN;
    }
    return SK_WAIT;                         // wait for accept to make room
  }
  let p = ux_pair(&mut k, 0, 0);
  if p == OFD_N {
    return ENFILE;
  }
  let mine = p % 4294967296;
  let theirs = p / 4294967296;
  // The accepted end reads what we write, and we read what the listener's
  // process will write.
  let x = of_get(k.ofd, mine, 2);
  uc_set_cred(&mut k, x / UX_N % UX_N, pid, ux_ids(k, pid));
  uc_set_cred(&mut k, x % UX_N, get(k.ux, UXLC0 + 2 * l), get(k.ux, UXLC0 + 2 * l + 1));
  // Our description takes over the first end; the one ux_pair made for it
  // is dropped.
  of_set(&mut k.ofd, u.h, 2, of_get(k.ofd, mine, 2));
  of_set(&mut k.ofd, u.h, 3, u.nb + 2 * UM_CONN);
  of_set(&mut k.ofd, mine, 0, OF_FREE);
  of_set(&mut k.ofd, mine, 1, 0);
  let s = ring_push(&mut r);
  ul_set(&mut k, l, 4 + s, theirs);
  ul_keep(&mut k, l, r);
  return 0;
}

/// accept4 on a listening unix socket: the oldest connection waiting, in a
/// new descriptor; SK_WAIT (or -EAGAIN when nonblocking) if none is.
fn ux_accept(k: &mut Kernel, pid: u64, fd: u64, addr: u64, lenp: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let u = ux_look(k, pid, fd);
  if u.err != 0 {
    return u.err;
  }
  if u.mode != UM_LISTEN {
    return EINVAL;
  }
  let mut bl = ul_ring(k, u.x);
  if ring_empty(bl) {
    if u.nb == 1 {
      return EAGAIN;
    }
    return SK_WAIT;
  }
  let s = ring_pop(&mut bl);
  let h = ul_get(k, u.x, 4 + s);
  ul_keep(&mut k, u.x, bl);
  if h >= OFD_N || of_get(k.ofd, h, 0) != OF_UNIX {
    return ECONNABORTED;
  }
  of_set(&mut k.ofd, h, 3, flags / SOCK_NONBLOCK % 2 + 2 * UM_CONN);
  let nfd = fd_install(&mut k, pid, h);
  if nfd >= LXNFD {
    return nfd;                             // -EMFILE; the description is gone
  }
  if flags / SOCK_CLOEXEC % 2 == 1 {
    fd_set(&mut k.lxfd, pid, nfd, FD_OFD + h + FD_CLOEXEC);
  }
  let r = sun_out(&mut k, pid, addr, lenp);
  if r != 0 {
    return r;
  }
  return nfd;
}

/// Writes an unnamed struct sockaddr_un (the family alone) to user address
/// va, as for a peer with no name. Nothing if va is 0.
fn sun_out(k: &mut Kernel, pid: u64, va: u64, lenp: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if va == 0 {
    return 0;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, &mut k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  let room = cast[u64](bget(k.fs.xfer, 0)) + 256 * cast[u64](bget(k.fs.xfer, 1));
  lx_fill(&mut k, 0, 4);
  bset(&mut k.fs.xfer, 0, cast[u8](AF_UNIX));
  let n = smaller(room, 2);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, n) != n {
    return EFAULT;
  }
  bset(&mut k.fs.xfer, 0, 2);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  return 0;
}

/// write / send on a connected unix socket: what fits in its outgoing
/// channel; SK_WAIT (or -EAGAIN) while that is full; -EPIPE once the other
/// end is closed or this one shut for writing. A datagram socket sends the
/// whole message or waits for room for it (-EMSGSIZE if it never fits);
/// one from socket() sends to the name at addr (alen bytes), or with addr
/// 0 to the one it connected to.
fn ux_send(k: &mut Kernel, pid: u64, fd: u64, va: u64, n: u64, dontwait: bool, addr: u64, alen: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  return ux_send_from(&mut k, pid, fd, va, n, dontwait, addr, alen, false);
}

/// ux_send of the first n bytes of the transfer buffer (sendfile and
/// copy_file_range hand it over there) rather than of user memory.
fn ux_send_xfer(k: &mut Kernel, pid: u64, fd: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= XFER
  ensures kok(k)
  ensures result <= n || result > XFER
{
  let r = ux_send_from(&mut k, pid, fd, 0, n, false, 0, 0, true);
  if r <= n || r > XFER {
    return r;
  }
  return EINVAL;                            // (never: the count sent is at most n)
}

/// ux_send, the bytes coming from user address va or, with xf, from the
/// transfer buffer.
fn ux_send_from(k: &mut Kernel, pid: u64, fd: u64, va: u64, n: u64, dontwait: bool, addr: u64, alen: u64, xf: bool) -> u64
  requires kok(k) && pid < NPROC && (!xf || n <= XFER)
  ensures kok(k)
{
  let u = ux_look(k, pid, fd);
  if u.err != 0 {
    return u.err;
  }
  let mut c = u.x / UX_N;
  if u.mode == UM_DGRAM {
    if addr != 0 {
      let l = ux_dg_target(&mut k, pid, addr, alen);
      if l >= UX_LIS {
        return l;
      }
      c = ul_get(k, l, 2);
    } else if u.x / 8 % 8 == 0 {
      return ENOTCONN;
    } else {
      c = ux_dg_chan(k, u.x / 8 % 8, u.x / 64);
    }
    if c >= UX_N {
      return ECONNREFUSED;                  // the socket at that name is gone
    }
  } else if u.mode != UM_CONN {
    return ENOTCONN;
  }
  if uc_get(k, c, 2) != 1 || uc_get(k, c, 3) != 1 {
    return EPIPE;
  }
  if n == 0 && !u.dg {
    return 0;
  }
  let mut r = uc_ring(k, c);
  let count = r.n;
  let mut lead = 0;                         // the length and sender a datagram starts with
  if u.dg {
    if n > XFER || n + 3 > UX_CAP {
      return EMSGSIZE;
    }
    lead = 3;
  }
  if count + lead >= UX_CAP || (u.dg && count + n + 3 > UX_CAP) {
    if dontwait || u.nb == 1 {
      return EAGAIN;
    }
    return SK_WAIT;
  }
  let mut got = 0;
  if n > 0 {
    if xf {
      got = smaller(n, UX_CAP - count - lead);
    } else {
      got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, smaller(n, UX_CAP - count - lead));
      if got == NO_RESULT || got == 0 {
        return EFAULT;
      }
    }
  }
  if u.dg {
    bset(&mut k.uxb, c * UX_CAP + ring_slot(r, count), cast[u8](got % 256));
    bset(&mut k.uxb, c * UX_CAP + ring_slot(r, count + 1), cast[u8](got / 256 % 256));
    let mut from = 0;
    if u.mode == UM_DGRAM {
      from = u.x % 8;                       // 1 + the slot it is bound to, or 0
    }
    bset(&mut k.uxb, c * UX_CAP + ring_slot(r, count + 2), cast[u8](from));
  }
  ring_in(&mut k.uxb, c * UX_CAP, UX_CAP, ring_slot(r, count + lead), k.fs.xfer, 0, got);
  ring_push_n(&mut r, lead + got);
  uc_keep(&mut k, c, r);
  return got;
}

/// read / recv on a connected unix socket: the bytes waiting (left there
/// with peek), 0 once the other end is closed and they are all read,
/// SK_WAIT (or -EAGAIN) while none are. A datagram socket takes one
/// message; the part past n is dropped, as on Linux.
fn ux_recv(k: &mut Kernel, pid: u64, fd: u64, va: u64, n: u64, dontwait: bool, peek: bool, addr: u64, lenp: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let u = ux_look(k, pid, fd);
  if u.err != 0 {
    return u.err;
  }
  let mut c = u.x % UX_N;
  if u.mode == UM_DGRAM {
    // Datagrams come to a bound socket's name; an unbound one waits.
    c = UX_N;
    if u.x % 8 != 0 {
      c = ul_get(k, u.x % 8 - 1, 2);
    }
    if c >= UX_N {
      if dontwait || u.nb == 1 {
        return EAGAIN;
      }
      return SK_WAIT;
    }
  } else if u.mode != UM_CONN {
    return ENOTCONN;
  }
  let mut r = uc_ring(k, c);
  let count = r.n;
  if count == 0 {
    if uc_get(k, c, 3) != 1 || uc_get(k, c, 2) != 1 {
      return 0;                             // the writer or this side shut
    }
    if dontwait || u.nb == 1 {
      return EAGAIN;
    }
    return SK_WAIT;
  }
  let mut lead = 0;
  let mut avail = count;                    // the bytes this call may take
  let mut from = 0;
  if u.dg {
    if count < 3 {
      return EAGAIN;                        // never: datagrams go in whole
    }
    lead = 3;
    let len = cast[u64](bget(k.uxb, c * UX_CAP + ring_slot(r, 0))) + 256 * cast[u64](bget(k.uxb, c * UX_CAP + ring_slot(r, 1)));
    from = cast[u64](bget(k.uxb, c * UX_CAP + ring_slot(r, 2)));
    avail = smaller(len, count - 3);
  } else if n == 0 {
    return 0;
  }
  let want = smaller(smaller(n, avail), XFER);
  ring_out(&mut k.fs.xfer, 0, k.uxb, c * UX_CAP, UX_CAP, ring_slot(r, lead), want);
  let put = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, want);
  if put == NO_RESULT || put != want {
    return EFAULT;
  }
  if !peek {
    // A description sent with these bytes goes with them: read and recv
    // drop it (recvmsg took it out first), as Linux does.
    let f = uc_fly(k, c);
    if f > 0 {
      uc_set_fly(&mut k, c, 0);
      if f <= OFD_N {
        unref_value(&mut k, FD_OFD + f - 1);
      }
    }
    let mut used = put;
    if u.dg {
      used = avail;                         // the whole message goes
    }
    ring_pop_n(&mut r, lead + used);
    uc_keep(&mut k, c, r);
  }
  if u.dg && addr != 0 {
    // The sender's name; a length of 0 for one with none, as on Linux.
    let mut l = UX_LIS;
    if from >= 1 && from <= UX_LIS {
      l = from - 1;
    }
    let e = sun_name_out(&mut k, pid, addr, lenp, l, 0);
    if e != 0 {
      return e;
    }
  }
  return put;
}

/// Writes the struct sockaddr_un naming slot l to user address va and its
/// length to the int at lenp (read first: what fits there is written):
/// "/" and the canonical path for a path name, the bytes of an abstract
/// one. For a slot that is free (or l == UX_LIS), the family alone with a
/// length of `none` (2, or 0 to say nothing). Nothing if va is 0.
fn sun_name_out(k: &mut Kernel, pid: u64, va: u64, lenp: u64, l: u64, none: u64) -> u64
  requires kok(k) && pid < NPROC && l <= UX_LIS && none <= 2
  ensures kok(k)
{
  if va == 0 {
    return 0;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, &mut k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  let room = get_u64(k.fs.xfer, 0) % 0x100000000;
  if room >= 0x80000000 {
    return EINVAL;
  }
  lx_fill(&mut k, 0, SUN_LEN);
  bset(&mut k.fs.xfer, 0, cast[u8](AF_UNIX));
  let mut len = none;
  let mut n = 0;
  if l < UX_LIS && ul_get(k, l, 0) != UL_FREE {
    n = ul_get(k, l, 1);
  }
  if l < UX_LIS && n >= 1 && n <= UX_PATH {
    let mut at = 2;                         // where the name's bytes go
    let mut m = n;
    if bget(k.uxb, UXP0 + l * UX_PATH) != 0 {
      bset(&mut k.fs.xfer, 2, 47);          // "/"
      at = 3;
      m = smaller(n, SUN_LEN - 4);          // and a NUL after
    }
    let mut i = 0;
    while i < m
      invariant i <= m && m <= UX_PATH && at <= 3 && l < UX_LIS && kok(k)
    {
      bset(&mut k.fs.xfer, at + i, bget(k.uxb, UXP0 + l * UX_PATH + i));
      i = i + 1;
    }
    len = at + m;
    if at == 3 {
      len = len + 1;                        // the NUL is counted, as Linux counts it
    }
  }
  let put = smaller(room, len);
  if put > 0 && copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, put) != put {
    return EFAULT;
  }
  lx_fill(&mut k, 0, 4);
  bset(&mut k.fs.xfer, 0, cast[u8](len));
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, lenp, k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  return 0;
}

/// shutdown(fd, how) on a connected unix socket: SHUT_WR (and SHUT_RDWR)
/// close its write end, so the peer reads the end and later sends are
/// -EPIPE; SHUT_RD (and SHUT_RDWR) close its read end: reads end once
/// the bytes waiting are taken, and the peer's sends are -EPIPE, as on
/// Linux.
fn ux_shutdown(k: &mut Kernel, pid: u64, fd: u64, how: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let u = ux_look(k, pid, fd);
  if u.err != 0 {
    return u.err;
  }
  if how > 2 {
    return EINVAL;
  }
  if u.mode != UM_CONN {
    return ENOTCONN;
  }
  // 2, not 0: the channel stays this socket's until it closes (with
  // both ends 0, uc_new would hand it out again).
  if how != 0 {
    uc_set(&mut k, u.x / UX_N, 3, 2);
  }
  if how != 1 && uc_get(k, u.x % UX_N, 2) == 1 {
    uc_set(&mut k, u.x % UX_N, 2, 2);
  }
  return 0;
}

/// getsockname / getpeername on a unix socket: the name a socket bound
/// (or a datagram socket connected to); otherwise unnamed (the family
/// alone), or -ENOTCONN for the peer of one not connected.
fn ux_name(k: &mut Kernel, pid: u64, fd: u64, addr: u64, lenp: u64, peer: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let u = ux_look(k, pid, fd);
  if u.err != 0 {
    return u.err;
  }
  if u.mode == UM_DGRAM {
    // A datagram socket's own name, or the one it is connected to.
    let mut l = UX_LIS;
    if peer {
      if u.x / 8 % 8 == 0 || ux_dg_chan(k, u.x / 8 % 8, u.x / 64) == UX_N {
        return ENOTCONN;
      }
      l = u.x / 8 % 8 - 1;
    } else if u.x % 8 != 0 {
      l = u.x % 8 - 1;
    }
    return sun_name_out(&mut k, pid, addr, lenp, l, 2);
  }
  if peer && u.mode != UM_CONN {
    return ENOTCONN;
  }
  if !peer && (u.mode == UM_BOUND || u.mode == UM_LISTEN) {
    return sun_name_out(&mut k, pid, addr, lenp, u.x, 2);
  }
  return sun_out(&mut k, pid, addr, lenp);
}

/// What a poll on a unix socket finds now: a listener is readable when a
/// connection waits; a connection when bytes or the end have come, and
/// writable while its outgoing channel has room.
fn ux_poll_bits(k: &Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
{
  let u = ux_look(k, pid, fd);
  if u.err != 0 {
    return POLLERR;
  }
  if u.mode == UM_LISTEN {
    if ul_get(k, u.x, 3) > 0 {
      return POLLIN;
    }
    return 0;
  }
  if u.mode == UM_DGRAM {
    let mut d = 0;
    if u.x % 8 != 0 {
      let rc = ul_get(k, u.x % 8 - 1, 2);
      if rc < UX_N && uc_get(k, rc, 1) > 0 {
        d = POLLIN;
      }
    }
    let tc = ux_dg_chan(k, u.x / 8 % 8, u.x / 64);
    if u.x / 8 % 8 == 0 || (tc < UX_N && uc_get(k, tc, 1) < UX_CAP - 3) {
      d = d | POLLOUT;
    }
    return d;
  }
  if u.mode != UM_CONN {
    return POLLOUT;
  }
  let mut b = 0;
  let rx = u.x % UX_N;
  let tx = u.x / UX_N;
  if uc_get(k, rx, 1) > 0 {
    b = POLLIN;
  }
  if uc_get(k, rx, 3) != 1 {
    b = b | POLLIN | POLLHUP | POLLRDHUP;
  }
  if uc_get(k, rx, 2) != 1 {
    b = b | POLLIN | POLLRDHUP;             // shut for reading here
  }
  if uc_get(k, tx, 2) != 1 {
    b = b | POLLERR;
  } else if uc_get(k, tx, 1) < UX_CAP {
    b = b | POLLOUT;
  }
  return b;
}
