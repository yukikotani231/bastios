// BastiOS kernel: boots, starts the shell as the first user process, and
// schedules processes round robin, preempting them on the timer.
//
// The kernel never touches memory through an address. Physical pages, page
// tables, CR3 and the CPU's user context are linear capabilities, and the
// Bastio prover checks every use of them before this file is compiled: a
// page is owned by exactly one table or by the allocator, a table is empty
// before it is freed, the address space in CR3 is never freed, and every
// buffer index and arithmetic step is in range.

import "uart.bastio";
import "pic.bastio";
import "pit.bastio";
import "hpet.bastio";
import "console.bastio";
import "pages.bastio";
import "space.bastio";
import "proc.bastio";
import "fs.bastio";
import "net.bastio";
import "syscall.bastio";
import "linux.bastio";
import "lxproc.bastio";
import "lxfd.bastio";
import "lxdir.bastio";
import "lxsock.bastio";
import "lxtcp.bastio";
import "lxsig.bastio";
import "lxtime.bastio";
import "lxmisc.bastio";

const V_TIMER: u64 = 32;
const V_SYSCALL: u64 = 128;

fn fault_name(con: &mut Con, v: u64)
  requires con_ok(con)
  ensures con_ok(con)
{
  if v == 0 {
    puts(&mut con, "divide error");
  } else if v == 6 {
    puts(&mut con, "invalid opcode");
  } else if v == 13 {
    puts(&mut con, "general protection fault");
  } else if v == 14 {
    puts(&mut con, "page fault");
  } else {
    puts(&mut con, "exception");
  }
}

// ---------------------------------------------------------------- scheduling

// Every processor runs `sched` (below): it takes the lock on the kernel's
// state, picks a READY process, takes its address space and FPU page out,
// and releases the lock while the process runs in user mode. When a trap
// ends the run, it takes the lock again, puts them back and handles the
// trap. A process on a processor is RUNNING, so no other processor picks
// it, and nothing else uses its slots while they are empty.

// The vector of each processor's local timer (boot/core.h).
const V_LTIMER: u64 = 48;

// The kernel's state and the devices the scheduler drives, shared by every
// processor through a lock. The invariant is what each processor may assume
// when it takes the lock, and must restore before it lets go.
struct Sys { k: Kernel, con: Con, pic: Pic, clock: Hpet, stop: bool }
  invariant kok(k) && con_ok(con) && pic_ok(pic) && hpet_ok(clock);

spec fn sys_ok(s: &Sys) -> bool {
  kok(s.k) && con_ok(s.con) && pic_ok(s.pic) && hpet_ok(s.clock)
}

// A process taken out to run: its id, address space and FPU page.
struct Task { pid: u64, root: PageTable, fpu: Frame }

enum Job { Stop, Idle, Run(Task) }

/// Under the lock: what this processor does next. Starting at `from`
/// (round robin), takes the next READY process out, with its registers and
/// FPU state loaded into `cpu`, and marks it RUNNING.
fn next_job(s: &mut Sys, cpu: &mut Cpu, mmu: &Mmu, from: u64) -> Job
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  ensures sys_ok(s)
  ensures result is Job::Run ==> (pt_level(result.Run.root) == 4 && 1 <= result.Run.pid && result.Run.pid < NPROC)
{
  if s.stop {
    return Job::Stop;
  }
  nic_poll(&mut s.k.nic);
  net_wake(&mut s.k);
  drain(&mut s.con, &mut s.k.q);
  tty_intr(&mut s.con, &mut s.k);
  tty_cook(&mut s.con, &mut s.k);
  wake_readers(&mut s.k.procs, &mut s.k.q, s.k.line);
  let p = pick(s.k.procs, from);
  if p == 0 {
    if live_count(s.k.procs) == 0 {
      s.stop = true;
      return Job::Stop;
    }
    return Job::Idle;
  }
  if !lx_deliver(&mut s.k, mmu, p) {
    return Job::Idle;                       // a signal ended it
  }
  match take_space(&mut s.k.spaces, p) {
    Space::Empty => {
      // A READY process always has a space; end it rather than spin on it.
      terminate(&mut s.k, mmu, p, 139);
      return Job::Idle;
    },
    Space::Mapped(root) => {
      match take_fpu(&mut s.k.fpus, p) {
        Fpu::None => {
          put_space(&mut s.k.spaces, p, Space::Mapped(root));
          terminate(&mut s.k, mmu, p, 139);
          return Job::Idle;
        },
        Fpu::State(f) => {
          cpu_fpu_load(&mut cpu, f);
          let mut r = 0;
          while r < 18
            invariant r <= 18 && len(s.k.procs) == PTAB_LEN
          {
            cpu_set(&mut cpu, r, pget(s.k.procs, p, F_REGS + r));
            r = r + 1;
          }
          cpu_set(&mut cpu, R_FSBASE, pget(s.k.procs, p, F_REGS + R_FSBASE));
          pset(&mut s.k.procs, p, F_STATE, RUNNING);
          return Job::Run(Task { pid: p, root: root, fpu: f });
        },
      }
    },
  }
}

/// Under the lock, after an idle wait ended with vector `v`.
fn idled(s: &mut Sys, v: u64)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  ack(&mut s.pic, v);
  if v == V_TIMER {
    s.k.ticks = tick(s.k.ticks);
    s.k.ns = hpet_ns(&mut s.clock);
    lx_alarms(&mut s.k);
  }
}

/// Under the lock, after task `t` ran on this processor until a trap with
/// vector `v`: puts it back and handles the trap. Returns where this
/// processor's round robin goes on.
fn finish(s: &mut Sys, cpu: &mut Cpu, mmu: &Mmu, t: Task, v: u64) -> u64
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  requires pt_level(t.root) == 4 && 1 <= t.pid && t.pid < NPROC
  ensures sys_ok(s) && result < NPROC
{
  let p = t.pid;
  let mut f = t.fpu;
  cpu_fpu_save(&mut cpu, &mut f);
  restore_fpu(&mut s.k.mem, &mut s.k.fpus, p, Fpu::State(f));
  restore_space(&mut s.k.mem, &mut s.k.spaces, mmu, p, Space::Mapped(t.root));
  // Registers, then the error code, fault address and FS base (words 18-20).
  let mut r = 0;
  while r < 21
    invariant r <= 21 && len(s.k.procs) == PTAB_LEN
  {
    pset(&mut s.k.procs, p, F_REGS + r, cpu_get(cpu, r));
    r = r + 1;
  }
  ack(&mut s.pic, v);
  if v == V_TIMER {
    s.k.ticks = tick(s.k.ticks);
  }
  let killed = state(s.k.procs, p) == KILLED;
  if state(s.k.procs, p) == RUNNING || killed {
    pset(&mut s.k.procs, p, F_STATE, READY);
  }
  if killed {
    terminate(&mut s.k, mmu, p, 137);
    return (p + 1) % NPROC;
  }
  if v == V_TIMER || v == V_LTIMER {
    pset(&mut s.k.procs, p, F_TICKS, tick(pget(s.k.procs, p, F_TICKS)));
    s.k.ns = hpet_ns(&mut s.clock);
    lx_alarms(&mut s.k);
    return (p + 1) % NPROC;
  }
  if v == V_SYSCALL {
    s.k.ns = hpet_ns(&mut s.clock);
    let what = syscall(&mut s.con, &mut s.k, mmu, p);
    if what == POWEROFF {
      s.stop = true;
    }
    if what == KEEP {
      return p;
    }
    return (p + 1) % NPROC;
  }
  if v == V_LINUX {
    s.k.ns = hpet_ns(&mut s.clock);
    if linux_syscall(&mut s.con, &mut s.k, mmu, p) == SWITCH {
      return (p + 1) % NPROC;
    }
    return p;
  }
  if v < 32 {
    puts(&mut s.con, "\r\n[pid ");
    put_num(&mut s.con, p);
    puts(&mut s.con, " (");
    puts(&mut s.con, prog_name(pget(s.k.procs, p, F_PROG)));
    puts(&mut s.con, "): ");
    fault_name(&mut s.con, v);
    puts(&mut s.con, " at rip ");
    put_hex(&mut s.con, pget(s.k.procs, p, F_REGS + R_RIP));
    if v == 14 {
      puts(&mut s.con, ", address ");
      put_hex(&mut s.con, pget(s.k.procs, p, F_REGS + 19));
    }
    puts(&mut s.con, "; killed]\r\n");
    terminate(&mut s.k, mmu, p, 128 + v);
    return (p + 1) % NPROC;
  }
  return p;
}

/// The scheduler loop each processor runs, with its own `cpu` and `mmu`,
/// until the kernel stops (no process left, or a power off).
fn sched(cpu: &mut Cpu, mmu: &mut Mmu, s: &Lock[Sys])
  requires mmu_root(mmu) == KERNEL_ROOT
  ensures mmu_root(mmu) == KERNEL_ROOT
{
  let mut cur = 1;
  let mut going = true;
  while going
    invariant mmu_root(mmu) == KERNEL_ROOT && cur < NPROC
  {
    let j = locked(s, next_job, &mut cpu, mmu, cur);
    match j {
      Job::Stop => { going = false; },
      Job::Idle => {
        let v = cpu_idle(&mut cpu);
        locked(s, idled, v);
      },
      Job::Run(t) => {
        mmu_switch(&mut mmu, t.root);
        let v = cpu_run(&mut cpu, mmu);
        mmu_kernel(&mut mmu);
        cur = locked(s, finish, &mut cpu, mmu, t, v);
      },
    }
  }
}

/// Acknowledges vector `v` at the interrupt controllers if it is a
/// hardware interrupt.
fn ack(pic: &mut Pic, v: u64)
  requires pic_ok(pic)
{
  if V_IRQ0 <= v && v < V_IRQ_END {
    pic_eoi(&mut pic, v);
  }
}

// The files the file system starts with, built into the kernel image.
// elfdemo is a Linux program (the elfpie test) that execve runs as a file.
const NINIT: u64 = 3;

fn init_name(i: u64) -> Str {
  if i == 0 {
    return "motd";
  }
  if i == 1 {
    return "about";
  }
  return "elfdemo";
}

fn init_data(i: u64) -> Str {
  if i == 0 {
    return include_bytes("../files/motd");
  }
  if i == 1 {
    return include_bytes("../files/about");
  }
  return include_bytes("../build/user/elfpie.elf");
}

fn install_files(con: &mut Con, k: &mut Kernel)
  requires con_ok(con) && kok(k)
  ensures kok(k) && con_ok(con)
{
  let mut i = 0;
  while i < NINIT
    invariant i <= NINIT && kok(k) && con_ok(con)
  {
    if !vfs_install(&mut k.fs, &mut k.mem, init_name(i), init_data(i)) {
      puts(&mut con, "cannot install file ");
      puts(&mut con, init_name(i));
      puts(&mut con, "\r\n");
    }
    i = i + 1;
  }
}

/// A MAC address as six hex bytes, colon-separated.
fn put_mac(con: &mut Con, mac: u64)
  requires con_ok(con)
  ensures con_ok(con)
{
  let mut q = 0x10000000000;
  let mut first = true;
  while q > 0
    invariant con_ok(con)
  {
    if !first {
      con_write(&mut con, 58);
    }
    first = false;
    let b = (mac / q) % 256;
    let hi = b / 16;
    let lo = b % 16;
    if hi < 10 { con_write(&mut con, cast[u8](48 + hi)); } else { con_write(&mut con, cast[u8](87 + hi)); }
    if lo < 10 { con_write(&mut con, cast[u8](48 + lo)); } else { con_write(&mut con, cast[u8](87 + lo)); }
    q = q / 256;
  }
}

fn tick(t: u64) -> u64 {
  if t < 18446744073709551615 {
    return t + 1;
  }
  return t;
}

fn main(ports: &mut Ports, win: &mut MmioSpace, pool: &mut Pool, mmu: &mut Mmu, cpu: &mut Cpu) -> u64 {
  // Every device the kernel drives, with the I/O ports it owns. The ports
  // are claimed here, once: no two drivers can own the same port, and no
  // code can touch a port that was not claimed.
  let mut uart = Uart { io: port_claim(&mut ports, COM1, 8) };
  let mut kbd = Kbd { data: port_claim(&mut ports, KBD_DATA, 1), status: port_claim(&mut ports, KBD_STATUS, 1),
    shift: false, ctrl: false, ext: false };
  let mut pic = Pic { master: port_claim(&mut ports, PIC1, 2), slave: port_claim(&mut ports, PIC2, 2) };
  let mut pit = Pit { io: port_claim(&mut ports, PIT, 4) };
  // Devices with memory-mapped registers claim them from the device window.
  let mut clock = hpet_init(mmio_claim(&mut win, HPET, HPET_LEN));
  uart_init(&mut uart);
  kbd_init(&mut kbd);
  // The screen: the framebuffer the boot loader set up, if there is one
  // and it lies in the device window below the I/O APIC.
  let fb_lo = boot_fb(cpu, 0);
  let fb_pitch = boot_fb(cpu, 1);
  let fb_h = boot_fb(cpu, 3);
  let fb_hi = fb_lo + fb_pitch * fb_h;
  let screen = screen_new(&mut win, fb_lo, fb_hi, fb_pitch, boot_fb(cpu, 2), fb_h, boot_fb(cpu, 4));
  let mut con = Con { uart: uart, screen: screen, kbd: kbd };
  pic_init(&mut pic);
  pit_init(&mut pit, 100);
  puts(&mut con, "\r\nBastiOS 0.2: ");
  put_num(&mut con, pool_size(pool));
  puts(&mut con, " pages of memory, ");
  let cpus = cpu_count(cpu);
  put_num(&mut con, cpus);
  if cpus == 1 {
    puts(&mut con, " processor\r\n");
  } else {
    puts(&mut con, " processors\r\n");
  }
  // The allocator takes the pool for as long as the kernel runs and gives
  // it back at power off.
  if screen_on(con.screen) {
    puts(&mut con, "screen: ");
    put_num(&mut con, boot_fb(cpu, 2));
    puts(&mut con, "x");
    put_num(&mut con, fb_h);
    puts(&mut con, " framebuffer, keyboard on PS/2\r\n");
  }
  let mut m = mem_new(pool);
  // The disk: virtio (DMA into pages lent from the allocator) if the machine
  // has one, else ATA. PCI's configuration ports are claimed for it.
  let mut pci = Pci { addr: port_claim(&mut ports, PCI_ADDR, 4), data: port_claim(&mut ports, PCI_DATA, 4) };
  let dev = blk_new(&mut ports, &mut pci, &mut m);
  let dev_lo = blk_ports_lo(dev);
  let dev_hi = blk_ports_hi(dev);
  let disk = disk_mount(dev);
  if blk_is_virtio(disk.dev) {
    puts(&mut con, "disk: virtio\r\n");
  }
  // The network card, if any: nine pages after the disk's four (an e1000
  // takes six of them).
  let nic = nic_new(&mut ports, &mut pci, &mut m, &mut win, 4, dev_lo, dev_hi, fb_lo, fb_hi);
  if nic_live(nic) {
    if nic_e1000(nic) {
      puts(&mut con, "net: e1000, mac ");
    } else {
      puts(&mut con, "net: virtio, mac ");
    }
    put_mac(&mut con, nic_mac(nic));
    puts(&mut con, ", address by DHCP\r\n");
  }
  let mut spaces = vec_new[Space]();
  let mut i = 0;
  while i < NPROC
    invariant i <= NPROC && vlen(spaces) == i
    invariant forall j: u64 :: j < i ==> vget(spaces, j) is Space::Empty
  {
    vec_push(&mut spaces, Space::Empty);
    i = i + 1;
  }
  let mut fpus = vec_new[Fpu]();
  let mut q = 0;
  while q < NPROC
    invariant q <= NPROC && vlen(fpus) == q
  {
    vec_push(&mut fpus, Fpu::None);
    q = q + 1;
  }
  let mut k = Kernel { mem: m, spaces: spaces, fpus: fpus, procs: alloc(PTAB_LEN), q: alloc(INQ_LEN), line: alloc(LINE_LEN), lxfd: alloc(LXFD_LEN), ofd: alloc(OFD_LEN), pipes: alloc(PIPES_LEN), ticks: 0, ns: 0, cpus: cpus, fs: vfs_new(disk), nic: nic, sigact: alloc(SIGACT_LEN), cwd: alloc(CWD_LEN), dpath: alloc(DPATH_LEN), alarms: alloc(ALARMS_LEN) };
  install_files(&mut con, &mut k);
  if spawn(&mut k, 0, 0) == 0 {
    puts(&mut con, "cannot start the shell\r\n");
  }
  // Every processor runs the scheduler until the kernel stops; then they
  // are all back in their park loops and the state is this one's again.
  let sl = lock_new(Sys { k: k, con: con, pic: pic, clock: clock, stop: false });
  smp_run(sched, &mut cpu, &mut mmu, sl);
  let mut sys = lock_end(sl);
  // Power off: tear down whatever is left, so every page goes back.
  while vec_len(sys.k.spaces) > 0
    invariant mem_ok(sys.k.mem) && mmu_root(mmu) == KERNEL_ROOT
    invariant forall j: u64 :: j < vlen(sys.k.spaces) ==> (vget(sys.k.spaces, j) is Space::Mapped ==> pt_level(vget(sys.k.spaces, j).Mapped) == 4)
  {
    match vec_pop(&mut sys.k.spaces) {
      Space::Empty => {},
      Space::Mapped(t) => { free_space(&mut sys.k.mem, mmu, t); },
    }
  }
  vec_free(sys.k.spaces);
  while vec_len(sys.k.fpus) > 0
    invariant mem_ok(sys.k.mem)
  {
    drop_fpu(&mut sys.k.mem, vec_pop(&mut sys.k.fpus));
  }
  vec_free(sys.k.fpus);
  blk_free(&mut ports, vfs_free(sys.k.fs, &mut sys.k.mem), &mut sys.k.mem);
  nic_free(&mut ports, &mut win, sys.k.nic, &mut sys.k.mem);
  puts(&mut sys.con, "BastiOS: ");
  put_num(&mut sys.con, count_free(sys.k.mem.bm));
  puts(&mut sys.con, " pages free at power off\r\n");
  free(sys.k.mem.bm);
  free(sys.k.procs);
  free(sys.k.q);
  free(sys.k.line);
  free(sys.k.lxfd);
  free(sys.k.ofd);
  free(sys.k.pipes);
  free(sys.k.sigact);
  free(sys.k.cwd);
  free(sys.k.dpath);
  free(sys.k.alarms);
  pool = sys.k.mem.pool;
  port_release(&mut ports, sys.con.uart.io);
  port_release(&mut ports, sys.con.kbd.data);
  port_release(&mut ports, sys.con.kbd.status);
  screen_free(&mut win, sys.con.screen);
  port_release(&mut ports, sys.pic.master);
  port_release(&mut ports, sys.pic.slave);
  port_release(&mut ports, pit.io);
  pci_free(&mut ports, pci);
  mmio_release(&mut win, sys.clock.regs);
  return 0;
}
