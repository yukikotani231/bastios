// BastiOS kernel: boots, starts the shell as the first user process, and
// schedules processes round robin, preempting them on the timer.
//
// The kernel never touches memory through an address. Physical pages, page
// tables, CR3 and the CPU's user context are linear capabilities, and the
// Bastio prover checks every use of them before this file is compiled: a
// page is owned by exactly one table or by the allocator, a table is empty
// before it is freed, the address space in CR3 is never freed, and every
// buffer index and arithmetic step is in range.

import "uart.bastio";
import "pic.bastio";
import "pit.bastio";
import "console.bastio";
import "pages.bastio";
import "space.bastio";
import "proc.bastio";
import "syscall.bastio";

const V_TIMER: u64 = 32;
const V_SYSCALL: u64 = 128;

fn fault_name(con: &mut Uart, v: u64)
  requires uart_ok(con)
  ensures uart_ok(con)
{
  if v == 0 {
    puts(&mut con, "divide error");
  } else if v == 6 {
    puts(&mut con, "invalid opcode");
  } else if v == 13 {
    puts(&mut con, "general protection fault");
  } else if v == 14 {
    puts(&mut con, "page fault");
  } else {
    puts(&mut con, "exception");
  }
}

/// Runs process `pid` until the next trap and returns its vector (256 if
/// the process has no address space). Its registers are loaded from and
/// saved back to its row.
fn run(mmu: &mut Mmu, cpu: &mut Cpu, spaces: &mut Vec[Space], procs: &mut Buf, pid: u64) -> u64
  requires spaces_ok(spaces) && len(procs) == PTAB_LEN && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures spaces_ok(spaces) && len(procs) == PTAB_LEN && mmu_root(mmu) == KERNEL_ROOT
{
  let mut v = 256;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return 256; },
    Space::Mapped(root) => {
      let mut r = 0;
      while r < 18
        invariant r <= 18
      {
        cpu_set(&mut cpu, r, pget(procs, pid, F_REGS + r));
        r = r + 1;
      }
      mmu_switch(&mut mmu, root);
      v = cpu_run(&mut cpu, mmu);
      mmu_kernel(&mut mmu);
      put_space(&mut spaces, pid, Space::Mapped(root));
    },
  }
  // Registers, then the error code and fault address (words 18 and 19).
  let mut r = 0;
  while r < 20
    invariant r <= 20 && len(procs) == PTAB_LEN
  {
    pset(&mut procs, pid, F_REGS + r, cpu_get(cpu, r));
    r = r + 1;
  }
  return v;
}

/// Acknowledges vector `v` at the interrupt controllers if it is a
/// hardware interrupt.
fn ack(pic: &mut Pic, v: u64)
  requires pic_ok(pic)
  ensures pic_ok(pic)
{
  if V_IRQ0 <= v && v < V_IRQ_END {
    pic_eoi(&mut pic, v);
  }
}

fn tick(t: u64) -> u64 {
  if t < 18446744073709551615 {
    return t + 1;
  }
  return t;
}

fn main(ports: &mut Ports, pool: &mut Pool, mmu: &mut Mmu, cpu: &mut Cpu) -> u64 {
  // Every device the kernel drives, with the I/O ports it owns. The ports
  // are claimed here, once: no two drivers can own the same port, and no
  // code can touch a port that was not claimed.
  let mut con = Uart { io: port_claim(&mut ports, COM1, 8) };
  let mut pic = Pic { master: port_claim(&mut ports, PIC1, 2), slave: port_claim(&mut ports, PIC2, 2) };
  let mut pit = Pit { io: port_claim(&mut ports, PIT, 4) };
  uart_init(&mut con);
  pic_init(&mut pic);
  pit_init(&mut pit, 100);
  puts(&mut con, "\r\nBastiOS 0.2: ");
  put_num(&mut con, pool_size(pool));
  puts(&mut con, " pages of memory\r\n");
  // The allocator takes the pool for as long as the kernel runs and gives
  // it back at power off.
  let mut m = mem_new(pool);
  let mut spaces = vec_new[Space]();
  let mut i = 0;
  while i < NPROC
    invariant i <= NPROC && vlen(spaces) == i
    invariant forall j: u64 :: j < i ==> vget(spaces, j) is Space::Empty
  {
    vec_push(&mut spaces, Space::Empty);
    i = i + 1;
  }
  let mut k = Kernel { mem: m, spaces: spaces, procs: alloc(PTAB_LEN), q: alloc(INQ_LEN), ticks: 0 };
  if spawn(&mut k, 0, 0) == 0 {
    puts(&mut con, "cannot start the shell\r\n");
  }
  let mut cur = 1;
  let mut running = true;
  while running
    invariant kok(k) && mmu_root(mmu) == KERNEL_ROOT && cur < NPROC
    invariant uart_ok(con) && pic_ok(pic)
  {
    drain(&mut con, &mut k.q);
    wake_readers(&mut k.procs, &mut k.q);
    let p = pick(k.procs, cur);
    if p == 0 {
      if live_count(k.procs) == 0 {
        running = false;
      } else {
        let v = cpu_idle(&mut cpu);
        ack(&mut pic, v);
        if v == V_TIMER {
          k.ticks = tick(k.ticks);
        }
      }
    } else {
      let v = run(&mut mmu, &mut cpu, &mut k.spaces, &mut k.procs, p);
      ack(&mut pic, v);
      cur = p;
      if v == V_TIMER {
        k.ticks = tick(k.ticks);
        pset(&mut k.procs, p, F_TICKS, tick(pget(k.procs, p, F_TICKS)));
        cur = (p + 1) % NPROC;
      } else if v == V_SYSCALL {
        let r = syscall(&mut con, &mut k, mmu, p);
        if r == SWITCH {
          cur = (p + 1) % NPROC;
        } else if r == POWEROFF {
          running = false;
        }
      } else if v < 32 {
        puts(&mut con, "\r\n[pid ");
        put_num(&mut con, p);
        puts(&mut con, " (");
        puts(&mut con, prog_name(pget(k.procs, p, F_PROG)));
        puts(&mut con, "): ");
        fault_name(&mut con, v);
        puts(&mut con, " at rip ");
        put_hex(&mut con, pget(k.procs, p, F_REGS + R_RIP));
        if v == 14 {
          puts(&mut con, ", address ");
          put_hex(&mut con, pget(k.procs, p, F_REGS + 19));
        }
        puts(&mut con, "; killed]\r\n");
        terminate(&mut k, mmu, p, 128 + v);
        cur = (p + 1) % NPROC;
      }
    }
  }
  // Power off: tear down whatever is left, so every page goes back.
  while vec_len(k.spaces) > 0
    invariant mem_ok(k.mem) && mmu_root(mmu) == KERNEL_ROOT
    invariant forall j: u64 :: j < vlen(k.spaces) ==> (vget(k.spaces, j) is Space::Mapped ==> pt_level(vget(k.spaces, j).Mapped) == 4)
  {
    match vec_pop(&mut k.spaces) {
      Space::Empty => {},
      Space::Mapped(t) => { free_space(&mut k.mem, mmu, t); },
    }
  }
  vec_free(k.spaces);
  puts(&mut con, "BastiOS: ");
  put_num(&mut con, count_free(k.mem.bm));
  puts(&mut con, " pages free at power off\r\n");
  free(k.mem.bm);
  free(k.procs);
  free(k.q);
  pool = k.mem.pool;
  port_release(&mut ports, con.io);
  port_release(&mut ports, pic.master);
  port_release(&mut ports, pic.slave);
  port_release(&mut ports, pit.io);
  return 0;
}
