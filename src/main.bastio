const V_TIMER: u64 = 32;
const V_SYSCALL: u64 = 128;

fn fault_name(con: &mut Con, v: u64)
  requires con_ok(con)
  ensures con_ok(con)
{
  if v == 0 {
    puts(&mut con, "divide error");
  } else if v == 6 {
    puts(&mut con, "invalid opcode");
  } else if v == 13 {
    puts(&mut con, "general protection fault");
  } else if v == 14 {
    puts(&mut con, "page fault");
  } else {
    puts(&mut con, "exception");
  }
}

/// For a Linux process killed by a page fault: what the kernel knows about
/// the address, one line, so a crash that is hard to reproduce can be
/// told from its log. Native programs (no heap) print nothing. Whether the page is mapped, how many pages around it
/// the process owns (mapped or recorded), where its heap and mmap area
/// are, its parent, whether it is the only thread of its group, and how
/// long it had run (hundredths of a second).
fn fault_diag(s: &mut Sys, p: u64)
  requires sys_ok(s) && p < NPROC
  ensures sys_ok(s)
{
  let va = pget(s.k.procs, p, F_REGS + 19);
  if pget(s.k.procs, p, F_BRK) == 0 || pget(s.k.procs, p, F_BRK) > USER_SIZE || va < USER_BASE || va - USER_BASE >= USER_SIZE {
    return;
  }
  let page = (va - USER_BASE) / 4096;
  let mapped = user_present(&mut s.k.spaces, p, va);
  let owned = anon_count(&mut s.k, p, page, page + 1);
  let alone = group_alone(&mut s.k, p);
  puts(&mut s.con, "[fault diag: page ");
  put_hex(&mut s.con, page);
  if mapped {
    puts(&mut s.con, " mapped");
  } else {
    puts(&mut s.con, " not mapped");
  }
  if owned > 0 {
    puts(&mut s.con, ", owned");
  } else {
    puts(&mut s.con, ", not owned");
  }
  puts(&mut s.con, ", brk ");
  put_hex(&mut s.con, pget(s.k.procs, p, F_BRK));
  puts(&mut s.con, ", mmap ");
  put_hex(&mut s.con, pget(s.k.procs, p, F_MMAP));
  puts(&mut s.con, ", parent ");
  put_num(&mut s.con, pget(s.k.procs, p, F_PARENT));
  if alone {
    puts(&mut s.con, ", one thread");
  } else {
    puts(&mut s.con, ", threads");
  }
  puts(&mut s.con, ", age ");
  let born = pget(s.k.procs, p, F_START);
  let now = s.k.ns / 10000000;
  if born <= now {
    put_num(&mut s.con, now - born);
  } else {
    put_num(&mut s.con, 0);
  }
  puts(&mut s.con, "]\r\n");
}

// ---------------------------------------------------------------- scheduling

// Every processor runs `sched` (below): it takes the lock on the kernel's
// state, picks a READY process, takes its FPU page out, loads its address
// space with a lease (`mmu_enter`), and releases the lock while the process
// runs in user mode. The address space stays in the kernel's state: the
// threads of one process share it, and run on several processors at once,
// each with its own lease. While a space has leases its tables only grow
// (system calls map pages in place, src/space.bastio), and it is freed
// only once they are all given back. When a trap ends the run, the
// processor gives its lease back and takes the lock again, puts the FPU
// page back and handles the trap. A process on a processor is RUNNING, so
// no other processor picks it.
//
// A processor holding a lease never waits for a lock: it takes one only
// after `mmu_exit`. So `free_space`, which waits under the lock for a
// space's leases to be given back, cannot wait forever.

// The vector of each processor's local timer (boot/core.h).
const V_LTIMER: u64 = 48;
const DEBUG_EXIT: u64 = 0xF4;         // QEMU's isa-debug-exit device, in the tests
const DISK_POLL_GAP: u64 = 2000;      // idle loops between looks at a running disk command
const MAX_IDLE: u64 = 1024;           // more than there are processors

// The kernel's state and the devices the scheduler drives, shared by every
// processor through a lock. The invariant is what each processor may assume
// when it takes the lock, and must restore before it lets go.
// `idle` counts the processors that found nothing to run and have not
// come back for more: those a V_WAKE may be worth sending to. `ticked`
// says the bootstrap processor's timer ticked since the last `next_job`
// (an idle application processor sleeps through its own; see `next_job`).
// `acpi` holds the clock's PM timer (without an HPET) and the power
// button; `reboot` says the stop is a restart.
struct Sys { k: Kernel, con: Con, pic: Pic, apic: Lapic, clock: Hpet, acpi: Acpi, stop: bool, reboot: bool, idle: u64, ticked: bool, login: u64, slept: u64, polled: bool }
  invariant kok(k) && con_ok(con) && pic_ok(pic) && lapic_ok(apic) && hpet_ok(clock) && acpi_ok(acpi);

spec fn sys_ok(s: &Sys) -> bool {
  kok(s.k) && con_ok(s.con) && pic_ok(s.pic) && lapic_ok(s.apic) && hpet_ok(s.clock) && acpi_ok(s.acpi)
}

/// On the bootstrap processor's timer tick: a press of the power button
/// powers off, as `halt` does.
fn power_button(s: &mut Sys)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  if acpi_button(&mut s.acpi) {
    puts(&mut s.con, "\r\npower button: powering off\r\n");
    s.stop = true;
  }
}

// A process taken out to run: its id, its process id (tgid, for a thread),
// its lease on its address space, and its FPU page.
struct Task { pid: u64, tgid: u64, vpid: u64, vtgid: u64, lease: Lease, fpu: Frame, slow: bool }

enum Job { Stop, Idle, Disk, Run(Task) }   // Disk: idle, but a polled disk command is running

/// The system calls a processor answers without the lock, from what it
/// knows of the task it runs: the thread and process ids, and a yield while no other process waits
/// for a processor (`others`, published under the lock by turn and
/// next_job_p). True if `v` was one of them (the caller skips this for a task whose calls must all be seen: a seccomp filter, PTRACE_SYSCALL); the result is in rax and the
/// task runs on. Anything they skip (a signal, a kill, the tick's
/// accounting) waits for the task's next trap that is not one of them, at
/// the latest its timer interrupt.
fn fast_call(cpu: &mut Cpu, v: u64, pid: u64, vpid: u64, vtg: u64, others: &Atomic[bool]) -> bool {
  let n = cpu_get(cpu, R_RAX);
  if v == V_LINUX {
    if n == LX_GETTID {
      cpu_set(&mut cpu, R_RAX, vpid);
      return true;
    }
    if n == LX_GETPID {
      cpu_set(&mut cpu, R_RAX, vtg);
      return true;
    }
    if n == LX_SCHED_YIELD && !atomic_load(others) {
      cpu_set(&mut cpu, R_RAX, 0);
      return true;
    }
  } else if v == V_SYSCALL {
    if n == SYS_GETPID {
      cpu_set(&mut cpu, R_RAX, pid);
      return true;
    }
    if n == SYS_YIELD && !atomic_load(others) {
      return true;
    }
  }
  return false;
}

/// Is any process READY (waiting for a processor)?
fn any_ready(procs: &Buf, hi: u64) -> bool
  requires ptab_ok(procs)
{
  let cap = smaller(len(procs) / STRIDE, hi);     // past it, every process is FREE
  let mut p = 1;
  while p < cap
    invariant 1 <= p && cap <= NPROC
  {
    if state(procs, p) == READY {
      return true;
    }
    p = p + 1;
  }
  return false;
}

/// With the boot option `login`, the console is BusyBox's `login` (its
/// pid in s.login) instead of the native shell, and a new one starts once
/// it has ended, as init restarts a getty: logging out of the shell it
/// started brings the prompt back.
fn relogin(s: &mut Sys)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  let l = s.login;
  if l == 0 || l >= NPROC {
    return;
  }
  let st = state(s.k.procs, l);
  if st != FREE && st != ZOMBIE && pget(s.k.procs, l, F_PARENT) == 0 {
    return;                                 // still there (login, then the shell it ran)
  }
  let n = spawn_as(&mut s.k, ASH_PROG, 0, "login");
  if n != 0 {
    s.login = n;
  }
}

/// Under the lock: this processor has nothing to run.
fn go_idle(s: &mut Sys) -> Job
  requires sys_ok(s)
  ensures sys_ok(s) && result is Job::Idle
{
  if s.idle < MAX_IDLE {
    s.idle = s.idle + 1;
  }
  return Job::Idle;
}

/// Under the lock: what this processor does next. Starting at `from`
/// (round robin), takes the next READY process out, with its registers
/// loaded into `cpu` (the caller loads its FPU page), and marks it RUNNING. With `poll`, first
/// polls the network card and hands typed input to waiting readers.
fn next_job(s: &mut Sys, cpu: &mut Cpu, mmu: &mut Mmu, from: u64, poll: bool) -> Job
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  ensures sys_ok(s)
  ensures result is Job::Run ==> (1 <= result.Run.pid && result.Run.pid < NPROC)
  ensures !(result is Job::Run) ==> mmu_root(mmu) == KERNEL_ROOT
{
  if s.stop {
    // An idle application processor sleeps up to a second (see below):
    // wake it to leave too.
    if s.idle > 0 {
      lapic_wake(&mut s.apic);
    }
    return Job::Stop;
  }
  let mut woke = false;
  rng_stir(&mut s.k, cpu);
  if poll {
    nic_feed(&mut s.k.nic, &mut s.k.mem);
    nic_poll(&mut s.k.nic);
    net_wake(&mut s.k);
    tty_intr(&mut s.con, &mut s.k);
    tty_cook(&mut s.con, &mut s.k);
    wake_readers(&mut s.k.procs, &mut s.k.q, s.k.line, s.k.pid_hi);
    woke = disk_wake(&mut s.k);
    if woke && s.k.fs.disk.q.dead {
      puts(&mut s.con, "[disk: a request timed out, the disk is treated as dead]\r\n");
    }
    if sock_wake(&mut s.k) {
      woke = true;
    }
  }
  relogin(&mut s);
  if s.k.naps {
    s.k.ns = tsc_now(s.k.tsc, s.k.ns, cpu);
    sleepers_due(&mut s.k);
  }
  let p = lx_pick(&mut s.k, from);
  // Only the bootstrap processor takes V_DISK. A process the disk woke
  // that this processor is not about to run would wait for an idle
  // processor's next tick without a V_WAKE. An idle application processor
  // stops its own timer (boot/smp.c, bst_cpu_wait), so a process left
  // ready after the bootstrap processor's tick wakes the idle ones, which
  // is when their own ticks, 10 ms apart, would have found it.
  if (woke || s.ticked) && s.idle > 0 && any_ready(s.k.procs, s.k.pid_hi) {
    lapic_wake(&mut s.apic);
  }
  s.ticked = false;
  if p == 0 {
    if live_count(s.k.procs, s.k.pid_hi) == 0 {
      s.stop = true;
      return Job::Stop;
    }
    if disk_polled(s.k) {
      return Job::Disk;
    }
    return go_idle(&mut s);
  }
  group_take(&mut s.k, mmu, p);                 // a thread gets its group's space
  if !lx_deliver(&mut s.k, mmu, p) {
    return go_idle(&mut s);                 // a signal ended it
  }
  match take_space(&mut s.k.spaces, p) {
    Space::Empty => {
      // A READY process always has a space; end it rather than spin on it.
      terminate(&mut s.k, mmu, p, 139);
      return go_idle(&mut s);
    },
    Space::Mapped(root) => {
      match take_fpu(&mut s.k.fpus, p) {
        Fpu::None => {
          put_space(&mut s.k.spaces, p, Space::Mapped(root));
          terminate(&mut s.k, mmu, p, 139);
          return go_idle(&mut s);
        },
        Fpu::State(f) => {
          let mut sp = root;
          let l = mmu_enter(&mut mmu, &mut sp);
          put_space(&mut s.k.spaces, p, Space::Mapped(sp));
          regs_load(&mut cpu, s.k.procs, p, 18);
          cpu_set(&mut cpu, R_FSBASE, pget(s.k.procs, p, F_REGS + R_FSBASE));
          pset(&mut s.k.procs, p, F_STATE, RUNNING);
          return Job::Run(Task { pid: p, tgid: tgid(s.k.procs, p), vpid: vpid_of(s.k, p, p), vtgid: vpid_of(s.k, p, tgid(s.k.procs, p)), lease: l, fpu: f, slow: sc_mode(s.k, p) != 0 || tr2_get(s.k, p) % 2 == 1 });
        },
      }
    },
  }
}

// An idle bootstrap processor stretches the timer tick. The kernel's tick
// is the PIT's, every 10 ms, and under QEMU's TCG an interrupt costs the
// host enough that an idle guest took 15% of a host processor. When
// nothing can happen before a known time, the PIT is masked and this
// processor's local APIC timer is set to that time instead (up to a
// second, as an idle application processor's is): any other interrupt
// ends the stretch early. The tick count catches up on the time that
// passed. Everything that runs off the tick must be quiet for that
// (stretch_p says what is checked); a stretched tick is never used while
// a process runs, waits for the disk, the network or the console, or has a
// timer the tick would check.
const STRETCH_MAX: u64 = 1000000000;
const STRETCH_MIN_TICKS: u64 = 3;

/// How long, at most, the tick may be stretched from now (k.ns), in ns; 0
/// if some process or timer needs it. Only waits that end by an interrupt,
/// another process's trap, or a deadline TIMEWAIT keeps are allowed.
fn idle_horizon(k: &Kernel) -> u64
  requires kok(k)
{
  let mut h = STRETCH_MAX;
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && kok(k)
  {
    let st = state(k.procs, p);
    if st == TIMEWAIT {
      let w = pget(k.procs, p, F_RESTART);
      if w < 2 || w - 2 <= k.ns || w - 2 - k.ns <= NEAR {
        return 0;                           // sleepers_due makes it ready now
      }
      h = smaller(h, w - 2 - k.ns - NEAR);
    } else if st != FREE && st != ZOMBIE && st != READING && st != WAITING && st != LXREADING
       && st != LXWAITING && st != LXVFORK && st != FUTEXWAIT && st != SOCKWAIT && st != STOPPED {
      return 0;
    }
    p = p + 1;
  }
  let mut i = 0;
  while i < len(k.alarms)
    invariant i <= len(k.alarms) && kok(k)
  {
    if get(k.alarms, i) != 0 {
      return 0;                             // alarm, setitimer or a POSIX timer
    }
    i = i + 1;
  }
  let mut t = 0;
  while t < TFD_N
    invariant t <= TFD_N && kok(k)
  {
    if get(k.evt, t * TFD_STRIDE + 2) != 0 {
      return 0;                             // a timerfd is armed
    }
    t = t + 1;
  }
  return h;
}

/// Under the lock, on the bootstrap processor with nothing to run: stretches
/// the tick if nothing needs it (see above).
fn stretch_p(s: &mut Sys, cpu: &Cpu)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  if s.slept != 0 || s.stop || !s.apic.on {
    return;
  }
  // The platform: a local APIC timer that can be set to a count (xAPIC,
  // calibrated), and the PIT as the tick.
  let c10 = boot_info(cpu, INFO_TIMER, 1);
  if boot_info(cpu, INFO_TIMER, 4) != 1 || boot_info(cpu, INFO_TIMER, 2) != 0 || c10 == 0 || c10 > 42949672 {
    return;
  }
  if lapic_self(&mut s.apic) != s.apic.id {
    return;                                 // not the bootstrap processor
  }
  // What else the tick drives: a polled keyboard or mouse (USB, or a PS/2
  // mouse), sound, a card that
  // raises no interrupt, the network stack's timers, the disk's batch.
  if s.polled || snd_queued(s.k.snd) != 0
     || (nic_up(s.k.nic) && !nic_irq(s.k.nic)) || !nic_timers_idle(s.k.nic)
     || !dq_idle(s.k.fs.disk.q) || s.k.fs.disk.pw != 0 {
    return;
  }
  s.k.ns = tsc_now(s.k.tsc, s.k.ns, cpu);
  let n = smaller(smaller(idle_horizon(s.k) / NS_PER_TICK, 100), nic_dhcp_due(s.k.nic, s.k.ticks));
  if n < STRETCH_MIN_TICKS || s.k.ns >= FOREVER {
    return;
  }
  nic_listen(&mut s.k.nic);                 // a frame ends the stretch
  pic_mask_timer(&mut s.pic);
  lapic_arm(&mut s.apic, c10 * n, V_LTIMER);
  s.slept = s.k.ns + 1;
}

/// Does some process sleep until a frame comes in?
fn frame_waiters(k: &Kernel) -> bool
  requires kok(k)
{
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && kok(k)
  {
    if state(k.procs, p) == SOCKWAIT && pget(k.procs, p, F_WAIT) != NO_RESULT {
      return true;
    }
    p = p + 1;
  }
  return false;
}

/// Under the lock, when the processor wakes from a stretched tick (by its
/// timer or any other interrupt): puts the PIT back, catches the tick
/// count up (one tick less than the time that passed: the PIT's edge
/// latched while it was masked is delivered as one), and does what a tick
/// does.
fn stretch_end(s: &mut Sys, cpu: &Cpu)
  requires sys_ok(s) && s.slept != 0
  ensures sys_ok(s)
{
  lapic_disarm(&mut s.apic);
  pic_unmask_timer(&mut s.pic);
  let t0 = s.slept - 1;
  s.slept = 0;
  s.k.ns = tsc_now(s.k.tsc, s.k.ns, cpu);
  if s.k.ns > t0 {
    let due = sat_add(s.k.ns - t0, NS_PER_TICK / 2) / NS_PER_TICK;
    if due >= 1 {
      s.k.ticks = sat_add(s.k.ticks, due - 1);
    }
  }
  s.ticked = true;
  lx_alarms(&mut s.k);
  power_button(&mut s);
  if !frame_waiters(s.k) {
    nic_quiet(&mut s.k.nic);
  }
}

/// `stretch_p`, for `locked`.
fn stretch_lp(s: &mut Sys, cpu: &Cpu)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  stretch_p(&mut s, cpu);
}

/// Under the lock, after an idle wait ended with vector `v`.
fn idled(s: &mut Sys, cpu: &Cpu, v: u64)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  ack(&mut s.pic, &mut s.apic, v);
  if s.slept != 0 {
    stretch_end(&mut s, cpu);
  }
  if v == V_TIMER {
    s.k.ticks = tick(s.k.ticks);
    s.ticked = true;
    snd_poll(&mut s.k.snd);
    s.k.ns = tsc_now(s.k.tsc, s.k.ns, cpu);
    cg_cpu_tick(&mut s.k, 0);
    lx_alarms(&mut s.k);
    power_button(&mut s);
  }
  sleepers_wake(&mut s.k);                    // an interrupt may end a timed wait
}

/// Under the lock, after process `p` ran on this processor until a trap
/// with vector `v` (and its lease was given back): puts its FPU page `fpu`
/// (saved by the caller) back and handles the trap. Returns where this
/// processor's round robin goes on.
fn finish(s: &mut Sys, cpu: &mut Cpu, mmu: &Mmu, p: u64, fpu: Frame, v: u64) -> u64
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  requires 1 <= p && p < NPROC
  ensures sys_ok(s) && result < NPROC
{
  restore_fpu(&mut s.k.mem, &mut s.k.fpus, p, Fpu::State(fpu));
  // Registers, then the error code, fault address and FS base (words 18-20).
  regs_store(&mut s.k.procs, cpu, p, 21);
  ack(&mut s.pic, &mut s.apic, v);
  if v == V_TIMER {
    s.k.ticks = tick(s.k.ticks);
    s.ticked = true;
    snd_poll(&mut s.k.snd);
  }
  if state(s.k.procs, p) == EXITING {
    thread_free(&mut s.k, mmu, p, tgid(s.k.procs, p));   // its leader is in execve
    return (p + 1) % NPROC;
  }
  // The group's shared state (descriptors, working directory, ..) comes
  // to p, for the trap's handling: another thread may have run since.
  group_take(&mut s.k, mmu, p);
  let killed = state(s.k.procs, p) == KILLED;
  if state(s.k.procs, p) == RUNNING || killed {
    pset(&mut s.k.procs, p, F_STATE, READY);
  }
  if killed {
    terminate(&mut s.k, mmu, p, 137);
    return (p + 1) % NPROC;
  }
  if v != V_TIMER && v != V_LTIMER && v != V_WAKE && pget(s.k.procs, p, F_TGID) != 0 && !has_space(&mut s.k.spaces, p) {
    // A thread whose group has lent its address space to a vfork child
    // (lx_vfork_vm) trapped on another processor, and group_take found
    // nothing to bring: its descriptors, working directory and signal
    // actions are with the vforking thread, and the call or fault would
    // see empty ones (a read of an open descriptor failing with EBADF).
    // It runs the instruction again once the space is back, which the
    // scheduler waits for (group_free).
    let rip = pget(s.k.procs, p, F_REGS + R_RIP);
    if (v == V_LINUX || v == V_SYSCALL) && rip >= SYSCALL_LEN {
      pset(&mut s.k.procs, p, F_REGS + R_RIP, rip - SYSCALL_LEN);
    }
    if v == V_LINUX || v == V_SYSCALL || v == 14 {
      return (p + 1) % NPROC;
    }
  }
  if v == V_TIMER || v == V_LTIMER {
    // A process waiting in a system call is READY with its rip on the
    // syscall instruction and F_RESTART set, and retries the call each
    // time it runs; a tick that finds it there has run none of its own
    // code, so it is not charged CPU time (a sleep would count otherwise).
    if pget(s.k.procs, p, F_RESTART) == 0 {
      pset(&mut s.k.procs, p, F_TICKS, tick(pget(s.k.procs, p, F_TICKS)));
      s.k.sys = set(s.k.sys, SYS_BUSY, tick(get(s.k.sys, SYS_BUSY)));
      cpu_timers_tick(&mut s.k, p);
      cg_cpu_tick(&mut s.k, p);
      // Counting resident pages walks a space, so it is done every 16th tick
      // the process itself was charged (the global tick count could land on
      // the same other process every time, with a few processes taking turns).
      if pget(s.k.procs, p, F_TICKS) % 16 == 0 {
        cg_oom_tick(&mut s.k, p);
      }
    } else {
      // Nobody is charged, but a cpu.max period must still end on time: a
      // throttled group's processes are not picked, so while the processors
      // only run waiting calls again no other tick would start the next
      // period (cg_cpu_tick with no process, as an idle tick does).
      s.k.ns = tsc_now(s.k.tsc, s.k.ns, cpu);
      cg_cpu_tick(&mut s.k, 0);
    }
    s.k.ns = tsc_now(s.k.tsc, s.k.ns, cpu);
    lx_alarms(&mut s.k);
    if v == V_TIMER {
      power_button(&mut s);
    }
    return (p + 1) % NPROC;
  }
  if v == V_SYSCALL {
    s.k.ns = tsc_now(s.k.tsc, s.k.ns, cpu);
    s.k.fs.now = sat_add(s.k.epoch, s.k.ns) / 1000000000;   // wall-clock seconds, as stat reports them
    let what = syscall(&mut s.con, &mut s.k, mmu, p);
    if what == POWEROFF || what == REBOOT {
      s.stop = true;
      s.reboot = what == REBOOT;
    }
    sock_wake(&mut s.k);                    // a frame its call took in may wake a socket waiter
    if disk_hold(&mut s.k, p, NO_RESULT) {
      return (p + 1) % NPROC;               // a queued write: it waits for the disk
    }
    if what == KEEP {
      return p;
    }
    return (p + 1) % NPROC;
  }
  if v == V_LINUX {
    s.k.ns = tsc_now(s.k.tsc, s.k.ns, cpu);
    s.k.fs.now = sat_add(s.k.epoch, s.k.ns) / 1000000000;   // wall-clock seconds, as stat reports them
    let began = s.k.ns;
    if pt_sys_entry(&mut s.k, p, pget(s.k.procs, p, F_RESTART) != 0) {
      return (p + 1) % NPROC;               // stopped for its tracer before the call (src/lxptrace.bastio)
    }
    ino_before(&mut s.k, p);                // src/lxinotify.bastio
    let what = linux_syscall(&mut s.con, &mut s.k, mmu, p);
    ino_after(&mut s.k, p);
    let ended = tsc_now(s.k.tsc, s.k.ns, cpu);
    if ended > began {
      tm_sys_add(&mut s.k, p, ended - began);   // system time (src/lxrlimit.bastio)
    }
    call_done(&mut s.k, p);
    if what == POWEROFF || what == REBOOT {
      s.stop = true;
      s.reboot = what == REBOOT;
    }
    sock_wake(&mut s.k);
    if what == SWITCH {
      sig_wake_now(&mut s.k, p);            // a signal posted while it ran is not lost to its sleep
    }
    if disk_hold(&mut s.k, p, EIO) || what == SWITCH {
      return (p + 1) % NPROC;
    }
    if what == KEEP && pt_sys_exit(&mut s.k, p) {
      return (p + 1) % NPROC;               // stopped for its tracer after the call
    }
    return p;
  }
  let mut is_bus = false;
  if v == 14 {
    let lz = lazy_fault(&mut s.k, p);
    if lz == LZ_WAIT && state(s.k.procs, p) == READY {
      // Its code page's blocks are being read: it sleeps until the disk's
      // queue moves, then faults again (and finds them in the cache).
      pset(&mut s.k.procs, p, F_STATE, DISKWAIT);
      pset(&mut s.k.procs, p, F_WAIT, RETRY_BIT + s.k.fs.disk.q.moved % RETRY_BIT);
      disk_wake(&mut s.k);
      if state(s.k.procs, p) == DISKWAIT {
        return (p + 1) % NPROC;
      }
      return p;
    }
    // A page past a mapped file's end (src/lxmem.bastio). If the file has
    // grown to cover it the instruction runs again; a second fault at the
    // same place is not this one's doing, and goes on to the handlers below.
    let bva = pget(s.k.procs, p, reg_word(R_FAULT));
    let brip = pget(s.k.procs, p, F_REGS + R_RIP) % 4611686018427387904 + 1;
    let mut bus = 0;
    if pget(s.k.procs, p, F_FAULT_RIP) != brip || pget(s.k.procs, p, F_FAULT_VA) != bva {
      bus = bus_fault(&mut s.k, p);
    }
    is_bus = bus == 2;
    if bus == 1 {
      pset(&mut s.k.procs, p, F_FAULT_RIP, brip);
      pset(&mut s.k.procs, p, F_FAULT_VA, bva);
      return p;
    }
    if lz != LZ_NO || anon_fault(&mut s.k, p) || cow_fault(&mut s.k, p) || stack_fault(&mut s.k, p) {
      pset(&mut s.k.procs, p, F_FAULT_RIP, 0);
      return p;                             // code read, a page mapped or copied, or the stack grew: run the instruction again
    }
    // Out of memory (src/oom.bastio): give cached pages back, or end the
    // process holding the most. The access was legitimate: the page was
    // there to map, there was none to map it with.
    let ova = pget(s.k.procs, p, reg_word(R_FAULT));
    if ova >= USER_BASE && ova - USER_BASE < USER_SIZE {
      let oq = (ova - USER_BASE) / 4096;
      let want = anon_covers(s.k.anon, p, oq) || lazy_covers(s.k, p, oq)
        || (user_present(&mut s.k.spaces, p, ova) && !user_page_writable(&mut s.k.spaces, p, ova));
      let oo = oom_fault(&mut s.k, &mut s.con, p, want);
      if oo == OOM_RETRY {
        pset(&mut s.k.procs, p, F_FAULT_RIP, 0);
        return p;
      }
      if oo == OOM_WAIT {
        return (p + 1) % NPROC;
      }
      if oo == OOM_SELF {
        terminate(&mut s.k, mmu, p, death_code(SIGKILL, false));
        return (p + 1) % NPROC;
      }
    }
    // Another thread, on another processor, may have mapped a page of
    // code (src/lazy.bastio) or anonymous memory (src/lxanon.bastio), or
    // broken a copy-on-write page (a write the kernel made for this process,
    // process_vm_writev, does the same), between this fault and its
    // handling: the handler above then finds it mapped (writable) and
    // declines. Run the instruction once more; a second fault at the same
    // place is a protection fault.
    let fva = pget(s.k.procs, p, reg_word(R_FAULT));
    let frip = pget(s.k.procs, p, F_REGS + R_RIP) % 4611686018427387904 + 1;
    if fva >= USER_BASE && fva - USER_BASE < USER_SIZE
       && (anon_covers(s.k.anon, p, (fva - USER_BASE) / 4096) || lazy_covers(s.k, p, (fva - USER_BASE) / 4096)
           || user_page_writable(&mut s.k.spaces, p, fva))
       && (pget(s.k.procs, p, F_FAULT_RIP) != frip || pget(s.k.procs, p, F_FAULT_VA) != fva) {
      pset(&mut s.k.procs, p, F_FAULT_RIP, frip);
      pset(&mut s.k.procs, p, F_FAULT_VA, fva);
      return p;
    }
  }
  if v < 32 {
    // Dies of the signal Linux would send: a parent's wait4 sees a
    // SIGSEGV (or SIGFPE, SIGILL, SIGTRAP), and a shell prints 128 + it.
    // A handler for it runs instead, if the process has one.
    let mut sig = SIGSEGV;
    if is_bus {
      sig = SIGBUS;
    }
    if v == 0 {
      sig = SIGFPE;
    } else if v == 6 {
      sig = SIGILL;
    } else if v == 3 {
      sig = SIGTRAP;
      pt_brk(&mut s.k, p);
    } else if v == 1 {
      sig = SIGTRAP;                        // a single step (src/lxptrace.bastio)
      pt_stepped(&mut s.k, p);
    }
    let mut addr = pget(s.k.procs, p, F_REGS + R_RIP);
    if v == 14 {
      addr = pget(s.k.procs, p, F_REGS + 19);   // CR2
    }
    if fault_caught(&mut s.k, p, sig, addr) {
      return (p + 1) % NPROC;
    }
    puts(&mut s.con, "\r\n[pid ");
    put_num(&mut s.con, p);
    puts(&mut s.con, " (");
    puts(&mut s.con, prog_name(pget(s.k.procs, p, F_PROG)));
    puts(&mut s.con, "): ");
    fault_name(&mut s.con, v);
    puts(&mut s.con, " at rip ");
    put_hex(&mut s.con, pget(s.k.procs, p, F_REGS + R_RIP));
    if v == 14 {
      puts(&mut s.con, ", address ");
      put_hex(&mut s.con, pget(s.k.procs, p, F_REGS + 19));
    }
    puts(&mut s.con, "; killed]\r\n");
    if v == 14 {
      fault_diag(&mut s, p);
    }
    let dumped = core_dump(&mut s.k, p, sig);
    terminate(&mut s.k, mmu, p, death_code(sig, dumped));
    return (p + 1) % NPROC;
  }
  return p;
}

/// The scheduler loop each processor runs, with its own `cpu` and `mmu`,
/// until the kernel stops (no process left, or a power off).
// What `turn` hands back: the next job, and where the round robin goes on.
struct Next { job: Job, from: u64 }

/// After finish handled process p's trap: the trap may have ended a timed
/// wait (sleepers_wake), unless it was a wait that goes on (its restart
/// word is set, lx_retry), which changed nothing.
fn after_trap(s: &mut Sys, p: u64)
  requires sys_ok(s) && p < NPROC
  ensures sys_ok(s)
{
  if pget(s.k.procs, p, F_RESTART) == 0 {
    sleepers_wake(&mut s.k);
  }
}

/// `finish` for task `t`, then `next_job` from where it leaves the round
/// robin, in one critical section, so a system call costs one round trip
/// of the lock. Publishes how much console output waits in `pend`.
fn turn(s: &mut Sys, cpu: &mut Cpu, mmu: &mut Mmu, p: u64, fpu: Frame, v: u64, poll: bool, pend: &Atomic[u64], others: &Atomic[bool]) -> Next
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  requires 1 <= p && p < NPROC
  ensures sys_ok(s) && result.from < NPROC
  ensures result.job is Job::Run ==> (1 <= result.job.Run.pid && result.job.Run.pid < NPROC)
  ensures !(result.job is Job::Run) ==> mmu_root(mmu) == KERNEL_ROOT
{
  let c = finish(&mut s, &mut cpu, mmu, p, fpu, v);
  after_trap(&mut s, p);
  let j = next_job(&mut s, &mut cpu, &mut mmu, c, poll);
  atomic_store(pend, s.con.r.n + gfx_pending(s.k));
  atomic_store(others, any_ready(s.k.procs, s.k.pid_hi));
  return Next { job: j, from: c };
}

// What `fault_fast` hands back: the task to run again (with a new lease on
// its space), or its FPU page for the usual turn.
enum Fast { Back(Frame), Go(Task) }

/// Under the lock, after task `p` trapped with a page fault (its lease and
/// FPU page are given back): if it is a plain process whose fault is anonymous
/// memory, a copy-on-write page or the stack growing, maps the page and
/// enters its space again, so the processor runs the task on without
/// putting it back in the round robin and picking a process (finish and
/// next_job do both for every other trap). Anything else, and a task that is
/// not RUNNING any more (killed from another processor), takes the usual turn.
/// The kernel does not touch the registers or the FPU page here, so the task
/// continues from the state the processor holds.
fn fault_fast(s: &mut Sys, cpu: &Cpu, mmu: &mut Mmu, p: u64, tgid_: u64, vpid: u64, vtgid: u64, slow: bool, fpu: Frame) -> Fast
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  requires 1 <= p && p < NPROC
  ensures sys_ok(s)
  ensures result is Fast::Go ==> (1 <= result.Go.pid && result.Go.pid < NPROC)
  ensures !(result is Fast::Go) ==> mmu_root(mmu) == KERNEL_ROOT
{
  if s.stop || state(s.k.procs, p) != RUNNING || pget(s.k.procs, p, F_TGID) != 0 {
    return Fast::Back(fpu);
  }
  pset(&mut s.k.procs, p, reg_word(R_FAULT), cpu_get(cpu, R_FAULT));
  if !(anon_fault(&mut s.k, p) || cow_fault(&mut s.k, p) || stack_fault(&mut s.k, p)) {
    return Fast::Back(fpu);
  }
  pset(&mut s.k.procs, p, F_FAULT_RIP, 0);
  match take_space(&mut s.k.spaces, p) {
    Space::Empty => {
      return Fast::Back(fpu);
    },
    Space::Mapped(root) => {
      let mut sp = root;
      let l = mmu_enter(&mut mmu, &mut sp);
      put_space(&mut s.k.spaces, p, Space::Mapped(sp));
      return Fast::Go(Task { pid: p, tgid: tgid_, vpid: vpid, vtgid: vtgid, lease: l, fpu: fpu, slow: slow });
    },
  }
}

/// `next_job`, then publishes how much console output waits in `pend`.
/// `back`: this processor was idle (its last job was Job::Idle).
fn next_job_p(s: &mut Sys, cpu: &mut Cpu, mmu: &mut Mmu, from: u64, poll: bool, back: bool, pend: &Atomic[u64], others: &Atomic[bool]) -> Job
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  ensures sys_ok(s)
  ensures result is Job::Run ==> (1 <= result.Run.pid && result.Run.pid < NPROC)
  ensures !(result is Job::Run) ==> mmu_root(mmu) == KERNEL_ROOT
{
  if back && s.idle > 0 {
    s.idle = s.idle - 1;
  }
  let j = next_job(&mut s, &mut cpu, &mut mmu, from, poll);
  atomic_store(pend, s.con.r.n + gfx_pending(s.k));
  atomic_store(others, any_ready(s.k.procs, s.k.pid_hi));
  return j;
}

/// `idled`, then publishes how much console output waits in `pend`.
fn idled_p(s: &mut Sys, cpu: &Cpu, v: u64, pend: &Atomic[u64])
  requires sys_ok(s)
  ensures sys_ok(s)
{
  idled(&mut s, cpu, v);
  atomic_store(pend, s.con.r.n + gfx_pending(s.k));
}

/// `finish`, then publishes how much console output waits in `pend`.
fn finish_p(s: &mut Sys, cpu: &mut Cpu, mmu: &Mmu, p: u64, fpu: Frame, v: u64, pend: &Atomic[u64]) -> u64
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  requires 1 <= p && p < NPROC
  ensures sys_ok(s) && result < NPROC
{
  let c = finish(&mut s, &mut cpu, mmu, p, fpu, v);
  after_trap(&mut s, p);
  atomic_store(pend, s.con.r.n + gfx_pending(s.k));
  return c;
}

// The most bytes `pump` moves per round, each way.
const CHUNK: u64 = 256;

/// Under the kernel lock, for `pump`: queues the rn bytes received in rx as
/// typed input, and moves the next chunk of output into tx. Returns how
/// many bytes of tx to send.
fn exchange(s: &mut Sys, tx: &mut Bytes, gx: &mut Bytes, rx: &Bytes, rn: u64, mx: &Bytes, mn: u64, cad: bool, pend: &Atomic[u64]) -> u64
  requires sys_ok(s) && blen(gx) == GXB_LEN
  ensures sys_ok(s) && blen(gx) == GXB_LEN
{
  if cad {
    // Ctrl-Alt-Delete restarts the machine, as on Linux, so a host that
    // sends it (Firecracker's SendCtrlAltDel) can stop or restart a guest
    // that has no ACPI.
    puts(&mut s.con, "\r\nctrl-alt-del: restarting\r\n");
    s.stop = true;
    s.reboot = true;
  }
  mice_push(&mut s.k, mx, mn);              // mouse packets (src/lxmouse.bastio)
  let mut typed = rn > 0;
  let mut i = 0;
  while i < rn && i < blen(rx)
    invariant sys_ok(s)
  {
    q_push(&mut s.k.q, cast[u64](bget(rx, i)));
    i = i + 1;
  }
  // A USB keyboard (and mouse) on the disk's controller is polled here,
  // under this lock, since the controller is part of the disk.
  let mut k = 0;
  while k < CHUNK
    invariant sys_ok(s)
  {
    let c = vfs_kbd_poll(&mut s.k.fs);
    if c < 256 {
      q_push(&mut s.k.q, c);
      typed = true;
      k = k + 1;
    } else if c > 256 {
      mice_put(&mut s.k, c - MOUSE_PKT);
      k = k + 1;
    } else {
      k = CHUNK;
    }
  }
  if typed {
    tty_intr(&mut s.con, &mut s.k);
    tty_cook(&mut s.con, &mut s.k);
    wake_readers(&mut s.k.procs, &mut s.k.q, s.k.line, s.k.pid_hi);
  }
  let n = con_take(&mut s.con, &mut tx);
  // What the screen is told next, if a program draws on it (src/lxfb.bastio).
  let drew = gfx_take(&mut s.k, &mut gx);
  if con_room(s.con) >= OUTCAP / 2 || drew {
    wake_writers(&mut s.k.procs);
  }
  atomic_store(pend, s.con.r.n + gfx_pending(s.k));
  return n;
}

/// Under the console devices' lock: moves output from the kernel's ring to
/// the devices, and typed bytes into the kernel, a chunk at a time. The
/// kernel lock is taken only to move the bytes (`exchange`); the device
/// I/O, two port accesses per byte on the serial line and slow on a real
/// one, happens with it free, so the other processors go on. Stops after a
/// bounded number of chunks so a busy writer cannot keep this processor
/// here.
fn pump(t: &mut Term, s: &Lock[Sys], pend: &Atomic[u64])
  requires term_ok(t)
  ensures term_ok(t)
{
  let mut tx = balloc(CHUNK);
  let mut rx = balloc(CHUNK);
  let mut mx = balloc(CHUNK);
  let mut gx = balloc(GXB_LEN);
  let mut rounds = 0;
  let mut more = true;
  while more && rounds < 64
    invariant term_ok(t) && blen(rx) == CHUNK && blen(mx) == CHUNK && blen(gx) == GXB_LEN
  {
    let mut rn = 0;
    let mut mn = 0;
    let mut cad = false;
    let mut c = 0;
    while c != 256 && rn < CHUNK && mn + 4 <= CHUNK
      invariant term_ok(t) && rn <= CHUNK && mn <= CHUNK && blen(rx) == CHUNK && blen(mx) == CHUNK
    {
      c = term_poll(&mut t);
      if c == KBD_CAD {
        cad = true;
      } else if c < 256 {
        bset(&mut rx, rn, cast[u8](c));
        rn = rn + 1;
      } else if c > 256 {
        let p = c - MOUSE_PKT;              // a mouse packet: its four bytes
        bset(&mut mx, mn, cast[u8](p / 16777216 % 256));
        bset(&mut mx, mn + 1, cast[u8](p / 65536 % 256));
        bset(&mut mx, mn + 2, cast[u8](p / 256 % 256));
        bset(&mut mx, mn + 3, cast[u8](p % 256));
        mn = mn + 4;
      }
    }
    let tn = locked(s, exchange, &mut tx, &mut gx, rx, rn, mx, mn, cad, pend);
    term_send(&mut t, tx, tn);
    let gk = get_u64(gx, 0);
    if gk == GX_HOLD {
      screen_hold(&mut t.screen);
    } else if gk == GX_RELEASE {
      screen_release(&mut t.screen);
    } else if gk == GX_BLIT {
      let go = get_u64(gx, 8);
      let gn = get_u64(gx, 16);
      if go <= 281474976710656 {
        screen_blit(&mut t.screen, go, gx, 24, smaller(gn, XFER));
      }
    }
    more = tn == CHUNK || rn == CHUNK || mn + 4 > CHUNK || gk != GX_NONE;
    rounds = rounds + 1;
  }
  bfree(tx);
  bfree(rx);
  bfree(mx);
  bfree(gx);
}

/// Pumps the console if no other processor is already doing it. One that
/// is will see any output queued meanwhile on its next round, or the next
/// processor to finish a turn will.
fn try_pump(u: &Lock[Term], s: &Lock[Sys], pumping: &Atomic[bool], pend: &Atomic[u64]) {
  if atomic_cas(pumping, false, true) {
    locked(u, pump, s, pend);
    atomic_store(pumping, false);
  }
}

/// The scheduler loop each processor runs, with its own `cpu` and `mmu`,
/// until the kernel stops (no process left, or a power off).
fn sched(cpu: &mut Cpu, mmu: &mut Mmu, s: &Lock[Sys], u: &Lock[Term], pumping: &Atomic[bool], pend: &Atomic[u64], others: &Atomic[bool])
  requires mmu_root(mmu) == KERNEL_ROOT
  ensures mmu_root(mmu) == KERNEL_ROOT
{
  let mut cur = 1;
  let mut going = true;
  let mut j = locked(s, next_job_p, &mut cpu, &mut mmu, cur, true, false, pend, others);
  while going
    invariant cur < NPROC
    invariant !(j is Job::Run) ==> mmu_root(mmu) == KERNEL_ROOT
    invariant j is Job::Run ==> (1 <= j.Run.pid && j.Run.pid < NPROC)
  {
    // Devices are polled after an interrupt or idle wait, not after a
    // system call: every processor's timer interrupts often enough, and
    // polling on every call would put port I/O in the hottest critical
    // section. The console is pumped only while this processor holds no
    // lease (see the top of this section).
    match j {
      Job::Stop => {
        going = false;
        j = Job::Stop;
      },
      Job::Idle => {
        // Nothing to run: pump the console if it has output and no other
        // processor is at it, else sleep until an interrupt.
        if atomic_load(pend) == 0 || atomic_load(pumping) {
          locked(s, stretch_lp, cpu);
          let v = cpu_idle(&mut cpu);
          locked(s, idled_p, cpu, v, pend);
        }
        try_pump(u, s, pumping, pend);
        j = locked(s, next_job_p, &mut cpu, &mut mmu, cur, true, true, pend, others);
      },
      Job::Disk => {
        // Nothing to run, but a process waits for a disk command, and the
        // disk raises no interrupt (blk_irq): look again shortly instead
        // of sleeping until the next tick.
        let mut w = 0;
        while w < DISK_POLL_GAP && atomic_load(pend) == 0 {
          w = w + 1;
        }
        j = locked(s, next_job_p, &mut cpu, &mut mmu, cur, true, false, pend, others);
      },
      Job::Run(t) => {
        // The FPU page is this processor's while the task runs, so it is
        // loaded and saved outside the lock.
        cpu_fpu_load(&mut cpu, t.fpu);
        let mut v = cpu_run(&mut cpu, mmu);
        // A task with a seccomp filter or under PTRACE_SYSCALL has every
        // call seen by the kernel, the ones answered here included.
        while !t.slow && fast_call(&mut cpu, v, t.pid, t.vpid, t.vtgid, others) {
          v = cpu_run(&mut cpu, mmu);         // answered without the lock
        }
        mmu_exit(&mut mmu, t.lease);
        let mut f = t.fpu;
        cpu_fpu_save(&mut cpu, &mut f);
        // A page fault that maps memory for the task runs it again at once
        // (fault_fast), without a turn of the round robin.
        let mut fr = Fast::Back(f);
        if v == 14 && atomic_load(pend) == 0 {
          match fr {
            Fast::Back(g) => {
              fr = locked(s, fault_fast, cpu, &mut mmu, t.pid, t.tgid, t.vpid, t.vtgid, t.slow, g);
            },
            Fast::Go(x) => {
              fr = Fast::Go(x);
            },
          }
        }
        match fr {
          Fast::Go(t2) => {
            j = Job::Run(t2);
          },
          Fast::Back(f2) => {
            // A processor exception (a page fault, vectors below 32) raises no
            // device input either: a program touching new memory would poll every
            // device on each of its faults.
            let poll = v >= V_TIMER && v != V_SYSCALL && v != V_LINUX;
            // After an interrupt the devices may have input; after any turn
            // there may be output.
            if poll || atomic_load(pend) > 0 {
              try_pump(u, s, pumping, pend);
            }
            let next = locked(s, turn, &mut cpu, &mut mmu, t.pid, f2, v, poll, pend, others);
            cur = next.from;
            j = next.job;
          },
        }
      },
    }
  }
  // Only Stop ends the loop; a task here would be put back as after a tick.
  match j {
    Job::Run(t) => {
      mmu_exit(&mut mmu, t.lease);
      let c = locked(s, finish_p, &mut cpu, mmu, t.pid, t.fpu, V_TIMER, pend);
    },
    Job::Idle => {},
    Job::Disk => {},
    Job::Stop => {},
  }
}

/// Acknowledges vector `v` at the interrupt controllers if it is a
/// hardware interrupt (the local timer's is acknowledged by boot/smp.c).
fn ack(pic: &mut Pic, apic: &mut Lapic, v: u64)
  requires pic_ok(pic) && lapic_ok(apic)
  ensures lapic_ok(apic)
{
  if V_IRQ0 <= v && v < V_IRQ_END {
    pic_eoi(&mut pic, v);
  }
  lapic_eoi(&mut apic, v);
}

/// A MAC address as six hex bytes, colon-separated.
fn put_mac(con: &mut Con, mac: u64)
  requires con_ok(con)
  ensures con_ok(con)
{
  let mut q = 0x10000000000;
  let mut first = true;
  while q > 0
    invariant con_ok(con)
  {
    if !first {
      con_write(&mut con, 58);
    }
    first = false;
    let b = (mac / q) % 256;
    let hi = b / 16;
    let lo = b % 16;
    if hi < 10 { con_write(&mut con, cast[u8](48 + hi)); } else { con_write(&mut con, cast[u8](87 + hi)); }
    if lo < 10 { con_write(&mut con, cast[u8](48 + lo)); } else { con_write(&mut con, cast[u8](87 + lo)); }
    q = q / 256;
  }
}

/// Between the parts of the hardware report, so each can be read (or
/// photographed): waits for a key, or a minute, or, without a clock,
/// about as many polls.
fn diag_pause(t: &mut Term, con: &mut Con, clock: &mut Hpet, acpi: &mut Acpi)
  requires term_ok(t) && con_ok(con) && hpet_ok(clock) && acpi_ok(acpi)
  ensures term_ok(t) && con_ok(con) && hpet_ok(clock) && acpi_ok(acpi)
{
  puts(&mut con, "-- press a key to go on (or wait a minute) --");
  con_flush(&mut t, &mut con);
  let start = clock_ns(&mut clock, &mut acpi);
  let mut polls = 0;
  let mut go = false;
  while !go && polls < 100000000
    invariant term_ok(t) && hpet_ok(clock) && acpi_ok(acpi)
  {
    let now = clock_ns(&mut clock, &mut acpi);
    if term_poll(&mut t) < 256 || now < start || now - start >= 60000000000 {
      go = true;
    }
    polls = polls + 1;
  }
  puts(&mut con, "\r\n");
  con_flush(&mut t, &mut con);
}

fn tick(t: u64) -> u64 {
  if t < 18446744073709551615 {
    return t + 1;
  }
  return t;
}

fn main(ports: &mut Ports, win: &mut MmioSpace, pool: &mut Pool, mmu: &mut Mmu, cpu: &mut Cpu) -> u64 {
  // Every device the kernel drives, with the I/O ports it owns. The ports
  // are claimed here, once: no two drivers can own the same port, and no
  // code can touch a port that was not claimed. The ACPI registers first,
  // wherever the firmware put them (src/acpi.bastio), clear of the others.
  let mut acpi = acpi_new(&mut ports, cpu);
  let acpi_lo = port_base(acpi.io);
  let acpi_hi = acpi_lo + port_count(acpi.io);
  let mut debug_exit = port_claim(&mut ports, DEBUG_EXIT, 1);
  let mut uart = Uart { io: port_claim(&mut ports, COM1, 8), present: true };
  let mut kbd = Kbd { data: port_claim(&mut ports, KBD_DATA, 1), status: port_claim(&mut ports, KBD_STATUS, 1),
    shift: false, ctrl: false, alt: false, ext: false, present: true, aux: false, aux_irq: false, wheel: false, mb: 0, mn: 0, pend: 0, kev: 0 };
  let mut pic = Pic { master: port_claim(&mut ports, PIC1, 2), slave: port_claim(&mut ports, PIC2, 2) };
  let mut pit = Pit { io: port_claim(&mut ports, PIT, 4) };
  let mut rtc = Rtc { io: port_claim(&mut ports, RTC, 2) };
  // Devices with memory-mapped registers claim them from the device window.
  // The HPET where the ACPI tables say it is (src/acpi.bastio).
  let mut hpet_at = acpi_hpet(cpu);
  let hpet_there = hpet_at != 0;
  if !hpet_there {
    hpet_at = HPET;
  }
  // A reset register in memory (src/acpi.bastio), if it is in the chipset
  // part of the window, where no PCI BAR goes, and clear of the HPET and
  // the local APIC; else an empty claim.
  let r = acpi.mreset;
  let mut reset_reg = mmio_claim(&mut win, WIN_LOW_TOP, 0);
  if WIN_LOW_TOP <= r && r < WIN_HIGH && !(hpet_at <= r && r < hpet_at + HPET_LEN) && !(LAPIC <= r && r < LAPIC + LAPIC_LEN) {
    mmio_release(&mut win, reset_reg);
    reset_reg = mmio_claim(&mut win, r, 1);
  }
  let mut clock = hpet_init(mmio_claim(&mut win, hpet_at, HPET_LEN), hpet_there);
  // No HPET and no PM timer (many recent PCs turn both off): the counter's
  // rate boot/smp.c measured against the PIT or the RTC.
  let mut tsc_hz = 0;
  if clock.period == 0 && acpi.tmr == ACPI_NONE {
    tsc_hz = boot_info(cpu, INFO_TIMER, 3);
  }
  let tsc = tsc_calibrate(cpu, &mut clock, &mut acpi, tsc_hz);
  let apic = lapic_new(mmio_claim(&mut win, LAPIC, LAPIC_LEN), boot_info(cpu, INFO_SMP, 3) == APIC_XAPIC);
  let mut msi = 0;
  if apic.on {
    msi = lapic_msi_addr(apic);
  }
  // The wall clock: the RTC's reading, less the time since boot it was
  // read at, so CLOCK_REALTIME = epoch + the clock (src/tsc.bastio).
  let wall = rtc_seconds(&mut rtc) * 1000000000;
  port_release(&mut ports, rtc.io);         // read once; the clock keeps time from here
  let at = tsc_now(tsc, 0, cpu);
  let mut epoch = 0;
  if wall > at {
    epoch = wall - at;
  }
  uart_init(&mut uart);
  kbd_init(&mut kbd);
  // The screen: the framebuffer the boot loader set up, if there is one
  // and it lies in the device window (src/fb.bastio): below the I/O APIC,
  // or above 4 GiB on a processor with 1 GiB pages.
  let fb_lo = boot_info(cpu, INFO_FB, 0);
  let fb_pitch = boot_info(cpu, INFO_FB, 1);
  let fb_h = boot_info(cpu, INFO_FB, 3);
  let fb_w = boot_info(cpu, INFO_FB, 2);
  let mut fb_hi = 0;
  if fb_lo < FB_HIGH_TOP && fb_pitch <= FB_MAX_PITCH && fb_h <= FB_MAX_SIDE {
    fb_hi = fb_lo + fb_pitch * fb_h;
  }
  let screen = screen_new(&mut win, fb_lo, fb_hi, fb_pitch, fb_w, fb_h, boot_info(cpu, INFO_FB, 4), high_window(cpu));
  let mut term = Term { uart: uart, screen: screen, kbd: kbd, usb: Usb::None };
  let mut con = con_new();
  pic_init(&mut pic);
  if term.kbd.aux_irq {
    pic_unmask(&mut pic, 12);               // the PS/2 mouse wakes an idle processor, so it need not be polled
  }
  pit_init(&mut pit, 100);
  let pool_pages = pool_size(pool);
  puts(&mut con, "\r\nBastiOS 0.2: ");
  put_num(&mut con, pool_pages);
  puts(&mut con, " pages of memory, ");
  let cpus = cpu_count(cpu);
  put_num(&mut con, cpus);
  if cpus == 1 {
    puts(&mut con, " processor\r\n");
  } else {
    puts(&mut con, " processors\r\n");
  }
  acpi_report(&mut con, acpi, clock.period > 0);
  // The allocator takes the pool for as long as the kernel runs and gives
  // it back at power off.
  if screen_on(term.screen) {
    puts(&mut con, "screen: ");
    put_num(&mut con, fb_w);
    puts(&mut con, "x");
    put_num(&mut con, fb_h);
    puts(&mut con, " framebuffer\r\n");
  }
  let mut m = mem_new(pool);
  // The pool spans every run of RAM (bastiolang's bst_pool_init, and
  // boot/multiboot.c's bst_map_ram): its last page is checked once.
  if !probe_top(&mut m) {
    puts(&mut con, "memory: the last page of RAM does not read back\r\n");
  }
  // PCI's configuration ports are claimed for the drivers that look for
  // their devices there.
  let mut pci = Pci { addr: port_claim(&mut ports, PCI_ADDR, 4), data: port_claim(&mut ports, PCI_DATA, 4) };
  // The xHCI controller first, the first of them with anything on it,
  // with pages from USB_AT: a USB stick with a BastiOS partition on it
  // becomes the disk, and a USB keyboard and mouse the keyboard and mouse.
  let xn = usb_count(&mut pci);
  // UHCI controllers are only looked at, to say in the boot log whether a
  // keyboard may be out of reach behind one (no driver yet).
  let uh = uhci_survey(&mut ports, &mut pci, acpi_lo, acpi_hi);
  let mut usb = usb_find(&mut pci, &mut m, &mut win, USB_AT, fb_lo, fb_hi, msi, V_DISK);
  let usb_lo = usb_base(usb);
  let usb_hi = usb_top(usb);
  let usb_disk = usb_msd(usb);
  let vm_where = boot_vmmio(cpu);
  // Entropy from the host, if it offers some (a virtio-rng): read and the
  // device given back before any other driver looks for its device. It
  // joins the generator's pool once the kernel exists.
  let mut hw = alloc(VRNG_WORDS);
  let hw_n = rng_hw(&mut ports, &mut pci, &mut m, &mut win, acpi_lo, acpi_hi, fb_lo, fb_hi, usb_lo, usb_hi, vm_where, &mut hw);
  if hw_n > 0 {
    puts(&mut con, "rng: virtio-rng, ");
    put_num(&mut con, hw_n * 8);
    puts(&mut con, " bytes of entropy\r\n");
  }
  // The disk: that stick, else NVMe, virtio, AHCI or ATA (see blk_new).
  let dev = blk_find(&mut ports, &mut pci, &mut m, &mut win, fb_lo, fb_hi, usb_lo, usb_hi, msi, &mut usb, acpi_lo, acpi_hi, boot_word(cpu, "ahci_reset"), vm_where);
  let dev_lo = blk_ports_lo(dev);
  let dev_hi = blk_ports_hi(dev);
  let dk_lo = blk_mmio_lo(dev);
  let dk_hi = blk_mmio_hi(dev);
  let disk = disk_mount(dev, dq_slots_for(pool_pages));
  if blk_is_virtio(disk.dev) {
    puts(&mut con, "disk: virtio\r\n");
  } else if blk_is_nvme(disk.dev) {
    puts(&mut con, "disk: NVMe\r\n");
  } else if blk_is_ahci(disk.dev) {
    puts(&mut con, "disk: AHCI\r\n");
  } else if blk_is_usb(disk.dev) {
    puts(&mut con, "disk: USB, the BastiOS partition (");
    put_num(&mut con, blk_sectors(disk.dev));
    puts(&mut con, " sectors)\r\n");
  }
  if usb_disk == MSD_UNUSED {
    puts(&mut con, "usb: a USB disk without a BastiOS partition; not used\r\n");
  }
  if disk.foreign {
    puts(&mut con, "disk: it holds a partition table or other data; left alone\r\n");
  }
  if blk_irq(disk.dev) {
    puts(&mut con, "disk: completions by message-signalled interrupt\r\n");
  }
  let usb_on = usb_live(usb) || blk_kbd(disk.dev);
  let usb_mouse_on = usb_mouse(usb) || blk_mouse(disk.dev);
  match term.usb {
    Usb::None => {},
    Usb::Xhci(stale) => { mmio_release(&mut win, xhci_free(stale, &mut m)); },
  }
  term.usb = usb;
  if uh % 16 > 0 {
    puts(&mut con, "usb: ");
    put_num(&mut con, uh % 16);
    puts(&mut con, " UHCI controller(s), ");
    put_num(&mut con, uh / 16 % 16);
    puts(&mut con, " device(s) on their ports (");
    put_num(&mut con, uh / 256);
    puts(&mut con, " low-speed); no driver for them yet\r\n");
  }
  if usb_on {
    puts(&mut con, "keyboard: USB (xHCI)\r\n");
  } else if xn > 0 {
    puts(&mut con, "usb: no keyboard on the xHCI controllers (");
    put_num(&mut con, xn);
    puts(&mut con, ")\r\n");
  }
  // The sound card, if any, with six pages from SND_AT.
  let snd = snd_find(&mut pci, &mut m, &mut win, SND_AT, fb_lo, fb_hi, usb_lo, usb_hi, dk_lo, dk_hi);
  let snd_l = snd_lo(snd);
  let snd_h = snd_hi(snd);
  if snd_live(snd) {
    puts(&mut con, "sound: HD Audio, ");
    put_num(&mut con, snd_outs(snd));
    if snd_outs(snd) == 1 {
      puts(&mut con, " output\r\n");
    } else {
      puts(&mut con, " outputs\r\n");
    }
  }
  // The network card, if any: nine pages after the disk's four (an e1000
  // takes six of them).
  let mut nic = nic_new(&mut ports, &mut pci, &mut m, &mut win, 4, dev_lo, dev_hi, acpi_lo, acpi_hi, fb_lo, fb_hi, usb_lo, usb_hi, dk_lo, dk_hi, snd_l, snd_h, msi, vm_where);
  // An e1000 has no MSI: its line goes through the 8259 (vectors 32-47,
  // acknowledged like the timer's), unless it shares the timer's, the
  // keyboard's, the cascade or COM1's.
  if nic_live(nic) && nic_e1000(nic) {
    let ed = nic_intx_dev(&mut pci);
    if ed < PCI_NONE {
      let line = pci_irq_line(&mut pci, ed);
      if line >= 3 && line < 16 && line != 4 {
        pic_unmask(&mut pic, line);
        nic_irq_on(&mut nic);
      }
    }
  }
  if nic_live(nic) {
    if nic_rtl(nic) {
      puts(&mut con, "net: rtl8168, mac ");
    } else if nic_e1000(nic) {
      puts(&mut con, "net: e1000, mac ");
    } else if nic_ena(nic) {
      puts(&mut con, "net: ena, mac ");
    } else {
      puts(&mut con, "net: virtio, mac ");
    }
    put_mac(&mut con, nic_mac(nic));
    puts(&mut con, ", address by DHCP\r\n");
    if nic_irq(nic) {
      puts(&mut con, "net: frames received by interrupt\r\n");
    }
  }
  // What is missing, on every boot: on a PC, the screen is all there is
  // to see why nothing can be typed or nothing is kept.
  if !usb_on && !term.kbd.present {
    puts(&mut con, "keyboard: none found (no USB keyboard, no PS/2 controller)\r\n");
  }
  if blk_sectors(disk.dev) == 0 {
    puts(&mut con, "disk: none found (NVMe, AHCI, ATA, virtio, USB); files are kept in memory only\r\n");
  }
  if nic_ena(nic) && !nic_live(nic) {
    puts(&mut con, "net: ena found but not started (reason ");
    put_num(&mut con, nic_why(nic));
    puts(&mut con, ", see docs/cloud.md)\r\n");
  } else if !nic_live(nic) {
    puts(&mut con, "net: none (drivers: virtio, e1000, rtl8168 and ena only)\r\n");
  }
  // The hardware report, with the boot option `diag` (src/info.bastio),
  // after a line for each thing the boot log above says nothing about.
  if boot_word(cpu, "diag") {
    if !screen_on(term.screen) {
      puts(&mut con, "screen: none (the serial line only)\r\n");
    }
    if !usb_on && term.kbd.present {
      puts(&mut con, "keyboard: PS/2 (no USB keyboard)\r\n");
    }
    if usb_mouse_on {
      puts(&mut con, "mouse: USB (xHCI)\r\n");
    } else if term.kbd.aux && term.kbd.wheel {
      puts(&mut con, "mouse: PS/2, with a wheel\r\n");
    } else if term.kbd.aux {
      puts(&mut con, "mouse: PS/2\r\n");
    } else {
      puts(&mut con, "mouse: none found\r\n");
    }
    if blk_sectors(disk.dev) != 0 && !blk_is_virtio(disk.dev) && !blk_is_nvme(disk.dev) && !blk_is_ahci(disk.dev) && !blk_is_usb(disk.dev) {
      puts(&mut con, "disk: ATA (");
      put_num(&mut con, blk_sectors(disk.dev));
      puts(&mut con, " sectors)\r\n");
    }
    if disk.blocks > 0 {
      puts(&mut con, "disk: the BastiOS file system, ");
      put_num(&mut con, disk.blocks);
      puts(&mut con, " blocks of 4 KiB\r\n");
    }
    puts(&mut con, "---- hardware report (boot option diag; see docs/real-hardware.md) ----\r\n");
    hw_cpu(&mut con, cpu);
    hw_smp(&mut con, cpu, clock.period > 0, acpi.tmr != ACPI_NONE);
    hw_screen(&mut con, cpu, screen_on(term.screen));
    diag_pause(&mut term, &mut con, &mut clock, &mut acpi);
    hw_mem(&mut con, cpu, pool_pages);
    diag_pause(&mut term, &mut con, &mut clock, &mut acpi);
    hw_acpi(&mut con, cpu, acpi);
    hw_pci(&mut con, &mut pci);
    puts(&mut con, "---- end of the hardware report ----\r\n");
    diag_pause(&mut term, &mut con, &mut clock, &mut acpi);
  }
  let mut k = kernel_new(m, disk, nic, snd, mice_new(term.kbd.aux || usb_mouse_on), tsc, at, epoch, cpus);
  if screen_on(term.screen) {
    gfx_screen(&mut k, fb_w, fb_h, fb_pitch, boot_info(cpu, INFO_FB, 4));   // /dev/fb0 (src/lxfb.bastio)
  }
  let mut hi = 0;
  while hi < hw_n
    invariant hi <= hw_n && hw_n <= VRNG_WORDS && len(hw) == VRNG_WORDS && kok(k)
  {
    rng_feed(&mut k, get(hw, hi));
    hi = hi + 1;
  }
  free(hw);
  let hr = rng_hw_boot(&mut k, cpu);
  if hr > 0 {
    puts(&mut con, "rng: the processor's RDSEED/RDRAND, ");
    put_num(&mut con, hr);
    puts(&mut con, " bytes of entropy\r\n");
  }
  install_files(&mut con, &mut k);
  let mut login = 0;
  if boot_word(cpu, "login") {
    login = spawn_as(&mut k, ASH_PROG, 0, "login");
    if login == 0 {
      puts(&mut con, "cannot start login\r\n");
    }
  } else if spawn(&mut k, 0, 0) == 0 {
    puts(&mut con, "cannot start the shell\r\n");
  }
  // With the boot option `mcloud`, first-boot setup from the instance
  // metadata service runs beside the console (user/mcloud.c, named
  // `mcloud-boot` so that it waits for the network).
  if boot_word(cpu, "mcloud") && spawn_as(&mut k, MCLOUD_PROG, 0, "mcloud-boot") == 0 {
    puts(&mut con, "cannot start mcloud\r\n");
  }
  // Every processor runs the scheduler until the kernel stops; then they
  // are all back in their park loops and the state is this one's again.
  con_flush(&mut term, &mut con);
  let sl = lock_new(Sys { k: k, con: con, pic: pic, apic: apic, clock: clock, acpi: acpi, stop: false, reboot: false, idle: 0, ticked: false, login: login, slept: 0, polled: usb_on || usb_mouse_on || (term.kbd.aux && !term.kbd.aux_irq) });
  let tl = lock_new(term);
  let pumping = atomic_new(false);
  let pend = atomic_new(0);
  let others = atomic_new(false);
  smp_run(sched, &mut cpu, &mut mmu, sl, tl, pumping, pend, others);
  let mut sys = lock_end(sl);
  let mut devices = lock_end(tl);
  atomic_end(pumping);
  atomic_end(pend);
  atomic_end(others);
  // Power off: tear down whatever is left, so every page goes back.
  kernel_drop_spaces(&mut sys.k, mmu);
  match sys.k.shm {
    Store::None => {},
    Store::Table(t) => { free_l2(&mut sys.k.mem, t); },
  }
  match sys.k.txt {
    Store::None => {},
    Store::Table(t) => { free_l2(&mut sys.k.mem, t); },
  }
  let devs = vfs_free(sys.k.fs, &mut sys.k.mem);
  blk_free(&mut ports, &mut win, devs.lo, &mut sys.k.mem);
  blk_free(&mut ports, &mut win, devs.disk, &mut sys.k.mem);
  nic_free(&mut ports, &mut win, sys.k.nic, &mut sys.k.mem);
  snd_free(&mut win, sys.k.snd, &mut sys.k.mem);
  usb_off(&mut devices.usb, &mut win, &mut sys.k.mem);
  puts(&mut sys.con, "BastiOS: ");
  put_num(&mut sys.con, count_free(sys.k.mem.bm));
  if sys.reboot {
    puts(&mut sys.con, " pages free at restart\r\n");
  } else {
    puts(&mut sys.con, " pages free at power off\r\n");
  }
  con_flush(&mut devices, &mut sys.con);
  con_free(sys.con);
  // (Stopped above, before the count: what is left here is no controller.)
  match devices.usb {
    Usb::None => {},
    Usb::Xhci(x) => { mmio_release(&mut win, xhci_free(x, &mut sys.k.mem)); },
  }
  vec_free(sys.k.spaces);
  vec_free(sys.k.fpus);
  free(sys.k.mem.bm);
  free(sys.k.procs);
  queue_free(sys.k.q);
  free(sys.k.line);
  free(sys.k.lxfd);
  free(sys.k.ofd);
  free(sys.k.pipes);
  while vec_len(sys.k.pipebuf) > 0 {
    match vec_pop(&mut sys.k.pipebuf) {
      PipeBuf::None => {},
      PipeBuf::Ring(b) => { bfree(b); },
    }
  }
  vec_free(sys.k.pipebuf);
  free(sys.k.sigact);
  free(sys.k.cwd);
  free(sys.k.croot);
  free(sys.k.dpath);
  free(sys.k.alarms);
  free(sys.k.maps);
  free(sys.k.holes);
  free(sys.k.lazy);
  free(sys.k.anon);
  free(sys.k.locks);
  free(sys.k.loops);
  free(sys.k.ptys);
  bfree(sys.k.ptyb);
  bfree(sys.k.mice);
  bfree(sys.k.gfx);
  free(sys.k.ipc);
  bfree(sys.k.ipcb);
  free(sys.k.sys);
  free(sys.k.inet6);
  free(sys.k.rng);
  free(sys.k.evt);
  free(sys.k.sigsave);
  free(sys.k.ux);
  bfree(sys.k.uxb);
  free(sys.k.mns);
  free(sys.k.scf);
  bfree(sys.k.mstr);
  pool = sys.k.mem.pool;
  // Off, or a restart. QEMU's isa-debug-exit device (tests) exits at once,
  // with status 33; elsewhere the port is unused.
  if sys.reboot {
    acpi_reset(&mut sys.acpi, &mut pci, &mut devices.kbd.status, &mut reset_reg);
  } else {
    pio_out8(&mut debug_exit, 0, 0x10);
    acpi_off(&mut sys.acpi);
  }
  port_release(&mut ports, debug_exit);
  port_release(&mut ports, sys.acpi.io);
  port_release(&mut ports, devices.uart.io);
  port_release(&mut ports, devices.kbd.data);
  port_release(&mut ports, devices.kbd.status);
  port_release(&mut ports, sys.pic.master);
  port_release(&mut ports, sys.pic.slave);
  port_release(&mut ports, pit.io);
  pci_free(&mut ports, pci);
  screen_free(&mut win, devices.screen);
  mmio_release(&mut win, sys.clock.regs);
  mmio_release(&mut win, sys.apic.regs);
  mmio_release(&mut win, reset_reg);
  return 0;
}
