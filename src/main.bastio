// BastiOS kernel: boots, starts the shell as the first user process, and
// schedules processes round robin, preempting them on the timer.
//
// The kernel never touches memory through an address. Physical pages, page
// tables, CR3 and the CPU's user context are linear capabilities, and the
// Bastio prover checks every use of them before this file is compiled: a
// page is owned by exactly one table or by the allocator, a table is empty
// before it is freed, the address space in CR3 is never freed, and every
// buffer index and arithmetic step is in range.

const V_TIMER: u64 = 32;
const V_SYSCALL: u64 = 128;

fn fault_name(con: &Serial, v: u64) {
  if v == 0 {
    puts(con, "divide error");
  } else if v == 6 {
    puts(con, "invalid opcode");
  } else if v == 13 {
    puts(con, "general protection fault");
  } else if v == 14 {
    puts(con, "page fault");
  } else {
    puts(con, "exception");
  }
}

/// Runs process `pid` until the next trap and returns its vector (256 if
/// the process has no address space). Its registers are loaded from and
/// saved back to its row.
fn run(mmu: &mut Mmu, cpu: &mut Cpu, dir: &mut PageTable, procs: &mut Buf, pid: u64) -> u64
  requires pt_level(dir) == 5 && len(procs) == PTAB_LEN && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures pt_level(dir) == 5 && len(procs) == PTAB_LEN && mmu_root(mmu) == KERNEL_ROOT
{
  if !pt_has(dir, pid) {
    return 256;
  }
  let mut r = 0;
  while r < 18
    invariant r <= 18
  {
    cpu_set(&mut cpu, r, pget(procs, pid, F_REGS + r));
    r = r + 1;
  }
  let root = pt_take(&mut dir, pid);
  mmu_switch(&mut mmu, root);
  let v = cpu_run(&mut cpu, mmu);
  mmu_kernel(&mut mmu);
  pt_put(&mut dir, pid, root);
  // Registers, then the error code and fault address (words 18 and 19).
  r = 0;
  while r < 20
    invariant r <= 20 && len(procs) == PTAB_LEN
  {
    pset(&mut procs, pid, F_REGS + r, cpu_get(cpu, r));
    r = r + 1;
  }
  return v;
}

fn tick(t: u64) -> u64 {
  if t < 18446744073709551615 {
    return t + 1;
  }
  return t;
}

fn main(con: &mut Serial, pool: &mut Pool, mmu: &mut Mmu, cpu: &mut Cpu) -> u64 {
  puts(con, "\r\nBastiOS 0.2: ");
  put_num(con, pool_size(pool));
  puts(con, " pages of memory\r\n");
  // The allocator takes the pool for as long as the kernel runs and gives
  // it back at power off.
  let mut m = mem_new(pool);
  let a = find_free(m.bm);
  if a >= NPAGES {
    puts(con, "no memory\r\n");
    free(m.bm);
    pool = m.pool;
    return 1;
  }
  let dir = pt_new(take_page(&mut m, a), 5);
  let mut k = Kernel { mem: m, dir: dir, procs: alloc(PTAB_LEN), q: alloc(INQ_LEN), ticks: 0 };
  if spawn(&mut k, 0, 0) == 0 {
    puts(con, "cannot start the shell\r\n");
  }
  let mut cur = 1;
  let mut running = true;
  while running
    invariant kok(k) && mmu_root(mmu) == KERNEL_ROOT && cur < NPROC
  {
    drain(con, &mut k.q);
    wake_readers(&mut k.procs, &mut k.q);
    let p = pick(k.procs, cur);
    if p == 0 {
      if live_count(k.procs) == 0 {
        running = false;
      } else if cpu_idle(&mut cpu) == V_TIMER {
        k.ticks = tick(k.ticks);
      }
    } else {
      let v = run(&mut mmu, &mut cpu, &mut k.dir, &mut k.procs, p);
      cur = p;
      if v == V_TIMER {
        k.ticks = tick(k.ticks);
        pset(&mut k.procs, p, F_TICKS, tick(pget(k.procs, p, F_TICKS)));
        cur = (p + 1) % NPROC;
      } else if v == V_SYSCALL {
        let r = syscall(con, &mut k, mmu, p);
        if r == SWITCH {
          cur = (p + 1) % NPROC;
        } else if r == POWEROFF {
          running = false;
        }
      } else if v < 32 {
        puts(con, "\r\n[pid ");
        put_num(con, p);
        puts(con, " (");
        puts(con, prog_name(pget(k.procs, p, F_PROG)));
        puts(con, "): ");
        fault_name(con, v);
        puts(con, " at rip ");
        put_hex(con, pget(k.procs, p, F_REGS + R_RIP));
        if v == 14 {
          puts(con, ", address ");
          put_hex(con, pget(k.procs, p, F_REGS + 19));
        }
        puts(con, "; killed]\r\n");
        terminate(&mut k, mmu, p, 128 + v);
        cur = (p + 1) % NPROC;
      }
    }
  }
  // Power off: tear down whatever is left, so every page goes back.
  let mut i = 0;
  while i < 512
    invariant i <= 512 && mem_ok(k.mem) && pt_level(k.dir) == 5 && mmu_root(mmu) == KERNEL_ROOT
    invariant forall j: u64 :: j < i ==> !pt_used(k.dir, j)
  {
    if pt_has(k.dir, i) {
      free_space(&mut k.mem, mmu, pt_take(&mut k.dir, i));
    }
    i = i + 1;
  }
  give_page(&mut k.mem, pt_free(k.dir));
  puts(con, "BastiOS: ");
  put_num(con, count_free(k.mem.bm));
  puts(con, " pages free at power off\r\n");
  free(k.mem.bm);
  free(k.procs);
  free(k.q);
  pool = k.mem.pool;
  return 0;
}
