// Linux file descriptors. Each process has LXNFD descriptors; each names
// the console or an open file description (the `ofd` table), which dup,
// dup2 and fork share and which counts its references. A description is a
// file (a native row of the file layer), one end of a pipe, a directory
// being listed, or a UDP socket (src/lxsock.bastio).
//
// k.lxfd, word pid * LXNFD + fd: 0 closed, FD_CONSOLE, or FD_OFD + h for
// description h; plus FD_CLOEXEC if execve closes it.
// k.ofd, words h * OFD_STRIDE: kind, references, row, pipe or directory,
// and a directory's next entry (for a pipe end: 1 if it is nonblocking);
// then the F_SETOWN owner, F_SETSIG signal, the owner's setter's ids and
// O_ASYNC (src/lxowner.bastio), then the access the open did not ask for
// (OF_ACC: a device's description keeps no mode of its own otherwise).
// k.pipes, words p * PIPE_STRIDE: head, count, the descriptions of its
// read end and of its write end, the FIFO it belongs to + 1 (0 for an
// anonymous pipe; src/lxevent.bastio), 1 once a writer has opened it,
// the size F_SETPIPE_SZ gave it (0: PIPE_CAP), and 1 once a read end
// has had O_ASYNC; the ring itself is
// slot p of k.pipebuf: PIPE_PAGE bytes at first, doubling up to PIPE_CAP
// as the pipe fills (pipe_ready, pipe_grow), a position's byte at that
// position modulo the ring's length.

import "linux.bastio";
import "lxdev.bastio";

struct Fd { kind: u64, x: u64 }

spec fn fds_ok(k: &Kernel) -> bool {
  len(k.lxfd) <= LXFD_LEN && len(k.ofd) == OFD_LEN && len(k.pipes) == PIPES_LEN
}

fn fd_get(t: &Buf, pid: u64, fd: u64) -> u64
  requires len(t) <= LXFD_LEN && pid < NPROC
  ensures fd >= LXNFD ==> result == 0
{
  if fd >= LXNFD || pid * LXNFD + fd >= len(t) {   // a process past the table's end has none open
    return 0;
  }
  return get(t, pid * LXNFD + fd);
}

fn fd_set(t: &mut Buf, pid: u64, fd: u64, v: u64)
  requires len(t) <= LXFD_LEN && pid < NPROC && fd < LXNFD
  ensures len(t) == old(len(t))
{
  if pid * LXNFD + fd < len(t) {             // live processes have their rows (new_pid)
    t = set(t, pid * LXNFD + fd, v);
  }
}

/// fd_set in the kernel's table, noting the highest descriptor ever open:
/// every non-zero word of k.lxfd is below fd_hi, so loops over a row stop there.
fn fd_set_k(k: &mut Kernel, pid: u64, fd: u64, v: u64)
  requires kok(k) && pid < NPROC && fd < LXNFD
  ensures kok(k)
{
  if v != 0 && fd >= k.fd_hi {
    k.fd_hi = fd + 1;
  }
  fd_set(&mut k.lxfd, pid, fd, v);
}

// ---------------------------------------------------------------- shared tables
//
// Processes that share one descriptor table (the threads of a group, and
// clone with CLONE_FILES) are a ring through F_FDNEXT. The table is linear,
// so it is in one member's row, the one with F_FDHOLD set, and moves to the
// member whose call is being handled (fd_take, from group_take) before the
// call runs; the other members' rows are empty meanwhile. A member that ends,
// or unshares, leaves the ring (fd_leave); the last one to end closes the
// descriptors.

/// Swaps the descriptor rows of a and b. Every non-zero word of a row is
/// below fd_hi.
fn fd_swap(k: &mut Kernel, a: u64, b: u64)
  requires kok(k) && a < NPROC && b < NPROC
  ensures kok(k)
{
  if a == b || (a + 1) * LXNFD > len(k.lxfd) || (b + 1) * LXNFD > len(k.lxfd) {
    return;                                 // a process past the table's end has none
  }
  let hi = smaller(k.fd_hi, LXNFD);
  let mut i = 0;
  while i < hi
    invariant i <= hi && hi <= LXNFD && kok(k) && (a + 1) * LXNFD <= len(k.lxfd) && (b + 1) * LXNFD <= len(k.lxfd)
  {
    let x = fd_get(k.lxfd, a, i);
    fd_set(&mut k.lxfd, a, i, fd_get(k.lxfd, b, i));
    fd_set(&mut k.lxfd, b, i, x);
    i = i + 1;
  }
}

/// The member after p in its ring, or 0 if p has a table of its own.
fn fd_next(procs: &Buf, p: u64) -> u64
  requires ptab_ok(procs) && p < NPROC
  ensures result < NPROC
{
  let n = pget(procs, p, F_FDNEXT);
  if n >= NPROC {
    return 0;
  }
  return n;
}

/// The row that holds p's descriptors: p, or the member of its ring that
/// holds them now.
fn fd_home(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result < NPROC
{
  if fd_next(k.procs, p) == 0 || pget(k.procs, p, F_FDHOLD) == 1 {
    return p;
  }
  let mut q = fd_next(k.procs, p);
  let mut n = 0;
  while q != 0 && q != p && n < NPROC
    invariant n <= NPROC && q < NPROC
  {
    if pget(k.procs, q, F_FDHOLD) == 1 {
      return q;
    }
    q = fd_next(k.procs, q);
    n = n + 1;
  }
  return p;
}

/// Brings the shared descriptors to p's row.
fn fd_take(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let h = fd_home(k, p);
  if h != p {
    fd_swap(&mut k, h, p);
    pset(&mut k.procs, h, F_FDHOLD, 0);
    pset(&mut k.procs, p, F_FDHOLD, 1);
  }
}

/// Process c, which has an empty row of its own, shares p's descriptors.
fn fd_join(k: &mut Kernel, p: u64, c: u64)
  requires kok(k) && p < NPROC && c < NPROC
  ensures kok(k)
{
  if p == c {
    return;
  }
  fd_take(&mut k, p);
  let n = fd_next(k.procs, p);
  pset(&mut k.procs, c, F_FDHOLD, 0);
  if n == 0 {
    pset(&mut k.procs, p, F_FDHOLD, 1);
    pset(&mut k.procs, p, F_FDNEXT, c);
    pset(&mut k.procs, c, F_FDNEXT, p);
  } else {
    pset(&mut k.procs, c, F_FDNEXT, n);
    pset(&mut k.procs, p, F_FDNEXT, c);
  }
}

/// Process p stops sharing: the descriptors stay with the rest of its ring,
/// and p's row is left empty.
fn fd_leave(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let n = fd_next(k.procs, p);
  if n == 0 {
    return;
  }
  if pget(k.procs, p, F_FDHOLD) == 1 {
    fd_swap(&mut k, p, n);
    pset(&mut k.procs, n, F_FDHOLD, 1);
  }
  // The member before p now skips it.
  let mut q = n;
  let mut i = 0;
  while q != 0 && fd_next(k.procs, q) != p && i < NPROC
    invariant i <= NPROC && q < NPROC && kok(k)
  {
    q = fd_next(k.procs, q);
    i = i + 1;
  }
  if q != 0 && fd_next(k.procs, q) == p {
    if q == n {
      // Only n is left: its table is its own again.
      pset(&mut k.procs, n, F_FDNEXT, 0);
      pset(&mut k.procs, n, F_FDHOLD, 0);
    } else {
      pset(&mut k.procs, q, F_FDNEXT, n);
    }
  }
  pset(&mut k.procs, p, F_FDNEXT, 0);
  pset(&mut k.procs, p, F_FDHOLD, 0);
}

// ---------------------------------------------------------------- shared working directory
//
// The same ring for clone with CLONE_FS between processes (not threads,
// which share theirs through group_move): the working directory, root and
// umask are in the row of the member whose call is being handled.

/// Swaps the working directory, root and umask of a and b.
fn fs_swap(k: &mut Kernel, a: u64, b: u64)
  requires kok(k) && a < NPROC && b < NPROC
  ensures kok(k)
{
  if a == b || (a + 1) * CWD_STRIDE > len(k.cwd) || (b + 1) * CWD_STRIDE > len(k.cwd)
     || (a + 1) * CWD_STRIDE > len(k.croot) || (b + 1) * CWD_STRIDE > len(k.croot) {
    return;
  }
  let mut i = 0;
  while i < CWD_STRIDE
    invariant i <= CWD_STRIDE && kok(k) && (a + 1) * CWD_STRIDE <= len(k.cwd) && (b + 1) * CWD_STRIDE <= len(k.cwd) && (a + 1) * CWD_STRIDE <= len(k.croot) && (b + 1) * CWD_STRIDE <= len(k.croot)
  {
    let x = wget(k.cwd, a * CWD_STRIDE + i);
    wset(&mut k.cwd, a * CWD_STRIDE + i, wget(k.cwd, b * CWD_STRIDE + i));
    wset(&mut k.cwd, b * CWD_STRIDE + i, x);
    let y = wget(k.croot, a * CWD_STRIDE + i);
    wset(&mut k.croot, a * CWD_STRIDE + i, wget(k.croot, b * CWD_STRIDE + i));
    wset(&mut k.croot, b * CWD_STRIDE + i, y);
    i = i + 1;
  }
  let u = pget(k.procs, a, F_UMASK);
  pset(&mut k.procs, a, F_UMASK, pget(k.procs, b, F_UMASK));
  pset(&mut k.procs, b, F_UMASK, u);
}

/// The member after p in its working-directory ring, or 0 if p has its own.
fn fs_next(procs: &Buf, p: u64) -> u64
  requires ptab_ok(procs) && p < NPROC
  ensures result < NPROC
{
  let n = pget(procs, p, F_FSNEXT);
  if n >= NPROC {
    return 0;
  }
  return n;
}

/// The row that holds p's working directory, root and umask.
fn fs_home(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result < NPROC
{
  if fs_next(k.procs, p) == 0 || pget(k.procs, p, F_FSHOLD) == 1 {
    return p;
  }
  let mut q = fs_next(k.procs, p);
  let mut n = 0;
  while q != 0 && q != p && n < NPROC
    invariant n <= NPROC && q < NPROC
  {
    if pget(k.procs, q, F_FSHOLD) == 1 {
      return q;
    }
    q = fs_next(k.procs, q);
    n = n + 1;
  }
  return p;
}

/// Brings the shared working directory to p's row.
fn fs_take(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let h = fs_home(k, p);
  if h != p {
    fs_swap(&mut k, h, p);
    pset(&mut k.procs, h, F_FSHOLD, 0);
    pset(&mut k.procs, p, F_FSHOLD, 1);
  }
}

/// Process c shares p's working directory, root and umask.
fn fs_join(k: &mut Kernel, p: u64, c: u64)
  requires kok(k) && p < NPROC && c < NPROC
  ensures kok(k)
{
  if p == c {
    return;
  }
  fs_take(&mut k, p);
  let n = fs_next(k.procs, p);
  pset(&mut k.procs, c, F_FSHOLD, 0);
  if n == 0 {
    pset(&mut k.procs, p, F_FSHOLD, 1);
    pset(&mut k.procs, p, F_FSNEXT, c);
    pset(&mut k.procs, c, F_FSNEXT, p);
  } else {
    pset(&mut k.procs, c, F_FSNEXT, n);
    pset(&mut k.procs, p, F_FSNEXT, c);
  }
}

/// Process p stops sharing: they stay with the rest of its ring.
fn fs_leave(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let n = fs_next(k.procs, p);
  if n == 0 {
    return;
  }
  if pget(k.procs, p, F_FSHOLD) == 1 {
    fs_swap(&mut k, p, n);
    pset(&mut k.procs, n, F_FSHOLD, 1);
  }
  // The member before p now skips it.
  let mut q = n;
  let mut i = 0;
  while q != 0 && fs_next(k.procs, q) != p && i < NPROC
    invariant i <= NPROC && q < NPROC && kok(k)
  {
    q = fs_next(k.procs, q);
    i = i + 1;
  }
  if q != 0 && fs_next(k.procs, q) == p {
    if q == n {
      // Only n is left: its table is its own again.
      pset(&mut k.procs, n, F_FSNEXT, 0);
      pset(&mut k.procs, n, F_FSHOLD, 0);
    } else {
      pset(&mut k.procs, q, F_FSNEXT, n);
    }
  }
  pset(&mut k.procs, p, F_FSNEXT, 0);
  pset(&mut k.procs, p, F_FSHOLD, 0);
}

fn of_get(t: &Buf, h: u64, f: u64) -> u64
  requires len(t) == OFD_LEN && h < OFD_N && f < OFD_STRIDE
{
  return get(t, h * OFD_STRIDE + f);
}

fn of_set(t: &mut Buf, h: u64, f: u64, v: u64)
  requires len(t) == OFD_LEN && h < OFD_N && f < OFD_STRIDE
  ensures len(t) == OFD_LEN
{
  t = set(t, h * OFD_STRIDE + f, v);
}

fn pi_get(t: &Buf, p: u64, f: u64) -> u64
  requires len(t) == PIPES_LEN && p < NPIPES && f < PIPE_STRIDE
{
  return get(t, p * PIPE_STRIDE + f);
}

fn pi_set(t: &mut Buf, p: u64, f: u64, v: u64)
  requires len(t) == PIPES_LEN && p < NPIPES && f < PIPE_STRIDE
  ensures len(t) == PIPES_LEN
{
  t = set(t, p * PIPE_STRIDE + f, v);
}

/// Pipe p's head and count as a core Ring over its PIPE_CAP bytes in
/// k.pipebuf. The stored words are clamped, so the ring is well formed
/// whatever they hold.
fn pipe_ring(t: &Buf, p: u64) -> Ring
  requires len(t) == PIPES_LEN && p < NPIPES
  ensures ring_ok(result) && result.cap == PIPE_CAP
{
  return Ring { h: pi_get(t, p, 0) % PIPE_CAP, n: smaller(pi_get(t, p, 1), PIPE_CAP), cap: PIPE_CAP };
}

/// Stores ring r back as pipe p's head and count.
fn pipe_keep(t: &mut Buf, p: u64, r: &Ring)
  requires len(t) == PIPES_LEN && p < NPIPES
  ensures len(t) == PIPES_LEN
{
  pi_set(&mut t, p, 0, r.h);
  pi_set(&mut t, p, 1, r.n);
}

/// How many bytes pipe p may hold: PIPE_CAP unless F_SETPIPE_SZ made it
/// smaller (word 6; 0 means PIPE_CAP). Its ring is PIPE_CAP bytes still.
fn pipe_cap(t: &Buf, p: u64) -> u64
  requires len(t) == PIPES_LEN && p < NPIPES
  ensures PIPE_PAGE <= result && result <= PIPE_CAP
{
  let c = pi_get(t, p, 6);
  if c >= PIPE_PAGE && c <= PIPE_CAP {
    return c;
  }
  return PIPE_CAP;
}

/// Room for more bytes in pipe p, which holds `count`.
fn pipe_room(t: &Buf, p: u64, count: u64) -> u64
  requires len(t) == PIPES_LEN && p < NPIPES && count <= PIPE_CAP
  ensures result <= PIPE_CAP - count
{
  let c = pipe_cap(t, p);
  if count >= c {
    return 0;
  }
  return c - count;
}

/// /proc/sys/fs/pipe-max-size: the most a process without
/// CAP_SYS_RESOURCE may give a pipe with F_SETPIPE_SZ, and what its new
/// pipes get if that is less than PIPE_CAP.
fn pipe_max(k: &Kernel) -> u64
  requires kok(k)
  ensures PIPE_PAGE <= result
{
  let v = get(k.sys, SYS_PIPEMAX);
  if v < PIPE_PAGE {
    return PIPE_CAP;                        // never written
  }
  return v;
}

/// Word 6 for a pipe process pid makes: 0 (PIPE_CAP), or less if
/// pipe-max-size is below PIPE_CAP and pid lacks CAP_SYS_RESOURCE, as on
/// Linux (alloc_pipe_info).
fn pipe_birth_cap(k: &Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
{
  let m = pipe_max(k);
  if m < PIPE_CAP && !cap_has(k, pid, CAP_SYS_RESOURCE) {
    return m;
  }
  return 0;
}

/// F_GETPIPE_SZ and F_SETPIPE_SZ on pipe p. A new size is rounded up to
/// a power of two pages; it may not drop below what the pipe holds
/// (EBUSY) or rise past PIPE_CAP, /proc/sys/fs/pipe-max-size (EPERM, or
/// ENOMEM with CAP_SYS_RESOURCE, which Linux would let go further).
fn pipe_size(k: &mut Kernel, pid: u64, p: u64, set: bool, arg: u64) -> u64
  requires kok(k) && pid < NPROC && p < NPIPES
  ensures kok(k)
{
  if !set {
    return pipe_cap(k.pipes, p);
  }
  let want = arg % 0x100000000;
  if want > 0x80000000 {
    return EINVAL;                          // past the largest size Linux rounds to
  }
  if want > PIPE_CAP {
    if cap_has(k, pid, CAP_SYS_RESOURCE) {
      return ENOMEM;
    }
    return EPERM;
  }
  let mut size = PIPE_PAGE;
  while size < want && size < PIPE_CAP
    invariant PIPE_PAGE <= size && size <= PIPE_CAP
  {
    if size >= PIPE_CAP / 2 {
      size = PIPE_CAP;
    } else {
      size = size * 2;
    }
  }
  if size > pipe_max(k) && !cap_has(k, pid, CAP_SYS_RESOURCE) {
    return EPERM;
  }
  if pi_get(k.pipes, p, 1) > size {
    return EBUSY;
  }
  pi_set(&mut k.pipes, p, 6, size);
  return size;
}

/// What Linux descriptor `fd` of process `pid` refers to.
fn fd_look(k: &Kernel, pid: u64, fd: u64) -> Fd
  requires fds_ok(k) && pid < NPROC
  ensures result.kind == K_FILE ==> result.x < FD_ROWS
  ensures (result.kind == K_PIPE_R || result.kind == K_PIPE_W) ==> result.x < NPIPES
  ensures result.kind == K_EVENT ==> result.x < OFD_N
  ensures result.kind == K_TIMER ==> result.x < TFD_N
  ensures result.kind == K_EPOLL ==> result.x < EP_N
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  if v == FD_CONSOLE {
    return Fd { kind: K_CONSOLE, x: 0 };
  }
  if v < FD_OFD || v - FD_OFD >= OFD_N {
    return Fd { kind: K_BAD, x: 0 };
  }
  let h = v - FD_OFD;
  let kind = of_get(k.ofd, h, 0);
  let x = of_get(k.ofd, h, 2);
  if kind == OF_FILE && x < FD_ROWS {
    return Fd { kind: K_FILE, x: x };
  }
  if kind == OF_PIPE_R && x < NPIPES {
    return Fd { kind: K_PIPE_R, x: x };
  }
  if kind == OF_PIPE_W && x < NPIPES {
    return Fd { kind: K_PIPE_W, x: x };
  }
  if kind == OF_DIR {
    return Fd { kind: K_DIR, x: x };
  }
  if kind == OF_SOCK || kind == OF_TCP || kind == OF_UNIX || kind == OF_NETLINK {
    return Fd { kind: K_SOCK, x: x };
  }
  if kind == OF_DEV || kind == OF_PTY {
    return Fd { kind: K_DEV, x: x };        // a pty end is a device too (src/lxpty.bastio)
  }
  if kind == OF_EVENT {
    return Fd { kind: K_EVENT, x: h };      // the counter lives in the description
  }
  if kind == OF_TIMER && x < TFD_N {
    return Fd { kind: K_TIMER, x: x };
  }
  if kind == OF_SIGFD {
    return Fd { kind: K_SIGFD, x: h };      // the mask lives in the description
  }
  if kind == OF_EPOLL && x < EP_N {
    return Fd { kind: K_EPOLL, x: x };
  }
  if kind == OF_PIDFD {
    return Fd { kind: K_PIDFD, x: smaller(x, NPROC) };
  }
  if kind == OF_INOTIFY && x < INO_N {
    return Fd { kind: K_INOTIFY, x: x };
  }
  if kind == OF_SECCOMP && x < SC_N {
    return Fd { kind: K_SECCOMP, x: x };
  }
  return Fd { kind: K_BAD, x: 0 };
}

/// The open file description descriptor `fd` of process `pid` names, or
/// OFD_N if it names none (closed, or the console).
fn fd_ofd(k: &Kernel, pid: u64, fd: u64) -> u64
  requires fds_ok(k) && pid < NPROC
  ensures result <= OFD_N
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  if v < FD_OFD || v - FD_OFD >= OFD_N {
    return OFD_N;
  }
  return v - FD_OFD;
}

/// Whether descriptor `fd` of process `pid` is a named pipe opened O_RDWR:
/// a read end (OF_PIPE_R) that also counts as a writer, word 3 bit 1.
fn pipe_both(k: &Kernel, pid: u64, fd: u64) -> bool
  requires fds_ok(k) && pid < NPROC
{
  let h = fd_ofd(k, pid, fd);
  return h < OFD_N && of_get(k.ofd, h, 0) == OF_PIPE_R && of_get(k.ofd, h, 3) / PIPE_BOTH % 2 == 1;
}

/// Whether descriptor `fd` of process `pid` is a pipe end, eventfd, timerfd
/// or epoll instance with O_NONBLOCK: a read or write that would wait
/// fails with -EAGAIN instead.
fn pipe_nonblock(k: &Kernel, pid: u64, fd: u64) -> bool
  requires fds_ok(k) && pid < NPROC
{
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N {
    return false;
  }
  return can_block(of_get(k.ofd, h, 0)) && of_get(k.ofd, h, 3) % 2 == 1;
}

/// Whether descriptions of this kind keep O_NONBLOCK in the low bit of
/// word 3 (sockets too: src/lxsock.bastio, src/lxtcp.bastio,
/// src/lxunix.bastio).
fn can_block(kind: u64) -> bool {
  return kind == OF_PIPE_R || kind == OF_PIPE_W || kind == OF_EVENT || kind == OF_TIMER || kind == OF_EPOLL || kind == OF_SIGFD || kind == OF_PTY
    || kind == OF_SOCK || kind == OF_TCP || kind == OF_UNIX || kind == OF_PIDFD || kind == OF_INOTIFY || kind == OF_NETLINK || kind == OF_SECCOMP;
}

/// Whether the pool has a file layer row free: an open file holds one.
fn row_free(k: &Kernel, pid: u64) -> bool
  requires kok(k) && pid < NPROC
{
  if FD_POOL * FD_STRIDE > len(k.fs.ftab) {
    return false;
  }
  let mut i = 0;
  while i < FD_POOL
    invariant i <= FD_POOL
  {
    if fget(k.fs.ftab, i, FD_FS) == 0 {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Process `pid`'s descriptors as a new program starts: 0 to 2 on the
/// console, the rest closed (only those below `hi`, the kernel's fd_hi, can be open). They must hold no references.
fn lx_fd_reset(t: &mut Buf, pid: u64, hi: u64)
  requires len(t) <= LXFD_LEN && pid < NPROC && hi <= LXNFD
  ensures len(t) == old(len(t))
{
  let n = len(t);
  let mut fd = 0;
  while fd < hi || fd < 3
    invariant fd <= LXNFD && len(t) == n && n <= LXFD_LEN
  {
    if fd < 3 {
      fd_set(&mut t, pid, fd, FD_CONSOLE);
    } else {
      fd_set(&mut t, pid, fd, 0);
    }
    fd = fd + 1;
  }
}

/// Adds a reference to whatever descriptor value v names.
fn ref_value(k: &mut Kernel, v: u64)
  requires kok(k)
  ensures kok(k)
{
  let t = v % FD_CLOEXEC;
  // There are only LXFD_LEN descriptors to hold references.
  if t >= FD_OFD && t - FD_OFD < OFD_N {
    let r = of_get(k.ofd, t - FD_OFD, 1);
    if r < LXFD_LEN {
      of_set(&mut k.ofd, t - FD_OFD, 1, r + 1);
    }
  }
}

/// Drops the reference descriptor value v holds; the last one closes the
/// file or the pipe end. Closing a unix socket can drop a description in
/// flight to it in turn, and that one another: at most OFD_N in all, as
/// each drop frees a description.
fn unref_value(k: &mut Kernel, v: u64)
  requires kok(k)
  ensures kok(k)
{
  let mut next = v;
  let mut i = 0;
  while next != 0 && i < OFD_N
    invariant i <= OFD_N && kok(k)
  {
    next = unref_one(&mut k, next);
    i = i + 1;
    if next == 0 {
      next = ux_reap(&mut k);               // in flight to a channel just closed
    }
  }
}

/// unref_value for one description; returns the descriptor value of a
/// description its closing let go of (see ux_close), or 0.
fn unref_one(k: &mut Kernel, v: u64) -> u64
  requires kok(k)
  ensures kok(k)
{
  let t = v % FD_CLOEXEC;
  if t < FD_OFD || t - FD_OFD >= OFD_N {
    return 0;
  }
  let h = t - FD_OFD;
  let refs = of_get(k.ofd, h, 1);
  if refs > 1 {
    of_set(&mut k.ofd, h, 1, refs - 1);
    return 0;
  }
  let kind = of_get(k.ofd, h, 0);
  let x = of_get(k.ofd, h, 2);
  let w = of_get(k.ofd, h, 3);
  lock_drop(&mut k.locks, LK_DESC + h, LK_EOF, 2);   // its OFD locks and flocks
  of_set(&mut k.ofd, h, 0, OF_FREE);
  of_set(&mut k.ofd, h, 1, 0);
  if kind == OF_FILE && x < FD_ROWS {
    ino_closed(&mut k, x, false);           // src/lxinotify.bastio
    vfs_close(&mut k.fs, &mut k.mem, x);
  } else if kind == OF_DIR {
    ino_closed(&mut k, x, true);
  } else if kind == OF_INOTIFY && x < INO_N {
    ino_free(&mut k, x);
  } else if kind == OF_SECCOMP && x < SC_N {
    sc_listener_closed(&mut k, x);          // src/lxseccomp.bastio
  } else if kind == OF_DEV && x == DEV_FB {
    fb_closed(&mut k);                      // src/lxfb.bastio: the console is drawn again after the last one
  } else if kind == OF_BPF && x < DVP_N {
    bpf_release(&mut k, x, w);              // src/lxbpf.bastio
  } else if kind == OF_PIPE_R && x < NPIPES {
    let left = pi_get(k.pipes, x, 2);
    if left > 0 {
      pi_set(&mut k.pipes, x, 2, left - 1);   // one description fewer on this end
    }
    let wl = pi_get(k.pipes, x, 3);
    if w / PIPE_BOTH % 2 == 1 && wl > 0 {
      pi_set(&mut k.pipes, x, 3, wl - 1);     // it was a writer too (a FIFO opened O_RDWR)
    }
    pipe_release(&mut k, x);
  } else if kind == OF_PIPE_W && x < NPIPES {
    let left = pi_get(k.pipes, x, 3);
    if left > 0 {
      pi_set(&mut k.pipes, x, 3, left - 1);   // one description fewer on this end
    }
    pipe_release(&mut k, x);
  } else if kind == OF_SOCK {
    sock_close(&mut k.nic, x);
  } else if kind == OF_NETLINK {
    nic_nl_close(&mut k.nic, x);           // src/rtnl.bastio
  } else if kind == OF_TCP && x < TCBS {
    tcp_close(&mut k.nic, x);               // sends the FIN after what is buffered
  } else if kind == OF_TIMER && x < TFD_N {
    k.evt = set(k.evt, x * TFD_STRIDE, 0);  // the timer is free again
  } else if kind == OF_EPOLL && x < EP_N {
    k.evt = set(k.evt, EP_AT + x * EP_STRIDE, 0);
  } else if kind == OF_PTY {
    pty_drop(&mut k, x);                    // src/lxpty.bastio
  } else if kind == OF_PQ && x < PQ_N {
    pq_close(&mut k, x);                    // src/lxmq.bastio
  } else if kind == OF_UNIX {
    return ux_close(&mut k, x, w);          // src/lxunix.bastio
  }
  return 0;
}

/// fork: the child's descriptors are the parent's, sharing descriptions.
fn lx_fd_fork(k: &mut Kernel, parent: u64, child: u64)
  requires kok(k) && parent < NPROC && child < NPROC
  ensures kok(k)
{
  let hi = smaller(k.fd_hi, LXNFD);         // past it every descriptor is closed
  let mut fd = 0;
  while fd < hi
    invariant fd <= hi && hi <= LXNFD && kok(k)
  {
    let v = fd_get(k.lxfd, parent, fd);
    fd_set_k(&mut k, child, fd, v);
    if v != 0 {
      ref_value(&mut k, v);
    }
    fd = fd + 1;
  }
}

/// Process p gets a working directory, root and umask of its own, copies of
/// the ones it shared.
fn fs_unshare(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let n = fs_next(k.procs, p);
  if n == 0 {
    return;
  }
  fs_take(&mut k, p);
  fs_leave(&mut k, p);
  cwd_fork(&mut k.cwd, n, p);
  cwd_fork(&mut k.croot, n, p);
  pset(&mut k.procs, p, F_UMASK, pget(k.procs, n, F_UMASK));
}

/// Process p gets descriptors of its own, a copy of the ones it shared.
fn fd_unshare(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let n = fd_next(k.procs, p);
  if n == 0 {
    return;
  }
  fd_take(&mut k, p);
  fd_leave(&mut k, p);
  lx_fd_fork(&mut k, n, p);
}

/// One more than the highest descriptor process p has open, 0 for none:
/// where the descriptors it shares begin to matter to nr_open.
fn fd_top(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result <= LXNFD
{
  let r = fd_home(k, p);
  let mut fd = smaller(k.fd_hi, LXNFD);
  while fd > 0 && fd_get(k.lxfd, r, fd - 1) == 0
    invariant fd <= LXNFD
  {
    fd = fd - 1;
  }
  return fd;
}

/// The lowest id in the ring p belongs to: the same for every member.
fn fd_ring_id(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result < NPROC
{
  let mut best = p;
  let mut q = fd_next(k.procs, p);
  let mut n = 0;
  while q != 0 && q != p && n < NPROC
    invariant n <= NPROC && q < NPROC && best < NPROC
  {
    if q < best {
      best = q;
    }
    q = fd_next(k.procs, q);
    n = n + 1;
  }
  return best;
}

/// The lowest id in the ring p belongs to: the same for every member.
fn fs_ring_id(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result < NPROC
{
  let mut best = p;
  let mut q = fs_next(k.procs, p);
  let mut n = 0;
  while q != 0 && q != p && n < NPROC
    invariant n <= NPROC && q < NPROC && best < NPROC
  {
    if q < best {
      best = q;
    }
    q = fs_next(k.procs, q);
    n = n + 1;
  }
  return best;
}

/// Closes Linux descriptor fd. Returns false if it was not open.
fn lx_fd_close(k: &mut Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let v = fd_get(k.lxfd, pid, fd);
  if v == 0 || fd >= LXNFD {
    return false;
  }
  // A process's record locks on a file go when it closes any descriptor
  // for that file (src/lxlock.bastio).
  let d = fd_look(k, pid, fd);
  if d.kind == K_FILE {
    let f = lk_file(k, d.x);
    if f != LK_EOF {
      lock_drop(&mut k.locks, tgid(k.procs, pid), f, LKC_FCNTL);
    }
  }
  fd_set_k(&mut k, pid, fd, 0);
  unref_value(&mut k, v);
  return true;
}

/// close_range(first, last, flags): closes the descriptors first..=last
/// (or, with CLOSE_RANGE_CLOEXEC, marks them close-on-exec). With
/// CLOSE_RANGE_UNSHARE a table shared with other processes is copied first,
/// so only the caller's copy changes.
fn lx_close_range(k: &mut Kernel, pid: u64, first: u64, last: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags % 0x100000000 & !6 != 0 || flags > 0xFFFFFFFF || first > last {
    return EINVAL;
  }
  if flags / 2 % 2 == 1 {
    fd_unshare(&mut k, pid);
  }
  if first >= LXNFD {
    return 0;
  }
  let mut fd = first;
  let mut end = last;
  if end >= LXNFD {
    end = LXNFD - 1;
  }
  while fd <= end && fd < LXNFD
    invariant fd <= LXNFD && kok(k)
  {
    if flags / 4 % 2 == 1 {
      let v = fd_get(k.lxfd, pid, fd);
      if v != 0 && v < FD_CLOEXEC {
        fd_set_k(&mut k, pid, fd, v + FD_CLOEXEC);
      }
    } else {
      lx_fd_close(&mut k, pid, fd);
    }
    fd = fd + 1;
  }
  return 0;
}

/// Closes every descriptor (exit), or every close-on-exec one (execve).
fn lx_fd_close_all(k: &mut Kernel, pid: u64, only_cloexec: bool)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if !only_cloexec {
    fs_leave(&mut k, pid);                  // the process ends: it stops sharing its working directory
  }
  if fd_next(k.procs, pid) != 0 {
    if !only_cloexec {
      fd_leave(&mut k, pid);                // the others still use them
      return;
    }
    fd_unshare(&mut k, pid);                // execve gives the program a table of its own
  }
  let hi = smaller(k.fd_hi, LXNFD);         // past it every descriptor is closed
  let mut fd = 0;
  while fd < hi
    invariant fd <= hi && hi <= LXNFD && kok(k)
  {
    let v = fd_get(k.lxfd, pid, fd);
    // Most slots are empty: look before paying for the call.
    if v != 0 && (!only_cloexec || v >= FD_CLOEXEC) {
      lx_fd_close(&mut k, pid, fd);
    }
    fd = fd + 1;
  }
}

/// Closes the native rows of process `pid` that no description still
/// uses (a forked child may share one after its opener exits).
fn close_unshared(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut f = 0;
  while f < NFD
    invariant f <= NFD && kok(k)
  {
    let row = nbase(pid) + f;
    // Only open rows: row_shared looks through every description.
    if fget(k.fs.ftab, row, FD_FS) != 0 && !row_shared(k.ofd, row) {
      vfs_close(&mut k.fs, &mut k.mem, row);
    }
    f = f + 1;
  }
}

fn row_shared(t: &Buf, row: u64) -> bool
  requires len(t) == OFD_LEN
{
  let mut h = 0;
  while h < OFD_N
    invariant h <= OFD_N
  {
    if of_get(t, h, 0) == OF_FILE && of_get(t, h, 2) == row {
      return true;
    }
    h = h + 1;
  }
  return false;
}

/// A free description set to (kind, x) with one reference, or OFD_N.
fn ofd_new(k: &mut Kernel, kind: u64, x: u64) -> u64
  requires kok(k)
  ensures kok(k) && result <= OFD_N
{
  let mut h = 0;
  while h < OFD_N && of_get(k.ofd, h, 0) != OF_FREE
    invariant h <= OFD_N
  {
    h = h + 1;
  }
  if h >= OFD_N {
    return OFD_N;
  }
  if h >= k.ofd_hi {
    k.ofd_hi = h + 1;
  }
  of_set(&mut k.ofd, h, 0, kind);
  of_set(&mut k.ofd, h, 1, 1);
  k.inet6 = set(k.inet6, h, 0);             // not AF_INET6 unless lx_socket says so
  of_set(&mut k.ofd, h, 2, x);
  of_set(&mut k.ofd, h, 3, 0);
  of_set(&mut k.ofd, h, OF_OWNER, 0);
  of_set(&mut k.ofd, h, OF_SIG, 0);
  of_set(&mut k.ofd, h, OF_CRED, 0);
  of_set(&mut k.ofd, h, OF_ASYNC, 0);
  of_set(&mut k.ofd, h, OF_ACC, 0);
  return h;
}

/// Description h was just made by an open with Linux `flags`: notes the
/// access it did not ask for in OF_ACC.
fn ofd_access(k: &mut Kernel, h: u64, flags: u64)
  requires kok(k)
  ensures kok(k)
{
  if h >= OFD_N {
    return;
  }
  if flags % 4 == 0 {
    of_set(&mut k.ofd, h, OF_ACC, ACC_NOWRITE);
  } else if flags % 4 == 1 {
    of_set(&mut k.ofd, h, OF_ACC, ACC_NOREAD);
  }
}

/// Whether description h lacks the access `bit` (ACC_*).
fn ofd_lacks(k: &Kernel, h: u64, bit: u64) -> bool
  requires kok(k)
{
  return h < OFD_N && of_get(k.ofd, h, OF_ACC) & bit != 0;
}

/// The lowest closed descriptor of process pid at or above `from`, or LXNFD.
fn fd_free_in(t: &Buf, pid: u64, from: u64) -> u64
  requires len(t) <= LXFD_LEN && pid < NPROC
  ensures result <= LXNFD
{
  if (pid + 1) * LXNFD > len(t) {
    return LXNFD;                           // no row: nothing can be installed
  }
  let mut fd = from;
  while fd < LXNFD && fd_get(t, pid, fd) != 0
  {
    fd = fd + 1;
  }
  if fd >= LXNFD {
    return LXNFD;
  }
  return fd;
}

/// Puts description h (whose reference the caller hands over) in the
/// lowest closed descriptor. Returns it, or -EMFILE after dropping h.
fn fd_install(k: &mut Kernel, pid: u64, h: u64) -> u64
  requires kok(k) && pid < NPROC && h < OFD_N
  ensures kok(k)
  ensures lx_fd_or_errno(result)
{
  let fd = fd_free(k, pid, 0);
  if fd >= LXNFD {
    unref_value(&mut k, FD_OFD + h);
    return EMFILE;
  }
  fd_set_k(&mut k, pid, fd, FD_OFD + h);
  return fd;
}

/// A new descriptor on the console (open of /dev/tty). Returns it, or
/// -EMFILE.
fn fd_install_console(k: &mut Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures lx_fd_or_errno(result)
{
  let fd = fd_free(k, pid, 0);
  if fd >= LXNFD {
    return EMFILE;
  }
  fd_set_k(&mut k, pid, fd, FD_CONSOLE);
  return fd;
}

/// open / openat: the native flags for Linux `flags`, then vfs_open, and
/// a description for the row. A file it creates gets `mode` less the
/// process's umask, and its owner (src/lxperm.bastio).
fn lx_open(k: &mut Kernel, pid: u64, dirfd: u64, path: u64, flags: u64, mode: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & LO_NOFOLLOW != 0 && flags & LO_PATH == 0 {
    // O_NOFOLLOW: a symbolic link at the end is ELOOP, as on Linux.
    let m = lx_path_at_nf(&mut k, pid, dirfd, path);
    if m == NO_RESULT {
      return k.perr;
    }
    let f = vfs_lookup(&mut k.fs, m);
    if (f != NO_FILE && vfs_is_link(&mut k.fs, f)) || is_exe_file(proc_node(k, m)) {
      return ELOOP;
    }
  }
  let mut n = NO_RESULT;
  if flags & LO_PATH != 0 && flags & LO_NOFOLLOW != 0 {
    n = lx_path_at_nf(&mut k, pid, dirfd, path);   // a handle on a symbolic link itself, for readlinkat and fstat
  } else if flags & LO_PATH == 0 && (flags % 4 != 0 || flags & LO_TRUNC != 0 || flags & LO_CREAT != 0) {
    n = lx_path_at_w(&mut k, pid, dirfd, path);    // written: in an overlay mount, copied up (src/lxns.bastio)
  } else {
    n = lx_path_at(&mut k, pid, dirfd, path);
  }
  if n == NO_RESULT {
    return k.perr;
  }
  if k.pdir && flags & LO_CREAT != 0 {
    return EISDIR;                          // "new/": a file is not made there, as on Linux
  }
  let pf = proc_node(k, n);
  if is_exe_file(pf) && flags & LO_PATH == 0 && flags % 4 == 0 {
    // /proc/PID/exe is a link to the program: open that (src/lxopen2.bastio).
    n = exe_name(&mut k, pf);
    if n == NO_RESULT {
      let of = exe_orphan(&mut k, pf);
      if of < NFILES {
        return lx_open_orphan(&mut k, pid, of, flags);   // a program run from a memfd: no name, only the file
      }
      return ENOENT;
    }
  }
  let link = flags & LO_PATH != 0 && flags & LO_NOFOLLOW != 0 && n <= XFER && proc_fd(k.procs, k.fs.xfer, n) != NO_RESULT;
  let r = lx_open_n(&mut k, pid, n, flags, mode);
  if link && r < LXNFD {
    // Linux hands back the link itself; this follows it, and the description
    // remembers that it is no more than a handle (magic_target).
    let h = fd_ofd(k, pid, r);
    if h < OFD_N {
      of_set(&mut k.ofd, h, OF_ACC, of_get(k.ofd, h, OF_ACC) | ACC_LINK);
    }
  }
  return r;
}

/// open of the path in the first n bytes of the transfer buffer.
fn lx_open_n(k: &mut Kernel, pid: u64, n: u64, flags: u64, mode: u64) -> u64
  requires kok(k) && pid < NPROC && n <= FNAME_MAX
  ensures kok(k)
{
  if n <= XFER {
    let pfd = proc_fd(k.procs, k.fs.xfer, n);
    if pfd != NO_RESULT {
      return lx_open_fd_link(&mut k, pid, pfd / LXNFD, pfd % LXNFD, flags, mode);
    }
  }
  if flags & LO_TMPFILE != 0 {
    return EOPNOTSUPP;                      // so a program falls back to a named file
  }
  if flags & LO_CREAT != 0 && flags & LO_PATH == 0 {
    let qe = mq_fs_creat(&mut k, pid, n, mode);
    if qe != 0 {
      return qe;                            // a queue directory (src/lxmq.bastio)
    }
  }
  if (flags % 4 != 0 || flags & LO_CREAT != 0) && flags & LO_PATH == 0 && dir_at(&mut k, n) != NO_FILE {
    return EISDIR;                          // a directory is not written through open
  }
  if (flags % 4 != 0 || flags & LO_TRUNC != 0 || flags & LO_CREAT != 0) && path_ro(&mut k, n) {
    let exists = vfs_lookup(&mut k.fs, n) != NO_FILE || dir_at(&mut k, n) != NO_FILE;
    if (exists && (flags % 4 != 0 || flags & LO_TRUNC != 0)) || (!exists && flags & LO_CREAT != 0) {
      return EROFS;                         // a read-only mount (src/lxmount.bastio)
    }
  }
  if flags % 4 != 0 && k.fs.lo_at != 0 && vfs_lookup(&mut k.fs, n) == k.fs.lo_file {
    return EBUSY;                           // a disk image while it is mounted (vfs_lo_mount)
  }
  // Permissions (src/lxperm.bastio): on the file, for what the flags
  // ask; on its directory, for a new name.
  let kept = kept_meta(&mut k, n);
  if kept && flags & LO_NOATIME != 0 {
    let nm = meta_keep(&mut k, n, n);
    if nm.ok && !owns(k.procs, pid, nm.own) {
      return EPERM;                         // O_NOATIME is for the owner and root
    }
  }
  if kept && flags & LO_CREAT != 0 && flags & LO_EXCL != 0 {
    // EEXIST, below
  } else if kept && flags & LO_PATH == 0 {
    let mut want = 0;
    if flags % 4 != LO_WRONLY {
      want = MAY_R;
    }
    if flags % 4 != 0 || flags & LO_TRUNC != 0 {
      want = want + MAY_W;
    }
    let e = may_path(&mut k, pid, n, want);
    if e != 0 {
      return e;
    }
  } else if flags & LO_CREAT != 0 && dir_at(&mut k, n) == NO_FILE && dev_at(k.fs.xfer, n) == DEV_NONE && proc_node(k, n) == 0 {
    // (an existing /proc file opened with O_CREAT, as a shell's > does, is no new name)
    let e = may_dir(&mut k, pid, n);
    if e != 0 {
      return e;
    }
  }
  return lx_open_tail(&mut k, pid, n, flags, mode);
}

/// open of /proc/PID/fd/N, which Linux follows to the file the descriptor
/// holds: a new description of the same open directory, or of a file that
/// still has a name (a file removed while open is not reopened here).
fn lx_open_fd_link(k: &mut Kernel, pid: u64, t: u64, tfd: u64, flags: u64, mode: u64) -> u64
  requires kok(k) && pid < NPROC && t < NPROC
  ensures kok(k)
{
  if tgid(k.procs, t) != tgid(k.procs, pid) {
    return EACCES;
  }
  let d = fd_look(k, t, tfd);
  if d.kind == K_BAD {
    return ENOENT;
  }
  if d.kind == K_DIR {
    let h = fd_ofd(k, t, tfd);
    if h >= OFD_N {
      return ENOENT;
    }
    let hd = ofd_new(&mut k, OF_DIR, d.x);
    if hd >= OFD_N {
      return ENFILE;
    }
    let l = base_len(k, t, h);
    let mut i = 0;
    while i < l
      invariant i <= l && l <= FNAME_MAX && h < OFD_N && kok(k)
    {
      bset(&mut k.fs.xfer, i, base_byte(k, t, h, i));
      i = i + 1;
    }
    dpath_keep(&mut k.dpath, hd, k.fs.xfer, l);
    return fd_install(&mut k, pid, hd);
  }
  if d.kind == K_FILE {
    let f = vfs_row_file(k.fs, d.x);
    if f != NO_FILE {
      let nm = vfs_dirent(&mut k.fs, f);
      if nm == 0 && f < NFILES {
        return lx_open_orphan(&mut k, pid, f, flags);   // unlinked while open: no name to open, only the file
      }
      if nm != NO_FILE && nm <= FNAME_MAX && nm <= XFER {
        return lx_open_n(&mut k, pid, nm, flags, mode);
      }
    }
    return ENOENT;
  }
  return ENXIO;
}

/// open of RAM file node f by itself, for a file that has no name left (a
/// memfd, or any file unlinked while open) reached through /proc/PID/fd/N or
/// /proc/PID/exe: read and write access and O_CLOEXEC from flags.
fn lx_open_orphan(k: &mut Kernel, pid: u64, f: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC && f < NFILES
  ensures kok(k)
{
  let acc = flags % 4;
  let mut fl = O_READ;
  if acc == LO_WRONLY {
    fl = O_WRITE;
  } else if acc == LO_RDWR {
    fl = O_READ + O_WRITE;
  }
  if flags / LO_APPEND % 2 == 1 {
    fl = fl + O_APPEND;
  }
  if flags & LO_PATH != 0 {
    fl = 0;
  }
  if fd_free(k, pid, 0) >= LXNFD || !row_free(k, pid) {
    return EMFILE;
  }
  if fl / O_WRITE % 2 == 1 && file_running(k, f) {
    return ETXTBSY;                         // a program a process runs
  }
  let row = vfs_open_node(&mut k.fs, 0, FD_POOL, fl, f);
  if row == NO_FD || row >= FD_POOL {
    return ENOENT;
  }
  let h = ofd_new(&mut k, OF_FILE, row);
  if h >= OFD_N {
    vfs_close(&mut k.fs, &mut k.mem, row);
    return ENFILE;
  }
  of_set(&mut k.ofd, h, 3, flags / LO_NONBLOCK % 2);
  let fd = fd_install(&mut k, pid, h);
  if fd < LXNFD && flags / LO_CLOEXEC % 2 == 1 {
    fd_set_k(&mut k, pid, fd, FD_OFD + h + FD_CLOEXEC);
  }
  return fd;
}

/// lx_open_n, once the permission checks are done: /proc files, devices
/// and nodes.
fn lx_open_tail(k: &mut Kernel, pid: u64, n: u64, flags: u64, mode: u64) -> u64
  requires kok(k) && pid < NPROC && n <= FNAME_MAX
  ensures kok(k)
{
  let pf = proc_node(k, n);
  if pf != 0 {
    // /proc is read-only but for a sysctl root may write (rw-r--r--);
    // exe is only a link.
    if (flags % 4 != 0 && (!proc_writable(pf) || (fs_id(k.procs, pid, false) != 0 && !um_owner(k, pid, pf)))) || is_exe_file(pf) {
      return EACCES;
    }
    if proc_secret(k.procs, pid, pf) {
      return EACCES;                        // another user's layout, memory or I/O counts
    }
    let hp = ofd_new(&mut k, OF_DEV, pf);
    if hp >= OFD_N {
      return ENFILE;
    }
    if is_ns_file(pf) {
      nsf_open(&mut k, hp, pf);             // it keeps the namespace (src/lxnsk.bastio)
    }
    ofd_access(&mut k, hp, flags);
    return fd_install(&mut k, pid, hp);
  }
  let dev = dev_at(k.fs.xfer, n);
  if dev != DEV_NONE && dev != DEV_DIR && !dv_open_ok(k, pid, dev, flags) {
    return EPERM;                           // the device filter of a cgroup (src/lxbpf.bastio)
  }
  if dev == DEV_TTY {
    if xfer_is(k.fs.xfer, 0, n, "dev/console") && !console_may(k.procs, pid, flags) {
      return EACCES;                        // the console is root's (rw--w----), as stat says
    }
    let ct = pty_ctty(k, pid);
    if ct < PTY_N && xfer_is(k.fs.xfer, 0, n, "dev/tty") {
      return pty_open_slave(&mut k, pid, ct, flags);   // the session's terminal is a pty
    }
    return fd_install_console(&mut k, pid);
  }
  if dev == DEV_PTMX {
    return pty_open_master(&mut k, pid, flags);       // src/lxpty.bastio
  }
  if dev == DEV_DSP && !snd_live(k.snd) {
    return 18446744073709551597;                      // -ENODEV: no sound card
  }
  if dev >= DEV_PTS && dev < DEV_PTS + PTY_N {
    return pty_open_slave(&mut k, pid, dev - DEV_PTS, flags);
  }
  if (is_loop(dev) || dev == DEV_LOOPCTL) && flags & LO_PATH == 0 {
    // A loop device reads and writes the file it is bound to, whoever
    // that file belongs to: rw-rw---- for root and group disk, as on
    // Linux (dev_meta).
    let mut lwant = 0;
    if flags % 4 != LO_WRONLY {
      lwant = MAY_R;
    }
    if flags % 4 != 0 {
      lwant = lwant + MAY_W;
    }
    if !may_meta(k.procs, pid, S_IFBLK, DISK_GID * 0x100000000, lwant) {
      return EACCES;
    }
  }
  if dev != DEV_NONE && dev != DEV_DIR {
    return lx_open_dev(&mut k, pid, dev, flags);
  }
  return lx_open_node(&mut k, pid, n, flags, mode);
}


/// open(2) of character device `dev` with these flags: a descriptor, or
/// an error.
fn lx_open_dev(k: &mut Kernel, pid: u64, dev: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if dev == DEV_MICE {
    return mice_open(&mut k, pid, flags);   // src/lxmouse.bastio
  }
  if dev == DEV_FB {
    return fb_open(&mut k, pid, flags);     // src/lxfb.bastio
  }
  let hv = ofd_new(&mut k, OF_DEV, dev);
  if hv >= OFD_N {
    return ENFILE;
  }
  if dev == DEV_PTSDIR {
    dpath_keep(&mut k.dpath, hv, k.mstr, lpath_len(k));   // the name it was opened by, for /proc/PID/fd
  }
  ofd_access(&mut k, hv, flags);
  return fd_install(&mut k, pid, hv);
}

/// Whether pid may open /dev/console with these open flags: its mode,
/// S_IFCHR (rw--w---- for root), allows what they ask; O_PATH asks nothing.
fn console_may(procs: &Buf, pid: u64, flags: u64) -> bool
  requires ptab_ok(procs) && pid < NPROC
{
  if flags & LO_PATH != 0 {
    return true;
  }
  let mut want = 0;
  if flags % 4 != LO_WRONLY {
    want = MAY_R;
  }
  if flags % 4 != 0 {
    want = want + MAY_W;
  }
  return may_meta(procs, pid, S_IFCHR, 0, want);
}

/// lx_open_n for a path that names no /proc file and no device path:
/// a node in a file system (split off to keep each proof small).
fn lx_open_node(k: &mut Kernel, pid: u64, n: u64, flags: u64, mode: u64) -> u64
  requires kok(k) && pid < NPROC && n <= FNAME_MAX
  ensures kok(k)
{
  let fh = vfs_lookup(&mut k.fs, n);
  let fm = vfs_meta(&mut k.fs, fh);
  if fh != NO_FILE && fm.ok && fm.mode % 65536 / 4096 * 4096 == 0xC000 {
    return 18446744073709551610;            // ENXIO: a socket file is not opened (src/lxunix.bastio)
  }
  if fh != NO_FILE && flags & LO_PATH == 0 && vfs_is_fifo(&mut k.fs, fh) {   // O_PATH holds the name, not an end
    if flags & LO_CREAT != 0 && flags & LO_EXCL != 0 {
      return EEXIST;
    }
    if flags & LO_DIRECTORY != 0 {
      return ENOTDIR;                       // and never wait for the other end
    }
    let ff = fifo_slot(&mut k, fh);
    if ff >= FIFO_N {
      return ENFILE;                        // FIFO_N named pipes are open already
    }
    return fifo_open(&mut k, pid, ff, flags);
  }
  let nt = vfs_node_type(&mut k.fs, fh);
  if fh != NO_FILE && (nt == T_CHR || nt == T_BLK || nt == T_SOCK) && flags & LO_PATH == 0 {
    // (O_PATH holds the node itself, not its device: crun changes a node
    // it made through /proc/self/fd/N.)
    // A device node (src/lxevent.bastio lx_mknod) opens the device its
    // number names; a socket node, or a device BastiOS lacks, is ENXIO.
    if flags & LO_CREAT != 0 && flags & LO_EXCL != 0 {
      return EEXIST;
    }
    if flags & LO_DIRECTORY != 0 {
      return ENOTDIR;
    }
    let mut nd = DEV_NONE;
    if nt == T_CHR {
      nd = rdev_dev(vfs_node_dev(&mut k.fs, fh));
    }
    if nd == DEV_TTY {
      return fd_install_console(&mut k, pid);
    }
    if nd == DEV_NONE {
      return ENXIO;
    }
    if !dv_open_ok(k, pid, nd, flags) {
      return EPERM;                         // the device filter of a cgroup (src/lxbpf.bastio)
    }
    let hn = ofd_new(&mut k, OF_DEV, nd);
    if hn >= OFD_N {
      return ENFILE;
    }
    return fd_install(&mut k, pid, hn);
  }
  let dir = dir_at(&mut k, n);
  let excl = flags & LO_CREAT != 0 && flags & LO_EXCL != 0;
  if excl && (dir != NO_FILE || vfs_lookup(&mut k.fs, n) != NO_FILE) {
    return EEXIST;
  }
  if dir == NO_FILE && flags & LO_DIRECTORY != 0 {
    if vfs_lookup(&mut k.fs, n) != NO_FILE {
      return ENOTDIR;
    }
    return ENOENT;
  }
  if dir != NO_FILE && flags & LO_PATH == 0 && (flags % 4 != 0 || flags & LO_CREAT != 0) {
    return EISDIR;                          // a directory is not opened for writing, nor created
  }
  if dir != NO_FILE {
    // A directory, for getdents64.
    let hd = ofd_new(&mut k, OF_DIR, dir);
    if hd >= OFD_N {
      return ENFILE;
    }
    dpath_keep(&mut k.dpath, hd, k.mstr, lpath_len(k));   // for *at calls and fchdir: the logical name
    return fd_install(&mut k, pid, hd);
  }
  let acc = flags % 4;
  let mut f = O_READ;
  if acc == LO_WRONLY {
    f = O_WRITE;
  } else if acc == LO_RDWR {
    f = O_READ + O_WRITE;
  }
  if flags / LO_CREAT % 2 == 1 {
    f = f + O_CREATE;
  }
  if flags / LO_TRUNC % 2 == 1 {
    f = f + O_TRUNC;
  }
  if flags / LO_APPEND % 2 == 1 {
    f = f + O_APPEND;
  }
  if flags & LO_PATH != 0 {
    f = 0;                                  // O_PATH: neither read nor write, and no other flag counts
  }
  if fh != NO_FILE && f / O_WRITE % 2 + f / O_TRUNC % 2 != 0 && file_running(k, fh) {
    return ETXTBSY;                         // a program a process runs
  }
  if fd_free(k, pid, 0) >= LXNFD || !row_free(k, pid) {
    return EMFILE;                          // no descriptor, or no file layer row, left
  }
  let fresh = f / O_CREATE % 2 == 1 && vfs_lookup(&mut k.fs, n) == NO_FILE;
  let mut own = 0;
  if fresh {
    own = new_owner(&mut k, pid, n);
  }
  let nfd = vfs_open(&mut k.fs, &mut k.mem, 0, FD_POOL, f, n);
  if nfd == NO_FD || nfd >= FD_POOL {
    if fresh && path_ok(k.fs, n) && parent_ok(&mut k.fs, n) {
      return ENOSPC;                        // no free node for it
    }
    return ENOENT;
  }
  let row = nfd;
  if fresh {
    let made = vfs_row_file(k.fs, row);
    if made != NO_FILE {
      made_by(&mut k, pid, made, own, mode % 4096, false);  // less the umask
    }
  }
  let h = ofd_new(&mut k, OF_FILE, row);
  if h >= OFD_N {
    vfs_close(&mut k.fs, &mut k.mem, row);
    return ENFILE;
  }
  of_set(&mut k.ofd, h, 3, flags / LO_NONBLOCK % 2);   // kept for F_GETFL only
  let fd = fd_install(&mut k, pid, h);
  if fd < LXNFD && flags / LO_CLOEXEC % 2 == 1 {
    fd_set_k(&mut k, pid, fd, FD_OFD + h + FD_CLOEXEC);
  }
  return fd;
}

/// dup2(src, new) (dup3 with `cloexec`). Returns new, or -EBADF.
fn lx_dup2(k: &mut Kernel, pid: u64, src: u64, new: u64, cloexec: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures lx_fd_or_errno(result)
{
  let v = fd_get(k.lxfd, pid, src) % FD_CLOEXEC;
  if v == 0 || new >= fd_limit(k, pid) {
    return EBADF;
  }
  if src == new {
    return new;
  }
  lx_fd_close(&mut k, pid, new);
  ref_value(&mut k, v);
  if cloexec {
    fd_set_k(&mut k, pid, new, v + FD_CLOEXEC);
  } else {
    fd_set_k(&mut k, pid, new, v);
  }
  return new;
}

/// dup(src) and fcntl F_DUPFD: the lowest closed descriptor >= from.
fn lx_dup(k: &mut Kernel, pid: u64, src: u64, from: u64, cloexec: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures lx_fd_or_errno(result)
{
  let v = fd_get(k.lxfd, pid, src) % FD_CLOEXEC;
  if v == 0 {
    return EBADF;
  }
  if from >= fd_limit(k, pid) {
    return EINVAL;
  }
  let fd = fd_free(k, pid, from);
  if fd >= LXNFD {
    return EMFILE;
  }
  return lx_dup2(&mut k, pid, src, fd, cloexec);
}

fn lx_fcntl(k: &mut Kernel, pid: u64, fd: u64, cmd: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let v = fd_get(k.lxfd, pid, fd);
  if v == 0 {
    return EBADF;
  }
  if cmd == F_DUPFD || cmd == F_DUPFD_CLOEXEC {
    return lx_dup(&mut k, pid, fd, arg, cmd == F_DUPFD_CLOEXEC);
  }
  if cmd == F_GETFD {
    return v / FD_CLOEXEC;
  }
  if cmd == F_SETFD {
    fd_set_k(&mut k, pid, fd, v % FD_CLOEXEC + FD_CLOEXEC * (arg % 2));
    return 0;
  }
  let h = fd_ofd(k, pid, fd);
  let mut kind = OF_FREE;
  if h < OFD_N {
    kind = of_get(k.ofd, h, 0);
  }
  let pipe = h < OFD_N && can_block(kind);
  // Sockets keep O_NONBLOCK in the low bit of word 3 too (src/lxsock.bastio,
  // src/lxtcp.bastio, src/lxunix.bastio), above their other state.
  let sock = h < OFD_N && (kind == OF_SOCK || kind == OF_TCP || kind == OF_UNIX || kind == OF_NETLINK);
  let mut row = FD_ROWS;
  if h < OFD_N && kind == OF_FILE {
    row = of_get(k.ofd, h, 2);
  }
  if cmd == F_GETFL && row < FD_ROWS {
    let m = fget(k.fs.ftab, row, FD_MODE);
    let mut fl = 0;                         // O_RDONLY
    if m / O_WRITE % 2 == 1 {
      fl = LO_WRONLY;
      if m / O_READ % 2 == 1 {
        fl = LO_RDWR;
      }
    }
    if m / O_APPEND % 2 == 1 {
      fl = fl + LO_APPEND;
    }
    return fl + of_get(k.ofd, h, 3) % 2 * LO_NONBLOCK + of_get(k.ofd, h, OF_ASYNC) % 2 * LO_ASYNC;
  }
  if cmd == F_SETFL && row < FD_ROWS {
    // O_APPEND takes effect; O_NONBLOCK is only reported back (a file never blocks).
    let m = fget(k.fs.ftab, row, FD_MODE);
    let mut nm = m % O_APPEND;              // O_TRUNC and O_CREATE only matter at open
    if arg / LO_APPEND % 2 == 1 {
      nm = nm + O_APPEND;
    }
    fset(&mut k.fs.ftab, row, FD_MODE, nm);
    of_set(&mut k.ofd, h, 3, arg / LO_NONBLOCK % 2);
    of_set(&mut k.ofd, h, OF_ASYNC, arg / LO_ASYNC % 2);
    return 0;
  }
  if cmd == F_GETFL {
    if sock {
      return LO_RDWR + of_get(k.ofd, h, 3) % 2 * LO_NONBLOCK;
    }
    if !pipe {
      return LO_RDWR;
    }
    let mut fl = 0;                         // O_RDONLY
    if kind == OF_PIPE_W {
      fl = LO_WRONLY;
    }
    if kind == OF_PIPE_R && of_get(k.ofd, h, 3) / PIPE_BOTH % 2 == 1 {
      fl = LO_RDWR;
    }
    if kind == OF_EVENT || kind == OF_TIMER || kind == OF_EPOLL || kind == OF_SIGFD || kind == OF_PTY {
      fl = LO_RDWR;
    }
    if kind == OF_PIDFD || kind == OF_INOTIFY || kind == OF_SECCOMP {
      fl = 0;                               // O_RDONLY
    }
    if of_get(k.ofd, h, 3) % 2 == 1 {
      fl = fl + LO_NONBLOCK;
    }
    return fl + of_get(k.ofd, h, OF_ASYNC) % 2 * LO_ASYNC;
  }
  if cmd == F_SETFL {
    // O_NONBLOCK on a pipe end (or eventfd, timerfd, epoll, socket) can change; no
    // other flag (O_APPEND) can.
    if pipe || sock {
      of_set(&mut k.ofd, h, 3, of_get(k.ofd, h, 3) / 2 * 2 + arg / LO_NONBLOCK % 2);
    }
    if h < OFD_N {
      set_async(&mut k, h, arg / LO_ASYNC % 2 == 1);   // src/lxowner.bastio
    }
    return 0;
  }
  if cmd == F_ADD_SEALS || cmd == F_GET_SEALS {
    return lx_seals(&mut k, pid, fd, cmd, arg);   // src/lxmore.bastio
  }
  if cmd == F_GETPIPE_SZ || cmd == F_SETPIPE_SZ {
    let pd = fd_look(k, pid, fd);
    if pd.kind != K_PIPE_R && pd.kind != K_PIPE_W {
      return EBADF;
    }
    return pipe_size(&mut k, pid, pd.x, cmd == F_SETPIPE_SZ, arg);
  }
  if cmd == F_SETOWN || cmd == F_GETOWN || cmd == F_SETOWN_EX || cmd == F_GETOWN_EX || cmd == F_SETSIG || cmd == F_GETSIG {
    return lx_owner(&mut k, pid, h, cmd, arg);    // src/lxowner.bastio
  }
  if cmd == F_SETLEASE || cmd == F_GETLEASE {
    return lx_lease(&mut k, pid, fd, cmd, arg);   // src/lxlock.bastio
  }
  let lock = cmd == F_SETLK || cmd == F_SETLKW || cmd == F_OFD_SETLK || cmd == F_OFD_SETLKW;
  let fk = fd_look(k, pid, fd);
  if (cmd == F_GETLK || cmd == F_OFD_GETLK || lock) && fk.kind == K_FILE {
    return lx_fcntl_lock(&mut k, pid, fd, cmd, arg);   // src/lxlock.bastio
  }
  if cmd == F_GETLK || cmd == F_OFD_GETLK {
    // Only files keep locks: nothing stands in the way on anything else,
    // so l_type (a short at the start of struct flock) says F_UNLCK.
    xfer_u64(&mut k.fs.xfer, 0, F_UNLCK);
    return lx_put_out(&mut k, pid, arg, 2);
  }
  if lock {
    return flock_check(&mut k, pid, arg);   // accepted if well formed, not kept
  }
  return EINVAL;
}

/// pipe2(fds, flags): a new pipe, its read end in fds[0] and write end in
/// fds[1] (two 32-bit ints). Returns 0 or -errno.
fn lx_pipe(k: &mut Kernel, pid: u64, fds: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut p = 0;
  while p < NPIPES && (pi_get(k.pipes, p, 2) != 0 || pi_get(k.pipes, p, 3) != 0)
    invariant p <= NPIPES
  {
    p = p + 1;
  }
  if p >= NPIPES || !pipe_ready(&mut k, p) {
    return ENFILE;
  }
  let r = fd_free(k, pid, 0);
  if r >= LXNFD {
    return EMFILE;
  }
  let w = fd_free(k, pid, r + 1);
  if w >= LXNFD {
    return EMFILE;
  }
  lx_fill(&mut k, 0, 8);
  bset(&mut k.fs.xfer, 0, cast[u8](r % 256));
  bset(&mut k.fs.xfer, 1, cast[u8](r / 256));
  bset(&mut k.fs.xfer, 4, cast[u8](w % 256));
  bset(&mut k.fs.xfer, 5, cast[u8](w / 256));
  if lx_put_out(&mut k, pid, fds, 8) != 0 {
    return EFAULT;
  }
  let hr = ofd_new(&mut k, OF_PIPE_R, p);
  if hr >= OFD_N {
    return ENFILE;
  }
  let hw = ofd_new(&mut k, OF_PIPE_W, p);
  if hw >= OFD_N {
    unref_value(&mut k, FD_OFD + hr);
    return ENFILE;
  }
  pi_set(&mut k.pipes, p, 0, 0);
  pi_set(&mut k.pipes, p, 1, 0);
  pi_set(&mut k.pipes, p, 2, 1);
  pi_set(&mut k.pipes, p, 3, 1);
  pi_set(&mut k.pipes, p, 4, 0);
  pi_set(&mut k.pipes, p, 5, 1);
  pi_set(&mut k.pipes, p, 6, pipe_birth_cap(k, pid));
  pi_set(&mut k.pipes, p, 7, 0);
  of_set(&mut k.ofd, hr, 3, flags / LO_NONBLOCK % 2);
  of_set(&mut k.ofd, hw, 3, flags / LO_NONBLOCK % 2);
  let mut ce = 0;
  if flags / LO_CLOEXEC % 2 == 1 {
    ce = FD_CLOEXEC;
  }
  fd_set_k(&mut k, pid, r, FD_OFD + hr + ce);
  fd_set_k(&mut k, pid, w, FD_OFD + hw + ce);
  return 0;
}

/// Reads up to n bytes from pipe p to user address va. Returns the count,
/// 0 at end of file (no writer left), or EAGAIN if the caller must wait.
fn pipe_read1(k: &mut Kernel, pid: u64, p: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && p < NPIPES
  ensures kok(k)
  ensures lx_count_or_fail(result, n)
{
  let mut r = pipe_ring(k.pipes, p);
  let count = r.n;
  if count == 0 {
    if pi_get(k.pipes, p, 3) == 0 && pi_get(k.pipes, p, 5) != 0 {
      return 0;                             // every writer has gone
    }
    return EAGAIN;                          // (a FIFO no writer has opened yet waits for one)
  }
  if n == 0 {
    return 0;
  }
  let want = smaller(smaller(n, count), XFER);
  pipe_ring_out(&mut k, p, 0, r.h, want);
  let put = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, want);
  if put == NO_RESULT || (put == 0 && want > 0) {
    return EFAULT;
  }
  ring_pop_n(&mut r, put);
  pipe_keep(&mut k.pipes, p, r);
  return put;
}

/// Writes up to n bytes from user address va into pipe p. Returns the
/// count, -EPIPE with no reader left, or EAGAIN if the pipe is full. A
/// write of PIPE_ATOM bytes or fewer goes in whole or not at all, so
/// writers sharing a pipe never interleave inside one (POSIX PIPE_BUF).
fn pipe_write1(k: &mut Kernel, pid: u64, p: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && p < NPIPES
  ensures kok(k)
  ensures lx_count_or_fail(result, n)
{
  if pi_get(k.pipes, p, 2) == 0 {
    return EPIPE;
  }
  if n == 0 {
    return 0;
  }
  let mut r = pipe_ring(k.pipes, p);
  let room = pipe_room_for(&mut k, p, r.n, smaller(n, XFER));
  if room == 0 || (n <= PIPE_ATOM && room < n) {
    return EAGAIN;
  }
  let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, smaller(smaller(n, room), XFER));
  if got == NO_RESULT || (got == 0 && n > 0) {
    return EFAULT;
  }
  pipe_ring_in(&mut k, p, ring_slot(r, r.n), 0, got);
  ring_push_n(&mut r, got);
  pipe_keep(&mut k.pipes, p, r);
  sigio_pipe(&mut k, p);
  return got;
}

/// pipe_read1 in XFER pieces, until n bytes or the pipe is empty.
fn pipe_read(k: &mut Kernel, pid: u64, p: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && p < NPIPES
  ensures kok(k)
  ensures lx_count_or_fail(result, n)
{
  let first = pipe_read1(&mut k, pid, p, va, n);
  if first == 0 || first > n || first < XFER || va >= 0x8000000000000000 {
    return first;                           // EOF, an error, EAGAIN, or all there was
  }
  let mut done = first;
  while done < n && done < 0x8000000000000000
    invariant kok(k) && done <= n
  {
    let more = pipe_read1(&mut k, pid, p, va + done, n - done);
    if more == 0 || more > n - done {
      return done;                          // empty now: what we have is the answer
    }
    done = done + more;
  }
  return done;
}

/// pipe_write1 in XFER pieces, until n bytes or the pipe is full, as one
/// write on Linux puts in all that fits.
fn pipe_write(k: &mut Kernel, pid: u64, p: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && p < NPIPES
  ensures kok(k)
  ensures lx_count_or_fail(result, n)
{
  let first = pipe_write1(&mut k, pid, p, va, n);
  if first == 0 || first > n || first < XFER || va >= 0x8000000000000000 {
    return first;
  }
  let mut done = first;
  while done < n && done < 0x8000000000000000
    invariant kok(k) && done <= n
  {
    let more = pipe_write1(&mut k, pid, p, va + done, n - done);
    if more == 0 || more > n - done {
      return done;                          // full now, or the rest faulted
    }
    done = done + more;
  }
  return done;
}

/// Makes sure pipe slot p has its ring, taking PIPE_PAGE bytes for it if
/// the slot has none (it is new, or its last pipe let go of it). False
/// when there is no memory for it, or p is past the next slot (a new pipe
/// takes the lowest free one, so it never is).
fn pipe_ready(k: &mut Kernel, p: u64) -> bool
  requires kok(k) && p < NPIPES
  ensures kok(k)
{
  let n = vec_len(k.pipebuf);
  if p < n {
    match vec_swap(&mut k.pipebuf, p, PipeBuf::None) {
      PipeBuf::Ring(b) => {
        match vec_swap(&mut k.pipebuf, p, PipeBuf::Ring(b)) {
          PipeBuf::None => {},
          PipeBuf::Ring(x) => { bfree(x); },
        }
        return true;
      },
      PipeBuf::None => {
        let r = try_balloc(PIPE_PAGE);
        if blen(r) != PIPE_PAGE {
          bfree(r);
          return false;
        }
        match vec_swap(&mut k.pipebuf, p, PipeBuf::Ring(r)) {
          PipeBuf::None => {},
          PipeBuf::Ring(x) => { bfree(x); },
        }
        return true;
      },
    }
  }
  if p > n {
    return false;
  }
  let b = try_balloc(PIPE_PAGE);
  if blen(b) != PIPE_PAGE || !vec_try_reserve(&mut k.pipebuf, 1) {
    bfree(b);
    return false;
  }
  vec_push_within(&mut k.pipebuf, PipeBuf::Ring(b));
  return true;
}

/// The room for a write of `want` bytes into pipe p, which holds `count`:
/// pipe_room, after growing its ring to fit them if it can. A ring starts
/// at PIPE_PAGE bytes and doubles up to PIPE_CAP, so a pipe that never
/// holds much costs a page, as on Linux; if memory runs out, the room is
/// what the ring holds now.
fn pipe_room_for(k: &mut Kernel, p: u64, count: u64, want: u64) -> u64
  requires kok(k) && p < NPIPES && count <= PIPE_CAP
  ensures kok(k) && result <= PIPE_CAP - count
{
  let room = pipe_room(k.pipes, p, count);
  let l = pipe_grow(&mut k, p, count + smaller(room, want), count);
  if l <= count {
    return 0;
  }
  return smaller(room, l - count);
}

/// Grows pipe p's ring to `need` bytes (rounded up to a power of two) if
/// it is smaller, keeping the `count` bytes it holds where ring positions
/// (the head and on, modulo the ring's length) find them. The ring's
/// length afterwards, 0 if it has none.
fn pipe_grow(k: &mut Kernel, p: u64, need: u64, count: u64) -> u64
  requires kok(k) && p < NPIPES && need <= PIPE_CAP
  ensures kok(k)
{
  if p >= vec_len(k.pipebuf) {
    return 0;
  }
  match vec_swap(&mut k.pipebuf, p, PipeBuf::None) {
    PipeBuf::None => { return 0; },
    PipeBuf::Ring(b) => {
      let l = blen(b);
      if l >= need || l == 0 || count > l {
        match vec_swap(&mut k.pipebuf, p, PipeBuf::Ring(b)) {
          PipeBuf::None => {},
          PipeBuf::Ring(x) => { bfree(x); },
        }
        return l;
      }
      let mut nl = l;
      while nl < need && nl < PIPE_CAP
        invariant 0 < nl && nl <= PIPE_CAP
      {
        nl = nl * 2;
        if nl > PIPE_CAP {
          nl = PIPE_CAP;
        }
      }
      let mut nb = try_balloc(nl);
      if blen(nb) != nl || nl < l {
        bfree(nb);
        match vec_swap(&mut k.pipebuf, p, PipeBuf::Ring(b)) {
          PipeBuf::None => {},
          PipeBuf::Ring(x) => { bfree(x); },
        }
        return l;
      }
      let h = pi_get(k.pipes, p, 0) % PIPE_CAP;
      let mut i = 0;
      while i < count
        invariant i <= count && count <= l && l == blen(b) && 0 < nl && nl == blen(nb)
      {
        bset(&mut nb, (h + i) % nl, bget(b, (h + i) % l));
        i = i + 1;
      }
      bfree(b);
      match vec_swap(&mut k.pipebuf, p, PipeBuf::Ring(nb)) {
        PipeBuf::None => {},
        PipeBuf::Ring(x) => { bfree(x); },
      }
      return nl;
    },
  }
}

/// Pipe p has no descriptor left on either end: its ring goes back to the
/// kernel's memory, so only pipes in use hold one (a pipe holds 64 KiB).
fn pipe_release(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPIPES
  ensures kok(k)
{
  if p >= vec_len(k.pipebuf) || pi_get(k.pipes, p, 2) != 0 || pi_get(k.pipes, p, 3) != 0 {
    return;
  }
  match vec_swap(&mut k.pipebuf, p, PipeBuf::None) {
    PipeBuf::None => {},
    PipeBuf::Ring(b) => { bfree(b); },
  }
}

/// ring_out from pipe p's ring into the transfer buffer at d.
fn pipe_ring_out(k: &mut Kernel, p: u64, d: u64, from: u64, n: u64)
  requires kok(k) && p < NPIPES && from < PIPE_CAP && n <= PIPE_CAP && d + n <= XFER
  ensures kok(k)
{
  if p >= vec_len(k.pipebuf) {
    return;                                 // no ring: pipe_ready keeps it from being used
  }
  match vec_swap(&mut k.pipebuf, p, PipeBuf::None) {
    PipeBuf::None => {},
    PipeBuf::Ring(b) => {
      let l = blen(b);
      if l > 0 && n <= l {
        ring_out(&mut k.fs.xfer, d, b, 0, l, from % l, n);
      }
      match vec_swap(&mut k.pipebuf, p, PipeBuf::Ring(b)) {
        PipeBuf::None => {},
        PipeBuf::Ring(x) => { bfree(x); },
      }
    },
  }
}

/// ring_in into pipe p's ring at `at` from the transfer buffer at s.
fn pipe_ring_in(k: &mut Kernel, p: u64, at: u64, s: u64, n: u64)
  requires kok(k) && p < NPIPES && at < PIPE_CAP && n <= PIPE_CAP && s + n <= XFER
  ensures kok(k)
{
  if p >= vec_len(k.pipebuf) {
    return;
  }
  match vec_swap(&mut k.pipebuf, p, PipeBuf::None) {
    PipeBuf::None => {},
    PipeBuf::Ring(b) => {
      let mut rb = b;
      let l = blen(rb);
      if l > 0 && n <= l {
        ring_in(&mut rb, 0, l, at % l, k.fs.xfer, s, n);
      }
      match vec_swap(&mut k.pipebuf, p, PipeBuf::Ring(rb)) {
        PipeBuf::None => {},
        PipeBuf::Ring(x) => { bfree(x); },
      }
    },
  }
}

/// Copies n bytes out of the ring buffer src[base .. base + cap], starting
/// at position `from` and wrapping at the end, into dst from index d.
fn ring_out(dst: &mut Bytes, d: u64, src: &Bytes, base: u64, cap: u64, from: u64, n: u64)
  requires from < cap && n <= cap && base + cap <= blen(src) && d + n <= blen(dst)
  ensures blen(dst) == old(blen(dst))
{
  let first = smaller(n, cap - from);
  bcopy(&mut dst, d, src, base + from, first);
  bcopy(&mut dst, d + first, src, base, n - first);
}

/// Copies src[s .. s + n] into the ring buffer dst[base .. base + cap],
/// from position `at`, wrapping at the end.
fn ring_in(dst: &mut Bytes, base: u64, cap: u64, at: u64, src: &Bytes, s: u64, n: u64)
  requires at < cap && n <= cap && base + cap <= blen(dst) && s + n <= blen(src)
  ensures blen(dst) == old(blen(dst))
{
  let first = smaller(n, cap - at);
  bcopy(&mut dst, base + at, src, s, first);
  bcopy(&mut dst, base, src, s + first, n - first);
}

/// Makes process `pid` run system call `n` again later: a wait.
fn lx_retry(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let rip = pget(k.procs, pid, F_REGS + R_RIP);
  if rip < SYSCALL_LEN {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  pset(&mut k.procs, pid, F_REGS + R_RIP, rip - SYSCALL_LEN);
  pset(&mut k.procs, pid, F_REGS + R_LXNR, n);
  pset(&mut k.procs, pid, F_RESTART, 1);
  return SWITCH;
}

/// Blocks process pid until the console's ring has room (`wake_writers`),
/// then restarts its system call n, as lx_retry does.
fn con_block(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r = lx_retry(&mut k, pid, n);
  if r == SWITCH {
    pset(&mut k.procs, pid, F_STATE, CONWAIT);
  }
  return r;
}

/// Makes every process waiting for room in the console's ring READY.
fn wake_writers(procs: &mut Buf)
  requires ptab_ok(procs)
  ensures ptab_ok(procs)
{
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && ptab_ok(procs)
  {
    if state(procs, p) == CONWAIT {
      pset(&mut procs, p, F_STATE, READY);
    }
    p = p + 1;
  }
}
