// Linux file descriptors. Each process has LXNFD descriptors; each names
// the console or an open file description (the `ofd` table), which dup,
// dup2 and fork share and which counts its references. A description is a
// file (a native row of the file layer), one end of a pipe, a directory
// being listed, or a UDP socket (src/lxsock.bastio).
//
// k.lxfd, word pid * LXNFD + fd: 0 closed, FD_CONSOLE, or FD_OFD + h for
// description h; plus FD_CLOEXEC if execve closes it.
// k.ofd, words h * OFD_STRIDE: kind, references, row, pipe or directory,
// and a directory's next entry (for a pipe end: 1 if it is nonblocking).
// k.pipes, words p * PIPE_STRIDE: head, count, the descriptions of its
// read end and of its write end, the FIFO it belongs to + 1 (0 for an
// anonymous pipe; src/lxevent.bastio), and 1 once a writer has opened it;
// the ring itself is PIPE_CAP bytes of k.pipebuf at p * PIPE_CAP.

import "linux.bastio";
import "lxdev.bastio";

struct Fd { kind: u64, x: u64 }

spec fn fds_ok(k: &Kernel) -> bool {
  len(k.lxfd) == LXFD_LEN && len(k.ofd) == OFD_LEN && len(k.pipes) == PIPES_LEN
}

fn fd_get(t: &Buf, pid: u64, fd: u64) -> u64
  requires len(t) == LXFD_LEN && pid < NPROC
  ensures fd >= LXNFD ==> result == 0
{
  if fd >= LXNFD {
    return 0;
  }
  return get(t, pid * LXNFD + fd);
}

fn fd_set(t: &mut Buf, pid: u64, fd: u64, v: u64)
  requires len(t) == LXFD_LEN && pid < NPROC && fd < LXNFD
  ensures len(t) == LXFD_LEN
{
  t = set(t, pid * LXNFD + fd, v);
}

fn of_get(t: &Buf, h: u64, f: u64) -> u64
  requires len(t) == OFD_LEN && h < OFD_N && f < OFD_STRIDE
{
  return get(t, h * OFD_STRIDE + f);
}

fn of_set(t: &mut Buf, h: u64, f: u64, v: u64)
  requires len(t) == OFD_LEN && h < OFD_N && f < OFD_STRIDE
  ensures len(t) == OFD_LEN
{
  t = set(t, h * OFD_STRIDE + f, v);
}

fn pi_get(t: &Buf, p: u64, f: u64) -> u64
  requires len(t) == PIPES_LEN && p < NPIPES && f < PIPE_STRIDE
{
  return get(t, p * PIPE_STRIDE + f);
}

fn pi_set(t: &mut Buf, p: u64, f: u64, v: u64)
  requires len(t) == PIPES_LEN && p < NPIPES && f < PIPE_STRIDE
  ensures len(t) == PIPES_LEN
{
  t = set(t, p * PIPE_STRIDE + f, v);
}

/// What Linux descriptor `fd` of process `pid` refers to.
fn fd_look(k: &Kernel, pid: u64, fd: u64) -> Fd
  requires fds_ok(k) && pid < NPROC
  ensures result.kind == K_FILE ==> result.x < FD_ROWS
  ensures (result.kind == K_PIPE_R || result.kind == K_PIPE_W) ==> result.x < NPIPES
  ensures result.kind == K_EVENT ==> result.x < OFD_N
  ensures result.kind == K_TIMER ==> result.x < TFD_N
  ensures result.kind == K_EPOLL ==> result.x < EP_N
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  if v == FD_CONSOLE {
    return Fd { kind: K_CONSOLE, x: 0 };
  }
  if v < FD_OFD || v - FD_OFD >= OFD_N {
    return Fd { kind: K_BAD, x: 0 };
  }
  let h = v - FD_OFD;
  let kind = of_get(k.ofd, h, 0);
  let x = of_get(k.ofd, h, 2);
  if kind == OF_FILE && x < FD_ROWS {
    return Fd { kind: K_FILE, x: x };
  }
  if kind == OF_PIPE_R && x < NPIPES {
    return Fd { kind: K_PIPE_R, x: x };
  }
  if kind == OF_PIPE_W && x < NPIPES {
    return Fd { kind: K_PIPE_W, x: x };
  }
  if kind == OF_DIR {
    return Fd { kind: K_DIR, x: x };
  }
  if kind == OF_SOCK || kind == OF_TCP || kind == OF_UNIX {
    return Fd { kind: K_SOCK, x: x };
  }
  if kind == OF_DEV {
    return Fd { kind: K_DEV, x: x };
  }
  if kind == OF_EVENT {
    return Fd { kind: K_EVENT, x: h };      // the counter lives in the description
  }
  if kind == OF_TIMER && x < TFD_N {
    return Fd { kind: K_TIMER, x: x };
  }
  if kind == OF_SIGFD {
    return Fd { kind: K_SIGFD, x: h };      // the mask lives in the description
  }
  if kind == OF_EPOLL && x < EP_N {
    return Fd { kind: K_EPOLL, x: x };
  }
  return Fd { kind: K_BAD, x: 0 };
}

/// The open file description descriptor `fd` of process `pid` names, or
/// OFD_N if it names none (closed, or the console).
fn fd_ofd(k: &Kernel, pid: u64, fd: u64) -> u64
  requires fds_ok(k) && pid < NPROC
  ensures result <= OFD_N
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  if v < FD_OFD || v - FD_OFD >= OFD_N {
    return OFD_N;
  }
  return v - FD_OFD;
}

/// Whether descriptor `fd` of process `pid` is a pipe end, eventfd, timerfd
/// or epoll instance with O_NONBLOCK: a read or write that would wait
/// fails with -EAGAIN instead.
fn pipe_nonblock(k: &Kernel, pid: u64, fd: u64) -> bool
  requires fds_ok(k) && pid < NPROC
{
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N {
    return false;
  }
  return can_block(of_get(k.ofd, h, 0)) && of_get(k.ofd, h, 3) % 2 == 1;
}

/// Whether descriptions of this kind keep O_NONBLOCK in the low bit of
/// word 3.
fn can_block(kind: u64) -> bool {
  return kind == OF_PIPE_R || kind == OF_PIPE_W || kind == OF_EVENT || kind == OF_TIMER || kind == OF_EPOLL || kind == OF_SIGFD;
}

/// Whether process pid has a file layer row free: an open file holds
/// one, and each process has NFD of them.
fn row_free(k: &Kernel, pid: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let mut i = 0;
  while i < NFD
    invariant i <= NFD
  {
    if fget(k.fs.ftab, pid * NFD + i, FD_FS) == 0 {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Process `pid`'s descriptors as a new program starts: 0 to 2 on the
/// console, the rest closed. They must hold no references.
fn lx_fd_reset(t: &mut Buf, pid: u64)
  requires len(t) == LXFD_LEN && pid < NPROC
  ensures len(t) == LXFD_LEN
{
  let mut fd = 0;
  while fd < LXNFD
    invariant fd <= LXNFD && len(t) == LXFD_LEN
  {
    if fd < 3 {
      fd_set(&mut t, pid, fd, FD_CONSOLE);
    } else {
      fd_set(&mut t, pid, fd, 0);
    }
    fd = fd + 1;
  }
}

/// Adds a reference to whatever descriptor value v names.
fn ref_value(k: &mut Kernel, v: u64)
  requires kok(k)
  ensures kok(k)
{
  let t = v % FD_CLOEXEC;
  // There are only LXFD_LEN descriptors to hold references.
  if t >= FD_OFD && t - FD_OFD < OFD_N {
    let r = of_get(k.ofd, t - FD_OFD, 1);
    if r < LXFD_LEN {
      of_set(&mut k.ofd, t - FD_OFD, 1, r + 1);
    }
  }
}

/// Drops the reference descriptor value v holds; the last one closes the
/// file or the pipe end. Closing a unix socket can drop a description in
/// flight to it in turn, and that one another: at most OFD_N in all, as
/// each drop frees a description.
fn unref_value(k: &mut Kernel, v: u64)
  requires kok(k)
  ensures kok(k)
{
  let mut next = v;
  let mut i = 0;
  while next != 0 && i < OFD_N
    invariant i <= OFD_N && kok(k)
  {
    next = unref_one(&mut k, next);
    i = i + 1;
  }
}

/// unref_value for one description; returns the descriptor value of a
/// description its closing let go of (see ux_close), or 0.
fn unref_one(k: &mut Kernel, v: u64) -> u64
  requires kok(k)
  ensures kok(k)
{
  let t = v % FD_CLOEXEC;
  if t < FD_OFD || t - FD_OFD >= OFD_N {
    return 0;
  }
  let h = t - FD_OFD;
  let refs = of_get(k.ofd, h, 1);
  if refs > 1 {
    of_set(&mut k.ofd, h, 1, refs - 1);
    return 0;
  }
  let kind = of_get(k.ofd, h, 0);
  let x = of_get(k.ofd, h, 2);
  let w = of_get(k.ofd, h, 3);
  lock_drop(&mut k.locks, LK_DESC + h, LK_EOF, 2);   // its OFD locks and flocks
  of_set(&mut k.ofd, h, 0, OF_FREE);
  of_set(&mut k.ofd, h, 1, 0);
  if kind == OF_FILE && x < FD_ROWS {
    vfs_close(&mut k.fs, &mut k.mem, x);
  } else if kind == OF_PIPE_R && x < NPIPES {
    let left = pi_get(k.pipes, x, 2);
    if left > 0 {
      pi_set(&mut k.pipes, x, 2, left - 1);   // one description fewer on this end
    }
  } else if kind == OF_PIPE_W && x < NPIPES {
    let left = pi_get(k.pipes, x, 3);
    if left > 0 {
      pi_set(&mut k.pipes, x, 3, left - 1);   // one description fewer on this end
    }
  } else if kind == OF_SOCK {
    sock_close(&mut k.nic, x);
  } else if kind == OF_TCP && x < TCBS {
    tcp_close(&mut k.nic, x);               // sends the FIN after what is buffered
  } else if kind == OF_TIMER && x < TFD_N {
    k.evt = set(k.evt, x * TFD_STRIDE, 0);  // the timer is free again
  } else if kind == OF_EPOLL && x < EP_N {
    k.evt = set(k.evt, EP_AT + x * EP_STRIDE, 0);
  } else if kind == OF_UNIX {
    return ux_close(&mut k, x, w);          // src/lxunix.bastio
  }
  return 0;
}

/// fork: the child's descriptors are the parent's, sharing descriptions.
fn lx_fd_fork(k: &mut Kernel, parent: u64, child: u64)
  requires kok(k) && parent < NPROC && child < NPROC
  ensures kok(k)
{
  let mut fd = 0;
  while fd < LXNFD
    invariant fd <= LXNFD && kok(k)
  {
    let v = fd_get(k.lxfd, parent, fd);
    fd_set(&mut k.lxfd, child, fd, v);
    ref_value(&mut k, v);
    fd = fd + 1;
  }
}

/// Closes Linux descriptor fd. Returns false if it was not open.
fn lx_fd_close(k: &mut Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let v = fd_get(k.lxfd, pid, fd);
  if v == 0 || fd >= LXNFD {
    return false;
  }
  // A process's record locks on a file go when it closes any descriptor
  // for that file (src/lxlock.bastio).
  let d = fd_look(k, pid, fd);
  if d.kind == K_FILE {
    let f = lk_file(k, d.x);
    if f != LK_EOF {
      lock_drop(&mut k.locks, tgid(k.procs, pid), f, LKC_FCNTL);
    }
  }
  fd_set(&mut k.lxfd, pid, fd, 0);
  unref_value(&mut k, v);
  return true;
}

/// Closes every descriptor (exit), or every close-on-exec one (execve).
fn lx_fd_close_all(k: &mut Kernel, pid: u64, only_cloexec: bool)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut fd = 0;
  while fd < LXNFD
    invariant fd <= LXNFD && kok(k)
  {
    if !only_cloexec || fd_get(k.lxfd, pid, fd) >= FD_CLOEXEC {
      lx_fd_close(&mut k, pid, fd);
    }
    fd = fd + 1;
  }
}

/// Closes the native rows of process `pid` that no description still
/// uses (a forked child may share one after its opener exits).
fn close_unshared(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut f = 0;
  while f < NFD
    invariant f <= NFD && kok(k)
  {
    let row = pid * NFD + f;
    if !row_shared(k.ofd, row) {
      vfs_close(&mut k.fs, &mut k.mem, row);
    }
    f = f + 1;
  }
}

fn row_shared(t: &Buf, row: u64) -> bool
  requires len(t) == OFD_LEN
{
  let mut h = 0;
  while h < OFD_N
    invariant h <= OFD_N
  {
    if of_get(t, h, 0) == OF_FILE && of_get(t, h, 2) == row {
      return true;
    }
    h = h + 1;
  }
  return false;
}

/// A free description set to (kind, x) with one reference, or OFD_N.
fn ofd_new(k: &mut Kernel, kind: u64, x: u64) -> u64
  requires kok(k)
  ensures kok(k) && result <= OFD_N
{
  let mut h = 0;
  while h < OFD_N && of_get(k.ofd, h, 0) != OF_FREE
    invariant h <= OFD_N
  {
    h = h + 1;
  }
  if h >= OFD_N {
    return OFD_N;
  }
  of_set(&mut k.ofd, h, 0, kind);
  of_set(&mut k.ofd, h, 1, 1);
  k.inet6 = k.inet6 & !(1 << h);            // not AF_INET6 unless lx_socket says so
  of_set(&mut k.ofd, h, 2, x);
  of_set(&mut k.ofd, h, 3, 0);
  return h;
}

/// The lowest closed descriptor of process pid at or above `from`, or LXNFD.
fn fd_free(t: &Buf, pid: u64, from: u64) -> u64
  requires len(t) == LXFD_LEN && pid < NPROC
  ensures result <= LXNFD
{
  let mut fd = from;
  while fd < LXNFD && fd_get(t, pid, fd) != 0
  {
    fd = fd + 1;
  }
  if fd >= LXNFD {
    return LXNFD;
  }
  return fd;
}

/// Puts description h (whose reference the caller hands over) in the
/// lowest closed descriptor. Returns it, or -EMFILE after dropping h.
fn fd_install(k: &mut Kernel, pid: u64, h: u64) -> u64
  requires kok(k) && pid < NPROC && h < OFD_N
  ensures kok(k)
{
  let fd = fd_free(k.lxfd, pid, 0);
  if fd >= LXNFD {
    unref_value(&mut k, FD_OFD + h);
    return EMFILE;
  }
  fd_set(&mut k.lxfd, pid, fd, FD_OFD + h);
  return fd;
}

/// A new descriptor on the console (open of /dev/tty). Returns it, or
/// -EMFILE.
fn fd_install_console(k: &mut Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let fd = fd_free(k.lxfd, pid, 0);
  if fd >= LXNFD {
    return EMFILE;
  }
  fd_set(&mut k.lxfd, pid, fd, FD_CONSOLE);
  return fd;
}

/// open / openat: the native flags for Linux `flags`, then vfs_open, and
/// a description for the row. A file it creates gets `mode` less the
/// umask (always 022).
fn lx_open(k: &mut Kernel, pid: u64, dirfd: u64, path: u64, flags: u64, mode: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_at(&mut k, pid, dirfd, path);
  if n == NO_RESULT {
    return k.perr;
  }
  return lx_open_n(&mut k, pid, n, flags, mode);
}

/// open of the path in the first n bytes of the transfer buffer.
fn lx_open_n(k: &mut Kernel, pid: u64, n: u64, flags: u64, mode: u64) -> u64
  requires kok(k) && pid < NPROC && n <= FNAME_MAX
  ensures kok(k)
{
  if flags & LO_TMPFILE != 0 {
    return EOPNOTSUPP;                      // so a program falls back to a named file
  }
  if (flags % 4 != 0 || flags & LO_TRUNC != 0 || flags & LO_CREAT != 0) && vfs_ro(&mut k.fs, n) {
    let exists = vfs_lookup(&mut k.fs, n) != NO_FILE || dir_at(&mut k, n) != NO_FILE;
    if (exists && (flags % 4 != 0 || flags & LO_TRUNC != 0)) || (!exists && flags & LO_CREAT != 0) {
      return EROFS;                         // a read-only mount (src/lxmount.bastio)
    }
  }
  if flags % 4 != 0 && k.fs.lo_at != 0 && vfs_lookup(&mut k.fs, n) == k.fs.lo_file {
    return EBUSY;                           // a disk image while it is mounted (vfs_lo_mount)
  }
  let pf = proc_file(k.procs, k.fs.xfer, n);
  if pf != 0 {
    if flags % 4 != 0 || pf % 16 == PF_EXE {
      return EACCES;                        // /proc is read-only; exe is only a link
    }
    let hp = ofd_new(&mut k, OF_DEV, pf);
    if hp >= OFD_N {
      return ENFILE;
    }
    return fd_install(&mut k, pid, hp);
  }
  let dev = dev_at(k.fs.xfer, n);
  if dev == DEV_TTY {
    return fd_install_console(&mut k, pid);
  }
  if dev != DEV_NONE && dev != DEV_DIR {
    let hv = ofd_new(&mut k, OF_DEV, dev);
    if hv >= OFD_N {
      return ENFILE;
    }
    return fd_install(&mut k, pid, hv);
  }
  let fh = vfs_lookup(&mut k.fs, n);
  if fh != NO_FILE && vfs_is_fifo(&mut k.fs, fh) {
    if flags & LO_CREAT != 0 && flags & LO_EXCL != 0 {
      return EEXIST;
    }
    let ff = fifo_slot(&mut k, fh);
    if ff >= FIFO_N {
      return ENFILE;                        // FIFO_N named pipes are open already
    }
    return fifo_open(&mut k, pid, ff, flags);
  }
  let dir = dir_at(&mut k, n);
  let excl = flags & LO_CREAT != 0 && flags & LO_EXCL != 0;
  if excl && (dir != NO_FILE || vfs_lookup(&mut k.fs, n) != NO_FILE) {
    return EEXIST;
  }
  if dir == NO_FILE && flags & LO_DIRECTORY != 0 {
    if vfs_lookup(&mut k.fs, n) != NO_FILE {
      return ENOTDIR;
    }
    return ENOENT;
  }
  if dir != NO_FILE {
    // A directory, for getdents64.
    let hd = ofd_new(&mut k, OF_DIR, dir);
    if hd >= OFD_N {
      return ENFILE;
    }
    name_keep(&mut k.dpath, DPATH_LEN, hd, k.fs.xfer, n);   // for *at calls and fchdir
    return fd_install(&mut k, pid, hd);
  }
  let acc = flags % 4;
  let mut f = O_READ;
  if acc == LO_WRONLY {
    f = O_WRITE;
  } else if acc == LO_RDWR {
    f = O_READ + O_WRITE;
  }
  if flags / LO_CREAT % 2 == 1 {
    f = f + O_CREATE;
  }
  if flags / LO_TRUNC % 2 == 1 {
    f = f + O_TRUNC;
  }
  if flags / LO_APPEND % 2 == 1 {
    f = f + O_APPEND;
  }
  if fd_free(k.lxfd, pid, 0) >= LXNFD || !row_free(k, pid) {
    return EMFILE;                          // no descriptor, or no file layer row, left
  }
  let fresh = f / O_CREATE % 2 == 1 && vfs_lookup(&mut k.fs, n) == NO_FILE;
  let nfd = vfs_open(&mut k.fs, &mut k.mem, pid * NFD, f, n);
  if nfd == NO_FD || nfd >= NFD {
    return ENOENT;
  }
  let row = pid * NFD + nfd;
  if fresh {
    let made = vfs_row_file(k.fs, row);
    if made != NO_FILE {
      vfs_set_meta(&mut k.fs, made, mode % 512 & !18, NO_FILE);   // 0777 bits, less umask 022
    }
  }
  let h = ofd_new(&mut k, OF_FILE, row);
  if h >= OFD_N {
    vfs_close(&mut k.fs, &mut k.mem, row);
    return ENFILE;
  }
  of_set(&mut k.ofd, h, 3, flags / LO_NONBLOCK % 2);   // kept for F_GETFL only
  let fd = fd_install(&mut k, pid, h);
  if fd < LXNFD && flags / LO_CLOEXEC % 2 == 1 {
    fd_set(&mut k.lxfd, pid, fd, FD_OFD + h + FD_CLOEXEC);
  }
  return fd;
}

/// dup2(src, new) (dup3 with `cloexec`). Returns new, or -EBADF.
fn lx_dup2(k: &mut Kernel, pid: u64, src: u64, new: u64, cloexec: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let v = fd_get(k.lxfd, pid, src) % FD_CLOEXEC;
  if v == 0 || new >= LXNFD {
    return EBADF;
  }
  if src == new {
    return new;
  }
  lx_fd_close(&mut k, pid, new);
  ref_value(&mut k, v);
  if cloexec {
    fd_set(&mut k.lxfd, pid, new, v + FD_CLOEXEC);
  } else {
    fd_set(&mut k.lxfd, pid, new, v);
  }
  return new;
}

/// dup(src) and fcntl F_DUPFD: the lowest closed descriptor >= from.
fn lx_dup(k: &mut Kernel, pid: u64, src: u64, from: u64, cloexec: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let v = fd_get(k.lxfd, pid, src) % FD_CLOEXEC;
  if v == 0 {
    return EBADF;
  }
  if from >= LXNFD {
    return EINVAL;
  }
  let fd = fd_free(k.lxfd, pid, from);
  if fd >= LXNFD {
    return EMFILE;
  }
  return lx_dup2(&mut k, pid, src, fd, cloexec);
}

fn lx_fcntl(k: &mut Kernel, pid: u64, fd: u64, cmd: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let v = fd_get(k.lxfd, pid, fd);
  if v == 0 {
    return EBADF;
  }
  if cmd == F_DUPFD || cmd == F_DUPFD_CLOEXEC {
    return lx_dup(&mut k, pid, fd, arg, cmd == F_DUPFD_CLOEXEC);
  }
  if cmd == F_GETFD {
    return v / FD_CLOEXEC;
  }
  if cmd == F_SETFD {
    fd_set(&mut k.lxfd, pid, fd, v % FD_CLOEXEC + FD_CLOEXEC * (arg % 2));
    return 0;
  }
  let h = fd_ofd(k, pid, fd);
  let mut kind = OF_FREE;
  if h < OFD_N {
    kind = of_get(k.ofd, h, 0);
  }
  let pipe = h < OFD_N && can_block(kind);
  let mut row = FD_ROWS;
  if h < OFD_N && kind == OF_FILE {
    row = of_get(k.ofd, h, 2);
  }
  if cmd == F_GETFL && row < FD_ROWS {
    let m = fget(k.fs.ftab, row, FD_MODE);
    let mut fl = 0;                         // O_RDONLY
    if m / O_WRITE % 2 == 1 {
      fl = LO_WRONLY;
      if m / O_READ % 2 == 1 {
        fl = LO_RDWR;
      }
    }
    if m / O_APPEND % 2 == 1 {
      fl = fl + LO_APPEND;
    }
    return fl + of_get(k.ofd, h, 3) % 2 * LO_NONBLOCK;
  }
  if cmd == F_SETFL && row < FD_ROWS {
    // O_APPEND takes effect; O_NONBLOCK is only reported back (a file never blocks).
    let m = fget(k.fs.ftab, row, FD_MODE);
    let mut nm = m % O_APPEND;              // O_TRUNC and O_CREATE only matter at open
    if arg / LO_APPEND % 2 == 1 {
      nm = nm + O_APPEND;
    }
    fset(&mut k.fs.ftab, row, FD_MODE, nm);
    of_set(&mut k.ofd, h, 3, arg / LO_NONBLOCK % 2);
    return 0;
  }
  if cmd == F_GETFL {
    if !pipe {
      return LO_RDWR;
    }
    let mut fl = 0;                         // O_RDONLY
    if kind == OF_PIPE_W {
      fl = LO_WRONLY;
    }
    if kind == OF_EVENT || kind == OF_TIMER || kind == OF_EPOLL || kind == OF_SIGFD {
      fl = LO_RDWR;
    }
    if of_get(k.ofd, h, 3) % 2 == 1 {
      fl = fl + LO_NONBLOCK;
    }
    return fl;
  }
  if cmd == F_SETFL {
    // O_NONBLOCK on a pipe end (or eventfd, timerfd, epoll) can change; no
    // other flag (O_APPEND) can.
    if pipe {
      of_set(&mut k.ofd, h, 3, of_get(k.ofd, h, 3) / 2 * 2 + arg / LO_NONBLOCK % 2);
    }
    return 0;
  }
  let lock = cmd == F_SETLK || cmd == F_SETLKW || cmd == F_OFD_SETLK || cmd == F_OFD_SETLKW;
  let fk = fd_look(k, pid, fd);
  if (cmd == F_GETLK || cmd == F_OFD_GETLK || lock) && fk.kind == K_FILE {
    return lx_fcntl_lock(&mut k, pid, fd, cmd, arg);   // src/lxlock.bastio
  }
  if cmd == F_GETLK || cmd == F_OFD_GETLK {
    // Only files keep locks: nothing stands in the way on anything else,
    // so l_type (a short at the start of struct flock) says F_UNLCK.
    xfer_u64(&mut k.fs.xfer, 0, F_UNLCK);
    return lx_put_out(&mut k, pid, arg, 2);
  }
  if lock {
    return 0;                               // accepted, not kept
  }
  return EINVAL;
}

/// pipe2(fds, flags): a new pipe, its read end in fds[0] and write end in
/// fds[1] (two 32-bit ints). Returns 0 or -errno.
fn lx_pipe(k: &mut Kernel, pid: u64, fds: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut p = 0;
  while p < NPIPES && (pi_get(k.pipes, p, 2) != 0 || pi_get(k.pipes, p, 3) != 0)
    invariant p <= NPIPES
  {
    p = p + 1;
  }
  if p >= NPIPES {
    return ENFILE;
  }
  let r = fd_free(k.lxfd, pid, 0);
  if r >= LXNFD {
    return EMFILE;
  }
  let w = fd_free(k.lxfd, pid, r + 1);
  if w >= LXNFD {
    return EMFILE;
  }
  lx_fill(&mut k, 0, 8);
  bset(&mut k.fs.xfer, 0, cast[u8](r));
  bset(&mut k.fs.xfer, 4, cast[u8](w));
  if lx_put_out(&mut k, pid, fds, 8) != 0 {
    return EFAULT;
  }
  let hr = ofd_new(&mut k, OF_PIPE_R, p);
  if hr >= OFD_N {
    return ENFILE;
  }
  let hw = ofd_new(&mut k, OF_PIPE_W, p);
  if hw >= OFD_N {
    unref_value(&mut k, FD_OFD + hr);
    return ENFILE;
  }
  pi_set(&mut k.pipes, p, 0, 0);
  pi_set(&mut k.pipes, p, 1, 0);
  pi_set(&mut k.pipes, p, 2, 1);
  pi_set(&mut k.pipes, p, 3, 1);
  pi_set(&mut k.pipes, p, 4, 0);
  pi_set(&mut k.pipes, p, 5, 1);
  of_set(&mut k.ofd, hr, 3, flags / LO_NONBLOCK % 2);
  of_set(&mut k.ofd, hw, 3, flags / LO_NONBLOCK % 2);
  let mut ce = 0;
  if flags / LO_CLOEXEC % 2 == 1 {
    ce = FD_CLOEXEC;
  }
  fd_set(&mut k.lxfd, pid, r, FD_OFD + hr + ce);
  fd_set(&mut k.lxfd, pid, w, FD_OFD + hw + ce);
  return 0;
}

/// Reads up to n bytes from pipe p to user address va. Returns the count,
/// 0 at end of file (no writer left), or EAGAIN if the caller must wait.
fn pipe_read(k: &mut Kernel, pid: u64, p: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && p < NPIPES
  ensures kok(k)
{
  let count = smaller(pi_get(k.pipes, p, 1), PIPE_CAP);
  if count == 0 {
    if pi_get(k.pipes, p, 3) == 0 && pi_get(k.pipes, p, 5) != 0 {
      return 0;                             // every writer has gone
    }
    return EAGAIN;                          // (a FIFO no writer has opened yet waits for one)
  }
  if n == 0 {
    return 0;
  }
  let want = smaller(smaller(n, count), XFER);
  let head = pi_get(k.pipes, p, 0) % PIPE_CAP;
  ring_out(&mut k.fs.xfer, 0, k.pipebuf, p * PIPE_CAP, PIPE_CAP, head, want);
  let put = copy_to_user(&mut k.spaces, pid, va, k.fs.xfer, want);
  if put == NO_RESULT || (put == 0 && want > 0) {
    return EFAULT;
  }
  pi_set(&mut k.pipes, p, 0, (head + put) % PIPE_CAP);
  pi_set(&mut k.pipes, p, 1, count - put);
  return put;
}

/// Writes up to n bytes from user address va into pipe p. Returns the
/// count, -EPIPE with no reader left, or EAGAIN if the pipe is full. A
/// write of PIPE_ATOM bytes or fewer goes in whole or not at all, so
/// writers sharing a pipe never interleave inside one (POSIX PIPE_BUF).
fn pipe_write(k: &mut Kernel, pid: u64, p: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && p < NPIPES
  ensures kok(k)
{
  if pi_get(k.pipes, p, 2) == 0 {
    return EPIPE;
  }
  if n == 0 {
    return 0;
  }
  let count = smaller(pi_get(k.pipes, p, 1), PIPE_CAP);
  let room = PIPE_CAP - count;
  if room == 0 || (n <= PIPE_ATOM && room < n) {
    return EAGAIN;
  }
  let got = copy_from_user(&mut k.spaces, pid, va, &mut k.fs.xfer, smaller(smaller(n, room), XFER));
  if got == NO_RESULT || (got == 0 && n > 0) {
    return EFAULT;
  }
  let head = pi_get(k.pipes, p, 0) % PIPE_CAP;
  ring_in(&mut k.pipebuf, p * PIPE_CAP, PIPE_CAP, (head + count) % PIPE_CAP, k.fs.xfer, 0, got);
  pi_set(&mut k.pipes, p, 1, count + got);
  return got;
}

/// Copies n bytes out of the ring buffer src[base .. base + cap], starting
/// at position `from` and wrapping at the end, into dst from index d.
fn ring_out(dst: &mut Bytes, d: u64, src: &Bytes, base: u64, cap: u64, from: u64, n: u64)
  requires from < cap && n <= cap && base + cap <= blen(src) && d + n <= blen(dst)
  ensures blen(dst) == old(blen(dst))
{
  let first = smaller(n, cap - from);
  bcopy(&mut dst, d, src, base + from, first);
  bcopy(&mut dst, d + first, src, base, n - first);
}

/// Copies src[s .. s + n] into the ring buffer dst[base .. base + cap],
/// from position `at`, wrapping at the end.
fn ring_in(dst: &mut Bytes, base: u64, cap: u64, at: u64, src: &Bytes, s: u64, n: u64)
  requires at < cap && n <= cap && base + cap <= blen(dst) && s + n <= blen(src)
  ensures blen(dst) == old(blen(dst))
{
  let first = smaller(n, cap - at);
  bcopy(&mut dst, base + at, src, s, first);
  bcopy(&mut dst, base, src, s + first, n - first);
}

/// Makes process `pid` run system call `n` again later: a wait.
fn lx_retry(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let rip = pget(k.procs, pid, F_REGS + R_RIP);
  if rip < 2 {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  pset(&mut k.procs, pid, F_REGS + R_RIP, rip - 2);
  pset(&mut k.procs, pid, F_REGS + R_RAX, n);
  pset(&mut k.procs, pid, F_RESTART, 1);
  return SWITCH;
}

/// Blocks process pid until the console's ring has room (`wake_writers`),
/// then restarts its system call n, as lx_retry does.
fn con_block(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r = lx_retry(&mut k, pid, n);
  if r == SWITCH {
    pset(&mut k.procs, pid, F_STATE, CONWAIT);
  }
  return r;
}

/// Makes every process waiting for room in the console's ring READY.
fn wake_writers(procs: &mut Buf)
  requires len(procs) == PTAB_LEN
  ensures len(procs) == PTAB_LEN
{
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && len(procs) == PTAB_LEN
  {
    if state(procs, p) == CONWAIT {
      pset(&mut procs, p, F_STATE, READY);
    }
    p = p + 1;
  }
}
