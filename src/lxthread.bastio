// Linux threads: clone with CLONE_THREAD, futex, set_tid_address, and the
// way exit and exit_group end them.
//
// A thread is a process row of its own (its id is the thread id) whose
// F_TGID names the group's leader; the leader's F_TGID names itself. The
// threads of a group share one address space, one descriptor table, one
// working directory, one set of signal actions and one alarm. These are
// linear, so they cannot be in two rows at once: they live in the row of
// the group's *holder*, and move to a thread before it runs (group_take),
// the way vfork moves a parent's space to its child. The other rows of
// the group keep theirs empty.
//
// The address space is not taken out while a thread runs: each processor
// running a thread of the group holds a lease on it (main.bastio), so the
// threads of a group run on several processors at once. The rest of the
// shared state is used only under the kernel lock, by whichever member's
// trap is being handled: `finish` moves it to that member first.
//
// Futexes are known by their address within the thread group, or, when
// the word is on a shared page (MAP_SHARED) and the call is not
// FUTEX_PRIVATE_FLAG, by the page itself, so processes meet there.
//
// What is left out: the leader calling exit while other threads run (it ends the
// whole group, as exit_group), execve from a thread other than the leader
// (EINVAL), wait4 for the children of another thread of the group.

const FUTEX_WAIT: u64 = 0;
const FUTEX_WAKE: u64 = 1;
const FUTEX_REQUEUE: u64 = 3;
const FUTEX_CMP_REQUEUE: u64 = 4;
const FUTEX_WAIT_BITSET: u64 = 9;
const FUTEX_WAKE_BITSET: u64 = 10;
const FUTEX_WOKEN: u64 = 1;         // F_FUTEX of a timed waiter woken on a processor (futex_wake)
const FUTEX_CLOCK_REALTIME: u64 = 256;
const FUTEX_CMD: u64 = 127;
const FUTEX_PRIVATE: u64 = 128;
const FUTEX_PHYS: u64 = 0x8000000000000000;   // keys of futexes on shared pages          // the rest: FUTEX_PRIVATE_FLAG, FUTEX_CLOCK_REALTIME
const ETIMEDOUT: u64 = 18446744073709551506;   // 2^64 - 110

const CLONE_SIGHAND: u64 = 0x800;
const CLONE_SETTLS: u64 = 0x80000;
const CLONE_PARENT_SETTID: u64 = 0x100000;
const CLONE_CHILD_CLEARTID: u64 = 0x200000;
const CLONE_CHILD_SETTID: u64 = 0x1000000;
const CLONE_PARENT: u64 = 0x8000;
const CLONE_SYSVSEM: u64 = 0x40000;
const CLONE_DETACHED: u64 = 0x400000;
const CLONE_IO: u64 = 0x80000000;


/// The leader of p's thread group: p itself for a process without threads.
fn tgid(procs: &Buf, p: u64) -> u64
  requires ptab_ok(procs) && p < NPROC
  ensures result < NPROC
{
  let g = pget(procs, p, F_TGID);
  if g == 0 || g >= NPROC {
    return p;
  }
  return g;
}

/// q is a live member of the thread group led by g (g itself included).
fn in_group(procs: &Buf, q: u64, g: u64) -> bool
  requires ptab_ok(procs) && q < NPROC
{
  return q != 0 && state(procs, q) != FREE && pget(procs, q, F_TGID) != 0 && pget(procs, q, F_TGID) == g;
}

fn has_space(spaces: &mut Vec[Space], p: u64) -> bool
  requires spaces_ok(spaces) && p < NPROC
  ensures spaces_ok(spaces)
{
  match take_space(&mut spaces, p) {
    Space::Empty => { return false; },
    Space::Mapped(t) => {
      put_space(&mut spaces, p, Space::Mapped(t));
      return true;
    },
  }
}

/// The member of group g that holds the group's address space, or 0 if
/// none does now (one is on a processor, or lent it to a vfork child).
fn holder(k: &mut Kernel, g: u64) -> u64
  requires kok(k)
  ensures kok(k) && result < NPROC
{
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if in_group(k.procs, q, g) && has_space(&mut k.spaces, q) {
      return q;
    }
    q = q + 1;
  }
  return 0;
}

/// Whether q waits for the rest of its group to leave the processors
/// (F_QUIET), and is still retrying the call that needs it. A mark left
/// behind by a thread that has since blocked, died or moved on to another
/// call stops nobody.
fn quieting(procs: &Buf, q: u64) -> bool
  requires ptab_ok(procs) && q < NPROC
{
  let st = state(procs, q);
  let n = pget(procs, q, F_REGS + R_RAX);       // the call it will run again (lx_retry)
  let remap = n == LX_MUNMAP || n == LX_MPROTECT || n == LX_MREMAP || n == LX_MMAP;
  return pget(procs, q, F_QUIET) != 0 && pget(procs, q, F_RESTART) != 0 && remap && (st == READY || st == RUNNING);
}

/// Whether thread p can run now: it is not in a group, or its group is
/// not ending (no member is KILLED) and one of them holds the address
/// space (none does while the group has lent it to a vfork child), and no other
/// member waits for the group to leave the processors (quieting) ahead of p.
fn group_free(k: &mut Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  if pget(k.procs, p, F_TGID) == 0 {
    return true;
  }
  let g = tgid(k.procs, p);
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if in_group(k.procs, q, g) && state(k.procs, q) == KILLED {
      return false;
    }
    // Of two threads waiting at once (two munmaps), the lower one goes
    // first; the other waits with the rest.
    if q != p && in_group(k.procs, q, g) && quieting(k.procs, q) && (q < p || !quieting(k.procs, p)) {
      return false;
    }
    q = q + 1;
  }
  return holder(&mut k, g) != 0;
}

/// pick (src/proc.bastio), skipping threads whose group cannot run now.
fn lx_pick(k: &mut Kernel, from: u64) -> u64
  requires kok(k)
  ensures kok(k) && result < NPROC
{
  let mut i = 0;
  while i < NPROC
    invariant i <= NPROC && kok(k)
  {
    let p = (from % NPROC + i) % NPROC;
    if p != 0 && state(k.procs, p) == READY && group_free(&mut k, p) {
      return p;
    }
    i = i + 1;
  }
  return 0;
}

/// Swaps n words at a and b of buffer t.
fn swap_words(t: &mut Buf, a: u64, b: u64, n: u64)
  requires a + n <= len(t) && b + n <= len(t)
  ensures len(t) == old(len(t))
{
  let mut i = 0;
  while i < n
    invariant i <= n && a + n <= len(t) && b + n <= len(t)
  {
    let x = get(t, a + i);
    t = set(t, a + i, get(t, b + i));
    t = set(t, b + i, x);
    i = i + 1;
  }
}

/// Moves what the threads of a group share from member h to member p:
/// the address space, descriptors, working directory, signal actions,
/// alarm, and the break and mmap floor. False, with nothing moved, if h
/// has no space or p already has one.
fn group_move(k: &mut Kernel, mmu: &Mmu, h: u64, p: u64) -> bool
  requires kok(k) && h < NPROC && p < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  if h == p {
    return true;
  }
  if has_space(&mut k.spaces, p) {
    return false;
  }
  match take_space(&mut k.spaces, h) {
    Space::Empty => { return false; },
    Space::Mapped(t) => { restore_space(&mut k.mem, &mut k.spaces, mmu, p, Space::Mapped(t)); },
  }
  pset(&mut k.procs, p, F_BRK, pget(k.procs, h, F_BRK));
  pset(&mut k.procs, p, F_BRK0, pget(k.procs, h, F_BRK0));
  pset(&mut k.procs, p, F_MMAP, pget(k.procs, h, F_MMAP));
  pset(&mut k.procs, p, F_PROG, pget(k.procs, h, F_PROG));
  if (h + 1) * LXNFD <= len(k.lxfd) && (p + 1) * LXNFD <= len(k.lxfd) {
    swap_words(&mut k.lxfd, h * LXNFD, p * LXNFD, LXNFD);
  }
  if (h + 1) * CWD_STRIDE <= len(k.cwd) && (p + 1) * CWD_STRIDE <= len(k.cwd) {      // live processes have rows
    swap_words(&mut k.cwd, h * CWD_STRIDE, p * CWD_STRIDE, CWD_STRIDE);
  }
  if (h + 1) * CWD_STRIDE <= len(k.croot) && (p + 1) * CWD_STRIDE <= len(k.croot) {
    swap_words(&mut k.croot, h * CWD_STRIDE, p * CWD_STRIDE, CWD_STRIDE);
  }
  swap_words(&mut k.mns, h, p, 1);
  nsk_swap(&mut k.mns, h, p);
  if (h + 1) * SIGACT_ROW <= len(k.sigact) && (p + 1) * SIGACT_ROW <= len(k.sigact) {
    swap_words(&mut k.sigact, h * SIGACT_ROW, p * SIGACT_ROW, SIGACT_ROW);
  }
  swap_words(&mut k.alarms, h * 2, p * 2, 2);
  swap_words(&mut k.maps, h * MAP_N * MAP_W, p * MAP_N * MAP_W, MAP_N * MAP_W);
  swap_words(&mut k.holes, h * HOLE_N * 2, p * HOLE_N * 2, HOLE_N * 2);
  swap_words(&mut k.lazy, h * LZ_W, p * LZ_W, LZ_W);
  swap_words(&mut k.anon, h * AN_N * 2, p * AN_N * 2, AN_N * 2);
  swap_words(&mut k.alarms, PT_BASE + h * PT_N * PT_W, PT_BASE + p * PT_N * PT_W, PT_N * PT_W);
  return true;
}

/// Before thread p runs: brings the group's shared state to it.
fn group_take(k: &mut Kernel, mmu: &Mmu, p: u64)
  requires kok(k) && p < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  if pget(k.procs, p, F_TGID) == 0 || has_space(&mut k.spaces, p) {
    return;
  }
  let h = holder(&mut k, tgid(k.procs, p));
  if h != 0 {
    let moved = group_move(&mut k, mmu, h, p);
  }
}

/// Frees the row of thread q, which holds none of the group's shared
/// state. Its children become the leader g's.
fn thread_free(k: &mut Kernel, mmu: &Mmu, q: u64, g: u64)
  requires kok(k) && 1 <= q && q < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  match take_space(&mut k.spaces, q) {
    Space::Empty => {},
    Space::Mapped(t) => { free_space(&mut k.mem, mmu, t); },
  }
  drop_fpu(&mut k.mem, take_fpu(&mut k.fpus, q));
  lx_fd_close_all(&mut k, q, false);
  let mut c = 1;
  while c < NPROC
    invariant 1 <= c && c <= NPROC && kok(k)
  {
    if pget(k.procs, c, F_PARENT) == q && state(k.procs, c) != FREE {
      pset(&mut k.procs, c, F_PARENT, g);
    }
    c = c + 1;
  }
  pr_clear(&mut k, q);
  pset(&mut k.procs, q, F_TGID, 0);
  pset(&mut k.procs, q, F_CTID, 0);
  pset(&mut k.procs, q, F_FUTEX, 0);
  pset(&mut k.procs, q, F_SIGPEND, 0);
  pset(&mut k.procs, q, F_RESTART, 0);
  pset(&mut k.procs, q, F_STATE, FREE);
}

/// For terminate (src/proc.bastio): process `p` ends. If it is one thread
/// of a group, the whole group ends: the shared state goes to the leader,
/// every other thread is freed, and the leader is returned to be ended as
/// a process. Returns p for a process without threads, and 0 if members
/// are on other processors: they are marked KILLED, and the group ends when
/// the last of them comes back.
fn group_end(k: &mut Kernel, mmu: &Mmu, p: u64) -> u64
  requires kok(k) && 1 <= p && p < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k) && result < NPROC
{
  if pget(k.procs, p, F_TGID) == 0 {
    return p;
  }
  let g = tgid(k.procs, p);
  if g == 0 {
    pset(&mut k.procs, p, F_TGID, 0);
    return p;
  }
  let mut busy = false;
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if q != p && in_group(k.procs, q, g) {
      let st = state(k.procs, q);
      if st == RUNNING || st == EXITING {
        pset(&mut k.procs, q, F_STATE, KILLED);
      }
      if st == RUNNING || st == EXITING || st == KILLED {
        busy = true;
      }
    }
    q = q + 1;
  }
  if busy {
    return 0;
  }
  let h = holder(&mut k, g);
  if h != 0 {
    let moved = group_move(&mut k, mmu, h, g);
  }
  let mut r = 1;
  while r < NPROC
    invariant 1 <= r && r <= NPROC && kok(k)
  {
    if r != g && in_group(k.procs, r, g) {
      thread_free(&mut k, mmu, r, g);
    }
    r = r + 1;
  }
  pset(&mut k.procs, g, F_TGID, 0);
  pset(&mut k.procs, g, F_CTID, 0);
  if state(k.procs, g) == FREE || state(k.procs, g) == ZOMBIE {
    return 0;
  }
  return g;
}

// ---------------------------------------------------------------- user words

/// The 32-bit word at user address va of process pid; ok false if it is
/// not mapped.
fn user_u32(k: &mut Kernel, pid: u64, va: u64) -> Word
  requires kok(k) && pid < NPROC
  ensures kok(k) && result.v < 0x100000000
{
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, 4) != 4 {
    return Word { ok: false, v: 0 };
  }
  return Word { ok: true, v: rd32(k.fs.xfer, 0) };
}

fn put_user_u32(k: &mut Kernel, pid: u64, va: u64, v: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  xfer_u64(&mut k.fs.xfer, 0, v % 0x100000000);
  return copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, 4) == 4;
}

// ---------------------------------------------------------------- clone

/// clone(flags, stack, ptid, ctid, tls) with CLONE_THREAD: a new thread
/// of pid's group, running pid's code on `stack`. Returns its id, or
/// -errno.
fn lx_thread_clone(k: &mut Kernel, pid: u64, flags: u64, stack: u64, ptid: u64, ctid: u64, tls: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  if flags & CLONE_VM == 0 || flags & CLONE_SIGHAND == 0 || flags & CLONE_VFORK != 0 {
    return EINVAL;
  }
  if !cow_break_all(&mut k, pid) {
    return ENOMEM;                          // its copy-on-write pages need copies first (src/lxcow.bastio)
  }
  let c = new_pid(&mut k);
  if c == 0 {
    return EAGAIN;
  }
  pidfd_reuse(&mut k, c);                   // pidfds on the slot's last process (src/lxpidfd.bastio)
  if has_space(&mut k.spaces, c) {
    return EAGAIN;                          // a FREE row has no space; check it
  }
  hole_clear(&mut k, c);                    // the group's holes stay with its holder
  anon_clear(&mut k, c);
  lazy_clear(&mut k, c);
  let fp = find_free(&mut k.mem);
  if fp >= NPAGES {
    return ENOMEM;
  }
  let mut fpu = take_page(&mut k.mem, fp);
  match take_fpu(&mut k.fpus, pid) {
    Fpu::None => {},
    Fpu::State(f) => {
      copy_frame(&mut fpu, f);
      put_fpu(&mut k.fpus, pid, Fpu::State(f));
    },
  }
  drop_fpu(&mut k.mem, take_fpu(&mut k.fpus, c));
  put_fpu(&mut k.fpus, c, Fpu::State(fpu));
  let g = tgid(k.procs, pid);
  pset(&mut k.procs, g, F_TGID, g);
  let mut f = 0;
  while f < STRIDE
    invariant f <= STRIDE && kok(k)
  {
    pset(&mut k.procs, c, f, pget(k.procs, pid, f));
    f = f + 1;
  }
  pset(&mut k.procs, c, F_WAIT, 0);
  pset(&mut k.procs, c, F_CODE, 0);
  pset(&mut k.procs, c, F_TICKS, 0);
  pset(&mut k.procs, c, F_PARENT, 0);       // threads are nobody's children
  pr_fork(&mut k, pid, c);
  pset(&mut k.procs, c, F_ALTSIZE, 0);      // nor have an alternate signal stack
  pset(&mut k.procs, c, F_VTIMER, 0);       // the CPU-time timers belong to the leader
  pset(&mut k.procs, c, F_PTIMER, 0);
  pset(&mut k.procs, c, F_QUIET, 0);
  group_fork(&mut k.procs, pid, c);
  pset(&mut k.procs, c, F_REGS + R_RAX, 0);
  if stack != 0 {
    pset(&mut k.procs, c, F_REGS + R_RSP, stack);
  }
  if flags & CLONE_SETTLS != 0 {
    pset(&mut k.procs, c, F_REGS + R_FSBASE, tls);
  }
  pset(&mut k.procs, c, F_SIGPEND, 0);
  pset(&mut k.procs, c, F_RESTART, 0);
  pset(&mut k.procs, c, F_TGID, g);
  pset(&mut k.procs, c, F_FUTEX, 0);
  pset(&mut k.procs, c, F_CTID, 0);
  if flags & CLONE_CHILD_CLEARTID != 0 {
    pset(&mut k.procs, c, F_CTID, ctid);
  }
  // The caller holds the shared space now: the ids go in through it.
  if flags & CLONE_PARENT_SETTID != 0 && !put_user_u32(&mut k, pid, ptid, c) {
    pset(&mut k.procs, c, F_STATE, READY);
    return c;
  }
  if flags & CLONE_CHILD_SETTID != 0 {
    let ok = put_user_u32(&mut k, pid, ctid, c);
  }
  pset(&mut k.procs, c, F_STATE, READY);
  return c;
}

/// The clone flags a new process (not a thread, not a vfork) may carry:
/// the exit signal, CLONE_PARENT, the tid and TLS flags, and the ones
/// that change nothing here (CLONE_SYSVSEM, CLONE_DETACHED, CLONE_IO).
/// CLONE_NEWNS, CLONE_NEWUTS and CLONE_NEWIPC give the child a mount, UTS
/// or IPC namespace of its own. Sharing files, the cwd, signal handlers or
/// memory with a separate process, and the other namespaces, are not
/// supported.
fn clone_proc_flags(flags: u64) -> bool {
  let known = 0xff + CLONE_PARENT + CLONE_SYSVSEM + CLONE_SETTLS + CLONE_PARENT_SETTID
    + CLONE_CHILD_CLEARTID + CLONE_DETACHED + CLONE_CHILD_SETTID + CLONE_IO + CLONE_NEWNS
    + CLONE_NEWUTS + CLONE_NEWIPC;
  return flags & known == flags;
}

/// clone(flags, stack, ptid, ctid, tls) that makes a new process: fork,
/// then the child starts on `stack` (if not 0) with the flags' extras.
/// With CLONE_PARENT the child is its parent's sibling. Returns the
/// child's pid, or -errno.
fn lx_clone_proc(k: &mut Kernel, mmu: &Mmu, pid: u64, flags: u64, stack: u64, ptid: u64, ctid: u64, tls: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let mut par = pid;
  if flags & CLONE_PARENT != 0 {
    par = pget(k.procs, tgid(k.procs, pid), F_PARENT);
    if par == 0 || par >= NPROC {
      return EINVAL;                        // init has no parent to share
    }
  }
  let nsf = flags & (CLONE_NEWNS + CLONE_NEWUTS + CLONE_NEWIPC);
  if nsf != 0 && !cap_has(k, pid, CAP_SYS_ADMIN) {
    return EPERM;
  }
  if flags & CLONE_NEWNS != 0 && !ns_room(&mut k, pid) {
    return ENOMEM;
  }
  if flags & CLONE_NEWUTS != 0 && !uts_room(&mut k) {
    return ENOMEM;
  }
  let c = lx_fork(&mut k, mmu, pid);
  if c == 0 || c >= NPROC {
    return c;
  }
  if flags & CLONE_NEWNS != 0 {
    let e = ns_unshare(&mut k, c);          // cannot fail: ns_room said so
  }
  let e2 = nsk_unshare(&mut k, c, flags);   // nor this: uts_room did (src/lxnsk.bastio)
  pset(&mut k.procs, c, F_PARENT, par);
  if stack != 0 {
    pset(&mut k.procs, c, F_REGS + R_RSP, stack);
  }
  if flags & CLONE_SETTLS != 0 {
    pset(&mut k.procs, c, F_REGS + R_FSBASE, tls);
  }
  if flags & CLONE_CHILD_CLEARTID != 0 {
    pset(&mut k.procs, c, F_CTID, ctid);
  }
  // The child has its own copy of the space now: CLONE_PARENT_SETTID
  // writes into both, CLONE_CHILD_SETTID into the child's.
  if flags & CLONE_PARENT_SETTID != 0 {
    let a = put_user_u32(&mut k, pid, ptid, c);
    let b = put_user_u32(&mut k, c, ptid, c);
  }
  if flags & CLONE_CHILD_SETTID != 0 {
    let d = put_user_u32(&mut k, c, ctid, c);
  }
  return c;
}

const CLONE_FS: u64 = 0x200;
const CLONE_FILES: u64 = 0x400;
// CLONE_NEWNS, NEWCGROUP, NEWUTS, NEWIPC, NEWUSER, NEWPID, NEWNET and
// NEWTIME: the namespaces.
const CLONE_NEWALL: u64 = 0x7e020080;

/// unshare(flags). A process (not a thread group) shares nothing with
/// another one here, so unsharing its files, cwd, memory, signal handlers
/// or semaphore undo list changes nothing. CLONE_NEWNS, CLONE_NEWUTS and
/// CLONE_NEWIPC give it a mount, UTS or IPC namespace of its own
/// (src/lxns.bastio, src/lxnsk.bastio). The other namespaces are not
/// supported: EINVAL, as on a Linux built without them, or EPERM for one
/// that only root may make.
fn lx_unshare(k: &mut Kernel, pid: u64, flags: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let share = CLONE_VM + CLONE_FS + CLONE_FILES + CLONE_SIGHAND + CLONE_THREAD + CLONE_SYSVSEM;
  if flags & (share + CLONE_NEWALL) != flags {
    return EINVAL;
  }
  let ns = flags & CLONE_NEWALL;
  if ns != 0 {
    if ns & CLONE_NEWUSER != ns && !cap_has(k, pid, CAP_SYS_ADMIN) {
      return EPERM;
    }
    if ns & (CLONE_NEWNS + CLONE_NEWNET + CLONE_NEWUTS + CLONE_NEWIPC) != ns {
      return EINVAL;                        // only mount, network, UTS and IPC namespaces so far
    }
  }
  if flags != ns && pget(k.procs, pid, F_TGID) != 0 {
    return EINVAL;                          // threads that share them: not supported
  }
  if ns & CLONE_NEWNS != 0 && ns & (CLONE_NEWNET + CLONE_NEWUTS + CLONE_NEWIPC) != 0 && !ns_room(&mut k, pid) {
    return ENOMEM;                          // so the others are not made alone
  }
  if ns & CLONE_NEWUTS != 0 && !uts_room(&mut k) {
    return ENOMEM;
  }
  if ns & CLONE_NEWNET != 0 {
    let e = netns_unshare(&mut k, pid);     // src/lxnetlink.bastio
    if e != 0 {
      return e;
    }
  }
  if ns & CLONE_NEWNS != 0 {
    let e = ns_unshare(&mut k, pid);        // src/lxns.bastio
    if e != 0 {
      return e;
    }
  }
  return nsk_unshare(&mut k, pid, ns);      // src/lxnsk.bastio
}

/// exit(code) from thread pid of a group, not its leader: clears and
/// wakes its clear_child_tid word (how pthread_join learns of it), hands
/// the shared state back to the leader and frees the row.
fn lx_thread_exit(k: &mut Kernel, mmu: &Mmu, pid: u64)
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let g = tgid(k.procs, pid);
  robust_exit(&mut k, pid);
  let ct = pget(k.procs, pid, F_CTID);
  if ct != 0 && put_user_u32(&mut k, pid, ct, 0) {
    let n = futex_wake(&mut k, pid, ct, 1);
  }
  if g == 0 || g == pid || !group_move(&mut k, mmu, pid, g) {
    terminate(&mut k, mmu, pid, 0);
    return;
  }
  thread_free(&mut k, mmu, pid, g);
}

/// Whether thread pid's exit ends only that thread.
fn thread_only(procs: &Buf, pid: u64) -> bool
  requires ptab_ok(procs) && pid < NPROC
{
  return pget(procs, pid, F_TGID) != 0 && tgid(procs, pid) != pid;
}

/// Before execve in process pid: its other threads end. Those on other
/// processors are marked EXITING and freed when they come back (finish in
/// main.bastio); until then execve waits (EXEC_WAIT: the caller runs it
/// again later).
fn thread_exec(k: &mut Kernel, mmu: &Mmu, pid: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  if pget(k.procs, pid, F_TGID) == 0 {
    return EXEC_GO;
  }
  if tgid(k.procs, pid) != pid {
    return EXEC_NO;
  }
  let mut busy = false;
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if q != pid && in_group(k.procs, q, pid) {
      let st = state(k.procs, q);
      if st == RUNNING || st == EXITING {
        pset(&mut k.procs, q, F_STATE, EXITING);
        busy = true;
      } else if st == KILLED {
        busy = true;                        // the group is ending anyway
      } else {
        thread_free(&mut k, mmu, q, pid);
      }
    }
    q = q + 1;
  }
  if busy {
    return EXEC_WAIT;
  }
  pset(&mut k.procs, pid, F_TGID, 0);
  return EXEC_GO;
}

// ---------------------------------------------------------------- futex

// A waiter is a thread whose futex call runs again later (lx_retry): its
// F_FUTEX is the address, and it is either FUTEXWAIT (no timeout), or
// TIMEWAIT or READY between tries of a wait with a timeout
// (src/lxtime.bastio's wait_until). A wake ends
// its call with 0 instead, as if it had returned.

fn futex_waiting(procs: &Buf, q: u64, g: u64, addr: u64) -> bool
  requires ptab_ok(procs) && q < NPROC
{
  let st = state(procs, q);
  return (st == FUTEXWAIT || st == TIMEWAIT || st == READY) && (g == 0 || tgid(procs, q) == g) && pget(procs, q, F_FUTEX) == addr
    && pget(procs, q, F_RESTART) != 0 && pget(procs, q, F_REGS + R_RAX) == LX_FUTEX;
}

/// Whether q is in a timed wait on addr in group g but on a processor right
/// now, between two tries of the call (a timed wait tries again each time
/// it is scheduled, src/lxtime.bastio's wait_until).
fn futex_polling(procs: &Buf, q: u64, g: u64, addr: u64) -> bool
  requires ptab_ok(procs) && q < NPROC
{
  return state(procs, q) == RUNNING && (g == 0 || tgid(procs, q) == g) && pget(procs, q, F_FUTEX) == addr
    && pget(procs, q, F_RESTART) >= 2 && pget(procs, q, F_REGS + R_RAX) == LX_FUTEX;
}

/// The key futex word addr of pid is known by (F_FUTEX of its waiters):
/// FUTEX_PHYS + its physical place if it is on a shared page and the call
/// is not private, otherwise addr itself, within pid's thread group.
fn futex_key(k: &mut Kernel, pid: u64, addr: u64, op: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if op & FUTEX_PRIVATE == 0 && addr < FUTEX_PHYS {
    let pg = user_shared_page(&mut k.spaces, k.mem.bm, pid, addr);
    if pg < NPAGES {
      return FUTEX_PHYS + pg * 4096 + addr % 4096;
    }
  }
  return addr;
}

/// The thread group whose waiters a key reaches: any (0) for a shared page.
fn futex_group(procs: &Buf, pid: u64, key: u64) -> u64
  requires ptab_ok(procs) && pid < NPROC
{
  if key >= FUTEX_PHYS {
    return 0;
  }
  return tgid(procs, pid);
}

/// Wakes up to n waiters on key (futex_key) that pid reaches; returns how
/// many.
fn futex_wake(k: &mut Kernel, pid: u64, addr: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k) && result <= NPROC
{
  let g = futex_group(k.procs, pid, addr);
  let mut woken = 0;
  let mut q = 1;
  while q < NPROC && woken < n
    invariant 1 <= q && q <= NPROC && woken <= n && woken < q && kok(k)
  {
    if q != pid && futex_polling(k.procs, q, g, addr) {
      // Its registers are live on another processor: leave it a note,
      // which its next try finds (lx_futex).
      pset(&mut k.procs, q, F_FUTEX, FUTEX_WOKEN);
      woken = woken + 1;
    } else if q != pid && futex_waiting(k.procs, q, g, addr) {
      let rip = pget(k.procs, q, F_REGS + R_RIP);
      if rip <= 0xFFFFFFFFFFFFFFF0 {
        pset(&mut k.procs, q, F_REGS + R_RIP, rip + 2);
      }
      pset(&mut k.procs, q, F_REGS + R_RAX, 0);
      pset(&mut k.procs, q, F_RESTART, 0);
      pset(&mut k.procs, q, F_FUTEX, 0);
      pset(&mut k.procs, q, F_STATE, READY);
      woken = woken + 1;
    }
    q = q + 1;
  }
  return woken;
}

/// Moves up to n waiters on key addr that pid reaches to wait on key to.
fn futex_requeue(k: &mut Kernel, pid: u64, addr: u64, to: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k) && result <= NPROC
{
  let g = futex_group(k.procs, pid, addr);
  let mut moved = 0;
  let mut q = 1;
  while q < NPROC && moved < n
    invariant 1 <= q && q <= NPROC && moved <= n && moved < q && kok(k)
  {
    // A timed waiter between two tries (futex_polling) keeps the key it
    // finds in F_FUTEX on its next try (lx_futex), so it moves too.
    if q != pid && (futex_waiting(k.procs, q, g, addr) || futex_polling(k.procs, q, g, addr)) {
      pset(&mut k.procs, q, F_FUTEX, to);
      moved = moved + 1;
    }
    q = q + 1;
  }
  return moved;
}

/// Whether the 4 bytes at addr of pid can be read.
fn user_mapped(k: &mut Kernel, pid: u64, addr: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let w = user_u32(&mut k, pid, addr);
  return w.ok;
}

/// futex(addr, op, val, timeout or val2, addr2, val3).
fn lx_futex(k: &mut Kernel, pid: u64, was: u64, addr: u64, op: u64, val: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let cmd = op & FUTEX_CMD;
  let arg4 = pget(k.procs, pid, F_REGS + R_R10);
  let addr2 = pget(k.procs, pid, F_REGS + R_R8);
  let val3 = pget(k.procs, pid, F_REGS + R_R9);
  if addr % 4 != 0 {
    ret(&mut k.procs, pid, EINVAL);
    return KEEP;
  }
  // A futex that is not private is known by its page, so as on Linux a
  // word that is not mapped (or PROT_NONE, which maps nothing) fails.
  if op & FUTEX_PRIVATE == 0 && (cmd == FUTEX_WAKE || cmd == FUTEX_WAKE_BITSET || cmd == FUTEX_REQUEUE || cmd == FUTEX_CMP_REQUEUE)
    && !user_mapped(&mut k, pid, addr) {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  let key = futex_key(&mut k, pid, addr, op);
  if cmd == FUTEX_WAKE || cmd == FUTEX_WAKE_BITSET {
    ret(&mut k.procs, pid, futex_wake(&mut k, pid, key, val));
    return KEEP;
  }
  if cmd == FUTEX_REQUEUE || cmd == FUTEX_CMP_REQUEUE {
    // The counts are ints: a negative one is refused.
    if val % 0x100000000 >= 0x80000000 || arg4 % 0x100000000 >= 0x80000000 {
      ret(&mut k.procs, pid, EINVAL);
      return KEEP;
    }
    if op & FUTEX_PRIVATE == 0 && !user_mapped(&mut k, pid, addr2) {
      ret(&mut k.procs, pid, EFAULT);
      return KEEP;
    }
    if cmd == FUTEX_CMP_REQUEUE {
      let w = user_u32(&mut k, pid, addr);
      if !w.ok {
        ret(&mut k.procs, pid, EFAULT);
        return KEEP;
      }
      if w.v != val3 % 0x100000000 {
        ret(&mut k.procs, pid, EAGAIN);
        return KEEP;
      }
    }
    if addr2 % 4 != 0 {
      ret(&mut k.procs, pid, EINVAL);
      return KEEP;
    }
    let key2 = futex_key(&mut k, pid, addr2, op);
    let woken = futex_wake(&mut k, pid, key, val);
    let moved = futex_requeue(&mut k, pid, key, key2, arg4 % 0x100000000);
    if cmd == FUTEX_CMP_REQUEUE {
      ret(&mut k.procs, pid, woken + moved);
    } else {
      ret(&mut k.procs, pid, woken);
    }
    return KEEP;
  }
  if cmd != FUTEX_WAIT && cmd != FUTEX_WAIT_BITSET {
    ret(&mut k.procs, pid, ENOSYS);
    return KEEP;
  }
  // A wait. Run again (was != 0), it is still waiting: no wake came, or
  // the wake would have ended the call. Only its deadline is checked.
  let mut dl = FOREVER;
  if was == 0 {
    let w = user_u32(&mut k, pid, addr);
    if !w.ok {
      ret(&mut k.procs, pid, EFAULT);
      return KEEP;
    }
    if w.v != val % 0x100000000 {
      ret(&mut k.procs, pid, EAGAIN);
      return KEEP;
    }
    if arg4 != 0 {
      let ts = ts_in(&mut k, pid, arg4);
      if ts.err != 0 {
        ret(&mut k.procs, pid, ts.err);
        return KEEP;
      }
      // FUTEX_WAIT's timeout is relative, FUTEX_WAIT_BITSET's absolute:
      // on CLOCK_MONOTONIC, which counts from boot, or with
      // FUTEX_CLOCK_REALTIME on the wall clock, which starts at k.epoch.
      if cmd == FUTEX_WAIT {
        dl = sat_add(k.ns, ts.ns);
      } else if op & FUTEX_CLOCK_REALTIME != 0 {
        if ts.ns > k.epoch {
          dl = ts.ns - k.epoch;
        } else {
          dl = 0;
        }
      } else {
        dl = ts.ns;
      }
    }
  } else if was >= 2 {
    if pget(k.procs, pid, F_FUTEX) == FUTEX_WOKEN {
      pset(&mut k.procs, pid, F_FUTEX, 0);  // woken while on a processor (futex_wake)
      ret(&mut k.procs, pid, 0);
      return KEEP;
    }
    dl = was - 2;
  }
  if dl < FOREVER {
    if k.ns >= dl {
      ret(&mut k.procs, pid, ETIMEDOUT);
      return KEEP;
    }
    let r = wait_until(&mut k, pid, LX_FUTEX, dl);
    // On a later try F_FUTEX may name another word: a requeue moved it.
    if was == 0 {
      pset(&mut k.procs, pid, F_FUTEX, key);
    }
    return r;
  }
  let r = lx_retry(&mut k, pid, LX_FUTEX);
  if r == SWITCH {
    if was == 0 {
      pset(&mut k.procs, pid, F_FUTEX, key);
    }
    pset(&mut k.procs, pid, F_STATE, FUTEXWAIT);
  }
  return r;
}

// ---------------------------------------------------------------- robust futexes

const ROBUST_HEAD: u64 = 24;               // sizeof(struct robust_list_head)
const ROBUST_LIMIT: u64 = 2048;            // entries walked at most, as Linux
const FUTEX_WAITERS: u64 = 0x80000000;
const FUTEX_OWNER_DIED: u64 = 0x40000000;
const FUTEX_TID_MASK: u64 = 0x3FFFFFFF;

/// set_robust_list(head, len): thread pid's list of held robust futexes,
/// which its exit walks (robust_exit). len must be the head's size.
fn lx_set_robust_list(k: &mut Kernel, pid: u64, head: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n != ROBUST_HEAD {
    return EINVAL;
  }
  k.sys = set(k.sys, SYS_RB + pid, head);
  return 0;
}

/// get_robust_list(target, head_ptr, len_ptr): target 0 is the caller.
fn lx_get_robust_list(k: &mut Kernel, pid: u64, target: u64, hp: u64, lp: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let mut t = pid;
  if target != 0 {
    t = target % 0x100000000;
  }
  if t >= NPROC || t == 0 || state(k.procs, t) == FREE {
    return ESRCH;
  }
  if !may_signal(k, pid, t, 0) {
    return EPERM;
  }
  xfer_u64(&mut k.fs.xfer, 0, get(k.sys, SYS_RB + t));
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, hp, k.fs.xfer, 8) != 8 {
    return EFAULT;
  }
  xfer_u64(&mut k.fs.xfer, 0, ROBUST_HEAD);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, lp, k.fs.xfer, 8) != 8 {
    return EFAULT;
  }
  return 0;
}

/// a + off, off a signed 64-bit offset; ok false if it wraps.
fn add_signed(a: u64, off: u64) -> Word {
  if off >= 0x8000000000000000 {
    let neg = 0xFFFFFFFFFFFFFFFF - off + 1;
    if a < neg {
      return Word { ok: false, v: 0 };
    }
    return Word { ok: true, v: a - neg };
  }
  if a > 0xFFFFFFFFFFFFFFFF - off {
    return Word { ok: false, v: 0 };
  }
  return Word { ok: true, v: a + off };
}

/// One robust futex word at uaddr, held by the dying thread pid: it gets
/// FUTEX_OWNER_DIED (keeping FUTEX_WAITERS), and one waiter wakes.
fn robust_one(k: &mut Kernel, pid: u64, uaddr: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let w = user_u32(&mut k, pid, uaddr);
  if !w.ok || w.v & FUTEX_TID_MASK != pid {
    return;
  }
  if put_user_u32(&mut k, pid, uaddr, (w.v & FUTEX_WAITERS) | FUTEX_OWNER_DIED) && w.v & FUTEX_WAITERS != 0 {
    let n = futex_wake(&mut k, pid, uaddr, 1);
  }
}

/// Thread pid is ending: walks its robust list, as Linux does, so that
/// the next owner of each futex it held sees FUTEX_OWNER_DIED.
fn robust_exit(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let head = get(k.sys, SYS_RB + pid);
  k.sys = set(k.sys, SYS_RB + pid, 0);
  if head == 0 || head > 0xFFFFFFFFFFFFFF00 {
    return;
  }
  let first = user_u64(&mut k.spaces, pid, head);
  let off = user_u64(&mut k.spaces, pid, head + 8);
  let pending = user_u64(&mut k.spaces, pid, head + 16);
  if !first.ok || !off.ok || !pending.ok {
    return;
  }
  let pend = pending.v / 2 * 2;             // bit 0 marks a PI futex
  let mut e = first.v / 2 * 2;
  let mut i = 0;
  while e != head && i < ROBUST_LIMIT
    invariant i <= ROBUST_LIMIT && kok(k)
  {
    let next = user_u64(&mut k.spaces, pid, e);
    if e != pend {
      let a = add_signed(e, off.v);
      if a.ok {
        robust_one(&mut k, pid, a.v);
      }
    }
    if !next.ok {
      i = ROBUST_LIMIT;
    } else {
      e = next.v / 2 * 2;
      i = i + 1;
    }
  }
  if pend != 0 {
    let a = add_signed(pend, off.v);
    if a.ok {
      robust_one(&mut k, pid, a.v);
    }
  }
}
