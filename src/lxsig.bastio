// Linux signals. Each process has a blocked set and a pending set (words
// F_SIGMASK and F_SIGPEND of its row, bit s - 1 for signal s) and an action
// per signal in k.sigact. A signal is posted by kill, by Ctrl-C on the
// console or by a write to a pipe with no reader, and delivered when the
// process is next picked to run (lx_deliver): the default action ends the
// process or ignores the signal, and a handler is entered on the user
// stack with the frame Linux builds (struct rt_sigframe: the return
// address, a ucontext with the saved registers and mask, a siginfo, and
// the x87/SSE state), which rt_sigreturn reads back.
//
// Nothing in a frame read back from user memory is trusted: the registers
// it restores are user registers, the flags keep only the arithmetic and
// direction bits, and the MXCSR keeps only bits fxrstor accepts.

import "linux.bastio";

const LX_RT_SIGRETURN: u64 = 15;
const LX_KILL: u64 = 62;
const LX_TKILL: u64 = 200;
const LX_TGKILL: u64 = 234;
const LX_RT_SIGQUEUEINFO: u64 = 129;
const LX_RT_SIGPENDING: u64 = 127;
const LX_SIGALTSTACK: u64 = 131;
const SS_ONSTACK: u64 = 1;
const SS_DISABLE: u64 = 2;
const MINSIGSTKSZ: u64 = 2048;
const SA_ONSTACK: u64 = 0x08000000;

const NSIG: u64 = 64;
const SIGINT: u64 = 2;
const SIGTRAP: u64 = 5;
const SIGILL: u64 = 4;
const SIGBUS: u64 = 7;
const SIGFPE: u64 = 8;
const SIGKILL: u64 = 9;
const SIGSEGV: u64 = 11;
const SIGCONT: u64 = 18;
const SIGSTOP: u64 = 19;
const SIGTSTP: u64 = 20;
const SIGTTIN: u64 = 21;
const SIGTTOU: u64 = 22;
const SIGURG: u64 = 23;
const SIGWINCH: u64 = 28;

// A sender word (k.sigsave) at or above this says the signal came from a
// processor exception at the address it holds less FAULT_MARK.
const FAULT_MARK: u64 = 0x8000000000000000;
// The sender word of a pending signal (k.sigsave): the sender's pid in the low 10 bits (below 1024, past
// NPROC), SW_QUEUE when sigqueue carried a value, the value times SW_VAL above it.
const SW_PID: u64 = 1024;
const SW_QUEUE: u64 = 1024;
const SW_VAL: u64 = 2048;
const MESGQ_MARK: u64 = 0x4000000000000;   // 2^50: a sender word from a message queue (post_mesgq)
const TKILL_MARK: u64 = 0x8000000000000;   // 2^51: from tkill or tgkill (si_code SI_TKILL, si_pid the sender's group)
const SIG_DFL: u64 = 0;
const SIG_IGN: u64 = 1;
const SA_RESTART: u64 = 0x10000000;
const SA_NODEFER: u64 = 0x40000000;
const SA_RESETHAND: u64 = 0x80000000;

const SIG_BLOCK: u64 = 0;
const SIG_UNBLOCK: u64 = 1;
const SIG_SETMASK: u64 = 2;

const EINTR: u64 = 18446744073709551612;   // 2^64 - 4

/// The bit for signal s (1 to 64) in a signal set.
fn sbit(s: u64) -> u64
  requires 1 <= s && s <= NSIG
{
  return 1 << (s - 1);
}

fn has_sig(m: u64, s: u64) -> bool
  requires 1 <= s && s <= NSIG
{
  return m & sbit(s) != 0;
}

fn sa_get(t: &Buf, pid: u64, s: u64, f: u64) -> u64
  requires len(t) <= SIGACT_LEN && pid < NPROC && 1 <= s && s <= NSIG && f < 4
{
  return wget(t, pid * 256 + (s - 1) * 4 + f);
}

fn sa_set(t: &mut Buf, pid: u64, s: u64, f: u64, v: u64)
  requires len(t) <= SIGACT_LEN && pid < NPROC && 1 <= s && s <= NSIG && f < 4
  ensures len(t) == old(len(t))
{
  wset(&mut t, pid * 256 + (s - 1) * 4 + f, v);
}

/// Signals whose default action is to do nothing (SIGCONT's is to
/// continue a stopped process, which post_sig does when it is sent).
fn dfl_ignores(s: u64) -> bool {
  return s == SIGCHLD || s == SIGURG || s == SIGWINCH || s == SIGCONT;
}

/// Signals whose default action is to stop the process.
fn dfl_stops(s: u64) -> bool {
  return s >= SIGSTOP && s <= SIGTTOU;
}

// ---------------------------------------------------------------- job control
// A process stopped by a signal is STOPPED: never picked to run, until
// SIGCONT (or SIGKILL) makes it READY again. Its word in k.sys from SYS_JC
// is the signal that stopped it, plus JC_STOP until wait reports the stop
// (WUNTRACED, WSTOPPED), plus JC_CONT until wait reports that it
// continued (WCONTINUED), plus JC_EXECED once it called execve (setpgid
// then refuses to move it). Each change sends the parent SIGCHLD unless its
// SIGCHLD action has SA_NOCLDSTOP, and wakes it from wait4 or waitid.
// Only the thread that takes the signal stops, not its whole group.

const JC_STOP: u64 = 256;
const JC_CONT: u64 = 512;
const JC_EXECED: u64 = 1024;
const SA_NOCLDSTOP: u64 = 1;

fn jc_get(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
{
  return get(k.sys, SYS_JC + p);
}

fn jc_set(k: &mut Kernel, p: u64, v: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_JC + p, v);
}

/// Process p stopped or continued: its parent hears of it.
fn jc_tell(k: &mut Kernel, p: u64)
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let par = pget(k.procs, p, F_PARENT);
  if par == 0 || par >= NPROC || state(k.procs, par) == FREE || state(k.procs, par) == ZOMBIE {
    return;
  }
  if state(k.procs, par) == LXWAITING {
    pset(&mut k.procs, par, F_STATE, READY);  // its wait4 or waitid looks again
  }
  if sa_get(k.sigact, par, SIGCHLD, 1) & SA_NOCLDSTOP == 0 && is_linux(k.procs, par) {
    post_from(&mut k, par, SIGCHLD, p);
  }
}

/// Process p stopped for its tracer (a ptrace-stop): the tracer hears of
/// it, as a parent hears of a stop, and wakes from wait4 or waitid.
fn tr_tell(k: &mut Kernel, p: u64)
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let t = tr_tracer(k, p);
  if t == 0 || t > NPROC {
    return;
  }
  let tr = t - 1;
  if tr == 0 || tr == pget(k.procs, p, F_PARENT) || state(k.procs, tr) == FREE || state(k.procs, tr) == ZOMBIE {
    return;                                 // the parent was told by jc_tell
  }
  if state(k.procs, tr) == LXWAITING {
    pset(&mut k.procs, tr, F_STATE, READY);
  }
  if is_linux(k.procs, tr) {
    post_from(&mut k, tr, SIGCHLD, p);
  }
}

/// Process p, traced, takes signal s: it stops until its tracer resumes
/// it (PTRACE_CONT and the others), which may pass a signal on instead.
fn tr_stop(k: &mut Kernel, p: u64, s: u64)
  requires kok(k) && 1 <= p && p < NPROC && s < 256
  ensures kok(k)
{
  pset(&mut k.procs, p, F_STATE, STOPPED);
  jc_set(&mut k, p, s + JC_STOP + jc_get(k, p) / JC_EXECED % 2 * JC_EXECED);
  let w = tr_get(k, p);
  tr_put(&mut k, p, tr_make(w % 65536, tr_att(w), 1, 0, s, tr_opt(w)));
  jc_tell(&mut k, p);
  tr_tell(&mut k, p);
}

/// What wait may report about child c besides its end: 256 + the signal
/// that stopped it (with `stops`), or 512 + SIGCONT once it continued
/// (with `conts`); 0 if neither. Unless `keep` (WNOWAIT), the report is
/// taken.
fn jc_report(k: &mut Kernel, c: u64, stops: bool, conts: bool, keep: bool) -> u64
  requires kok(k) && c < NPROC
  ensures kok(k) && (result == 0 || (result >= 256 && result < 768))
{
  let w = jc_get(k, c);
  let sig = w % 256;
  if stops && w / JC_STOP % 2 == 1 && state(k.procs, c) == STOPPED {
    if !keep {
      jc_set(&mut k, c, w - JC_STOP);
    }
    return 256 + sig;
  }
  if conts && w / JC_CONT % 2 == 1 {
    if !keep {
      jc_set(&mut k, c, w - JC_CONT);
    }
    return 512 + SIGCONT;
  }
  return 0;
}

/// execve in process p.
fn jc_exec(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let w = jc_get(k, p);
  if w / JC_EXECED % 2 == 0 && w < 0xFFFFFFFF {
    jc_set(&mut k, p, w + JC_EXECED);
  }
}

/// Has process p called execve?
fn jc_execed(k: &Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
{
  return jc_get(k, p) / JC_EXECED % 2 == 1;
}

/// Process p takes stop signal s.
fn jc_stop(k: &mut Kernel, p: u64, s: u64)
  requires kok(k) && 1 <= p && p < NPROC && s < 256
  ensures kok(k)
{
  pset(&mut k.procs, p, F_STATE, STOPPED);
  jc_set(&mut k, p, s + JC_STOP + jc_get(k, p) / JC_EXECED % 2 * JC_EXECED);
  jc_tell(&mut k, p);
}

/// Would signal s be thrown away, as Linux does when it is generated?
fn sig_ignored(t: &Buf, pid: u64, s: u64) -> bool
  requires len(t) <= SIGACT_LEN && pid < NPROC && 1 <= s && s <= NSIG
{
  if s == SIGKILL {
    return false;
  }
  let h = sa_get(t, pid, s, 0);
  return h == SIG_IGN || (h == SIG_DFL && dfl_ignores(s));
}

/// The row of k.sigact that holds p's signal actions now: the actions of a
/// thread group move with its address space (src/lxthread.bastio
/// group_move), so a thread that is not running has the group's actions only
/// if nobody else in the group has the space.
fn sig_row(k: &mut Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures kok(k) && result < NPROC
{
  let mut g = pget(k.procs, p, F_TGID);
  if g == 0 || g >= NPROC {
    g = p;
  }
  if has_space(&mut k.spaces, p) {
    return p;
  }
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if (q == g || pget(k.procs, q, F_TGID) == g) && state(k.procs, q) != FREE && has_space(&mut k.spaces, q) {
      return q;
    }
    q = q + 1;
  }
  return p;
}

/// Makes signal s pending for process p, and wakes p from a wait it may be
/// in (a console read or wait4), so the signal is acted on.
fn post_sig(k: &mut Kernel, p: u64, s: u64)
  requires kok(k) && 1 <= p && p < NPROC && 1 <= s && s <= NSIG
  ensures kok(k)
{
  let st = state(k.procs, p);
  let blocked = has_sig(pget(k.procs, p, F_SIGMASK), s) && s != SIGKILL;
  if st == FREE || st == ZOMBIE {
    return;
  }
  // SIGCONT continues a stopped process whatever its action, and drops
  // pending stops; a stop signal drops a pending SIGCONT.
  if s == SIGCONT {
    pset(&mut k.procs, p, F_SIGPEND, pget(k.procs, p, F_SIGPEND) & !(sbit(SIGSTOP) | sbit(SIGTSTP) | sbit(SIGTTIN) | sbit(SIGTTOU)));
    if st == STOPPED && tr_stopped(tr_get(k, p)) == 0 {
      pset(&mut k.procs, p, F_STATE, READY);
      jc_set(&mut k, p, JC_CONT + jc_get(k, p) / JC_EXECED % 2 * JC_EXECED);
      jc_tell(&mut k, p);
    }
  } else if dfl_stops(s) {
    pset(&mut k.procs, p, F_SIGPEND, pget(k.procs, p, F_SIGPEND) & !sbit(SIGCONT));
  }
  if s == SIGKILL && st == STOPPED {
    pset(&mut k.procs, p, F_STATE, READY);  // to die
  }
  // A blocked signal is kept even if ignored, as on Linux: a signalfd or
  // sigwait may take it, and delivery drops it if it is still ignored.
  let sr = sig_row(&mut k, p);
  if sig_ignored(k.sigact, sr, s) && !blocked && tr_tracer(k, p) == 0 {
    return;                                 // a traced process stops for it, as on Linux
  }
  pset(&mut k.procs, p, F_SIGPEND, pget(k.procs, p, F_SIGPEND) | sbit(s));
  wset(&mut k.sigsave, sender_at(p, s), 0);     // the kernel, unless post_from says
  // A timed wait tries again even for a blocked signal: sigtimedwait may
  // be waiting for it.
  if (!blocked && (st == LXREADING || st == LXWAITING || st == FUTEXWAIT || st == SOCKWAIT)) || st == TIMEWAIT {
    pset(&mut k.procs, p, F_STATE, READY);
  }
}

/// Where k.sigsave keeps who sent process p's pending signal s.
fn sender_at(p: u64, s: u64) -> u64
  requires p < NPROC && 1 <= s && s <= NSIG
  ensures result < SIGSAVE_LEN
{
  return p * SIGSAVE_ROW + s;
}

/// post_sig, from process `from` (for the siginfo's si_pid).
fn post_from(k: &mut Kernel, p: u64, s: u64, from: u64)
  requires kok(k) && 1 <= p && p < NPROC && 1 <= s && s <= NSIG
  ensures kok(k)
{
  post_sig(&mut k, p, s);
  wset(&mut k.sigsave, sender_at(p, s), from);
}

/// post_from with a value (sigqueue): the siginfo says SI_QUEUE and
/// carries the low 32 bits of `value` (sival_int; a sival_ptr loses its
/// upper half). The sender word holds from + SW_QUEUE + SW_VAL * value.
fn post_queued(k: &mut Kernel, p: u64, s: u64, from: u64, value: u64)
  requires kok(k) && 1 <= p && p < NPROC && 1 <= s && s <= NSIG && from < NPROC
  ensures kok(k)
{
  post_sig(&mut k, p, s);
  wset(&mut k.sigsave, sender_at(p, s), from + SW_QUEUE + SW_VAL * (value % 0x100000000));
}

/// post_queued from a message queue (mq_notify): si_code SI_MESGQ.
fn post_mesgq(k: &mut Kernel, p: u64, s: u64, from: u64, value: u64)
  requires kok(k) && 1 <= p && p < NPROC && 1 <= s && s <= NSIG && from < NPROC
  ensures kok(k)
{
  post_sig(&mut k, p, s);
  wset(&mut k.sigsave, sender_at(p, s), from + SW_QUEUE + SW_VAL * (value % 0x100000000) + MESGQ_MARK);
}

/// Writes the parts of a siginfo at `at` in b that come from a sender
/// word (see post_queued): si_pid, and for a queued signal si_code
/// SI_QUEUE (-1), or SI_MESGQ (-3) with MESGQ_MARK, and si_value.
fn info_from(b: &mut Bytes, at: u64, word: u64)
  requires at + 32 <= blen(b)
  ensures blen(b) == old(blen(b))
{
  if word >= FAULT_MARK {
    // A processor exception (fault_caught): si_code SEGV_MAPERR, si_addr.
    bset(&mut b, at + 8, cast[u8](1));
    xfer_u64(&mut b, at + 16, word - FAULT_MARK);
    return;
  }
  bset(&mut b, at + 16, cast[u8](word % 256));          // si_pid
  bset(&mut b, at + 17, cast[u8](word / 256 % 4));
  if word / TKILL_MARK % 2 == 1 {
    // glibc's SIGSETXID handler (setgid and friends in a threaded program)
    // ignores a signal that is not SI_TKILL from its own process.
    bset(&mut b, at + 8, cast[u8](250));
    bset(&mut b, at + 9, cast[u8](255));
    bset(&mut b, at + 10, cast[u8](255));
    bset(&mut b, at + 11, cast[u8](255));
  }
  if word / SW_QUEUE % 2 == 1 {
    let mut i = 0;
    while i < 4
      invariant i <= 4 && at + 32 <= blen(b) && blen(b) == old(blen(b))
    {
      if i == 0 && word / MESGQ_MARK % 2 == 1 {
        bset(&mut b, at + 8, cast[u8](253));             // si_code: SI_MESGQ
      } else {
        bset(&mut b, at + 8 + i, cast[u8](255));         // si_code: SI_QUEUE
      }
      bset(&mut b, at + 24 + i, cast[u8](word / SW_VAL / pow256(i) % 256));
      i = i + 1;
    }
  }
}

fn pow256(i: u64) -> u64
  requires i < 4
  ensures result >= 1 && result <= 16777216
{
  if i == 0 {
    return 1;
  }
  if i == 1 {
    return 256;
  }
  if i == 2 {
    return 65536;
  }
  return 16777216;
}

/// rt_sigqueueinfo(target, s, info): kill with the si_value in info.
fn lx_sigqueue(k: &mut Kernel, pid: u64, target: u64, s: u64, info: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  if s > NSIG {
    return EINVAL;
  }
  if target >= NPROC || state(k.procs, target) == FREE || target == 0 {
    return ESRCH;
  }
  if info > 0xFFFFFFFFFFFF0000 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, info, &mut k.fs.xfer, 32) != 32 {
    return EFAULT;
  }
  // Another process may not pretend to be the kernel or kill/tkill: a
  // si_code of 0 or more, or SI_TKILL (-6), is for a process's own use.
  let code = get_u64(k.fs.xfer, 8) % 4294967296;
  if (code < 0x80000000 || code == 0xFFFFFFFA) && target != pid {
    return EPERM;
  }
  if !may_signal(k, pid, target, s) {
    return EPERM;                           // the same rule as kill
  }
  if sigpending_full(k, target, s) {
    return EAGAIN;
  }
  if s != 0 && state(k.procs, target) != ZOMBIE {
    post_queued(&mut k, target, s, pid, get_u64(k.fs.xfer, 24));
  }
  return 0;
}

/// Process p's child has ended: a Linux parent gets SIGCHLD (thrown away
/// unless it has a handler, as the default action ignores it).
fn child_ended(k: &mut Kernel, p: u64, child: u64)
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  // The group's leader gets it, whichever thread made the child.
  let g = pget(k.procs, p, F_TGID);
  let mut t = p;
  if g != 0 && g < NPROC && state(k.procs, g) != FREE && state(k.procs, g) != ZOMBIE {
    t = g;
  }
  if is_linux(k.procs, t) {
    post_from(&mut k, t, SIGCHLD, child);
  }
}

/// A Linux program: started from an ELF image (src/proc.bastio sets its
/// mmap floor), as opposed to a BastiOS one.
/// Process p's process group (a pid).
fn pgid_of(procs: &Buf, p: u64) -> u64
  requires ptab_ok(procs) && p < NPROC
{
  let g = pget(procs, p, F_PGID);
  if g == 0 {
    return p;
  }
  return g;
}

/// Process p's session (a pid).
fn sid_of(procs: &Buf, p: u64) -> u64
  requires ptab_ok(procs) && p < NPROC
{
  let g = pget(procs, p, F_SID);
  if g == 0 {
    return p;
  }
  return g;
}

/// Makes process c start in the group and session of process p (fork and
/// clone, which copy the row, would otherwise read p's 0 as c's own pid).
fn group_fork(procs: &mut Buf, p: u64, c: u64)
  requires ptab_ok(procs) && p < NPROC && c < NPROC
  ensures ptab_ok(procs)
{
  pset(&mut procs, c, F_PGID, pgid_of(procs, p));
  pset(&mut procs, c, F_SID, sid_of(procs, p));
}

fn is_linux(procs: &Buf, p: u64) -> bool
  requires ptab_ok(procs) && p < NPROC
{
  return pget(procs, p, F_MMAP) != 0;
}

/// Ctrl-C on the console: with a Linux program on it, throws away what was
/// typed and posts SIGINT to every Linux program (there are no process
/// groups: they all share the console). Otherwise the byte stays queued
/// for a BastiOS program.
fn tty_intr(con: &mut Con, k: &mut Kernel)
  requires con_ok(con) && kok(k)
  ensures kok(k) && con_ok(con)
{
  if tt_flags(k.line, 12) & ISIG == 0 {
    return;                                 // Ctrl-C is a byte like any other (ISIG off)
  }
  let n = k.q.r.n;
  let mut hit = false;
  let mut i = 0;
  while i < n
    invariant i <= n && n == k.q.r.n && kok(k) && con_ok(con)
  {
    if get(k.q.q, ring_slot(k.q.r, i)) == 3 {
      hit = true;
    }
    i = i + 1;
  }
  if !hit {
    return;
  }
  let mut any = false;
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && kok(k) && con_ok(con)
  {
    let st = state(k.procs, p);
    if st != FREE && st != ZOMBIE && is_linux(k.procs, p) {
      any = true;
    }
    p = p + 1;
  }
  if !any {
    return;
  }
  ring_clear(&mut k.q.r);
  k.line = set(k.line, 0, 0);
  k.line = set(k.line, 1, 0);
  puts(&mut con, "^C\r\n");
  p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && kok(k) && con_ok(con)
  {
    if is_linux(k.procs, p) {
      post_sig(&mut k, p, SIGINT);
    }
    p = p + 1;
  }
}

/// fork: the child has the parent's actions. (Its row, copied from the
/// parent's, has the blocked set; fork_into clears what is pending.)
fn sig_fork(t: &mut Buf, parent: u64, child: u64)
  requires len(t) <= SIGACT_LEN && parent < NPROC && child < NPROC
  ensures len(t) <= SIGACT_LEN
{
  let mut s = 1;
  while s <= NSIG
    invariant 1 <= s && s <= NSIG + 1 && len(t) <= SIGACT_LEN
  {
    let mut f = 0;
    while f < 4
      invariant f <= 4 && s <= NSIG && len(t) <= SIGACT_LEN
    {
      sa_set(&mut t, child, s, f, sa_get(t, parent, s, f));
      f = f + 1;
    }
    s = s + 1;
  }
}

/// A new program (spawn, or execve with keep_ign): every handler goes back
/// to the default; execve keeps the signals that are ignored.
fn sig_reset(t: &mut Buf, pid: u64, keep_ign: bool)
  requires len(t) <= SIGACT_LEN && pid < NPROC
  ensures len(t) <= SIGACT_LEN
{
  let mut s = 1;
  while s <= NSIG
    invariant 1 <= s && s <= NSIG + 1 && len(t) <= SIGACT_LEN
  {
    if !keep_ign || sa_get(t, pid, s, 0) != SIG_IGN {
      sa_set(&mut t, pid, s, 0, SIG_DFL);
    }
    sa_set(&mut t, pid, s, 1, 0);
    sa_set(&mut t, pid, s, 2, 0);
    sa_set(&mut t, pid, s, 3, 0);
    s = s + 1;
  }
}

// ---------------------------------------------------------------- system calls

/// rt_sigaction(sig, act, oact): struct sigaction is handler, flags,
/// restorer and mask, 8 bytes each (the restorer is absent on AArch64).
fn lx_sigaction(k: &mut Kernel, pid: u64, s: u64, act: u64, oact: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if s == 0 || s > NSIG {
    return EINVAL;
  }
  let mut nh = 0;
  let mut nf = 0;
  let mut nr = 0;
  let mut nm = 0;
  if act != 0 {
    if s == SIGKILL || s == SIGSTOP {
      return EINVAL;
    }
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, act, &mut k.fs.xfer, SIGACT_SIZE) != SIGACT_SIZE {
      return EFAULT;
    }
    nh = rd64(k.fs.xfer, 0);
    nf = rd64(k.fs.xfer, 8);
    if SA_RESTORER_AT != 0 {
      nr = rd64(k.fs.xfer, SA_RESTORER_AT);
    }
    nm = rd64(k.fs.xfer, SA_MASK_AT);
  }
  if oact != 0 {
    xfer_u64(&mut k.fs.xfer, 0, sa_get(k.sigact, pid, s, 0));
    xfer_u64(&mut k.fs.xfer, 8, sa_get(k.sigact, pid, s, 1));
    if SA_RESTORER_AT != 0 {
      xfer_u64(&mut k.fs.xfer, SA_RESTORER_AT, sa_get(k.sigact, pid, s, 2));
    }
    xfer_u64(&mut k.fs.xfer, SA_MASK_AT, sa_get(k.sigact, pid, s, 3));
    if lx_put_out(&mut k, pid, oact, SIGACT_SIZE) != 0 {
      return EFAULT;
    }
  }
  if act != 0 {
    sa_set(&mut k.sigact, pid, s, 0, nh);
    sa_set(&mut k.sigact, pid, s, 1, nf);
    sa_set(&mut k.sigact, pid, s, 2, nr);
    sa_set(&mut k.sigact, pid, s, 3, nm);
    if sig_ignored(k.sigact, pid, s) {
      pset(&mut k.procs, pid, F_SIGPEND, pget(k.procs, pid, F_SIGPEND) & !sbit(s));
    }
  }
  return 0;
}

/// The set a process may block: anything but SIGKILL and SIGSTOP.
fn blockable(m: u64) -> u64 {
  return m & !(sbit(SIGKILL) | sbit(SIGSTOP));
}

/// rt_sigprocmask(how, set, oset).
fn lx_sigprocmask(k: &mut Kernel, pid: u64, how: u64, setp: u64, oset: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let was = pget(k.procs, pid, F_SIGMASK);
  let mut new = was;
  if setp != 0 {
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, setp, &mut k.fs.xfer, 8) != 8 {
      return EFAULT;
    }
    let v = rd64(k.fs.xfer, 0);
    if how == SIG_BLOCK {
      new = was | v;
    } else if how == SIG_UNBLOCK {
      new = was & !v;
    } else if how == SIG_SETMASK {
      new = v;
    } else {
      return EINVAL;
    }
  }
  if oset != 0 {
    xfer_u64(&mut k.fs.xfer, 0, was);
    if lx_put_out(&mut k, pid, oset, 8) != 0 {
      return EFAULT;
    }
  }
  pset(&mut k.procs, pid, F_SIGMASK, blockable(new));
  return 0;
}

/// Whether pid may send a signal to p (Linux's kill_ok_by_cred): root may,
/// and so may a sender whose real or effective uid is p's real or saved
/// uid; SIGCONT also reaches the sender's own session.
fn may_signal(k: &Kernel, pid: u64, p: u64, s: u64) -> bool
  requires kok(k) && pid < NPROC && p < NPROC
{
  let ruid = id_get(k.procs, pid, F_UID, false);
  let euid = id_get(k.procs, pid, F_UID, true);
  if euid == 0 || (s == 18 && sid_of(k.procs, pid) == sid_of(k.procs, p)) {
    return true;
  }
  let tr = id_get(k.procs, p, F_UID, false);
  let ts = id_get(k.procs, p, F_SUID, false);
  return euid == tr || euid == ts || ruid == tr || ruid == ts;
}

/// kill(target, s): one process; with 0 the caller's process group, with
/// -g group g, with -1 every other Linux program. Signal 0 only checks.
/// tkill(tid, s) (tgid 0) and tgkill(tgid, tid, s): a thread id, and a
/// group id, must be positive (EINVAL); tgkill's thread must be in that
/// group (ESRCH).
fn lx_tgkill(k: &mut Kernel, pid: u64, tgid: u64, tid: u64, s: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let t = tid % 0x100000000;
  if t == 0 || t >= 0x80000000 || s > NSIG {
    return EINVAL;
  }
  if tgid != 0 {
    let g = tgid % 0x100000000;
    if g == 0 || g >= 0x80000000 {
      return EINVAL;
    }
    if t < NPROC && state(k.procs, t) != FREE {
      let mut lead = pget(k.procs, t, F_TGID);
      if lead == 0 {
        lead = t;
      }
      if lead != g {
        return ESRCH;
      }
    }
  }
  // Past RLIMIT_SIGPENDING (src/lxrlimit.bastio), a real-time signal from
  // tgkill or sigqueue fails; one from kill (SI_USER) is still sent.
  if t < NPROC && state(k.procs, t) != FREE && may_signal(k, pid, t, s) && sigpending_full(k, t, s) {
    return EAGAIN;
  }
  let r = lx_kill(&mut k, pid, t, s);
  if r == 0 && s != 0 && t < NPROC && 1 <= t && state(k.procs, t) != FREE && state(k.procs, t) != ZOMBIE {
    let g = tgid(k.procs, pid);
    if g < NPROC {
      wset(&mut k.sigsave, sender_at(t, s), g + TKILL_MARK);
    }
  }
  return r;
}

fn lx_kill(k: &mut Kernel, pid: u64, target: u64, s: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  if s > NSIG {
    return EINVAL;
  }
  if target == 0 || target >= 0x8000000000000000 {
    let all = target == 0xFFFFFFFFFFFFFFFF;
    let mut g = pgid_of(k.procs, pid);
    if target != 0 && !all {
      g = 0xFFFFFFFFFFFFFFFF - target + 1;   // -target
    }
    let mut hit = false;
    let mut sent = false;
    let mut p = 1;
    while p < NPROC
      invariant 1 <= p && p <= NPROC && kok(k)
    {
      let live = state(k.procs, p) != FREE && state(k.procs, p) != ZOMBIE && is_linux(k.procs, p);
      let seen = nsk_of(k, NSK_PID, pid) == 0 || nsk_of(k, NSK_PID, p) == nsk_of(k, NSK_PID, pid);
      if live && seen && ((all && p != pid) || (!all && pgid_of(k.procs, p) == g)) {
        hit = true;
        if may_signal(k, pid, p, s) {
          sent = true;
          if s != 0 {
            post_from(&mut k, p, s, pid);
          }
        }
      }
      p = p + 1;
    }
    if !hit {
      return ESRCH;
    }
    if !sent {
      return EPERM;
    }
    return 0;
  }
  if target >= NPROC || state(k.procs, target) == FREE {
    return ESRCH;
  }
  if !may_signal(k, pid, target, s) {
    return EPERM;
  }
  if s != 0 && state(k.procs, target) != ZOMBIE {   // a zombie takes it and drops it, as on Linux
    post_from(&mut k, target, s, pid);
  }
  return 0;
}

/// rt_sigsuspend(mask): waits, with mask as the blocked set, until a
/// handler runs; the handler's return puts the old mask back (see
/// enter_handler), and the call ends with -EINTR. `was` is the restart
/// word: only the first run swaps the mask.
fn lx_sigsuspend(k: &mut Kernel, pid: u64, was: u64, setp: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  if was == 0 {
    if pget(k.procs, pid, F_REGS + R_RSI) != 8 {
      ret(&mut k.procs, pid, EINVAL);       // the sigset size
      return KEEP;
    }
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, setp, &mut k.fs.xfer, 8) != 8 {
      ret(&mut k.procs, pid, EFAULT);
      return KEEP;
    }
    wset(&mut k.sigsave, pid * SIGSAVE_ROW, pget(k.procs, pid, F_SIGMASK));
    pset(&mut k.procs, pid, F_SIGMASK, blockable(rd64(k.fs.xfer, 0)));
  }
  let r = lx_retry(&mut k, pid, LX_RT_SIGSUSPEND);
  let pend = pget(k.procs, pid, F_SIGPEND);
  if r == SWITCH && pend & pget(k.procs, pid, F_SIGMASK) == pend {
    nap(&mut k, pid, false);                // nothing to deliver yet: asleep until a signal (or a tick) comes
  }
  return r;
}

/// Is rsp on process p's alternate signal stack?
fn on_altstack(procs: &Buf, p: u64, rsp: u64) -> bool
  requires ptab_ok(procs) && p < NPROC
{
  let sp = pget(procs, p, F_ALTSP);
  let size = pget(procs, p, F_ALTSIZE);
  return size != 0 && rsp > sp && rsp - sp <= size;
}

/// sigaltstack(ss, old): stack_t is the address, the flags (an int) and
/// the size. A handler whose action has SA_ONSTACK runs on the stack set
/// here (enter_handler). SS_AUTODISARM is not supported.
fn lx_sigaltstack(k: &mut Kernel, pid: u64, ss: u64, oss: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let sp = pget(k.procs, pid, F_ALTSP);
  let size = pget(k.procs, pid, F_ALTSIZE);
  let on = on_altstack(k.procs, pid, pget(k.procs, pid, F_REGS + R_RSP));
  let mut nsp = sp;
  let mut nsize = size;
  if ss != 0 {
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, ss, &mut k.fs.xfer, 24) != 24 {
      return EFAULT;
    }
    if on {
      return EPERM;                         // not while running on it
    }
    let mut fl = rd64(k.fs.xfer, 8) % 0x100000000;
    if fl == SS_ONSTACK {
      fl = 0;                               // what old programs pass: Linux takes it as 0
    }
    if fl == SS_DISABLE {
      nsp = 0;
      nsize = 0;
    } else if fl != 0 {
      return EINVAL;
    } else {
      nsp = rd64(k.fs.xfer, 0);
      nsize = rd64(k.fs.xfer, 16);
      if nsize < MINSIGSTKSZ {
        return ENOMEM;
      }
    }
  }
  if oss != 0 {
    let mut ofl = SS_DISABLE;
    if on {
      ofl = SS_ONSTACK;
    } else if size != 0 {
      ofl = 0;
    }
    xfer_u64(&mut k.fs.xfer, 0, sp);
    xfer_u64(&mut k.fs.xfer, 8, ofl);
    xfer_u64(&mut k.fs.xfer, 16, size);
    if lx_put_out(&mut k, pid, oss, 24) != 0 {
      return EFAULT;
    }
  }
  pset(&mut k.procs, pid, F_ALTSP, nsp);
  pset(&mut k.procs, pid, F_ALTSIZE, nsize);
  return 0;
}

/// The signal system calls. Returns KEEP, or SWITCH when the caller now
/// has a signal to take, so it is delivered before the caller goes on.
fn lx_sig_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let mut r = ENOSYS;
  // The sigset size: 8 bytes on x86-64; Linux refuses any other.
  let size = pget(k.procs, pid, F_REGS + R_R10);
  if (n == LX_RT_SIGACTION || n == LX_RT_SIGPROCMASK) && size != 8 {
    r = EINVAL;
  } else if n == LX_RT_SIGPENDING && b > 8 {
    r = EINVAL;
  } else if n == LX_RT_SIGACTION {
    r = lx_sigaction(&mut k, pid, a, b, c);
  } else if n == LX_RT_SIGPROCMASK {
    r = lx_sigprocmask(&mut k, pid, a, b, c);
  } else if n == LX_KILL {
    r = lx_kill(&mut k, pid, a, b);
  } else if n == LX_TKILL {
    r = lx_tgkill(&mut k, pid, 0, a, b);
  } else if n == LX_TGKILL {
    r = lx_tgkill(&mut k, pid, a, b, c);
  } else if n == LX_RT_SIGQUEUEINFO {
    r = lx_sigqueue(&mut k, pid, a, b, c);
  } else if n == LX_RT_SIGRETURN {
    r = lx_sigreturn(&mut k, pid);
  } else if n == LX_RT_SIGPENDING {
    // Pending signals that are blocked: the others are about to be taken.
    xfer_u64(&mut k.fs.xfer, 0, pget(k.procs, pid, F_SIGPEND) & pget(k.procs, pid, F_SIGMASK));
    r = lx_put_out(&mut k, pid, a, smaller(b, 8));
  } else if n == LX_SIGALTSTACK {
    r = lx_sigaltstack(&mut k, pid, a, b);
  }
  ret(&mut k.procs, pid, r);
  if pget(k.procs, pid, F_SIGPEND) & !pget(k.procs, pid, F_SIGMASK) != 0 {
    return SWITCH;
  }
  return KEEP;
}

fn is_sig_call(n: u64) -> bool {
  return n == LX_RT_SIGACTION || n == LX_RT_SIGPROCMASK || n == LX_KILL || n == LX_TKILL
    || n == LX_TGKILL || n == LX_RT_SIGRETURN || n == LX_RT_SIGPENDING || n == LX_SIGALTSTACK || n == LX_RT_SIGQUEUEINFO;
}

// ---------------------------------------------------------------- delivery

/// Before process p runs: acts on its pending, unblocked signals. Returns
/// false if one ended it.
fn lx_deliver(k: &mut Kernel, mmu: &Mmu, p: u64) -> bool
  requires kok(k) && 1 <= p && p < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  // A sigtimedwait between two tries runs again first: the signal that
  // woke it may be one it waits for, which Linux hands to the call rather
  // than to a handler. If another signal is pending, the call ends with
  // EINTR and the signal is delivered after it (lx_sigtimedwait).
  if pget(k.procs, p, F_RESTART) != 0 && pget(k.procs, p, F_REGS + R_LXNR) == 128 {
    return true;
  }
  if pget(k.procs, p, F_SIGPEND) == 0 {
    return true;                            // nothing pending: the common case
  }
  let mut s = 1;
  while s <= NSIG
    invariant 1 <= s && s <= NSIG + 1 && kok(k)
  {
    let pend = pget(k.procs, p, F_SIGPEND);
    let take = has_sig(pend, s) && (s == SIGKILL || !has_sig(pget(k.procs, p, F_SIGMASK), s));
    if take {
      pset(&mut k.procs, p, F_SIGPEND, pend & !sbit(s));
      let w = tr_get(k, p);
      if w % 65536 != 0 && s != SIGKILL {
        if tr_skip(w) == 0 {
          tr_stop(&mut k, p, s);            // the tracer decides what becomes of it
          return false;
        }
        tr_put(&mut k, p, tr_make(w % 65536, tr_att(w), tr_stopped(w), 0, tr_sig(w), tr_opt(w)));
      }
      let h = sa_get(k.sigact, p, s, 0);
      if s != SIGKILL && h == SIG_DFL && dfl_stops(s) {
        jc_stop(&mut k, p, s);
        return false;                       // not run until SIGCONT
      }
      if s == SIGKILL || (h == SIG_DFL && !dfl_ignores(s)) {
        terminate(&mut k, mmu, p, SIG_DEATH + s);
        return false;
      }
      if h != SIG_DFL && h != SIG_IGN {
        if !enter_handler(&mut k, p, s) {
          // No room for the frame (an alternate stack made read-only, say):
          // as Linux does, a SIGSEGV is forced, which a handler of its own
          // (on the normal stack) may still catch.
          let segv = sa_get(k.sigact, p, SIGSEGV, 0);
          if s == SIGSEGV || segv == SIG_DFL || segv == SIG_IGN {
            terminate(&mut k, mmu, p, SIG_DEATH + SIGSEGV);
            return false;
          }
          pset(&mut k.procs, p, F_SIGMASK, pget(k.procs, p, F_SIGMASK) & !sbit(SIGSEGV));
          pset(&mut k.procs, p, F_SIGPEND, pget(k.procs, p, F_SIGPEND) | sbit(SIGSEGV));
          return lx_deliver(&mut k, mmu, p);
        }
        return true;                        // one handler at a time
      }
    }
    s = s + 1;
  }
  return true;
}

/// A processor exception (vector v) in process p, which Linux turns into
/// signal s: if p has a handler for s and does not block it, makes s
/// pending, with the faulting address `addr` for its siginfo, and returns
/// true. Otherwise the exception ends p, as Linux's forced signal would.
/// Returning from the handler runs the instruction again, as on Linux.
fn fault_caught(k: &mut Kernel, p: u64, s: u64, addr: u64) -> bool
  requires kok(k) && 1 <= p && p < NPROC && 1 <= s && s <= NSIG
  ensures kok(k)
{
  let h = sa_get(k.sigact, p, s, 0);
  let masked = has_sig(pget(k.procs, p, F_SIGMASK), s);
  // A traced process stops for the signal, handler or not (src/lxptrace.bastio).
  let traced = tr_tracer(k, p) != 0 && !masked;
  if (h == SIG_DFL || h == SIG_IGN || masked) && !traced {
    return false;
  }
  pset(&mut k.procs, p, F_SIGPEND, pget(k.procs, p, F_SIGPEND) | sbit(s));
  wset(&mut k.sigsave, sender_at(p, s), FAULT_MARK + addr % FAULT_MARK);
  return true;
}

/// The calls Linux never restarts after a handler, SA_RESTART or not
/// (signal(7)): the waits with a timeout, and the waits for a signal.
fn never_restarts(call: u64) -> bool {
  // rt_sigtimedwait, nanosleep, clock_nanosleep (lxtime.bastio comes later)
  if call == 128 || call == 35 || call == 230 {
    return true;
  }
  // select, pselect6, epoll_wait, epoll_pwait, epoll_pwait2
  if call == 23 || call == 270 || call == 232 || call == 281 || call == 441 {
    return true;
  }
  // semop, semtimedop, msgsnd, msgrcv (src/lxipc.bastio comes later)
  if call == 65 || call == 220 || call == 69 || call == 70 {
    return true;
  }
  return call == LX_POLL || call == LX_PPOLL;
}

/// After a Linux system call of process pid: F_ASLEEP is set while the
/// call waits (it will run again), for /proc.
fn call_done(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if pget(k.procs, pid, F_RESTART) == 0 {
    pset(&mut k.procs, pid, F_ASLEEP, 0);
  } else {
    pset(&mut k.procs, pid, F_ASLEEP, 1);
  }
}

/// Builds the signal frame for signal s on process p's stack and points p
/// at the handler. False if the stack has no room or the action has no
/// return address (SA_RESTORER, which every C library sets).
fn enter_handler(k: &mut Kernel, p: u64, s: u64) -> bool
  requires kok(k) && 1 <= p && p < NPROC && 1 <= s && s <= NSIG
  ensures kok(k)
{
  let restorer = sa_get(k.sigact, p, s, 2);
  let flags = sa_get(k.sigact, p, s, 1);
  let mut rsp = pget(k.procs, p, F_REGS + R_RSP);
  // SA_ONSTACK: onto the alternate stack, unless already on it. The frame
  // starts at its top, where no red zone needs keeping.
  let alt_sp = pget(k.procs, p, F_ALTSP);
  let alt_size = pget(k.procs, p, F_ALTSIZE);
  let was_on = on_altstack(k.procs, p, rsp);
  let mut red = RED_ZONE;
  if flags & SA_ONSTACK != 0 && alt_size != 0 && !was_on && alt_sp <= 0xFFFFFFFFFFFFFFFF - alt_size {
    rsp = alt_sp + alt_size;
    red = 0;
  }
  if (restorer == 0 && RESTORER_REQUIRED == 1) || !sig_fits(rsp) || rsp > USER_BASE + USER_SIZE {
    return false;
  }
  // A system call that was waiting: without SA_RESTART it fails with
  // EINTR instead of running again once the handler returns.
  // pause, rt_sigsuspend and the calls never_restarts names never run
  // again. A wait4 that SIGCHLD
  // interrupts always does: on Linux it would already have its child,
  // and here it collects it when it runs again after the handler.
  let call = pget(k.procs, p, F_REGS + R_LXNR);
  let waiting = pget(k.procs, p, F_RESTART) != 0;
  // ppoll and pselect6 with a mask swap it as rt_sigsuspend does, and
  // never run again after a handler either.
  let swapped = waiting && (call == LX_PPOLL || call == LX_PSELECT6 || call == 281 || call == 441) && wget(k.sigsave, p * SIGSAVE_ROW) & MASK_SWAPPED != 0;   // epoll_pwait, epoll_pwait2
  let suspended = waiting && call == LX_RT_SIGSUSPEND || swapped;
  let pausing = call == LX_PAUSE || suspended || never_restarts(call);
  let reaping = (call == LX_WAIT4 || call == LX_WAITID) && s == SIGCHLD;
  if waiting && (flags & SA_RESTART == 0 || pausing) && !reaping {
    let rip = pget(k.procs, p, F_REGS + R_RIP);
    if rip <= 0xFFFFFFFFFFFFFFF0 {
      pset(&mut k.procs, p, F_REGS + R_RIP, rip + SYSCALL_LEN);
      if sleep_left(&mut k, p, call) {
        pset(&mut k.procs, p, F_REGS + R_RET, EINTR);
      } else {
        pset(&mut k.procs, p, F_REGS + R_RET, EFAULT);
      }
    }
  }
  pset(&mut k.procs, p, F_RESTART, 0);
  pset(&mut k.procs, p, F_ASLEEP, 0);       // the handler runs
  // The mask to go back to: rt_sigsuspend's caller gets its own back.
  let mut was = pget(k.procs, p, F_SIGMASK);
  if suspended {
    was = wget(k.sigsave, p * SIGSAVE_ROW) & !MASK_SWAPPED;
    wset(&mut k.sigsave, p * SIGSAVE_ROW, was);     // the call is over: nothing left to put back
  }
  // The alternate stack as sigaltstack would report it.
  let mut ss_flags = SS_DISABLE;
  if was_on {
    ss_flags = SS_ONSTACK;
  } else if alt_size != 0 {
    ss_flags = 0;
  }
  if !sig_frame(&mut k, p, s, rsp, red, restorer, ss_flags, alt_sp, alt_size, was) {
    return false;
  }
  let mut mask = pget(k.procs, p, F_SIGMASK);
  if flags & SA_NODEFER == 0 {
    mask = mask | sbit(s);
  }
  pset(&mut k.procs, p, F_SIGMASK, blockable(mask | sa_get(k.sigact, p, s, 3)));
  pset(&mut k.procs, p, F_REGS + R_RIP, sa_get(k.sigact, p, s, 0));
  if flags & SA_RESETHAND != 0 {
    sa_set(&mut k.sigact, p, s, 0, SIG_DFL);   // after the handler is read
  }
  return true;
}

