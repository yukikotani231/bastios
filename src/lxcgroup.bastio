// Control groups (cgroup v2): a tree of groups of processes with limits,
// under /sys/fs/cgroup.
//
// The tree is not in the file layer. A path under sys/fs/cgroup is
// resolved by cg_walk to a group (a directory) or one of its control files;
// the groups are slots of CG_W words in k.mns (MNS_CG: parent, limits, name),
// 32 at most, and the root is slot 0 and always there. `mkdir` and `rmdir`
// there make and remove groups, so `cgroup.procs` of the new one is a file at
// once, and `mount -t cgroup2` shows the same tree where it is mounted. Every
// process belongs to one group (NSK_CG), and a child starts in its parent's.
//
// Control files (cgf_name): cgroup.procs and cgroup.threads (read: the
// members; write a process id: move it with its threads), cgroup.controllers
// (the controllers the parent hands down), cgroup.subtree_control (+cpu
// +memory +pids and - to hand them down), cgroup.events (populated),
// cgroup.kill (write 1: SIGKILL every process in the group and below),
// cgroup.type, cgroup.stat, cgroup.max.descendants, pids.max and
// pids.current, memory.max, memory.current and memory.events, cpu.max and
// cpu.weight. Only root writes. pids.max is enforced: fork, vfork and clone
// (threads too) fail with EAGAIN once the group or one above it holds that
// many tasks, and so does moving a process in.
//
// cgroup.freeze: writing 1 stops the group's processes (and those below it,
// and any that move in or are made there) from being scheduled until 0 is
// written; cgroup.events shows "frozen 1". A process with a pending SIGKILL
// still runs, so that it can end.
//
// A cgroup namespace (unshare or clone with CLONE_NEWCGROUP) is named by its
// root, the group the process was in (NSK_CGN). A process in one sees that
// group as /sys/fs/cgroup (cg_view puts the root's path in front of what
// the path walk finds), and /proc/PID/cgroup is relative to it. A group that
// is the root of a namespace some process is in cannot be removed.
//
// cpu.max is enforced in timer ticks (cg_cpu_tick): a tick that finds a
// process running charges 10 ms to its group and those above it, and a group
// that has used its quota in the current period is not scheduled until the
// period ends; cpu.stat counts usage_usec, nr_periods and nr_throttled.
// cpu.weight shares the processors between sibling groups that have processes
// to run, in proportion to their weights (cg_weigh): each tick charges the
// running process's group (and those above it) CG_TICK_US scaled by
// 100 / weight, and a group whose charge is more than CG_LAG_US ahead of the
// least charged runnable sibling is not scheduled until the others catch up;
// a group that was not runnable starts level with the least charged one.
//
// memory.max is enforced in the same tick (cg_oom_tick): memory.current is the
// pages mapped in the group's address spaces, and a group over its limit loses
// the process with the most of them to SIGKILL (cg_oom); memory.events counts
// it. Mapping and forking are not refused for the limit.
//
// Not done: the "no internal processes" rule.

import "lxuser.bastio";

const CG_ROOT_LEN: u64 = 13;               // "sys/fs/cgroup"
const CG_ALL: u64 = 7;                     // controllers: cpu 1, memory 2, pids 4
const CG_BIG: u64 = 0x0100000000000000;    // limits read from a write stay below it

/// Word w of cgroup slot s in k.mns.
fn cg_at(s: u64, w: u64) -> u64
  requires s < CG_N && w < CG_W
  ensures result < MNS_LEN
{
  return MNS_CG + s * CG_W + w;
}

fn cg_get(k: &Kernel, s: u64, w: u64) -> u64
  requires kok(k) && s < CG_N && w < CG_W
{
  return get(k.mns, cg_at(s, w));
}

fn cg_put(k: &mut Kernel, s: u64, w: u64, v: u64)
  requires kok(k) && s < CG_N && w < CG_W
  ensures kok(k)
{
  k.mns = set(k.mns, cg_at(s, w), v);
}

/// Is slot s a cgroup? The root always is.
fn cg_used(k: &Kernel, s: u64) -> bool
  requires kok(k) && s < CG_N
{
  return s == 0 || cg_get(k, s, CGW_USED) == 1;
}

/// The parent of slot s (the root's is itself).
fn cg_parent(k: &Kernel, s: u64) -> u64
  requires kok(k) && s < CG_N
  ensures result < CG_N
{
  if s == 0 {
    return 0;
  }
  return smaller(cg_get(k, s, CGW_PARENT), CG_N - 1);
}

/// The cgroup process pid is in.
fn cg_of(k: &Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures result < CG_N
{
  return smaller(get(k.mns, nsk_at(NSK_CG, pid)), CG_N - 1);
}

/// Is cgroup s anc or below it?
fn cg_in(k: &Kernel, s: u64, anc: u64) -> bool
  requires kok(k) && s < CG_N && anc < CG_N
{
  let mut c = s;
  let mut i = 0;
  while i < CG_N
    invariant i <= CG_N && c < CG_N && kok(k)
  {
    if c == anc {
      return true;
    }
    if c == 0 {
      return false;
    }
    c = cg_parent(k, c);
    i = i + 1;
  }
  return false;
}

/// Is cgroup s frozen, or is one above it?
fn cg_frozen(k: &Kernel, s: u64) -> bool
  requires kok(k) && s < CG_N
{
  let mut c = s;
  let mut i = 0;
  while i < CG_N
    invariant i <= CG_N && c < CG_N && kok(k)
  {
    if cg_get(k, c, CGW_FRZ) == 1 {
      return true;
    }
    if c == 0 {
      return false;
    }
    c = cg_parent(k, c);
    i = i + 1;
  }
  return false;
}

/// Is process q kept from running by its cgroup's freeze? A pending SIGKILL
/// lets it run, so that it can end.
fn cg_held(k: &Kernel, q: u64) -> bool
  requires kok(k) && q < NPROC
{
  if pget(k.procs, q, F_SIGPEND) & sbit(9) != 0 {
    return false;
  }
  return cg_frozen(k, cg_of(k, q)) || cg_throttled(k, cg_of(k, q)) || cg_wheld(k, cg_of(k, q));
}

/// Is cgroup s, or one above it, out of its cpu.max quota for the period?
fn cg_throttled(k: &Kernel, s: u64) -> bool
  requires kok(k) && s < CG_N
{
  let mut c = s;
  let mut i = 0;
  while i < CG_N
    invariant i <= CG_N && c < CG_N && kok(k)
  {
    if cg_get(k, c, CGW_THR) == 1 {
      return true;
    }
    if c == 0 {
      return false;
    }
    c = cg_parent(k, c);
    i = i + 1;
  }
  return false;
}

const CG_TICK_US: u64 = 10000;             // one timer tick, in microseconds

const CG_LAG_US: u64 = 20000;              // how far ahead (in weighted microseconds) a group may run

/// cpu.weight of cgroup c (100 if it was never set).
fn cg_weight(k: &Kernel, c: u64) -> u64
  requires kok(k) && c < CG_N
  ensures 1 <= result && result <= 10000
{
  let w = cg_get(k, c, CGW_WEIGHT);
  if w < 1 || w > 10000 {
    return 100;
  }
  return w;
}

/// Is cgroup s, or one above it, held back by cpu.weight for now?
fn cg_wheld(k: &Kernel, s: u64) -> bool
  requires kok(k) && s < CG_N
{
  let mut c = s;
  let mut i = 0;
  while i < CG_N
    invariant i <= CG_N && c < CG_N && kok(k)
  {
    if cg_get(k, c, CGW_WST) % 2 == 1 {
      return true;
    }
    if c == 0 {
      return false;
    }
    c = cg_parent(k, c);
    i = i + 1;
  }
  return false;
}

/// Weighs the sibling groups against each other (see the comment at the top
/// of the file): marks the groups that have a process to run, and holds back
/// each one that has had more than its share. Nothing is held while every
/// group has the default weight.
fn cg_weigh(k: &mut Kernel)
  requires kok(k)
  ensures kok(k)
{
  let mut on = false;
  let mut c = 1;
  while c < CG_N
    invariant 1 <= c && c <= CG_N && kok(k)
  {
    let w = cg_get(k, c, CGW_WEIGHT);
    if cg_used(k, c) && w != 0 && w != 100 {
      on = true;
    }
    c = c + 1;
  }
  if !on {
    c = 0;
    while c < CG_N
      invariant c <= CG_N && kok(k)
    {
      cg_put(&mut k, c, CGW_WST, 0);
      c = c + 1;
    }
    return;
  }
  // Which groups have a process that could run: not asleep in a system
  // call, not frozen or out of cpu.max quota.
  c = 0;
  while c < CG_N
    invariant c <= CG_N && kok(k)
  {
    cg_put(&mut k, c, CGW_WST, cg_get(k, c, CGW_WST) % 4);
    c = c + 1;
  }
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if (state(k.procs, q) == READY || state(k.procs, q) == RUNNING) && pget(k.procs, q, F_RESTART) == 0 {
      let g = cg_of(k, q);
      if !cg_frozen(k, g) && !cg_throttled(k, g) {
        let mut a = g;
        let mut i = 0;
        while i < CG_N
          invariant i <= CG_N && a < CG_N && kok(k)
        {
          let st = cg_get(k, a, CGW_WST);
          if st / 4 % 2 == 0 {
            cg_put(&mut k, a, CGW_WST, st + 4);
          }
          if a == 0 {
            i = CG_N;
          } else {
            a = cg_parent(k, a);
            i = i + 1;
          }
        }
      }
    }
    q = q + 1;
  }
  // A group that has just become runnable starts level with the least
  // charged runnable sibling, so that it cannot hold the others back for
  // the time it slept.
  c = 1;
  while c < CG_N
    invariant 1 <= c && c <= CG_N && kok(k)
  {
    let st = cg_get(k, c, CGW_WST);
    if cg_used(k, c) && st / 4 % 2 == 1 && st / 2 % 2 == 0 {
      let mut m = CG_BIG;
      let mut b = 1;
      while b < CG_N
        invariant 1 <= b && b <= CG_N && m <= CG_BIG && kok(k)
      {
        if b != c && cg_used(k, b) && cg_parent(k, b) == cg_parent(k, c) && cg_get(k, b, CGW_WST) / 2 % 2 == 1 {
          m = smaller(m, cg_get(k, b, CGW_VRUN));
        }
        b = b + 1;
      }
      if m < CG_BIG && cg_get(k, c, CGW_VRUN) < m {
        cg_put(&mut k, c, CGW_VRUN, m);
      }
    }
    c = c + 1;
  }
  c = 1;
  while c < CG_N
    invariant 1 <= c && c <= CG_N && kok(k)
  {
    let st = cg_get(k, c, CGW_WST);
    let run = st / 4 % 2;
    let mut held = 0;
    if cg_used(k, c) && run == 1 {
      let mut m = CG_BIG;
      let mut b = 1;
      while b < CG_N
        invariant 1 <= b && b <= CG_N && m <= CG_BIG && kok(k)
      {
        if cg_used(k, b) && cg_parent(k, b) == cg_parent(k, c) && cg_get(k, b, CGW_WST) / 4 % 2 == 1 {
          m = smaller(m, cg_get(k, b, CGW_VRUN));
        }
        b = b + 1;
      }
      let mine = cg_get(k, c, CGW_VRUN);
      if m < CG_BIG && mine > m {
        if mine - m > CG_LAG_US {
          held = 1;
        }
      }
    }
    cg_put(&mut k, c, CGW_WST, held + run * 6);
    c = c + 1;
  }
}

/// A timer tick found process p running: every group with a cpu.max whose
/// period has ended starts a new one (counting it, and whether it ran out
/// of quota), and the tick is charged to p's group and those above it; a
/// group that has used its quota is throttled until its period ends
/// (cg_held keeps its processes from being scheduled).
fn cg_cpu_tick(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  cg_weigh(&mut k);
  let now = k.ns;
  let mut c = 0;
  while c < CG_N
    invariant c <= CG_N && kok(k)
  {
    let q = cg_get(k, c, CGW_CPUQ);
    if cg_used(k, c) && q != 0 {
      let mut per = cg_get(k, c, CGW_CPUP);
      if per == 0 {
        per = 100000;
      }
      let st = cg_get(k, c, CGW_CPUS);
      if st > now || now - st >= smaller(per, 1000000) * 1000 {
        cg_put(&mut k, c, CGW_NPER, sat_add(cg_get(k, c, CGW_NPER), 1));
        if cg_get(k, c, CGW_THR) == 1 {
          cg_put(&mut k, c, CGW_NTHR, sat_add(cg_get(k, c, CGW_NTHR), 1));
        }
        cg_put(&mut k, c, CGW_THR, 0);
        cg_put(&mut k, c, CGW_CPUU, 0);
        cg_put(&mut k, c, CGW_CPUS, now);
      }
    }
    c = c + 1;
  }
  if p == 0 {
    return;
  }
  let mut g = cg_of(k, p);
  let mut i = 0;
  while i < CG_N
    invariant i <= CG_N && g < CG_N && kok(k)
  {
    cg_put(&mut k, g, CGW_USEC, sat_add(cg_get(k, g, CGW_USEC), CG_TICK_US));
    cg_put(&mut k, g, CGW_VRUN, sat_add(cg_get(k, g, CGW_VRUN), CG_TICK_US * 100 / cg_weight(k, g)));
    let q = cg_get(k, g, CGW_CPUQ);
    if q != 0 {
      let u = sat_add(cg_get(k, g, CGW_CPUU), CG_TICK_US);
      cg_put(&mut k, g, CGW_CPUU, u);
      if u >= q - 1 {
        cg_put(&mut k, g, CGW_THR, 1);
      }
    }
    if g == 0 {
      return;
    }
    g = cg_parent(k, g);
    i = i + 1;
  }
}

/// Is row q a task (not free, not a zombie)?
fn cg_live(k: &Kernel, q: u64) -> bool
  requires kok(k) && q < NPROC
{
  let s = pget(k.procs, q, F_STATE);
  return s != FREE && s != ZOMBIE;
}

/// How many tasks (threads count) are in cgroup anc or below it.
fn cg_tasks(k: &Kernel, anc: u64) -> u64
  requires kok(k) && anc < CG_N
  ensures result <= NPROC
{
  let mut n = 0;
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && n < q && kok(k)
  {
    if cg_live(k, q) && cg_in(k, cg_of(k, q), anc) {
      n = n + 1;
    }
    q = q + 1;
  }
  return n;
}

/// Number of child cgroups of s.
fn cg_children(k: &Kernel, s: u64) -> u64
  requires kok(k) && s < CG_N
  ensures result <= CG_N
{
  let mut n = 0;
  let mut c = 1;
  while c < CG_N
    invariant 1 <= c && c <= CG_N && n < c && kok(k)
  {
    if cg_used(k, c) && cg_parent(k, c) == s {
      n = n + 1;
    }
    c = c + 1;
  }
  return n;
}

/// Number of cgroups below s, at any depth.
fn cg_descendants(k: &Kernel, s: u64) -> u64
  requires kok(k) && s < CG_N
  ensures result <= CG_N
{
  let mut n = 0;
  let mut c = 1;
  while c < CG_N
    invariant 1 <= c && c <= CG_N && n < c && kok(k)
  {
    if cg_used(k, c) && c != s && cg_in(k, c, s) {
      n = n + 1;
    }
    c = c + 1;
  }
  return n;
}

/// Whether process pid may make one more task: no cgroup from its own up
/// to the root is at its pids.max.
fn cg_fork_ok(k: &Kernel, pid: u64) -> bool
  requires kok(k) && pid < NPROC
{
  return cg_room(k, cg_of(k, pid));
}

/// Whether cgroup s could take one more task: neither it nor a group
/// above it is at its pids.max.
fn cg_room(k: &Kernel, s: u64) -> bool
  requires kok(k) && s < CG_N
{
  let mut c = s;
  let mut i = 0;
  while i < CG_N
    invariant i <= CG_N && c < CG_N && kok(k)
  {
    let lim = cg_get(k, c, CGW_PIDS);
    if lim != 0 && cg_tasks(k, c) + 1 > lim - 1 {
      return false;
    }
    if c == 0 {
      return true;
    }
    c = cg_parent(k, c);
    i = i + 1;
  }
  return true;
}

// ---------------------------------------------------------------- names

/// The name of control file f.
fn cgf_name(f: u64) -> Str {
  if f == 0 {
    return "cgroup.procs";
  }
  if f == 1 {
    return "cgroup.controllers";
  }
  if f == 2 {
    return "cgroup.subtree_control";
  }
  if f == 3 {
    return "cgroup.events";
  }
  if f == 4 {
    return "cgroup.kill";
  }
  if f == 5 {
    return "cgroup.type";
  }
  if f == 6 {
    return "cgroup.threads";
  }
  if f == 7 {
    return "cgroup.stat";
  }
  if f == 8 {
    return "pids.max";
  }
  if f == 9 {
    return "pids.current";
  }
  if f == 10 {
    return "memory.max";
  }
  if f == 11 {
    return "memory.current";
  }
  if f == 12 {
    return "memory.events";
  }
  if f == 13 {
    return "cpu.max";
  }
  if f == 14 {
    return "cpu.weight";
  }
  if f == 15 {
    return "cgroup.max.descendants";
  }
  if f == 16 {
    return "cgroup.freeze";
  }
  return "cpu.stat";
}

/// Which control file x[a..b] names, or CGF_N.
fn cgf_at(x: &Bytes, a: u64, b: u64) -> u64
  requires a <= b && b <= blen(x)
  ensures result <= CGF_N
{
  let mut f = 0;
  while f < CGF_N
    invariant f <= CGF_N
  {
    if xfer_is(x, a, b, cgf_name(f)) {
      return f;
    }
    f = f + 1;
  }
  return CGF_N;
}

/// Whether root may write control file f.
fn cgf_writable(f: u64) -> bool {
  return f == 0 || f == 2 || f == 4 || f == 6 || f == 8 || f == 10 || f == 13 || f == 14 || f == 16;
}

/// Does cgroup s have the name x[a..b]?
fn cg_name_is(k: &Kernel, s: u64, x: &Bytes, a: u64, b: u64) -> bool
  requires kok(k) && s < CG_N && a <= b && b <= blen(x)
{
  let l = cg_get(k, s, CGW_NLEN);
  if l != b - a || l > CG_NAME_MAX {
    return false;
  }
  let mut i = 0;
  while i < l
    invariant i <= l && l <= CG_NAME_MAX && a + l == b && b <= blen(x) && s < CG_N && kok(k)
  {
    if cg_get(k, s, CGW_NAME + i) != cast[u64](bget(x, a + i)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// The child of cgroup par called x[a..b], or CG_N.
fn cg_child(k: &Kernel, par: u64, x: &Bytes, a: u64, b: u64) -> u64
  requires kok(k) && par < CG_N && a <= b && b <= blen(x)
  ensures result <= CG_N
{
  let mut c = 1;
  while c < CG_N
    invariant 1 <= c && c <= CG_N && kok(k)
  {
    if cg_used(k, c) && cg_parent(k, c) == par && cg_name_is(k, c, x, a, b) {
      return c;
    }
    c = c + 1;
  }
  return CG_N;
}

// What a path under sys/fs/cgroup names.
struct CgRef { kind: u64, slot: u64, f: u64 }   // kind: 0 nothing, 1 a cgroup, 2 a control file

const CGK_NONE: u64 = 0;
const CGK_DIR: u64 = 1;
const CGK_FILE: u64 = 2;

/// Is the name in the first n bytes of the transfer buffer sys/fs/cgroup or
/// something under it?
fn cg_under(k: &Kernel, n: u64) -> bool
  requires kok(k) && n <= FNAME_MAX
{
  if n < CG_ROOT_LEN || !xfer_is(k.fs.xfer, 0, CG_ROOT_LEN, "sys/fs/cgroup") {
    return false;
  }
  return n == CG_ROOT_LEN || bget(k.fs.xfer, CG_ROOT_LEN) == 47;
}

/// What the first n bytes of the transfer buffer name.
fn cg_walk(k: &Kernel, n: u64) -> CgRef
  requires kok(k) && n <= FNAME_MAX
  ensures result.slot < CG_N && result.f < CGF_N
{
  let none = CgRef { kind: CGK_NONE, slot: 0, f: 0 };
  if n < CG_ROOT_LEN || !cg_under(k, n) {
    return none;
  }
  let mut cur = 0;
  let mut at = CG_ROOT_LEN + 1;
  let mut i = 0;
  while at < n && i < CG_N
    invariant CG_ROOT_LEN < at && at <= n + 1 && n <= FNAME_MAX && cur < CG_N && i <= CG_N && kok(k)
  {
    let e = comp_end(k.fs.xfer, at, n);
    if e == at {
      return none;                          // "//"
    }
    let ch = cg_child(k, cur, k.fs.xfer, at, e);
    if ch < CG_N {
      cur = ch;
      at = e + 1;
      i = i + 1;
    } else {
      let f = cgf_at(k.fs.xfer, at, e);
      if f < CGF_N && e == n {
        return CgRef { kind: CGK_FILE, slot: cur, f: f };
      }
      return none;
    }
  }
  return CgRef { kind: CGK_DIR, slot: cur, f: 0 };
}

/// The directory description for the name in the transfer buffer if it is
/// a cgroup, else NO_FILE.
fn cg_dir(k: &Kernel, n: u64) -> u64
  requires kok(k) && n <= FNAME_MAX
{
  let r = cg_walk(k, n);
  if r.kind == CGK_DIR {
    return DIR_CG + r.slot;
  }
  return NO_FILE;
}

/// The /proc-style device of the control file the name in the transfer
/// buffer names, or 0.
fn cg_file(k: &Kernel, n: u64) -> u64
  requires kok(k) && n <= FNAME_MAX
{
  let r = cg_walk(k, n);
  if r.kind == CGK_FILE && r.slot < CG_N && r.f < CGF_N {
    return PROC_DEV + PSYS + SY_CG + r.slot * CGF_N + r.f;
  }
  return 0;
}

/// The /proc file or control file the name in the transfer buffer is, or 0.
fn proc_node(k: &Kernel, n: u64) -> u64
  requires kok(k) && n <= FNAME_MAX
{
  let p = proc_file(k.procs, k.fs.xfer, n);
  if p != 0 {
    return p;
  }
  return cg_file(k, n);
}

/// Is /proc device d a control file?
fn is_cg_file(d: u64) -> bool
  ensures result == (d >= PROC_DEV + PSYS + SY_CG && d < PROC_DEV + PSYS + SY_CG + CG_N * CGF_N)
{
  return d >= PROC_DEV + PSYS + SY_CG && d < PROC_DEV + PSYS + SY_CG + CG_N * CGF_N;
}

/// The cgroup of control file d.
fn cgd_slot(d: u64) -> u64
  requires d >= PROC_DEV + PSYS + SY_CG && d < PROC_DEV + PSYS + SY_CG + CG_N * CGF_N
  ensures result < CG_N
{
  return (d - PROC_DEV - PSYS - SY_CG) / CGF_N;
}

/// Which control file d is.
fn cgd_f(d: u64) -> u64
  ensures result < CGF_N
{
  if d < PROC_DEV + PSYS + SY_CG {
    return 0;
  }
  return (d - PROC_DEV - PSYS - SY_CG) % CGF_N;
}

/// What stat says about cgroup directory d.
fn cg_dir_meta(d: u64) -> Meta {
  return Meta { ok: true, mode: S_IFDIR, size: 0, ino: INO_PROC + 8192 + d % 64, mtime: 0, own: 0 };
}

/// What stat says about control file d: rw-r--r-- if root writes it.
fn cg_file_meta(d: u64) -> Meta {
  let mut mode = S_IFREG_RO;
  if cgf_writable(cgd_f(d)) {
    mode = 0x81A4;
  }
  return Meta { ok: true, mode: mode, size: 0, ino: INO_PROC + 8192 + 64 + d % 4096, mtime: 0, own: 0 };
}

/// Entry i of cgroup s's directory: its control files, then its children.
fn cg_entry(k: &mut Kernel, s: u64, i: u64) -> Ent
  requires kok(k) && s < CG_N
  ensures kok(k) && result.len <= XFER
{
  if i < CGF_N {
    return Ent { len: name_out(&mut k.fs.xfer, cgf_name(i)), dir: false, end: false };
  }
  let mut want = i - CGF_N;
  let mut c = 1;
  while c < CG_N
    invariant 1 <= c && c <= CG_N && kok(k)
  {
    if cg_used(k, c) && cg_parent(k, c) == s {
      if want == 0 {
        let l = smaller(cg_get(k, c, CGW_NLEN), CG_NAME_MAX);
        let mut j = 0;
        while j < l
          invariant j <= l && l <= CG_NAME_MAX && c < CG_N && kok(k)
        {
          bset(&mut k.fs.xfer, j, cast[u8](cg_get(k, c, CGW_NAME + j) % 256));
          j = j + 1;
        }
        return Ent { len: l, dir: true, end: false };
      }
      want = want - 1;
    }
    c = c + 1;
  }
  return Ent { len: 0, dir: false, end: true };
}

// ---------------------------------------------------------------- text

/// The controllers cgroup s has: what its parent hands down.
fn cg_avail(k: &Kernel, s: u64) -> u64
  requires kok(k) && s < CG_N
  ensures result <= CG_ALL
{
  if s == 0 {
    return CG_ALL;
  }
  return cg_get(k, cg_parent(k, s), CGW_SUB) % (CG_ALL + 1);
}

/// "cpu memory pids" for the controllers in bits.
fn put_ctrls(o: &mut Bytes, at: u64, bits: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  let mut first = true;
  if bits & 1 != 0 {
    a = put_s(&mut o, a, "cpu");
    first = false;
  }
  if bits & 2 != 0 {
    if !first {
      a = put_c(&mut o, a, 32);
    }
    a = put_s(&mut o, a, "memory");
    first = false;
  }
  if bits & 4 != 0 {
    if !first {
      a = put_c(&mut o, a, 32);
    }
    a = put_s(&mut o, a, "pids");
  }
  return put_c(&mut o, a, 10);
}

/// The members of cgroup s, one id a line, as process obs sees them;
/// only thread group leaders unless threads.
fn cg_members(k: &Kernel, obs: u64, s: u64, threads: bool, o: &mut Bytes) -> u64
  requires kok(k) && obs < NPROC && s < CG_N && blen(o) == PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = 0;
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
  {
    if cg_live(k, q) && cg_of(k, q) == s && (threads || tgid(k.procs, q) == q) {
      let v = vpid_of(k, obs, q);
      if v != 0 {
        a = put_n(&mut o, a, v);
        a = put_c(&mut o, a, 10);
      }
    }
    q = q + 1;
  }
  return a;
}

/// A limit stored +1 (0: max).
fn put_lim(o: &mut Bytes, at: u64, w: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  if w == 0 {
    return put_s(&mut o, at, "max\n");
  }
  let a = put_n(&mut o, at, w - 1);
  return put_c(&mut o, a, 10);
}

/// Text of control file d, read by process pid.
fn cg_text(k: &mut Kernel, pid: u64, d: u64, o: &mut Bytes) -> u64
  requires kok(k) && pid < NPROC && d >= PROC_DEV + PSYS + SY_CG && d < PROC_DEV + PSYS + SY_CG + CG_N * CGF_N && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let s = cgd_slot(d);
  let f = cgd_f(d);
  if !cg_used(k, s) {
    return 0;
  }
  if f == 0 || f == 6 {
    return cg_members(k, pid, s, f == 6, &mut o);
  }
  if f == 1 {
    return put_ctrls(&mut o, 0, cg_avail(k, s));
  }
  if f == 2 {
    return put_ctrls(&mut o, 0, cg_get(k, s, CGW_SUB) % (CG_ALL + 1));
  }
  if f == 3 {
    let mut a = 0;
    if cg_tasks(k, s) > 0 {
      a = put_s(&mut o, 0, "populated 1\nfrozen ");
    } else {
      a = put_s(&mut o, 0, "populated 0\nfrozen ");
    }
    if cg_frozen(k, s) {
      a = put_c(&mut o, a, 49);
    } else {
      a = put_c(&mut o, a, 48);
    }
    return put_c(&mut o, a, 10);
  }
  if f == 5 {
    return put_s(&mut o, 0, "domain\n");
  }
  if f == 7 {
    let mut a = put_s(&mut o, 0, "nr_descendants ");
    a = put_n(&mut o, a, cg_descendants(k, s));
    return put_s(&mut o, a, "\nnr_dying_descendants 0\n");
  }
  if f == 8 {
    return put_lim(&mut o, 0, cg_get(k, s, CGW_PIDS));
  }
  if f == 9 {
    let a = put_n(&mut o, 0, cg_tasks(k, s));
    return put_c(&mut o, a, 10);
  }
  if f == 10 {
    return put_lim(&mut o, 0, cg_get(k, s, CGW_MEM));
  }
  if f == 11 {
    let a = put_n(&mut o, 0, cg_mem_current(&mut k, s));
    return put_c(&mut o, a, 10);
  }
  if f == 12 {
    let mut a = put_s(&mut o, 0, "low 0\nhigh 0\nmax ");
    a = put_n(&mut o, a, cg_get(k, s, CGW_MAXE));
    a = put_s(&mut o, a, "\noom ");
    a = put_n(&mut o, a, cg_get(k, s, CGW_MAXE));
    a = put_s(&mut o, a, "\noom_kill ");
    a = put_n(&mut o, a, cg_get(k, s, CGW_OOMK));
    return put_c(&mut o, a, 10);
  }
  if f == 13 {
    let q = cg_get(k, s, CGW_CPUQ);
    let mut p = cg_get(k, s, CGW_CPUP);
    if p == 0 {
      p = 100000;
    }
    let mut a = 0;
    if q == 0 {
      a = put_s(&mut o, 0, "max ");
    } else {
      a = put_n(&mut o, 0, q - 1);
      a = put_c(&mut o, a, 32);
    }
    a = put_n(&mut o, a, p);
    return put_c(&mut o, a, 10);
  }
  if f == 14 {
    let mut w = cg_get(k, s, CGW_WEIGHT);
    if w == 0 {
      w = 100;
    }
    let a = put_n(&mut o, 0, w);
    return put_c(&mut o, a, 10);
  }
  if f == 15 {
    return put_s(&mut o, 0, "max\n");
  }
  if f == 16 {
    if cg_get(k, s, CGW_FRZ) == 1 {
      return put_s(&mut o, 0, "1\n");
    }
    return put_s(&mut o, 0, "0\n");
  }
  if f == 17 {
    let u = cg_get(k, s, CGW_USEC);
    let mut a = put_s(&mut o, 0, "usage_usec ");
    a = put_n(&mut o, a, u);
    a = put_s(&mut o, a, "\nuser_usec ");
    a = put_n(&mut o, a, u);
    a = put_s(&mut o, a, "\nsystem_usec 0\nnr_periods ");
    a = put_n(&mut o, a, cg_get(k, s, CGW_NPER));
    a = put_s(&mut o, a, "\nnr_throttled ");
    a = put_n(&mut o, a, cg_get(k, s, CGW_NTHR));
    return put_c(&mut o, a, 10);
  }
  return 0;                                 // cgroup.kill is write-only
}

/// The pages mapped in the address space of row q, or 0 when they cannot
/// be counted now (another processor runs the space).
fn cg_resident(k: &mut Kernel, q: u64) -> u64
  requires kok(k) && q < NPROC
  ensures kok(k) && result <= WPAGES
{
  if !has_space(&mut k.spaces, q) {
    return 0;
  }
  let c = win_op(&mut k.mem, &mut k.spaces, q, WOP_COUNT, 0, WPAGES, 0);
  if c > WPAGES {
    return 0;
  }
  return c;
}

/// memory.current of cgroup s: the bytes of memory the processes in it and
/// below it have, counting each address space once and every page it has
/// mapped (what is resident: a mapping nobody has touched is not counted),
/// not the page cache or the kernel's own memory.
fn cg_mem_current(k: &mut Kernel, s: u64) -> u64
  requires kok(k) && s < CG_N
  ensures kok(k) && result <= 0x100000000000000
{
  let mut pages = 0;
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && pages <= (q - 1) * WPAGES && kok(k)
  {
    if cg_live(k, q) && tgid(k.procs, q) == q && cg_in(k, cg_of(k, q), s) {
      pages = pages + cg_resident(&mut k, q);
    }
    q = q + 1;
  }
  return pages * 4096;
}

/// Has a task of cgroup s or below a SIGKILL it has not yet died of?
fn cg_dying(k: &Kernel, s: u64) -> bool
  requires kok(k) && s < CG_N
{
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if cg_live(k, q) && cg_in(k, cg_of(k, q), s) && pget(k.procs, q, F_SIGPEND) & sbit(SIGKILL) != 0 {
      return true;
    }
    q = q + 1;
  }
  return false;
}

/// cgroup s, or one below it, has passed its memory.max: the process with
/// the most pages in it is killed with all its threads (SIGKILL), as the
/// out-of-memory killer does after reclaim finds nothing to free. There is
/// no reclaim here. memory.events counts the event and the kill.
fn cg_oom(k: &mut Kernel, s: u64)
  requires kok(k) && s < CG_N
  ensures kok(k)
{
  if cg_dying(k, s) {
    return;                                 // the memory of the last victim is not back yet
  }
  let mut v = 0;
  let mut best = 0;
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && v < NPROC && kok(k)
  {
    if cg_live(k, q) && tgid(k.procs, q) == q && cg_in(k, cg_of(k, q), s) {
      let r = cg_resident(&mut k, q);
      if r > best {
        best = r;
        v = q;
      }
    }
    q = q + 1;
  }
  if v == 0 {
    return;
  }
  cg_put(&mut k, s, CGW_MAXE, sat_add(cg_get(k, s, CGW_MAXE), 1));
  cg_put(&mut k, s, CGW_OOMK, sat_add(cg_get(k, s, CGW_OOMK), 1));
  let mut r = 1;
  while r < NPROC
    invariant 1 <= r && r <= NPROC && kok(k)
  {
    if cg_live(k, r) && (r == v || in_group(k.procs, r, v)) {
      post_sig(&mut k, r, 9);
    }
    r = r + 1;
  }
}

/// A timer tick found process p running: if its group or one above it has
/// more memory than its memory.max, the out-of-memory killer runs there.
/// This is where memory.max is enforced: memory is counted when it is
/// resident, so a program that maps more than it uses is not touched, and
/// one that goes on touching what it mapped is killed within a few ticks.
fn cg_oom_tick(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  if p == 0 {
    return;
  }
  let mut c = cg_of(k, p);
  let mut i = 0;
  while i < CG_N
    invariant i <= CG_N && c < CG_N && kok(k)
  {
    let lim = cg_get(k, c, CGW_MEM);
    if lim != 0 && lim <= 0x100000000000000 && cg_mem_current(&mut k, c) > lim - 1 {
      cg_oom(&mut k, c);
      return;
    }
    if c == 0 {
      return;
    }
    c = cg_parent(k, c);
    i = i + 1;
  }
}

/// The root of process pid's cgroup namespace: the group it was in when it
/// unshared (0 in the first namespace).
fn cgns_root(k: &Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures result < CG_N
{
  let id = nsk_of(k, NSK_CGN, pid);
  if id == 0 {
    return 0;
  }
  return smaller(id - 1, CG_N - 1);
}

/// unshare(CLONE_NEWCGROUP) or clone with it: the group the process is in
/// becomes the root of its cgroup namespace. A namespace is named by its
/// root, so one made at the root group is the first namespace.
fn cgns_unshare(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let c = cg_of(k, pid);
  if c == 0 {
    nsk_set(&mut k, NSK_CGN, pid, 0);
  } else {
    nsk_set(&mut k, NSK_CGN, pid, c + 1);
  }
}

/// Does any process (not a zombie) have group s as the root of its cgroup
/// namespace?
fn cgns_held(k: &Kernel, s: u64) -> bool
  requires kok(k) && s < CG_N
{
  let mut q = 0;
  while q < NPROC
    invariant q <= NPROC && kok(k)
  {
    let st = pget(k.procs, q, F_STATE);
    if st != FREE && st != ZOMBIE && get(k.mns, nsk_at(NSK_CGN, q)) == s + 1 {
      return true;
    }
    q = q + 1;
  }
  return false;
}

/// The path of the file layer for a name under sys/fs/cgroup as process pid
/// sees it: its cgroup namespace's root is the top of the tree, so the name
/// is looked up below that group's directory. The name is in the first n
/// bytes of the transfer buffer. Returns the new length, or NO_RESULT with
/// k.perr set if it grows too long.
fn cg_view(k: &mut Kernel, n: u64, pid: u64) -> u64
  requires kok(k) && pid < NPROC && n <= FNAME_MAX
  ensures kok(k)
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  let root = cgns_root(k, pid);
  if root == 0 || n < CG_ROOT_LEN || !cg_under(k, n) {
    return n;
  }
  // The groups from the root of the tree down to the namespace's root.
  let mut chain = balloc(CG_N);
  let mut depth = 0;
  let mut c = root;
  while c != 0 && depth < CG_N
    invariant depth <= CG_N && c < CG_N && blen(chain) == CG_N && kok(k)
  {
    bset(&mut chain, depth, cast[u8](c));
    depth = depth + 1;
    c = cg_parent(k, c);
  }
  let mut grow = depth;                     // a "/" before each name
  let mut i = 0;
  while i < depth
    invariant i <= depth && depth <= CG_N && grow <= depth + i * CG_NAME_MAX && blen(chain) == CG_N && kok(k)
  {
    let s = smaller(cast[u64](bget(chain, i)), CG_N - 1);
    grow = grow + smaller(cg_get(k, s, CGW_NLEN), CG_NAME_MAX);
    i = i + 1;
  }
  if n + grow > FNAME_MAX {
    bfree(chain);
    k.perr = ENAMETOOLONG;
    return NO_RESULT;
  }
  let mut j = n;
  while j > CG_ROOT_LEN
    invariant CG_ROOT_LEN <= j && j <= n && n + grow <= FNAME_MAX && kok(k)
  {
    j = j - 1;
    bset(&mut k.fs.xfer, j + grow, bget(k.fs.xfer, j));
  }
  let mut w = CG_ROOT_LEN;
  i = depth;
  while i > 0
    invariant i <= depth && depth <= CG_N && w <= CG_ROOT_LEN + grow && n + grow <= FNAME_MAX && blen(chain) == CG_N && kok(k)
  {
    i = i - 1;
    let s = smaller(cast[u64](bget(chain, i)), CG_N - 1);
    let l = smaller(cg_get(k, s, CGW_NLEN), CG_NAME_MAX);
    if w + 1 + l > CG_ROOT_LEN + grow {
      bfree(chain);
      return n;                             // not reached: grow counted every name
    }
    bset(&mut k.fs.xfer, w, 47);
    w = w + 1;
    let mut m = 0;
    while m < l
      invariant m <= l && l <= CG_NAME_MAX && s < CG_N && w + (l - m) <= CG_ROOT_LEN + grow && n + grow <= FNAME_MAX && kok(k)
    {
      bset(&mut k.fs.xfer, w, cast[u8](cg_get(k, s, CGW_NAME + m) % 256));
      w = w + 1;
      m = m + 1;
    }
  }
  bfree(chain);
  return n + grow;
}

/// Text of /proc/PID/cgroup as process reader sees it: "0::/path", the path
/// from the root of the reader's cgroup namespace, with "/.." for each group
/// it has to go up to reach a process outside it.
fn cg_proc_text(k: &Kernel, p: u64, reader: u64, o: &mut Bytes) -> u64
  requires kok(k) && p < NPROC && reader < NPROC && blen(o) == PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let root = cgns_root(k, reader);
  // The nearest group at or above the process that is also at or above the
  // namespace's root: the path goes up from the root to it, then down.
  let mut anc = cg_of(k, p);
  let mut guard = 0;
  while !cg_in(k, root, anc) && guard < CG_N
    invariant guard <= CG_N && anc < CG_N && root < CG_N && kok(k)
  {
    anc = cg_parent(k, anc);
    guard = guard + 1;
  }
  // The names are built from the leaf up, so collect the chain first.
  let mut chain = balloc(CG_N);
  let mut depth = 0;
  let mut c = cg_of(k, p);
  while c != anc && c != 0 && depth < CG_N
    invariant depth <= CG_N && c < CG_N && blen(chain) == CG_N && kok(k)
  {
    bset(&mut chain, depth, cast[u8](c));
    depth = depth + 1;
    c = cg_parent(k, c);
  }
  let mut a = put_s(&mut o, 0, "0::");
  let mut r = root;
  let mut up = 0;
  while r != anc && r != 0 && up < CG_N
    invariant up <= CG_N && r < CG_N && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
  {
    a = put_s(&mut o, a, "/..");
    r = cg_parent(k, r);
    up = up + 1;
  }
  if up == 0 && depth == 0 {
    a = put_c(&mut o, a, 47);
  }
  let mut i = depth;
  while i > 0
    invariant i <= depth && depth <= CG_N && a <= PROC_OUT && blen(o) == PROC_OUT && blen(chain) == CG_N && kok(k)
  {
    i = i - 1;
    let s = smaller(cast[u64](bget(chain, i)), CG_N - 1);
    let l = smaller(cg_get(k, s, CGW_NLEN), CG_NAME_MAX);
    a = put_c(&mut o, a, 47);
    let mut j = 0;
    while j < l
      invariant j <= l && l <= CG_NAME_MAX && s < CG_N && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
    {
      a = put_c(&mut o, a, cast[u8](cg_get(k, s, CGW_NAME + j) % 256));
      j = j + 1;
    }
  }
  bfree(chain);
  return put_c(&mut o, a, 10);
}

// ---------------------------------------------------------------- writing

/// A number from x[at..n] (blanks around, then digits): below CG_BIG, or
/// CG_BIG for none or too many. The text "max" is CG_BIG - 1.
struct Big { v: u64, ok: bool }

fn big_at(x: &Bytes, at: u64, n: u64) -> Big
  requires n <= blen(x) && at <= n
{
  let mut i = at;
  while i < n && (bget(x, i) == 32 || bget(x, i) == 9)
    invariant at <= i && i <= n && n <= blen(x)
  {
    i = i + 1;
  }
  if i + 3 <= n && xfer_is(x, i, i + 3, "max") {
    return Big { v: CG_BIG - 1, ok: true };
  }
  let from = i;
  let mut v = 0;
  while i < n && bget(x, i) >= 48 && bget(x, i) <= 57 && v < CG_BIG
    invariant from <= i && i <= n && n <= blen(x) && v <= CG_BIG * 10
  {
    v = v * 10 + cast[u64](bget(x, i)) - 48;
    i = i + 1;
  }
  if i == from || v >= CG_BIG {
    return Big { v: CG_BIG, ok: false };
  }
  return Big { v: v, ok: true };
}

/// Whether x[at..n] is only blanks and newlines.
fn only_blank(x: &Bytes, at: u64, n: u64) -> bool
  requires n <= blen(x) && at <= n
{
  let mut i = at;
  while i < n
    invariant at <= i && i <= n && n <= blen(x)
  {
    let c = bget(x, i);
    if c != 32 && c != 9 && c != 10 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// Where the number big_at read from at ends.
fn big_end(x: &Bytes, at: u64, n: u64) -> u64
  requires n <= blen(x) && at <= n
  ensures at <= result && result <= n
{
  let mut i = at;
  while i < n && (bget(x, i) == 32 || bget(x, i) == 9)
    invariant at <= i && i <= n && n <= blen(x)
  {
    i = i + 1;
  }
  if i + 3 <= n && xfer_is(x, i, i + 3, "max") {
    return i + 3;
  }
  while i < n && bget(x, i) >= 48 && bget(x, i) <= 57
    invariant at <= i && i <= n && n <= blen(x)
  {
    i = i + 1;
  }
  return i;
}

/// Moves the task group of row q into cgroup dest.
fn cg_move(k: &mut Kernel, q: u64, dest: u64)
  requires kok(k) && q < NPROC && dest < CG_N
  ensures kok(k)
{
  let g = tgid(k.procs, q);
  let mut r = 1;
  while r < NPROC
    invariant 1 <= r && r <= NPROC && kok(k)
  {
    if cg_live(k, r) && (r == q || in_group(k.procs, r, g)) {
      k.mns = set(k.mns, nsk_at(NSK_CG, r), dest);
    }
    r = r + 1;
  }
}

/// Tasks in the group of row q.
fn cg_group_tasks(k: &Kernel, q: u64) -> u64
  requires kok(k) && q < NPROC
  ensures result <= NPROC
{
  let g = tgid(k.procs, q);
  let mut n = 0;
  let mut r = 1;
  while r < NPROC
    invariant 1 <= r && r <= NPROC && n < r && kok(k)
  {
    if cg_live(k, r) && (r == q || in_group(k.procs, r, g)) {
      n = n + 1;
    }
    r = r + 1;
  }
  return n;
}

/// Write of a process id to cgroup.procs or cgroup.threads of cgroup s by
/// pid: the process moves, with its threads.
fn cg_write_procs(k: &mut Kernel, pid: u64, s: u64, v: u64) -> u64
  requires kok(k) && pid < NPROC && s < CG_N
  ensures kok(k)
{
  let mut q = pid;
  if v != 0 {
    q = kpid_of(k, pid, v);
  }
  if q >= NPROC || q == 0 || !cg_live(k, q) {
    return ESRCH;
  }
  let from = cg_of(k, q);
  if from == s {
    return 0;
  }
  // Each cgroup on the way up from the destination, that the process is
  // not already below, must have room for its tasks.
  let add = cg_group_tasks(k, q);
  let mut c = s;
  let mut i = 0;
  while i < CG_N
    invariant i <= CG_N && c < CG_N && kok(k)
  {
    let lim = cg_get(k, c, CGW_PIDS);
    if lim != 0 && !cg_in(k, from, c) && cg_tasks(k, c) + add > lim - 1 {
      return EAGAIN;
    }
    if c == 0 {
      i = CG_N;
    } else {
      c = cg_parent(k, c);
      i = i + 1;
    }
  }
  cg_move(&mut k, q, s);
  return 0;
}

/// SIGKILL to every task in cgroup s and below.
fn cg_kill(k: &mut Kernel, s: u64)
  requires kok(k) && s < CG_N
  ensures kok(k)
{
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && kok(k)
  {
    if cg_live(k, q) && cg_in(k, cg_of(k, q), s) {
      post_sig(&mut k, q, 9);
    }
    q = q + 1;
  }
}

/// Write of "+cpu -memory ..." to cgroup.subtree_control of s.
fn cg_write_sub(k: &mut Kernel, s: u64, n: u64) -> u64
  requires kok(k) && s < CG_N && n <= 64
  ensures kok(k)
{
  let mut bits = cg_get(k, s, CGW_SUB) % (CG_ALL + 1);
  let avail = cg_avail(k, s);
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 64 && kok(k)
  {
    let c = bget(k.fs.xfer, i);
    if c == 32 || c == 9 || c == 10 {
      i = i + 1;
    } else {
      if (c != 43 && c != 45) || i + 1 >= n {
        return EINVAL;
      }
      let e = comp_end_ws(k.fs.xfer, i + 1, n);
      let mut b = 0;
      if xfer_is(k.fs.xfer, i + 1, e, "cpu") {
        b = 1;
      } else if xfer_is(k.fs.xfer, i + 1, e, "memory") {
        b = 2;
      } else if xfer_is(k.fs.xfer, i + 1, e, "pids") {
        b = 4;
      }
      if b == 0 {
        return EINVAL;                      // io and the rest: not here
      }
      if c == 43 {
        if avail & b == 0 {
          return ENOENT;                    // the parent does not hand it down
        }
        bits = bits | b;
      } else {
        // Not while a child below uses it.
        let mut ch = 1;
        while ch < CG_N
          invariant 1 <= ch && ch <= CG_N && kok(k)
        {
          if cg_used(k, ch) && cg_parent(k, ch) == s && cg_get(k, ch, CGW_SUB) & b != 0 {
            return EBUSY;
          }
          ch = ch + 1;
        }
        bits = bits & !b;
      }
      i = e;
    }
  }
  cg_put(&mut k, s, CGW_SUB, bits);
  return 0;
}

/// Where the word starting at a ends (the next blank or newline, or n).
fn comp_end_ws(x: &Bytes, a: u64, n: u64) -> u64
  requires a <= n && n <= blen(x)
  ensures a <= result && result <= n
{
  let mut e = a;
  while e < n && bget(x, e) != 32 && bget(x, e) != 9 && bget(x, e) != 10
    invariant a <= e && e <= n && n <= blen(x)
  {
    e = e + 1;
  }
  return e;
}

/// write(2) to control file d by process pid: n bytes at va. Returns n or
/// -errno.
fn cg_write(k: &mut Kernel, pid: u64, d: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && d >= PROC_DEV + PSYS + SY_CG && d < PROC_DEV + PSYS + SY_CG + CG_N * CGF_N
  ensures kok(k)
{
  let s = cgd_slot(d);
  let f = cgd_f(d);
  if !cgf_writable(f) || !cg_used(k, s) {
    return EINVAL;
  }
  if n == 0 || n > 64 {
    return EINVAL;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, n) != n {
    return EFAULT;
  }
  if f == 2 {
    let e = cg_write_sub(&mut k, s, n);
    if e != 0 {
      return e;
    }
    return n;
  }
  let b = big_at(k.fs.xfer, 0, n);
  let be = big_end(k.fs.xfer, 0, n);
  if !b.ok {
    return EINVAL;
  }
  if f == 13 {
    // "max" or a quota, then an optional period.
    let mut period = cg_get(k, s, CGW_CPUP);
    if !only_blank(k.fs.xfer, be, n) {
      let p = big_at(k.fs.xfer, be, n);
      let pe = big_end(k.fs.xfer, be, n);
      if !p.ok || p.v < 1000 || p.v > 1000000 || !only_blank(k.fs.xfer, pe, n) {
        return EINVAL;
      }
      period = p.v;
    }
    if b.v != CG_BIG - 1 && (b.v < 1000 || b.v >= 0x100000000) {
      return EINVAL;
    }
    if b.v == CG_BIG - 1 {
      cg_put(&mut k, s, CGW_CPUQ, 0);
    } else {
      cg_put(&mut k, s, CGW_CPUQ, b.v + 1);
    }
    cg_put(&mut k, s, CGW_CPUP, period);
    cg_put(&mut k, s, CGW_CPUU, 0);
    cg_put(&mut k, s, CGW_CPUS, 0);
    cg_put(&mut k, s, CGW_THR, 0);
    return n;
  }
  if !only_blank(k.fs.xfer, be, n) {
    return EINVAL;
  }
  if f == 0 || f == 6 {
    if b.v == CG_BIG - 1 || b.v >= 0x100000000 {
      return EINVAL;
    }
    let e = cg_write_procs(&mut k, pid, s, b.v);
    if e != 0 {
      return e;
    }
    return n;
  }
  if f == 4 {
    if b.v != 1 {
      return EINVAL;
    }
    cg_kill(&mut k, s);
    return n;
  }
  if f == 8 || f == 10 {
    let mut w = CGW_PIDS;
    if f == 10 {
      w = CGW_MEM;
    }
    if b.v != CG_BIG - 1 && b.v >= 0x4000000000000000 {
      return EINVAL;
    }
    if b.v == CG_BIG - 1 {
      cg_put(&mut k, s, w, 0);
    } else {
      cg_put(&mut k, s, w, b.v + 1);
    }
    return n;
  }
  if f == 16 {
    if b.v == 0 || b.v == 1 {
      cg_put(&mut k, s, CGW_FRZ, b.v);
      return n;
    }
    return EINVAL;
  }
  if f == 14 {
    if b.v < 1 || b.v > 10000 {
      return EINVAL;
    }
    cg_put(&mut k, s, CGW_WEIGHT, b.v);
    return n;
  }
  return EINVAL;
}

// ---------------------------------------------------------------- mkdir, rmdir

/// mkdir of the cgroup whose name is in the first n bytes of the transfer
/// buffer (cg_under): 0 or -errno. Only root.
fn cg_mkdir(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= FNAME_MAX
  ensures kok(k)
{
  if n <= CG_ROOT_LEN {
    return EEXIST;
  }
  let mut a = n;                            // where the last name starts
  while a > CG_ROOT_LEN + 1 && bget(k.fs.xfer, a - 1) != 47
    invariant CG_ROOT_LEN + 1 <= a && a <= n && n <= FNAME_MAX && kok(k)
  {
    a = a - 1;
  }
  if a <= CG_ROOT_LEN {
    return EEXIST;
  }
  let r = cg_walk(k, n);
  if r.kind != CGK_NONE {
    return EEXIST;
  }
  // The parent is everything before the last "/".
  let par = cg_walk(k, a - 1);
  if par.kind != CGK_DIR {
    return ENOENT;
  }
  if fs_id(k.procs, pid, false) != 0 {
    return EACCES;
  }
  let l = n - a;
  if l == 0 || l > CG_NAME_MAX {
    return ENAMETOOLONG;
  }
  if cgf_at(k.fs.xfer, a, n) < CGF_N {
    return EEXIST;                          // a control file's name
  }
  let mut free = CG_N;
  let mut c = 1;
  while c < CG_N
    invariant 1 <= c && c <= CG_N && free <= CG_N && kok(k)
  {
    if free == CG_N && !cg_used(k, c) {
      free = c;
    }
    c = c + 1;
  }
  if free >= CG_N {
    return ENOSPC;
  }
  let mut j = 0;
  while j < l
    invariant j <= l && l <= CG_NAME_MAX && a + l == n && n <= FNAME_MAX && free < CG_N && kok(k)
  {
    cg_put(&mut k, free, CGW_NAME + j, cast[u64](bget(k.fs.xfer, a + j)));
    j = j + 1;
  }
  cg_put(&mut k, free, CGW_NLEN, l);
  cg_put(&mut k, free, CGW_PARENT, par.slot);
  cg_put(&mut k, free, CGW_PIDS, 0);
  cg_put(&mut k, free, CGW_MEM, 0);
  cg_put(&mut k, free, CGW_FRZ, 0);
  cg_put(&mut k, free, CGW_SUB, 0);
  cg_put(&mut k, free, CGW_CPUQ, 0);
  cg_put(&mut k, free, CGW_CPUP, 0);
  cg_put(&mut k, free, CGW_WEIGHT, 0);
  cg_put(&mut k, free, CGW_CPUU, 0);
  cg_put(&mut k, free, CGW_CPUS, 0);
  cg_put(&mut k, free, CGW_USEC, 0);
  cg_put(&mut k, free, CGW_NPER, 0);
  cg_put(&mut k, free, CGW_NTHR, 0);
  cg_put(&mut k, free, CGW_THR, 0);
  cg_put(&mut k, free, CGW_MAXE, 0);
  cg_put(&mut k, free, CGW_VRUN, 0);
  cg_put(&mut k, free, CGW_WST, 0);
  cg_put(&mut k, free, CGW_OOMK, 0);
  cg_put(&mut k, free, CGW_DEV0, 0);
  cg_put(&mut k, free, CGW_DEV1, 0);
  cg_put(&mut k, free, CGW_USED, 1);
  return 0;
}

/// rmdir of the cgroup in the first n bytes of the transfer buffer.
fn cg_rmdir(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= FNAME_MAX
  ensures kok(k)
{
  let r = cg_walk(k, n);
  if r.kind == CGK_FILE {
    return ENOTDIR;
  }
  if r.kind != CGK_DIR {
    return ENOENT;
  }
  if r.slot == 0 {
    return EBUSY;
  }
  if fs_id(k.procs, pid, false) != 0 {
    return EACCES;
  }
  if cg_children(k, r.slot) > 0 || cg_tasks(k, r.slot) > 0 || cgns_held(k, r.slot) {
    return EBUSY;
  }
  dv_cg_clear(&mut k, r.slot);              // its device filters (src/lxbpf.bastio)
  cg_put(&mut k, r.slot, CGW_USED, 0);
  return 0;
}

// ---------------------------------------------------------------- clone3

const CLONE_INTO_CGROUP: u64 = 0x200000000;   // clone3 only
const CLONE_PIDFD_FLAG: u64 = 0x1000;
const CLONE_ARGS_V0: u64 = 64;                // struct clone_args up to child_tid..tls
const CLONE_ARGS_V2: u64 = 88;                // ... through cgroup

/// What lx_clone3_cg did: r is the child's id or -errno, wait is true if the
/// caller must give way until a vfork child lets go.
struct Clone3Cg { r: u64, wait: bool }

/// The u64 at byte off of the clone_args at user address va, 0 beyond size.
fn c3_field(k: &mut Kernel, pid: u64, va: u64, size: u64, off: u64) -> Word
  requires kok(k) && pid < NPROC && off <= CLONE_ARGS_V2 && va < 0x800000000000
  ensures kok(k)
{
  if off + 8 > size {
    return Word { ok: true, v: 0 };
  }
  return user_u64(&mut k.spaces, pid, va + off);
}

/// clone3(args, size) with CLONE_INTO_CGROUP (the other clone3 calls go through
/// lx_clone3_read in src/lxthread.bastio): clone with the arguments in a struct. The
/// flags are the ones clone takes (the exit signal is a field of its own),
/// the stack is given as its lowest address and size, and CLONE_INTO_CGROUP
/// puts the child in the cgroup that descriptor `cgroup` is a directory of,
/// as if it had been written to that group's cgroup.procs, but with the
/// group's pids.max checked first, so nothing is made that cannot stay.
/// CLONE_PIDFD and set_tid are not supported (EINVAL).
fn lx_clone3_cg(k: &mut Kernel, mmu: &Mmu, pid: u64, va: u64, size: u64) -> Clone3Cg
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  if size < CLONE_ARGS_V0 || size > 4096 {
    return Clone3Cg { r: EINVAL, wait: false };
  }
  if va >= 0x800000000000 {
    return Clone3Cg { r: EFAULT, wait: false };
  }
  if size > CLONE_ARGS_V2 {
    // A structure from a newer kernel: its extra words must be readable and zero.
    let tail = user_u64(&mut k.spaces, pid, va + size - 8);
    if !tail.ok {
      return Clone3Cg { r: EFAULT, wait: false };
    }
    if tail.v != 0 {
      return Clone3Cg { r: E2BIG, wait: false };
    }
  }
  let fl = c3_field(&mut k, pid, va, size, 0);
  let ctid = c3_field(&mut k, pid, va, size, 16);
  let ptid = c3_field(&mut k, pid, va, size, 24);
  let sig = c3_field(&mut k, pid, va, size, 32);
  let stack = c3_field(&mut k, pid, va, size, 40);
  let ssz = c3_field(&mut k, pid, va, size, 48);
  let tls = c3_field(&mut k, pid, va, size, 56);
  let tidn = c3_field(&mut k, pid, va, size, 72);
  let cgfd = c3_field(&mut k, pid, va, size, 80);
  if !fl.ok || !ctid.ok || !ptid.ok || !sig.ok || !stack.ok || !ssz.ok || !tls.ok || !tidn.ok || !cgfd.ok {
    return Clone3Cg { r: EFAULT, wait: false };
  }
  let into = fl.v & CLONE_INTO_CGROUP != 0;
  let flags = fl.v % 0x100000000;
  if fl.v >= 0x400000000 || fl.v / 0x100000000 % 2 == 1 || flags & 0xff != 0 || flags & CLONE_DETACHED != 0 {
    return Clone3Cg { r: EINVAL, wait: false };
  }
  if flags & CLONE_PIDFD_FLAG != 0 {
    // Not supported; a bad address for the descriptor is still told first.
    let pf = c3_field(&mut k, pid, va, size, 8);
    if !pf.ok {
      return Clone3Cg { r: EFAULT, wait: false };
    }
    if pf.v != 0 {
      let pw = user_u64(&mut k.spaces, pid, pf.v);
      if !pw.ok {
        return Clone3Cg { r: EFAULT, wait: false };
      }
    }
    return Clone3Cg { r: EINVAL, wait: false };
  }
  if (flags & CLONE_SIGHAND != 0 && flags & CLONE_VM == 0) || (flags & CLONE_THREAD != 0 && flags & CLONE_SIGHAND == 0)
     || (flags & CLONE_FS != 0 && flags & (CLONE_NEWNS + CLONE_NEWUSER) != 0) {
    return Clone3Cg { r: EINVAL, wait: false };
  }
  if sig.v > 64 || tidn.v != 0 || stack.v >= 0x800000000000 || ssz.v >= 0x800000000000 {
    return Clone3Cg { r: EINVAL, wait: false };
  }
  if (stack.v == 0) != (ssz.v == 0) {
    return Clone3Cg { r: EINVAL, wait: false };
  }
  let thread = flags & CLONE_THREAD != 0;
  if thread && (sig.v != 0 || into) {
    return Clone3Cg { r: EINVAL, wait: false };
  }
  if flags & CLONE_VFORK != 0 && flags & CLONE_VM == 0 {
    return Clone3Cg { r: EINVAL, wait: false };
  }
  if !into && cgfd.v != 0 {
    return Clone3Cg { r: EINVAL, wait: false };
  }
  // The target group.
  let mut dest = 0;
  if into {
    if cgfd.v >= 0x80000000 {
      return Clone3Cg { r: EINVAL, wait: false };
    }
    let d = fd_look(k, pid, cgfd.v);
    if d.kind == K_BAD {
      return Clone3Cg { r: EBADF, wait: false };
    }
    if d.kind != K_DIR || d.x < DIR_CG || d.x - DIR_CG >= CG_N {
      return Clone3Cg { r: EBADF, wait: false };
    }
    dest = d.x - DIR_CG;
    if !cg_used(k, dest) || !cg_in(k, dest, cgns_root(k, pid)) {
      return Clone3Cg { r: ENOENT, wait: false };    // gone, or outside the caller's cgroup namespace
    }
    if fs_id(k.procs, pid, false) != 0 {
      return Clone3Cg { r: EACCES, wait: false };
    }
    if !cg_room(k, dest) {
      return Clone3Cg { r: EAGAIN, wait: false };
    }
  }
  let mut sp = 0;
  if stack.v != 0 {
    sp = stack.v + ssz.v;
  }
  let cflags = flags + sig.v;
  if thread {
    let r = lx_thread_clone(&mut k, pid, cflags, sp, ptid.v, ctid.v, tls.v);
    if r < NPROC {
      pt_fork_event(&mut k, pid, r, 3);
    }
    return Clone3Cg { r: child_id(k, pid, r), wait: false };
  }
  if flags & CLONE_VM != 0 && flags & CLONE_VFORK != 0 {
    let r = lx_vfork_vm(&mut k, mmu, pid, sp);
    if r >= NPROC {
      return Clone3Cg { r: r, wait: false };
    }
    if into {
      cg_move(&mut k, r, dest);
    }
    pt_fork_event(&mut k, pid, r, 2);
    return Clone3Cg { r: r, wait: true };
  }
  if !clone_proc_flags(cflags) {
    return Clone3Cg { r: EINVAL, wait: false };
  }
  let r = lx_clone_proc(&mut k, mmu, pid, cflags, sp, ptid.v, ctid.v, tls.v);
  if r < NPROC {
    if into {
      cg_move(&mut k, r, dest);
    }
    let mut kind = 3;
    if sig.v == 17 && flags == 0 {
      kind = 1;
    }
    pt_fork_event(&mut k, pid, r, kind);
  }
  return Clone3Cg { r: child_id(k, pid, r), wait: false };
}
