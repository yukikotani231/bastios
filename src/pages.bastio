// The physical page allocator. A bitmap with one entry per page says which
// pages are free, and the proof keeps it in step with the Pool capability:
// an entry is 1 exactly when the pool still has that page. `pool_take`
// demands that the pool has the page, so no page is ever handed out twice.
//
// `low` is a page below which none is free, so the search for a free page
// starts there instead of at page 0: it skips every page in use at the
// bottom of memory, which is most of them.
//
// The bitmap has an entry for each page of the pool, however much RAM the
// machine has: 8 bytes a page, from the arena's extension the compiler's
// runtime carves from RAM (a 32nd of the pool, at least 4 MiB).

const NPAGES: u64 = 0x8000000;  // the most pages a pool can have (2^27, 512 GiB); "no page"
const LOW_PAGES: u64 = 64;      // the bitmap has at least this many entries: drivers take fixed pages below it

spec fn tracks(bm: &Buf, pool: &Pool) -> bool {
  len(bm) >= pool_size(pool) && len(bm) >= LOW_PAGES && len(bm) <= NPAGES
  && (forall i: u64 :: i < len(bm) ==> ((get(bm, i) == 1) == pool_has(pool, i)))
  && (forall i: u64 :: pool_has(pool, i) ==> i < pool_size(pool))
}

// The allocator: the bitmap and the pool it tracks, kept together.
struct Mem { bm: Buf, pool: Pool, low: u64 }

spec fn mem_ok(m: &Mem) -> bool {
  tracks(m.bm, m.pool)
  && m.low <= len(m.bm)
  && (forall i: u64 :: i < m.low ==> get(m.bm, i) != 1)
}

fn larger(a: u64, b: u64) -> u64
  ensures result >= a && result >= b && (result == a || result == b)
{
  if a > b {
    return a;
  }
  return b;
}

fn bm_new(pool: &Pool) -> Buf
  requires forall i: u64 :: pool_has(pool, i) == (i < pool_size(pool))
  ensures tracks(result, pool)
{
  let n = pool_size(pool);
  let size = larger(n, LOW_PAGES);
  let mut bm = alloc(size);   // a tiny pool: the entries past it stay 0, "in use"
  let mut i = 0;
  while i < n
    invariant i <= n && n <= size && len(bm) == size && size >= LOW_PAGES && size <= NPAGES
    invariant forall j: u64 :: j < len(bm) ==> ((get(bm, j) == 1) == (j < i))
  {
    bm = set(bm, i, 1);
    i = i + 1;
  }
  return bm;
}

/// The first free page, or NPAGES when there is none.
fn find_free(m: &mut Mem) -> u64
  requires mem_ok(m)
  ensures mem_ok(m)
  ensures result == NPAGES || (result < len(m.bm) && get(m.bm, result) == 1)
{
  let mut i = m.low;
  while i < len(m.bm) && get(m.bm, i) != 1
    invariant m.low <= i && i <= len(m.bm)
    invariant forall j: u64 :: j < i ==> get(m.bm, j) != 1
  {
    i = i + 1;
  }
  m.low = i;
  if i == len(m.bm) {
    return NPAGES;
  }
  return i;
}

fn count_free(bm: &Buf) -> u64
  ensures result <= len(bm)
{
  let mut n = 0;
  let mut i = 0;
  while i < len(bm)
    invariant i <= len(bm) && n <= i
  {
    if get(bm, i) == 1 {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

fn mem_new(pool: Pool) -> Mem
  requires forall i: u64 :: pool_has(pool, i) == (i < pool_size(pool))
  ensures mem_ok(result)
{
  let bm = bm_new(pool);
  return Mem { bm: bm, pool: pool, low: 0 };
}

/// Writes the highest free page (the end of the last run of RAM, above
/// 4 GiB on a large machine) and reads it back: false if it does not hold
/// what was written. True when no page is free.
fn probe_top(m: &mut Mem) -> bool
  requires mem_ok(m)
  ensures mem_ok(m)
{
  let mut i = len(m.bm);
  while i > 0 && get(m.bm, i - 1) != 1
    invariant i <= len(m.bm) && mem_ok(m)
  {
    i = i - 1;
  }
  if i == 0 {
    return true;
  }
  let mut f = take_page(&mut m, i - 1);
  let mut k = 0;
  while k < 512
    invariant k <= 512 && i <= NPAGES
  {
    frame_write(&mut f, k, i * 512 + k);
    k = k + 1;
  }
  let mut ok = true;
  k = 0;
  while k < 512
    invariant k <= 512 && i <= NPAGES
  {
    if frame_read(f, k) != i * 512 + k {
      ok = false;
    }
    k = k + 1;
  }
  give_page(&mut m, f);
  return ok;
}

fn take_page(m: &mut Mem, i: u64) -> Frame
  requires mem_ok(m) && i < len(m.bm) && get(m.bm, i) == 1
  ensures mem_ok(m)
  ensures frame_id(result) == i
{
  m.bm = set(m.bm, i, 0);
  return pool_take(&mut m.pool, i);
}

fn give_page(m: &mut Mem, f: Frame)
  requires mem_ok(m)
  ensures mem_ok(m)
{
  let i = frame_id(f);
  m.bm = set(m.bm, i, 1);
  if i < m.low {
    m.low = i;
  }
  pool_give(&mut m.pool, f);
}

/// Shared pages the kernel keeps: a level-2 table, never loaded, whose
/// slot s is a level-1 table of shared pages. k.shm holds the pages of
/// System V shared memory segments (slots s, s + 32, ...: segment s, src/lxipc.bastio),
/// k.txt the read-only pages of the built-in programs (slot s: program s,
/// src/text.bastio). None only if there was no page for it at boot.
enum Store {
  None,
  Table(PageTable),
}

spec fn store_ok(s: &Store) -> bool {
  s is Store::Table ==> (pt_level(s.Table) == 2 && pt_leases(s.Table) == 0)
}

/// Gives up one reference to a shared page (a MAP_SHARED page several
/// address spaces map). The last one gives the page back, which the
/// bitmap then records as free.
fn drop_shared(m: &mut Mem, s: Shared)
  requires mem_ok(m)
  ensures mem_ok(m)
{
  let i = shared_drop(&mut m.pool, s);
  if i < len(m.bm) {
    m.bm = set(m.bm, i, 1);
    if i < m.low {
      m.low = i;
    }
  }
}

/// Takes page `i` without zeroing it (bastiolang's `Dirty`): for a page
/// that is about to be overwritten whole, a copy of another.
fn take_dirty(m: &mut Mem, i: u64) -> Dirty
  requires mem_ok(m) && i < len(m.bm) && get(m.bm, i) == 1
  ensures mem_ok(m)
  ensures dirty_id(result) == i
{
  m.bm = set(m.bm, i, 0);
  return pool_take_dirty(&mut m.pool, i);
}

// A page the kernel keeps for good to share between processes, the
// read-only pages of the built-in programs (src/text.bastio), is marked
// TXT_PAGE in the bitmap instead of 0: it is in use, but `mem` counts it
// as available (it is a cache), and mprotect copies it before letting a
// process write it.
const TXT_PAGE: u64 = 2;

/// take_page for such a page.
fn take_text_page(m: &mut Mem, i: u64) -> Frame
  requires mem_ok(m) && i < len(m.bm) && get(m.bm, i) == 1
  ensures mem_ok(m)
  ensures frame_id(result) == i
{
  m.bm = set(m.bm, i, TXT_PAGE);
  return pool_take(&mut m.pool, i);
}

/// Is shared page `s` one of those?
fn is_text_page(m: &Mem, s: &Shared) -> bool
  requires mem_ok(m)
{
  return shared_id(s) < len(m.bm) && get(m.bm, shared_id(s)) == TXT_PAGE;
}

// A private page fork shares between parent and child until one of them
// writes it (copy-on-write, src/lxcow.bastio) is a shared page marked
// COW_PAGE: in use, mapped read-only in every space that holds it, and
// copied on the first write. The mark is the page's, not a mapping's: a
// COW_PAGE is only ever mapped where the memory is private and writable,
// and anything that would change that (mprotect, MADV_DONTNEED) gives the
// space its own copy first. The last reference's drop_shared marks the
// page free again.
const COW_PAGE: u64 = 3;

/// Marks the page of `s`, which a private mapping held, COW_PAGE.
fn mark_cow(m: &mut Mem, s: &Shared)
  requires mem_ok(m)
  ensures mem_ok(m)
{
  let i = shared_id(s);
  if i < len(m.bm) && get(m.bm, i) != 1 {
    m.bm = set(m.bm, i, COW_PAGE);
  }
}

// A private page the process may both write and run code from (a built-in
// program's image, a read-write-execute mapping) is marked XPAGE instead of
// 0, and COW_PAGE_X instead of COW_PAGE when fork shares it: the page table
// entry cannot be asked whether the page may run (src/lxmem.bastio, l2_protect),
// and fork and the copy a write makes must keep it so. Every other page the
// process may write cannot run code.
const XPAGE: u64 = 4;
const COW_PAGE_X: u64 = 5;

/// Is a bitmap value one of a copy-on-write page?
fn bm_cow(v: u64) -> bool
{
  return v == COW_PAGE || v == COW_PAGE_X;
}

/// Is shared page `s` copy-on-write?
fn is_cow_page(m: &Mem, s: &Shared) -> bool
  requires mem_ok(m)
{
  return shared_id(s) < len(m.bm) && bm_cow(get(m.bm, shared_id(s)));
}

/// Is shared page `s` a copy-on-write page that was executable?
fn is_cow_x(m: &Mem, s: &Shared) -> bool
  requires mem_ok(m)
{
  return shared_id(s) < len(m.bm) && get(m.bm, shared_id(s)) == COW_PAGE_X;
}

/// Marks the page of `s`, which a private mapping held and could run code
/// from, COW_PAGE_X.
fn mark_cow_x(m: &mut Mem, s: &Shared)
  requires mem_ok(m)
  ensures mem_ok(m)
{
  let i = shared_id(s);
  if i < len(m.bm) && get(m.bm, i) != 1 {
    m.bm = set(m.bm, i, COW_PAGE_X);
  }
}

/// Says whether private page `f` (in use, not shared) may be written and run
/// as well: XPAGE, or an ordinary in-use page again.
fn mark_x(m: &mut Mem, f: &Frame, on: bool)
  requires mem_ok(m)
  ensures mem_ok(m)
{
  let i = frame_id(f);
  if i < len(m.bm) && (get(m.bm, i) == 0 || get(m.bm, i) == XPAGE) {
    if on {
      m.bm = set(m.bm, i, XPAGE);
    } else {
      m.bm = set(m.bm, i, 0);
    }
  }
}

/// Is private page `f` one that may be written and run?
fn is_x_frame(m: &Mem, f: &Frame) -> bool
  requires mem_ok(m)
{
  return frame_id(f) < len(m.bm) && get(m.bm, frame_id(f)) == XPAGE;
}

/// The free pages plus the cached ones (`mem`).
fn count_avail(bm: &Buf) -> u64
  ensures result <= len(bm)
{
  let mut n = 0;
  let mut i = 0;
  while i < len(bm)
    invariant n <= i && i <= len(bm)
  {
    if get(bm, i) == 1 || get(bm, i) == TXT_PAGE {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

/// A lent page's physical address (always below 2^48: the pool is low).
fn dma_phys(d: &Dma) -> u64
  ensures result < 0x1000000000000
{
  let a = dma_addr(d);
  if a >= 0x1000000000000 {
    return 0;
  }
  return a;
}
