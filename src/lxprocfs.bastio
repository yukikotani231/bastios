// /proc for Linux programs, generated on each read and read-only: enough
// for BusyBox's ps, free, df and uptime and for programs that look at
// themselves.
//
//   /proc/mounts            the mount table ("/", "/proc", and "/disk" with a disk)
//   /proc/meminfo           total and free memory, as sysinfo counts them
//   /proc/uptime            seconds since boot
//   /proc/cpuinfo           one block per running processor
//   /proc/filesystems       the file system types mount names
//   /proc/sys/kernel/tainted, pid_max, printk, and the System V IPC
//   limits shmmax, shmall, shmmni, msgmax, msgmnb, msgmni, sem
//                           read-only sysctls with their fixed values
//   /proc/sys/fs/pipe-max-size  the most F_SETPIPE_SZ gives
//   /proc/sys/fs/inotify/max_queued_events, max_user_instances,
//   max_user_watches        inotify's fixed limits (src/lxinotify.bastio)
//   /proc/sys/kernel/hostname, domainname, ostype, osrelease, version
//                           what uname says (src/lxsys.bastio)
//   /proc/sysvipc/msg, sem, shm
//                           the System V IPC objects (src/lxipc.bastio)
//   /proc/PID/              one directory per process (zombies included)
//   /proc/PID/stat          the one-line status ps reads (52 fields)
//   /proc/PID/status        the same as "Name:\t..." lines
//   /proc/PID/cmdline       the program's name: argv is not kept
//   /proc/PID/exe           a symbolic link to the program (readlink)
//   /proc/PID/mounts        the same as /proc/mounts
//   /proc/self              the caller's own directory
//   /sys/block/loopN/size, ro, and loop/backing_file, offset, sizelimit,
//   autoclear, partscan, dio
//                           a loop device's settings (src/lxloop.bastio),
//                           as losetup and LTP read them
//
// "self" is rewritten to the caller's pid when a path is read from user
// memory (lx_path_from), so everything after sees /proc/PID. A file is an
// open file description of kind OF_DEV whose device is PROC_DEV + 16 * pid
// + PF_*, and whose word 3 is the read offset; a directory is an OF_DIR
// description whose x is DIR_PROC (+ pid). Each read generates the whole
// file (at most PROC_OUT bytes) and hands out the part past the offset, so
// a file read in several calls can mix two moments, as small /proc files
// can on Linux too.
//
// Not here: argv in cmdline, readlink of /proc/self itself (it reads as
// the directory), /proc/PID/fd, maps and environ, writable sysctls, and
// /proc/sys as a directory (its files open and stat, but are not listed).
// A sysctl for a feature BastiOS lacks (core dumps, splice) is left out,
// so a program that checks for it finds the feature missing.

import "linux.bastio";

// PROC_DEV, DIR_PROC, PF_EXE and EACCES are in src/proc.bastio, which the
// files that hook in here are compiled after.

const PF_MOUNTS: u64 = 1;
const PF_MEMINFO: u64 = 2;
const PF_UPTIME: u64 = 3;
const PF_STAT: u64 = 4;
const PF_CMDLINE: u64 = 5;
const PF_STATUS: u64 = 6;
const PF_CPUINFO: u64 = 8;            // these two with pid 0; 7 is PF_EXE
const PF_FILESYSTEMS: u64 = 9;
const PF_MAPS: u64 = 10;
const PF_COMM: u64 = 11;
const PF_SLACK: u64 = 12;
const PF_LOADAVG: u64 = 13;           // with pid 0
const PSYS: u64 = 16 * NPROC;         // PROC_DEV + PSYS + SY_*: a /proc/sys file
const SY_TAINTED: u64 = 1;
const SY_PID_MAX: u64 = 2;
const SY_PRINTK: u64 = 3;
const SY_IPC: u64 = 4;                // 4 .. 13: ipc_proc_text (src/lxipc.bastio)
const SY_IPC_END: u64 = 14;
const SY_UTS: u64 = 14;                // 14 .. 17: uts_proc_text (src/lxsys.bastio)
const SY_UTS_END: u64 = 19;
const SY_PIPE_MAX: u64 = 19;
const SY_INO: u64 = 20;                // 20 .. 22: /proc/sys/fs/inotify (src/lxinotify.bastio)
const SY_LOOP: u64 = 32;               // 32 ..: loop device n's attribute a at n * LOOP_SYS + a
const LOOP_SYS: u64 = 8;               // size, ro, backing_file, offset, sizelimit, autoclear, partscan, dio
const PROC_OUT: u64 = 4096;           // XFER: the most a /proc file holds
const S_IFLNK: u64 = 0xA1FF;          // a symbolic link, rwxrwxrwx
const S_IFREG_RO: u64 = 0x8124;       // a regular file, r--r--r--
const INO_PROC: u64 = 8192;           // /proc inode numbers start here (past INO_FILES + HFILES)
const LX_READLINK: u64 = 89;
const LX_READLINKAT: u64 = 267;

// ---------------------------------------------------------------- paths

/// Whether bytes from..to of x are "self".
fn is_self(x: &Bytes, from: u64, to: u64) -> bool
  requires from <= to && to <= blen(x)
{
  return xfer_is(x, from, to, "self");
}

/// Where the path component starting at `from` in x[..n] ends.
fn comp_end(x: &Bytes, from: u64, n: u64) -> u64
  requires from <= n && n <= blen(x)
  ensures from <= result && result <= n
{
  let mut e = from;
  while e < n && bget(x, e) != 47
    invariant from <= e && e <= n
  {
    e = e + 1;
  }
  return e;
}

/// Writes pid p (below 1000) in decimal at x[at..]; how many digits.
fn dec_out(x: &mut Bytes, at: u64, p: u64) -> u64
  requires p < 1000 && at + 3 <= blen(x)
  ensures blen(x) == old(blen(x)) && 1 <= result && result <= 3
{
  if p >= 100 {
    bset(&mut x, at, cast[u8](48 + p / 100));
    bset(&mut x, at + 1, cast[u8](48 + p / 10 % 10));
    bset(&mut x, at + 2, cast[u8](48 + p % 10));
    return 3;
  }
  if p >= 10 {
    bset(&mut x, at, cast[u8](48 + p / 10));
    bset(&mut x, at + 1, cast[u8](48 + p % 10));
    return 2;
  }
  bset(&mut x, at, cast[u8](48 + p));
  return 1;
}

/// Rewrites a leading "proc/self" in x[..n] to "proc/PID" for the caller.
/// Returns the new length, never more than n.
fn proc_self(x: &mut Bytes, n: u64, pid: u64) -> u64
  requires n <= blen(x) && pid < NPROC
  ensures blen(x) == old(blen(x)) && result <= n
{
  if n < 9 || !xfer_is(x, 0, 5, "proc/") || comp_end(x, 5, n) != 9 || !is_self(x, 5, 9) {
    return n;
  }
  // "self" (4 bytes) becomes 1 to 3 digits: move the rest left.
  let d = dec_out(&mut x, 5, pid);
  let l = blen(x);
  let mut i = 9;
  while i < n
    invariant 9 <= i && i <= n && n <= l && blen(x) == l
  {
    bset(&mut x, i - 4 + d, bget(x, i));
    i = i + 1;
  }
  return n - 4 + d;
}

/// The process x[from..to] names, as decimal digits: a live one (zombies
/// count), or NPROC.
fn proc_pid(procs: &Buf, x: &Bytes, from: u64, to: u64) -> u64
  requires ptab_ok(procs) && from <= to && to <= blen(x)
  ensures result <= NPROC
{
  if to == from || to - from > 3 || bget(x, from) == 48 {
    return NPROC;
  }
  let mut p = 0;
  let mut i = from;
  while i < to
    invariant from <= i && i <= to && p < 1000
  {
    let c = cast[u64](bget(x, i));
    if c < 48 || c > 57 {
      return NPROC;
    }
    p = p * 10 + (c - 48);
    if p >= 1000 {
      return NPROC;
    }
    i = i + 1;
  }
  if p == 0 || p >= NPROC || state(procs, p) == FREE {
    return NPROC;
  }
  return p;
}

/// The directory description for x[..n] if it is /proc or /proc/PID, or
/// NO_FILE.
fn proc_dir(procs: &Buf, x: &Bytes, n: u64) -> u64
  requires ptab_ok(procs) && n <= blen(x)
{
  if n == 4 && xfer_is(x, 0, 4, "proc") {
    return DIR_PROC;
  }
  if n < 6 || !xfer_is(x, 0, 5, "proc/") || comp_end(x, 5, n) != n {
    return NO_FILE;
  }
  let p = proc_pid(procs, x, 5, n);
  if p >= NPROC {
    return NO_FILE;
  }
  return DIR_PROC + p;
}

/// The device for x[..n] if it is a /proc file, or 0.
fn proc_file(procs: &Buf, x: &Bytes, n: u64) -> u64
  requires ptab_ok(procs) && n <= blen(x)
{
  let s = loop_sys_at(x, n);
  if s != 0 {
    return PROC_DEV + PSYS + SY_LOOP + s - 1;
  }
  if n < 6 || !xfer_is(x, 0, 5, "proc/") {
    return 0;
  }
  let e = comp_end(x, 5, n);
  if e == n {
    if xfer_is(x, 5, n, "mounts") {
      return PROC_DEV + PF_MOUNTS;
    }
    if xfer_is(x, 5, n, "meminfo") {
      return PROC_DEV + PF_MEMINFO;
    }
    if xfer_is(x, 5, n, "uptime") {
      return PROC_DEV + PF_UPTIME;
    }
    if xfer_is(x, 5, n, "loadavg") {
      return PROC_DEV + PF_LOADAVG;
    }
    if xfer_is(x, 5, n, "cpuinfo") {
      return PROC_DEV + PF_CPUINFO;
    }
    if xfer_is(x, 5, n, "filesystems") {
      return PROC_DEV + PF_FILESYSTEMS;
    }
    if xfer_is(x, 5, n, "cmdline") {
      return PROC_DEV + PF_CMDLINE;         // pid 0: the kernel's command line
    }
    return 0;
  }
  if xfer_is(x, 5, n, "sys/kernel/tainted") {
    return PROC_DEV + PSYS + SY_TAINTED;
  }
  if xfer_is(x, 5, n, "sys/kernel/pid_max") {
    return PROC_DEV + PSYS + SY_PID_MAX;
  }
  if xfer_is(x, 5, n, "sys/kernel/printk") {
    return PROC_DEV + PSYS + SY_PRINTK;
  }
  if xfer_is(x, 5, n, "sys/fs/pipe-max-size") {
    return PROC_DEV + PSYS + SY_PIPE_MAX;
  }
  if xfer_is(x, 5, n, "sys/fs/inotify/max_queued_events") {
    return PROC_DEV + PSYS + SY_INO;
  }
  if xfer_is(x, 5, n, "sys/fs/inotify/max_user_instances") {
    return PROC_DEV + PSYS + SY_INO + 1;
  }
  if xfer_is(x, 5, n, "sys/fs/inotify/max_user_watches") {
    return PROC_DEV + PSYS + SY_INO + 2;
  }
  let mut i = 0;
  while i < SY_IPC_END - SY_IPC
    invariant i <= SY_IPC_END - SY_IPC
  {
    if xfer_is(x, 5, n, ipc_proc_name(i)) {
      return PROC_DEV + PSYS + SY_IPC + i;
    }
    i = i + 1;
  }
  let mut j = 0;
  while j < SY_UTS_END - SY_UTS
    invariant j <= SY_UTS_END - SY_UTS
  {
    if xfer_is(x, 5, n, uts_proc_name(j)) {
      return PROC_DEV + PSYS + SY_UTS + j;
    }
    j = j + 1;
  }
  let p = proc_pid(procs, x, 5, e);
  if p >= NPROC {
    return 0;
  }
  let base = PROC_DEV + 16 * p;
  if xfer_is(x, e + 1, n, "stat") {
    return base + PF_STAT;
  }
  if xfer_is(x, e + 1, n, "cmdline") {
    return base + PF_CMDLINE;
  }
  if xfer_is(x, e + 1, n, "status") {
    return base + PF_STATUS;
  }
  if xfer_is(x, e + 1, n, "exe") {
    return base + PF_EXE;
  }
  if xfer_is(x, e + 1, n, "mounts") {
    return base + PF_MOUNTS;
  }
  if xfer_is(x, e + 1, n, "maps") {
    return base + PF_MAPS;
  }
  if xfer_is(x, e + 1, n, "comm") {
    return base + PF_COMM;
  }
  if xfer_is(x, e + 1, n, "timerslack_ns") {
    return base + PF_SLACK;
  }
  // task/TID/comm, for a thread of the group (or the group itself).
  if e + 6 < n && xfer_is(x, e + 1, e + 6, "task/") {
    let te = comp_end(x, e + 6, n);
    let t = proc_pid(procs, x, e + 6, te);
    if t < NPROC && (t == p || tgid(procs, t) == p) && te < n && xfer_is(x, te + 1, n, "comm") {
      return PROC_DEV + 16 * t + PF_COMM;
    }
  }
  return 0;
}

/// The /sys/block/loopN file the n-byte path in x names: N * LOOP_SYS +
/// its attribute + 1, or 0. The loop/ files are there whether or not the
/// device is bound (on Linux, only while it is).
fn loop_sys_at(x: &Bytes, n: u64) -> u64
  requires n <= blen(x)
  ensures result <= LOOP_N * LOOP_SYS
{
  if n < 17 || !xfer_is(x, 0, 14, "sys/block/loop") || cast[u64](bget(x, 15)) != 47 {
    return 0;
  }
  let c = cast[u64](bget(x, 14));
  if c < 48 || c >= 48 + LOOP_N {
    return 0;
  }
  let base = (c - 48) * LOOP_SYS + 1;
  if xfer_is(x, 16, n, "size") {
    return base;
  }
  if xfer_is(x, 16, n, "ro") {
    return base + 1;
  }
  if xfer_is(x, 16, n, "loop/backing_file") {
    return base + 2;
  }
  if xfer_is(x, 16, n, "loop/offset") {
    return base + 3;
  }
  if xfer_is(x, 16, n, "loop/sizelimit") {
    return base + 4;
  }
  if xfer_is(x, 16, n, "loop/autoclear") {
    return base + 5;
  }
  if xfer_is(x, 16, n, "loop/partscan") {
    return base + 6;
  }
  if xfer_is(x, 16, n, "loop/dio") {
    return base + 7;
  }
  return 0;
}

/// The text of /sys/block/loopN attribute s (N * LOOP_SYS + attribute).
fn loop_sys_text(k: &mut Kernel, s: u64, o: &mut Bytes) -> u64
  requires kok(k) && s < LOOP_N * LOOP_SYS && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let d = s / LOOP_SYS;
  let a = s % LOOP_SYS;
  let flags = lo_get(k.loops, d, 3);
  let mut v = 0;
  if a == 0 {
    v = loop_size(&mut k, d) / 512;         // in 512-byte sectors
  } else if a == 1 {
    v = flags % 2;
  } else if a == 2 {
    let row = loop_row(k, d);
    if row >= FD_ROWS {
      return put_c(&mut o, 0, 10);
    }
    let f = vfs_row_file(k.fs, row);
    let n = vfs_dirent(&mut k.fs, f);
    if f == NO_FILE || n == NO_FILE || n > XFER {
      return put_c(&mut o, 0, 10);
    }
    let mut at = put_c(&mut o, 0, 47);
    let mut j = 0;
    while j < n
      invariant j <= n && n <= XFER && at <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
    {
      at = put_c(&mut o, at, bget(k.fs.xfer, j));
      j = j + 1;
    }
    return put_c(&mut o, at, 10);
  } else if a == 3 {
    v = lo_get(k.loops, d, 1);
  } else if a == 4 {
    v = lo_get(k.loops, d, 2);
  } else if a == 5 {
    v = flags / 4 % 2;
  } else if a == 6 {
    v = flags / 8 % 2;
  } else {
    v = flags / 16 % 2;
  }
  let e = put_n(&mut o, 0, v);
  return put_c(&mut o, e, 10);
}

/// What stat says about /proc file f (a proc_file device).
fn proc_meta(f: u64) -> Meta {
  if is_exe_file(f) {
    return Meta { ok: true, mode: S_IFLNK, size: 0, ino: INO_PROC + f % 4096, mtime: 0, own: 0 };
  }
  return Meta { ok: true, mode: S_IFREG_RO, size: 0, ino: INO_PROC + f % 4096, mtime: 0, own: 0 };
}

/// What stat says about /proc directory d (a proc_dir description).
fn proc_dir_meta(d: u64) -> Meta {
  return Meta { ok: true, mode: S_IFDIR, size: 0, ino: INO_PROC + d % 256, mtime: 0, own: 0 };
}

/// Entry i of /proc directory `dir` (getdents64), its name in the
/// transfer buffer.
fn proc_entry(k: &mut Kernel, dir: u64, i: u64) -> Ent
  requires kok(k) && dir >= DIR_PROC
  ensures kok(k) && result.len <= XFER
{
  let end = Ent { len: 0, dir: false, end: true };
  if dir > DIR_PROC {
    if i == 0 {
      return Ent { len: name_out(&mut k.fs.xfer, "stat"), dir: false, end: false };
    }
    if i == 1 {
      return Ent { len: name_out(&mut k.fs.xfer, "status"), dir: false, end: false };
    }
    if i == 2 {
      return Ent { len: name_out(&mut k.fs.xfer, "cmdline"), dir: false, end: false };
    }
    if i == 3 {
      return Ent { len: name_out(&mut k.fs.xfer, "exe"), dir: false, end: false };
    }
    if i == 4 {
      return Ent { len: name_out(&mut k.fs.xfer, "mounts"), dir: false, end: false };
    }
    if i == 5 {
      return Ent { len: name_out(&mut k.fs.xfer, "maps"), dir: false, end: false };
    }
    return end;
  }
  if i == 0 {
    return Ent { len: name_out(&mut k.fs.xfer, "self"), dir: true, end: false };
  }
  if i == 1 {
    return Ent { len: name_out(&mut k.fs.xfer, "mounts"), dir: false, end: false };
  }
  if i == 2 {
    return Ent { len: name_out(&mut k.fs.xfer, "meminfo"), dir: false, end: false };
  }
  if i == 3 {
    return Ent { len: name_out(&mut k.fs.xfer, "uptime"), dir: false, end: false };
  }
  if i == 4 {
    return Ent { len: name_out(&mut k.fs.xfer, "cpuinfo"), dir: false, end: false };
  }
  if i == 5 {
    return Ent { len: name_out(&mut k.fs.xfer, "filesystems"), dir: false, end: false };
  }
  if i == 6 {
    return Ent { len: name_out(&mut k.fs.xfer, "cmdline"), dir: false, end: false };
  }
  let p = i - 6;
  if p >= NPROC {
    return end;
  }
  if state(k.procs, p) == FREE {
    return Ent { len: 0, dir: false, end: false };
  }
  return Ent { len: dec_out(&mut k.fs.xfer, 0, p), dir: true, end: false };
}

// ---------------------------------------------------------------- text

/// Appends s to o at `at`; what does not fit is dropped. Returns the end.
fn put_s(o: &mut Bytes, at: u64, s: Str) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  let mut i = 0;
  while i < slen(s) && a < PROC_OUT
    invariant a <= PROC_OUT && blen(o) == PROC_OUT
  {
    bset(&mut o, a, sget(s, i));
    a = a + 1;
    i = i + 1;
  }
  return a;
}

/// Appends byte c.
fn put_c(o: &mut Bytes, at: u64, c: u8) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  if at >= PROC_OUT {
    return at;
  }
  bset(&mut o, at, c);
  return at + 1;
}

/// Appends v in hex, at least 8 digits, as Linux's %08lx.
fn put_x(o: &mut Bytes, at: u64, v: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  let mut sh = 16;
  while sh > 0
    invariant sh <= 16 && blen(o) == PROC_OUT && a <= PROC_OUT
  {
    sh = sh - 1;
    let d = (v >> (4 * sh)) & 15;
    if sh < 8 || v >> (4 * sh) != 0 {       // at least 8 digits, as Linux's %08lx
      if d < 10 {
        a = put_c(&mut o, a, cast[u8](48 + d));
      } else {
        a = put_c(&mut o, a, cast[u8](87 + d));
      }
    }
  }
  return a;
}

/// Appends v in decimal.
fn put_n(o: &mut Bytes, at: u64, v: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut p = 1;
  while p <= v / 10
    invariant p >= 1
  {
    p = p * 10;
  }
  let mut a = at;
  let mut q = p;
  while q > 0
    invariant a <= PROC_OUT && blen(o) == PROC_OUT
  {
    a = put_c(&mut o, a, cast[u8](48 + v / q % 10));
    q = q / 10;
  }
  return a;
}

/// A status line's four ids (real, effective, saved, file system) from
/// row words w and s, each after a tab.
fn put_ids(o: &mut Bytes, at: u64, procs: &Buf, p: u64, w: u64, s: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT && ptab_ok(procs) && p < NPROC && w < STRIDE && s < STRIDE
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = put_c(&mut o, at, 9);
  a = put_n(&mut o, a, id_get(procs, p, w, false));
  a = put_c(&mut o, a, 9);
  a = put_n(&mut o, a, id_get(procs, p, w, true));
  a = put_c(&mut o, a, 9);
  a = put_n(&mut o, a, id_get(procs, p, s, false));
  a = put_c(&mut o, a, 9);
  return put_n(&mut o, a, id_get(procs, p, s, true));
}

/// Appends v as two digits (v below 100).
fn put_2(o: &mut Bytes, at: u64, v: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let a = put_c(&mut o, at, cast[u8](48 + v / 10 % 10));
  return put_c(&mut o, a, cast[u8](48 + v % 10));
}

/// Appends process p's name (see pr_comm).
fn put_comm(k: &mut Kernel, p: u64, o: &mut Bytes, at: u64) -> u64
  requires kok(k) && p < NPROC && blen(o) == PROC_OUT && at <= PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let n = pr_comm(&mut k, p);
  let mut a = at;
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 15 && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
  {
    a = put_c(&mut o, a, bget(k.fs.xfer, i));
    i = i + 1;
  }
  return a;
}

/// Appends the path of process p's program ("/bin/NAME", or the file it
/// was loaded from), or only its last part when `base`.
fn put_prog(k: &mut Kernel, p: u64, o: &mut Bytes, at: u64, base: bool) -> u64
  requires kok(k) && p < NPROC && blen(o) == PROC_OUT && at <= PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let prog = pget(k.procs, p, F_PROG);
  if prog < NPROGS || prog == NPROGS || prog - NPROGS - 1 >= HFILES {
    let mut a = at;
    if !base {
      a = put_s(&mut o, a, "/bin/");
    }
    return put_s(&mut o, a, prog_name(prog));
  }
  let n = vfs_dirent(&mut k.fs, prog - NPROGS - 1);
  if n == NO_FILE || n > XFER {
    return put_s(&mut o, at, prog_name(prog));
  }
  let mut from = 0;
  if base {
    let mut i = 0;
    while i < n
      invariant i <= n && from <= n
    {
      if bget(k.fs.xfer, i) == 47 {
        from = i + 1;
      }
      i = i + 1;
    }
  }
  let mut a = at;
  if !base {
    a = put_c(&mut o, a, 47);
  }
  let mut j = from;
  while j < n
    invariant j <= n && n <= XFER && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
  {
    a = put_c(&mut o, a, bget(k.fs.xfer, j));
    j = j + 1;
  }
  return a;
}

/// The one-letter state of a process in state s, as ps shows it. A
/// process that runs its system call again until what it waits for comes
/// (`waiting`, F_ASLEEP) is waiting, though it is READY or RUNNING: Linux
/// would have it asleep.
fn state_letter(s: u64, waiting: bool) -> u8 {
  if (s == READY || s == RUNNING) && waiting {
    return 83;                              // S
  }
  if s == READY || s == RUNNING || s == KILLED || s == EXITING {
    return 82;                              // R
  }
  if s == ZOMBIE {
    return 90;                              // Z
  }
  if s == STOPPED {
    return 84;                              // T
  }
  return 83;                                // S: waiting for something
}

/// Writes /proc file f into o. Returns its length.
fn proc_text(k: &mut Kernel, f: u64, o: &mut Bytes) -> u64
  requires kok(k) && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  if f < PROC_DEV {
    return 0;
  }
  if f >= PROC_DEV + PSYS {
    // A /proc/sys file, numbered from 0 (src/lxprocfs.bastio's SY_*).
    let what = f - PROC_DEV - PSYS;
    if what >= SY_LOOP && what - SY_LOOP < LOOP_N * LOOP_SYS {
      return loop_sys_text(&mut k, what - SY_LOOP, &mut o);
    }
    if what == SY_TAINTED {
      return put_s(&mut o, 0, "0\n");
    }
    if what == SY_PID_MAX {
      let a = put_n(&mut o, 0, NPROC);    // every pid is below it
      return put_c(&mut o, a, 10);
    }
    if what == SY_PRINTK {
      return put_s(&mut o, 0, "7\t4\t1\t7\n");
    }
    if what >= SY_IPC && what < SY_IPC_END {
      return ipc_proc_text(&mut k, what - SY_IPC, &mut o);
    }
    if what >= SY_UTS && what < SY_UTS_END {
      return uts_proc_text(k, what - SY_UTS, &mut o);
    }
    if what == SY_PIPE_MAX {
      let a = put_n(&mut o, 0, PIPE_CAP);   // F_SETPIPE_SZ goes no higher
      return put_c(&mut o, a, 10);
    }
    if what >= SY_INO && what < SY_INO + 3 {
      // inotify's fixed limits: events queued before IN_Q_OVERFLOW,
      // instances (in all, not per user), watches per instance.
      let mut v = INO_Q - 1;
      if what == SY_INO + 1 {
        v = INO_N;
      } else if what == SY_INO + 2 {
        v = INO_W;
      }
      let a = put_n(&mut o, 0, v);
      return put_c(&mut o, a, 10);
    }
    return 0;
  }
  let what = f % 16;
  let p = (f - PROC_DEV) / 16;
  if what == PF_MOUNTS {
    let mut a = put_s(&mut o, 0, "rootfs / ramfs rw 0 0\nproc /proc proc rw 0 0\n");
    if k.fs.disk.slots > 0 {
      a = put_s(&mut o, a, "disk /disk bstdisk3 rw 0 0\n");
    }
    // tmpfs mounts (src/lxmount.bastio): "tmpfs /NAME tmpfs rw 0 0".
    let mut s = 0;
    while s < MNT_N
      invariant s <= MNT_N && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
    {
      let i = vfs_mount_node(k.fs, s);
      if i < NFILES {
        let l = ram_name(&mut k.fs.ram, i, &mut k.fs.name);
        if l != NO_FILE {
          a = put_s(&mut o, a, "tmpfs /");
          let mut j = 0;
          while j < l
            invariant j <= l && l <= NAMEBUF && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
          {
            a = put_c(&mut o, a, bget(k.fs.name, j));
            j = j + 1;
          }
          if vfs_mount_ro(k.fs, s) {
            a = put_s(&mut o, a, " tmpfs ro 0 0\n");
          } else {
            a = put_s(&mut o, a, " tmpfs rw 0 0\n");
          }
        }
      }
      s = s + 1;
    }
    // The loop mount: "/dev/loopN /NAME bstdisk3 rw 0 0" ("bstdisk3" for
    // an image mounted from its file).
    if k.fs.lo_at != 0 && k.fs.lo_at <= NFILES {
      let l = ram_name(&mut k.fs.ram, k.fs.lo_at - 1, &mut k.fs.name);
      if l != NO_FILE {
        if k.fs.lo_dev == LO_NODEV {
          a = put_s(&mut o, a, "bstdisk3 /");
        } else {
          a = put_s(&mut o, a, "/dev/loop");
          a = put_n(&mut o, a, k.fs.lo_dev);
          a = put_s(&mut o, a, " /");
        }
        let mut j = 0;
        while j < l
          invariant j <= l && l <= NAMEBUF && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
        {
          a = put_c(&mut o, a, bget(k.fs.name, j));
          j = j + 1;
        }
        if k.fs.lo_ro {
          a = put_s(&mut o, a, " bstdisk3 ro 0 0\n");
        } else {
          a = put_s(&mut o, a, " bstdisk3 rw 0 0\n");
        }
      }
    }
    return a;
  }
  if what == PF_MEMINFO {
    let total = pool_size(k.mem.pool) * 4;   // the RAM the pool holds
    let avail = count_free(k.mem.bm) * 4;
    let mut a = put_s(&mut o, 0, "MemTotal: ");
    a = put_n(&mut o, a, total);
    a = put_s(&mut o, a, " kB\nMemFree: ");
    a = put_n(&mut o, a, avail);
    a = put_s(&mut o, a, " kB\nMemAvailable: ");
    a = put_n(&mut o, a, avail);
    return put_s(&mut o, a, " kB\nBuffers: 0 kB\nCached: 0 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n");
  }
  if what == PF_CPUINFO && p == 0 {
    let mut a = 0;
    let mut c = 0;
    while c < k.cpus
      invariant a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
    {
      a = put_s(&mut o, a, "processor\t: ");
      a = put_n(&mut o, a, c);
      a = put_s(&mut o, a, "\nmodel name\t: x86-64\nflags\t\t: fpu tsc msr pae apic sse sse2 syscall lm\n\n");
      c = c + 1;
    }
    return a;
  }
  if what == PF_FILESYSTEMS && p == 0 {
    let mut a = 0;
    let mut t = 0;
    while t < FS_TYPES
      invariant a <= PROC_OUT && blen(o) == PROC_OUT
    {
      if t + 1 < FS_TYPES {
        a = put_s(&mut o, a, "nodev");      // all but the disk's need no device
      }
      a = put_c(&mut o, a, 9);
      a = put_s(&mut o, a, fs_type_name(t));
      a = put_c(&mut o, a, 10);
      t = t + 1;
    }
    return a;
  }
  if what == PF_CMDLINE && p == 0 {
    return put_s(&mut o, 0, "BOOT_IMAGE=/boot/bastios.elf\n");
  }
  if what == PF_LOADAVG && p == 0 {
    // No load average is kept (sysinfo's loads are 0 too): then the
    // runnable and existing processes, and the newest process id.
    let mut live = 0;
    let mut run = 0;
    let mut last = 0;
    let mut q = 1;
    while q < NPROC
      invariant 1 <= q && q <= NPROC && live < q && run <= live && last < q && kok(k)
    {
      let st = state(k.procs, q);
      if st != FREE && st != ZOMBIE {
        live = live + 1;
        last = q;
        if st == READY || st == RUNNING {
          run = run + 1;
        }
      }
      q = q + 1;
    }
    let mut a = put_s(&mut o, 0, "0.00 0.00 0.00 ");
    a = put_n(&mut o, a, run);
    a = put_c(&mut o, a, 47);
    a = put_n(&mut o, a, live);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, last);
    return put_c(&mut o, a, 10);
  }
  if what == PF_UPTIME {
    let mut a = put_n(&mut o, 0, k.ns / NS_PER_S);
    a = put_c(&mut o, a, 46);
    a = put_2(&mut o, a, k.ns / 10000000 % 100);
    return put_s(&mut o, a, " 0.00\n");
  }
  if p == 0 || state(k.procs, p) == FREE {
    return 0;                               // it ended after the file was opened
  }
  let s = state(k.procs, p);
  let parent = pget(k.procs, p, F_PARENT);
  if what == PF_STAT {
    // pid (comm) state ppid pgrp session tty_nr tpgid flags minflt cminflt
    // majflt cmajflt utime stime cutime cstime priority nice num_threads
    // itrealvalue starttime, then 30 more fields of zeros.
    let mut a = put_n(&mut o, 0, p);
    a = put_s(&mut o, a, " (");
    a = put_comm(&mut k, p, &mut o, a);
    a = put_s(&mut o, a, ") ");
    a = put_c(&mut o, a, state_letter(s, pget(k.procs, p, F_ASLEEP) != 0));
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, parent);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, p);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, p);
    a = put_s(&mut o, a, " 0 -1 0 0 0 0 0 ");
    a = put_n(&mut o, a, pget(k.procs, p, F_TICKS));
    let ni = nice_of(k.procs, p);
    a = put_s(&mut o, a, " 0 0 0 ");
    a = put_n(&mut o, a, ni);               // the priority: 20 + nice
    a = put_c(&mut o, a, 32);
    if ni < 20 {
      a = put_c(&mut o, a, 45);
      a = put_n(&mut o, a, 20 - ni);
    } else {
      a = put_n(&mut o, a, ni - 20);
    }
    a = put_s(&mut o, a, " 1 0 0");
    let mut z = 0;
    while z < 30
      invariant z <= 30 && a <= PROC_OUT && blen(o) == PROC_OUT
    {
      a = put_s(&mut o, a, " 0");
      z = z + 1;
    }
    return put_c(&mut o, a, 10);
  }
  if what == PF_STATUS {
    let mut a = put_s(&mut o, 0, "Name:\t");
    a = put_comm(&mut k, p, &mut o, a);
    a = put_s(&mut o, a, "\nState:\t");
    a = put_c(&mut o, a, state_letter(s, pget(k.procs, p, F_ASLEEP) != 0));
    a = put_s(&mut o, a, "\nTgid:\t");
    a = put_n(&mut o, a, p);
    a = put_s(&mut o, a, "\nPid:\t");
    a = put_n(&mut o, a, p);
    a = put_s(&mut o, a, "\nPPid:\t");
    a = put_n(&mut o, a, parent);
    a = put_s(&mut o, a, "\nUid:");
    a = put_ids(&mut o, a, k.procs, p, F_UID, F_SUID);
    a = put_s(&mut o, a, "\nGid:");
    a = put_ids(&mut o, a, k.procs, p, F_GID, F_SGID);
    a = put_s(&mut o, a, "\nGroups:\t");
    let ng = ngroups(k.procs, p);
    let mut i = 0;
    while i < ng
      invariant i <= ng && ng <= NGROUPS_KEPT && blen(o) == PROC_OUT && a <= PROC_OUT && kok(k)
    {
      a = put_n(&mut o, a, group_at(k.procs, p, i));
      a = put_c(&mut o, a, 32);
      i = i + 1;
    }
    a = put_s(&mut o, a, "\nVmLck:\t");
    a = put_n(&mut o, a, rl_locked(k, p) / 1024);
    return put_s(&mut o, a, " kB\nThreads:\t1\n");
  }
  if what == PF_COMM {
    let a = put_comm(&mut k, p, &mut o, 0);
    return put_c(&mut o, a, 10);
  }
  if what == PF_SLACK {
    let a = put_n(&mut o, 0, pr_slack(k, p));
    return put_c(&mut o, a, 10);
  }
  if what == PF_MAPS {
    // Only the regions whose place is fixed: the stack (mapped on demand
    // over its whole reach) and the vDSO. The program, its heap and its
    // mmaps are not listed: no list of them is kept, only page tables.
    let mut a = put_x(&mut o, 0, USER_BASE + VDSO_PAGE * 4096);
    a = put_c(&mut o, a, 45);
    a = put_x(&mut o, a, USER_BASE + (VDSO_PAGE + 1) * 4096);
    a = put_s(&mut o, a, " r-xp 00000000 00:00 0                          [vdso]\n");
    a = put_x(&mut o, a, USER_BASE + STACK_FIRST * 4096);
    a = put_c(&mut o, a, 45);
    a = put_x(&mut o, a, USER_BASE + USER_SIZE);
    return put_s(&mut o, a, " rw-p 00000000 00:00 0                          [stack]\n");
  }
  if what == PF_CMDLINE {
    let a = put_prog(&mut k, p, &mut o, 0, true);
    return put_c(&mut o, a, 0);
  }
  if what == PF_EXE {
    return put_prog(&mut k, p, &mut o, 0, false);
  }
  return 0;
}

// ---------------------------------------------------------------- calls

/// read(2) on /proc file f, open in descriptor fd: the bytes of the file
/// as generated now, from the description's offset.
fn proc_read(k: &mut Kernel, pid: u64, fd: u64, f: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N || is_exe_file(f) {
    return EBADF;
  }
  let off = of_get(k.ofd, h, 3);
  let mut out = balloc(PROC_OUT);
  let l = proc_text(&mut k, f, &mut out);
  if off >= l || n == 0 {
    bfree(out);
    return 0;
  }
  let m = smaller(smaller(n, l - off), XFER);
  let mut i = 0;
  while i < m
    invariant i <= m && m <= l - off && off < l && l <= PROC_OUT && m <= XFER && blen(out) == PROC_OUT && kok(k)
  {
    bset(&mut k.fs.xfer, i, bget(out, off + i));
    i = i + 1;
  }
  bfree(out);
  let put = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, m);
  if put == NO_RESULT || put == 0 {
    return EFAULT;
  }
  of_set(&mut k.ofd, h, 3, off + put);
  return put;
}

/// If x[..n] is /proc/PID/fd/N: PID * LXNFD + N, else NO_RESULT. Only
/// readlink knows these links; they are not listed or stat'ed.
fn proc_fd(procs: &Buf, x: &Bytes, n: u64) -> u64
  requires ptab_ok(procs) && n <= blen(x)
  ensures result == NO_RESULT || result < NPROC * LXNFD
{
  if n < 6 || !xfer_is(x, 0, 5, "proc/") {
    return NO_RESULT;
  }
  let e = comp_end(x, 5, n);
  let p = proc_pid(procs, x, 5, e);
  if p >= NPROC || n < e + 5 || n > e + 6 || !xfer_is(x, e, e + 4, "/fd/") {
    return NO_RESULT;
  }
  let mut fd = 0;
  let mut i = e + 4;
  while i < n
    invariant e + 4 <= i && i <= n && n <= e + 6 && fd < 100
  {
    let c = cast[u64](bget(x, i));
    if c < 48 || c > 57 || fd >= 10 {
      return NO_RESULT;
    }
    fd = fd * 10 + (c - 48);
    i = i + 1;
  }
  if fd >= LXNFD {
    return NO_RESULT;
  }
  return p * LXNFD + fd;
}

/// The target of /proc/P/fd/FD into o: "/dev/tty" for the console, the
/// path of a file, a "pipe:[N]" or "socket:[N]" or "anon_inode:[...]"
/// name for the rest. Returns its length, or NO_RESULT if fd is closed.
fn fd_link(k: &mut Kernel, p: u64, fd: u64, o: &mut Bytes) -> u64
  requires kok(k) && p < NPROC && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT
  ensures result <= PROC_OUT || result == NO_RESULT
{
  let d = fd_look(k, p, fd);
  if d.kind == K_BAD {
    return NO_RESULT;
  }
  if d.kind == K_CONSOLE {
    return put_s(&mut o, 0, "/dev/tty");
  }
  if d.kind == K_DEV && d.x >= DEV_PTS && d.x < DEV_PTS + PTY_N {
    return put_n(&mut o, put_s(&mut o, 0, "/dev/pts/"), d.x - DEV_PTS);
  }
  if d.kind == K_DEV && d.x >= DEV_PTM && d.x < DEV_PTM + PTY_N {
    return put_s(&mut o, 0, "/dev/ptmx");
  }
  if d.kind == K_PIPE_R || d.kind == K_PIPE_W {
    let a = put_s(&mut o, 0, "pipe:[");
    return put_c(&mut o, put_n(&mut o, a, d.x), 93);
  }
  if d.kind == K_SOCK {
    let a = put_s(&mut o, 0, "socket:[");
    return put_c(&mut o, put_n(&mut o, a, d.x), 93);
  }
  if d.kind == K_FILE {
    let f = vfs_row_file(k.fs, d.x);
    if f != NO_FILE {
      let n = vfs_dirent(&mut k.fs, f);
      if n != NO_FILE && n <= XFER {
        let mut a = put_c(&mut o, 0, 47);
        let mut j = 0;
        while j < n
          invariant j <= n && n <= XFER && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
        {
          a = put_c(&mut o, a, bget(k.fs.xfer, j));
          j = j + 1;
        }
        return a;
      }
    }
  }
  return put_s(&mut o, 0, "anon_inode:[file]");
}

/// readlink / readlinkat(dirfd, path, buf, size): the target of
/// /proc/PID/exe or /proc/PID/fd/N, without a NUL; -EINVAL for anything
/// else that exists, since nothing else is a symbolic link.
fn lx_readlink(k: &mut Kernel, pid: u64, dirfd: u64, path: u64, va: u64, size: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_at_nf(&mut k, pid, dirfd, path);
  if n == NO_RESULT {
    return k.perr;
  }
  let lk = vfs_lookup(&mut k.fs, n);
  if lk != NO_FILE && vfs_is_link(&mut k.fs, lk) {
    return link_out(&mut k, pid, lk, va, size);   // a symbolic link (src/lxlink.bastio)
  }
  let mut pfd = NO_RESULT;
  if n <= XFER {
    pfd = proc_fd(k.procs, k.fs.xfer, n);
  }
  if pfd != NO_RESULT {
    if size == 0 || size > 0x7FFFFFFF {
      return EINVAL;
    }
    let mut lo = balloc(PROC_OUT);
    let ln = fd_link(&mut k, pfd / LXNFD, pfd % LXNFD, &mut lo);
    if ln == NO_RESULT {
      bfree(lo);
      return ENOENT;
    }
    let m = smaller(ln, smaller(size, XFER));
    let mut i = 0;
    while i < m
      invariant i <= m && m <= PROC_OUT && m <= XFER && blen(lo) == PROC_OUT && kok(k)
    {
      bset(&mut k.fs.xfer, i, bget(lo, i));
      i = i + 1;
    }
    bfree(lo);
    if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, m) != m {
      return EFAULT;
    }
    return m;
  }
  let f = proc_file(k.procs, k.fs.xfer, n);
  if f == 0 || !is_exe_file(f) {
    let m = path_meta(&mut k, n);
    if m.ok {
      return EINVAL;
    }
    return ENOENT;
  }
  if size == 0 || size > 0x7FFFFFFF {
    return EINVAL;
  }
  let mut out = balloc(PROC_OUT);
  let l = smaller(proc_text(&mut k, f, &mut out), smaller(size, XFER));
  let mut i = 0;
  while i < l
    invariant i <= l && l <= PROC_OUT && l <= XFER && blen(out) == PROC_OUT && kok(k)
  {
    bset(&mut k.fs.xfer, i, bget(out, i));
    i = i + 1;
  }
  bfree(out);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, l) != l {
    return EFAULT;
  }
  return l;
}

fn is_procfs_call(n: u64) -> bool {
  return n == LX_READLINK || n == LX_READLINKAT;
}

/// readlink and readlinkat.
fn lx_procfs_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_READLINK {
    return lx_readlink(&mut k, pid, AT_FDCWD, a, b, c);
  }
  return lx_readlink(&mut k, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10));
}
