// /proc for Linux programs, generated on each read and read-only: enough
// for BusyBox's ps, free, df and uptime and for programs that look at
// themselves.
//
//   /proc/mounts            the mount table ("/", "/proc", and "/disk" with a disk)
//   /proc/meminfo           total and free memory, as sysinfo counts them
//   /proc/uptime            seconds since boot
//   /proc/cpuinfo           one block per running processor
//   /proc/stat              cpu and cpuN times, btime, processes, procs_running
//   /proc/modules           empty: there are no loadable modules
//   /proc/diskstats         empty: the disks keep no I/O counts
//   /proc/net/dev           the interfaces of the reader's network namespace
//   /proc/filesystems       the file system types mount names
//   /proc/version           the release uname gives, as a Linux banner
//   /proc/sys/kernel/tainted, pid_max, printk, and the System V IPC
//   limits shmmax, shmall, shmmni, msgmax, msgmnb, msgmni, sem
//                           read-only sysctls with their fixed values
//   /proc/sys/fs/pipe-max-size  the most F_SETPIPE_SZ gives; root may write it
//   /proc/sys/fs/inotify/max_queued_events, max_user_instances,
//   max_user_watches        inotify's fixed limits (src/lxinotify.bastio)
//   /proc/sys/kernel/hostname, domainname, ostype, osrelease, version
//                           what uname says (src/lxsys.bastio)
//   /proc/sysvipc/msg, sem, shm
//                           the System V IPC objects (src/lxipc.bastio)
//   /proc/PID/              one directory per process (zombies included)
//   /proc/PID/stat          the one-line status ps reads (52 fields)
//   /proc/PID/status        the same as "Name:\t..." lines
//   /proc/PID/cmdline       the program's name: argv is not kept
//   /proc/PID/exe           a symbolic link to the program (readlink; open
//                           opens the program, src/lxopen2.bastio)
//   /proc/PID/mounts        the same as /proc/mounts
//   /proc/PID/ns/           a link per namespace (src/lxnsk.bastio)
//   /proc/self              the caller's own directory
//   /sys/block/loopN/size, ro, and loop/backing_file, offset, sizelimit,
//   autoclear, partscan, dio
//                           a loop device's settings (src/lxloop.bastio),
//                           as losetup and LTP read them
//
// "self" is rewritten to the caller's pid when a path is read from user
// memory (lx_path_from), so everything after sees /proc/PID. A file is an
// open file description of kind OF_DEV whose device is PROC_DEV + 16 * pid
// + PF_*, and whose word 3 is the read offset; a directory is an OF_DIR
// description whose x is DIR_PROC (+ pid). Each read generates the whole
// file (at most PROC_OUT bytes) and hands out the part past the offset, so
// a file read in several calls can mix two moments, as small /proc files
// can on Linux too.
//
// Not here: argv in cmdline, readlink of /proc/self itself (it reads as
// the directory), /proc/PID/fd, maps and environ, writable sysctls but
// pipe-max-size (proc_write), and
// /proc/sys as a directory (its files open and stat, but are not listed).
// A sysctl for a feature BastiOS lacks (splice, say) is left out,
// so a program that checks for it finds the feature missing.

import "linux.bastio";
import "core/num.bastio";
import "lxnsbase.bastio";

// PROC_DEV, DIR_PROC, PF_EXE and EACCES are in src/proc.bastio, which the
// files that hook in here are compiled after.

const PF_MOUNTS: u64 = 1;
const PF_AUXV: u64 = 2;               // /proc/PID/auxv (2 is pid 0's meminfo)
const PF_MEMINFO: u64 = 2;
const PF_MEM: u64 = 3;                // /proc/PID/mem (3 is pid 0's uptime)
const PF_UPTIME: u64 = 3;
const PF_STAT: u64 = 4;
const PF_CMDLINE: u64 = 5;
const PF_STATUS: u64 = 6;
const PF_CPUINFO: u64 = 8;            // these two with pid 0; 7 is PF_EXE
const PF_FILESYSTEMS: u64 = 9;
const PF_MAPS: u64 = 10;
const PF_COMM: u64 = 11;
const PF_SLACK: u64 = 12;
const PF_LOADAVG: u64 = 13;           // with pid 0
const PF_VERSION: u64 = 14;           // with pid 0
const PF_CGROUP: u64 = 15;            // /proc/PID/cgroup
const PF_MOUNTINFO: u64 = 13;         // /proc/PID/mountinfo (13 is pid 0's loadavg)
const PF_STATM: u64 = 8;              // /proc/PID/statm (8 is pid 0's cpuinfo)
const PF_IO: u64 = 9;                 // /proc/PID/io (9 is pid 0's filesystems)
const PF_LIMITS: u64 = 14;            // /proc/PID/limits (14 is free for a process)
const PF_MODULES: u64 = 6;            // with pid 0 (status has 6 for a process): /proc/modules
const PF_DISKSTATS: u64 = 11;         // with pid 0: /proc/diskstats (comm has 11 for a process)
const PF_NETTCP: u64 = 12;            // with pid 0: /proc/net/tcp (slack has 12 for a process)
const PF_NETTCP6: u64 = 15;           // with pid 0: /proc/net/tcp6 (cgroup has 15 for a process)
const PF_NETDEV: u64 = 10;            // with pid 0: /proc/net/dev (maps has 10 for a process)
const PSYS: u64 = 16 * NPROC;         // PROC_DEV + PSYS + SY_*: a /proc/sys file
const SY_TAINTED: u64 = 1;
const SY_PID_MAX: u64 = 2;
const SY_PRINTK: u64 = 3;
const SY_IPC: u64 = 4;                // 4 .. 13: ipc_proc_text (src/lxipc.bastio)
const SY_IPC_END: u64 = 14;
const SY_UTS: u64 = 14;                // 14 .. 17: uts_proc_text (src/lxsys.bastio)
const SY_UTS_END: u64 = 19;
const SY_PIPE_MAX: u64 = 19;
const SY_INO: u64 = 20;                // 20 .. 22: /proc/sys/fs/inotify (src/lxinotify.bastio)
const SY_NETUDP: u64 = 23;             // /proc/net/udp
const SY_NETUDP6: u64 = 24;            // /proc/net/udp6
const SY_NETUNIX: u64 = 25;            // /proc/net/unix
const SY_NETRAW: u64 = 26;             // /proc/net/raw
const SY_NETROUTE: u64 = 27;           // /proc/net/route
const SY_NETARP: u64 = 28;             // /proc/net/arp
const SY_CORE: u64 = 29;               // /proc/sys/kernel/core_pattern ("core": a dump goes to a file of that name, src/lxcore.bastio)
const SY_NROPEN: u64 = 30;             // /proc/sys/fs/nr_open
const SY_DROP: u64 = 31;               // /proc/sys/vm/drop_caches: written, kept for nothing
const SY_SC: u64 = 32;                // 32 .. 32 + SCT_N: the plain sysctl files of src/lxsysctl.bastio
const SY_NEXTID: u64 = 96;             // 96 .. 98: /proc/sys/kernel/{msg,sem,shm}_next_id, by IPC kind (src/lxipc.bastio)
const SY_NS: u64 = 128;                // 128 ..: /proc/P/ns link f at P * NF_N + f (src/lxnsk.bastio)
const NF_N: u64 = 10;
const SY_UM: u64 = SY_NS + NPROC * NF_N;   // /proc/P/uid_map, gid_map, setgroups at P * 3 + 0, 1, 2 (src/lxuser.bastio)
const UMF_N: u64 = 3;
const SY_CG: u64 = SY_UM + NPROC * UMF_N;   // a cgroup's control file f at slot * CGF_N + f (src/lxcgroup.bastio)
const CGF_N: u64 = 18;
const SY_LOOP: u64 = SY_CG + CG_N * CGF_N;   // after the cgroups: loop device n's attribute a at n * LOOP_SYS + a
const NS_DIRS: u64 = 0x400;            // DIR_PROC + NS_DIRS + pid: /proc/PID/ns
const FD_DIRS: u64 = 0x800;            // DIR_PROC + FD_DIRS + pid: /proc/PID/fd
const TASK_DIRS: u64 = 0xC00;          // DIR_PROC + TASK_DIRS + pid: /proc/PID/task
const FDI_DIRS: u64 = 0x1800;           // DIR_PROC + FDI_DIRS + pid: /proc/PID/fdinfo
const SYSD: u64 = 0x1400;              // DIR_PROC + SYSD + j: /proc/sys and its directories (src/lxsysctl.bastio)
const NET_DIR: u64 = 0x1000;            // DIR_PROC + NET_DIR: /proc/net
const LOOP_SYS: u64 = 8;               // size, ro, backing_file, offset, sizelimit, autoclear, partscan, dio
const SY_PX: u64 = SY_LOOP + LOOP_N * LOOP_SYS;   // after the loop devices: /proc/P/ file w at P * PXF_N + w (src/lxsysctl.bastio)
const SY_FI: u64 = SY_PX + NPROC * PXF_N;   // after those: /proc/P/fdinfo/FD at P * LXNFD + FD
const PROC_OUT: u64 = 4096;           // XFER: the most a /proc file holds
const S_IFLNK: u64 = 0xA1FF;          // a symbolic link, rwxrwxrwx
const S_IFREG_RO: u64 = 0x8124;       // a regular file, r--r--r--
const INO_PROC: u64 = INO_FILES + HFILES;  // /proc inode numbers start here (past every file's: INO_FILES + the handle)
const LX_READLINK: u64 = 89;
const LX_READLINKAT: u64 = 267;

// ---------------------------------------------------------------- paths

/// Whether bytes from..to of x are "self".
fn is_self(x: &Bytes, from: u64, to: u64) -> bool
  requires from <= to && to <= blen(x)
{
  return xfer_is(x, from, to, "self");
}

/// Where the path component starting at `from` in x[..n] ends.
fn comp_end(x: &Bytes, from: u64, n: u64) -> u64
  requires from <= n && n <= blen(x)
  ensures from <= result && result <= n
{
  let mut e = from;
  while e < n && bget(x, e) != 47
    invariant from <= e && e <= n
  {
    e = e + 1;
  }
  return e;
}

/// Writes pid p (below 10000) in decimal at x[at..]; how many digits.
fn dec_out(x: &mut Bytes, at: u64, p: u64) -> u64
  requires p < 10000 && at + 4 <= blen(x)
  ensures blen(x) == old(blen(x)) && 1 <= result && result <= 4
{
  if p >= 1000 {
    bset(&mut x, at, cast[u8](48 + p / 1000));
    bset(&mut x, at + 1, cast[u8](48 + p / 100 % 10));
    bset(&mut x, at + 2, cast[u8](48 + p / 10 % 10));
    bset(&mut x, at + 3, cast[u8](48 + p % 10));
    return 4;
  }
  if p >= 100 {
    bset(&mut x, at, cast[u8](48 + p / 100));
    bset(&mut x, at + 1, cast[u8](48 + p / 10 % 10));
    bset(&mut x, at + 2, cast[u8](48 + p % 10));
    return 3;
  }
  if p >= 10 {
    bset(&mut x, at, cast[u8](48 + p / 10));
    bset(&mut x, at + 1, cast[u8](48 + p % 10));
    return 2;
  }
  bset(&mut x, at, cast[u8](48 + p));
  return 1;
}

/// Writes v (below 10 million) in decimal at x[at..]; how many digits.
fn dec_big(x: &mut Bytes, at: u64, v: u64) -> u64
  requires v < 10000000 && at + 7 <= blen(x)
  ensures blen(x) == old(blen(x)) && 1 <= result && result <= 7
{
  let mut d = 1;
  if v >= 1000000 {
    d = 7;
  } else if v >= 100000 {
    d = 6;
  } else if v >= 10000 {
    d = 5;
  } else if v >= 1000 {
    d = 4;
  } else if v >= 100 {
    d = 3;
  } else if v >= 10 {
    d = 2;
  }
  let mut i = d;
  let mut r = v;
  while i > 0
    invariant i <= d && d <= 7 && at + 7 <= blen(x) && blen(x) == old(blen(x))
  {
    bset(&mut x, at + i - 1, cast[u8](48 + r % 10));
    r = r / 10;
    i = i - 1;
  }
  return d;
}

/// Rewrites a leading "proc/self" in x[..n] to "proc/PID" for the caller.
/// Returns the new length, never more than n.
fn proc_self(x: &mut Bytes, n: u64, pid: u64) -> u64
  requires n <= blen(x) && pid < NPROC
  ensures blen(x) == old(blen(x)) && result <= n
{
  if n < 9 || !xfer_is(x, 0, 5, "proc/") || comp_end(x, 5, n) != 9 || !is_self(x, 5, 9) {
    return n;
  }
  // "self" (4 bytes) becomes 1 to 4 digits: move the rest left.
  let d = dec_out(&mut x, 5, pid);
  let l = blen(x);
  let mut i = 9;
  while i < n
    invariant 9 <= i && i <= n && n <= l && blen(x) == l
  {
    bset(&mut x, i - 4 + d, bget(x, i));
    i = i + 1;
  }
  return n - 4 + d;
}

/// "proc/N/task/M/fd..." and "proc/N/task/M/ns..." in x[..n], for a thread M
/// of N's group, become "proc/M/fd..." and "proc/M/ns...": the descriptors and
/// namespaces of a thread are its process's. (runc and Go reach their own
/// descriptors as /proc/self/task/TID/fd/N when /proc/thread-self is absent.)
/// The other files under task/M are found by proc_file. Returns the new length.
fn proc_task(k: &mut Kernel, n: u64) -> u64
  requires kok(k) && n <= FNAME_MAX
  ensures kok(k) && result <= n
{
  if n < 14 || !xfer_is(k.fs.xfer, 0, 5, "proc/") {
    return n;
  }
  let e = comp_end(k.fs.xfer, 5, n);
  if e + 6 >= n || !xfer_is(k.fs.xfer, e, e + 6, "/task/") {
    return n;
  }
  let te = comp_end(k.fs.xfer, e + 6, n);
  if te + 3 > n || te - e - 6 > 3 {
    return n;
  }
  let fd = xfer_is(k.fs.xfer, te, te + 3, "/fd");
  let ns = xfer_is(k.fs.xfer, te, te + 3, "/ns");
  if (!fd && !ns) || (te + 3 < n && bget(k.fs.xfer, te + 3) != 47) {
    return n;
  }
  let q = proc_pid(k.procs, k.fs.xfer, 5, e);
  let t = proc_pid(k.procs, k.fs.xfer, e + 6, te);
  if q >= NPROC || t >= NPROC || (t != q && tgid(k.procs, t) != q) {
    return n;
  }
  // Move the thread's digits to x[5..], then the rest after them.
  let l = te - e - 6;
  let mut i = 0;
  while i < l
    invariant i <= l && l <= 3 && e + 6 + l == te && te <= n && n <= FNAME_MAX && blen(k.fs.xfer) == XFER && kok(k)
  {
    bset(&mut k.fs.xfer, 5 + i, bget(k.fs.xfer, e + 6 + i));
    i = i + 1;
  }
  let mut j = te;
  while j < n
    invariant te <= j && j <= n && n <= FNAME_MAX && l <= 3 && e + 6 + l == te && blen(k.fs.xfer) == XFER && kok(k)
  {
    bset(&mut k.fs.xfer, 5 + l + (j - te), bget(k.fs.xfer, j));
    j = j + 1;
  }
  return 5 + l + (n - te);
}

/// For a caller in a PID namespace other than the first, "proc/N..." in
/// x[..n] names the process with id N there: N becomes the kernel's row
/// number for it (0, which names none, if there is no such process), so
/// the lookups below see rows. Returns the new length.
fn proc_vpid(k: &mut Kernel, n: u64, pid: u64) -> u64
  requires kok(k) && pid < NPROC && n <= FNAME_MAX
  ensures kok(k) && result <= FNAME_MAX
{
  if nsk_of(k, NSK_PID, pid) == 0 || n < 6 || !xfer_is(k.fs.xfer, 0, 5, "proc/") {
    return n;
  }
  let e = comp_end(k.fs.xfer, 5, n);
  if e == 5 || e - 5 > 7 || bget(k.fs.xfer, 5) == 48 {
    return n;
  }
  let mut v = 0;
  let mut i = 5;
  while i < e
    invariant 5 <= i && i <= e && e <= n && n <= FNAME_MAX && v < 10000000 && kok(k)
  {
    let c = cast[u64](bget(k.fs.xfer, i));
    if c < 48 || c > 57 {
      return n;                             // not an id: "self", "mounts", ...
    }
    if v >= 1000000 {
      return n;                             // ids stay below a million (src/lxnsk.bastio)
    }
    v = v * 10 + (c - 48);
    i = i + 1;
  }
  let r = kpid_of(k, pid, v);
  let mut row = 0;
  if r < NPROC {
    row = r;
  }
  let l = e - 5;
  let mut d = 1;
  if row >= 1000 {
    d = 4;
  } else if row >= 100 {
    d = 3;
  } else if row >= 10 {
    d = 2;
  }
  if d > l && n + (d - l) > FNAME_MAX {
    row = 0;
    d = 1;                                  // no room for the longer name: none
  }
  if d <= l {
    let mut j = e;
    while j < n
      invariant e <= j && j <= n && n <= FNAME_MAX && 1 <= d && d <= l && l == e - 5 && 6 <= e && blen(k.fs.xfer) == XFER && kok(k)
    {
      bset(&mut k.fs.xfer, j - l + d, bget(k.fs.xfer, j));
      j = j + 1;
    }
    let w = dec_out(&mut k.fs.xfer, 5, row);
    return n - l + d;
  }
  let mut j = n;
  while j > e
    invariant e <= j && j <= n && n + d - l <= FNAME_MAX && l < d && d <= 4 && l == e - 5 && 6 <= e && blen(k.fs.xfer) == XFER && kok(k)
  {
    bset(&mut k.fs.xfer, j - 1 + d - l, bget(k.fs.xfer, j - 1));
    j = j - 1;
  }
  let w = dec_out(&mut k.fs.xfer, 5, row);
  return n + d - l;
}

/// The process x[from..to] names, as decimal digits: a live one (zombies
/// count), or NPROC.
fn proc_pid(procs: &Buf, x: &Bytes, from: u64, to: u64) -> u64
  requires ptab_ok(procs) && from <= to && to <= blen(x)
  ensures result <= NPROC
{
  if to == from || to - from > 4 || bget(x, from) == 48 {
    return NPROC;
  }
  let mut p = 0;
  let mut i = from;
  while i < to
    invariant from <= i && i <= to && p < 10000
  {
    let c = cast[u64](bget(x, i));
    if c < 48 || c > 57 {
      return NPROC;
    }
    p = p * 10 + (c - 48);
    if p >= 10000 {
      return NPROC;
    }
    i = i + 1;
  }
  if p == 0 || p >= NPROC || state(procs, p) == FREE {
    return NPROC;
  }
  return p;
}

/// The directory description for x[..n] if it is /proc or /proc/PID, or
/// NO_FILE.
fn proc_dir(procs: &Buf, x: &Bytes, n: u64) -> u64
  requires ptab_ok(procs) && n <= blen(x)
{
  if n == 4 && xfer_is(x, 0, 4, "proc") {
    return DIR_PROC;
  }
  if n < 6 || !xfer_is(x, 0, 5, "proc/") {
    return NO_FILE;
  }
  if n == 8 && xfer_is(x, 5, n, "net") {
    return DIR_PROC + NET_DIR;
  }
  let mut sj = 0;
  while sj < SYSD_N
    invariant sj <= SYSD_N
  {
    if xfer_is(x, 5, n, sysd_path(sj)) {
      return DIR_PROC + SYSD + sj;
    }
    sj = sj + 1;
  }
  let e = comp_end(x, 5, n);
  if e + 3 == n && xfer_is(x, e, n, "/ns") {
    let q = proc_pid(procs, x, 5, e);
    if q >= NPROC {
      return NO_FILE;
    }
    return DIR_PROC + NS_DIRS + q;          // /proc/PID/ns
  }
  if e + 3 == n && xfer_is(x, e, n, "/fd") {
    let q = proc_pid(procs, x, 5, e);
    if q >= NPROC {
      return NO_FILE;
    }
    return DIR_PROC + FD_DIRS + q;          // /proc/PID/fd
  }
  if e + 7 == n && xfer_is(x, e, n, "/fdinfo") {
    let q = proc_pid(procs, x, 5, e);
    if q >= NPROC {
      return NO_FILE;
    }
    return DIR_PROC + FDI_DIRS + q;         // /proc/PID/fdinfo
  }
  if e + 5 == n && xfer_is(x, e, n, "/task") {
    let q = proc_pid(procs, x, 5, e);
    if q >= NPROC {
      return NO_FILE;
    }
    return DIR_PROC + TASK_DIRS + q;        // /proc/PID/task
  }
  if e + 6 < n && xfer_is(x, e, e + 6, "/task/") {
    // /proc/PID/task/TID: the thread's own directory, for a thread of the group
    let q = proc_pid(procs, x, 5, e);
    let te = comp_end(x, e + 6, n);
    if q >= NPROC || te != n {
      return NO_FILE;
    }
    let t = proc_pid(procs, x, e + 6, te);
    if t < NPROC && (t == q || tgid(procs, t) == q) {
      return DIR_PROC + t;
    }
    return NO_FILE;
  }
  if e != n {
    return NO_FILE;
  }
  let p = proc_pid(procs, x, 5, n);
  if p >= NPROC {
    return NO_FILE;
  }
  return DIR_PROC + p;
}

/// The device for x[..n] if it is a /proc file, or 0.
fn proc_file(procs: &Buf, x: &Bytes, n: u64) -> u64
  requires ptab_ok(procs) && n <= blen(x)
{
  let s = loop_sys_at(x, n);
  if s != 0 {
    return PROC_DEV + PSYS + SY_LOOP + s - 1;
  }
  if n < 6 || !xfer_is(x, 0, 5, "proc/") {
    return 0;
  }
  let mut e = comp_end(x, 5, n);
  if e == n {
    if xfer_is(x, 5, n, "mounts") {
      return PROC_DEV + PF_MOUNTS;
    }
    if xfer_is(x, 5, n, "meminfo") {
      return PROC_DEV + PF_MEMINFO;
    }
    if xfer_is(x, 5, n, "uptime") {
      return PROC_DEV + PF_UPTIME;
    }
    if xfer_is(x, 5, n, "loadavg") {
      return PROC_DEV + PF_LOADAVG;
    }
    if xfer_is(x, 5, n, "version") {
      return PROC_DEV + PF_VERSION;
    }
    if xfer_is(x, 5, n, "cpuinfo") {
      return PROC_DEV + PF_CPUINFO;
    }
    if xfer_is(x, 5, n, "filesystems") {
      return PROC_DEV + PF_FILESYSTEMS;
    }
    if xfer_is(x, 5, n, "stat") {
      return PROC_DEV + PF_STAT;            // pid 0: the system's own
    }
    if xfer_is(x, 5, n, "modules") {
      return PROC_DEV + PF_MODULES;
    }
    if xfer_is(x, 5, n, "diskstats") {
      return PROC_DEV + PF_DISKSTATS;
    }
    if xfer_is(x, 5, n, "cmdline") {
      return PROC_DEV + PF_CMDLINE;         // pid 0: the kernel's command line
    }
    return 0;
  }
  if xfer_is(x, 5, n, "net/dev") {
    return PROC_DEV + PF_NETDEV;
  }
  if xfer_is(x, 5, n, "net/tcp") {
    return PROC_DEV + PF_NETTCP;
  }
  if xfer_is(x, 5, n, "net/udp") {
    return PROC_DEV + PSYS + SY_NETUDP;
  }
  if xfer_is(x, 5, n, "net/arp") {
    return PROC_DEV + PSYS + SY_NETARP;
  }
  if xfer_is(x, 5, n, "net/route") {
    return PROC_DEV + PSYS + SY_NETROUTE;
  }
  if xfer_is(x, 5, n, "net/raw") {
    return PROC_DEV + PSYS + SY_NETRAW;
  }
  if xfer_is(x, 5, n, "net/unix") {
    return PROC_DEV + PSYS + SY_NETUNIX;
  }
  if xfer_is(x, 5, n, "net/udp6") {
    return PROC_DEV + PSYS + SY_NETUDP6;
  }
  if xfer_is(x, 5, n, "net/tcp6") {
    return PROC_DEV + PF_NETTCP6;
  }
  if xfer_is(x, 5, n, "sys/kernel/tainted") {
    return PROC_DEV + PSYS + SY_TAINTED;
  }
  if xfer_is(x, 5, n, "sys/kernel/pid_max") {
    return PROC_DEV + PSYS + SY_PID_MAX;
  }
  if xfer_is(x, 5, n, "sys/kernel/printk") {
    return PROC_DEV + PSYS + SY_PRINTK;
  }
  if xfer_is(x, 5, n, "sys/kernel/core_pattern") {
    return PROC_DEV + PSYS + SY_CORE;
  }
  if xfer_is(x, 5, n, "sys/fs/nr_open") {
    return PROC_DEV + PSYS + SY_NROPEN;
  }
  if xfer_is(x, 5, n, "sys/kernel/msg_next_id") {
    return PROC_DEV + PSYS + SY_NEXTID + KQ;
  }
  if xfer_is(x, 5, n, "sys/kernel/sem_next_id") {
    return PROC_DEV + PSYS + SY_NEXTID + KS;
  }
  if xfer_is(x, 5, n, "sys/kernel/shm_next_id") {
    return PROC_DEV + PSYS + SY_NEXTID + KM;
  }
  if xfer_is(x, 5, n, "sys/vm/drop_caches") {
    return PROC_DEV + PSYS + SY_DROP;
  }
  if xfer_is(x, 5, n, "sys/fs/pipe-max-size") {
    return PROC_DEV + PSYS + SY_PIPE_MAX;
  }
  let mut si = 0;
  while si < SCT_N
    invariant si <= SCT_N
  {
    if xfer_is(x, 5, n, sct_name(si)) {
      return PROC_DEV + PSYS + SY_SC + si;
    }
    si = si + 1;
  }
  if xfer_is(x, 5, n, "sys/fs/inotify/max_queued_events") {
    return PROC_DEV + PSYS + SY_INO;
  }
  if xfer_is(x, 5, n, "sys/fs/inotify/max_user_instances") {
    return PROC_DEV + PSYS + SY_INO + 1;
  }
  if xfer_is(x, 5, n, "sys/fs/inotify/max_user_watches") {
    return PROC_DEV + PSYS + SY_INO + 2;
  }
  let mut i = 0;
  while i < SY_IPC_END - SY_IPC
    invariant i <= SY_IPC_END - SY_IPC
  {
    if xfer_is(x, 5, n, ipc_proc_name(i)) {
      return PROC_DEV + PSYS + SY_IPC + i;
    }
    i = i + 1;
  }
  let mut j = 0;
  while j < SY_UTS_END - SY_UTS
    invariant j <= SY_UTS_END - SY_UTS
  {
    if xfer_is(x, 5, n, uts_proc_name(j)) {
      return PROC_DEV + PSYS + SY_UTS + j;
    }
    j = j + 1;
  }
  let mut p = proc_pid(procs, x, 5, e);
  if p >= NPROC {
    return 0;
  }
  if e + 6 < n && xfer_is(x, e + 1, e + 6, "task/") {
    // /proc/PID/task/TID/FILE is /proc/TID/FILE, for a thread of the group
    let te = comp_end(x, e + 6, n);
    let t = proc_pid(procs, x, e + 6, te);
    if t >= NPROC || te >= n || (t != p && tgid(procs, t) != p) {
      return 0;
    }
    p = t;
    e = te;
  }
  let base = PROC_DEV + 16 * p;
  if xfer_is(x, e + 1, n, "stat") {
    return base + PF_STAT;
  }
  if xfer_is(x, e + 1, n, "cmdline") {
    return base + PF_CMDLINE;
  }
  if xfer_is(x, e + 1, n, "auxv") {
    return base + PF_AUXV;
  }
  if xfer_is(x, e + 1, n, "mem") {
    return base + PF_MEM;
  }
  if xfer_is(x, e + 1, n, "status") {
    return base + PF_STATUS;
  }
  if xfer_is(x, e + 1, n, "exe") {
    return base + PF_EXE;
  }
  if xfer_is(x, e + 1, n, "mounts") {
    return base + PF_MOUNTS;
  }
  if xfer_is(x, e + 1, n, "maps") {
    return base + PF_MAPS;
  }
  if xfer_is(x, e + 1, n, "comm") {
    return base + PF_COMM;
  }
  if xfer_is(x, e + 1, n, "timerslack_ns") {
    return base + PF_SLACK;
  }
  if xfer_is(x, e + 1, n, "cgroup") {
    return base + PF_CGROUP;
  }
  if xfer_is(x, e + 1, n, "limits") {
    return base + PF_LIMITS;
  }
  if xfer_is(x, e + 1, n, "mountinfo") {
    return base + PF_MOUNTINFO;
  }
  if xfer_is(x, e + 1, n, "statm") {
    return base + PF_STATM;
  }
  if xfer_is(x, e + 1, n, "io") {
    return base + PF_IO;
  }
  let mut pw = 0;
  while pw < PXF_N
    invariant pw <= PXF_N
  {
    if xfer_is(x, e + 1, n, px_name(pw)) {
      return PROC_DEV + PSYS + SY_PX + p * PXF_N + pw;
    }
    pw = pw + 1;
  }
  if e + 8 < n && n <= e + 12 && xfer_is(x, e + 1, e + 8, "fdinfo/") {
    let mut fd = 0;
    let mut fi = e + 8;
    while fi < n
      invariant e + 8 <= fi && fi <= n && n <= e + 12 && fd < 10000
    {
      let c = cast[u64](bget(x, fi));
      if c < 48 || c > 57 || fd >= 1000 {
        return 0;
      }
      fd = fd * 10 + (c - 48);
      fi = fi + 1;
    }
    if fd >= LXNFD {
      return 0;
    }
    return PROC_DEV + PSYS + SY_FI + p * LXNFD + fd;     // /proc/PID/fdinfo/FD
  }
  let um = um_at(x, e + 1, n, p);
  if um != 0 {
    return um;                              // uid_map, gid_map or setgroups (src/lxuser.bastio)
  }
  if e + 4 < n && xfer_is(x, e + 1, e + 4, "ns/") {
    return nsf_at(x, e + 4, n, p);          // a namespace link (src/lxnsk.bastio)
  }
  return 0;
}

/// The /sys/block/loopN file the n-byte path in x names: N * LOOP_SYS +
/// its attribute + 1, or 0. The loop/ files are there whether or not the
/// device is bound (on Linux, only while it is).
fn loop_sys_at(x: &Bytes, n: u64) -> u64
  requires n <= blen(x)
  ensures result <= LOOP_N * LOOP_SYS
{
  if n < 17 || !xfer_is(x, 0, 14, "sys/block/loop") {
    return 0;
  }
  // One digit or two (no leading zero), then a slash.
  let c = cast[u64](bget(x, 14));
  if c < 48 || c >= 58 {
    return 0;
  }
  let mut v = c - 48;
  let mut at = 16;
  if cast[u64](bget(x, 15)) != 47 {
    let e = cast[u64](bget(x, 15));
    if c == 48 || e < 48 || e >= 58 || n < 18 || cast[u64](bget(x, 16)) != 47 {
      return 0;
    }
    v = v * 10 + e - 48;
    at = 17;
  }
  if v >= LOOP_N {
    return 0;
  }
  let base = v * LOOP_SYS + 1;
  if xfer_is(x, at, n, "size") {
    return base;
  }
  if xfer_is(x, at, n, "ro") {
    return base + 1;
  }
  if xfer_is(x, at, n, "loop/backing_file") {
    return base + 2;
  }
  if xfer_is(x, at, n, "loop/offset") {
    return base + 3;
  }
  if xfer_is(x, at, n, "loop/sizelimit") {
    return base + 4;
  }
  if xfer_is(x, at, n, "loop/autoclear") {
    return base + 5;
  }
  if xfer_is(x, at, n, "loop/partscan") {
    return base + 6;
  }
  if xfer_is(x, at, n, "loop/dio") {
    return base + 7;
  }
  return 0;
}

/// The text of /sys/block/loopN attribute s (N * LOOP_SYS + attribute).
fn loop_sys_text(k: &mut Kernel, s: u64, o: &mut Bytes) -> u64
  requires kok(k) && s < LOOP_N * LOOP_SYS && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let d = s / LOOP_SYS;
  let a = s % LOOP_SYS;
  let flags = lo_get(k.loops, d, 3);
  let mut v = 0;
  if a == 0 {
    v = loop_size(&mut k, d) / 512;         // in 512-byte sectors
  } else if a == 1 {
    v = flags % 2;
  } else if a == 2 {
    let row = loop_row(k, d);
    if row >= FD_ROWS {
      return put_c(&mut o, 0, 10);
    }
    let f = vfs_row_file(k.fs, row);
    let n = vfs_dirent(&mut k.fs, f);
    if f == NO_FILE || n == NO_FILE || n > XFER {
      return put_c(&mut o, 0, 10);
    }
    let mut at = put_c(&mut o, 0, 47);
    let mut j = 0;
    while j < n
      invariant j <= n && n <= XFER && at <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
    {
      at = put_c(&mut o, at, bget(k.fs.xfer, j));
      j = j + 1;
    }
    return put_c(&mut o, at, 10);
  } else if a == 3 {
    v = lo_get(k.loops, d, 1);
  } else if a == 4 {
    v = lo_get(k.loops, d, 2);
  } else if a == 5 {
    v = flags / 4 % 2;
  } else if a == 6 {
    v = flags / 8 % 2;
  } else {
    v = flags / 16 % 2;
  }
  let e = put_n(&mut o, 0, v);
  return put_c(&mut o, e, 10);
}

/// Whether /proc file f may be opened for writing (by root: it is
/// rw-r--r--): /proc/sys/fs/pipe-max-size, the one writable sysctl.
/// Is f one of the *_next_id files? Its IPC kind is f - PROC_DEV - PSYS - SY_NEXTID.
fn is_nextid_file(f: u64) -> bool {
  return f >= PROC_DEV + PSYS + SY_NEXTID && f < PROC_DEV + PSYS + SY_NEXTID + 3;
}

/// Is f one of the plain numeric sysctl files (src/lxsysctl.bastio)?
fn is_sct_file(f: u64) -> bool {
  return f >= PROC_DEV + PSYS + SY_SC && f < PROC_DEV + PSYS + SY_SC + SCT_NUM;
}

/// Is f one of the three inotify limits?
fn is_ino_file(f: u64) -> bool {
  return f >= PROC_DEV + PSYS + SY_INO && f < PROC_DEV + PSYS + SY_INO + 3;
}

/// Is f some process's oom_score_adj?
fn is_px_adj(f: u64) -> bool {
  let pbase = PROC_DEV + PSYS + SY_PX;
  return f >= pbase && f < pbase + NPROC * PXF_N && (f - pbase) % PXF_N == 1;
}

/// Is f some process's timens_offsets?
fn is_px_timens(f: u64) -> bool {
  let pbase = PROC_DEV + PSYS + SY_PX;
  return f >= pbase && f < pbase + NPROC * PXF_N && (f - pbase) % PXF_N == 10;
}

fn proc_writable(f: u64) -> bool {
  return is_px_timens(f) || is_mem_file(f) || is_px_adj(f) || is_sct_file(f) || is_ino_file(f) || f == PROC_DEV + PSYS + SY_PID_MAX || f == PROC_DEV + PSYS + SY_NROPEN || is_nextid_file(f) || f == PROC_DEV + PSYS + SY_IPC || f == PROC_DEV + PSYS + SY_IPC + 5 || f == PROC_DEV + PSYS + SY_UTS || f == PROC_DEV + PSYS + SY_UTS + 1 || f == PROC_DEV + PSYS + SY_PIPE_MAX || f == PROC_DEV + PSYS + SY_DROP || is_um_file(f) || (is_cg_file(f) && cgf_writable(cgd_f(f)));
}

/// What stat says about /proc file f (a proc_file device).
fn proc_meta(f: u64) -> Meta {
  if is_exe_file(f) {
    return Meta { ok: true, mode: S_IFLNK, size: 0, ino: INO_PROC + f % 4096, mtime: 0, own: 0 };
  }
  if proc_writable(f) {
    return Meta { ok: true, mode: 0x81A4, size: 0, ino: INO_PROC + f % 4096, mtime: 0, own: 0 };
  }
  return Meta { ok: true, mode: S_IFREG_RO, size: 0, ino: INO_PROC + f % 4096, mtime: 0, own: 0 };
}

/// What stat says about /proc directory d (a proc_dir description).
fn proc_dir_meta(d: u64) -> Meta {
  if d >= DIR_PROC + SYSD && d < DIR_PROC + SYSD + SYSD_N {
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: INO_PROC + 20000 + d % 1024, mtime: 0, own: 0 };
  }
  if d == DIR_PROC + NET_DIR {
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: INO_PROC + 16384, mtime: 0, own: 0 };
  }
  if d >= DIR_PROC + FDI_DIRS && d < DIR_PROC + FDI_DIRS + NPROC {
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: INO_PROC + 24576 + d % 1024, mtime: 0, own: 0 };
  }
  if d >= DIR_PROC + TASK_DIRS {
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: INO_PROC + 12288 + d % 1024, mtime: 0, own: 0 };
  }
  if d >= DIR_PROC + FD_DIRS {
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: INO_PROC + 8192 + d % 1024, mtime: 0, own: 0 };
  }
  if d >= DIR_PROC + NS_DIRS {
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: INO_PROC + 4096 + d % 1024, mtime: 0, own: 0 };
  }
  if d == DIR_PROC {
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: 1, mtime: 0, own: 0 };   // as Linux: runc checks it
  }
  return Meta { ok: true, mode: S_IFDIR, size: 0, ino: INO_PROC + d % 1024, mtime: 0, own: 0 };
}

/// Entry i of /proc directory `dir` (getdents64), its name in the
/// transfer buffer.
fn proc_entry(k: &mut Kernel, pid: u64, dir: u64, i: u64) -> Ent
  requires kok(k) && pid < NPROC && dir >= DIR_PROC
  ensures kok(k) && result.len <= XFER
{
  let end = Ent { len: 0, dir: false, end: true };
  if dir >= DIR_PROC + SYSD && dir < DIR_PROC + SYSD + SYSD_N {
    let j = dir - DIR_PROC - SYSD;
    if i >= sysd_count(j) {
      return end;
    }
    return Ent { len: name_out(&mut k.fs.xfer, sysd_child(j, i)), dir: sysd_child_dir(j, i), end: false };
  }
  if dir == DIR_PROC + NET_DIR {
    if i == 0 {
      return Ent { len: name_out(&mut k.fs.xfer, "dev"), dir: false, end: false };
    }
    if i == 1 {
      return Ent { len: name_out(&mut k.fs.xfer, "tcp"), dir: false, end: false };
    }
    if i == 2 {
      return Ent { len: name_out(&mut k.fs.xfer, "tcp6"), dir: false, end: false };
    }
    if i == 3 {
      return Ent { len: name_out(&mut k.fs.xfer, "udp"), dir: false, end: false };
    }
    if i == 4 {
      return Ent { len: name_out(&mut k.fs.xfer, "udp6"), dir: false, end: false };
    }
    if i == 5 {
      return Ent { len: name_out(&mut k.fs.xfer, "unix"), dir: false, end: false };
    }
    if i == 6 {
      return Ent { len: name_out(&mut k.fs.xfer, "raw"), dir: false, end: false };
    }
    if i == 7 {
      return Ent { len: name_out(&mut k.fs.xfer, "route"), dir: false, end: false };
    }
    if i == 8 {
      return Ent { len: name_out(&mut k.fs.xfer, "arp"), dir: false, end: false };
    }
    return end;
  }
  if dir >= DIR_PROC + FDI_DIRS && dir < DIR_PROC + FDI_DIRS + NPROC {
    // /proc/PID/fdinfo: the same entries as /proc/PID/fd
    if i >= LXNFD {
      return end;
    }
    let d = fd_look(k, dir - DIR_PROC - FDI_DIRS, i);
    if d.kind == K_BAD {
      return Ent { len: 0, dir: false, end: false };
    }
    return Ent { len: dec_big(&mut k.fs.xfer, 0, i), dir: false, end: false };
  }
  if dir >= DIR_PROC + TASK_DIRS {
    // /proc/PID/task: one entry per thread of the group, a hole for the others
    let q = dir - DIR_PROC - TASK_DIRS;
    if q >= NPROC || i >= NPROC {
      return end;
    }
    let row = i + 1;
    if row >= NPROC {
      return end;
    }
    if state(k.procs, row) == FREE || (row != q && tgid(k.procs, row) != q) {
      return Ent { len: 0, dir: false, end: false };
    }
    let v = vpid_of(k, pid, row);
    if v == 0 {
      return Ent { len: 0, dir: false, end: false };
    }
    return Ent { len: dec_big(&mut k.fs.xfer, 0, smaller(v, 9999999)), dir: true, end: false };
  }
  if dir >= DIR_PROC + FD_DIRS {
    // /proc/PID/fd: one entry per open descriptor, a hole for each closed one
    if i >= LXNFD {
      return end;
    }
    let q = dir - DIR_PROC - FD_DIRS;
    if q >= NPROC {
      return end;
    }
    let d = fd_look(k, q, i);
    if d.kind == K_BAD {
      return Ent { len: 0, dir: false, end: false };
    }
    return Ent { len: dec_big(&mut k.fs.xfer, 0, i), dir: false, end: false };
  }
  if dir >= DIR_PROC + NS_DIRS {
    return nsf_entry(&mut k, i);            // /proc/PID/ns (src/lxnsk.bastio)
  }
  if dir > DIR_PROC {
    if i == 0 {
      return Ent { len: name_out(&mut k.fs.xfer, "stat"), dir: false, end: false };
    }
    if i == 1 {
      return Ent { len: name_out(&mut k.fs.xfer, "status"), dir: false, end: false };
    }
    if i == 2 {
      return Ent { len: name_out(&mut k.fs.xfer, "cmdline"), dir: false, end: false };
    }
    if i == 3 {
      return Ent { len: name_out(&mut k.fs.xfer, "exe"), dir: false, end: false };
    }
    if i == 4 {
      return Ent { len: name_out(&mut k.fs.xfer, "mounts"), dir: false, end: false };
    }
    if i == 5 {
      return Ent { len: name_out(&mut k.fs.xfer, "maps"), dir: false, end: false };
    }
    if i == 6 {
      return Ent { len: name_out(&mut k.fs.xfer, "ns"), dir: true, end: false };
    }
    if i >= 7 && i < 7 + UMF_N {
      return Ent { len: name_out(&mut k.fs.xfer, um_name(i - 7)), dir: false, end: false };
    }
    if i == 7 + UMF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "fd"), dir: true, end: false };
    }
    if i == 8 + UMF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "cgroup"), dir: false, end: false };
    }
    if i == 9 + UMF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "task"), dir: true, end: false };
    }
    if i == 10 + UMF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "limits"), dir: false, end: false };
    }
    if i == 11 + UMF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "mountinfo"), dir: false, end: false };
    }
    if i == 12 + UMF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "statm"), dir: false, end: false };
    }
    if i == 13 + UMF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "io"), dir: false, end: false };
    }
    if i >= 14 + UMF_N && i < 14 + UMF_N + PXF_N {
      return Ent { len: name_out(&mut k.fs.xfer, px_name(i - 14 - UMF_N)), dir: false, end: false };
    }
    if i == 14 + UMF_N + PXF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "fdinfo"), dir: true, end: false };
    }
    if i == 15 + UMF_N + PXF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "auxv"), dir: false, end: false };
    }
    if i == 16 + UMF_N + PXF_N {
      return Ent { len: name_out(&mut k.fs.xfer, "mem"), dir: false, end: false };
    }
    return end;
  }
  if i == 0 {
    return Ent { len: name_out(&mut k.fs.xfer, "self"), dir: true, end: false };
  }
  if i == 1 {
    return Ent { len: name_out(&mut k.fs.xfer, "mounts"), dir: false, end: false };
  }
  if i == 2 {
    return Ent { len: name_out(&mut k.fs.xfer, "meminfo"), dir: false, end: false };
  }
  if i == 3 {
    return Ent { len: name_out(&mut k.fs.xfer, "uptime"), dir: false, end: false };
  }
  if i == 4 {
    return Ent { len: name_out(&mut k.fs.xfer, "cpuinfo"), dir: false, end: false };
  }
  if i == 5 {
    return Ent { len: name_out(&mut k.fs.xfer, "filesystems"), dir: false, end: false };
  }
  if i == 6 {
    return Ent { len: name_out(&mut k.fs.xfer, "cmdline"), dir: false, end: false };
  }
  if i == 7 {
    return Ent { len: name_out(&mut k.fs.xfer, "stat"), dir: false, end: false };
  }
  if i == 8 {
    return Ent { len: name_out(&mut k.fs.xfer, "loadavg"), dir: false, end: false };
  }
  if i == 9 {
    return Ent { len: name_out(&mut k.fs.xfer, "version"), dir: false, end: false };
  }
  if i == 10 {
    return Ent { len: name_out(&mut k.fs.xfer, "modules"), dir: false, end: false };
  }
  if i == 11 {
    return Ent { len: name_out(&mut k.fs.xfer, "net"), dir: true, end: false };
  }
  if i == 12 {
    return Ent { len: name_out(&mut k.fs.xfer, "diskstats"), dir: false, end: false };
  }
  if i == 13 {
    return Ent { len: name_out(&mut k.fs.xfer, "sys"), dir: true, end: false };
  }
  let p = i - 13;
  if p >= NPROC {
    return end;
  }
  if state(k.procs, p) == FREE {
    return Ent { len: 0, dir: false, end: false };
  }
  let v = vpid_of(k, pid, p);
  if v == 0 {
    return Ent { len: 0, dir: false, end: false };   // in another PID namespace
  }
  return Ent { len: dec_big(&mut k.fs.xfer, 0, smaller(v, 9999999)), dir: true, end: false };
}

// ---------------------------------------------------------------- text

/// Appends s to o at `at`; what does not fit is dropped. Returns the end.
fn put_s(o: &mut Bytes, at: u64, s: Str) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  return bytes_put_str(&mut o, at, s);
}

/// Appends byte c.
fn put_c(o: &mut Bytes, at: u64, c: u8) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  return bytes_put_byte(&mut o, at, c);
}

/// One line of /proc/PID/maps: window pages from .. to with the permissions
/// bits says (see user_page_bits), and the name of class cls (0 none,
/// 1 [heap], 2 [stack], 3 [vdso]). PROT_EXEC is not tracked, so a readable
/// page that cannot be written reads as executable.
fn maps_line(o: &mut Bytes, at: u64, from: u64, to: u64, bits: u64, cls: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT && from <= WPAGES && to <= WPAGES && bits < 16 && cls < 4
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = put_x(&mut o, at, USER_BASE + from * 4096);
  a = put_c(&mut o, a, 45);
  a = put_x(&mut o, a, USER_BASE + to * 4096);
  a = put_c(&mut o, a, 32);
  let r = bits / 2 % 2;
  let w = bits / 4 % 2;
  if r == 1 {
    a = put_c(&mut o, a, 114);
  } else {
    a = put_c(&mut o, a, 45);
  }
  if w == 1 {
    a = put_c(&mut o, a, 119);
  } else {
    a = put_c(&mut o, a, 45);
  }
  if r == 1 && w == 0 {
    a = put_c(&mut o, a, 120);
  } else {
    a = put_c(&mut o, a, 45);
  }
  if bits / 8 == 1 {
    a = put_c(&mut o, a, 115);
  } else {
    a = put_c(&mut o, a, 112);
  }
  a = put_s(&mut o, a, " 00000000 00:00 0");
  if cls != 0 {
    // The name starts in column 74, as on Linux.
    let mut c = 0;
    if a >= at {
      c = smaller(a - at, 73);
    }
    while c < 73 && a < PROC_OUT
      invariant c <= 73 && a <= PROC_OUT && blen(o) == PROC_OUT
    {
      a = put_c(&mut o, a, 32);
      c = c + 1;
    }
    if cls == 1 {
      a = put_s(&mut o, a, "[heap]");
    } else if cls == 2 {
      a = put_s(&mut o, a, "[stack]");
    } else {
      a = put_s(&mut o, a, "[vdso]");
    }
  }
  return put_c(&mut o, a, 10);
}

/// /proc/PID/maps of process p, from its page tables and its records of
/// anonymous memory not touched yet (those read as private read-write): runs
/// of pages with the same permissions, the heap apart, then the vDSO and the
/// stack, whose place is fixed. The names of mapped files are not given
/// (only shared maps are recorded), nor PROT_EXEC, and a read-only shared
/// map shows as private (the program's own pages share frames too); a PROT_NONE anonymous
/// map that maps no pages is not listed. The walk is capped, so a window with
/// very many touched pages lists only its lower part.
fn maps_text(k: &mut Kernel, p: u64, o: &mut Bytes) -> u64
  requires kok(k) && p < NPROC && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let w0 = pget(k.procs, p, F_BRK0);
  let w1 = pget(k.procs, p, F_BRK);
  let b0 = smaller(w0 / 4096, WPAGES);
  let b1 = larger(b0, smaller(w1 / 4096 + smaller(w1 % 4096, 1), WPAGES));
  let mut a = 0;
  let mut q = 0;
  let mut steps = 0;
  let mut open = false;
  let mut rs = 0;
  let mut re = 0;
  let mut rb = 0;
  let mut rc = 0;
  while q < VDSO_PAGE && steps < 262144 && a + 160 <= PROC_OUT
    invariant q <= VDSO_PAGE && a <= PROC_OUT && steps <= 262144 && rs <= WPAGES && re <= WPAGES
      && rb < 16 && rc < 4 && b0 <= b1 && b1 <= WPAGES && blen(o) == PROC_OUT && kok(k) && p < NPROC
  {
    steps = steps + 1;
    let mut bits = user_page_bits(&mut k.spaces, p, q);
    let mut nq = q + 1;
    if anon_covers(k.anon, p, q) {
      bits = 7;
      nq = anon_end(k.anon, p, q);
    } else if bits == 0 {
      nq = smaller(user_next_mapped(&mut k.spaces, p, q + 1), anon_after(k.anon, p, q));
    } else if bits >= 8 && user_cow_page(&mut k.spaces, k.mem.bm, p, USER_BASE + q * 4096) {
      bits = 7;                               // a private page shared with a relative until a write
    }
    if bits >= 8 && bits / 4 % 2 == 0 {
      bits = bits - 8;                        // read-only shared frames (program text) are private maps
    }
    nq = smaller(larger(nq, q + 1), VDSO_PAGE);
    let mut cls = 0;
    if q < b0 {
      nq = smaller(nq, b0);
    } else if q < b1 {
      cls = 1;
      nq = smaller(nq, b1);
    }
    if bits == 0 {
      if open {
        a = maps_line(&mut o, a, rs, re, rb, rc);
        open = false;
      }
    } else if open && rb == bits && rc == cls {
      re = nq;
    } else {
      if open {
        a = maps_line(&mut o, a, rs, re, rb, rc);
      }
      open = true;
      rs = q;
      re = nq;
      rb = bits;
      rc = cls;
    }
    q = nq;
  }
  if open {
    a = maps_line(&mut o, a, rs, re, rb, rc);
  }
  a = maps_line(&mut o, a, VDSO_PAGE, VDSO_PAGE + 1, 3, 3);
  return maps_line(&mut o, a, STACK_FIRST, WPAGES, 7, 2);
}

/// Appends v in hex, at least 8 digits, as Linux's %08lx.
fn put_x(o: &mut Bytes, at: u64, v: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  let mut sh = 16;
  while sh > 0
    invariant sh <= 16 && blen(o) == PROC_OUT && a <= PROC_OUT
  {
    sh = sh - 1;
    let d = (v >> (4 * sh)) & 15;
    if sh < 8 || v >> (4 * sh) != 0 {       // at least 8 digits, as Linux's %08lx
      if d < 10 {
        a = put_c(&mut o, a, cast[u8](48 + d));
      } else {
        a = put_c(&mut o, a, cast[u8](87 + d));
      }
    }
  }
  return a;
}

/// Appends v in lower-case hexadecimal without padding (Linux's %x).
fn put_h(o: &mut Bytes, at: u64, v: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  let mut sh = 16;
  while sh > 0
    invariant sh <= 16 && blen(o) == PROC_OUT && a <= PROC_OUT
  {
    sh = sh - 1;
    let d = (v >> (4 * sh)) & 15;
    if sh == 0 || v >> (4 * sh) != 0 {
      if d < 10 {
        a = put_c(&mut o, a, cast[u8](48 + d));
      } else {
        a = put_c(&mut o, a, cast[u8](87 + d));
      }
    }
  }
  return a;
}

/// Appends v in octal with a leading 0, as fdinfo's flags.
fn put_oct(o: &mut Bytes, at: u64, v: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = put_c(&mut o, at, 48);
  let mut sh = 21;
  while sh > 0
    invariant sh <= 21 && blen(o) == PROC_OUT && a <= PROC_OUT
  {
    sh = sh - 1;
    if v >> (3 * sh) != 0 {
      a = put_c(&mut o, a, cast[u8](48 + ((v >> (3 * sh)) & 7)));
    }
  }
  return a;
}

/// /proc/P/fdinfo/FD: the position, flags, mount and inode every
/// description has, then what its kind adds (an eventfd's count, an inotify
/// instance's watches). Empty for a descriptor that is not open.
fn fdinfo_out(k: &mut Kernel, p: u64, fd: u64, o: &mut Bytes) -> u64
  requires kok(k) && p < NPROC && fd < LXNFD && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let d = fd_look(k, p, fd);
  if d.kind == K_BAD {
    return 0;
  }
  let mut pos = 0;
  let mut ino = 0;
  if d.kind == K_FILE && d.x < FD_ROWS {
    pos = fget(k.fs.ftab, d.x, FD_OFF);
    let f = vfs_row_file(k.fs, d.x);
    if f < HFILES {
      ino = INO_FILES + f;
    }
  }
  let mut fl = lx_fcntl(&mut k, p, fd, F_GETFL, 0);
  if fl > 0xFFFFFFFF {
    fl = 0;
  }
  if fd_get(k.lxfd, p, fd) / FD_CLOEXEC % 2 == 1 {
    fl = fl | LO_CLOEXEC;
  }
  let mut a = put_s(&mut o, 0, "pos:\t");
  a = put_n(&mut o, a, pos);
  a = put_s(&mut o, a, "\nflags:\t");
  a = put_oct(&mut o, a, fl);
  a = put_s(&mut o, a, "\nmnt_id:\t1\nino:\t");
  a = put_n(&mut o, a, ino);
  a = put_c(&mut o, a, 10);
  if d.kind == K_EVENT && d.x < OFD_N {
    a = put_s(&mut o, a, "eventfd-count: ");
    let c = of_get(k.ofd, d.x, 2);
    a = put_hx(&mut o, a, c >> 32, 8);
    a = put_hx(&mut o, a, c & 0xFFFFFFFF, 8);
    a = put_c(&mut o, a, 10);
  }
  if d.kind == K_PIDFD {
    let mut v = 0;
    if d.x < NPROC && state(k.procs, d.x) != FREE {
      v = vpid_of(k, p, d.x);
    }
    a = put_s(&mut o, a, "Pid:\t");
    if v == 0 {
      a = put_s(&mut o, a, "-1");
    } else {
      a = put_n(&mut o, a, v);
    }
    a = put_s(&mut o, a, "\nNSpid:\t");
    if v == 0 {
      a = put_s(&mut o, a, "-1");
    } else {
      a = put_n(&mut o, a, v);
    }
    a = put_c(&mut o, a, 10);
  }
  if d.kind == K_INOTIFY && d.x < INO_N && get(k.evt, INO_AT + d.x * INO_STRIDE) != 2 {
    let mut w = 0;
    while w < INO_W
      invariant w <= INO_W && a <= PROC_OUT && blen(o) == PROC_OUT && d.x < INO_N && kok(k)
    {
      let at = INO_AT + d.x * INO_STRIDE + INO_HEAD + w * INO_WAT;
      let hv = get(k.evt, at);
      if hv != 0 && hv < 0x100000000 && a + 120 <= PROC_OUT {
        a = put_s(&mut o, a, "inotify wd:");
        a = put_n(&mut o, a, get(k.evt, at + 2));
        a = put_s(&mut o, a, " ino:");
        a = put_x(&mut o, a, hv);                  // the handle: what stat calls the inode is this plus INO_FILES
        a = put_s(&mut o, a, " sdev:00000001 mask:");
        a = put_x(&mut o, a, get(k.evt, at + 1));
        a = put_s(&mut o, a, " ignored_mask:0\n");
      }
      w = w + 1;
    }
  }
  if d.kind == K_INOTIFY && d.x < INO_N && get(k.evt, INO_AT + d.x * INO_STRIDE) == 2 {
    let mut m = 0;
    while m < FAN_M
      invariant m <= FAN_M && a <= PROC_OUT && blen(o) == PROC_OUT && d.x < INO_N && kok(k)
    {
      let at = INO_AT + d.x * INO_STRIDE + 6 + m * FAN_MK;     // the mark (fm_at in src/lxinotify.bastio)
      let hv = get(k.evt, at);
      if hv != 0 && get(k.evt, at + 1) == 0 && hv < 0x100000000 && a + 120 <= PROC_OUT {
        a = put_s(&mut o, a, "fanotify ino:");
        a = put_x(&mut o, a, hv);
        a = put_s(&mut o, a, " sdev:00000001 mflags:");
        if get(k.evt, at + 4) % 2 == 1 {
          a = put_s(&mut o, a, "40");
        } else {
          a = put_s(&mut o, a, "0");
        }
        a = put_s(&mut o, a, " mask:");
        a = put_h(&mut o, a, get(k.evt, at + 2));
        a = put_s(&mut o, a, " ignored_mask:");
        a = put_h(&mut o, a, get(k.evt, at + 3));
        a = put_c(&mut o, a, 10);
      }
      m = m + 1;
    }
  }
  return a;
}

/// Appends v in decimal.
/// v as exactly `digits` upper-case hex digits (the low ones if it is wider).
fn put_hx(o: &mut Bytes, at: u64, v: u64, digits: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT && digits <= 8
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  let mut sh = digits;
  while sh > 0
    invariant sh <= 8 && blen(o) == PROC_OUT && a <= PROC_OUT
  {
    sh = sh - 1;
    let d = (v >> (4 * sh)) & 15;
    if d < 10 {
      a = put_c(&mut o, a, cast[u8](48 + d));
    } else {
      a = put_c(&mut o, a, cast[u8](55 + d));
    }
  }
  return a;
}

/// An address as /proc/net/tcp prints it: the four bytes as one
/// little-endian number, so 10.0.2.15 is 0F02000A.
fn put_ip_hex(o: &mut Bytes, at: u64, ip: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let sw = ((ip & 255) << 24) | (((ip >> 8) & 255) << 16) | (((ip >> 16) & 255) << 8) | ((ip >> 24) & 255);
  return put_hx(&mut o, at, sw, 8);
}

/// Interface slot i's name at o[at..]. Returns the new end.
fn put_ifname(k: &Kernel, o: &mut Bytes, at: u64, i: u64) -> u64
  requires kok(k) && blen(o) == PROC_OUT && at <= PROC_OUT && i < IFN
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let w0 = nic_if_name(k.nic, i, 0);
  let w1 = nic_if_name(k.nic, i, 1);
  let mut a = at;
  let mut j = 0;
  while j < 16 && name_byte(w0, w1, j) != 0 && a < PROC_OUT
    invariant j <= 16 && a <= PROC_OUT && blen(o) == PROC_OUT
  {
    a = put_c(&mut o, a, cast[u8](name_byte(w0, w1, j)));
    j = j + 1;
  }
  return a;
}

/// v (below 256) as two lower-case hex digits.
fn put_hb(o: &mut Bytes, at: u64, v: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let hi = (v >> 4) & 15;
  let lo = v & 15;
  let mut a = at;
  if hi < 10 {
    a = put_c(&mut o, a, cast[u8](48 + hi));
  } else {
    a = put_c(&mut o, a, cast[u8](87 + hi));
  }
  if lo < 10 {
    a = put_c(&mut o, a, cast[u8](48 + lo));
  } else {
    a = put_c(&mut o, a, cast[u8](87 + lo));
  }
  return a;
}

/// Appends spaces until the line has w columns since `start`.
fn pad_col(o: &mut Bytes, at: u64, start: u64, w: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT && start <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  while a < PROC_OUT && a >= start && a - start < w
    invariant a <= PROC_OUT && blen(o) == PROC_OUT
  {
    a = put_c(&mut o, a, 32);
  }
  return a;
}

/// A limit as /proc/PID/limits shows it, padded to a 21-column field.
fn put_rlim(o: &mut Bytes, at: u64, v: u64, start: u64, w: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT && start <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  if v == RLIM_INFINITY {
    a = put_s(&mut o, a, "unlimited");
  } else {
    a = put_n(&mut o, a, v);
  }
  return pad_col(&mut o, a, start, w);
}

/// One row of /proc/PID/limits: resource r of process p.
fn limit_row(k: &Kernel, p: u64, r: u64, name: Str, units: Str, o: &mut Bytes, at: u64) -> u64
  requires kok(k) && p < NPROC && r < RLIM_NLIMITS && blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = put_s(&mut o, at, name);
  a = pad_col(&mut o, a, at, 26);
  a = put_rlim(&mut o, a, rl_cur(k, p, r), a, 21);
  a = put_rlim(&mut o, a, rl_max(k, p, r), a, 21);
  a = put_s(&mut o, a, units);
  return put_c(&mut o, a, 10);
}

/// /proc/PID/limits: the table of process p's resource limits.
fn limits_text(k: &Kernel, p: u64, o: &mut Bytes) -> u64
  requires kok(k) && p < NPROC && blen(o) == PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = put_s(&mut o, 0, "Limit                     Soft Limit           Hard Limit           Units     \n");
  a = limit_row(k, p, 0, "Max cpu time", "seconds   ", &mut o, a);
  a = limit_row(k, p, 1, "Max file size", "bytes     ", &mut o, a);
  a = limit_row(k, p, 2, "Max data size", "bytes     ", &mut o, a);
  a = limit_row(k, p, 3, "Max stack size", "bytes     ", &mut o, a);
  a = limit_row(k, p, 4, "Max core file size", "bytes     ", &mut o, a);
  a = limit_row(k, p, 5, "Max resident set", "bytes     ", &mut o, a);
  a = limit_row(k, p, 6, "Max processes", "processes ", &mut o, a);
  a = limit_row(k, p, 7, "Max open files", "files     ", &mut o, a);
  a = limit_row(k, p, 8, "Max locked memory", "bytes     ", &mut o, a);
  a = limit_row(k, p, 9, "Max address space", "bytes     ", &mut o, a);
  a = limit_row(k, p, 10, "Max file locks", "locks     ", &mut o, a);
  a = limit_row(k, p, 11, "Max pending signals", "signals   ", &mut o, a);
  a = limit_row(k, p, 12, "Max msgqueue size", "bytes     ", &mut o, a);
  a = limit_row(k, p, 13, "Max nice priority", "          ", &mut o, a);
  a = limit_row(k, p, 14, "Max realtime priority", "          ", &mut o, a);
  return limit_row(k, p, 15, "Max realtime timeout", "us        ", &mut o, a);
}

fn put_n(o: &mut Bytes, at: u64, v: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  return bytes_put_u64(&mut o, at, v);
}

/// A status line's four ids (real, effective, saved, file system) from
/// row words w and s, each after a tab, as process obs sees them (g 0
/// users, 1 groups).
fn put_ids(o: &mut Bytes, at: u64, k: &Kernel, obs: u64, p: u64, g: u64, w: u64, s: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT && kok(k) && obs < NPROC && p < NPROC && g < 2 && w < STRIDE && s < STRIDE
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = put_c(&mut o, at, 9);
  a = put_n(&mut o, a, id_out(k, obs, g, id_get(k.procs, p, w, false)));
  a = put_c(&mut o, a, 9);
  a = put_n(&mut o, a, id_out(k, obs, g, id_get(k.procs, p, w, true)));
  a = put_c(&mut o, a, 9);
  a = put_n(&mut o, a, id_out(k, obs, g, id_get(k.procs, p, s, false)));
  a = put_c(&mut o, a, 9);
  return put_n(&mut o, a, id_out(k, obs, g, id_get(k.procs, p, s, true)));
}

/// Appends v as two digits (v below 100).
fn put_2(o: &mut Bytes, at: u64, v: u64) -> u64
  requires blen(o) == PROC_OUT && at <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let a = put_c(&mut o, at, cast[u8](48 + v / 10 % 10));
  return put_c(&mut o, a, cast[u8](48 + v % 10));
}

/// Appends process p's name (see pr_comm).
fn put_comm(k: &mut Kernel, p: u64, o: &mut Bytes, at: u64) -> u64
  requires kok(k) && p < NPROC && blen(o) == PROC_OUT && at <= PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let n = pr_comm(&mut k, p);
  let mut a = at;
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 15 && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
  {
    a = put_c(&mut o, a, bget(k.fs.xfer, i));
    i = i + 1;
  }
  return a;
}

/// Appends the path of process p's program ("/bin/NAME", or the file it
/// was loaded from), or only its last part when `base`.
fn put_prog(k: &mut Kernel, p: u64, o: &mut Bytes, at: u64, base: bool) -> u64
  requires kok(k) && p < NPROC && blen(o) == PROC_OUT && at <= PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let prog = pget(k.procs, p, F_PROG);
  if prog < NPROGS || prog == NPROGS || prog - NPROGS - 1 >= HFILES {
    let mut a = at;
    if !base {
      a = put_s(&mut o, a, "/bin/");
    }
    return put_s(&mut o, a, prog_name(prog));
  }
  let n = vfs_dirent(&mut k.fs, prog - NPROGS - 1);
  if n == NO_FILE || n > XFER {
    return put_s(&mut o, at, prog_name(prog));
  }
  let mut from = 0;
  if base {
    let mut i = 0;
    while i < n
      invariant i <= n && from <= n
    {
      if bget(k.fs.xfer, i) == 47 {
        from = i + 1;
      }
      i = i + 1;
    }
  }
  let mut a = at;
  if !base {
    a = put_c(&mut o, a, 47);
  }
  let mut j = from;
  while j < n
    invariant j <= n && n <= XFER && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
  {
    a = put_c(&mut o, a, bget(k.fs.xfer, j));
    j = j + 1;
  }
  return a;
}

/// Whether process p waits in a system call that runs again until what it
/// waits for comes, with no signal pending that it takes: Linux wakes a
/// sleeper when it posts such a signal, so by then the process is running
/// even though it has not got a processor yet.
fn is_waiting(k: &Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
{
  return pget(k.procs, p, F_ASLEEP) != 0 && pget(k.procs, p, F_SIGPEND) & !pget(k.procs, p, F_SIGMASK) == 0;
}

/// The one-letter state of a process in state s, as ps shows it. A
/// process that runs its system call again until what it waits for comes
/// (`waiting`, F_ASLEEP) is waiting, though it is READY or RUNNING: Linux
/// would have it asleep.
fn state_letter(s: u64, waiting: bool) -> u8 {
  if (s == READY || s == RUNNING) && waiting {
    return 83;                              // S
  }
  if s == READY || s == RUNNING || s == KILLED || s == EXITING {
    return 82;                              // R
  }
  if s == ZOMBIE {
    return 90;                              // Z
  }
  if s == STOPPED {
    return 84;                              // T
  }
  return 83;                                // S: waiting for something
}

/// /proc/mounts as process p sees it: one "SOURCE /MOUNTPOINT TYPE OPTIONS 0 0"
/// line for the root, /proc, the disk, the tmpfs and loop mounts, and the
/// mount namespace's own.
fn mounts_text(k: &mut Kernel, p: u64, o: &mut Bytes) -> u64
  requires kok(k) && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = put_s(&mut o, 0, "rootfs / ramfs rw 0 0\nproc /proc proc rw 0 0\n");
  if k.fs.disk.slots > 0 {
    a = put_s(&mut o, a, "disk /disk bstdisk3 rw 0 0\n");
  }
  // tmpfs mounts (src/lxmount.bastio): "tmpfs /NAME tmpfs rw 0 0".
  let mut s = 0;
  while s < MNT_N
    invariant s <= MNT_N && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
  {
    let i = vfs_mount_node(k.fs, s);
    if i < NFILES {
      let l = ram_name(&mut k.fs.ram, i, &mut k.fs.name);
      if l != NO_FILE {
        a = put_s(&mut o, a, "tmpfs /");
        let mut j = 0;
        while j < l
          invariant j <= l && l <= NAMEBUF && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
        {
          a = put_c(&mut o, a, bget(k.fs.name, j));
          j = j + 1;
        }
        if vfs_mount_ro(k.fs, s) {
          a = put_s(&mut o, a, " tmpfs ro 0 0\n");
        } else {
          a = put_s(&mut o, a, " tmpfs rw 0 0\n");
        }
      }
    }
    s = s + 1;
  }
  // The loop mount: "/dev/loopN /NAME bstdisk3 rw 0 0" ("bstdisk3" for
  // an image mounted from its file).
  if k.fs.lo_at != 0 && k.fs.lo_at <= NFILES {
    let l = ram_name(&mut k.fs.ram, k.fs.lo_at - 1, &mut k.fs.name);
    if l != NO_FILE {
      if k.fs.lo_dev == LO_NODEV {
        a = put_s(&mut o, a, "bstdisk3 /");
      } else {
        a = put_s(&mut o, a, "/dev/loop");
        a = put_n(&mut o, a, k.fs.lo_dev);
        a = put_s(&mut o, a, " /");
      }
      let mut j = 0;
      while j < l
        invariant j <= l && l <= NAMEBUF && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
      {
        a = put_c(&mut o, a, bget(k.fs.name, j));
        j = j + 1;
      }
      if k.fs.lo_ro {
        a = put_s(&mut o, a, " bstdisk3 ro 0 0\n");
      } else {
        a = put_s(&mut o, a, " bstdisk3 rw 0 0\n");
      }
    }
  }
  if p < NPROC {
    a = ns_mounts_text(k, p, &mut o, a);   // the mount namespace's own (src/lxns.bastio)
  }
  return a;
}

/// The index of the first space or newline of t at or after i, or n.
fn tok_end(t: &Bytes, i: u64, n: u64) -> u64
  requires blen(t) == PROC_OUT && n <= PROC_OUT && i <= n
  ensures result >= i && result <= n
{
  let mut j = i;
  while j < n
    invariant j >= i && j <= n && n <= PROC_OUT && blen(t) == PROC_OUT
  {
    let c = bget(t, j);
    if c == 32 || c == 10 {
      return j;
    }
    j = j + 1;
  }
  return n;
}

/// Appends t[s..e) to o.
fn put_span(o: &mut Bytes, at: u64, t: &Bytes, s: u64, e: u64, n: u64) -> u64
  requires blen(o) == PROC_OUT && blen(t) == PROC_OUT && at <= PROC_OUT && s <= e && e <= n && n <= PROC_OUT
  ensures blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut a = at;
  let mut j = s;
  while j < e
    invariant j >= s && j <= e && e <= n && n <= PROC_OUT && a <= PROC_OUT && blen(o) == PROC_OUT && blen(t) == PROC_OUT
  {
    a = put_c(&mut o, a, bget(t, j));
    j = j + 1;
  }
  return a;
}

/// /proc/PID/mountinfo, made from the lines of /proc/mounts:
/// "ID PARENT 0:ID / MOUNTPOINT OPTIONS - TYPE SOURCE OPTIONS". Every mount
/// is of the whole of its file system (root "/") and has the first as its
/// parent; the device numbers are made up (major 0, minor the id).
fn mountinfo_text(k: &mut Kernel, p: u64, o: &mut Bytes) -> u64
  requires kok(k) && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  let mut t = balloc(PROC_OUT);
  let n = smaller(mounts_text(&mut k, p, &mut t), PROC_OUT);
  let mut a = 0;
  let mut i = 0;
  let mut id = 1;
  while i < n && id < 100
    invariant i <= n && n <= PROC_OUT && a <= PROC_OUT && blen(o) == PROC_OUT && blen(t) == PROC_OUT && id >= 1 && kok(k)
  {
    let se = tok_end(t, i, n);
    let ms = smaller(se + 1, n);
    let me = tok_end(t, ms, n);
    let fs = smaller(me + 1, n);
    let fe = tok_end(t, fs, n);
    let os = smaller(fe + 1, n);
    let oe = tok_end(t, os, n);
    a = put_n(&mut o, a, id);
    a = put_s(&mut o, a, " ");
    if id == 1 {
      a = put_n(&mut o, a, 0);
    } else {
      a = put_n(&mut o, a, 1);
    }
    a = put_s(&mut o, a, " 0:");
    a = put_n(&mut o, a, id);
    a = put_s(&mut o, a, " / ");
    a = put_span(&mut o, a, t, ms, me, n);
    a = put_s(&mut o, a, " ");
    a = put_span(&mut o, a, t, os, oe, n);
    a = put_s(&mut o, a, " - ");
    a = put_span(&mut o, a, t, fs, fe, n);
    a = put_s(&mut o, a, " ");
    a = put_span(&mut o, a, t, i, se, n);
    a = put_s(&mut o, a, " ");
    a = put_span(&mut o, a, t, os, oe, n);
    a = put_c(&mut o, a, 10);
    // To the end of the line.
    let mut e = oe;
    while e < n && bget(t, e) != 10
      invariant e >= oe && e <= n && n <= PROC_OUT && blen(t) == PROC_OUT
    {
      e = e + 1;
    }
    i = smaller(e + 1, n);
    if e >= n {
      i = n;
    }
    id = id + 1;
  }
  bfree(t);
  return a;
}

/// Writes /proc file f into o. Returns its length.
fn proc_text(k: &mut Kernel, pid: u64, f: u64, o: &mut Bytes) -> u64
  requires kok(k) && pid < NPROC && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT && result <= PROC_OUT
{
  if f < PROC_DEV {
    return 0;
  }
  if f >= PROC_DEV + PSYS {
    // A /proc/sys file, numbered from 0 (src/lxprocfs.bastio's SY_*).
    let what = f - PROC_DEV - PSYS;
    if is_ns_file(f) {
      return nsf_text(k, f, &mut o);        // a namespace link (src/lxnsk.bastio)
    }
    if is_cg_file(f) {
      return cg_text(&mut k, pid, f, &mut o);    // a cgroup's control file (src/lxcgroup.bastio)
    }
    if is_um_file(f) {
      return um_text(k, pid, f, &mut o);         // uid_map, gid_map, setgroups (src/lxuser.bastio)
    }
    if what >= SY_LOOP && what - SY_LOOP < LOOP_N * LOOP_SYS {
      return loop_sys_text(&mut k, what - SY_LOOP, &mut o);
    }
    if what == SY_NETARP {
      // The card's ARP cache; only the namespace the machine boots in
      // has one. The device is the card.
      let ns = net_ns(k, pid);
      let mut a = put_s(&mut o, 0, "IP address       HW type     Flags       HW address            Mask     Device\n");
      let mut e = 0;
      while e < ARP_N && ns == 0 && a + 160 < PROC_OUT
        invariant e <= ARP_N && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
      {
        let ip = nic_arp(k.nic, e, 0) % 4294967296;
        let mac = nic_arp(k.nic, e, 1) % 281474976710656;
        if ip != 0 {
          a = put_n(&mut o, a, ip / 16777216 % 256);
          a = put_c(&mut o, a, 46);
          a = put_n(&mut o, a, ip / 65536 % 256);
          a = put_c(&mut o, a, 46);
          a = put_n(&mut o, a, ip / 256 % 256);
          a = put_c(&mut o, a, 46);
          a = put_n(&mut o, a, ip % 256);
          a = put_s(&mut o, a, "     0x1         0x2         ");
          a = put_hb(&mut o, a, mac / 1099511627776 % 256);
          a = put_c(&mut o, a, 58);
          a = put_hb(&mut o, a, mac / 4294967296 % 256);
          a = put_c(&mut o, a, 58);
          a = put_hb(&mut o, a, mac / 16777216 % 256);
          a = put_c(&mut o, a, 58);
          a = put_hb(&mut o, a, mac / 65536 % 256);
          a = put_c(&mut o, a, 58);
          a = put_hb(&mut o, a, mac / 256 % 256);
          a = put_c(&mut o, a, 58);
          a = put_hb(&mut o, a, mac % 256);
          a = put_s(&mut o, a, "     *        eth0\n");
        }
        e = e + 1;
      }
      return a;
    }
    if what == SY_NETROUTE {
      // The routes of the reader's network namespace: the default one and
      // the subnet of each interface that is up. The reference count, use,
      // metric, MTU, window and RTT read 0.
      let ns = net_ns(k, pid);
      let mut a = put_s(&mut o, 0, "Iface\tDestination\tGateway \tFlags\tRefCnt\tUse\tMetric\tMask\t\tMTU\tWindow\tIRTT\n");
      let mut r = 0;
      while r < IFN && a + 160 < PROC_OUT
        invariant r <= IFN && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
      {
        if nic_route(k.nic, ns, r, 0) == 1 {
          let sl = nic_route(k.nic, ns, r, 1);
          if sl < IFN {
            a = put_ifname(k, &mut o, a, sl);
            a = put_c(&mut o, a, 9);
            a = put_ip_hex(&mut o, a, nic_route(k.nic, ns, r, 2) % 4294967296);
            a = put_c(&mut o, a, 9);
            a = put_ip_hex(&mut o, a, nic_route(k.nic, ns, r, 3) % 4294967296);
            if r == 0 {
              a = put_s(&mut o, a, "\t0003\t0\t0\t0\t");
            } else {
              a = put_s(&mut o, a, "\t0001\t0\t0\t0\t");
            }
            a = put_ip_hex(&mut o, a, nic_route(k.nic, ns, r, 4) % 4294967296);
            a = put_s(&mut o, a, "\t0\t0\t0\n");
          }
        }
        r = r + 1;
      }
      return a;
    }
    if what == SY_NETRAW {
      // One line per raw ICMP socket of the reader's network namespace;
      // the "port" is the protocol number, 1. The owner and inode are not
      // kept.
      let ns = net_ns(k, pid);
      let mut a = put_s(&mut o, 0, "  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode ref pointer drops\n");
      let mut t = 0;
      let mut row = 0;
      while t < SOCKS && a + 160 < PROC_OUT
        invariant t <= SOCKS && row <= t && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
      {
        if raw_row(k.nic, t, ns, 0) == 1 {
          a = put_s(&mut o, a, "  ");
          a = put_n(&mut o, a, row);
          a = put_s(&mut o, a, ": 00000000:0001 00000000:0000 07 00000000:");
          a = put_hx(&mut o, a, raw_row(k.nic, t, ns, 1), 8);
          a = put_s(&mut o, a, " 00:00000000 00000000     0        0 0 2 0000000000000000 0\n");
          row = row + 1;
        }
        t = t + 1;
      }
      return a;
    }
    if what == SY_NETUNIX {
      // One line per bound or listening unix socket (the sockets of a
      // connected pair have no name and are not listed): its type, the
      // listening flag and its path, an abstract name with a leading @.
      // The address, reference count and inode are not kept.
      let mut a = put_s(&mut o, 0, "Num       RefCount Protocol Flags    Type St Inode Path\n");
      let mut l = 0;
      while l < UX_LIS && a + 160 < PROC_OUT
        invariant l <= UX_LIS && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
      {
        let st = ul_row(k, l, 0, 0);
        if st != UL_FREE {
          a = put_s(&mut o, a, "0000000000000000: 00000002 00000000 ");
          if st == UL_LISTEN {
            a = put_s(&mut o, a, "00010000 ");
          } else {
            a = put_s(&mut o, a, "00000000 ");
          }
          if st == UL_DGRAM {
            a = put_s(&mut o, a, "0002 01 0");
          } else {
            a = put_s(&mut o, a, "0001 01 0");
          }
          let n = smaller(ul_row(k, l, 1, 0), UX_PATH);
          if n > 0 {
            a = put_c(&mut o, a, 32);
            if ul_row(k, l, 2, 0) != 0 {
              a = put_c(&mut o, a, 47);     // a path is kept without its leading "/"
            }
            let mut i = 0;
            while i < n && a + 2 < PROC_OUT
              invariant i <= n && n <= UX_PATH && a <= PROC_OUT && blen(o) == PROC_OUT && l < UX_LIS && kok(k)
            {
              let mut b = ul_row(k, l, 2, i);
              if b == 0 {
                b = 64;                     // the abstract namespace's NUL, as @
              }
              a = put_c(&mut o, a, cast[u8](b % 256));
              i = i + 1;
            }
          }
          a = put_c(&mut o, a, 10);
        }
        l = l + 1;
      }
      return a;
    }
    if what == SY_NETUDP6 {
      // IPv6 datagram sockets run over the IPv4 stack, so /proc/net/udp
      // lists them; this table has only its header.
      return put_s(&mut o, 0, "  sl  local_address                         remote_address                        st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode ref pointer drops\n");
    }
    if what == SY_NETUDP {
      // One line per UDP socket of the reader's network namespace: the
      // local port and the datagrams waiting. Sockets are not connected
      // in this table, so the remote address reads 0, and the owner and
      // inode are not kept.
      let ns = net_ns(k, pid);
      let mut a = put_s(&mut o, 0, "   sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode ref pointer drops\n");
      let mut t = 0;
      let mut row = 0;
      while t < SOCKS && a + 160 < PROC_OUT
        invariant t <= SOCKS && row <= t && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
      {
        if sock_row(k.nic, t, ns, 0) == 1 {
          a = put_s(&mut o, a, "  ");
          a = put_n(&mut o, a, row);
          a = put_s(&mut o, a, ": 00000000:");
          a = put_hx(&mut o, a, sock_row(k.nic, t, ns, 1), 4);
          a = put_s(&mut o, a, " 00000000:0000 07 00000000:");
          a = put_hx(&mut o, a, sock_row(k.nic, t, ns, 2), 8);
          a = put_s(&mut o, a, " 00:00000000 00000000     0        0 0 2 0000000000000000 0\n");
          row = row + 1;
        }
        t = t + 1;
      }
      return a;
    }
    if what >= SY_FI && what < SY_FI + NPROC * LXNFD {
      return fdinfo_out(&mut k, (what - SY_FI) / LXNFD, (what - SY_FI) % LXNFD, &mut o);
    }
    if what >= SY_PX && what < SY_PX + NPROC * PXF_N {
      let w = (what - SY_PX) % PXF_N;
      if w == 1 {
        let s = get(k.sys, SYS_OOM + (what - SY_PX) / PXF_N);
        if s == 0 || s == 1002 {
          return put_s(&mut o, 0, "0\n");
        }
        if s > 1002 {
          let a = put_n(&mut o, 0, s - 1002);
          return put_c(&mut o, a, 10);
        }
        let a = put_c(&mut o, 0, 45);
        let b = put_n(&mut o, a, 1002 - s);
        return put_c(&mut o, b, 10);
      }
      if w == 10 {
        return tm_text(k, smaller((what - SY_PX) / PXF_N, NPROC - 1), &mut o);   // src/lxnsk.bastio
      }
      return put_s(&mut o, 0, px_text(w));
    }
    if what >= SY_SC && what < SY_SC + SCT_NUM {
      let mut v = sct_default(what - SY_SC);
      let w = get(k.sys, SYS_SCT + (what - SY_SC));
      if w != 0 {
        v = w - 1;
      }
      let a = put_n(&mut o, 0, v);
      return put_c(&mut o, a, 10);
    }
    if what >= SY_SC + SCT_NUM && what < SY_SC + SCT_N {
      return put_s(&mut o, 0, sct_text(what - SY_SC));
    }
    if what == SY_TAINTED {
      return put_s(&mut o, 0, "0\n");
    }
    if what == SY_PID_MAX {
      let mut pm = NPROC;                 // every pid is below it
      let w = get(k.sys, SYS_PIDMX);
      if w != 0 {
        pm = w - 1;                       // as written: kept and handed back, pids are still handed out below NPROC
      }
      let a = put_n(&mut o, 0, pm);
      return put_c(&mut o, a, 10);
    }
    if what == SY_PRINTK {
      return put_s(&mut o, 0, "7\t4\t1\t7\n");
    }
    if what >= SY_IPC && what < SY_IPC_END {
      return ipc_proc_text(&mut k, pid, what - SY_IPC, &mut o);
    }
    if what >= SY_UTS && what < SY_UTS_END {
      return uts_proc_text(k, pid, what - SY_UTS, &mut o);
    }
    if what == SY_CORE {
      return put_s(&mut o, 0, "core\n");
    }
    if what == SY_NROPEN {
      let a = put_n(&mut o, 0, nr_open(k));
      return put_c(&mut o, a, 10);
    }
    if what == SY_DROP {
      return put_s(&mut o, 0, "0\n");
    }
    if what >= SY_NEXTID && what < SY_NEXTID + 3 {
      let want = get(k.sys, SYS_NEXTID + (what - SY_NEXTID));
      if want == 0 {
        return put_s(&mut o, 0, "-1\n");
      }
      let a = put_n(&mut o, 0, want - 1);
      return put_c(&mut o, a, 10);
    }
    if what == SY_PIPE_MAX {
      let a = put_n(&mut o, 0, pipe_max(k));
      return put_c(&mut o, a, 10);
    }
    if what >= SY_INO && what < SY_INO + 3 {
      // inotify's fixed limits: events queued before IN_Q_OVERFLOW,
      // instances (in all, not per user), watches per instance.
      let mut v = INO_Q - 1;
      if what == SY_INO + 1 {
        v = INO_N;
      } else if what == SY_INO + 2 {
        v = INO_W;
      }
      let w = get(k.sys, SYS_INOL + (what - SY_INO));
      if w != 0 {
        v = w - 1;          // as written: kept and handed back, the limits themselves do not move
      }
      let a = put_n(&mut o, 0, v);
      return put_c(&mut o, a, 10);
    }
    return 0;
  }
  let what = f % 16;
  let p = (f - PROC_DEV) / 16;
  if what == PF_MOUNTS {
    return mounts_text(&mut k, p, &mut o);
  }
  if what == PF_MOUNTINFO && p != 0 {
    return mountinfo_text(&mut k, p, &mut o);
  }
  if what == PF_MEMINFO && p == 0 {
    let total = pool_size(k.mem.pool) * 4;   // the RAM the pool holds
    let avail = count_free(k.mem.bm) * 4;
    let mut a = put_s(&mut o, 0, "MemTotal: ");
    a = put_n(&mut o, a, total);
    a = put_s(&mut o, a, " kB\nMemFree: ");
    a = put_n(&mut o, a, avail);
    a = put_s(&mut o, a, " kB\nMemAvailable: ");
    a = put_n(&mut o, a, avail);
    a = put_s(&mut o, a, " kB\nBuffers: 0 kB\nCached: ");
    a = put_n(&mut o, a, smaller(pc_count(k.fs.pc), PC_N) * 4);
    return put_s(&mut o, a, " kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n");
  }
  if what == PF_CPUINFO && p == 0 {
    let mut a = 0;
    let mut c = 0;
    while c < k.cpus
      invariant a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
    {
      a = put_s(&mut o, a, "processor\t: ");
      a = put_n(&mut o, a, c);
      a = put_s(&mut o, a, "\nmodel name\t: x86-64\nflags\t\t: fpu tsc msr pae apic sse sse2 syscall lm\n\n");
      c = c + 1;
    }
    return a;
  }
  if what == PF_FILESYSTEMS && p == 0 {
    let mut a = 0;
    let mut t = 0;
    while t < FS_TYPES
      invariant a <= PROC_OUT && blen(o) == PROC_OUT
    {
      if t + 1 < FS_TYPES {
        a = put_s(&mut o, a, "nodev");      // all but the disk's need no device
      }
      a = put_c(&mut o, a, 9);
      a = put_s(&mut o, a, fs_type_name(t));
      a = put_c(&mut o, a, 10);
      t = t + 1;
    }
    return a;
  }
  if what == PF_CMDLINE && p == 0 {
    return put_s(&mut o, 0, "BOOT_IMAGE=/boot/bastios.elf\n");
  }
  if what == PF_VERSION && p == 0 {
    return put_s(&mut o, 0, "Linux version 6.1.0-bastios (root@bastios) #1 SMP\n");   // the release uname gives
  }
  if what == PF_STAT && p == 0 {
    // CPU times in clock ticks (USER_HZ 100), summed over the processors.
    // The kernel keeps no split of user and system time, nor iowait: the
    // ticks some process was running are all "user", the rest of the
    // processors' time "idle". Each processor's own line is its share.
    let wall = k.ns / 10000000;
    let cpus = smaller(k.cpus, 64);
    let mut busy = get(k.sys, SYS_BUSY);
    if cpus != 0 && busy > wall * cpus {
      busy = wall * cpus;
    }
    let mut idle = 0;
    if cpus != 0 {
      idle = wall * cpus - busy;
    }
    let mut a = put_s(&mut o, 0, "cpu  ");
    a = put_n(&mut o, a, busy);
    a = put_s(&mut o, a, " 0 0 ");
    a = put_n(&mut o, a, idle);
    a = put_s(&mut o, a, " 0 0 0 0 0 0\n");
    let mut c = 0;
    while c < cpus
      invariant c <= cpus && cpus <= 64 && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
    {
      a = put_s(&mut o, a, "cpu");
      a = put_n(&mut o, a, c);
      a = put_c(&mut o, a, 32);
      a = put_n(&mut o, a, busy / cpus);
      a = put_s(&mut o, a, " 0 0 ");
      a = put_n(&mut o, a, idle / cpus);
      a = put_s(&mut o, a, " 0 0 0 0 0 0\n");
      c = c + 1;
    }
    a = put_s(&mut o, a, "intr 0\nctxt 0\nbtime ");
    a = put_n(&mut o, a, k.epoch / NS_PER_S);
    a = put_s(&mut o, a, "\nprocesses ");
    let mut live = 0;
    let mut run = 0;
    let mut q = 1;
    while q < NPROC
      invariant 1 <= q && q <= NPROC && live < q && run <= live && kok(k)
    {
      let st = state(k.procs, q);
      if st != FREE && st != ZOMBIE {
        live = live + 1;
        if st == READY || st == RUNNING {
          run = run + 1;
        }
      }
      q = q + 1;
    }
    a = put_n(&mut o, a, live);
    a = put_s(&mut o, a, "\nprocs_running ");
    a = put_n(&mut o, a, run);
    return put_s(&mut o, a, "\nprocs_blocked 0\n");
  }
  if what == PF_DISKSTATS && p == 0 {
    // One line for the disk (major 8, minor 0, "bastio0"): reads, merges
    // (blocks beyond the first of a command), sectors and milliseconds
    // (ticks of 10 ms) for reads and writes, none in flight, and after the
    // discard fields the flushes. Then two fields of our own: how many
    // times a process was woken from a disk wait, and the milliseconds
    // all of them slept in total.
    let rc = k.fs.disk.q.rd_cmd;
    let rb = k.fs.disk.q.rd_blk;
    let wc = k.fs.disk.q.wr_cmd;
    let wb = k.fs.disk.q.wr_blk;
    let mut rm = 0;
    if rb > rc {
      rm = rb - rc;
    }
    let mut wm = 0;
    if wb > wc {
      wm = wb - wc;
    }
    let mut a = put_s(&mut o, 0, "   8       0 bastio0 ");
    a = put_n(&mut o, a, rc);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, rm);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, rb % 0x20000000000000 * 8);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, k.fs.disk.q.rd_tk % 0x20000000000000 * 10);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, wc);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, wm);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, wb % 0x20000000000000 * 8);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, k.fs.disk.q.wr_tk % 0x20000000000000 * 10);
    a = put_s(&mut o, a, " 0 0 0 0 0 0 0 ");
    a = put_n(&mut o, a, k.fs.disk.q.fl_cmd);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, k.fs.disk.q.fl_tk % 0x20000000000000 * 10);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, k.fs.disk.q.w_wakes);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, k.fs.disk.q.w_tk % 0x20000000000000 * 10);
    return put_s(&mut o, a, "\n");
  }
  if what == PF_MODULES && p == 0 {
    return 0;                               // no loadable modules
  }
  if what == PF_NETTCP6 && p == 0 {
    // IPv6 sockets run over the IPv4 stack (src/net6.bastio), so they are
    // listed in /proc/net/tcp; this table only has its header.
    return put_s(&mut o, 0, "  sl  local_address                         remote_address                        st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode\n");
  }
  if what == PF_NETTCP && p == 0 {
    // One line per connection of the reader's network namespace; the
    // queues, timers, owner and inode are not kept per connection.
    let ns = net_ns(k, pid);
    let mut a = put_s(&mut o, 0, "  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode\n");
    let mut t = 0;
    let mut row = 0;
    while t < TCBS && a + 160 < PROC_OUT
      invariant t <= TCBS && row <= t && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
    {
      let st = tcp_row(k.nic, t, ns, 0);
      if st != 0 {
        a = put_s(&mut o, a, "  ");
        a = put_n(&mut o, a, row);
        a = put_s(&mut o, a, ": ");
        a = put_ip_hex(&mut o, a, tcp_row(k.nic, t, ns, 4));
        a = put_c(&mut o, a, 58);
        a = put_hx(&mut o, a, tcp_row(k.nic, t, ns, 1), 4);
        a = put_c(&mut o, a, 32);
        a = put_ip_hex(&mut o, a, tcp_row(k.nic, t, ns, 2));
        a = put_c(&mut o, a, 58);
        a = put_hx(&mut o, a, tcp_row(k.nic, t, ns, 3), 4);
        a = put_c(&mut o, a, 32);
        a = put_hx(&mut o, a, st, 2);
        a = put_s(&mut o, a, " 00000000:00000000 00:00000000 00000000     0        0 0 1 0000000000000000 100 0 0 10 0\n");
        row = row + 1;
      }
      t = t + 1;
    }
    return a;
  }
  if what == PF_NETDEV && p == 0 {
    // One line per interface of the reader's network namespace. Only the
    // card's frames are counted, not per interface and not in bytes.
    let ns = net_ns(k, pid);
    let mut a = put_s(&mut o, 0, "Inter-|   Receive                                                |  Transmit\n face |bytes    packets errs drop fifo frame compressed multicast|bytes    packets errs drop fifo colls carrier compressed\n");
    let mut i = 0;
    while i < IFN
      invariant i <= IFN && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
    {
      if nic_if_in(k.nic, ns, i) {
        let w0 = nic_if_name(k.nic, i, 0);
        let w1 = nic_if_name(k.nic, i, 1);
        let mut l = 0;
        while l < 16 && name_byte(w0, w1, l) != 0
          invariant l <= 16 && a <= PROC_OUT && blen(o) == PROC_OUT
        {
          l = l + 1;
        }
        let mut pad = 0;
        while pad + l < 6
          invariant pad <= 6 && a <= PROC_OUT && blen(o) == PROC_OUT
        {
          a = put_c(&mut o, a, 32);
          pad = pad + 1;
        }
        let mut j = 0;
        while j < l
          invariant j <= l && l <= 16 && a <= PROC_OUT && blen(o) == PROC_OUT
        {
          a = put_c(&mut o, a, cast[u8](name_byte(w0, w1, j)));
          j = j + 1;
        }
        a = put_s(&mut o, a, ": 0 ");
        let mut rx = 0;
        let mut tx = 0;
        if i == IF_ETH && ns == 0 {
          rx = nic_frames(k.nic, true);
          tx = nic_frames(k.nic, false);
        }
        a = put_n(&mut o, a, rx);
        a = put_s(&mut o, a, " 0 0 0 0 0 0 0 ");
        a = put_n(&mut o, a, tx);
        a = put_s(&mut o, a, " 0 0 0 0 0 0\n");
      }
      i = i + 1;
    }
    return a;
  }
  if what == PF_LOADAVG && p == 0 {
    // No load average is kept (sysinfo's loads are 0 too): then the
    // runnable and existing processes, and the newest process id.
    let mut live = 0;
    let mut run = 0;
    let mut last = 0;
    let mut q = 1;
    while q < NPROC
      invariant 1 <= q && q <= NPROC && live < q && run <= live && last < q && kok(k)
    {
      let st = state(k.procs, q);
      if st != FREE && st != ZOMBIE {
        live = live + 1;
        last = q;
        if st == READY || st == RUNNING {
          run = run + 1;
        }
      }
      q = q + 1;
    }
    let mut a = put_s(&mut o, 0, "0.00 0.00 0.00 ");
    a = put_n(&mut o, a, run);
    a = put_c(&mut o, a, 47);
    a = put_n(&mut o, a, live);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, last);
    return put_c(&mut o, a, 10);
  }
  if what == PF_UPTIME {
    let up = tm_clock(k, pid, CLOCK_BOOTTIME, smaller(k.ns, FOREVER - 1));   // the reader's time namespace's boot time
    let mut a = put_n(&mut o, 0, up / NS_PER_S);
    a = put_c(&mut o, a, 46);
    a = put_2(&mut o, a, up / 10000000 % 100);
    return put_s(&mut o, a, " 0.00\n");
  }
  if p == 0 || state(k.procs, p) == FREE {
    return 0;                               // it ended after the file was opened
  }
  let s = state(k.procs, p);
  let parent = tgid(k.procs, smaller(pget(k.procs, p, F_PARENT), NPROC - 1));   // the thread group that made it
  if what == PF_STAT {
    // pid (comm) state ppid pgrp session tty_nr tpgid flags minflt cminflt
    // majflt cmajflt utime stime cutime cstime priority nice num_threads
    // itrealvalue starttime, then 30 more fields of zeros.
    let mut a = put_n(&mut o, 0, vpid_of(k, pid, p));
    a = put_s(&mut o, a, " (");
    a = put_comm(&mut k, p, &mut o, a);
    a = put_s(&mut o, a, ") ");
    a = put_c(&mut o, a, state_letter(s, is_waiting(k, p)));
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, vpid_of(k, pid, parent));
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, vpid_of(k, pid, p));
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, vpid_of(k, pid, p));
    a = put_s(&mut o, a, " 0 -1 0 0 0 0 0 ");
    a = put_n(&mut o, a, pget(k.procs, p, F_TICKS));
    let ni = nice_of(k.procs, p);
    a = put_s(&mut o, a, " 0 0 0 ");
    a = put_n(&mut o, a, ni);               // the priority: 20 + nice
    a = put_c(&mut o, a, 32);
    if ni < 20 {
      a = put_c(&mut o, a, 45);
      a = put_n(&mut o, a, 20 - ni);
    } else {
      a = put_n(&mut o, a, ni - 20);
    }
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, group_size(k, p));  // num_threads: Python warns on fork when there are more
    a = put_s(&mut o, a, " 0 ");
    a = put_n(&mut o, a, pget(k.procs, p, F_START));   // starttime: never 0, which runc relies on to tell a process from none
    let mut z = 0;
    while z < 30
      invariant z <= 30 && a <= PROC_OUT && blen(o) == PROC_OUT
    {
      a = put_s(&mut o, a, " 0");
      z = z + 1;
    }
    return put_c(&mut o, a, 10);
  }
  if what == PF_STATUS {
    let mut a = put_s(&mut o, 0, "Name:\t");
    a = put_comm(&mut k, p, &mut o, a);
    a = put_s(&mut o, a, "\nState:\t");
    a = put_c(&mut o, a, state_letter(s, is_waiting(k, p)));
    a = put_s(&mut o, a, "\nTgid:\t");
    a = put_n(&mut o, a, vpid_of(k, pid, p));
    a = put_s(&mut o, a, "\nPid:\t");
    a = put_n(&mut o, a, vpid_of(k, pid, p));
    a = put_s(&mut o, a, "\nPPid:\t");
    a = put_n(&mut o, a, vpid_of(k, pid, parent));
    let dp = pn_depth(k, nsk_of(k, NSK_PID, p));
    let dobs = pn_depth(k, nsk_of(k, NSK_PID, pid));
    if dp > dobs {
      a = put_s(&mut o, a, "\nNSpid:\t");     // its id here, then in each namespace inside, down to its own
      a = put_n(&mut o, a, vpid_of(k, pid, p));
      let mut j = smaller(dp - dobs, 3);
      while j > 0 && j <= 3
        invariant j <= 3 && blen(o) == PROC_OUT && a <= PROC_OUT && kok(k)
      {
        j = j - 1;
        a = put_c(&mut o, a, 9);
        a = put_n(&mut o, a, get(k.mns, nsk_at(vp_kind(j), p)));
      }
    }
    a = put_s(&mut o, a, "\nUid:");
    a = put_ids(&mut o, a, k, pid, p, 0, F_UID, F_SUID);
    a = put_s(&mut o, a, "\nGid:");
    a = put_ids(&mut o, a, k, pid, p, 1, F_GID, F_SGID);
    a = put_s(&mut o, a, "\nGroups:\t");
    let ng = ngroups(k.procs, p);
    let mut i = 0;
    while i < ng
      invariant i <= ng && ng <= NGROUPS_KEPT && blen(o) == PROC_OUT && a <= PROC_OUT && kok(k)
    {
      a = put_n(&mut o, a, id_out(k, pid, 1, group_at(k.procs, p, i)));
      a = put_c(&mut o, a, 32);
      i = i + 1;
    }
    a = put_s(&mut o, a, "\nVmLck:\t");
    a = put_n(&mut o, a, rl_locked(k, p) / 1024);
    a = put_s(&mut o, a, " kB\nThreads:\t");
    a = put_n(&mut o, a, group_size(k, p));
    a = put_s(&mut o, a, "\nNoNewPrivs:\t");
    if sc_nnp(k, p) {
      a = put_n(&mut o, a, 1);
    } else {
      a = put_n(&mut o, a, 0);
    }
    a = put_s(&mut o, a, "\nSeccomp:\t");
    a = put_n(&mut o, a, sc_mode(k, p));
    a = put_s(&mut o, a, "\nSeccomp_filters:\t");
    a = put_n(&mut o, a, sc_depth(k, p));
    return put_c(&mut o, a, 10);
  }
  if what == PF_COMM {
    let a = put_comm(&mut k, p, &mut o, 0);
    return put_c(&mut o, a, 10);
  }
  if what == PF_CGROUP {
    return cg_proc_text(k, p, pid, &mut o);      // src/lxcgroup.bastio
  }
  if what == PF_LIMITS {
    return limits_text(k, p, &mut o);
  }
  if what == PF_STATM {
    // size resident shared text lib data dt, in pages: every page the process
    // has is counted as resident and as data; nothing is shared or text.
    let c = smaller(anon_count(&mut k, p, 0, WPAGES), WPAGES);
    let mut a = put_n(&mut o, 0, c);
    a = put_c(&mut o, a, 32);
    a = put_n(&mut o, a, c);
    a = put_s(&mut o, a, " 0 0 0 ");
    a = put_n(&mut o, a, c);
    return put_s(&mut o, a, " 0\n");
  }
  if what == PF_IO {
    // Nothing counts bytes read or written yet.
    return put_s(&mut o, 0, "rchar: 0\nwchar: 0\nsyscr: 0\nsyscw: 0\nread_bytes: 0\nwrite_bytes: 0\ncancelled_write_bytes: 0\n");
  }
  if what == PF_SLACK {
    let a = put_n(&mut o, 0, pr_slack(k, p));
    return put_c(&mut o, a, 10);
  }
  if what == PF_MAPS {
    return maps_text(&mut k, p, &mut o);
  }
  if what == PF_CMDLINE {
    let w = pget(k.procs, p, F_ARGS);
    let n = w / 1099511627776;
    if n != 0 && n < PROC_OUT {
      let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, p, USER_BASE + w % 1099511627776, &mut k.fs.xfer, n);
      if got == n {
        let mut i = 0;
        while i < n
          invariant i <= n && n < PROC_OUT && blen(o) == PROC_OUT && blen(k.fs.xfer) == XFER
        {
          bset(&mut o, i, bget(k.fs.xfer, i));
          i = i + 1;
        }
        return n;
      }
    }
    let a = put_prog(&mut k, p, &mut o, 0, true);
    return put_c(&mut o, a, 0);
  }
  if what == PF_AUXV {
    // The auxiliary vector sits just below the argument strings, where exec
    // built it (init_stack, src/elf.bastio): found by its first entries, which
    // are always AT_PHDR, AT_PHENT = the program header size, AT_PHNUM. A
    // debugger asks for AT_ENTRY to find where a PIE program was loaded.
    let w = pget(k.procs, p, F_ARGS);
    let top = w % 1099511627776;
    if w / 1099511627776 != 0 && top >= 320 {
      if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, p, USER_BASE + top - 320, &mut k.fs.xfer, 320) == 320 {
        let mut j = 0;
        let mut found = false;
        while j < 8 && !found
          invariant j <= 8 && blen(k.fs.xfer) == XFER
        {
          if rd64(k.fs.xfer, 8 * j) == 3 && rd64(k.fs.xfer, 8 * (j + 2)) == 4 && rd64(k.fs.xfer, 8 * (j + 3)) == PH_SIZE && rd64(k.fs.xfer, 8 * (j + 4)) == 5 {
            found = true;
          } else {
            j = j + 1;
          }
        }
        if found {
          let mut e = j;
          while e < 38 && rd64(k.fs.xfer, 8 * e) != 0
            invariant j <= e && e <= 39 && blen(k.fs.xfer) == XFER
          {
            e = e + 2;
          }
          let n = 8 * (e + 2 - j);
          let mut i = 0;
          while i < n && i < 320
            invariant i <= 320 && 8 * j + i <= 8 * 7 + 320 && blen(o) == PROC_OUT && blen(k.fs.xfer) == XFER
          {
            bset(&mut o, i, bget(k.fs.xfer, 8 * j + i));
            i = i + 1;
          }
          return smaller(n, 320);
        }
      }
    }
    return 0;
  }
  if what == PF_EXE {
    return put_prog(&mut k, p, &mut o, 0, false);
  }
  return 0;
}

// ---------------------------------------------------------------- calls

/// The next up to n bytes (at most XFER) of /proc file f, open as fd, left in
/// the transfer buffer, and their count: 0 at the end, or an error. The offset
/// does not move.
fn proc_fill(k: &mut Kernel, pid: u64, fd: u64, f: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N || is_exe_file(f) {
    return EBADF;
  }
  // A process that ended after its file was opened: ESRCH, as on Linux.
  // An empty file instead makes BusyBox's ps (procps_scan) look for the
  // ')' of a /proc/PID/stat that has none and write through NULL.
  if f >= PROC_DEV && f < PROC_DEV + PSYS {
    let p = (f - PROC_DEV) / 16;
    if p != 0 && state(k.procs, p) == FREE {
      return ESRCH;
    }
  }
  if is_ns_file(f) || is_mem_file(f) {
    return EINVAL;                          // as reading an nsfs file is; memory is read by mem_io
  }
  let off = of_get(k.ofd, h, 3);
  let mut out = balloc(PROC_OUT);
  let mut g = f;
  if f == PROC_DEV + PF_MOUNTS {
    g = PROC_DEV + pid * 16 + PF_MOUNTS;    // /proc/mounts: the reader's mount namespace
  }
  let l = proc_text(&mut k, pid, g, &mut out);
  if off >= l || n == 0 {
    bfree(out);
    return 0;
  }
  let m = smaller(smaller(n, l - off), XFER);
  let mut i = 0;
  while i < m
    invariant i <= m && m <= l - off && off < l && l <= PROC_OUT && m <= XFER && blen(out) == PROC_OUT && kok(k)
  {
    bset(&mut k.fs.xfer, i, bget(out, off + i));
    i = i + 1;
  }
  bfree(out);
  return m;
}

/// read(2) on /proc file f, open in descriptor fd: the bytes of the file
/// as generated now, from the description's offset.
fn proc_read(k: &mut Kernel, pid: u64, fd: u64, f: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if is_mem_file(f) {
    return mem_io(&mut k, pid, fd, f, va, n, false);
  }
  let m = proc_fill(&mut k, pid, fd, f, n);
  if m == 0 || m > XFER {
    return m;
  }
  let put = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, m);
  if put == NO_RESULT || put == 0 {
    return EFAULT;
  }
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N {
    return EBADF;
  }
  of_set(&mut k.ofd, h, 3, sat_add(of_get(k.ofd, h, 3), put));
  return put;
}

/// lseek(2) on a /proc/PID/auxv file, open in descriptor fd: the description's offset
/// moves, so a reader that seeks (a debugger reading /proc/PID/auxv in
/// pieces) gets the part it asked for. The size is 0, as on Linux, so
/// SEEK_END counts from the start.
fn proc_seek(k: &mut Kernel, pid: u64, fd: u64, off: u64, whence: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N {
    return EBADF;
  }
  let mut base = 0;
  if whence == 1 {
    base = of_get(k.ofd, h, 3);
  } else if whence != 0 && whence != 2 {
    return EINVAL;
  }
  if base >= 0x8000000000000000 {
    return EINVAL;
  }
  let mut to = 0;
  if off < 0x8000000000000000 {
    if base > 0x7FFFFFFFFFFFFFFF - off {
      return EINVAL;
    }
    to = base + off;
  } else {
    let back = 0xFFFFFFFFFFFFFFFF - off + 1;
    if back > base {
      return EINVAL;
    }
    to = base - back;
  }
  of_set(&mut k.ofd, h, 3, to);
  return to;
}

/// Is f some process's /proc/PID/mem?
fn is_mem_file(f: u64) -> bool {
  return f >= PROC_DEV + 16 && f < PROC_DEV + PSYS && (f - PROC_DEV) % 16 == PF_MEM;
}

/// read(2) or write(2) on /proc/PID/mem, open in descriptor fd: the memory of
/// process PID, at the description's offset (an address), as ptrace's peek and
/// poke reach it: a write goes into read-only code too (a breakpoint) and a
/// read finds the code pages the program has not run yet. A page that is not
/// mapped ends the transfer: the bytes before it are moved, and it is EIO
/// only if none was.
fn mem_io(k: &mut Kernel, pid: u64, fd: u64, f: u64, va: u64, n: u64, write: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if f < PROC_DEV + 16 {
    return EBADF;
  }
  if va >= 0x800000000000 {
    return EFAULT;
  }
  let p = (f - PROC_DEV) / 16;
  if p == 0 || p >= NPROC || state(k.procs, p) == FREE {
    return ESRCH;
  }
  if state(k.procs, p) == ZOMBIE {
    return 0;
  }
  if tgid(k.procs, p) != tgid(k.procs, pid) && !cred_root(k.procs, pid) && !same_ids(k.procs, pid, p) {
    return EPERM;                           // as for ptrace
  }
  let h = fd_ofd(k, pid, fd);
  if h >= OFD_N {
    return EBADF;
  }
  let off = of_get(k.ofd, h, 3);
  if off >= 0x800000000000 {
    if n == 0 {
      return 0;
    }
    return EIO;                             // not an address a program can have
  }
  let g = tgid(k.procs, p);
  let tp = fd_row(&mut k, g);
  let mut done = 0;
  let mut go = true;
  while go && done < n && done < 0x100000
    invariant done <= n && done <= 0x101000 && kok(k) && pid < NPROC && tp < NPROC && g < NPROC && 1 <= p && p < NPROC
  {
    let at = off + done;
    if at >= 0x800000000000 {
      go = false;
    } else {
      let mut c = 4096 - at % 4096;
      if c > n - done {
        c = n - done;
      }
      if c > XFER {
        c = XFER;
      }
      if write {
        if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + done, &mut k.fs.xfer, c) != c {
          go = false;
          if done == 0 {
            return EFAULT;
          }
        } else {
          pt_fill(&mut k, p, at);
          own_touch(&mut k.mem, &mut k.spaces, g, (at - USER_BASE) / 4096, true);
          if at >= USER_BASE && copy_to_user(&mut k.spaces, &mut k.mem, k.anon, tp, at, k.fs.xfer, c) != c && force_to_user(&mut k.spaces, tp, at, k.fs.xfer, c) != c {
            go = false;
          } else if at < USER_BASE {
            go = false;
          } else {
            done = done + c;
          }
        }
      } else {
        pt_fill(&mut k, p, at);
        let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, tp, at, &mut k.fs.xfer, c);
        if got == NO_RESULT || got == 0 {
          go = false;
        } else {
          let put = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + done, k.fs.xfer, got);
          if put == NO_RESULT || put == 0 {
            go = false;
            if done == 0 {
              return EFAULT;
            }
          } else {
            done = done + put;
            if put < c {
              go = false;
            }
          }
        }
      }
    }
  }
  if done == 0 && n != 0 {
    return EIO;
  }
  of_set(&mut k.ofd, h, 3, off + done);
  return done;
}

/// If x[..n] is /proc/PID/fd/N: PID * LXNFD + N, else NO_RESULT. Only
/// readlink knows these links; they are not listed or stat'ed.
fn proc_fd(procs: &Buf, x: &Bytes, n: u64) -> u64
  requires ptab_ok(procs) && n <= blen(x)
  ensures result == NO_RESULT || result < NPROC * LXNFD
{
  if n < 6 || !xfer_is(x, 0, 5, "proc/") {
    return NO_RESULT;
  }
  let e = comp_end(x, 5, n);
  let p = proc_pid(procs, x, 5, e);
  if p >= NPROC || n < e + 5 || n > e + 6 || !xfer_is(x, e, e + 4, "/fd/") {
    return NO_RESULT;
  }
  let mut fd = 0;
  let mut i = e + 4;
  while i < n
    invariant e + 4 <= i && i <= n && n <= e + 6 && fd < 100
  {
    let c = cast[u64](bget(x, i));
    if c < 48 || c > 57 || fd >= 10 {
      return NO_RESULT;
    }
    fd = fd * 10 + (c - 48);
    i = i + 1;
  }
  if fd >= LXNFD {
    return NO_RESULT;
  }
  return p * LXNFD + fd;
}

/// Where the name x[..n] (no leading "/") goes on once process p's root is
/// taken off its front: 0 if the name is not inside the root.
fn root_skip(k: &Kernel, p: u64, x: &Bytes, n: u64) -> u64
  requires kok(k) && p < NPROC && n <= blen(x)
  ensures result <= n
{
  let rl = root_len(k, p);
  if rl == 0 || n < rl {
    return 0;
  }
  let mut i = 0;
  while i < rl
    invariant i <= rl && rl <= n && n <= blen(x) && rl <= FNAME_MAX && kok(k) && p < NPROC
  {
    if cast[u64](bget(x, i)) != wget(k.croot, p * CWD_STRIDE + 1 + i) % 256 {
      return 0;
    }
    i = i + 1;
  }
  if n == rl {
    return rl;
  }
  if bget(x, rl) != 47 {
    return 0;
  }
  return rl + 1;
}

/// The target of /proc/P/fd/FD into o: "/dev/tty" for the console, the
/// path of a file, a "pipe:[N]" or "socket:[N]" or "anon_inode:[...]"
/// name for the rest. Returns its length, or NO_RESULT if fd is closed.
fn fd_link(k: &mut Kernel, p: u64, fd: u64, o: &mut Bytes) -> u64
  requires kok(k) && p < NPROC && blen(o) == PROC_OUT
  ensures kok(k) && blen(o) == PROC_OUT
  ensures result <= PROC_OUT || result == NO_RESULT
{
  let d = fd_look(k, p, fd);
  if d.kind == K_BAD {
    return NO_RESULT;
  }
  if d.kind == K_CONSOLE {
    return put_s(&mut o, 0, "/dev/tty");
  }
  if d.kind == K_DEV && d.x >= DEV_PTS && d.x < DEV_PTS + PTY_N {
    return put_n(&mut o, put_s(&mut o, 0, "/dev/pts/"), d.x - DEV_PTS);
  }
  if d.kind == K_DEV && d.x >= DEV_PTM && d.x < DEV_PTM + PTY_N {
    return put_s(&mut o, 0, "/dev/ptmx");
  }
  if d.kind == K_PIPE_R || d.kind == K_PIPE_W {
    let a = put_s(&mut o, 0, "pipe:[");
    return put_c(&mut o, put_n(&mut o, a, d.x), 93);
  }
  if d.kind == K_SOCK {
    let a = put_s(&mut o, 0, "socket:[");
    return put_c(&mut o, put_n(&mut o, a, d.x), 93);
  }
  if d.kind == K_FILE {
    let f = vfs_row_file(k.fs, d.x);
    if f != NO_FILE {
      let n = vfs_dirent(&mut k.fs, f);
      if n != NO_FILE && n <= XFER {
        let mut a = put_c(&mut o, 0, 47);
        // A file below a mount the process's namespace made (a tmpfs, say)
        // reads under the mount's name, not the file layer's; and below the
        // process's root (chroot, pivot_root) from there.
        let mut lg = balloc(FNAME_MAX);
        let ln = ns_back(k, ns_of(k, p), smaller(n, FNAME_MAX), &mut lg);
        if ln != NO_RESULT && ln < PROC_OUT {
          let mut j = root_skip(k, p, lg, ln);
          while j < ln
            invariant j <= ln && ln < PROC_OUT && a <= PROC_OUT && blen(o) == PROC_OUT && FNAME_MAX <= blen(lg) && kok(k)
          {
            a = put_c(&mut o, a, bget(lg, j));
            j = j + 1;
          }
          bfree(lg);
          return a;
        }
        bfree(lg);
        let mut j = root_skip(k, p, k.fs.xfer, n);
        while j < n
          invariant j <= n && n <= XFER && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
        {
          a = put_c(&mut o, a, bget(k.fs.xfer, j));
          j = j + 1;
        }
        return a;
      }
    }
  }
  if d.kind == K_DIR || (d.kind == K_DEV && d.x == DEV_PTSDIR) {
    // An open directory: its name as it was opened (runc checks that its
    // descriptor for /sys/fs/cgroup reads back as that).
    let v = fd_get(k.lxfd, p, fd) % FD_CLOEXEC;
    if v >= FD_OFD && v - FD_OFD < OFD_N {
      let h = v - FD_OFD;
      let n = base_len(k, p, h);
      if n == 0 && d.kind == K_DEV {
        return put_s(&mut o, 0, "/dev/pts");
      }
      let mut a = 0;
      if n == 0 || base_byte(k, p, h, 0) != 47 {
        a = put_c(&mut o, 0, 47);
      }
      let mut j = 0;
      // A directory opened before a chroot or pivot_root reads relative to
      // the process's root now (the root directory itself as "/"), when it
      // is inside it.
      let rl = root_len(k, p);
      if rl > 0 {
        let mut s0 = 0;
        if n > 0 && base_byte(k, p, h, 0) == 47 {
          s0 = 1;
        }
        let mut inside = n >= s0 + rl && (n == s0 + rl || base_byte(k, p, h, s0 + rl) == 47);
        let mut i = 0;
        while inside && i < rl
          invariant i <= rl && rl <= FNAME_MAX && s0 <= 1 && (!inside || s0 + rl <= n) && n <= FNAME_MAX && kok(k) && p < NPROC
        {
          if cast[u8](wget(k.croot, p * CWD_STRIDE + 1 + i) % 256) != base_byte(k, p, h, s0 + i) {
            inside = false;
          }
          i = i + 1;
        }
        if inside {
          j = s0 + rl;
          if j < n {
            j = j + 1;                      // the slash after the root's name
          }
          a = put_c(&mut o, 0, 47);
        }
      }
      while j < n && a < PROC_OUT
        invariant j <= n && n <= FNAME_MAX && a <= PROC_OUT && blen(o) == PROC_OUT && kok(k)
      {
        a = put_c(&mut o, a, base_byte(k, p, h, j));
        j = j + 1;
      }
      return a;
    }
  }
  return put_s(&mut o, 0, "anon_inode:[file]");
}

/// If the file-layer name x[..n] is /proc/PID/fd/N of the caller's own
/// process (a thread of it) and descriptor N is an open directory or a file
/// that still has a name, the path it stands for, written to the transfer
/// buffer: Linux follows these links in a path walk (a mount onto
/// /proc/self/fd/N, a stat, a chdir). Returns its length, or NO_RESULT.
fn magic_link(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  if n > XFER || n < 11 || n > FNAME_MAX || !xfer_is(k.fs.xfer, 0, 5, "proc/") {
    return NO_RESULT;                       // the common case, quickly
  }
  // "self" and a PID namespace's ids are rewritten as at the end of a walk;
  // the name is put back if it is not a link after all.
  let mut sv = balloc(FNAME_MAX);
  let mut j = 0;
  while j < n
    invariant j <= n && n <= FNAME_MAX && blen(sv) == FNAME_MAX && kok(k)
  {
    bset(&mut sv, j, bget(k.fs.xfer, j));
    j = j + 1;
  }
  let n1 = proc_vpid(&mut k, n, pid);
  let n2 = proc_task(&mut k, proc_self(&mut k.fs.xfer, n1, pid));
  let r = magic_target(&mut k, pid, n2);
  if r == NO_RESULT {
    j = 0;
    while j < n
      invariant j <= n && n <= FNAME_MAX && blen(sv) == FNAME_MAX && kok(k)
    {
      bset(&mut k.fs.xfer, j, bget(sv, j));
      j = j + 1;
    }
  }
  bfree(sv);
  return r;
}

/// Does file f lie inside process p's root?
fn file_in_root(k: &mut Kernel, p: u64, f: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let n = vfs_dirent(&mut k.fs, f);
  if n == NO_FILE || n > FNAME_MAX {
    return false;
  }
  let mut lg = balloc(FNAME_MAX);
  let ln = ns_back(k, ns_of(k, p), n, &mut lg);
  let mut inside = false;
  if ln != NO_RESULT {
    inside = root_skip(k, p, lg, ln) > 0;
  } else {
    inside = root_skip(k, p, k.fs.xfer, n) > 0;
  }
  bfree(lg);
  return inside;
}

/// magic_link for the rewritten name x[..n].
fn magic_target(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= FNAME_MAX
  ensures kok(k)
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  let pfd = proc_fd(k.procs, k.fs.xfer, n);
  if pfd == NO_RESULT || tgid(k.procs, pfd / LXNFD) != tgid(k.procs, pid) {
    return NO_RESULT;
  }
  let t = pfd / LXNFD;
  let fd = pfd % LXNFD;
  let d = fd_look(k, t, fd);
  let mut fr = NO_FILE;
  if d.kind == K_FILE {
    fr = vfs_row_file(k.fs, d.x);
  }
  let inroot = fr != NO_FILE && file_in_root(&mut k, pid, fr);
  // Only a directory (or the pts directory) is followed to a path, and a
  // file only if it lies inside the process's root (a chroot, a container),
  // as outside it its name resolves to nothing; open and exec reopen a file
  // through the link.
  if d.kind != K_DIR && !(d.kind == K_DEV && d.x == DEV_PTSDIR) && !(d.kind == K_FILE && (root_len(k, pid) == 0 || inroot) && !ofd_lacks(k, fd_ofd(k, t, fd), ACC_LINK)) {
    return NO_RESULT;
  }
  if d.kind == K_FILE {
    // Its name must still be the file's: a file removed while open keeps
    // the name it had in the table.
    let f = vfs_row_file(k.fs, d.x);
    let nm = vfs_dirent(&mut k.fs, f);
    if f == NO_FILE || nm == NO_FILE || nm > FNAME_MAX || vfs_lookup(&mut k.fs, nm) != f {
      return NO_RESULT;
    }
  }
  let mut lo = balloc(PROC_OUT);
  let ln = fd_link(&mut k, t, fd, &mut lo);
  if ln == NO_RESULT || ln == 0 || ln > FNAME_MAX || bget(lo, 0) != 47 {
    bfree(lo);
    return NO_RESULT;                       // not a path ("anon_inode:[file]")
  }
  let mut i = 0;
  while i < ln
    invariant i <= ln && ln <= FNAME_MAX && blen(lo) == PROC_OUT && kok(k)
  {
    bset(&mut k.fs.xfer, i, bget(lo, i));
    i = i + 1;
  }
  bfree(lo);
  return ln;
}

/// Whether process pid may read process p's /proc links (exe and fd/N):
/// p itself, root, or a process with the same real, effective and saved
/// user and group ids, as Linux's PTRACE_MODE_READ_FSCREDS asks (without
/// its dumpable flag).
fn proc_peek(procs: &Buf, pid: u64, p: u64) -> bool
  requires ptab_ok(procs) && pid < NPROC && p < NPROC
{
  return pid == p || cred_root(procs, pid) || same_ids(procs, pid, p);
}

/// Whether /proc file f is one of another process's whose content tells
/// pid more than it may know: the memory map (/proc/PID/maps) and the
/// auxiliary vector (/proc/PID/auxv) give away where its stack, libraries
/// and code lie, /proc/PID/mem is its memory, and /proc/PID/io counts what
/// it reads and writes. Linux hides them from anyone who could not ptrace
/// the process (EACCES at open); so does this, by proc_peek.
fn proc_secret(procs: &Buf, pid: u64, f: u64) -> bool
  requires ptab_ok(procs) && pid < NPROC
{
  if f < PROC_DEV + 16 || f >= PROC_DEV + PSYS {
    return false;
  }
  let p = (f - PROC_DEV) / 16;
  let w = (f - PROC_DEV) % 16;
  if p >= NPROC || (w != PF_MAPS && w != PF_AUXV && w != PF_MEM && w != PF_IO) {
    return false;
  }
  return !proc_peek(procs, pid, p);
}

/// Whether the path at user address path ends in the component "self"
/// (after "/" or alone): readlink of /proc/self, which the walk rewrites to
/// the caller's /proc/PID.
fn path_ends_self(k: &mut Kernel, pid: u64, path: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, path, &mut k.fs.xfer, FNAME_MAX);
  if got == NO_RESULT || got < 4 || got > FNAME_MAX {
    return false;
  }
  let mut n = 0;
  while n < got && bget(k.fs.xfer, n) != 0
    invariant n <= got && got <= FNAME_MAX && kok(k)
  {
    n = n + 1;
  }
  if n < 4 || n == got || !xfer_is(k.fs.xfer, n - 4, n, "self") {
    return false;
  }
  return n == 4 || bget(k.fs.xfer, n - 5) == 47;
}

/// readlink / readlinkat(dirfd, path, buf, size): the target of
/// /proc/PID/exe or /proc/PID/fd/N, without a NUL (-EACCES unless
/// proc_peek); -EINVAL for anything else that exists, since nothing else
/// is a symbolic link.
fn lx_readlink(k: &mut Kernel, pid: u64, dirfd: u64, path: u64, va: u64, size: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if size == 0 || size > 0x7FFFFFFF {
    return EINVAL;                          // checked before the path, as on Linux
  }
  if dirfd % 0x100000000 != AT_FDCWD && user_empty(&mut k, pid, path) {
    // readlinkat(fd, "") on an O_PATH | O_NOFOLLOW handle on a link
    // reads that link, as on Linux; on anything else "" names nothing.
    let d = fd_look(k, pid, dirfd);
    if d.kind == K_FILE {
      let f = vfs_row_file(k.fs, d.x);
      if f != NO_FILE && vfs_is_link(&mut k.fs, f) {
        return link_out(&mut k, pid, f, va, size);
      }
    }
  }
  let selfname = path_ends_self(&mut k, pid, path);
  let n = lx_path_at_nf(&mut k, pid, dirfd, path);
  if n == NO_RESULT {
    return k.perr;
  }
  let lk = vfs_lookup(&mut k.fs, n);
  if lk != NO_FILE && vfs_is_link(&mut k.fs, lk) {
    return link_out(&mut k, pid, lk, va, size);   // a symbolic link (src/lxlink.bastio)
  }
  if selfname && n > 5 && n <= 14 && xfer_is(k.fs.xfer, 0, 5, "proc/") {
    // readlink of /proc/self: the walk made it /proc/PID, and the link's
    // text is the caller's id in its PID namespace.
    let id = vpid_of(k, pid, tgid(k.procs, pid));
    if id < 10000000 {
      let d = dec_big(&mut k.fs.xfer, 0, id);
      let m = smaller(d, size);
      if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, m) != m {
        return EFAULT;
      }
      return m;
    }
  }
  let mut pfd = NO_RESULT;
  if n <= XFER {
    pfd = proc_fd(k.procs, k.fs.xfer, n);
  }
  if pfd != NO_RESULT {
    if size == 0 || size > 0x7FFFFFFF {
      return EINVAL;
    }
    if !proc_peek(k.procs, pid, pfd / LXNFD) {
      return EACCES;
    }
    let mut lo = balloc(PROC_OUT);
    let ln = fd_link(&mut k, pfd / LXNFD, pfd % LXNFD, &mut lo);
    if ln == NO_RESULT {
      bfree(lo);
      return ENOENT;
    }
    let m = smaller(ln, smaller(size, XFER));
    let mut i = 0;
    while i < m
      invariant i <= m && m <= PROC_OUT && m <= XFER && blen(lo) == PROC_OUT && kok(k)
    {
      bset(&mut k.fs.xfer, i, bget(lo, i));
      i = i + 1;
    }
    bfree(lo);
    if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, m) != m {
      return EFAULT;
    }
    return m;
  }
  let f = proc_node(k, n);
  if f == 0 || (!is_exe_file(f) && !is_ns_file(f)) {
    let m = path_meta(&mut k, n);
    if m.ok {
      return EINVAL;
    }
    return ENOENT;
  }
  if size == 0 || size > 0x7FFFFFFF {
    return EINVAL;
  }
  let mut t = (f - PROC_DEV) / 16;      // the process of an exe link
  if is_ns_file(f) {
    t = nsf_proc(f);
  }
  if t >= NPROC || !proc_peek(k.procs, pid, t) {
    return EACCES;
  }
  let mut out = balloc(PROC_OUT);
  let full = proc_text(&mut k, pid, f, &mut out);
  // The program's name is from the top of the file system; the reader sees
  // it from its own root (chroot), as on Linux. A program outside the
  // root keeps its full name.
  let mut cut = 0;
  let rl = root_len(k, pid);
  if is_exe_file(f) && rl > 0 && full > rl + 1 {
    // out is "/" and the name; the root is kept without the "/".
    let mut same = true;
    let mut j = 0;
    while same && j < rl
      invariant j <= rl && rl + 1 < full && full <= PROC_OUT && rl <= FNAME_MAX && blen(out) == PROC_OUT && kok(k) && pid < NPROC
    {
      if cast[u64](bget(out, j + 1)) != wget(k.croot, pid * CWD_STRIDE + 1 + j) % 256 {
        same = false;
      }
      j = j + 1;
    }
    if same && bget(out, rl + 1) == 47 {
      cut = rl + 1;
    }
  }
  let l = smaller(full - cut, smaller(size, XFER));
  let mut i = 0;
  while i < l
    invariant i <= l && cut <= full && l <= full - cut && full <= PROC_OUT && l <= XFER && blen(out) == PROC_OUT && kok(k)
  {
    bset(&mut k.fs.xfer, i, bget(out, cut + i));
    i = i + 1;
  }
  bfree(out);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, l) != l {
    return EFAULT;
  }
  return l;
}

fn is_procfs_call(n: u64) -> bool {
  return n == LX_READLINK || n == LX_READLINKAT;
}

/// readlink and readlinkat.
fn lx_procfs_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_READLINK {
    return lx_readlink(&mut k, pid, AT_FDCWD, a, b, c);
  }
  return lx_readlink(&mut k, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10));
}

/// write(2) to /proc file f, open for writing (proc_writable): a decimal
/// number for pipe-max-size, rounded up to a power of two pages as Linux
/// does (round_pipe_size), at least a page and at most 2^31. Returns n,
/// or -EINVAL for anything else. Past PIPE_CAP it is kept and read back,
/// but a pipe still holds no more than PIPE_CAP (F_SETPIPE_SZ: ENOMEM).
/// A write of n bytes in k.fs.xfer, starting at i after the blanks, to
/// /proc/sys/kernel/shmmax: a decimal number up to 2^40, then blanks.
fn shmmax_write(k: &mut Kernel, n: u64, start: u64) -> u64
  requires kok(k) && n <= 32 && start <= n
  ensures kok(k)
  ensures result <= n || result > XFER
{
  let mut i = start;
  let mut v = 0;
  let mut any = false;
  while i < n && bget(k.fs.xfer, i) >= 48 && bget(k.fs.xfer, i) <= 57 && v <= 0x10000000000
    invariant i <= n && n <= 32 && v <= 0x10000000009 * 10 && kok(k)
  {
    v = v * 10 + cast[u64](bget(k.fs.xfer, i)) - 48;
    any = true;
    i = i + 1;
  }
  while i < n && (bget(k.fs.xfer, i) == 10 || bget(k.fs.xfer, i) == 32 || bget(k.fs.xfer, i) == 9)
    invariant i <= n && n <= 32 && kok(k)
  {
    i = i + 1;
  }
  if !any || i < n || v > 0x10000000000 {
    return EINVAL;
  }
  k.sys = set(k.sys, SYS_SHMMAX, v + 1);
  return n;
}

/// A write of n bytes in k.fs.xfer, starting at i after the blanks, to a
/// *_next_id file: -1 (none) or an id up to INT_MAX for the next new
/// object of that IPC kind.
fn next_id_write(k: &mut Kernel, f: u64, n: u64, start: u64) -> u64
  requires kok(k) && n <= 32 && start <= n && f >= PROC_DEV + PSYS + SY_NEXTID && f < PROC_DEV + PSYS + SY_NEXTID + 3
  ensures kok(k)
  ensures result <= n || result > XFER
{
  let mut i = start;
  let mut neg = false;
  if i < n && bget(k.fs.xfer, i) == 45 {
    neg = true;
    i = i + 1;
  }
  let mut v = 0;
  let mut any = false;
  while i < n && bget(k.fs.xfer, i) >= 48 && bget(k.fs.xfer, i) <= 57 && v <= 0x80000000
    invariant i <= n && n <= 32 && v <= 0x80000009 * 10 && kok(k)
  {
    v = v * 10 + cast[u64](bget(k.fs.xfer, i)) - 48;
    any = true;
    i = i + 1;
  }
  while i < n && (bget(k.fs.xfer, i) == 10 || bget(k.fs.xfer, i) == 32 || bget(k.fs.xfer, i) == 9)
    invariant i <= n && n <= 32 && kok(k)
  {
    i = i + 1;
  }
  if !any || i < n {
    return EINVAL;
  }
  let kind = f - PROC_DEV - PSYS - SY_NEXTID;
  if neg {
    if v != 1 {
      return EINVAL;                        // only -1 is below zero
    }
    k.sys = set(k.sys, SYS_NEXTID + kind, 0);
    return n;
  }
  if v > 0x7FFFFFFF {
    return EINVAL;
  }
  k.sys = set(k.sys, SYS_NEXTID + kind, v + 1);
  return n;
}

fn proc_write(k: &mut Kernel, pid: u64, f: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if is_cg_file(f) {
    return cg_write(&mut k, pid, f, va, n);   // src/lxcgroup.bastio
  }
  if is_um_file(f) {
    return um_write(&mut k, pid, f, va, n);   // src/lxuser.bastio
  }
  if f == PROC_DEV + PSYS + SY_UTS || f == PROC_DEV + PSYS + SY_UTS + 1 {
    return uts_proc_write(&mut k, pid, f - (PROC_DEV + PSYS + SY_UTS), va, n);   // src/lxsys.bastio
  }
  if !proc_writable(f) || n == 0 || n > 32 {
    return EINVAL;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, n) != n {
    return EFAULT;
  }
  return proc_write_xfer(&mut k, f, n);
}

/// Whether /proc file f is /proc/sys/kernel/hostname or domainname, and which
/// of the two (0 or 1).
fn is_uts_file(f: u64) -> bool {
  return f == PROC_DEV + PSYS + SY_UTS || f == PROC_DEV + PSYS + SY_UTS + 1;
}

fn uts_file_index(f: u64) -> u64
  ensures result < 2
{
  if f == PROC_DEV + PSYS + SY_UTS + 1 {
    return 1;
  }
  return 0;
}

/// Whether a write of the transfer buffer can set /proc file f: the number
/// files, which need no user memory beyond that buffer.
fn proc_xfer_writable(f: u64) -> bool {
  return proc_writable(f) && !is_mem_file(f) && !is_cg_file(f) && !is_um_file(f) && f != PROC_DEV + PSYS + SY_UTS && f != PROC_DEV + PSYS + SY_UTS + 1;
}

/// The part of proc_write after the bytes are in the transfer buffer: n of
/// them (1 to 32) for the number file f, which proc_xfer_writable accepted.
fn proc_write_xfer(k: &mut Kernel, f: u64, n: u64) -> u64
  requires kok(k) && n <= 32
  ensures kok(k)
  ensures result <= n || result > XFER
{
  if f == PROC_DEV + PSYS + SY_DROP {
    // 1, 2 or 3 drop the caches; there is nothing to drop that anyone could
    // tell, so the write is accepted and forgotten.
    let c = bget(k.fs.xfer, 0);
    if c < 49 || c > 52 || (n > 1 && bget(k.fs.xfer, 1) != 10) {
      return EINVAL;
    }
    return n;
  }
  let mut i = 0;
  while i < n && (bget(k.fs.xfer, i) == 32 || bget(k.fs.xfer, i) == 9)
    invariant i <= n && n <= 32 && kok(k)
  {
    i = i + 1;
  }
  let pbase = PROC_DEV + PSYS + SY_PX;
  if f >= pbase && is_px_timens(f) {
    return tm_write(&mut k, smaller((f - pbase) / PXF_N, NPROC - 1), n);   // src/lxnsk.bastio
  }
  if f >= pbase && f < pbase + NPROC * PXF_N && (f - pbase) % PXF_N == 1 {
    // oom_score_adj: -1000 to 1000, kept as 1001 + it
    let mut neg = false;
    if i < n && bget(k.fs.xfer, i) == 45 {
      neg = true;
      i = i + 1;
    }
    let mut a = 0;
    let mut got = false;
    while i < n && bget(k.fs.xfer, i) >= 48 && bget(k.fs.xfer, i) <= 57 && a <= 1000
      invariant i <= n && n <= 32 && a <= 10009 && kok(k)
    {
      a = a * 10 + cast[u64](bget(k.fs.xfer, i)) - 48;
      got = true;
      i = i + 1;
    }
    while i < n && (bget(k.fs.xfer, i) == 10 || bget(k.fs.xfer, i) == 32 || bget(k.fs.xfer, i) == 9)
      invariant i <= n && n <= 32 && kok(k)
    {
      i = i + 1;
    }
    if !got || i < n || a > 1000 {
      return EINVAL;
    }
    let mut stored = 1001 + a;
    if neg {
      stored = 1001 - a;
    }
    k.sys = set(k.sys, SYS_OOM + (f - pbase) / PXF_N, stored + 1);
    return n;
  }
  if f >= PROC_DEV + PSYS + SY_NEXTID && f < PROC_DEV + PSYS + SY_NEXTID + 3 {
    return next_id_write(&mut k, f, n, i);
  }
  if f == PROC_DEV + PSYS + SY_IPC {
    return shmmax_write(&mut k, n, i);
  }
  let mut v = 0;
  let mut any = false;
  while i < n && bget(k.fs.xfer, i) >= 48 && bget(k.fs.xfer, i) <= 57 && v <= 0x80000000
    invariant i <= n && n <= 32 && v <= 0x80000009 * 10 && kok(k)
  {
    v = v * 10 + cast[u64](bget(k.fs.xfer, i)) - 48;
    any = true;
    i = i + 1;
  }
  while i < n && (bget(k.fs.xfer, i) == 10 || bget(k.fs.xfer, i) == 32 || bget(k.fs.xfer, i) == 9)
    invariant i <= n && n <= 32 && kok(k)
  {
    i = i + 1;
  }
  if !any || i < n || v > 0x80000000 {
    return EINVAL;
  }
  let sbase = PROC_DEV + PSYS + SY_SC;
  if f >= sbase && f < sbase + SCT_NUM {
    k.sys = set(k.sys, SYS_SCT + (f - sbase), v + 1);
    return n;
  }
  if f == PROC_DEV + PSYS + SY_IPC + 5 {
    if v > 32768 {
      return EINVAL;                        // IPCMNI
    }
    k.sys = set(k.sys, SYS_MSGMNI, v + 1);
    return n;
  }
  if f == PROC_DEV + PSYS + SY_PID_MAX {
    if v < 301 || v > 4194304 {
      return EINVAL;                        // Linux's bounds: PIDS_MIN and PID_MAX_LIMIT
    }
    k.sys = set(k.sys, SYS_PIDMX, v + 1);
    return n;
  }
  if f == PROC_DEV + PSYS + SY_NROPEN {
    if v < 64 {
      return EINVAL;                        // Linux's lower bound: a descriptor word
    }
    k.sys = set(k.sys, SYS_NROPEN, v + 1);
    return n;
  }
  if f >= PROC_DEV + PSYS + SY_INO && f < PROC_DEV + PSYS + SY_INO + 3 {
    k.sys = set(k.sys, SYS_INOL + (f - PROC_DEV - PSYS - SY_INO), v + 1);
    return n;
  }
  let mut size = PIPE_PAGE;
  while size < v && size < 0x80000000
    invariant PIPE_PAGE <= size && size <= 0x80000000
  {
    if size >= 0x40000000 {
      size = 0x80000000;
    } else {
      size = size * 2;
    }
  }
  k.sys = set(k.sys, SYS_PIPEMAX, size);
  return n;
}

/// The number of threads in p's thread group: 1 for a process without
/// threads.
fn group_size(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result <= NPROC
{
  if pget(k.procs, p, F_TGID) == 0 {
    return 1;
  }
  let g = tgid(k.procs, p);
  let mut n = 0;
  let mut q = 1;
  while q < NPROC
    invariant 1 <= q && q <= NPROC && n < q && kok(k)
  {
    if in_group(k.procs, q, g) {
      n = n + 1;
    }
    q = q + 1;
  }
  if n == 0 {
    return 1;
  }
  return n;
}
