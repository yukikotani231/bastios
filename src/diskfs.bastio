// A file system on the disk, so files survive power off. The disk is cut
// into blocks of 4096 bytes (8 sectors):
//
//   block 0          superblock: the magic "BSTDISK3", then where the
//                    rest of the directory is (below)
//   blocks 1..4      directory: entries 0..63, 256 bytes each
//   blocks 5..       file data, the maps that find it, and the rest of
//                    the directory
//
// The directory grows. Its first DIR_FIXED blocks are blocks 1..4; block
// db of it past those (16 entries each, up to DSLOTS entries in all) is
// the block number at byte 8 * db of the superblock, 0 while it does not
// exist yet. dir_grow adds one when every entry is taken: the new block,
// all zeros (no entries), is written and flushed, and only then the
// superblock that names it, so a power cut leaves either no new block (and
// a free block, as nothing names it) or an empty one. Blocks are added in
// order and never taken away. Entry 64 is never used: its number is DTOP,
// which parents name for the top, as they did when the directory had
// exactly 64 entries. A disk in the older format, BSTDISK2 (the same, with
// only the fixed blocks), is mounted as it is and its magic rewritten.
//
// A directory entry is: byte 0 its kind (0 unused, 1 a file, 2 a
// directory, which holds no data, 3 an orphan: a file removed while it
// was open, nameless until its last close), byte 1 its name length, then as
// little-endian u64s: at 8 its parent (another entry, or DTOP for the top
// directory, "disk"), at 16 its size, at 24 its root map block (0 for no
// data), at 32 its mode, at 40 its modification time; bytes 56..256 its
// name: one path component of up to DNAME_MAX bytes. So a path is a walk
// from the top, component by component, and full paths can be longer than
// any entry. A blank disk is formatted when it is mounted; a disk with
// neither magic that is not blank (a partition table, another system's
// data, a still older format) is left alone, and there is no file system.
//
// A file's data is found through two levels of maps. The root map is one
// block of PTRS block numbers, each naming a first-level map, a block of
// PTRS more naming data blocks; block number 0 is a hole and reads as
// zeros. A file can grow to PTRS * PTRS blocks (1 GiB), as far as the disk
// allows. Which blocks are in use is not on the disk: mounting walks every
// file's maps and rebuilds the table in memory, so there is no free list
// to keep consistent.
//
// Power cuts. Data is never written over in place. A write builds the
// blocks it changes in memory and queues them, and new copies of the maps
// above them, for free blocks; then a flush; then the directory block
// holding the file's entry, now with the new root and size (an entry
// never straddles a sector, so its sector is written whole or not at all,
// and the block's other sectors are rewritten unchanged); then a flush.
// The old blocks are freed only after that (src/diskq.bastio runs the
// queue in order). Removing and truncating write only the entry, after
// waiting for the queue to empty. A flush means the drive has the data
// (ATA, AHCI, NVMe: FLUSH CACHE; virtio: the legacy device is
// write-through unless the cache feature is negotiated, and it is not).
// So after a cut anywhere, the file system
// mounts as it was after some prefix of the entry writes: each write call
// has happened entirely or not at all, even one that overwrites bytes in
// the middle of a file across two blocks. Not atomic: a format cut short
// (the next mount formats again), and work that takes several calls, such
// as O_TRUNC followed by writes. test/shell_test.sh cuts power during
// user/crashme.bastio six times and checks this.
//
// A damaged disk (two entries naming one block, a cycle of parents) can
// lose data, but never makes the kernel read or write outside its
// buffers: every block number and length read from the disk is checked.

import "blk.bastio";
import "diskq.bastio";
import "core/endian.bastio";

const DSLOTS: u64 = 1024;             // directory entries, at most
const DENT: u64 = 256;
const DIR_BYTES: u64 = 262144;        // DSLOTS * DENT
const DIR_SECTORS: u64 = 512;
const DIR_BLOCKS: u64 = 64;
const DIR_FIXED: u64 = 4;             // directory blocks 0..3 are disk blocks 1..4
const DPB: u64 = 16;                  // directory entries per block
const DIR_LBA: u64 = 8;               // block 1
const BLOCK: u64 = 4096;
const BSECT: u64 = 8;                 // sectors per block
const DATA_B0: u64 = 5;               // the first block for data and maps
const PTRS: u64 = 512;                // block numbers in a map
const MAX_BLOCKS: u64 = 65536;        // the most blocks used (256 MiB)
const DFILE_MAX: u64 = 1073741824;    // PTRS * PTRS * BLOCK
const DNAME_MAX: u64 = 200;
const DTOP: u64 = 64;                 // the parent of an entry in "disk"; entry 64 stays unused
const DISK_MAGIC: u64 = 0x334B534944545342;   // "BSTDISK3", little-endian
const DISK_MAGIC2: u64 = 0x324B534944545342;  // "BSTDISK2": no directory blocks past the fixed ones
const NO_DISK_FILE: u64 = 18446744073709551615;
const DISK_MISS: u64 = 18446744073709551614;    // not in the cache yet: try again (see disk_read)

// Directory entry fields.
const E_KIND: u64 = 0;
const K_ORPHAN: u64 = 3;               // kind: a file removed while open
const K_LINK: u64 = 4;                 // kind: a hard link to the file entry in E_LINK
const E_NLEN: u64 = 1;
const E_PARENT: u64 = 8;
const E_SIZE: u64 = 16;
const E_ROOT: u64 = 24;
const E_MODE: u64 = 32;
const E_MTIME: u64 = 40;
const E_LINK: u64 = 48;
const E_NAME: u64 = 56;

const MODE_FILE: u64 = 420;           // 0644
const MODE_DIR: u64 = 493;            // 0755

struct DiskFs {
  dev: Blk,
  dir: Bytes,           // the directory, DIR_BYTES
  sb: Bytes,            // the superblock's first sector: the magic and the directory's blocks
  sec: Bytes,           // a sector buffer
  root: Bytes,          // a root map, while a write changes it
  la: Bytes,            // a first-level map, likewise
  lb: Bytes,            // a second one, for a write that crosses two
  data: Bytes,          // a data block being built
  d2: Bytes,            // a second one, for a write that crosses two
  q: DiskQ,             // the block cache and the queue of disk commands (src/diskq.bastio)
  txn: u64,             // the last transaction a write queued, for its caller to wait on
  used: Bytes,          // MAX_BLOCKS: 1 for each block in use
  blocks: u64,          // blocks on the disk, at most MAX_BLOCKS
  slots: u64,           // the entries the directory's blocks hold now (DPB * blocks); 0 without a disk
  hint: u64,            // where the next allocation starts looking
  foreign: bool,        // the disk holds something else, and is left alone
}

spec fn disk_ok(d: &DiskFs) -> bool {
  blk_ok(d.dev) && blen(d.dir) == DIR_BYTES && blen(d.sb) == SECTOR && blen(d.sec) == SECTOR && blen(d.root) == BLOCK
    && blen(d.la) == BLOCK && blen(d.lb) == BLOCK && blen(d.data) == BLOCK && blen(d.d2) == BLOCK && dq_ok(d.q)
    && blen(d.used) == MAX_BLOCKS && d.blocks <= MAX_BLOCKS && d.slots <= DSLOTS
}

// ---------------------------------------------------------------- bytes

/// The little-endian u64 at b[at..at + 8].
fn get_u64(b: &Bytes, at: u64) -> u64
  requires at + 8 <= blen(b)
{
  return load_le64(b, at);
}

/// Stores v at b[at..at + 8], little-endian.
fn put_u64(b: &mut Bytes, at: u64, v: u64)
  requires at + 8 <= blen(b)
  ensures blen(b) == old(blen(b))
{
  store_le64(&mut b, at, v);
}

/// Sets b[from..to] to zero.
fn zero(b: &mut Bytes, from: u64, to: u64)
  requires to <= blen(b)
  ensures blen(b) == old(blen(b))
{
  if from >= to {
    return;
  }
  // One zero byte, then the zeros so far copied after themselves: the run
  // doubles with each copy.
  bset(&mut b, from, 0);
  let l = blen(b);
  let mut len = 1;
  while len < to - from
    invariant 1 <= len && from + len <= to && to <= l && blen(b) == l
  {
    let c = smaller(len, to - from - len);
    bmove(&mut b, from + len, from, c);
    len = len + c;
  }
}

// ---------------------------------------------------------------- blocks

/// Reads sector `lba` into out[at..at + SECTOR].
fn sec_in(dev: &mut Blk, sec: &mut Bytes, lba: u64, out: &mut Bytes, at: u64) -> bool
  requires blk_ok(dev) && blen(sec) == SECTOR && at + SECTOR <= blen(out)
  ensures blk_ok(dev) && blen(sec) == SECTOR && blen(out) == old(blen(out))
{
  if !blk_read(&mut dev, lba, &mut sec) {
    return false;
  }
  bcopy(&mut out, at, sec, 0, SECTOR);
  return true;
}

/// Writes src[at..at + SECTOR] to sector `lba`.
fn sec_out(dev: &mut Blk, sec: &mut Bytes, lba: u64, src: &Bytes, at: u64) -> bool
  requires blk_ok(dev) && blen(sec) == SECTOR && at + SECTOR <= blen(src)
  ensures blk_ok(dev) && blen(sec) == SECTOR
{
  bcopy(&mut sec, 0, src, at, SECTOR);
  return blk_write(&mut dev, lba, sec);
}

/// Reads block b into out, or zeros for b == 0 (a hole), with one disk
/// command.
fn block_in(dev: &mut Blk, sec: &mut Bytes, b: u64, out: &mut Bytes) -> bool
  requires blk_ok(dev) && blen(sec) == SECTOR && blen(out) == BLOCK && b < MAX_BLOCKS
  ensures blk_ok(dev) && blen(sec) == SECTOR && blen(out) == BLOCK
{
  if b == 0 {
    zero(&mut out, 0, BLOCK);
    return true;
  }
  return blk_read_block(&mut dev, b * BSECT, &mut out, 0);
}

/// Writes src (BLOCK bytes) to block b with one disk command, and flushes
/// the drive's cache, so it is on the disk before any later write.
fn block_out(dev: &mut Blk, sec: &mut Bytes, b: u64, src: &Bytes) -> bool
  requires blk_ok(dev) && blen(sec) == SECTOR && blen(src) == BLOCK && b < MAX_BLOCKS
  ensures blk_ok(dev) && blen(sec) == SECTOR
{
  return blk_write_block(&mut dev, b * BSECT, src, 0);
}

/// The block number at m[at..at + 8], or 0 for a hole or a number that is
/// not a data block on this disk.
fn ptr_in(d: &DiskFs, m: &Bytes, at: u64) -> u64
  requires disk_ok(d) && at + 8 <= blen(m)
  ensures result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS)
{
  let p = get_u64(m, at);
  if p >= DATA_B0 && p < d.blocks {
    return p;
  }
  return 0;
}

/// Takes a free block. Returns it, or 0 if the disk is full.
fn alloc_block(d: &mut DiskFs) -> u64
  requires disk_ok(d)
  ensures disk_ok(d) && (result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS))
{
  let n = d.blocks;
  if n <= DATA_B0 {
    return 0;
  }
  let mut start = d.hint;
  if start < DATA_B0 || start >= n {
    start = DATA_B0;
  }
  let mut b = start;
  while b < n
    invariant b >= DATA_B0 && b <= n && n <= MAX_BLOCKS && disk_ok(d)
  {
    if bget(d.used, b) == 0 {
      bset(&mut d.used, b, 1);
      d.hint = b + 1;
      dq_forget(&mut d.q, b);
      return b;
    }
    b = b + 1;
  }
  b = DATA_B0;
  while b < start && b < n
    invariant b >= DATA_B0 && n <= MAX_BLOCKS && disk_ok(d)
  {
    if bget(d.used, b) == 0 {
      bset(&mut d.used, b, 1);
      d.hint = b + 1;
      dq_forget(&mut d.q, b);
      return b;
    }
    b = b + 1;
  }
  return 0;
}

// ---------------------------------------------------------------- the queue

/// Moves the disk's command queue along without waiting (see
/// src/diskq.bastio), freeing the blocks finished transactions gave up.
/// True if anything happened.
fn disk_pump(d: &mut DiskFs, now: u64) -> bool
  requires disk_ok(d)
  ensures disk_ok(d)
{
  let mut moved = false;
  let mut n = 0;
  while n < 2 * NQ + 2
    invariant disk_ok(d)
  {
    let r = dq_pump(&mut d.q, &mut d.dev, now);
    if r == DQ_IDLE {
      return moved;
    }
    if r >= DQ_FREED {
      free_block(&mut d, r - DQ_FREED);
    }
    moved = true;
    n = n + 1;
  }
  return moved;
}

/// Waits until every queued command has finished, for the operations
/// that still do their disk I/O synchronously. A command that never
/// finishes is given up after DQ_SPINS polls (the disk is then dead).
fn disk_drain(d: &mut DiskFs)
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  let mut spins = 0;
  let blocks0 = d.blocks;
  let slots0 = d.slots;
  while !dq_idle(d.q) && spins < DQ_SPINS + 2 * NQ + 2
    invariant disk_ok(d) && d.blocks == blocks0 && d.slots == slots0
  {
    let mut now = 0;
    if spins >= DQ_SPINS && d.q.since < 0x4000000000000000 {
      now = d.q.since + DQ_TICKS + 1;
    }
    let r = dq_pump(&mut d.q, &mut d.dev, now);
    if r >= DQ_FREED {
      free_block(&mut d, r - DQ_FREED);
    }
    spins = spins + 1;
  }
}

/// Gives block b back (nothing for 0).
fn free_block(d: &mut DiskFs, b: u64)
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  if b >= DATA_B0 && b < MAX_BLOCKS {
    bset(&mut d.used, b, 0);
  }
}

/// Marks every block of the file with root map r as in use (u = 1) or
/// free (u = 0). A map that cannot be read is skipped: its blocks stay as
/// they were (in use until the next mount, if they were).
fn walk(d: &mut DiskFs, r: u64, u: u8)
  requires disk_ok(d) && r >= DATA_B0 && r < MAX_BLOCKS
  ensures disk_ok(d)
{
  bset(&mut d.used, r, u);
  walk_from(&mut d, r, 0, u);
}

/// Marks the blocks under entries `from`.. of root map r (not r itself).
fn walk_from(d: &mut DiskFs, r: u64, from: u64, u: u8)
  requires disk_ok(d) && r >= DATA_B0 && r < MAX_BLOCKS
  ensures disk_ok(d)
{
  if from >= PTRS || !block_in(&mut d.dev, &mut d.sec, r, &mut d.root) {
    return;
  }
  let mut j = from;
  while j < PTRS
    invariant j <= PTRS && disk_ok(d)
  {
    let l = ptr_in(d, d.root, 8 * j);
    if l != 0 {
      bset(&mut d.used, l, u);
      if block_in(&mut d.dev, &mut d.sec, l, &mut d.la) {
        let mut k = 0;
        while k < PTRS
          invariant k <= PTRS && disk_ok(d)
        {
          let p = ptr_in(d, d.la, 8 * k);
          if p != 0 {
            bset(&mut d.used, p, u);
          }
          k = k + 1;
        }
      }
    }
    j = j + 1;
  }
}

// ---------------------------------------------------------------- mounting

/// The disk block that holds block db of the directory, or 0 if it has
/// none yet.
fn dir_block(d: &DiskFs, db: u64) -> u64
  requires disk_ok(d) && db < DIR_BLOCKS
  ensures result == 0 || (result >= 1 && result < MAX_BLOCKS)
{
  if db < DIR_FIXED {
    return DIR_LBA / BSECT + db;
  }
  return ptr_in(d, d.sb, 8 * db);
}

/// Writes directory sector s (0 to DIR_SECTORS - 1) to the disk.
fn dir_flush(d: &mut DiskFs, s: u64) -> bool
  requires disk_ok(d) && s < DIR_SECTORS
  ensures disk_ok(d)
{
  let b = dir_block(d, s / BSECT);
  if b == 0 {
    return false;
  }
  return sec_out(&mut d.dev, &mut d.sec, b * BSECT + s % BSECT, d.dir, s * SECTOR);
}

/// Adds a block to the directory (DPB more entries): the block, zeroed,
/// is written and flushed before the superblock names it. False if the
/// directory is at DSLOTS, the disk is full, or a write fails.
fn dir_grow(d: &mut DiskFs) -> bool
  requires disk_ok(d)
  ensures disk_ok(d) && d.slots <= DSLOTS
{
  if d.slots < DIR_FIXED * DPB || d.slots >= DSLOTS {
    return false;
  }
  let db = d.slots / DPB;
  let b = alloc_block(&mut d);
  if b == 0 {
    return false;
  }
  zero(&mut d.dir, db * BLOCK, db * BLOCK + BLOCK);
  if !blk_write_block(&mut d.dev, b * BSECT, d.dir, db * BLOCK) {
    free_block(&mut d, b);
    return false;
  }
  put_u64(&mut d.sb, 8 * db, b);
  if !blk_write(&mut d.dev, 0, d.sb) {
    // The disk may or may not have the new superblock: b stays in use
    // (until the next mount), so it never holds anything else meanwhile.
    put_u64(&mut d.sb, 8 * db, 0);
    return false;
  }
  d.slots = DPB * (db + 1);
  return true;
}

/// Writes entry i (it shares a sector only with its neighbour).
fn ent_flush(d: &mut DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  return dir_flush(&mut d, i / 2);
}

const BLANK_SECTORS: u64 = 34;      // a protective MBR, then GPT's header and its 32 sectors of entries

/// Are the first and the last BLANK_SECTORS of the disk's `n` sectors all
/// zeros (or unreadable: then the disk is not used either)?
fn disk_blank(dev: &mut Blk, sec: &mut Bytes, n: u64) -> bool
  requires blk_ok(dev) && blen(sec) == SECTOR
  ensures blk_ok(dev) && blen(sec) == SECTOR
{
  let mut i = 0;
  while i < 2 * BLANK_SECTORS
    invariant blk_ok(dev) && blen(sec) == SECTOR
  {
    let mut lba = i;
    if i >= BLANK_SECTORS && n >= 2 * BLANK_SECTORS {
      lba = n - 2 * BLANK_SECTORS + i;
    }
    if !blk_read(&mut dev, lba, &mut sec) {
      return false;
    }
    let mut k = 0;
    while k < SECTOR
      invariant k <= SECTOR && blen(sec) == SECTOR && blk_ok(dev)
    {
      if bget(sec, k) != 0 {
        return false;
      }
      k = k + 1;
    }
    i = i + 1;
  }
  return true;
}

/// Mounts the disk, formatting it if it has no file system yet and is
/// blank (else it is left alone: `foreign`), and works out which blocks
/// are in use. Without a disk (or one too small) the file
/// system has no entries and every operation on it fails.
fn disk_mount(dev: Blk) -> DiskFs
  requires blk_ok(dev)
  ensures disk_ok(result)
{
  let mut d = DiskFs { dev: dev, dir: balloc(DIR_BYTES), sb: balloc(SECTOR), sec: balloc(SECTOR), root: balloc(BLOCK),
    la: balloc(BLOCK), lb: balloc(BLOCK), data: balloc(BLOCK), d2: balloc(BLOCK), q: dq_new(), txn: 0,
    used: balloc(MAX_BLOCKS), blocks: 0, slots: 0, hint: DATA_B0, foreign: false };
  let mut n = blk_sectors(d.dev) / BSECT;
  if n > MAX_BLOCKS {
    n = MAX_BLOCKS;
  }
  if n < DATA_B0 + 16 || !blk_read(&mut d.dev, 0, &mut d.sec) {
    return d;
  }
  d.blocks = n;
  let magic = get_u64(d.sec, 0);
  if magic == DISK_MAGIC || magic == DISK_MAGIC2 {
    // The fixed blocks, then each block the superblock names, in order,
    // up to the first it does not (a block number off the data area ends
    // the directory there too; test/fsck.py reports it).
    let mut s = 0;
    while s < DIR_FIXED * BSECT
      invariant s <= DIR_FIXED * BSECT && disk_ok(d)
    {
      if !sec_in(&mut d.dev, &mut d.sec, DIR_LBA + s, &mut d.dir, s * SECTOR) {
        d.blocks = 0;
        return d;
      }
      s = s + 1;
    }
    if magic == DISK_MAGIC {
      if !blk_read(&mut d.dev, 0, &mut d.sb) {
        d.blocks = 0;
        return d;
      }
    } else {
      put_u64(&mut d.sb, 0, DISK_MAGIC);    // an older disk: no more blocks, the new magic
      if !blk_write(&mut d.dev, 0, d.sb) {
        d.blocks = 0;
        return d;
      }
    }
    let mut db = DIR_FIXED;
    while db < DIR_BLOCKS && dir_block(d, db) != 0
      invariant db >= DIR_FIXED && db <= DIR_BLOCKS && disk_ok(d)
    {
      let b = dir_block(d, db);
      if !blk_read_block(&mut d.dev, b * BSECT, &mut d.dir, db * BLOCK) {
        d.blocks = 0;
        return d;
      }
      bset(&mut d.used, b, 1);
      db = db + 1;
    }
    d.slots = DPB * db;
    if db < DIR_BLOCKS {
      zero(&mut d.sb, 8 * db, SECTOR);      // forget any blocks named past a gap
    }
  } else {
    // Format, but only a blank disk. Anything in its first or last
    // BLANK_SECTORS sectors (an MBR or GPT partition table, GPT's backup
    // copy at the end, a boot sector, another file system's superblock)
    // means the disk is someone else's: on a real machine, the one with
    // its owner's operating system on it. It is not touched.
    let all = blk_sectors(d.dev);
    if !disk_blank(&mut d.dev, &mut d.sec, all) {
      d.blocks = 0;
      d.foreign = true;
      return d;
    }
    // Format: an empty directory (balloc zeroes it), then the superblock.
    d.slots = DIR_FIXED * DPB;
    let mut s = 0;
    while s < DIR_FIXED * BSECT
      invariant s <= DIR_FIXED * BSECT && disk_ok(d)
    {
      if !dir_flush(&mut d, s) {
        d.blocks = 0;
        d.slots = 0;
        return d;
      }
      s = s + 1;
    }
    put_u64(&mut d.sb, 0, DISK_MAGIC);
    if !blk_write(&mut d.dev, 0, d.sb) {
      d.blocks = 0;
      d.slots = 0;
      return d;
    }
  }
  zero(&mut d.dir, DTOP * DENT, DTOP * DENT + DENT);   // entry 64 is never used
  let slots = d.slots;
  d.slots = 0;                                         // until the checks below are done
  let mut i = 0;
  while i < DSLOTS
    invariant i <= DSLOTS && disk_ok(d)
  {
    if bget(d.dir, i * DENT + E_KIND) == 1 {
      let r = ptr_in(d, d.dir, i * DENT + E_ROOT);
      if r != 0 {
        walk(&mut d, r, 1);
      }
    } else if cast[u64](bget(d.dir, i * DENT + E_KIND)) == K_ORPHAN {
      // Removed while open, then the power went: nothing has it open now.
      // Its blocks stay unmarked, so they are free.
      bset(&mut d.dir, i * DENT + E_KIND, 0);
      dir_flush(&mut d, i / 2);
    }
    i = i + 1;
  }
  // A hard link must name a file under another name. A power cut can
  // leave one naming a free entry (while the file was removed), or one
  // whose file has already taken its name (disk_take_name): it goes.
  i = 0;
  while i < DSLOTS
    invariant i <= DSLOTS && disk_ok(d)
  {
    if cast[u64](bget(d.dir, i * DENT + E_KIND)) == K_LINK {
      let t = get_u64(d.dir, i * DENT + E_LINK);
      if t >= DSLOTS || bget(d.dir, t * DENT + E_KIND) != 1 || same_name(d, i, t) {
        bset(&mut d.dir, i * DENT + E_KIND, 0);
        dir_flush(&mut d, i / 2);
      }
    }
    i = i + 1;
  }
  d.slots = slots;
  return d;
}

/// Unmounts the disk and hands back its driver (at power off), once every
/// queued command has finished.
fn disk_unmount(d: DiskFs) -> Blk
  requires disk_ok(d)
  ensures blk_ok(result)
{
  let mut e = d;
  disk_drain(&mut e);
  return disk_unmount_now(e);
}

fn disk_unmount_now(d: DiskFs) -> Blk
  requires disk_ok(d)
  ensures blk_ok(result)
{
  dq_free(d.q);
  bfree(d.d2);
  bfree(d.dir);
  bfree(d.sb);
  bfree(d.sec);
  bfree(d.root);
  bfree(d.la);
  bfree(d.lb);
  bfree(d.data);
  bfree(d.used);
  return d.dev;
}

// ---------------------------------------------------------------- the directory

/// Is entry i in use: a file, a directory, or an orphan (a file removed
/// while still open, which keeps its data until the last close)?
fn dent_used(d: &DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
{
  let k = cast[u64](bget(d.dir, i * DENT));
  return i < d.slots && (k == 1 || k == 2 || k == K_ORPHAN || k == K_LINK);
}

/// Does entry i have a name (a file, a directory or a hard link, not an
/// orphan)?
fn dent_live(d: &DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
{
  let k = cast[u64](bget(d.dir, i * DENT));
  return i < d.slots && (k == 1 || k == 2 || k == K_LINK);
}

/// Is entry i an orphan?
fn dent_orphan(d: &DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
{
  return i < d.slots && cast[u64](bget(d.dir, i * DENT)) == K_ORPHAN;
}

/// Takes entry i's name away but keeps its data, while it is open: one
/// sector write. disk_remove frees it at the last close, and a mount
/// frees any a power cut left behind.
fn disk_orphan(d: &mut DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  if bget(d.dir, i * DENT) != 1 {
    return false;
  }
  bset(&mut d.dir, i * DENT + E_KIND, cast[u8](K_ORPHAN));
  if !ent_flush(&mut d, i) {
    bset(&mut d.dir, i * DENT + E_KIND, 1);
    return false;
  }
  return true;
}

/// Is entry i a directory?
fn dent_dir(d: &DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
{
  return i < d.slots && bget(d.dir, i * DENT) == 2;
}

/// Field f (a u64) of entry i.
fn dent_get(d: &DiskFs, i: u64, f: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && f + 8 <= E_NAME
{
  return get_u64(d.dir, i * DENT + f);
}

/// Sets field f of entry i in memory (ent_flush writes it).
fn dent_set(d: &mut DiskFs, i: u64, f: u64, x: u64)
  requires disk_ok(d) && i < DSLOTS && f + 8 <= E_NAME
  ensures disk_ok(d)
{
  put_u64(&mut d.dir, i * DENT + f, x);
}

/// The directory entry i is in: another entry, or DTOP.
fn dent_parent(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
{
  return dent_get(d, i, E_PARENT);
}

/// Entry i's root map block, or 0.
fn dent_root(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS)
{
  return ptr_in(d, d.dir, i * DENT + E_ROOT);
}

fn disk_size(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures result <= DFILE_MAX || result == NO_DISK_FILE
{
  if !dent_used(d, i) {
    return NO_DISK_FILE;
  }
  let s = dent_get(d, i, E_SIZE);
  if s > DFILE_MAX {
    return DFILE_MAX;           // a damaged entry: never read past the maps
  }
  return s;
}

/// Is entry i named name[from..from + n] (one component)?
fn dent_named(d: &DiskFs, i: u64, name: &Bytes, from: u64, n: u64) -> bool
  requires disk_ok(d) && i < DSLOTS && from + n <= blen(name)
{
  if !dent_live(d, i) || cast[u64](bget(d.dir, i * DENT + E_NLEN)) != n || n > DNAME_MAX {
    return false;
  }
  let mut k = 0;
  while k < n
    invariant k <= n
  {
    if bget(d.dir, i * DENT + E_NAME + k) != bget(name, from + k) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

/// The entry in directory p named name[from..from + n], or DSLOTS.
fn disk_child(d: &DiskFs, p: u64, name: &Bytes, from: u64, n: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name)
  ensures result <= DSLOTS
{
  let mut i = 0;
  while i < d.slots
    invariant i <= d.slots && d.slots <= DSLOTS
  {
    if dent_named(d, i, name, from, n) && dent_parent(d, i) == p {
      return i;
    }
    i = i + 1;
  }
  return DSLOTS;
}

/// Is anything in directory p?
fn disk_has_children(d: &DiskFs, p: u64) -> bool
  requires disk_ok(d)
{
  let mut i = 0;
  while i < d.slots
    invariant i <= d.slots && d.slots <= DSLOTS
  {
    if dent_live(d, i) && dent_parent(d, i) == p {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// The entry at the path name[from..from + n] (components separated by
/// "/", from the top directory), or DSLOTS.
fn disk_find(d: &DiskFs, name: &Bytes, from: u64, n: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name)
  ensures result <= DSLOTS
{
  let end = from + n;
  let mut p = DTOP;
  let mut s = from;
  while s < end
    invariant from <= s && s <= end
  {
    let mut e = s;
    while e < end && bget(name, e) != 47
      invariant s <= e && e <= end
    {
      e = e + 1;
    }
    let c = disk_child(d, p, name, s, e - s);
    if c >= DSLOTS {
      return DSLOTS;
    }
    if e == end {
      return c;
    }
    if !dent_dir(d, c) {
      return DSLOTS;
    }
    p = c;
    s = e + 1;
  }
  return DSLOTS;
}

/// Creates an empty file (or directory) at the path name[from..from + n].
/// Its directory must exist, its last component be 1 to DNAME_MAX bytes,
/// and the name be free. Returns the entry or DSLOTS.
fn disk_create(d: &mut DiskFs, name: &Bytes, from: u64, n: u64, dir: bool, now: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name)
  ensures disk_ok(d) && result <= DSLOTS
{
  return disk_entry(&mut d, name, from, n, dir, DSLOTS, now);
}

/// Creates a hard link at the path name[from..from + n] to file entry t
/// (the caller checks it is one), as disk_create does a file: one sector
/// write. Returns the new entry, or DSLOTS.
fn disk_link(d: &mut DiskFs, name: &Bytes, from: u64, n: u64, t: u64, now: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name) && t < DSLOTS
  ensures disk_ok(d) && result <= DSLOTS
{
  return disk_entry(&mut d, name, from, n, false, t, now);
}

/// The file entry that entry i is a hard link to, or DSLOTS if it is not
/// one.
fn disk_link_of(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures result <= DSLOTS
{
  if i >= d.slots || cast[u64](bget(d.dir, i * DENT)) != K_LINK {
    return DSLOTS;
  }
  let t = dent_get(d, i, E_LINK);
  if t >= DSLOTS {
    return DSLOTS;
  }
  return t;
}

/// A hard link to entry t, or DSLOTS if there is none.
fn disk_link_to(d: &DiskFs, t: u64) -> u64
  requires disk_ok(d)
  ensures result <= DSLOTS
{
  let mut i = 0;
  while i < DSLOTS
    invariant i <= DSLOTS
  {
    if disk_link_of(d, i) == t {
      return i;
    }
    i = i + 1;
  }
  return DSLOTS;
}

/// How many hard links name entry t, besides its own name.
fn disk_links(d: &DiskFs, t: u64) -> u64
  requires disk_ok(d)
  ensures result <= DSLOTS
{
  let mut c = 0;
  let mut i = 0;
  while i < DSLOTS
    invariant i <= DSLOTS && c <= i
  {
    if disk_link_of(d, i) == t {
      c = c + 1;
    }
    i = i + 1;
  }
  return c;
}

/// Do entries i and t have the same parent and last component?
fn same_name(d: &DiskFs, i: u64, t: u64) -> bool
  requires disk_ok(d) && i < DSLOTS && t < DSLOTS
{
  if dent_get(d, i, E_PARENT) != dent_get(d, t, E_PARENT) || bget(d.dir, i * DENT + E_NLEN) != bget(d.dir, t * DENT + E_NLEN) {
    return false;
  }
  let mut j = 0;
  while j < DENT - E_NAME
    invariant j <= DENT - E_NAME
  {
    if bget(d.dir, i * DENT + E_NAME + j) != bget(d.dir, t * DENT + E_NAME + j) {
      return false;
    }
    j = j + 1;
  }
  return true;
}

/// File entry i takes the name (parent and last component) of hard link l,
/// which names it, and l goes: how a file that has links loses its own
/// name. The commit is the one sector write of i's entry; l's removal is a
/// second write unless both share a sector. A power cut between them
/// leaves l naming i under i's new name, which the next mount drops, so
/// either the old state or the new one survives.
fn disk_take_name(d: &mut DiskFs, i: u64, l: u64) -> bool
  requires disk_ok(d) && i < DSLOTS && l < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  if i == l || i >= d.slots || bget(d.dir, i * DENT) != 1 || disk_link_of(d, l) != i {
    return false;
  }
  let mut save = balloc(DENT);
  let mut j = 0;
  while j < DENT
    invariant j <= DENT && blen(save) == DENT && disk_ok(d)
  {
    bset(&mut save, j, bget(d.dir, i * DENT + j));
    j = j + 1;
  }
  dent_set(&mut d, i, E_PARENT, dent_get(d, l, E_PARENT));
  bset(&mut d.dir, i * DENT + E_NLEN, bget(d.dir, l * DENT + E_NLEN));
  j = E_NAME;
  while j < DENT
    invariant j <= DENT && disk_ok(d)
  {
    bset(&mut d.dir, i * DENT + j, bget(d.dir, l * DENT + j));
    j = j + 1;
  }
  let shared = i / 2 == l / 2;       // two entries to a sector
  if shared {
    bset(&mut d.dir, l * DENT + E_KIND, 0);
  }
  if !ent_flush(&mut d, i) {
    j = 0;
    while j < DENT
      invariant j <= DENT && blen(save) == DENT && disk_ok(d)
    {
      bset(&mut d.dir, i * DENT + j, bget(save, j));
      j = j + 1;
    }
    if shared {
      bset(&mut d.dir, l * DENT + E_KIND, cast[u8](K_LINK));
    }
    bfree(save);
    return false;
  }
  bfree(save);
  if !shared {
    bset(&mut d.dir, l * DENT + E_KIND, 0);
    ent_flush(&mut d, l);               // if this fails, the next mount drops l
  }
  return true;
}

/// disk_create, or a hard link to entry `link` when it is below DSLOTS.
fn disk_entry(d: &mut DiskFs, name: &Bytes, from: u64, n: u64, dir: bool, link: u64, now: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name)
  ensures disk_ok(d) && result <= DSLOTS
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  let end = from + n;
  let mut k = end;
  while k > from && bget(name, k - 1) != 47
    invariant from <= k && k <= end
  {
    k = k - 1;
  }
  let mut p = DTOP;
  if k > from {
    p = disk_find(d, name, from, k - 1 - from);
    if p >= DSLOTS || !dent_dir(d, p) {
      return DSLOTS;
    }
  }
  let l = end - k;
  if l == 0 || l > DNAME_MAX || disk_child(d, p, name, k, l) < DSLOTS {
    return DSLOTS;
  }
  let mut i = 0;
  while i < DSLOTS
    invariant i <= DSLOTS && disk_ok(d)
  {
    if i == d.slots && !dir_grow(&mut d) {
      return DSLOTS;                    // the directory is full, or so is the disk
    }
    if i != DTOP && !dent_used(d, i) {
      zero(&mut d.dir, i * DENT, i * DENT + DENT);
      if dir {
        bset(&mut d.dir, i * DENT + E_KIND, 2);
        dent_set(&mut d, i, E_MODE, MODE_DIR);
      } else if link < DSLOTS {
        bset(&mut d.dir, i * DENT + E_KIND, cast[u8](K_LINK));
        dent_set(&mut d, i, E_LINK, link);
      } else {
        bset(&mut d.dir, i * DENT + E_KIND, 1);
        dent_set(&mut d, i, E_MODE, MODE_FILE);
      }
      bset(&mut d.dir, i * DENT + E_NLEN, cast[u8](l));
      dent_set(&mut d, i, E_PARENT, p);
      dent_set(&mut d, i, E_MTIME, now);
      let mut j = 0;
      while j < l
        invariant j <= l && disk_ok(d)
      {
        bset(&mut d.dir, i * DENT + E_NAME + j, bget(name, k + j));
        j = j + 1;
      }
      if !ent_flush(&mut d, i) {
        bset(&mut d.dir, i * DENT + E_KIND, 0);
        return DSLOTS;
      }
      return i;
    }
    i = i + 1;
  }
  return DSLOTS;
}

/// Moves entry i to the path name[from..from + n]: its directory must
/// exist and not be i or inside i, its last component be 1 to DNAME_MAX
/// bytes, and the name be free. One sector write, so a power cut leaves
/// the old name or the new one.
fn disk_move(d: &mut DiskFs, i: u64, name: &Bytes, from: u64, n: u64) -> bool
  requires disk_ok(d) && i < DSLOTS && from + n <= blen(name)
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  if !dent_live(d, i) {
    return false;
  }
  let end = from + n;
  let mut k = end;
  while k > from && bget(name, k - 1) != 47
    invariant from <= k && k <= end
  {
    k = k - 1;
  }
  let mut p = DTOP;
  if k > from {
    p = disk_find(d, name, from, k - 1 - from);
    if p >= DSLOTS || !dent_dir(d, p) {
      return false;
    }
  }
  let l = end - k;
  if l == 0 || l > DNAME_MAX || disk_child(d, p, name, k, l) < DSLOTS {
    return false;
  }
  // The new directory, and each one above it, must not be i.
  let mut c = p;
  let mut steps = 0;
  while c < DSLOTS && c != DTOP && steps <= DSLOTS
    invariant steps <= DSLOTS + 1
  {
    if c == i {
      return false;
    }
    c = dent_parent(d, c);
    steps = steps + 1;
  }
  let mut save = balloc(DENT);
  let mut j = 0;
  while j < DENT
    invariant j <= DENT && blen(save) == DENT && disk_ok(d)
  {
    bset(&mut save, j, bget(d.dir, i * DENT + j));
    j = j + 1;
  }
  dent_set(&mut d, i, E_PARENT, p);
  bset(&mut d.dir, i * DENT + E_NLEN, cast[u8](l));
  zero(&mut d.dir, i * DENT + E_NAME, i * DENT + DENT);
  j = 0;
  while j < l
    invariant j <= l && disk_ok(d)
  {
    bset(&mut d.dir, i * DENT + E_NAME + j, bget(name, k + j));
    j = j + 1;
  }
  let ok = ent_flush(&mut d, i);
  if !ok {
    // As after a failed write: memory keeps the old name.
    j = 0;
    while j < DENT
      invariant j <= DENT && blen(save) == DENT && disk_ok(d)
    {
      bset(&mut d.dir, i * DENT + j, bget(save, j));
      j = j + 1;
    }
  }
  bfree(save);
  return ok;
}

/// Removes entry i (a file, or an empty directory: the caller checks).
fn disk_remove(d: &mut DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  let r = dent_root(d, i);
  let file = bget(d.dir, i * DENT + E_KIND) == 1 || cast[u64](bget(d.dir, i * DENT + E_KIND)) == K_ORPHAN;
  bset(&mut d.dir, i * DENT + E_KIND, 0);
  if !ent_flush(&mut d, i) {
    return false;
  }
  if file && r != 0 {
    walk(&mut d, r, 0);
  }
  return true;
}

/// Copies the last component of entry i's name into buf from `at`.
/// Returns its length, or NO_DISK_FILE if the entry is free or buf too
/// short.
fn disk_comp(d: &DiskFs, i: u64, buf: &mut Bytes, at: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures blen(buf) == old(blen(buf))
  ensures result == NO_DISK_FILE || (at <= blen(buf) && result <= blen(buf) - at && result <= DNAME_MAX)
{
  if !dent_live(d, i) {
    return NO_DISK_FILE;
  }
  let n = cast[u64](bget(d.dir, i * DENT + E_NLEN));
  if n > DNAME_MAX || at > blen(buf) || n > blen(buf) - at {
    return NO_DISK_FILE;
  }
  let l = blen(buf);
  let mut k = 0;
  while k < n
    invariant k <= n && blen(buf) == l
  {
    bset(&mut buf, at + k, bget(d.dir, i * DENT + E_NAME + k));
    k = k + 1;
  }
  return n;
}

/// Copies the whole path of entry i (from the top directory, without
/// "disk/") into buf from `at`. Returns its length, or NO_DISK_FILE if the
/// entry is free, its parents are damaged, or buf is too short.
fn disk_name(d: &DiskFs, i: u64, buf: &mut Bytes, at: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures blen(buf) == old(blen(buf))
  ensures result == NO_DISK_FILE || (at <= blen(buf) && result <= blen(buf) - at)
{
  // First the length: the components and a "/" before each but the first.
  let mut total = 0;
  let mut c = i;
  let mut steps = 0;
  while c < DSLOTS && c != DTOP
    invariant steps <= DSLOTS && total <= steps * (DNAME_MAX + 1)
  {
    let l = cast[u64](bget(d.dir, c * DENT + E_NLEN));
    if !dent_live(d, c) || l == 0 || l > DNAME_MAX || steps == DSLOTS {
      return NO_DISK_FILE;      // free, damaged, or a cycle
    }
    total = total + l + 1;
    steps = steps + 1;
    c = dent_parent(d, c);
  }
  if c != DTOP || total == 0 || at > blen(buf) || total - 1 > blen(buf) - at {
    return NO_DISK_FILE;
  }
  total = total - 1;
  // Then the components, from the last one back.
  let bl = blen(buf);
  let mut e = at + total;
  c = i;
  while c < DSLOTS && c != DTOP && e > at
    invariant at <= e && e <= bl && blen(buf) == bl
  {
    let l = cast[u64](bget(d.dir, c * DENT + E_NLEN));
    if l > e - at || l > DNAME_MAX {
      return NO_DISK_FILE;
    }
    let mut k = 0;
    while k < l
      invariant k <= l && blen(buf) == bl
    {
      bset(&mut buf, e - l + k, bget(d.dir, c * DENT + E_NAME + k));
      k = k + 1;
    }
    e = e - l;
    if e > at {
      e = e - 1;
      bset(&mut buf, e, 47);
    }
    c = dent_parent(d, c);
  }
  return total;
}

// ---------------------------------------------------------------- data

/// The block holding block b of the file with root map `root`: 0 for a
/// hole, DISK_MISS if a map it needs is not in the cache yet (a read of it
/// is queued, or will be once the queue has room).
fn data_ptr(d: &mut DiskFs, root: u64, b: u64) -> u64
  requires disk_ok(d) && b < PTRS * PTRS
  ensures disk_ok(d)
  ensures result == DISK_MISS || result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS)
{
  if root < DATA_B0 || root >= MAX_BLOCKS {
    return 0;
  }
  let s = dq_want(&mut d.q, root);
  if s >= NC {
    return DISK_MISS;
  }
  let l = ptr_in(d, d.q.cache, s * BLOCK + 8 * (b / PTRS));
  if l == 0 {
    return 0;
  }
  let t = dq_want(&mut d.q, l);
  if t >= NC {
    return DISK_MISS;
  }
  return ptr_in(d, d.q.cache, t * BLOCK + 8 * (b % PTRS));
}

/// Reads up to n bytes of the file in entry i from offset `off` into the
/// start of buf, from the block cache. Returns the count, short at the end
/// of the file; NO_DISK_FILE if there is no such file or the disk is dead;
/// or DISK_MISS if some of it is not in the cache: reads of what is missing
/// (and of the next few blocks) are queued, and the caller tries again once
/// the queue has moved.
fn disk_read(d: &mut DiskFs, i: u64, off: u64, buf: &mut Bytes, n: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf)
  ensures disk_ok(d) && blen(buf) == old(blen(buf))
  ensures result <= n || result == NO_DISK_FILE || result == DISK_MISS
{
  let size = disk_size(d, i);
  if size == NO_DISK_FILE || d.q.dead {
    return NO_DISK_FILE;
  }
  if off >= size {
    return 0;
  }
  let mut want = size - off;
  if want > n {
    want = n;
  }
  let root = dent_root(d, i);
  let l = blen(buf);
  let mut missing = false;
  let mut k = 0;
  while k < want
    invariant k <= want && want <= n && n <= blen(buf) && blen(buf) == l && disk_ok(d)
    invariant off + want <= DFILE_MAX && want <= size
  {
    let a = off + k;
    let o = a % BLOCK;
    let mut m = BLOCK - o;
    if m > want - k {
      m = want - k;
    }
    let p = data_ptr(&mut d, root, a / BLOCK);
    if p == DISK_MISS {
      missing = true;
    } else if p == 0 {
      zero(&mut buf, k, k + m);
    } else {
      let s = dq_want(&mut d.q, p);
      if s >= NC {
        missing = true;
        read_ahead(&mut d, root, a / BLOCK + 1, size);
      } else {
        bcopy(&mut buf, k, d.q.cache, s * BLOCK + o, m);
      }
    }
    k = k + m;
  }
  if missing {
    return DISK_MISS;
  }
  return want;
}

const READ_AHEAD: u64 = 8;            // blocks queued past one a read missed

/// Queues reads of the file's blocks from block b on (up to READ_AHEAD,
/// within `size` bytes), whose maps are cached already.
fn read_ahead(d: &mut DiskFs, root: u64, b: u64, size: u64)
  requires disk_ok(d) && b <= PTRS * PTRS && size <= DFILE_MAX
  ensures disk_ok(d)
{
  let mut c = 0;
  while c < READ_AHEAD && b + c < PTRS * PTRS && (b + c) * BLOCK < size && d.q.count + 8 < NQ
    invariant disk_ok(d)
  {
    let p = data_ptr(&mut d, root, b + c);
    if p != DISK_MISS && p != 0 {
      dq_want(&mut d.q, p);
    }
    c = c + 1;
  }
}

/// disk_read for callers that cannot sleep (loading a program, mmap):
/// waits for the queue instead.
fn disk_read_wait(d: &mut DiskFs, i: u64, off: u64, buf: &mut Bytes, n: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf)
  ensures disk_ok(d) && blen(buf) == old(blen(buf))
  ensures result <= n || result == NO_DISK_FILE
{
  let mut tries = 0;
  let l = blen(buf);
  while tries < 8
    invariant disk_ok(d) && blen(buf) == l
  {
    let r = disk_read(&mut d, i, off, &mut buf, n);
    if r != DISK_MISS {
      return r;
    }
    disk_drain(&mut d);
    tries = tries + 1;
  }
  return NO_DISK_FILE;
}

/// How many bytes of block b a file of `size` bytes holds.
fn valid_in(size: u64, b: u64) -> u64
  requires b < PTRS * PTRS
  ensures result <= BLOCK
{
  if size <= b * BLOCK {
    return 0;
  }
  if size - b * BLOCK > BLOCK {
    return BLOCK;
  }
  return size - b * BLOCK;
}

/// Copies block b from the cache into `out`, or zeros for b == 0. False
/// if it is not cached (a read of it is queued, or will be).
fn gather(q: &mut DiskQ, b: u64, out: &mut Bytes) -> bool
  requires dq_ok(q) && blen(out) == BLOCK
  ensures dq_ok(q) && blen(out) == BLOCK
{
  if b == 0 {
    zero(&mut out, 0, BLOCK);
    return true;
  }
  let s = dq_want(&mut q, b);
  if s >= NC {
    return false;
  }
  bcopy(&mut out, 0, q.cache, s * BLOCK, BLOCK);
  return true;
}

/// Turns the old data block in `blk` (valid bytes of it) into the new one:
/// zeros above `valid`, then wm bytes of buf[at..] at offset wo.
fn patch(blk: &mut Bytes, valid: u64, buf: &Bytes, at: u64, wo: u64, wm: u64)
  requires blen(blk) == BLOCK && valid <= BLOCK && wo + wm <= BLOCK && at + wm <= blen(buf)
  ensures blen(blk) == BLOCK
{
  zero(&mut blk, valid, BLOCK);
  bcopy(&mut blk, wo, buf, at, wm);
}

/// Queues the release of block b once the transaction ends (nothing for 0).
fn release(q: &mut DiskQ, b: u64)
  requires dq_ok(q)
  ensures dq_ok(q)
{
  if b != 0 {
    dq_release(&mut q, b);
  }
}

/// Writes the first n bytes (at most a block) of buf to the file in entry
/// i at `off`. A gap past the old end reads as zeros. The write happens
/// entirely or not at all, even across a power cut (see the top of this
/// file).
///
/// The disk I/O is queued, not waited for. First every old block the
/// write needs (the maps on its path, and a data block it changes only in
/// part) must be in the cache; if one is not, its read is queued and this
/// returns DISK_MISS, having changed nothing, for the caller to try again
/// once the queue has moved. Then the new blocks go into the cache and the
/// queue: data and maps, a flush, the directory block holding the entry,
/// a flush, the release of the old blocks, and the transaction's end,
/// whose number is left in d.txn for the caller to wait on. Readers see
/// the new contents at once. Returns the count (short only at the 1 GiB
/// limit), 0 if the disk is full or dead, NO_DISK_FILE if there is no
/// file, or DISK_MISS.
fn disk_write(d: &mut DiskFs, i: u64, off: u64, buf: &Bytes, n: u64, now: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf) && n <= BLOCK
  ensures disk_ok(d)
  ensures result <= n || result == NO_DISK_FILE || result == DISK_MISS
{
  let size = disk_size(d, i);
  if size == NO_DISK_FILE || dent_dir(d, i) {
    return NO_DISK_FILE;
  }
  if off >= DFILE_MAX || n == 0 || d.q.dead {
    return 0;
  }
  let mut want = DFILE_MAX - off;
  if want > n {
    want = n;
  }
  let end = off + want;
  let mut newsize = size;
  if end > newsize {
    newsize = end;
  }
  let b0 = off / BLOCK;
  let b1 = (end - 1) / BLOCK;
  let ia = b0 / PTRS;
  let ib = b1 / PTRS;
  let mut m0 = BLOCK - off % BLOCK;
  if m0 > want {
    m0 = want;
  }
  // Gather the maps as they are, and the old data the write keeps.
  let root0 = dent_root(d, i);
  if !gather(&mut d.q, root0, &mut d.root) {
    return DISK_MISS;
  }
  let la0 = ptr_in(d, d.root, 8 * ia);
  let mut lb0 = 0;
  if ib != ia {
    lb0 = ptr_in(d, d.root, 8 * ib);
  }
  let ga = gather(&mut d.q, la0, &mut d.la);
  let gb = gather(&mut d.q, lb0, &mut d.lb);
  if !ga || !gb {
    return DISK_MISS;
  }
  let old0 = ptr_in(d, d.la, 8 * (b0 % PTRS));
  let mut old1 = 0;
  if b1 != b0 {
    if ib == ia {
      old1 = ptr_in(d, d.la, 8 * (b1 % PTRS));
    } else {
      old1 = ptr_in(d, d.lb, 8 * (b1 % PTRS));
    }
  }
  let v0 = valid_in(size, b0);
  let v1 = valid_in(size, b1);
  // A block the write covers wherever it holds data needs no reading.
  let mut keep0 = old0;
  if off % BLOCK == 0 && m0 >= v0 {
    keep0 = 0;
  }
  let mut keep1 = old1;
  if b1 == b0 || want - m0 >= v1 {
    keep1 = 0;
  }
  let g0 = gather(&mut d.q, keep0, &mut d.data);
  let g1 = gather(&mut d.q, keep1, &mut d.d2);
  if !g0 || !g1 {
    return DISK_MISS;
  }
  // Room for six blocks (two data, three maps, the directory block) and
  // fourteen operations, or wait for the queue to move.
  if !dq_fits(d.q, 6, 14) {
    return DISK_MISS;
  }
  let n0 = alloc_block(&mut d);
  let mut n1 = 0;
  if b1 != b0 {
    n1 = alloc_block(&mut d);
  }
  let na = alloc_block(&mut d);
  let mut nb = 0;
  if ib != ia {
    nb = alloc_block(&mut d);
  }
  let nr = alloc_block(&mut d);
  if n0 == 0 || (b1 != b0 && n1 == 0) || na == 0 || (ib != ia && nb == 0) || nr == 0 {
    free_block(&mut d, n0);
    free_block(&mut d, n1);
    free_block(&mut d, na);
    free_block(&mut d, nb);
    free_block(&mut d, nr);
    return 0;
  }
  // The new blocks.
  let mut k0 = 0;
  if keep0 != 0 {
    k0 = v0;
  }
  patch(&mut d.data, k0, buf, 0, off % BLOCK, m0);
  put_u64(&mut d.la, 8 * (b0 % PTRS), n0);
  let mut ok = dq_put(&mut d.q, n0, d.data, 0, true);
  if b1 != b0 {
    let mut k1 = 0;
    if keep1 != 0 {
      k1 = v1;
    }
    patch(&mut d.d2, k1, buf, m0, 0, want - m0);
    if ib == ia {
      put_u64(&mut d.la, 8 * (b1 % PTRS), n1);
    } else {
      put_u64(&mut d.lb, 8 * (b1 % PTRS), n1);
    }
    ok = ok && dq_put(&mut d.q, n1, d.d2, 0, true);
  }
  put_u64(&mut d.root, 8 * ia, na);
  ok = ok && dq_put(&mut d.q, na, d.la, 0, true);
  if ib != ia {
    put_u64(&mut d.root, 8 * ib, nb);
    ok = ok && dq_put(&mut d.q, nb, d.lb, 0, true);
  }
  ok = ok && dq_put(&mut d.q, nr, d.root, 0, true) && dq_flush(&mut d.q);
  // The switch: the entry, in its directory block, after a flush.
  dent_set(&mut d, i, E_SIZE, newsize);
  dent_set(&mut d, i, E_ROOT, nr);
  dent_set(&mut d, i, E_MTIME, now);
  let db = i * DENT / BLOCK;
  let dbn = dir_block(d, db);
  ok = ok && dbn != 0 && dq_put(&mut d.q, dbn, d.dir, db * BLOCK, false) && dq_flush(&mut d.q);
  release(&mut d.q, old0);
  release(&mut d.q, old1);
  release(&mut d.q, la0);
  release(&mut d.q, lb0);
  release(&mut d.q, root0);
  let t = dq_end(&mut d.q);
  if !ok || t == 0 {
    dq_kill(&mut d.q);                // dq_fits said there was room: not reached
    return 0;
  }
  d.txn = t;
  return want;
}

/// disk_write for the operations that still do their I/O synchronously:
/// retries until the blocks are cached, then waits for the transaction.
fn disk_write_wait(d: &mut DiskFs, i: u64, buf: &Bytes, n: u64, now: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf) && n <= BLOCK
  ensures disk_ok(d)
  ensures result <= n || result == NO_DISK_FILE
{
  return disk_write_at_wait(&mut d, i, 0, buf, n, now);
}

/// disk_write_wait at offset off.
fn disk_write_at_wait(d: &mut DiskFs, i: u64, off: u64, buf: &Bytes, n: u64, now: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf) && n <= BLOCK
  ensures disk_ok(d)
  ensures result <= n || result == NO_DISK_FILE
{
  let mut tries = 0;
  while tries < 8
    invariant disk_ok(d)
  {
    let r = disk_write(&mut d, i, off, buf, n, now);
    if r != DISK_MISS {
      disk_drain(&mut d);
      d.txn = 0;
      if d.q.dead {
        return 0;
      }
      return r;
    }
    disk_drain(&mut d);
    tries = tries + 1;
  }
  return NO_DISK_FILE;
}

/// Empties the file in entry i.
fn disk_truncate(d: &mut DiskFs, i: u64, now: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  let r = dent_root(d, i);
  if dent_get(d, i, E_SIZE) == 0 && r == 0 {
    return true;
  }
  dent_set(&mut d, i, E_SIZE, 0);
  dent_set(&mut d, i, E_ROOT, 0);
  dent_set(&mut d, i, E_MTIME, now);
  if !ent_flush(&mut d, i) {
    return false;
  }
  if r != 0 {
    walk(&mut d, r, 0);
  }
  return true;
}

/// Sets the size of the file in entry i to len bytes: growing reads as
/// zeros, shrinking drops the blocks past the end. Like a write, it happens
/// entirely or not at all (one entry-sector switch). It keeps the rule that
/// the bytes past a file's end are zeros and the blocks wholly past it are
/// holes, which is what lets growing only move the end.
fn disk_resize(d: &mut DiskFs, i: u64, size_to: u64, now: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  let size = disk_size(d, i);
  if size == NO_DISK_FILE || dent_dir(d, i) || size_to > DFILE_MAX {
    return false;
  }
  if size_to == 0 {
    return disk_truncate(&mut d, i, now);
  }
  let root0 = dent_root(d, i);
  let size_raw = dent_get(d, i, E_SIZE);
  let root_raw = dent_get(d, i, E_ROOT);
  let mtime_raw = dent_get(d, i, E_MTIME);
  if size_to >= size || root0 == 0 {
    dent_set(&mut d, i, E_SIZE, size_to);
    dent_set(&mut d, i, E_MTIME, now);
    if !ent_flush(&mut d, i) {
      dent_set(&mut d, i, E_SIZE, size_raw);
      dent_set(&mut d, i, E_MTIME, mtime_raw);
      return false;
    }
    return true;
  }
  // Shrinking: copy the last block kept (its tail zeroed), its map, and
  // the root, each cut off after the new end.
  let bl = (size_to - 1) / BLOCK;
  let il = bl / PTRS;
  let kl = bl % PTRS;
  if !block_in(&mut d.dev, &mut d.sec, root0, &mut d.root) {
    return false;
  }
  let la0 = ptr_in(d, d.root, 8 * il);
  if !block_in(&mut d.dev, &mut d.sec, la0, &mut d.la) {
    return false;
  }
  // The old map, to free its tail once the switch is done.
  let mut c = 0;
  while c < BLOCK
    invariant c <= BLOCK && disk_ok(d)
  {
    bset(&mut d.lb, c, bget(d.la, c));
    c = c + 1;
  }
  let prev = ptr_in(d, d.la, 8 * kl);
  let mut nd = prev;
  if prev != 0 && size_to % BLOCK != 0 {
    if !block_in(&mut d.dev, &mut d.sec, prev, &mut d.data) {
      return false;
    }
    zero(&mut d.data, size_to % BLOCK, BLOCK);
    nd = alloc_block(&mut d);
    if nd == 0 {
      return false;
    }
    if !block_out(&mut d.dev, &mut d.sec, nd, d.data) {
      free_block(&mut d, nd);
      return false;
    }
  }
  put_u64(&mut d.la, 8 * kl, nd);
  zero(&mut d.la, 8 * kl + 8, BLOCK);
  let mut na = 0;
  let mut ok = true;
  if la0 != 0 {
    na = alloc_block(&mut d);
    ok = na != 0 && block_out(&mut d.dev, &mut d.sec, na, d.la);
  }
  put_u64(&mut d.root, 8 * il, na);
  zero(&mut d.root, 8 * il + 8, BLOCK);
  let mut nr = 0;
  if ok {
    nr = alloc_block(&mut d);
    ok = nr != 0 && block_out(&mut d.dev, &mut d.sec, nr, d.root);
  }
  if !ok {
    if nd != prev {
      free_block(&mut d, nd);
    }
    free_block(&mut d, na);
    free_block(&mut d, nr);
    return false;
  }
  // The switch: one sector.
  dent_set(&mut d, i, E_SIZE, size_to);
  dent_set(&mut d, i, E_ROOT, nr);
  dent_set(&mut d, i, E_MTIME, now);
  if !ent_flush(&mut d, i) {
    // As in disk_write: keep both trees; the next mount frees the loser.
    dent_set(&mut d, i, E_SIZE, size_raw);
    dent_set(&mut d, i, E_ROOT, root_raw);
    dent_set(&mut d, i, E_MTIME, mtime_raw);
    return false;
  }
  // Free what only the old tree held.
  if nd != prev {
    free_block(&mut d, prev);
  }
  let mut k = kl + 1;
  while k < PTRS
    invariant k <= PTRS + 1 && disk_ok(d)
  {
    free_block(&mut d, ptr_in(d, d.lb, 8 * k));
    k = k + 1;
  }
  free_block(&mut d, la0);
  walk_from(&mut d, root0, il + 1, 0);
  free_block(&mut d, root0);
  return true;
}

/// Entry i's mode (permission bits).
fn disk_mode(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
{
  return dent_get(d, i, E_MODE) % 65536;
}

/// Entry i's modification time, in seconds.
fn disk_mtime(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
{
  return dent_get(d, i, E_MTIME);
}

/// Sets entry i's mode (when `mode` is below 65536) and modification time
/// (when `mtime` is not NO_DISK_FILE): one sector write.
fn disk_set_meta(d: &mut DiskFs, i: u64, mode: u64, mtime: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  if !dent_used(d, i) {
    return false;
  }
  if mode < 65536 {
    dent_set(&mut d, i, E_MODE, mode);
  }
  if mtime != NO_DISK_FILE {
    dent_set(&mut d, i, E_MTIME, mtime);
  }
  return ent_flush(&mut d, i);
}
