// A file system on the disk, so files survive power off. The disk is cut
// into blocks of 4096 bytes (8 sectors):
//
//   block 0          superblock: the magic "BSTDISK3" (or "BSTDISK4"), then where the
//                    rest of the directory is (below)
//   blocks 1..4      directory: entries 0..63, 256 bytes each
//   blocks 5..       file data, the maps that find it, and the rest of
//                    the directory
//
// The directory grows. Its first DIR_FIXED blocks are blocks 1..4; block
// db of it past those (16 entries each, up to DSLOTS entries in all) is
// named by the superblock, at byte 8 * db of its block (db below DIR_SB =
// 512: the superblock's block is full there; its other seven sectors were
// always zeros on a BSTDISK3 disk, so an older disk reads as it did), and
// past that by extension blocks: byte 8 of the superblock names the first,
// word 0 of each names the next, and word w (1 to 511) of extension block e
// names directory block DIR_SB + 511 * e + w - 1 (at most EXT_MAX blocks).
// 0 means none yet. dir_grow adds a block when every entry is taken: the
// new block, all zeros (no entries), is written and flushed, and only then
// the sector that names it (one sector write), so a power cut leaves either
// no new block (and a free block, as nothing names it) or an empty one.
// Blocks are added in order and never taken away. An extension block is
// made the same way (ext_name): written whole while nothing links to it,
// then linked by one sector write, and the first link also changes the
// magic to BSTDISK4, in the same sector, so a kernel that does not know
// the extension sees a disk it does not know and leaves it alone, while
// BSTDISK3 and BSTDISK2 disks (the same, with only the fixed blocks) are
// mounted as they are, the older magic rewritten, and only become
// BSTDISK4 when the directory outgrows 512 blocks. Entry 64 is never used:
// its number is DTOP, which parents name for the top, as they did when the
// directory had exactly 64 entries.
//
// A directory entry is: byte 0 its kind (0 unused, 1 a file, 2 a
// directory, which holds no data, 3 an orphan: a file removed while it
// was open, nameless until its last close), byte 1 its name length, then as
// little-endian u64s: at 8 its parent (another entry, or DTOP for the top
// directory, "disk"), at 16 its size, at 24 its root map block (0 for no
// data), at 32 its mode (the low 16 bits; then its owner's user and group
// ids, 24 bits each, 0 for root), at 40 its modification time; bytes 56..256 its
// name: one path component of up to DNAME_MAX bytes. So a path is a walk
// from the top, component by component, and full paths can be longer than
// any entry. A blank disk is formatted when it is mounted; a disk with
// neither magic that is not blank (a partition table, another system's
// data, a still older format) is left alone, and there is no file system.
//
// A file's data is found through two levels of maps. The root map is one
// block of PTRS block numbers, each naming a first-level map, a block of
// PTRS more naming data blocks; block number 0 is a hole and reads as
// zeros. A file can grow to PTRS * PTRS blocks (1 GiB), as far as the disk
// allows. Which blocks are in use is not on the disk: mounting walks every
// file's maps and rebuilds the table in memory, so there is no free list
// to keep consistent.
//
// Power cuts. Data is never written over in place. A write builds the
// blocks it changes in memory, and new copies of the maps above them, for
// free blocks; consecutive writes to one file share them (see "batches of
// writes" below), and when the batch commits it queues them; then a flush; then the directory block
// holding the file's entry, now with the new root and size (an entry
// never straddles a sector, so its sector is written whole or not at all,
// and the block's other sectors are rewritten unchanged); then a flush.
// The old blocks are freed only after that (src/diskq.bastio runs the
// queue in order). Removing and truncating write only the entry, after
// waiting for the queue to empty. A flush means the drive has the data
// (ATA, AHCI, NVMe: FLUSH CACHE; virtio: the legacy device is
// write-through unless the cache feature is negotiated, and it is not).
// So after a cut anywhere, the file system
// mounts as it was after some prefix of the entry writes: each write call
// has happened entirely or not at all, even one that overwrites bytes in
// the middle of a file across two blocks (a batch counts as one step, so
// a cut loses the writes since the last commit, whole). Not atomic: a format cut short
// (the next mount formats again), and work that takes several calls, such
// as O_TRUNC followed by writes. test/shell_test.sh cuts power during
// user/crashme.bastio six times and checks this.
//
// A damaged disk (two entries naming one block, a cycle of parents) can
// lose data, but never makes the kernel read or write outside its
// buffers: every block number and length read from the disk is checked.

import "blk.bastio";
import "diskq.bastio";
import "smaller.bastio";
import "core/endian.bastio";
import "core/bitmap.bastio";
import "core/bytes.bastio";

const DSLOTS: u64 = 262144;           // directory entries, at most (16384 directory blocks: 512 named by the superblock, the rest by extension blocks)
const BATCH_MAX: u64 = 32;               // blocks a batch of writes makes before it commits (disk_write)
const OB_MAX: u64 = 40;               // blocks it replaces: at most one per block it makes, and room for a write's five
const PD_MAX: u64 = 8;                // directory blocks whose entries wait for a commit (ent_lazy)
const BATCH_TICKS: u64 = 10;          // ticks (10 ms each) a batch waits for more writes before disk_pump commits it
const DENT: u64 = 256;
const DIR_BYTES: u64 = 67108864;      // DSLOTS * DENT: the most the directory takes in memory
const DIR_SECTORS: u64 = 131072;
const DIR_BLOCKS: u64 = 16384;
const DIR_SB: u64 = 512;              // directory blocks below this are named by the superblock, the rest by extension blocks
const EXT_PTRS: u64 = 511;            // directory blocks one extension block names (its word 0 names the next extension block)
const EXT_START: u64 = 4;             // extension blocks a mounted disk has room for at first (a small disk costs 16 KiB)
const EXT_MAX: u64 = 32;              // extension blocks: DIR_SB + EXT_MAX * EXT_PTRS >= DIR_BLOCKS
const IX_CELLS: u64 = 524288;          // cells of the name index (a power of two, at least twice DSLOTS)
const IX_BYTES: u64 = 2097152;         // 4 bytes a cell: 0 empty, else entry + 1
const IX_MIN: u64 = 1024;             // a directory with more entries than this has the index
const IX_MAX: u64 = 393216;           // cells in use (stale ones too) before the index is rebuilt
const DIR_START: u64 = 8;             // the blocks of memory the directory starts with (it doubles from there)
const DIR_FIXED: u64 = 4;             // directory blocks 0..3 are disk blocks 1..4
const DPB: u64 = 16;                  // directory entries per block
const DIR_LBA: u64 = 8;               // block 1
const BLOCK: u64 = 4096;
const BSECT: u64 = 8;                 // sectors per block
const DATA_B0: u64 = 5;               // the first block for data and maps
const PTRS: u64 = 512;                // block numbers in a map
const MAX_BLOCKS: u64 = 268435456;    // the most blocks used (1 TiB; the used map is then 32 MiB)
const SEG_BLOCKS: u64 = 262144;       // PTRS * PTRS: the blocks one root map reaches
const SEG_BYTES: u64 = 1073741824;    // SEG_BLOCKS * BLOCK: a file's first 1 GiB hangs from one root map
const SEG_FLAG: u64 = 1099511627776;  // 2^40: set in E_ROOT, the word names a super map of up to PTRS root maps, one per 1 GiB
const DFILE_MAX: u64 = 549755813888;  // PTRS * SEG_BYTES (512 GiB)
const DNAME_MAX: u64 = 200;
const DTOP: u64 = 64;                 // the parent of an entry in "disk"; entry 64 stays unused
const DISK_MAGIC: u64 = 0x334B534944545342;   // "BSTDISK3", little-endian
const DISK_MAGIC5: u64 = 0x354B534944545342;  // "BSTDISK5": BSTDISK4 plus files with super maps (E_ROOT with SEG_FLAG)
const DISK_MAGIC4: u64 = 0x344B534944545342;  // "BSTDISK4": BSTDISK3 plus extension blocks (the head is at byte 8 of the superblock)
const DISK_MAGIC2: u64 = 0x324B534944545342;  // "BSTDISK2": no directory blocks past the fixed ones
const NO_DISK_FILE: u64 = 18446744073709551615;
const DISK_MISS: u64 = 18446744073709551614;    // not in the cache yet: try again (see disk_read)

// Directory entry fields.
const E_KIND: u64 = 0;
const K_ORPHAN: u64 = 3;               // kind: a file removed while open
const K_LINK: u64 = 4;                 // kind: a hard link to the file entry in E_LINK
const E_NLEN: u64 = 1;
const E_PARENT: u64 = 8;
const E_SIZE: u64 = 16;
const E_ROOT: u64 = 24;
const E_MODE: u64 = 32;                // the mode (16 bits), user id (24) and group id (24)
const E_MTIME: u64 = 40;
const E_LINK: u64 = 48;
const E_NAME: u64 = 56;

const OWN_ID_MAX: u64 = 0x1000000;     // ids a disk entry can keep: 24 bits each
const MODE_FILE: u64 = 420;           // 0644
const MODE_DIR: u64 = 493;            // 0755

struct DiskFs {
  dev: Blk,
  dir: Bytes,           // the directory, dcap blocks (at most DIR_BYTES): grows by doubling as blocks are added
  dcap: u64,            // the blocks dir holds room for
  sb: Bytes,            // the superblock's block: the magic and the directory's blocks
  ext: Bytes,           // the extension blocks, next of ecap, in chain order
  ecap: u64,            // the extension blocks ext holds room for (at most EXT_MAX): grows by doubling from EXT_START
  next: u64,
  sec: Bytes,           // a sector buffer
  root: Bytes,          // a root map, while a write changes it
  sp: Bytes,            // a super map (see SEG_FLAG), likewise
  la: Bytes,            // a first-level map, likewise
  lb: Bytes,            // a second one, for a write that crosses two
  data: Bytes,          // a data block being built
  d2: Bytes,            // a second one, for a write that crosses two
  q: DiskQ,             // the block cache and the queue of disk commands (src/diskq.bastio)
  txn: u64,             // the last transaction a write queued, for its caller to wait on
  pw: u64,              // 1 + the entry whose writes are batched and not committed yet (0: none); see disk_write
  pb: Buf,              // the blocks the batch made: nothing on the disk names them yet (pn of BATCH_MAX)
  pn: u64,
  ob: Buf,              // the blocks the batch replaced: the disk still names them (on of OB_MAX)
  on: u64,
  pt: u64,              // the tick the batch began
  pd: Buf,              // the directory blocks holding entries changed in memory only (ent_lazy), pdn of PD_MAX: they go to the disk with the next commit
  pdn: u64,
  ppt: u64,             // the tick the first of them was noted
  tick: u64,            // the last tick disk_pump was given
  used: Bits,           // a set bit for each block in use, one per block of the disk (at most MAX_BLOCKS)
  blocks: u64,          // blocks on the disk, at most MAX_BLOCKS
  slots: u64,           // the entries the directory's blocks hold now (DPB * blocks); 0 without a disk
  hint: u64,            // where the next allocation starts looking
  ix: Bytes,            // the index of names (below), IX_BYTES once built, else empty
  ixn: u64,             // its cells in use
  free0: u64,           // every directory entry below this is in use (disk_entry starts its search for a free one here); lowered to a freed one
  foreign: bool,        // the disk holds something else, and is left alone
  psz: u64,             // its sectors (the whole device, or the partition)
  plo: u64,             // the file system's first sector on the device: 0 for a whole disk, the start of the BastiOS partition of a GPT otherwise (a multiple of BSECT, at most PLO_MAX)
  raw: bool,            // mounted with no file system, left for raw sector access (the boot option `install`)
  links: bool,          // a hard link entry may exist: false lets disk_links skip counting them
}

spec fn disk_ok(d: &DiskFs) -> bool {
  blk_ok(d.dev) && d.plo <= PLO_MAX && d.dcap >= DIR_START && d.dcap <= DIR_BLOCKS && blen(d.dir) == d.dcap * BLOCK && d.slots <= d.dcap * DPB && blen(d.sb) == BLOCK && d.ecap >= EXT_START && d.ecap <= EXT_MAX && blen(d.ext) == d.ecap * BLOCK && d.next <= d.ecap && blen(d.sec) == SECTOR && blen(d.root) == BLOCK && blen(d.sp) == BLOCK
    && blen(d.la) == BLOCK && blen(d.lb) == BLOCK && blen(d.data) == BLOCK && blen(d.d2) == BLOCK && dq_ok(d.q)
    && bits_ok(d.used) && d.blocks <= d.used.n && d.used.n <= MAX_BLOCKS && d.slots <= DSLOTS
    && len(d.pb) == BATCH_MAX && len(d.ob) == OB_MAX && d.pn <= BATCH_MAX && d.on <= OB_MAX && d.pw <= DSLOTS && d.free0 <= DSLOTS
    && (blen(d.ix) == 0 || blen(d.ix) == IX_BYTES) && d.ixn <= IX_CELLS
}

// ---------------------------------------------------------------- bytes

/// The little-endian u64 at b[at..at + 8].
fn get_u64(b: &Bytes, at: u64) -> u64
  requires at + 8 <= blen(b)
{
  return load_le64(b, at);
}

/// Stores v at b[at..at + 8], little-endian.
fn put_u64(b: &mut Bytes, at: u64, v: u64)
  requires at + 8 <= blen(b)
  ensures blen(b) == old(blen(b))
{
  store_le64(&mut b, at, v);
}

/// Sets b[from..to] to zero.
fn zero(b: &mut Bytes, from: u64, to: u64)
  requires to <= blen(b)
  ensures blen(b) == old(blen(b))
{
  if from >= to {
    return;
  }
  // One zero byte, then the zeros so far copied after themselves: the run
  // doubles with each copy.
  bset(&mut b, from, 0);
  let l = blen(b);
  let mut len = 1;
  while len < to - from
    invariant 1 <= len && from + len <= to && to <= l && blen(b) == l
  {
    let c = smaller(len, to - from - len);
    bmove(&mut b, from + len, from, c);
    len = len + c;
  }
}

// ---------------------------------------------------------------- blocks

/// Reads sector `lba` into out[at..at + SECTOR].
fn sec_in(dev: &mut Blk, plo: u64, sec: &mut Bytes, lba: u64, out: &mut Bytes, at: u64) -> bool
  requires blk_ok(dev) && plo <= PLO_MAX && blen(sec) == SECTOR && at + SECTOR <= blen(out)
  ensures blk_ok(dev) && blen(sec) == SECTOR && blen(out) == old(blen(out))
{
  if lba > PLO_MAX || !blk_read(&mut dev, plo + lba, &mut sec) {
    return false;
  }
  bcopy(&mut out, at, sec, 0, SECTOR);
  return true;
}

/// Writes src[at..at + SECTOR] to sector `lba`.
fn sec_out(dev: &mut Blk, plo: u64, sec: &mut Bytes, lba: u64, src: &Bytes, at: u64) -> bool
  requires blk_ok(dev) && plo <= PLO_MAX && blen(sec) == SECTOR && at + SECTOR <= blen(src)
  ensures blk_ok(dev) && blen(sec) == SECTOR
{
  if lba > PLO_MAX {
    return false;
  }
  bcopy(&mut sec, 0, src, at, SECTOR);
  return blk_write(&mut dev, plo + lba, sec);
}

/// Reads block b into out, or zeros for b == 0 (a hole), with one disk
/// command.
fn block_in(dev: &mut Blk, plo: u64, sec: &mut Bytes, b: u64, out: &mut Bytes) -> bool
  requires blk_ok(dev) && plo <= PLO_MAX && blen(sec) == SECTOR && blen(out) == BLOCK && b < MAX_BLOCKS
  ensures blk_ok(dev) && blen(sec) == SECTOR && blen(out) == BLOCK
{
  if b == 0 {
    zero(&mut out, 0, BLOCK);
    return true;
  }
  return blk_read_block(&mut dev, plo + b * BSECT, &mut out, 0);
}

/// Writes src (BLOCK bytes) to block b with one disk command, and flushes
/// the drive's cache, so it is on the disk before any later write.
fn block_out(dev: &mut Blk, plo: u64, sec: &mut Bytes, b: u64, src: &Bytes) -> bool
  requires blk_ok(dev) && plo <= PLO_MAX && blen(sec) == SECTOR && blen(src) == BLOCK && b < MAX_BLOCKS
  ensures blk_ok(dev) && blen(sec) == SECTOR
{
  return blk_write_block(&mut dev, plo + b * BSECT, src, 0);
}

/// The block number at m[at..at + 8], or 0 for a hole or a number that is
/// not a data block on this disk.
fn ptr_in(d: &DiskFs, m: &Bytes, at: u64) -> u64
  requires disk_ok(d) && at + 8 <= blen(m)
  ensures result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS)
{
  let p = get_u64(m, at);
  if p >= DATA_B0 && p < d.blocks {
    return p;
  }
  return 0;
}

/// The file tree an entry's root word at m[at..at + 8] names: a root map
/// block, or a super map block plus SEG_FLAG; 0 for none or for a number
/// that is not a data block on this disk.
fn tree_in(d: &DiskFs, m: &Bytes, at: u64) -> u64
  requires disk_ok(d) && at + 8 <= blen(m)
  ensures result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS) || (result >= SEG_FLAG + DATA_B0 && result < SEG_FLAG + MAX_BLOCKS)
{
  let w = get_u64(m, at);
  if w < SEG_FLAG {
    if w >= DATA_B0 && w < d.blocks {
      return w;
    }
    return 0;
  }
  if w >= SEG_FLAG + DATA_B0 && w < SEG_FLAG + d.blocks {
    return w;
  }
  return 0;
}

/// Takes a free block. Returns it, or 0 if the disk is full.
fn alloc_block(d: &mut DiskFs) -> u64
  requires disk_ok(d)
  ensures disk_ok(d) && (result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS))
{
  let n = d.blocks;
  if n <= DATA_B0 {
    return 0;
  }
  // From the hint up to n, then from DATA_B0 (core/bitmap: a block it
  // returns was free, and n means every block is in use).
  let b = bits_take(&mut d.used, DATA_B0, n, d.hint);
  if b == n {
    return 0;
  }
  d.hint = b + 1;
  dq_forget(&mut d.q, b);
  return b;
}

// ---------------------------------------------------------------- the queue

/// Moves the disk's command queue along without waiting (see
/// src/diskq.bastio), freeing the blocks finished transactions gave up.
/// True if anything happened.
fn disk_pump(d: &mut DiskFs, now: u64) -> bool
  requires disk_ok(d)
  ensures disk_ok(d)
{
  let mut moved = false;
  d.tick = now;
  if (d.pw != 0 && now >= d.pt && now - d.pt >= BATCH_TICKS) || (d.pw == 0 && d.pdn != 0 && now >= d.ppt && now - d.ppt >= BATCH_TICKS) {
    let keep = d.txn;
    disk_commit(&mut d);
    d.txn = keep;
  }
  let mut n = 0;
  while n < 2 * NQ + 2
    invariant disk_ok(d)
  {
    let r = dq_pump(&mut d.q, &mut d.dev, now);
    if r == DQ_IDLE {
      return moved;
    }
    if r >= DQ_FREED {
      free_block(&mut d, r - DQ_FREED);
    }
    moved = true;
    n = n + 1;
  }
  return moved;
}

/// Waits until every queued command has finished, for the operations
/// that still do their disk I/O synchronously. A command that never
/// finishes is given up after DQ_SPINS polls (the disk is then dead).
fn disk_drain(d: &mut DiskFs)
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  settle_batch(&mut d);
  disk_wait(&mut d);
}

/// Waits until every queued command has finished, leaving a batch of
/// writes that is not queued yet as it is.
fn disk_wait(d: &mut DiskFs)
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  let mut spins = 0;
  let blocks0 = d.blocks;
  let slots0 = d.slots;
  while !dq_idle(d.q) && spins < DQ_SPINS + 2 * NQ + 2
    invariant disk_ok(d) && d.blocks == blocks0 && d.slots == slots0
  {
    let mut now = 0;
    if spins >= DQ_SPINS && d.q.since < 0x4000000000000000 {
      now = d.q.since + DQ_TICKS + 1;
    }
    let r = dq_pump(&mut d.q, &mut d.dev, now);
    if r >= DQ_FREED {
      free_block(&mut d, r - DQ_FREED);
    }
    spins = spins + 1;
  }
}

/// Gives block b back (nothing for 0).
fn free_block(d: &mut DiskFs, b: u64)
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  if b >= DATA_B0 && b < d.used.n {
    bits_clear(&mut d.used, b);
  }
}

/// Blocks for data and maps on the disk, and how many of them are free
/// (statfs on a path under disk/).
fn disk_space(d: &DiskFs, free: bool) -> u64
  requires disk_ok(d)
{
  if d.blocks <= DATA_B0 {
    return 0;
  }
  if free {
    return bits_count_clear(d.used, DATA_B0, d.blocks);
  }
  return d.blocks - DATA_B0;
}

/// Directory entries left for new names.
fn disk_free_entries(d: &DiskFs) -> u64
  requires disk_ok(d)
  ensures result <= DSLOTS
{
  let mut n = 0;
  let mut i = 0;
  while i < DSLOTS
    invariant i <= DSLOTS && n <= i
  {
    if i != DTOP && !dent_used(d, i) {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

/// Marks block b in use (u != 0) or free in the used map, if the map
/// covers it.
fn used_mark(m: &mut Bits, b: u64, u: u8)
  requires bits_ok(m)
  ensures bits_ok(m) && m.n == old(m.n)
{
  if b < m.n && u != 0 {
    bits_set(&mut m, b);
  } else if b < m.n {
    bits_clear(&mut m, b);
  }
}

// Entry i of the directory in memory. The buffer holds room for dcap blocks,
// more as the directory grows (dir_room): an entry past it reads as zeros
// (unused) and a write to one changes nothing.

/// Byte off of entry i.
fn dent_byte(d: &DiskFs, i: u64, off: u64) -> u8
  requires disk_ok(d) && i < DSLOTS && off < DENT
{
  if i >= d.dcap * DPB {
    return 0;
  }
  return bget(d.dir, i * DENT + off);
}

/// Sets byte off of entry i in memory.
fn dent_setb(d: &mut DiskFs, i: u64, off: u64, x: u8)
  requires disk_ok(d) && i < DSLOTS && off < DENT
  ensures disk_ok(d) && d.dcap == old(d.dcap) && d.slots == old(d.slots)
{
  if i < d.dcap * DPB {
    bset(&mut d.dir, i * DENT + off, x);
  }
}

/// Zeroes bytes from..to of entry i in memory.
fn dent_zero(d: &mut DiskFs, i: u64, from: u64, to: u64)
  requires disk_ok(d) && i < DSLOTS && from <= to && to <= DENT
  ensures disk_ok(d) && d.dcap == old(d.dcap) && d.slots == old(d.slots)
{
  if i < d.dcap * DPB {
    zero(&mut d.dir, i * DENT + from, i * DENT + to);
  }
}

/// Marks every block of the file with root map r as in use (u = 1) or
/// free (u = 0). A map that cannot be read is skipped: its blocks stay as
/// they were (in use until the next mount, if they were).
fn walk_flat(d: &mut DiskFs, r: u64, u: u8)
  requires disk_ok(d) && r >= DATA_B0 && r < MAX_BLOCKS
  ensures disk_ok(d) && d.dcap == old(d.dcap) && d.slots == old(d.slots)
{
  used_mark(&mut d.used, r, u);
  walk_from(&mut d, r, 0, u);
}

/// Marks every block of the file tree t (a root map, or a super map plus
/// SEG_FLAG: the super map, and each root map it names with its blocks).
fn walk(d: &mut DiskFs, t: u64, u: u8)
  requires disk_ok(d) && ((t >= DATA_B0 && t < MAX_BLOCKS) || (t >= SEG_FLAG + DATA_B0 && t < SEG_FLAG + MAX_BLOCKS))
  ensures disk_ok(d) && d.dcap == old(d.dcap) && d.slots == old(d.slots)
{
  if t < SEG_FLAG {
    walk_flat(&mut d, t, u);
    return;
  }
  let sb = t - SEG_FLAG;
  used_mark(&mut d.used, sb, u);
  if !block_in(&mut d.dev, d.plo, &mut d.sec, sb, &mut d.sp) {
    return;
  }
  let mut j = 0;
  while j < PTRS
    invariant j <= PTRS && disk_ok(d)
  {
    let r = ptr_in(d, d.sp, 8 * j);
    if r != 0 {
      walk_flat(&mut d, r, u);
    }
    j = j + 1;
  }
}

/// Marks the blocks under entries `from`.. of root map r (not r itself).
fn walk_from(d: &mut DiskFs, r: u64, from: u64, u: u8)
  requires disk_ok(d) && r >= DATA_B0 && r < MAX_BLOCKS
  ensures disk_ok(d) && d.dcap == old(d.dcap) && d.slots == old(d.slots)
{
  if from >= PTRS || !block_in(&mut d.dev, d.plo, &mut d.sec, r, &mut d.root) {
    return;
  }
  let mut j = from;
  while j < PTRS
    invariant j <= PTRS && disk_ok(d)
  {
    let l = ptr_in(d, d.root, 8 * j);
    if l != 0 && l < d.used.n {
      used_mark(&mut d.used, l, u);
      if block_in(&mut d.dev, d.plo, &mut d.sec, l, &mut d.la) {
        let mut k = 0;
        while k < PTRS
          invariant k <= PTRS && disk_ok(d)
        {
          let p = ptr_in(d, d.la, 8 * k);
          if p != 0 {
            used_mark(&mut d.used, p, u);
          }
          k = k + 1;
        }
      }
    }
    j = j + 1;
  }
}

// ---------------------------------------------------------------- mounting

/// The disk block that holds block db of the directory, or 0 if it has
/// none yet.
fn dir_block(d: &DiskFs, db: u64) -> u64
  requires disk_ok(d) && db < DIR_BLOCKS
  ensures result == 0 || (result >= 1 && result < MAX_BLOCKS)
{
  if db < DIR_FIXED {
    return DIR_LBA / BSECT + db;
  }
  if db < DIR_SB {
    return ptr_in(d, d.sb, 8 * db);
  }
  let e = (db - DIR_SB) / EXT_PTRS;
  if e >= d.next {
    return 0;
  }
  return ptr_in(d, d.ext, e * BLOCK + 8 * ((db - DIR_SB) % EXT_PTRS + 1));
}

/// The disk block of extension block e (e < next), or 0.
fn ext_no(d: &DiskFs, e: u64) -> u64
  requires disk_ok(d) && e < d.ecap
  ensures result == 0 || (result >= 1 && result < MAX_BLOCKS)
{
  if e == 0 {
    return ptr_in(d, d.sb, 8);
  }
  return ptr_in(d, d.ext, (e - 1) * BLOCK);
}

/// Makes room in memory for `blocks` directory blocks: dir doubles (the
/// kernel's allocator reuses a freed block only for a buffer of the same
/// size, so a step of one block would leave every old copy unused) up to
/// DIR_BLOCKS, with its bytes kept. False, with d as it was, when memory
/// runs out.
fn dir_room(d: &mut DiskFs, blocks: u64) -> bool
  requires disk_ok(d) && blocks <= DIR_BLOCKS
  ensures disk_ok(d) && (result ==> blocks <= d.dcap)
{
  if blocks <= d.dcap {
    return true;
  }
  let mut n = d.dcap;
  while n < blocks
    invariant n >= DIR_START && n <= DIR_BLOCKS && disk_ok(d)
  {
    n = n * 2;
    if n > DIR_BLOCKS {
      n = DIR_BLOCKS;
    }
  }
  let mut nd = try_balloc(n * BLOCK);
  if blen(nd) != n * BLOCK && blen(d.ix) == IX_BYTES {
    // The name index (2 MiB) can take the room the bigger directory needs
    // on a machine with little memory: the directory matters more, and the
    // index is built again by a lookup once there is room for it.
    bfree(nd);
    bfree(d.ix);
    d.ix = balloc(0);
    d.ixn = 0;
    nd = try_balloc(n * BLOCK);
  }
  if blen(nd) != n * BLOCK {
    bfree(nd);
    return false;
  }
  bcopy(&mut nd, 0, d.dir, 0, d.dcap * BLOCK);
  let prev = d.dir;
  d.dir = nd;
  d.dcap = n;
  bfree(prev);
  return true;
}

/// Makes room in memory for `blocks` extension blocks, as dir_room does
/// for the directory. False, with d as it was, when memory runs out.
fn ext_room(d: &mut DiskFs, blocks: u64) -> bool
  requires disk_ok(d) && blocks <= EXT_MAX
  ensures disk_ok(d) && (result ==> blocks <= d.ecap)
{
  if blocks <= d.ecap {
    return true;
  }
  let mut n = d.ecap;
  while n < blocks
    invariant n >= EXT_START && n <= EXT_MAX && disk_ok(d)
  {
    n = n * 2;
    if n > EXT_MAX {
      n = EXT_MAX;
    }
  }
  let mut ne = try_balloc(n * BLOCK);
  if blen(ne) != n * BLOCK {
    bfree(ne);
    return false;
  }
  bcopy(&mut ne, 0, d.ext, 0, d.ecap * BLOCK);
  let prev = d.ext;
  d.ext = ne;
  d.ecap = n;
  bfree(prev);
  return true;
}

/// Writes directory sector s (0 to DIR_SECTORS - 1) to the disk.
fn dir_flush(d: &mut DiskFs, s: u64) -> bool
  requires disk_ok(d) && s < DIR_SECTORS
  ensures disk_ok(d) && d.dcap == old(d.dcap) && d.slots == old(d.slots)
{
  let b = dir_block(d, s / BSECT);
  if b == 0 || s / BSECT >= d.dcap {
    return false;
  }
  return sec_out(&mut d.dev, d.plo, &mut d.sec, b * BSECT + s % BSECT, d.dir, s * SECTOR);
}

/// Adds a block to the directory (DPB more entries): the block, zeroed,
/// is written and flushed before the superblock names it. False if the
/// directory is at DSLOTS, the disk is full, or a write fails.
fn dir_grow(d: &mut DiskFs) -> bool
  requires disk_ok(d)
  ensures disk_ok(d) && d.slots <= DSLOTS
{
  if d.slots < DIR_FIXED * DPB || d.slots >= DSLOTS {
    return false;
  }
  let db = d.slots / DPB;
  if !dir_room(&mut d, db + 1) {
    return false;
  }
  let b = alloc_block(&mut d);
  if b == 0 {
    return false;
  }
  zero(&mut d.dir, db * BLOCK, db * BLOCK + BLOCK);
  if !blk_write_block(&mut d.dev, d.plo + b * BSECT, d.dir, db * BLOCK) {
    free_block(&mut d, b);
    return false;
  }
  if db >= DIR_SB {
    if !ext_name(&mut d, db, b) {
      return false;
    }
    d.slots = DPB * (db + 1);
    ix_rebuild(&mut d);
    return true;
  }
  put_u64(&mut d.sb, 8 * db, b);
  if !sec_out(&mut d.dev, d.plo, &mut d.sec, db / 64, d.sb, db / 64 * SECTOR) {
    // The disk may or may not have the new superblock: b stays in use
    // (until the next mount), so it never holds anything else meanwhile.
    put_u64(&mut d.sb, 8 * db, 0);
    return false;
  }
  d.slots = DPB * (db + 1);
  ix_rebuild(&mut d);
  return true;
}

/// Names directory block db (at least DIR_SB), already written as block
/// b, in an extension block. When the last extension block is full (or
/// there is none) a new one is made: it is written whole, naming b, while
/// nothing links to it, and then linked with one sector write: the
/// superblock's sector 0 for the first (which also changes the magic to
/// BSTDISK4, so an older kernel leaves the disk alone), word 0 of the
/// previous extension block otherwise. A power cut leaves either the old
/// directory or the new one, and the unlinked blocks free.
fn ext_name(d: &mut DiskFs, db: u64, b: u64) -> bool
  requires disk_ok(d) && db >= DIR_SB && db < DIR_BLOCKS && b >= 1 && b < MAX_BLOCKS
  ensures disk_ok(d) && d.slots == old(d.slots)
{
  let e = (db - DIR_SB) / EXT_PTRS;
  let w = (db - DIR_SB) % EXT_PTRS + 1;
  if e > d.next || e >= EXT_MAX {
    return false;
  }
  if e < d.next {
    // The block exists: one pointer, in one sector.
    let eb = ext_no(d, e);
    if eb == 0 {
      return false;
    }
    put_u64(&mut d.ext, e * BLOCK + 8 * w, b);
    if !sec_out(&mut d.dev, d.plo, &mut d.sec, eb * BSECT + w / 64, d.ext, e * BLOCK + w / 64 * SECTOR) {
      put_u64(&mut d.ext, e * BLOCK + 8 * w, 0);
      return false;
    }
    return true;
  }
  if !ext_room(&mut d, e + 1) {
    return false;
  }
  let eb = alloc_block(&mut d);
  if eb == 0 {
    return false;
  }
  zero(&mut d.ext, e * BLOCK, e * BLOCK + BLOCK);
  put_u64(&mut d.ext, e * BLOCK + 8 * w, b);
  if !blk_write_block(&mut d.dev, d.plo + eb * BSECT, d.ext, e * BLOCK) {
    zero(&mut d.ext, e * BLOCK, e * BLOCK + BLOCK);
    free_block(&mut d, eb);
    return false;
  }
  let mut ok = false;
  if e == 0 {
    let was = get_u64(d.sb, 0);
    if was != DISK_MAGIC5 {
      put_u64(&mut d.sb, 0, DISK_MAGIC4);
    }
    put_u64(&mut d.sb, 8, eb);
    ok = sec_out(&mut d.dev, d.plo, &mut d.sec, 0, d.sb, 0);
    if !ok {
      put_u64(&mut d.sb, 0, was);
      put_u64(&mut d.sb, 8, 0);
    }
  } else {
    let pb = ext_no(d, e - 1);
    if pb != 0 {
      put_u64(&mut d.ext, (e - 1) * BLOCK, eb);
      ok = sec_out(&mut d.dev, d.plo, &mut d.sec, pb * BSECT, d.ext, (e - 1) * BLOCK);
      if !ok {
        put_u64(&mut d.ext, (e - 1) * BLOCK, 0);
      }
    }
  }
  if !ok {
    // The link may or may not be on the disk: eb and b stay in use (until
    // the next mount), so they never hold anything else meanwhile.
    zero(&mut d.ext, e * BLOCK, e * BLOCK + BLOCK);
    return false;
  }
  d.next = e + 1;
  return true;
}

/// Writes entry i (it shares a sector only with its neighbour).
fn ent_flush(d: &mut DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  return dir_flush(&mut d, i / 2);
}

const BLANK_SECTORS: u64 = 34;      // a protective MBR, then GPT's header and its 32 sectors of entries

/// Are the first and the last BLANK_SECTORS of the disk's `n` sectors all
/// zeros (or unreadable: then the disk is not used either)?
fn disk_blank(dev: &mut Blk, plo: u64, sec: &mut Bytes, n: u64) -> bool
  requires blk_ok(dev) && plo <= PLO_MAX && n <= PLO_MAX && blen(sec) == SECTOR
  ensures blk_ok(dev) && blen(sec) == SECTOR
{
  let mut i = 0;
  while i < 2 * BLANK_SECTORS
    invariant blk_ok(dev) && blen(sec) == SECTOR
  {
    let mut lba = i;
    if i >= BLANK_SECTORS && n >= 2 * BLANK_SECTORS {
      lba = n - 2 * BLANK_SECTORS + i;
    }
    if !blk_read(&mut dev, plo + lba, &mut sec) {
      return false;
    }
    let mut k = 0;
    while k < SECTOR
      invariant k <= SECTOR && blen(sec) == SECTOR && blk_ok(dev)
    {
      if bget(sec, k) != 0 {
        return false;
      }
      k = k + 1;
    }
    i = i + 1;
  }
  return true;
}

/// How disk_mount takes the device.
const DM_WHOLE: u64 = 0;              // the whole device is the file system (a loop device's image, a USB stick's partition)
const DM_GPT: u64 = 1;                // the BastiOS partition of a GPT if there is one, else as DM_WHOLE
const DM_RAW: u64 = 2;                // no file system, nothing read or written (the device is for raw sector access)

/// Where a GPT on a device of `total` sectors puts its BastiOS partition.
struct Part { found: bool, gpt: bool, plo: u64, n: u64 }

spec fn part_ok(r: &Part, total: u64) -> bool {
  r.found ==> (r.gpt && r.plo >= 34 && r.plo % BSECT == 0 && r.plo <= PLO_MAX && r.n >= 1 && r.plo + r.n <= total)
}

/// Looks for a GPT (header in sector 1, 128-byte entries) and in it for a
/// partition of the BastiOS type (BASTIOS_PART_LO / BASTIOS_PART_HI, which
/// `make usb` and the installer make). The checksums are not checked: the
/// partition must lie whole on the device, past the table, on a 4 KiB
/// boundary. `gpt` says there is a GPT at all.
fn gpt_find(dev: &mut Blk, sec: &mut Bytes, total: u64) -> Part
  requires blk_ok(dev) && blen(sec) == SECTOR
  ensures blk_ok(dev) && blen(sec) == SECTOR && part_ok(result, total)
{
  let none = Part { found: false, gpt: false, plo: 0, n: 0 };
  if total < 34 || total > PLO_MAX || !blk_read(&mut dev, 1, &mut sec) || get_u64(sec, 0) != GPT_SIG {
    return none;
  }
  let elba = get_u64(sec, 72);
  let w = get_u64(sec, 80);
  let count = w % 4294967296;
  let mut r = Part { found: false, gpt: true, plo: 0, n: 0 };
  if w / 4294967296 != 128 || elba < 2 || elba > total || elba + 32 > total {
    return r;
  }
  let mut i = 0;
  while i < count && i < 128 && !r.found
    invariant blk_ok(dev) && blen(sec) == SECTOR && part_ok(r, total) && r.gpt && i % 4 == 0 && i <= 128 && elba + 32 <= total
  {
    if !blk_read(&mut dev, elba + i / 4, &mut sec) {
      return r;
    }
    let mut j = 0;
    while j < 4 && !r.found
      invariant j <= 4 && blk_ok(dev) && blen(sec) == SECTOR && part_ok(r, total) && r.gpt
    {
      let o = j * 128;
      if i + j < count && get_u64(sec, o) == BASTIOS_PART_LO && get_u64(sec, o + 8) == BASTIOS_PART_HI {
        let first = get_u64(sec, o + 32);
        let last = get_u64(sec, o + 40);
        if first >= 34 && first % BSECT == 0 && first <= last && last < total {
          r = Part { found: true, gpt: true, plo: first, n: last - first + 1 };
        }
      }
      j = j + 1;
    }
    i = i + 4;
  }
  return r;
}

/// Mounts the disk (see DM_*), formatting it if it has no file system yet and is
/// blank (else it is left alone: `foreign`), and works out which blocks
/// are in use. Without a disk (or one too small) the file
/// system has no entries and every operation on it fails.
fn disk_mount(dev: Blk, mode: u64, cslots: u64) -> DiskFs
  requires blk_ok(dev) && cslots >= NC_MIN && cslots <= NC
  ensures disk_ok(result)
{
  let total = blk_sectors(dev);
  let mut n = total / BSECT;
  if n > MAX_BLOCKS {
    n = MAX_BLOCKS;
  }
  let mut nc = cslots;
  if n < DATA_B0 + 16 || mode == DM_RAW {
    nc = NC_MIN;      // no file system to cache: a loop mount that no file backs
  }
  let mut d = DiskFs { dev: dev, dir: balloc(DIR_START * BLOCK), dcap: DIR_START, sb: balloc(BLOCK), ext: balloc(EXT_START * BLOCK), ecap: EXT_START, next: 0, sec: balloc(SECTOR), root: balloc(BLOCK), sp: balloc(BLOCK),
    la: balloc(BLOCK), lb: balloc(BLOCK), data: balloc(BLOCK), d2: balloc(BLOCK), q: dq_new(nc), txn: 0, pw: 0, pb: alloc(BATCH_MAX), pn: 0, ob: alloc(OB_MAX), on: 0, pt: 0, pd: alloc(PD_MAX), pdn: 0, ppt: 0, tick: 0,
    used: bits_new(n), blocks: 0, slots: 0, hint: DATA_B0, ix: balloc(0), ixn: 0, free0: 0, foreign: false, links: true, psz: total, plo: 0, raw: mode == DM_RAW };
  if mode == DM_RAW {
    return d;
  }
  if mode == DM_GPT {
    // A GPT with a BastiOS partition: the file system is in that
    // partition. A GPT without one is someone else's disk (below).
    let p = gpt_find(&mut d.dev, &mut d.sec, total);
    if p.found {
      d.plo = p.plo;
      d.psz = p.n;
      d.q.plo = p.plo;
      n = p.n / BSECT;
      if n > MAX_BLOCKS {
        n = MAX_BLOCKS;
      }
    }
  }
  if n < DATA_B0 + 16 || !blk_read(&mut d.dev, d.plo, &mut d.sec) {
    return d;
  }
  d.blocks = n;
  let magic = get_u64(d.sec, 0);
  if magic == DISK_MAGIC || magic == DISK_MAGIC2 || magic == DISK_MAGIC4 || magic == DISK_MAGIC5 {
    // The fixed blocks, then each block the superblock names, in order,
    // up to the first it does not (a block number off the data area ends
    // the directory there too; test/fsck.py reports it).
    let mut s = 0;
    while s < DIR_FIXED * BSECT
      invariant s <= DIR_FIXED * BSECT && disk_ok(d)
    {
      if !sec_in(&mut d.dev, d.plo, &mut d.sec, DIR_LBA + s, &mut d.dir, s * SECTOR) {
        d.blocks = 0;
        return d;
      }
      s = s + 1;
    }
    if magic != DISK_MAGIC2 {
      if !blk_read_block(&mut d.dev, d.plo, &mut d.sb, 0) {
        d.blocks = 0;
        return d;
      }
    } else {
      put_u64(&mut d.sb, 0, DISK_MAGIC);    // an older disk: no more blocks, the new magic
      if !blk_write_block(&mut d.dev, d.plo, d.sb, 0) {
        d.blocks = 0;
        return d;
      }
    }
    if magic == DISK_MAGIC4 || magic == DISK_MAGIC5 {
      // The extension blocks, in chain order (at most EXT_MAX: a longer
      // chain, or a loop, is cut there).
      let mut eb = ptr_in(d, d.sb, 8);
      while eb != 0 && d.next < EXT_MAX
        invariant d.next <= EXT_MAX && eb < MAX_BLOCKS && disk_ok(d)
      {
        if !ext_room(&mut d, d.next + 1) || !blk_read_block(&mut d.dev, d.plo + eb * BSECT, &mut d.ext, d.next * BLOCK) {
          d.blocks = 0;
          return d;
        }
        used_mark(&mut d.used, eb, 1);
        eb = ptr_in(d, d.ext, d.next * BLOCK);
        d.next = d.next + 1;
      }
    }
    let mut db = DIR_FIXED;
    while db < DIR_BLOCKS && dir_block(d, db) != 0
      invariant db >= DIR_FIXED && db <= DIR_BLOCKS && db <= d.dcap && disk_ok(d)
    {
      let b = dir_block(d, db);
      if !dir_room(&mut d, db + 1) || !blk_read_block(&mut d.dev, d.plo + b * BSECT, &mut d.dir, db * BLOCK) {
        d.blocks = 0;
        return d;
      }
      used_mark(&mut d.used, b, 1);
      db = db + 1;
    }
    d.slots = DPB * db;
    if db < DIR_SB {
      zero(&mut d.sb, 8 * db, BLOCK);       // forget any blocks named past a gap
    } else if db < DIR_BLOCKS && (db - DIR_SB) / EXT_PTRS < d.next {
      let e = (db - DIR_SB) / EXT_PTRS;
      zero(&mut d.ext, e * BLOCK + 8 * ((db - DIR_SB) % EXT_PTRS + 1), e * BLOCK + BLOCK);
      d.next = e + 1;
    }
  } else {
    // Format, but only a blank disk. Anything in its first or last
    // BLANK_SECTORS sectors (an MBR or GPT partition table, GPT's backup
    // copy at the end, a boot sector, another file system's superblock)
    // means the disk is someone else's: on a real machine, the one with
    // its owner's operating system on it. It is not touched.
    if d.psz > PLO_MAX || !disk_blank(&mut d.dev, d.plo, &mut d.sec, d.psz) {
      d.blocks = 0;
      d.foreign = true;
      return d;
    }
    // Format: an empty directory (balloc zeroes it), then the superblock.
    d.slots = DIR_FIXED * DPB;
    let mut s = 0;
    while s < DIR_FIXED * BSECT
      invariant s <= DIR_FIXED * BSECT && disk_ok(d)
    {
      if !dir_flush(&mut d, s) {
        d.blocks = 0;
        d.slots = 0;
        return d;
      }
      s = s + 1;
    }
    put_u64(&mut d.sb, 0, DISK_MAGIC);
    if !sec_out(&mut d.dev, d.plo, &mut d.sec, 0, d.sb, 0) {
      d.blocks = 0;
      d.slots = 0;
      return d;
    }
  }
  zero(&mut d.dir, DTOP * DENT, DTOP * DENT + DENT);   // entry 64 is never used
  let slots = d.slots;
  d.slots = 0;                                         // until the checks below are done
  let mut seen = false;                                // a link entry in the directory
  let mut i = 0;
  while i < slots
    invariant i <= slots && slots <= DSLOTS && slots <= d.dcap * DPB && disk_ok(d)
  {
    if cast[u64](dent_byte(d, i, E_KIND)) == K_LINK {
      seen = true;
    }
    if dent_byte(d, i, E_KIND) == 1 {
      let r = tree_in(d, d.dir, i * DENT + E_ROOT);
      if r != 0 {
        walk(&mut d, r, 1);
      }
    } else if cast[u64](dent_byte(d, i, E_KIND)) == K_ORPHAN {
      // Removed while open, then the power went: nothing has it open now.
      // Its blocks stay unmarked, so they are free.
      dent_setb(&mut d, i, E_KIND, 0);
      dir_flush(&mut d, i / 2);
    }
    i = i + 1;
  }
  // A hard link must name a file under another name. A power cut can
  // leave one naming a free entry (while the file was removed), or one
  // whose file has already taken its name (disk_take_name): it goes.
  i = 0;
  while i < slots
    invariant i <= slots && slots <= DSLOTS && slots <= d.dcap * DPB && disk_ok(d)
  {
    if cast[u64](dent_byte(d, i, E_KIND)) == K_LINK {
      let t = get_u64(d.dir, i * DENT + E_LINK);
      if t >= slots || dent_byte(d, t, E_KIND) != 1 || same_name(d, i, t) {
        dent_setb(&mut d, i, E_KIND, 0);
        dir_flush(&mut d, i / 2);
      }
    }
    i = i + 1;
  }
  d.slots = slots;
  d.links = seen;
  ix_rebuild(&mut d);
  return d;
}

/// Unmounts the disk and hands back its driver (at power off), once every
/// queued command has finished.
fn disk_unmount(d: DiskFs) -> Blk
  requires disk_ok(d)
  ensures blk_ok(result)
{
  let mut e = d;
  disk_drain(&mut e);
  return disk_unmount_now(e);
}

fn disk_unmount_now(d: DiskFs) -> Blk
  requires disk_ok(d)
  ensures blk_ok(result)
{
  dq_free(d.q);
  bfree(d.d2);
  bfree(d.dir);
  bfree(d.sb);
  bfree(d.ext);
  bfree(d.ix);
  bfree(d.sec);
  bfree(d.root);
  bfree(d.sp);
  bfree(d.la);
  bfree(d.lb);
  bfree(d.data);
  free(d.pb);
  free(d.ob);
  free(d.pd);
  bits_free(d.used);
  return d.dev;
}

// ---------------------------------------------------------------- the directory

/// Is entry i in use: a file, a directory, or an orphan (a file removed
/// while still open, which keeps its data until the last close)?
fn dent_used(d: &DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
{
  let k = cast[u64](dent_byte(d, i, 0));
  return i < d.slots && (k == 1 || k == 2 || k == K_ORPHAN || k == K_LINK);
}

/// Does entry i have a name (a file, a directory or a hard link, not an
/// orphan)?
fn dent_live(d: &DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
{
  let k = cast[u64](dent_byte(d, i, 0));
  return i < d.slots && (k == 1 || k == 2 || k == K_LINK);
}

/// Is entry i an orphan?
fn dent_orphan(d: &DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
{
  return i < d.slots && cast[u64](dent_byte(d, i, 0)) == K_ORPHAN;
}

/// Takes entry i's name away but keeps its data, while it is open: one
/// sector write. disk_remove frees it at the last close, and a mount
/// frees any a power cut left behind.
fn disk_orphan(d: &mut DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  if dent_byte(d, i, 0) != 1 {
    return false;
  }
  dent_setb(&mut d, i, E_KIND, cast[u8](K_ORPHAN));
  if !ent_flush(&mut d, i) {
    dent_setb(&mut d, i, E_KIND, 1);
    return false;
  }
  return true;
}

/// Is entry i a directory?
fn dent_dir(d: &DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
{
  return i < d.slots && dent_byte(d, i, 0) == 2;
}

/// Field f (a u64) of entry i.
fn dent_get(d: &DiskFs, i: u64, f: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && f + 8 <= E_NAME
{
  if i >= d.dcap * DPB {
    return 0;
  }
  return get_u64(d.dir, i * DENT + f);
}

/// Sets field f of entry i in memory (ent_flush writes it).
fn dent_set(d: &mut DiskFs, i: u64, f: u64, x: u64)
  requires disk_ok(d) && i < DSLOTS && f + 8 <= E_NAME
  ensures disk_ok(d) && d.dcap == old(d.dcap) && d.slots == old(d.slots)
{
  if i < d.dcap * DPB {
    put_u64(&mut d.dir, i * DENT + f, x);
  }
}

/// The directory entry i is in: another entry, or DTOP.
fn dent_parent(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
{
  return dent_get(d, i, E_PARENT);
}

/// Entry i's file tree (see tree_in), or 0.
fn dent_tree(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS) || (result >= SEG_FLAG + DATA_B0 && result < SEG_FLAG + MAX_BLOCKS)
{
  if i >= d.dcap * DPB {
    return 0;
  }
  return tree_in(d, d.dir, i * DENT + E_ROOT);
}

fn disk_size(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures result <= DFILE_MAX || result == NO_DISK_FILE
{
  if !dent_used(d, i) {
    return NO_DISK_FILE;
  }
  let s = dent_get(d, i, E_SIZE);
  if s > DFILE_MAX {
    return DFILE_MAX;           // a damaged entry: never read past the maps
  }
  return s;
}

/// Is entry i named name[from..from + n] (one component)?
fn dent_named(d: &DiskFs, i: u64, name: &Bytes, from: u64, n: u64) -> bool
  requires disk_ok(d) && i < DSLOTS && from + n <= blen(name)
{
  if i >= d.slots || cast[u64](dent_byte(d, i, E_NLEN)) != n || n > DNAME_MAX || !dent_live(d, i) {
    return false;
  }
  return bytes_span_eq(d.dir, i * DENT + E_NAME, name, from, n);
}

// The index of names. A directory with more than IX_MIN entries has a hash
// table from (parent, name) to the entry, so a lookup (and so a create,
// which first looks for the name) does not read every entry. Each cell holds
// an entry number + 1. It is memory only, built from the directory at mount
// (and again when its cells run out) and never written. A cell is added for
// an entry when it gets its name (create, move, take_name) and is never
// removed: a lookup checks the entry's parent and name, so a cell left by an
// entry that was removed or renamed is skipped. When memory for the table
// cannot be had, lookups read every entry, as they did before it.

fn ix_cell(d: &DiskFs, c: u64) -> u64
  requires disk_ok(d) && blen(d.ix) == IX_BYTES && c < IX_CELLS
{
  return cast[u64](bget(d.ix, 4 * c)) + cast[u64](bget(d.ix, 4 * c + 1)) * 256
    + cast[u64](bget(d.ix, 4 * c + 2)) * 65536 + cast[u64](bget(d.ix, 4 * c + 3)) * 16777216;
}

fn ix_put(d: &mut DiskFs, c: u64, v: u64)
  requires disk_ok(d) && blen(d.ix) == IX_BYTES && c < IX_CELLS && v <= DSLOTS
  ensures disk_ok(d)
{
  bset(&mut d.ix, 4 * c, cast[u8](v % 256));
  bset(&mut d.ix, 4 * c + 1, cast[u8](v / 256 % 256));
  bset(&mut d.ix, 4 * c + 2, cast[u8](v / 65536 % 256));
  bset(&mut d.ix, 4 * c + 3, cast[u8](v / 16777216 % 256));
}

/// The first cell to look at for the name m[from..from + n] in directory p.
fn ix_hash(p: u64, m: &Bytes, from: u64, n: u64) -> u64
  requires from + n <= blen(m)
  ensures result < IX_CELLS
{
  let mut h = wrap_mul(wrap_add(p, 1), 0x9E3779B97F4A7C15);
  let mut j = 0;
  while j < n
    invariant j <= n && from + n <= blen(m)
  {
    h = wrap_mul(h ^ cast[u64](bget(m, from + j)), 0x100000001B3);
    j = j + 1;
  }
  return (h ^ (h >> 32)) % IX_CELLS;
}

/// Gives live entry i (i < d.slots) a cell.
fn ix_add(d: &mut DiskFs, i: u64)
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  if blen(d.ix) != IX_BYTES || i >= d.slots {
    return;
  }
  if d.ixn >= IX_MAX {
    ix_rebuild(&mut d);
    return;
  }
  let n = cast[u64](dent_byte(d, i, E_NLEN));
  if n > DNAME_MAX {
    return;
  }
  let mut c = ix_hash(dent_parent(d, i), d.dir, i * DENT + E_NAME, n);
  let mut t = 0;
  while t < IX_CELLS && ix_cell(d, c) != 0
    invariant t <= IX_CELLS && c < IX_CELLS && blen(d.ix) == IX_BYTES && disk_ok(d)
  {
    c = (c + 1) % IX_CELLS;
    t = t + 1;
  }
  if t < IX_CELLS {
    ix_put(&mut d, c, i + 1);
    d.ixn = d.ixn + 1;
  }
}

/// Builds the index from the directory (or does nothing when it is small or
/// memory is short: lookups then read every entry).
fn ix_rebuild(d: &mut DiskFs)
  requires disk_ok(d)
  ensures disk_ok(d)
{
  if d.slots <= IX_MIN {
    return;
  }
  if blen(d.ix) != IX_BYTES {
    let nb = try_balloc(IX_BYTES);
    if blen(nb) != IX_BYTES {
      bfree(nb);
      return;
    }
    let prev = d.ix;
    d.ix = nb;
    bfree(prev);
  }
  zero(&mut d.ix, 0, IX_BYTES);
  d.ixn = 0;
  let mut i = 0;
  while i < d.slots
    invariant i <= d.slots && d.slots <= DSLOTS && blen(d.ix) == IX_BYTES && d.ixn < IX_MAX && disk_ok(d)
  {
    if dent_live(d, i) && d.ixn < IX_MAX - 1 {
      let n = cast[u64](dent_byte(d, i, E_NLEN));
      if n <= DNAME_MAX {
        let mut c = ix_hash(dent_parent(d, i), d.dir, i * DENT + E_NAME, n);
        let mut t = 0;
        while t < IX_CELLS && ix_cell(d, c) != 0
          invariant t <= IX_CELLS && c < IX_CELLS && blen(d.ix) == IX_BYTES && disk_ok(d)
        {
          c = (c + 1) % IX_CELLS;
          t = t + 1;
        }
        if t < IX_CELLS {
          ix_put(&mut d, c, i + 1);
          d.ixn = d.ixn + 1;
        }
      }
    }
    i = i + 1;
  }
}

/// The entry in directory p named name[from..from + n], or DSLOTS.
fn disk_child(d: &DiskFs, p: u64, name: &Bytes, from: u64, n: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name)
  ensures result <= DSLOTS
{
  if blen(d.ix) == IX_BYTES && d.slots > IX_MIN {
    let mut c = ix_hash(p, name, from, n);
    let mut t = 0;
    while t < IX_CELLS
      invariant t <= IX_CELLS && c < IX_CELLS && blen(d.ix) == IX_BYTES && disk_ok(d)
    {
      let v = ix_cell(d, c);
      if v == 0 {
        return DSLOTS;
      }
      if v <= DSLOTS && dent_named(d, v - 1, name, from, n) && dent_parent(d, v - 1) == p {
        return v - 1;
      }
      c = (c + 1) % IX_CELLS;
      t = t + 1;
    }
    return DSLOTS;
  }
  let mut i = 0;
  while i < d.slots
    invariant i <= d.slots && d.slots <= DSLOTS
  {
    if dent_named(d, i, name, from, n) && dent_parent(d, i) == p {
      return i;
    }
    i = i + 1;
  }
  return DSLOTS;
}

/// Is anything in directory p?
fn disk_has_children(d: &DiskFs, p: u64) -> bool
  requires disk_ok(d)
{
  let mut i = 0;
  while i < d.slots
    invariant i <= d.slots && d.slots <= DSLOTS
  {
    if dent_live(d, i) && dent_parent(d, i) == p {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// The entry at the path name[from..from + n] (components separated by
/// "/", from the top directory), or DSLOTS.
fn disk_find(d: &DiskFs, name: &Bytes, from: u64, n: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name)
  ensures result <= DSLOTS
{
  let end = from + n;
  let mut p = DTOP;
  let mut s = from;
  while s < end
    invariant from <= s && s <= end
  {
    let mut e = s;
    while e < end && bget(name, e) != 47
      invariant s <= e && e <= end
    {
      e = e + 1;
    }
    let c = disk_child(d, p, name, s, e - s);
    if c >= DSLOTS {
      return DSLOTS;
    }
    if e == end {
      return c;
    }
    if !dent_dir(d, c) {
      return DSLOTS;
    }
    p = c;
    s = e + 1;
  }
  return DSLOTS;
}

/// Creates an empty file (or directory) at the path name[from..from + n].
/// Its directory must exist, its last component be 1 to DNAME_MAX bytes,
/// and the name be free. Returns the entry or DSLOTS.
fn disk_create(d: &mut DiskFs, name: &Bytes, from: u64, n: u64, dir: bool, now: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name)
  ensures disk_ok(d) && result <= DSLOTS
{
  return disk_entry(&mut d, name, from, n, dir, DSLOTS, now);
}

/// Creates a hard link at the path name[from..from + n] to file entry t
/// (the caller checks it is one), as disk_create does a file: one sector
/// write. Returns the new entry, or DSLOTS.
fn disk_link(d: &mut DiskFs, name: &Bytes, from: u64, n: u64, t: u64, now: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name) && t < DSLOTS
  ensures disk_ok(d) && result <= DSLOTS
{
  return disk_entry(&mut d, name, from, n, false, t, now);
}

/// The file entry that entry i is a hard link to, or DSLOTS if it is not
/// one.
fn disk_link_of(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures result <= DSLOTS
{
  if i >= d.slots || cast[u64](dent_byte(d, i, 0)) != K_LINK {
    return DSLOTS;
  }
  let t = dent_get(d, i, E_LINK);
  if t >= DSLOTS {
    return DSLOTS;
  }
  return t;
}

/// A hard link to entry t, or DSLOTS if there is none. Only the slots the
/// directory holds now can be links (disk_link_of), so the scans stop there.
fn disk_link_to(d: &DiskFs, t: u64) -> u64
  requires disk_ok(d)
  ensures result <= DSLOTS
{
  let mut i = 0;
  while i < d.slots
    invariant i <= d.slots && d.slots <= DSLOTS
  {
    if disk_link_of(d, i) == t {
      return i;
    }
    i = i + 1;
  }
  return DSLOTS;
}

/// How many hard links name entry t, besides its own name.
fn disk_links(d: &DiskFs, t: u64) -> u64
  requires disk_ok(d)
  ensures result <= DSLOTS
{
  if !d.links {
    return 0;
  }
  let mut c = 0;
  let mut i = 0;
  while i < d.slots
    invariant i <= d.slots && d.slots <= DSLOTS && c <= i
  {
    if disk_link_of(d, i) == t {
      c = c + 1;
    }
    i = i + 1;
  }
  return c;
}

/// Do entries i and t have the same parent and last component?
fn same_name(d: &DiskFs, i: u64, t: u64) -> bool
  requires disk_ok(d) && i < DSLOTS && t < DSLOTS
{
  if dent_get(d, i, E_PARENT) != dent_get(d, t, E_PARENT) || dent_byte(d, i, E_NLEN) != dent_byte(d, t, E_NLEN) {
    return false;
  }
  if i >= d.dcap * DPB || t >= d.dcap * DPB {
    return false;
  }
  return bytes_span_eq(d.dir, i * DENT + E_NAME, d.dir, t * DENT + E_NAME, DENT - E_NAME);
}

/// File entry i takes the name (parent and last component) of hard link l,
/// which names it, and l goes: how a file that has links loses its own
/// name. The commit is the one sector write of i's entry; l's removal is a
/// second write unless both share a sector. A power cut between them
/// leaves l naming i under i's new name, which the next mount drops, so
/// either the old state or the new one survives.
fn disk_take_name(d: &mut DiskFs, i: u64, l: u64) -> bool
  requires disk_ok(d) && i < DSLOTS && l < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  if i == l || i >= d.slots || dent_byte(d, i, 0) != 1 || disk_link_of(d, l) != i {
    return false;
  }
  let mut save = balloc(DENT);
  let mut j = 0;
  while j < DENT
    invariant j <= DENT && blen(save) == DENT && disk_ok(d)
  {
    bset(&mut save, j, dent_byte(d, i, j));
    j = j + 1;
  }
  dent_set(&mut d, i, E_PARENT, dent_get(d, l, E_PARENT));
  dent_setb(&mut d, i, E_NLEN, dent_byte(d, l, E_NLEN));
  j = E_NAME;
  while j < DENT
    invariant j <= DENT && disk_ok(d)
  {
    dent_setb(&mut d, i, j, dent_byte(d, l, j));
    j = j + 1;
  }
  let shared = i / 2 == l / 2;       // two entries to a sector
  if l < d.free0 {
    d.free0 = l;
  }
  if shared {
    dent_setb(&mut d, l, E_KIND, 0);
  }
  if !ent_flush(&mut d, i) {
    j = 0;
    while j < DENT
      invariant j <= DENT && blen(save) == DENT && disk_ok(d)
    {
      dent_setb(&mut d, i, j, bget(save, j));
      j = j + 1;
    }
    if shared {
      dent_setb(&mut d, l, E_KIND, cast[u8](K_LINK));
    }
    bfree(save);
    return false;
  }
  bfree(save);
  if !shared {
    dent_setb(&mut d, l, E_KIND, 0);
    ent_flush(&mut d, l);               // if this fails, the next mount drops l
  }
  ix_add(&mut d, i);
  return true;
}

/// disk_create, or a hard link to entry `link` when it is below DSLOTS.
fn disk_entry(d: &mut DiskFs, name: &Bytes, from: u64, n: u64, dir: bool, link: u64, now: u64) -> u64
  requires disk_ok(d) && from + n <= blen(name)
  ensures disk_ok(d) && result <= DSLOTS
{
  // A new file's entry waits for the next commit (ent_lazy). A directory or
  // a link is written at once: a directory must be on the disk before the
  // entries inside it, and a link before it names a file.
  let lazy = !dir && link >= DSLOTS;
  if !lazy {
    disk_drain(&mut d);               // queued writes reach the disk first
  }
  let end = from + n;
  let mut k = end;
  while k > from && bget(name, k - 1) != 47
    invariant from <= k && k <= end
  {
    k = k - 1;
  }
  let mut p = DTOP;
  if k > from {
    p = disk_find(d, name, from, k - 1 - from);
    if p >= DSLOTS || !dent_dir(d, p) {
      return DSLOTS;
    }
  }
  let l = end - k;
  if l == 0 || l > DNAME_MAX || disk_child(d, p, name, k, l) < DSLOTS {
    return DSLOTS;
  }
  let mut i = d.free0;
  while i < DSLOTS
    invariant i <= DSLOTS && disk_ok(d)
  {
    if i == d.slots {
      disk_drain(&mut d);               // the new block is written in place
      if !dir_grow(&mut d) {
        return DSLOTS;                  // the directory is full, or so is the disk
      }
    }
    if i != DTOP && !dent_used(d, i) {
      dent_zero(&mut d, i, 0, DENT);
      if dir {
        dent_setb(&mut d, i, E_KIND, 2);
        dent_set(&mut d, i, E_MODE, MODE_DIR);
      } else if link < DSLOTS {
        dent_setb(&mut d, i, E_KIND, cast[u8](K_LINK));
        dent_set(&mut d, i, E_LINK, link);
        d.links = true;
      } else {
        dent_setb(&mut d, i, E_KIND, 1);
        dent_set(&mut d, i, E_MODE, MODE_FILE);
      }
      dent_setb(&mut d, i, E_NLEN, cast[u8](l));
      dent_set(&mut d, i, E_PARENT, p);
      dent_set(&mut d, i, E_MTIME, now);
      let mut j = 0;
      while j < l
        invariant j <= l && disk_ok(d)
      {
        dent_setb(&mut d, i, E_NAME + j, bget(name, k + j));
        j = j + 1;
      }
      let mut written = false;
      if lazy {
        written = ent_lazy(&mut d, i);
      } else {
        written = ent_flush(&mut d, i);
      }
      if !written {
        dent_setb(&mut d, i, E_KIND, 0);
        return DSLOTS;
      }
      d.free0 = i;
      ix_add(&mut d, i);
      return i;
    }
    i = i + 1;
  }
  return DSLOTS;
}

/// Moves entry i to the path name[from..from + n]: its directory must
/// exist and not be i or inside i, its last component be 1 to DNAME_MAX
/// bytes, and the name be free. One sector write, so a power cut leaves
/// the old name or the new one.
fn disk_move(d: &mut DiskFs, i: u64, name: &Bytes, from: u64, n: u64) -> bool
  requires disk_ok(d) && i < DSLOTS && from + n <= blen(name)
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  if !dent_live(d, i) {
    return false;
  }
  let end = from + n;
  let mut k = end;
  while k > from && bget(name, k - 1) != 47
    invariant from <= k && k <= end
  {
    k = k - 1;
  }
  let mut p = DTOP;
  if k > from {
    p = disk_find(d, name, from, k - 1 - from);
    if p >= DSLOTS || !dent_dir(d, p) {
      return false;
    }
  }
  let l = end - k;
  if l == 0 || l > DNAME_MAX || disk_child(d, p, name, k, l) < DSLOTS {
    return false;
  }
  // The new directory, and each one above it, must not be i.
  let mut c = p;
  let mut steps = 0;
  while c < DSLOTS && c != DTOP && steps <= DSLOTS
    invariant steps <= DSLOTS + 1
  {
    if c == i {
      return false;
    }
    c = dent_parent(d, c);
    steps = steps + 1;
  }
  let mut save = balloc(DENT);
  let mut j = 0;
  while j < DENT
    invariant j <= DENT && blen(save) == DENT && disk_ok(d)
  {
    bset(&mut save, j, dent_byte(d, i, j));
    j = j + 1;
  }
  dent_set(&mut d, i, E_PARENT, p);
  dent_setb(&mut d, i, E_NLEN, cast[u8](l));
  dent_zero(&mut d, i, E_NAME, DENT);
  j = 0;
  while j < l
    invariant j <= l && disk_ok(d)
  {
    dent_setb(&mut d, i, E_NAME + j, bget(name, k + j));
    j = j + 1;
  }
  let ok = ent_flush(&mut d, i);
  if !ok {
    // As after a failed write: memory keeps the old name.
    j = 0;
    while j < DENT
      invariant j <= DENT && blen(save) == DENT && disk_ok(d)
    {
      dent_setb(&mut d, i, j, bget(save, j));
      j = j + 1;
    }
  }
  bfree(save);
  if ok {
    ix_add(&mut d, i);
  }
  return ok;
}

/// Removes entry i (a file, or an empty directory: the caller checks).
fn disk_remove(d: &mut DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  // A file whose last writes are still in a batch that was never queued
  // goes without them reaching the disk. The entry on the disk still names
  // the blocks of before the batch, so those (not the batch's, which are
  // only in memory) are what the removal frees.
  let mut dropped = false;
  let mut oldroot = 0;
  if d.pw == i + 1 && dent_byte(d, i, E_KIND) == 1 {
    disk_wait(&mut d);
    if d.pw == i + 1 {
      let s = i / 2;
      let b = dir_block(d, s / BSECT);
      if b != 0 && b < MAX_BLOCKS && blk_read(&mut d.dev, d.plo + b * BSECT + s % BSECT, &mut d.sec) {
        oldroot = tree_in(d, d.sec, i % 2 * DENT + E_ROOT);
        dropped = true;
      }
    }
  }
  if !dropped {
    disk_drain(&mut d);               // queued writes reach the disk first
  }
  let r = dent_tree(d, i);
  let file = dent_byte(d, i, E_KIND) == 1 || cast[u64](dent_byte(d, i, E_KIND)) == K_ORPHAN;
  dent_setb(&mut d, i, E_KIND, 0);
  if i < d.free0 {
    d.free0 = i;
  }
  if !ent_flush(&mut d, i) {
    return false;
  }
  if dropped {
    if oldroot != 0 {
      walk(&mut d, oldroot, 0);
    }
    batch_drop(&mut d);
  } else if file && r != 0 {
    walk(&mut d, r, 0);
  }
  return true;
}

/// Forgets the batch of writes without queueing it: the blocks it made
/// (only in the cache, held) are free again. The blocks it replaced belong
/// to the file as the disk has it, which the caller frees.
fn batch_drop(d: &mut DiskFs)
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  let n = d.pn;
  let mut j = 0;
  while j < n
    invariant j <= n && n == d.pn && n <= BATCH_MAX && disk_ok(d)
  {
    let b = get(d.pb, j);
    dq_unhold(&mut d.q, b);
    free_block(&mut d, b);
    j = j + 1;
  }
  d.pn = 0;
  d.on = 0;
  d.pw = 0;
}

/// Copies the last component of entry i's name into buf from `at`.
/// Returns its length, or NO_DISK_FILE if the entry is free or buf too
/// short.
fn disk_comp(d: &DiskFs, i: u64, buf: &mut Bytes, at: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures blen(buf) == old(blen(buf))
  ensures result == NO_DISK_FILE || (at <= blen(buf) && result <= blen(buf) - at && result <= DNAME_MAX)
{
  if !dent_live(d, i) {
    return NO_DISK_FILE;
  }
  let n = cast[u64](dent_byte(d, i, E_NLEN));
  if n > DNAME_MAX || at > blen(buf) || n > blen(buf) - at {
    return NO_DISK_FILE;
  }
  let l = blen(buf);
  let mut k = 0;
  while k < n
    invariant k <= n && blen(buf) == l
  {
    bset(&mut buf, at + k, dent_byte(d, i, E_NAME + k));
    k = k + 1;
  }
  return n;
}

/// Copies the whole path of entry i (from the top directory, without
/// "disk/") into buf from `at`. Returns its length, or NO_DISK_FILE if the
/// entry is free, its parents are damaged, or buf is too short.
fn disk_name(d: &DiskFs, i: u64, buf: &mut Bytes, at: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
  ensures blen(buf) == old(blen(buf))
  ensures result == NO_DISK_FILE || (at <= blen(buf) && result <= blen(buf) - at)
{
  // First the length: the components and a "/" before each but the first.
  let mut total = 0;
  let mut c = i;
  let mut steps = 0;
  while c < DSLOTS && c != DTOP
    invariant steps <= DSLOTS && total <= steps * (DNAME_MAX + 1)
  {
    let l = cast[u64](dent_byte(d, c, E_NLEN));
    if !dent_live(d, c) || l == 0 || l > DNAME_MAX || steps == DSLOTS {
      return NO_DISK_FILE;      // free, damaged, or a cycle
    }
    total = total + l + 1;
    steps = steps + 1;
    c = dent_parent(d, c);
  }
  if c != DTOP || total == 0 || at > blen(buf) || total - 1 > blen(buf) - at {
    return NO_DISK_FILE;
  }
  total = total - 1;
  // Then the components, from the last one back.
  let bl = blen(buf);
  let mut e = at + total;
  c = i;
  while c < DSLOTS && c != DTOP && e > at
    invariant at <= e && e <= bl && blen(buf) == bl
  {
    let l = cast[u64](dent_byte(d, c, E_NLEN));
    if l > e - at || l > DNAME_MAX {
      return NO_DISK_FILE;
    }
    let mut k = 0;
    while k < l
      invariant k <= l && blen(buf) == bl
    {
      bset(&mut buf, e - l + k, dent_byte(d, c, E_NAME + k));
      k = k + 1;
    }
    e = e - l;
    if e > at {
      e = e - 1;
      bset(&mut buf, e, 47);
    }
    c = dent_parent(d, c);
  }
  return total;
}

// ---------------------------------------------------------------- data

/// The block holding block b of the file with root map `root`: 0 for a
/// hole, DISK_MISS if a map it needs is not in the cache yet (a read of it
/// is queued, or will be once the queue has room).
fn data_ptr(d: &mut DiskFs, tree: u64, b: u64) -> u64
  requires disk_ok(d) && b < SEG_BLOCKS * PTRS
  ensures disk_ok(d)
  ensures result == DISK_MISS || result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS)
{
  let mut root = tree;
  let mut bb = b;
  if tree >= SEG_FLAG {
    // A super map: the root map of the block's 1 GiB, then as below.
    if tree < SEG_FLAG + DATA_B0 || tree >= SEG_FLAG + MAX_BLOCKS {
      return 0;
    }
    let u = dq_want(&mut d.q, tree - SEG_FLAG);
    if u >= d.q.nc {
      return DISK_MISS;
    }
    root = ptr_in(d, d.q.cache, u * BLOCK + 8 * (bb / SEG_BLOCKS));
    bb = bb % SEG_BLOCKS;
  } else if bb >= SEG_BLOCKS {
    return 0;                         // a single root map reaches the first 1 GiB only
  }
  if root < DATA_B0 || root >= MAX_BLOCKS {
    return 0;
  }
  let s = dq_want(&mut d.q, root);
  if s >= d.q.nc {
    return DISK_MISS;
  }
  let l = ptr_in(d, d.q.cache, s * BLOCK + 8 * (bb / PTRS));
  if l == 0 {
    return 0;
  }
  let t = dq_want(&mut d.q, l);
  if t >= d.q.nc {
    return DISK_MISS;
  }
  return ptr_in(d, d.q.cache, t * BLOCK + 8 * (bb % PTRS));
}

/// Reads up to n bytes of the file in entry i from offset `off` into the
/// start of buf, from the block cache. Returns the count, short at the end
/// of the file; NO_DISK_FILE if there is no such file or the disk is dead;
/// or DISK_MISS if some of it is not in the cache: reads of what is missing
/// (and of the next few blocks) are queued, and the caller tries again once
/// the queue has moved.
fn disk_read(d: &mut DiskFs, i: u64, off: u64, buf: &mut Bytes, n: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf)
  ensures disk_ok(d) && blen(buf) == old(blen(buf))
  ensures result <= n || result == NO_DISK_FILE || result == DISK_MISS
{
  let size = disk_size(d, i);
  if size == NO_DISK_FILE || d.q.dead {
    return NO_DISK_FILE;
  }
  if off >= size {
    return 0;
  }
  let mut want = size - off;
  if want > n {
    want = n;
  }
  let root = dent_tree(d, i);
  let l = blen(buf);
  let mut missing = false;
  let mut k = 0;
  while k < want
    invariant k <= want && want <= n && n <= blen(buf) && blen(buf) == l && disk_ok(d)
    invariant off + want <= DFILE_MAX && want <= size
  {
    let a = off + k;
    let o = a % BLOCK;
    let mut m = BLOCK - o;
    if m > want - k {
      m = want - k;
    }
    let p = data_ptr(&mut d, root, a / BLOCK);
    if p == DISK_MISS {
      missing = true;
    } else if p == 0 {
      zero(&mut buf, k, k + m);
    } else {
      let s = dq_want(&mut d.q, p);
      if s >= d.q.nc {
        missing = true;
        read_ahead(&mut d, root, a / BLOCK + 1, size);
      } else {
        bcopy(&mut buf, k, d.q.cache, s * BLOCK + o, m);
      }
    }
    k = k + m;
  }
  if missing {
    return DISK_MISS;
  }
  return want;
}

const READ_AHEAD: u64 = 32;           // blocks queued past one a read missed

/// Queues reads of the file's blocks from block b on (up to READ_AHEAD,
/// within `size` bytes), whose maps are cached already.
fn read_ahead(d: &mut DiskFs, root: u64, b: u64, size: u64)
  requires disk_ok(d) && b <= SEG_BLOCKS * PTRS && size <= DFILE_MAX
  ensures disk_ok(d)
{
  let mut c = 0;
  while c < READ_AHEAD && b + c < SEG_BLOCKS * PTRS && (b + c) * BLOCK < size && d.q.r.n + 8 < NQ
    invariant disk_ok(d)
  {
    let p = data_ptr(&mut d, root, b + c);
    if p != DISK_MISS && p != 0 {
      dq_want(&mut d.q, p);
    }
    c = c + 1;
  }
}

/// disk_read for callers that cannot sleep (loading a program, mmap):
/// waits for the queue instead.
fn disk_read_wait(d: &mut DiskFs, i: u64, off: u64, buf: &mut Bytes, n: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf)
  ensures disk_ok(d) && blen(buf) == old(blen(buf))
  ensures result <= n || result == NO_DISK_FILE
{
  let mut tries = 0;
  let l = blen(buf);
  while tries < 8
    invariant disk_ok(d) && blen(buf) == l
  {
    let r = disk_read(&mut d, i, off, &mut buf, n);
    if r != DISK_MISS {
      return r;
    }
    disk_drain(&mut d);
    tries = tries + 1;
  }
  return NO_DISK_FILE;
}

/// How many bytes of block b a file of `size` bytes holds.
fn valid_in(size: u64, b: u64) -> u64
  requires b < SEG_BLOCKS * PTRS
  ensures result <= BLOCK
{
  if size <= b * BLOCK {
    return 0;
  }
  if size - b * BLOCK > BLOCK {
    return BLOCK;
  }
  return size - b * BLOCK;
}

/// Copies block b from the cache into `out`, or zeros for b == 0. False
/// if it is not cached (a read of it is queued, or will be).
fn gather(q: &mut DiskQ, b: u64, out: &mut Bytes) -> bool
  requires dq_ok(q) && blen(out) == BLOCK
  ensures dq_ok(q) && blen(out) == BLOCK
{
  if b == 0 {
    zero(&mut out, 0, BLOCK);
    return true;
  }
  let s = dq_want(&mut q, b);
  if s >= q.nc {
    return false;
  }
  bcopy(&mut out, 0, q.cache, s * BLOCK, BLOCK);
  return true;
}

/// Turns the old data block in `blk` (valid bytes of it) into the new one:
/// zeros above `valid`, then wm bytes of buf[at..] at offset wo.
fn patch(blk: &mut Bytes, valid: u64, buf: &Bytes, at: u64, wo: u64, wm: u64)
  requires blen(blk) == BLOCK && valid <= BLOCK && wo + wm <= BLOCK && at + wm <= blen(buf)
  ensures blen(blk) == BLOCK
{
  zero(&mut blk, valid, BLOCK);
  bcopy(&mut blk, wo, buf, at, wm);
}

// ---------------------------------------------------------------- batches of writes

// A write used to be a transaction of its own: its blocks, a flush, the
// directory block, a flush, the release of what it replaced. For a program
// writing a file in 4 KiB pieces that was four device commands a piece
// (the data, the two maps, the directory block), each a round trip, and
// the writer waited for all of them.
//
// Now consecutive writes to one file share a transaction, a batch. The
// blocks a batch makes (pb: new data blocks and new copies of the maps) are
// named by nothing on the disk, so a later write in the same batch changes
// them in place instead of making more copies. They sit in the cache,
// held (src/diskq.bastio), and nothing is queued for them. The blocks the
// batch replaced (ob) stay in use, as the disk still names them. The entry
// in memory already has the new root and size, so readers see every write
// at once. disk_commit then queues what one write used to: the held
// blocks, a flush, the directory block holding the entry, a flush, the
// release of ob, and the end of the transaction. So a power cut leaves the
// file as it was before the batch or with all of it, and the old blocks
// are reused only after the entry that stopped naming them is on the disk,
// as before; a write call is still entirely there or not at all.
//
// A batch commits when it has BATCH_MAX blocks, when a write to another file
// begins, when anything else changes the disk (disk_drain), when it is
// BATCH_TICKS old (disk_pump), and on fsync (disk_sync). A write no longer
// waits for the disk, so it is on the disk only after one of those.

/// Is block b one the batch made?
fn in_batch(d: &DiskFs, b: u64) -> bool
  requires disk_ok(d)
{
  let mut j = 0;
  while j < d.pn
    invariant j <= d.pn && d.pn <= BATCH_MAX && len(d.pb) == BATCH_MAX
  {
    if get(d.pb, j) == b {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// The block a write puts the new version of a block that is `old` in (0:
/// a hole): the same block if the batch made it, else a free one (0 if
/// there is none), which the caller records with batch_made.
fn batch_pick(d: &mut DiskFs, prev: u64) -> u64
  requires disk_ok(d)
  ensures disk_ok(d) && d.pn == old(d.pn) && d.on == old(d.on) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
  ensures result == 0 || (result >= DATA_B0 && result < MAX_BLOCKS) || result == prev
{
  if prev != 0 && in_batch(d, prev) {
    return prev;
  }
  return alloc_block(&mut d);
}

/// Notes that a write put the new version of a block that was `prev` in
/// block `now`: if that is a new block, the batch made it, and the block it
/// replaced (if any) goes when the batch commits. Room: disk_write checked.
fn batch_made(d: &mut DiskFs, prev: u64, now: u64)
  requires disk_ok(d) && d.pn < BATCH_MAX && d.on < OB_MAX
  ensures disk_ok(d) && d.pn <= old(d.pn) + 1 && d.on <= old(d.on) + 1
{
  if now == prev {
    return;
  }
  d.pb = set(d.pb, d.pn, now);
  d.pn = d.pn + 1;
  if prev != 0 {
    d.ob = set(d.ob, d.on, prev);
    d.on = d.on + 1;
  }
}

/// Makes the superblock say that files may have super maps (BSTDISK5), on
/// the disk, before a write makes the first. False if that cannot be done.
fn set_big(d: &mut DiskFs) -> bool
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  let was = get_u64(d.sb, 0);
  if was == DISK_MAGIC5 {
    return true;
  }
  disk_drain(&mut d);
  if d.q.dead {
    return false;
  }
  put_u64(&mut d.sb, 0, DISK_MAGIC5);
  if !sec_out(&mut d.dev, d.plo, &mut d.sec, 0, d.sb, 0) {
    put_u64(&mut d.sb, 0, was);
    return false;
  }
  return true;
}

/// Entry i has changed in memory, and a change of this kind does not wait
/// for the disk: its directory block is queued with the next commit (or
/// when disk_pump finds it BATCH_TICKS old), together with the batch's, so
/// a file created, given an owner and a mode and then written costs the
/// disk one commit, not a sector write for each step. A power cut before
/// that leaves the entry as it was. False if the entry cannot be put there
/// and the sector write failed.
fn ent_lazy(d: &mut DiskFs, i: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  let db = i * DENT / BLOCK;
  if db >= d.dcap || d.q.dead || dir_block(d, db) == 0 {
    disk_drain(&mut d);
    return ent_flush(&mut d, i);
  }
  let mut j = 0;
  while j < d.pdn && j < len(d.pd)
    invariant j <= len(d.pd) && disk_ok(d)
  {
    if get(d.pd, j) == db {
      return true;
    }
    j = j + 1;
  }
  if d.pdn >= PD_MAX || d.pdn >= len(d.pd) {
    disk_drain(&mut d);
  }
  if d.pdn >= PD_MAX || d.pdn >= len(d.pd) {
    return false;
  }
  if d.pdn == 0 {
    d.ppt = d.tick;
  }
  d.pd = set(d.pd, d.pdn, db);
  d.pdn = d.pdn + 1;
  return true;
}

/// Queues the commit of the batch (nothing if there is none). False, with
/// nothing changed, if the queue has no room for it yet. On true the
/// transaction's number is in d.txn.
fn disk_commit(d: &mut DiskFs) -> bool
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  if d.pw == 0 && d.pdn == 0 {
    return true;
  }
  let mut np = d.pdn;
  if np > PD_MAX || np > len(d.pd) {
    np = 0;                           // (not reached: ent_lazy keeps pdn within pd)
  }
  if !dq_fits(d.q, 1 + np, d.pn + d.on + np + 4) {
    return false;
  }
  let n = d.pn;
  let m = d.on;
  let mut ok = true;
  let mut j = 0;
  while j < n
    invariant j <= n && n == d.pn && n <= BATCH_MAX && disk_ok(d)
  {
    ok = dq_queue_held(&mut d.q, get(d.pb, j)) && ok;
    j = j + 1;
  }
  let mut skip = DIR_BLOCKS;            // the batch entry's block, not queued twice
  if d.pw != 0 {
    ok = ok && dq_flush(&mut d.q);
    let db = (d.pw - 1) * DENT / BLOCK;
    let dbn = dir_block(d, db);
    ok = ok && dbn != 0 && db < d.dcap && dq_put(&mut d.q, dbn, d.dir, db * BLOCK, false);
    skip = db;
  }
  j = 0;
  while j < np
    invariant j <= np && np <= PD_MAX && np <= len(d.pd) && disk_ok(d)
  {
    let pb = get(d.pd, j);
    if pb != skip {
      let mut pbn = 0;
      if pb < d.dcap {
        pbn = dir_block(d, pb);
      }
      ok = ok && pbn != 0 && dq_put(&mut d.q, pbn, d.dir, pb * BLOCK, false);
    }
    j = j + 1;
  }
  ok = ok && dq_flush(&mut d.q);
  j = 0;
  while j < m
    invariant j <= m && m == d.on && m <= OB_MAX && disk_ok(d)
  {
    release(&mut d.q, get(d.ob, j));
    j = j + 1;
  }
  let t = dq_end(&mut d.q);
  d.pn = 0;
  d.on = 0;
  d.pw = 0;
  d.pdn = 0;
  if !ok || t == 0 {
    dq_kill(&mut d.q);                // dq_fits said there was room: not reached
    return true;
  }
  d.txn = t;
  return true;
}

/// Commits the batch for the code that waits for the queue to empty,
/// letting the queue move until there is room for it.
fn settle_batch(d: &mut DiskFs)
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  if d.pw == 0 && d.pdn == 0 {
    return;
  }
  let keep = d.txn;
  let blocks0 = d.blocks;
  let slots0 = d.slots;
  let mut spins = 0;
  while (d.pw != 0 || d.pdn != 0) && spins < DQ_SPINS + 2 * NQ + 2
    invariant disk_ok(d) && d.blocks == blocks0 && d.slots == slots0
  {
    if disk_commit(&mut d) {
      d.txn = keep;
      return;
    }
    let mut now = 0;
    if spins >= DQ_SPINS && d.q.since < 0x4000000000000000 {
      now = d.q.since + DQ_TICKS + 1;
    }
    let r = dq_pump(&mut d.q, &mut d.dev, now);
    if r >= DQ_FREED {
      free_block(&mut d, r - DQ_FREED);
    }
    spins = spins + 1;
  }
  if d.pw != 0 || d.pdn != 0 {
    dq_kill(&mut d.q);
    d.pw = 0;
    d.pn = 0;
    d.on = 0;
    d.pdn = 0;
  }
  d.txn = keep;
}

/// For fsync: commits the batch and leaves in d.txn the transaction the
/// caller waits for, the last one queued if there is no batch. If the
/// queue has no room for the commit yet, waits for it to have.
fn disk_sync(d: &mut DiskFs)
  requires disk_ok(d)
  ensures disk_ok(d) && d.blocks == old(d.blocks) && d.slots == old(d.slots)
{
  if d.pw != 0 || d.pdn != 0 {
    settle_batch(&mut d);
  }
  if d.q.next > 1 && d.q.done < d.q.next - 1 {
    d.txn = d.q.next - 1;
  }
}

/// Queues the release of block b once the transaction ends (nothing for 0).
fn release(q: &mut DiskQ, b: u64)
  requires dq_ok(q)
  ensures dq_ok(q)
{
  if b != 0 {
    dq_release(&mut q, b);
  }
}

/// Writes the first n bytes (at most a block) of buf to the file in entry
/// i at `off`. A gap past the old end reads as zeros. The write happens
/// entirely or not at all, even across a power cut (see the top of this
/// file).
///
/// The disk I/O is queued, not waited for, and the write itself queues
/// nothing: its blocks are held in the cache for the batch (see "batches of
/// writes" above). First every old block the
/// write needs (the maps on its path, and a data block it changes only in
/// part) must be in the cache; if one is not, its read is queued and this
/// returns DISK_MISS, having changed nothing, for the caller to try again
/// once the queue has moved. Then the new blocks go into the cache, held for the batch,
/// and the entry in memory takes the new root and size; disk_commit queues
/// them later. Readers see the new contents at once. Returns the count (short only at the 1 GiB
/// limit), 0 if the disk is full or dead, NO_DISK_FILE if there is no
/// file, or DISK_MISS.
fn disk_write(d: &mut DiskFs, i: u64, off: u64, buf: &Bytes, n: u64, now: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf) && n <= BLOCK
  ensures disk_ok(d)
  ensures result <= n || result == NO_DISK_FILE || result == DISK_MISS
{
  let size = disk_size(d, i);
  if size == NO_DISK_FILE || dent_dir(d, i) {
    return NO_DISK_FILE;
  }
  if off >= DFILE_MAX || n == 0 || d.q.dead {
    return 0;
  }
  // A write stays within one 1 GiB segment of the file (the caller
  // continues with the rest).
  let seg = off / SEG_BYTES;
  let mut want = (seg + 1) * SEG_BYTES - off;
  if want > n {
    want = n;
  }
  let end = off + want;
  let mut newsize = size;
  if end > newsize {
    newsize = end;
  }
  let tree0 = dent_tree(d, i);
  let big = tree0 >= SEG_FLAG || seg > 0;
  if big && !set_big(&mut d) {
    return 0;
  }
  // Block numbers in the file (for valid_in) and in the segment's root map.
  let ba0 = off / BLOCK;
  let ba1 = (end - 1) / BLOCK;
  let b0 = ba0 % SEG_BLOCKS;
  let b1 = ba1 % SEG_BLOCKS;
  let ia = b0 / PTRS;
  let ib = b1 / PTRS;
  let mut m0 = BLOCK - off % BLOCK;
  if m0 > want {
    m0 = want;
  }
  // A batch is for one file, and has room for what a write may add.
  if d.pw != 0 && (d.pw != i + 1 || d.pn + 6 > BATCH_MAX || d.on + 6 > OB_MAX) {
    if !disk_commit(&mut d) {
      return DISK_MISS;
    }
    d.txn = 0;
  }
  if d.pn + 6 > BATCH_MAX || d.on + 6 > OB_MAX {
    return DISK_MISS;                 // (not reached: a commit empties the batch)
  }
  // Gather the maps as they are, and the old data the write keeps.
  // A file with a super map keeps the segment's root map there; one that
  // is about to get its second segment makes its root map segment 0.
  let mut sp0 = 0;
  let mut root0 = tree0;
  if big {
    if tree0 >= SEG_FLAG {
      sp0 = tree0 - SEG_FLAG;
    }
    if !gather(&mut d.q, sp0, &mut d.sp) {
      return DISK_MISS;
    }
    if tree0 < SEG_FLAG && tree0 != 0 {
      put_u64(&mut d.sp, 0, tree0);
    }
    root0 = ptr_in(d, d.sp, 8 * seg);
  }
  if !gather(&mut d.q, root0, &mut d.root) {
    return DISK_MISS;
  }
  let la0 = ptr_in(d, d.root, 8 * ia);
  let mut lb0 = 0;
  if ib != ia {
    lb0 = ptr_in(d, d.root, 8 * ib);
  }
  let ga = gather(&mut d.q, la0, &mut d.la);
  let gb = gather(&mut d.q, lb0, &mut d.lb);
  if !ga || !gb {
    return DISK_MISS;
  }
  let old0 = ptr_in(d, d.la, 8 * (b0 % PTRS));
  let mut old1 = 0;
  if b1 != b0 {
    if ib == ia {
      old1 = ptr_in(d, d.la, 8 * (b1 % PTRS));
    } else {
      old1 = ptr_in(d, d.lb, 8 * (b1 % PTRS));
    }
  }
  let v0 = valid_in(size, ba0);
  let v1 = valid_in(size, ba1);
  // A block the write covers wherever it holds data needs no reading.
  let mut keep0 = old0;
  if off % BLOCK == 0 && m0 >= v0 {
    keep0 = 0;
  }
  let mut keep1 = old1;
  if b1 == b0 || want - m0 >= v1 {
    keep1 = 0;
  }
  let g0 = gather(&mut d.q, keep0, &mut d.data);
  let g1 = gather(&mut d.q, keep1, &mut d.d2);
  if !g0 || !g1 {
    return DISK_MISS;
  }
  // Room for seven held blocks (two data, three maps, a super map, the
  // directory block at commit).
  if !dq_fits(d.q, 7, 0) {
    return DISK_MISS;
  }
  // Each new block is the batch's own copy if the batch made the old one,
  // else a free block.
  let n0 = batch_pick(&mut d, old0);
  let mut n1 = 0;
  if b1 != b0 {
    n1 = batch_pick(&mut d, old1);
  }
  let na = batch_pick(&mut d, la0);
  let mut nb = 0;
  if ib != ia {
    nb = batch_pick(&mut d, lb0);
  }
  let nr = batch_pick(&mut d, root0);
  let mut nsp = 0;
  if big {
    nsp = batch_pick(&mut d, sp0);
  }
  if n0 == 0 || (b1 != b0 && n1 == 0) || na == 0 || (ib != ia && nb == 0) || nr == 0 || (big && nsp == 0) {
    if n0 != old0 {
      free_block(&mut d, n0);
    }
    if n1 != old1 {
      free_block(&mut d, n1);
    }
    if na != la0 {
      free_block(&mut d, na);
    }
    if nb != lb0 {
      free_block(&mut d, nb);
    }
    if nr != root0 {
      free_block(&mut d, nr);
    }
    if nsp != sp0 {
      free_block(&mut d, nsp);
    }
    return 0;
  }
  batch_made(&mut d, old0, n0);
  if b1 != b0 {
    batch_made(&mut d, old1, n1);
  }
  batch_made(&mut d, la0, na);
  if ib != ia {
    batch_made(&mut d, lb0, nb);
  }
  batch_made(&mut d, root0, nr);
  if big {
    batch_made(&mut d, sp0, nsp);
  }
  // The new blocks.
  let mut k0 = 0;
  if keep0 != 0 {
    k0 = v0;
  }
  patch(&mut d.data, k0, buf, 0, off % BLOCK, m0);
  put_u64(&mut d.la, 8 * (b0 % PTRS), n0);
  let mut ok = dq_hold(&mut d.q, n0, d.data, 0);
  if b1 != b0 {
    let mut k1 = 0;
    if keep1 != 0 {
      k1 = v1;
    }
    patch(&mut d.d2, k1, buf, m0, 0, want - m0);
    if ib == ia {
      put_u64(&mut d.la, 8 * (b1 % PTRS), n1);
    } else {
      put_u64(&mut d.lb, 8 * (b1 % PTRS), n1);
    }
    ok = ok && dq_hold(&mut d.q, n1, d.d2, 0);
  }
  put_u64(&mut d.root, 8 * ia, na);
  ok = ok && dq_hold(&mut d.q, na, d.la, 0);
  if ib != ia {
    put_u64(&mut d.root, 8 * ib, nb);
    ok = ok && dq_hold(&mut d.q, nb, d.lb, 0);
  }
  ok = ok && dq_hold(&mut d.q, nr, d.root, 0);
  let mut tree1 = nr;
  if big {
    put_u64(&mut d.sp, 8 * seg, nr);
    ok = ok && dq_hold(&mut d.q, nsp, d.sp, 0);
    tree1 = nsp + SEG_FLAG;
  }
  // The entry in memory: the disk gets it when the batch commits.
  dent_set(&mut d, i, E_SIZE, newsize);
  dent_set(&mut d, i, E_ROOT, tree1);
  dent_set(&mut d, i, E_MTIME, now);
  if d.pw == 0 {
    d.pt = d.tick;
  }
  d.pw = i + 1;
  if !ok {
    dq_kill(&mut d.q);                // dq_fits said there was room: not reached
    return 0;
  }
  return want;
}

/// disk_write for the operations that still do their I/O synchronously:
/// retries until the blocks are cached, then waits for the transaction.
fn disk_write_wait(d: &mut DiskFs, i: u64, buf: &Bytes, n: u64, now: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf) && n <= BLOCK
  ensures disk_ok(d)
  ensures result <= n || result == NO_DISK_FILE
{
  return disk_write_at_wait(&mut d, i, 0, buf, n, now);
}

/// disk_write_wait at offset off.
fn disk_write_at_wait(d: &mut DiskFs, i: u64, off: u64, buf: &Bytes, n: u64, now: u64) -> u64
  requires disk_ok(d) && i < DSLOTS && n <= blen(buf) && n <= BLOCK
  ensures disk_ok(d)
  ensures result <= n || result == NO_DISK_FILE
{
  let mut tries = 0;
  while tries < 8
    invariant disk_ok(d)
  {
    let r = disk_write(&mut d, i, off, buf, n, now);
    if r != DISK_MISS {
      disk_drain(&mut d);
      d.txn = 0;
      if d.q.dead {
        return 0;
      }
      return r;
    }
    disk_drain(&mut d);
    tries = tries + 1;
  }
  return NO_DISK_FILE;
}

/// Empties the file in entry i.
fn disk_truncate(d: &mut DiskFs, i: u64, now: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  let r = dent_tree(d, i);
  if dent_get(d, i, E_SIZE) == 0 && r == 0 {
    return true;
  }
  dent_set(&mut d, i, E_SIZE, 0);
  dent_set(&mut d, i, E_ROOT, 0);
  dent_set(&mut d, i, E_MTIME, now);
  if !ent_flush(&mut d, i) {
    return false;
  }
  if r != 0 {
    walk(&mut d, r, 0);
  }
  return true;
}

/// Sets the size of the file in entry i to len bytes: growing reads as
/// zeros, shrinking drops the blocks past the end. Like a write, it happens
/// entirely or not at all (one entry-sector switch). It keeps the rule that
/// the bytes past a file's end are zeros and the blocks wholly past it are
/// holes, which is what lets growing only move the end.
fn disk_resize(d: &mut DiskFs, i: u64, size_to: u64, now: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  disk_drain(&mut d);                 // queued writes reach the disk first
  let size = disk_size(d, i);
  if size == NO_DISK_FILE || dent_dir(d, i) || size_to > DFILE_MAX {
    return false;
  }
  if size_to == 0 {
    return disk_truncate(&mut d, i, now);
  }
  let tree0 = dent_tree(d, i);
  let size_raw = dent_get(d, i, E_SIZE);
  let root_raw = dent_get(d, i, E_ROOT);
  let mtime_raw = dent_get(d, i, E_MTIME);
  // The block holding the new end, in its 1 GiB segment (seg) and in that
  // segment's root map (bl). A file with a super map keeps one root map
  // per segment there; one without has only segment 0.
  let bla = (size_to - 1) / BLOCK;
  let seg = bla / SEG_BLOCKS;
  let bl = bla % SEG_BLOCKS;
  let big = tree0 >= SEG_FLAG;
  let mut root0 = 0;
  if big {
    if !block_in(&mut d.dev, d.plo, &mut d.sec, tree0 - SEG_FLAG, &mut d.sp) {
      return false;
    }
    root0 = ptr_in(d, d.sp, 8 * seg);
  } else if seg == 0 {
    root0 = tree0;
  }
  if size_to >= size || (root0 == 0 && !big) {
    dent_set(&mut d, i, E_SIZE, size_to);
    dent_set(&mut d, i, E_MTIME, now);
    if !ent_flush(&mut d, i) {
      dent_set(&mut d, i, E_SIZE, size_raw);
      dent_set(&mut d, i, E_MTIME, mtime_raw);
      return false;
    }
    return true;
  }
  // Shrinking: copy the last block kept (its tail zeroed), its map, and
  // the root, each cut off after the new end; and the super map, if any,
  // cut off after the new end's segment.
  let il = bl / PTRS;
  let kl = bl % PTRS;
  let mut la0 = 0;
  let mut prev = 0;
  let mut nd = 0;
  let mut na = 0;
  let mut nr = 0;
  let mut ok = true;
  if root0 != 0 {
    if !block_in(&mut d.dev, d.plo, &mut d.sec, root0, &mut d.root) {
      return false;
    }
    la0 = ptr_in(d, d.root, 8 * il);
    if !block_in(&mut d.dev, d.plo, &mut d.sec, la0, &mut d.la) {
      return false;
    }
    // The old map, to free its tail once the switch is done.
    let mut c = 0;
    while c < BLOCK
      invariant c <= BLOCK && disk_ok(d)
    {
      bset(&mut d.lb, c, bget(d.la, c));
      c = c + 1;
    }
    prev = ptr_in(d, d.la, 8 * kl);
    nd = prev;
    if prev != 0 && size_to % BLOCK != 0 {
      if !block_in(&mut d.dev, d.plo, &mut d.sec, prev, &mut d.data) {
        return false;
      }
      zero(&mut d.data, size_to % BLOCK, BLOCK);
      nd = alloc_block(&mut d);
      if nd == 0 {
        return false;
      }
      if !block_out(&mut d.dev, d.plo, &mut d.sec, nd, d.data) {
        free_block(&mut d, nd);
        return false;
      }
    }
    put_u64(&mut d.la, 8 * kl, nd);
    zero(&mut d.la, 8 * kl + 8, BLOCK);
    if la0 != 0 {
      na = alloc_block(&mut d);
      ok = na != 0 && block_out(&mut d.dev, d.plo, &mut d.sec, na, d.la);
    }
    put_u64(&mut d.root, 8 * il, na);
    zero(&mut d.root, 8 * il + 8, BLOCK);
    if ok {
      nr = alloc_block(&mut d);
      ok = nr != 0 && block_out(&mut d.dev, d.plo, &mut d.sec, nr, d.root);
    }
  }
  // The new super map: the segments up to this one, and no more.
  let mut nsp = 0;
  if ok && big {
    put_u64(&mut d.sp, 8 * seg, nr);
    zero(&mut d.sp, 8 * seg + 8, BLOCK);
    nsp = alloc_block(&mut d);
    ok = nsp != 0 && block_out(&mut d.dev, d.plo, &mut d.sec, nsp, d.sp);
  }
  if !ok {
    if nd != prev {
      free_block(&mut d, nd);
    }
    free_block(&mut d, na);
    free_block(&mut d, nr);
    free_block(&mut d, nsp);
    return false;
  }
  // The switch: one sector.
  let mut tree1 = nr;
  if big {
    tree1 = nsp + SEG_FLAG;
  }
  dent_set(&mut d, i, E_SIZE, size_to);
  dent_set(&mut d, i, E_ROOT, tree1);
  dent_set(&mut d, i, E_MTIME, now);
  if !ent_flush(&mut d, i) {
    // As in disk_write: keep both trees; the next mount frees the loser.
    dent_set(&mut d, i, E_SIZE, size_raw);
    dent_set(&mut d, i, E_ROOT, root_raw);
    dent_set(&mut d, i, E_MTIME, mtime_raw);
    return false;
  }
  // Free what only the old tree held.
  if root0 != 0 {
    if nd != prev {
      free_block(&mut d, prev);
    }
    let mut k = kl + 1;
    while k < PTRS
      invariant k <= PTRS + 1 && disk_ok(d)
    {
      free_block(&mut d, ptr_in(d, d.lb, 8 * k));
      k = k + 1;
    }
    free_block(&mut d, la0);
    walk_from(&mut d, root0, il + 1, 0);
    free_block(&mut d, root0);
  }
  if big {
    // The segments past the new end, from the old super map.
    if block_in(&mut d.dev, d.plo, &mut d.sec, tree0 - SEG_FLAG, &mut d.sp) {
      let mut j = seg + 1;
      while j < PTRS
        invariant j <= PTRS + 1 && disk_ok(d)
      {
        let r = ptr_in(d, d.sp, 8 * j);
        if r != 0 {
          walk_flat(&mut d, r, 0);
        }
        j = j + 1;
      }
    }
    free_block(&mut d, tree0 - SEG_FLAG);
  }
  return true;
}

/// Entry i's mode (permission bits).
fn disk_mode(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
{
  return dent_get(d, i, E_MODE) % 65536;
}

/// Entry i's owner: user id + group id * 2^32 (each below OWN_ID_MAX).
fn disk_owner(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
{
  let w = dent_get(d, i, E_MODE) / 65536;
  return w % OWN_ID_MAX + w / OWN_ID_MAX % OWN_ID_MAX * 0x100000000;
}

/// Sets entry i's owner to user id uid and group id gid. False if the
/// entry is unused or the disk fails.
fn disk_set_owner(d: &mut DiskFs, i: u64, uid: u64, gid: u64) -> bool
  requires disk_ok(d) && i < DSLOTS && uid < OWN_ID_MAX && gid < OWN_ID_MAX
  ensures disk_ok(d)
{
  if !dent_used(d, i) {
    return false;
  }
  let w = dent_get(d, i, E_MODE) % 65536 + (uid + gid * OWN_ID_MAX) * 65536;
  if w == dent_get(d, i, E_MODE) {
    return true;                      // as it is already: nothing to write
  }
  dent_set(&mut d, i, E_MODE, w);
  return ent_lazy(&mut d, i);
}

/// Entry i's modification time, in seconds.
fn disk_mtime(d: &DiskFs, i: u64) -> u64
  requires disk_ok(d) && i < DSLOTS
{
  return dent_get(d, i, E_MTIME);
}

/// Sets entry i's mode (when `mode` is below 65536) and modification time
/// (when `mtime` is not NO_DISK_FILE): one sector write.
fn disk_set_meta(d: &mut DiskFs, i: u64, mode: u64, mtime: u64) -> bool
  requires disk_ok(d) && i < DSLOTS
  ensures disk_ok(d)
{
  if !dent_used(d, i) {
    return false;
  }
  let m0 = dent_get(d, i, E_MODE);
  let t0 = dent_get(d, i, E_MTIME);
  let mut m1 = m0;
  let mut t1 = t0;
  if mode < 65536 {
    m1 = m0 / 65536 * 65536 + mode;
  }
  if mtime != NO_DISK_FILE {
    t1 = mtime;
  }
  if m1 == m0 && t1 == t0 {
    return true;                      // as they are already: nothing to write
  }
  dent_set(&mut d, i, E_MODE, m1);
  dent_set(&mut d, i, E_MTIME, t1);
  return ent_lazy(&mut d, i);
}
