// Calendar arithmetic for the real-time clock (src/rtc.bastio) and
// /dev/rtc0 (src/lxrtc.bastio): days since 1970-01-01 and the date they fall on.

/// Days from 1970-01-01 to year-month-day (the proleptic Gregorian
/// calendar; years 2000 to 2099, what the clock can hold).
fn days_from_civil(year: u64, month: u64, day: u64) -> u64
  requires 2000 <= year && year <= 2099 && 1 <= month && month <= 12 && 1 <= day && day <= 31
  ensures result <= 47500
{
  let mut y = year;
  let mut mp = month + 9;              // March is month 0 of the year
  if month > 2 {
    mp = month - 3;
  } else {
    y = year - 1;
  }
  let era = y / 400;
  let yoe = y - era * 400;
  let doy = (153 * mp + 2) / 5 + day - 1;
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return era * 146097 + doe - 719468;
}

/// A calendar date.
struct Civil { year: u64, month: u64, day: u64 }

/// The date `days` days after 1970-01-01, for the years 2000 to 2099 (the
/// inverse of days_from_civil).
fn civil_from_days(days: u64) -> Civil
  requires 10957 <= days && days <= 47500
  ensures 2000 <= result.year && result.year <= 2100 && 1 <= result.month && result.month <= 12 && 1 <= result.day && result.day <= 31
{
  let z = days + 719468;
  let era = z / 146097;
  let doe = z - era * 146097;
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  let mp = (5 * doy + 2) / 153;
  let day = doy - (153 * mp + 2) / 5 + 1;
  let mut month = mp + 3;
  if mp >= 10 {
    month = mp - 9;
  }
  let mut year = yoe + era * 400;
  if month <= 2 {
    year = year + 1;
  }
  return Civil { year: year, month: month, day: day };
}
