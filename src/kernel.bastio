// The kernel state, built and torn down the same way on every architecture;
// what differs (the devices the file system, network and sound card sit on)
// comes in as arguments and goes back out for the architecture's own cleanup.

import "proc.bastio";
import "initfiles.bastio";

/// A kernel with no processes: `m` the pages, `disk` the file system's disk,
/// `nic` and `snd` the devices, `mice` the pointer buffer, `tsc` the clock.
fn kernel_new(mut m: Mem, disk: DiskFs, nic: Nic, snd: Snd, mice: Bytes, tsc: Tsc, at: u64, epoch: u64, cpus: u64) -> Kernel
  requires mem_ok(m) && disk_ok(disk) && nic_ok(nic) && snd_ok(snd) && blen(mice) == MICE_LEN
  ensures kok(result)
{
  let mut spaces = vec_new[Space]();
  let mut i = 0;
  while i < NPROC
    invariant i <= NPROC && vlen(spaces) == i
    invariant forall j: u64 :: j < i ==> vget(spaces, j) is Space::Empty
  {
    vec_push(&mut spaces, Space::Empty);
    i = i + 1;
  }
  let mut fpus = vec_new[Fpu]();
  let mut q = 0;
  while q < NPROC
    invariant q <= NPROC && vlen(fpus) == q
  {
    vec_push(&mut fpus, Fpu::None);
    q = q + 1;
  }
  let shm = new_store(&mut m);
  let txt = new_store(&mut m);
  let mut k = Kernel { mem: m, spaces: spaces, fpus: fpus, procs: alloc(PGROW * STRIDE), q: queue_new(INQ_CAP), line: alloc(LINE_LEN), lxfd: alloc(PGROW * LXNFD), ofd: alloc(OFD_LEN), pipes: alloc(PIPES_LEN), pipebuf: vec_new[PipeBuf](), ticks: 0, ns: at, tsc: tsc, epoch: epoch, rng: rng_new(epoch ^ at), cpus: cpus, fs: vfs_new(disk), nic: nic, sigact: alloc(PGROW * SIGACT_ROW), cwd: alloc(PGROW * CWD_STRIDE), croot: alloc(PGROW * CWD_STRIDE), dpath: alloc(0), sigsave: alloc(PGROW * SIGSAVE_ROW), alarms: alloc(ALARMS_LEN), evt: alloc(EVT_LEN), ux: alloc(UX_LEN), uxb: balloc(UXB_LEN), maps: alloc(MAPS_LEN), holes: alloc(HOLES_LEN), lazy: alloc(LAZY_LEN), anon: alloc(ANON_LEN), inet6: alloc(OFD_N), locks: alloc(LK_LEN), perr: ENOENT, ipc: alloc(IPC_LEN), ipcb: balloc(IPCB_LEN), shm: shm, txt: txt, sys: alloc(SYS_LEN), loops: alloc(LOOP_LEN), ptys: alloc(PTY_LEN), ptyb: balloc(PTYB_LEN), snd: snd, mice: mice, pdir: false, mns: alloc(MNS_LEN), scf: alloc(0), mstr: balloc(MSTR_LEN), naps: false, socks: false, fd_hi: 0, ofd_hi: 0, mt_hi: 0 };
  return k;
}

/// Power off, first step: ends every process's address space and gives its
/// FPU page back, so the pages can be counted.
fn kernel_drop_spaces(k: &mut Kernel, mmu: &Mmu)
  requires kok(k) && mmu_root(mmu) == KERNEL_ROOT
  ensures mem_ok(k.mem) && vfs_ok(k.fs) && nic_ok(k.nic) && snd_ok(k.snd) && vlen(k.spaces) == 0 && vlen(k.fpus) == 0
{
  while vec_len(k.spaces) > 0
    invariant mem_ok(k.mem) && mmu_root(mmu) == KERNEL_ROOT
    invariant forall j: u64 :: j < vlen(k.spaces) ==> (vget(k.spaces, j) is Space::Mapped ==> pt_level(vget(k.spaces, j).Mapped) == 4)
  {
    match vec_pop(&mut k.spaces) {
      Space::Empty => {},
      Space::Mapped(t) => { free_space(&mut k.mem, mmu, t); },
    }
  }
  while vec_len(k.fpus) > 0
    invariant mem_ok(k.mem)
  {
    drop_fpu(&mut k.mem, vec_pop(&mut k.fpus));
  }
}


/// Gives the file or directory at path `name` permission bits `mode`.
fn set_mode(v: &mut Vfs, name: Str, mode: u64)
  requires vfs_ok(v) && slen(name) <= FNAME_MAX
  ensures vfs_ok(v)
{
  let mut i = 0;
  while i < slen(name)
    invariant i <= slen(name) && slen(name) <= FNAME_MAX && vfs_ok(v)
  {
    bset(&mut v.xfer, i, sget(name, i));
    i = i + 1;
  }
  let mut f = vfs_lookup(&mut v, slen(name));
  if f == NO_FILE {
    f = vfs_dir_lookup(&mut v, slen(name));
  }
  if f != NO_FILE {
    vfs_set_meta(&mut v, f, mode, NO_FILE);
  }
}

/// Makes directory `name` (a top-level name) in the RAM file system.
fn make_dir(v: &mut Vfs, name: Str) -> bool
  requires vfs_ok(v) && slen(name) <= FNAME_MAX
  ensures vfs_ok(v)
{
  let mut i = 0;
  while i < slen(name)
    invariant i <= slen(name) && slen(name) <= FNAME_MAX && vfs_ok(v)
  {
    bset(&mut v.xfer, i, sget(name, i));
    i = i + 1;
  }
  return vfs_mkdir(&mut v, slen(name));
}

/// Puts `a` then `b` in the transfer buffer; returns their length.
fn put_name(v: &mut Vfs, a: Str, b: Str) -> u64
  requires vfs_ok(v) && slen(a) + slen(b) <= FNAME_MAX
  ensures vfs_ok(v) && result == slen(a) + slen(b) && result <= FNAME_MAX
{
  let mut i = 0;
  while i < slen(a)
    invariant i <= slen(a) && vfs_ok(v) && slen(a) + slen(b) <= FNAME_MAX
  {
    bset(&mut v.xfer, i, sget(a, i));
    i = i + 1;
  }
  let mut j = 0;
  while j < slen(b)
    invariant j <= slen(b) && vfs_ok(v) && slen(a) + slen(b) <= FNAME_MAX
  {
    bset(&mut v.xfer, slen(a) + j, sget(b, j));
    j = j + 1;
  }
  return slen(a) + slen(b);
}

/// Copies built-in file `name` (under etc/) to disk/`name` with mode
/// `mode`, unless the disk has it already. False if it could not.
fn seed_file(v: &mut Vfs, mem: &mut Mem, name: Str, data: Str, mode: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && slen(name) + 5 <= FNAME_MAX
  ensures vfs_ok(v) && mem_ok(mem)
{
  let n = put_name(&mut v, "disk/", name);
  if vfs_lookup(&mut v, n) != NO_FILE {
    return true;                          // kept from an earlier boot
  }
  let nf = vfs_open(&mut v, &mut mem, nbase(0), NFD, O_WRITE + O_CREATE, n);
  if nf >= NFD {
    return false;
  }
  let fd = nbase(0) + nf;
  let mut ok = true;
  let mut at = 0;
  while ok && at < slen(data)
    invariant at <= slen(data) && vfs_ok(v) && mem_ok(mem)
  {
    let mut c = 0;
    while c < XFER && at + c < slen(data)
      invariant c <= XFER && at + c <= slen(data) && vfs_ok(v)
    {
      bset(&mut v.xfer, c, sget(data, at + c));
      c = c + 1;
    }
    ok = vfs_write(&mut v, &mut mem, fd, c) == c;
    at = at + c;
  }
  vfs_close(&mut v, &mut mem, fd);
  disk_drain(&mut v.disk);
  let m = put_name(&mut v, "disk/", name);
  let f = vfs_lookup(&mut v, m);
  if f != NO_FILE {
    vfs_set_meta(&mut v, f, mode, NO_FILE);
  }
  return ok;
}

/// Makes top-level `name` a link to disk/`name`, making that directory
/// (with mode `mode`) if it is not there yet. False, with nothing made in
/// memory, if it could not.
fn keep_on_disk(v: &mut Vfs, mem: &mut Mem, name: Str, mode: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && slen(name) + 6 <= FNAME_MAX
  ensures vfs_ok(v) && mem_ok(mem)
{
  let n = put_name(&mut v, "disk/", name);
  if vfs_dir_lookup(&mut v, n) == NO_FILE {
    if !vfs_mkdir(&mut v, n) {
      return false;
    }
    disk_drain(&mut v.disk);
    let m = put_name(&mut v, "disk/", name);
    let d = vfs_dir_lookup(&mut v, m);
    if d != NO_FILE {
      vfs_set_meta(&mut v, d, mode, NO_FILE);
    }
  }
  // The link's name is xfer[0..slen(name)], its target "/disk/NAME" after it.
  let t = put_name(&mut v, name, "/disk/");
  let mut j = 0;
  while j < slen(name)
    invariant j <= slen(name) && slen(name) + 6 <= FNAME_MAX && t == slen(name) + 6 && vfs_ok(v)
  {
    bset(&mut v.xfer, t + j, sget(name, j));
    j = j + 1;
  }
  let ok = vfs_symlink(&mut v, &mut mem, slen(name), 6 + slen(name));
  disk_drain(&mut v.disk);
  return ok;
}

fn install_files(con: &mut Con, k: &mut Kernel)
  requires con_ok(con) && kok(k)
  ensures kok(k) && con_ok(con)
{
  pc_tables(&mut k.fs.pc, &mut k.mem);   // the page cache's tables, before the first `mem` (src/pcache.bastio)
  // /tmp is a RAM directory. /etc, root's home and /home, which hold the
  // users and their files, are links into the disk when there is one, so
  // they are kept across boots; the files under etc/ built into the kernel
  // seed disk/etc on the first boot. Without a disk they are RAM
  // directories, filled afresh at each boot.
  if !make_dir(&mut k.fs, "tmp") {
    puts(&mut con, "cannot make /tmp\r\n");
  }
  let disk = k.fs.disk.blocks > 0;
  let etc = disk && keep_on_disk(&mut k.fs, &mut k.mem, "etc", 493);
  if !etc && !make_dir(&mut k.fs, "etc") {
    puts(&mut con, "cannot make /etc\r\n");
  }
  if !(disk && keep_on_disk(&mut k.fs, &mut k.mem, "root", 448)) {
    if !make_dir(&mut k.fs, "root") {
      puts(&mut con, "cannot make /root\r\n");
    }
    set_mode(&mut k.fs, "root", 448);       // 0700
  }
  if !(disk && keep_on_disk(&mut k.fs, &mut k.mem, "home", 493)) && !make_dir(&mut k.fs, "home") {
    puts(&mut con, "cannot make /home\r\n");
  }
  // /dev/shm, where musl's sem_open and shm_open make their files (for
  // Python's multiprocessing). The devices themselves are not files
  // (src/lxdev.bastio): their paths are matched before the file system.
  if !make_dir(&mut k.fs, "dev") || !make_dir(&mut k.fs, "dev/shm") {
    puts(&mut con, "cannot make /dev/shm\r\n");
  }
  // /sys/fs/cgroup is virtual (src/lxcgroup.bastio); its parents are files.
  if !make_dir(&mut k.fs, "sys") || !make_dir(&mut k.fs, "sys/fs") {
    puts(&mut con, "cannot make /sys/fs\r\n");
  }
  let mut i = 0;
  while i < NINIT
    invariant i <= NINIT && kok(k) && con_ok(con)
  {
    let mut ok = true;
    if etc && in_etc(init_name(i)) {
      ok = seed_file(&mut k.fs, &mut k.mem, init_name(i), init_data(i), init_mode(i));
    } else {
      ok = vfs_install(&mut k.fs, &mut k.mem, init_name(i), init_data(i));
      set_mode(&mut k.fs, init_name(i), init_mode(i));
    }
    if !ok {
      puts(&mut con, "cannot install file ");
      puts(&mut con, init_name(i));
      puts(&mut con, "\r\n");
    }
    i = i + 1;
  }
  set_mode(&mut k.fs, "tmp", 1023);         // 01777: anyone may make names, only owners remove them
  set_mode(&mut k.fs, "dev/shm", 1023);
}

/// Is `name` under etc/?
fn in_etc(name: Str) -> bool {
  return slen(name) > 4 && sget(name, 0) == 101 && sget(name, 1) == 116 && sget(name, 2) == 99 && sget(name, 3) == 47;
}
