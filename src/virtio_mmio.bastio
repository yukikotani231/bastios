// Finding virtio devices on the memory-mapped transport (src/virtq.bastio,
// `Vt::Mem`). There is no bus to ask: a machine without PCI (Firecracker,
// QEMU's microvm) has its devices at addresses fixed by the machine, QEMU's
// in a row of 512-byte blocks. So a slot is claimed, its magic number read,
// and the claim given back unless a device of the wanted kind is there.
//
// This is done only on a machine with no PCI host bridge at all: on a PC
// the same addresses can belong to a PCI device's registers, and reading
// them blindly is not harmless.

import "virtq.bastio";
import "vt.bastio";
import "mmiowin.bastio";

const VM_ID_BLK: u64 = 2;             // virtio device ids
const VM_ID_NET: u64 = 1;

enum VmFound { None, Found(VMem) }

/// Where the slots are: `slots` blocks, `step` bytes apart, from `first`.
struct VmWhere { first: u64, step: u64, slots: u64 }

spec fn vmw_ok(w: &VmWhere) -> bool {
  w.first % 4 == 0 && w.step % 4 == 0 && w.first >= WIN_LO && w.step >= VM_LEN && w.step <= 65536 && w.slots <= 64
  && w.first + w.slots * w.step <= WIN_LOW_TOP
}

/// QEMU's microvm.
fn vmw_default() -> VmWhere
  ensures vmw_ok(result)
{
  return VmWhere { first: VM_SLOT0, step: VM_LEN, slots: VM_SLOTS };
}

/// Is the block of registers a virtio device with this id, and which
/// version of the layout? 0 if it is not.
fn vm_probe(regs: &mut Mmio, dev: u64) -> u64
  requires mmio_len(regs) == VM_LEN && mmio_base(regs) % 4 == 0
  ensures mmio_len(regs) == VM_LEN && mmio_base(regs) % 4 == 0 && result <= 2
{
  if cast[u64](mmio_read32(&mut regs, 0)) != VM_MAGIC {
    return 0;
  }
  let v = cast[u64](mmio_read32(&mut regs, VM_VERSION));
  if (v != 1 && v != 2) || cast[u64](mmio_read32(&mut regs, VM_DEVICE)) != dev {
    return 0;
  }
  return v;
}

/// The first virtio device with id `dev` among the slots of `w`,
/// clear of four ranges of the device window (other drivers'; an empty one
/// is 0 .. 0).
fn vm_find(win: &mut MmioSpace, dev: u64, w: VmWhere, l1: u64, h1: u64, l2: u64, h2: u64, l3: u64, h3: u64, l4: u64, h4: u64) -> VmFound
  requires vmw_ok(w)
  requires forall a: u64 :: bar_space(a) && !(l1 <= a && a < h1) && !(l2 <= a && a < h2) && !(l3 <= a && a < h3) && !(l4 <= a && a < h4) ==> mmio_free(win, a)
  ensures forall a: u64 :: bar_space(a) && !(l1 <= a && a < h1) && !(l2 <= a && a < h2) && !(l3 <= a && a < h3) && !(l4 <= a && a < h4)
    && !(result is VmFound::Found && mmio_base(result.Found.regs) <= a && a < mmio_base(result.Found.regs) + mmio_len(result.Found.regs)) ==> mmio_free(win, a)
  ensures result is VmFound::Found ==> vmem_mmio_ok(result.Found) && mmio_len(result.Found.regs) == VM_LEN && mmio_base(result.Found.regs) % 4 == 0
{
  let mut i = 0;
  while i < w.slots
    invariant i <= w.slots
    invariant forall a: u64 :: bar_space(a) && !(l1 <= a && a < h1) && !(l2 <= a && a < h2) && !(l3 <= a && a < h3) && !(l4 <= a && a < h4) ==> mmio_free(win, a)
  {
    let at = w.first + i * w.step;
    if at % 4 == 0 && (at + VM_LEN <= l1 || at >= h1) && (at + VM_LEN <= l2 || at >= h2)
      && (at + VM_LEN <= l3 || at >= h3) && (at + VM_LEN <= l4 || at >= h4) {
      let mut r = mmio_claim(&mut win, at, VM_LEN);
      let v = vm_probe(&mut r, dev);
      if v != 0 {
        return VmFound::Found(vmem_new(r, v == 2));
      }
      mmio_release(&mut win, r);
    }
    i = i + 1;
  }
  return VmFound::None;
}
