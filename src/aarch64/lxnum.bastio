// The Linux arm64 system call numbers, turned into the numbers the Linux
// layer (src/linux.bastio) names its calls by. The layer is written against
// the x86-64 table; every arm64 call that has an x86-64 counterpart with the
// same meaning maps to it, and the rest (the calls AArch64 never had, and
// the ones BastiOS does not implement) are 0xFFFF, which the dispatcher
// answers with -ENOSYS. The calls whose arguments differ in layout (clone,
// the stat family) are handled by their own arch hooks.

import "proc.bastio";

const LX_NONE: u64 = 0xFFFF;

/// The Linux-layer number of arm64 call `n`.
fn lx_number(n: u64) -> u64
  ensures result < 65536
{
  if n == 63 { return LX_READ; }
  if n == 64 { return LX_WRITE; }
  if n == 56 { return LX_OPENAT; }
  if n == 57 { return LX_CLOSE; }
  if n == 222 { return LX_MMAP; }
  if n == 215 { return LX_MUNMAP; }
  if n == 226 { return LX_MPROTECT; }
  if n == 214 { return LX_BRK; }
  if n == 93 { return LX_EXIT; }
  if n == 94 { return LX_EXIT_GROUP; }
  if n == 79 { return LX_NEWFSTATAT; }
  if n == 80 { return LX_FSTAT; }
  if n == 62 { return LX_LSEEK; }
  if n == 66 { return LX_WRITEV; }
  if n == 65 { return LX_READV; }
  if n == 131 { return LX_TGKILL; }
  if n == 134 { return LX_RT_SIGACTION; }
  if n == 135 { return LX_RT_SIGPROCMASK; }
  if n == 98 { return LX_FUTEX; }
  if n == 113 { return LX_CLOCK_GETTIME; }
  if n == 172 { return LX_GETPID; }
  if n == 178 { return LX_GETTID; }
  if n == 129 { return LX_KILL; }
  if n == 220 { return LX_CLONE; }
  if n == 221 { return LX_EXECVE; }
  if n == 260 { return LX_WAIT4; }
  if n == 29 { return LX_IOCTL; }
  if n == 25 { return LX_FCNTL; }
  if n == 48 { return LX_FACCESSAT; }
  if n == 61 { return LX_GETDENTS64; }
  if n == 17 { return LX_GETCWD; }
  if n == 49 { return LX_CHDIR; }
  if n == 35 { return LX_UNLINKAT; }
  if n == 34 { return LX_MKDIRAT; }
  if n == 24 { return LX_DUP3; }
  if n == 59 { return LX_PIPE2; }
  if n == 23 { return LX_DUP; }
  if n == 198 { return LX_SOCKET; }
  if n == 0 { return LX_IO_SETUP; }
  if n >= 5 && n <= 16 { return LX_SETXATTR + (n - 5); }   // set, get, list, remove, each by path, link and fd
  if n == 19 { return LX_EVENTFD2; }
  if n == 20 { return LX_EPOLL_CREATE1; }
  if n == 21 { return LX_EPOLL_CTL; }
  if n == 22 { return LX_EPOLL_PWAIT; }
  if n == 26 { return LX_INOTIFY_INIT1; }
  if n == 27 { return LX_INOTIFY_ADD_WATCH; }
  if n == 28 { return LX_INOTIFY_RM_WATCH; }
  if n == 30 { return LX_IOPRIO_SET; }
  if n == 31 { return LX_IOPRIO_GET; }
  if n == 32 { return LX_FLOCK; }
  if n == 33 { return LX_MKNODAT; }
  if n == 36 { return LX_SYMLINKAT; }
  if n == 37 { return LX_LINKAT; }
  if n == 38 { return LX_RENAMEAT; }
  if n == 39 { return LX_UMOUNT2; }
  if n == 40 { return LX_MOUNT; }
  if n == 41 { return LX_PIVOT_ROOT; }
  if n == 43 { return LX_STATFS; }
  if n == 44 { return LX_FSTATFS; }
  if n == 45 { return LX_TRUNCATE; }
  if n == 46 { return LX_FTRUNCATE; }
  if n == 47 { return LX_FALLOCATE; }
  if n == 50 { return LX_FCHDIR; }
  if n == 51 { return LX_CHROOT; }
  if n == 52 { return LX_FCHMOD; }
  if n == 53 { return LX_FCHMODAT; }
  if n == 54 { return LX_FCHOWNAT; }
  if n == 55 { return LX_FCHOWN; }
  if n == 58 { return LX_VHANGUP; }
  if n == 67 { return LX_PREAD64; }
  if n == 68 { return LX_PWRITE64; }
  if n == 69 { return LX_PREADV; }
  if n == 70 { return LX_PWRITEV; }
  if n == 71 { return LX_SENDFILE; }
  if n == 72 { return LX_PSELECT6; }
  if n == 73 { return LX_PPOLL; }
  if n == 74 { return LX_SIGNALFD4; }
  if n == 75 { return LX_VMSPLICE; }
  if n == 76 { return LX_SPLICE; }
  if n == 77 { return LX_TEE; }
  if n == 78 { return LX_READLINKAT; }
  if n == 81 { return LX_SYNC; }
  if n == 82 { return LX_FSYNC; }
  if n == 83 { return LX_FDATASYNC; }
  if n == 84 { return LX_SYNC_FILE_RANGE; }
  if n == 85 { return LX_TIMERFD_CREATE; }
  if n == 86 { return LX_TIMERFD_SETTIME; }
  if n == 87 { return LX_TIMERFD_GETTIME; }
  if n == 88 { return LX_UTIMENSAT; }
  if n == 90 { return LX_CAPGET; }
  if n == 91 { return LX_CAPSET; }
  if n == 92 { return LX_PERSONALITY; }
  if n == 95 { return LX_WAITID; }
  if n == 96 { return LX_SET_TID_ADDRESS; }
  if n == 97 { return LX_UNSHARE; }
  if n == 99 { return LX_SET_ROBUST_LIST; }
  if n == 100 { return LX_GET_ROBUST_LIST; }
  if n == 101 { return LX_NANOSLEEP; }
  if n == 102 { return LX_GETITIMER; }
  if n == 103 { return LX_SETITIMER; }
  if n == 107 { return LX_TIMER_CREATE; }
  if n == 108 { return LX_TIMER_GETTIME; }
  if n == 109 { return LX_TIMER_GETOVERRUN; }
  if n == 110 { return LX_TIMER_SETTIME; }
  if n == 111 { return LX_TIMER_DELETE; }
  if n == 112 { return LX_CLOCK_SETTIME; }
  if n == 114 { return LX_CLOCK_GETRES; }
  if n == 115 { return LX_CLOCK_NANOSLEEP; }
  if n == 116 { return LX_SYSLOG; }
  if n == 117 { return LX_PTRACE; }
  if n == 118 { return LX_SCHED_SETPARAM; }
  if n == 119 { return LX_SCHED_SETSCHEDULER; }
  if n == 120 { return LX_SCHED_GETSCHEDULER; }
  if n == 121 { return LX_SCHED_GETPARAM; }
  if n == 122 { return LX_SCHED_SETAFFINITY; }
  if n == 123 { return LX_SCHED_GETAFFINITY; }
  if n == 124 { return LX_SCHED_YIELD; }
  if n == 125 { return LX_SCHED_GET_PRIORITY_MAX; }
  if n == 126 { return LX_SCHED_GET_PRIORITY_MIN; }
  if n == 127 { return LX_SCHED_RR_GET_INTERVAL; }
  if n == 130 { return LX_TKILL; }
  if n == 132 { return LX_SIGALTSTACK; }
  if n == 133 { return LX_RT_SIGSUSPEND; }
  if n == 136 { return LX_RT_SIGPENDING; }
  if n == 137 { return LX_RT_SIGTIMEDWAIT; }
  if n == 138 { return LX_RT_SIGQUEUEINFO; }
  if n == 240 { return LX_RT_TGSIGQUEUEINFO; }
  if n == 267 { return LX_SYNCFS; }
  if n == 139 { return LX_RT_SIGRETURN; }
  if n == 140 { return LX_SETPRIORITY; }
  if n == 141 { return LX_GETPRIORITY; }
  if n == 142 { return LX_REBOOT; }
  if n == 143 { return LX_SETREGID; }
  if n == 144 { return LX_SETGID; }
  if n == 145 { return LX_SETREUID; }
  if n == 146 { return LX_SETUID; }
  if n == 147 { return LX_SETRESUID; }
  if n == 148 { return LX_GETRESUID; }
  if n == 149 { return LX_SETRESGID; }
  if n == 150 { return LX_GETRESGID; }
  if n == 151 { return LX_SETFSUID; }
  if n == 152 { return LX_SETFSGID; }
  if n == 153 { return LX_TIMES; }
  if n == 154 { return LX_SETPGID; }
  if n == 155 { return LX_GETPGID; }
  if n == 156 { return LX_GETSID; }
  if n == 157 { return LX_SETSID; }
  if n == 158 { return LX_GETGROUPS; }
  if n == 159 { return LX_SETGROUPS; }
  if n == 160 { return LX_UNAME; }
  if n == 161 { return LX_SETHOSTNAME; }
  if n == 162 { return LX_SETDOMAINNAME; }
  if n == 163 { return LX_GETRLIMIT; }
  if n == 164 { return LX_SETRLIMIT; }
  if n == 165 { return LX_GETRUSAGE; }
  if n == 166 { return LX_UMASK; }
  if n == 167 { return LX_PRCTL; }
  if n == 168 { return LX_GETCPU; }
  if n == 169 { return LX_GETTIMEOFDAY; }
  if n == 170 { return LX_SETTIMEOFDAY; }
  if n == 171 { return LX_ADJTIMEX; }
  if n == 173 { return LX_GETPPID; }
  if n == 174 { return LX_GETUID; }
  if n == 175 { return LX_GETEUID; }
  if n == 176 { return LX_GETGID; }
  if n == 177 { return LX_GETEGID; }
  if n == 179 { return LX_SYSINFO; }
  if n == 180 { return LX_MQ_OPEN; }
  if n == 181 { return LX_MQ_UNLINK; }
  if n == 182 { return LX_MQ_TIMEDSEND; }
  if n == 183 { return LX_MQ_TIMEDRECEIVE; }
  if n == 184 { return LX_MQ_NOTIFY; }
  if n == 185 { return LX_MQ_GETSETATTR; }
  if n == 186 { return LX_MSGGET; }
  if n == 187 { return LX_MSGCTL; }
  if n == 188 { return LX_MSGRCV; }
  if n == 189 { return LX_MSGSND; }
  if n == 190 { return LX_SEMGET; }
  if n == 191 { return LX_SEMCTL; }
  if n == 192 { return LX_SEMTIMEDOP; }
  if n == 193 { return LX_SEMOP; }
  if n == 194 { return LX_SHMGET; }
  if n == 195 { return LX_SHMCTL; }
  if n == 196 { return LX_SHMAT; }
  if n == 197 { return LX_SHMDT; }
  if n == 199 { return LX_SOCKETPAIR; }
  if n == 200 { return LX_BIND; }
  if n == 201 { return LX_LISTEN; }
  if n == 202 { return LX_ACCEPT; }
  if n == 203 { return LX_CONNECT; }
  if n == 204 { return LX_GETSOCKNAME; }
  if n == 205 { return LX_GETPEERNAME; }
  if n == 206 { return LX_SENDTO; }
  if n == 207 { return LX_RECVFROM; }
  if n == 208 { return LX_SETSOCKOPT; }
  if n == 209 { return LX_GETSOCKOPT; }
  if n == 210 { return LX_SHUTDOWN; }
  if n == 211 { return LX_SENDMSG; }
  if n == 212 { return LX_RECVMSG; }
  if n == 213 { return LX_READAHEAD; }
  if n == 216 { return LX_MREMAP; }
  if n == 217 { return LX_ADD_KEY; }
  if n == 218 { return LX_REQUEST_KEY; }
  if n == 219 { return LX_KEYCTL; }
  if n == 223 { return LX_FADVISE64; }
  if n == 227 { return LX_MSYNC; }
  if n == 228 { return LX_MLOCK; }
  if n == 229 { return LX_MUNLOCK; }
  if n == 230 { return LX_MLOCKALL; }
  if n == 231 { return LX_MUNLOCKALL; }
  if n == 232 { return LX_MINCORE; }
  if n == 233 { return LX_MADVISE; }
  if n == 242 { return LX_ACCEPT4; }
  if n == 243 { return LX_RECVMMSG; }
  if n == 261 { return LX_PRLIMIT64; }
  if n == 264 { return LX_NAME_TO_HANDLE_AT; }
  if n == 265 { return LX_OPEN_BY_HANDLE_AT; }
  if n == 266 { return LX_CLOCK_ADJTIME; }
  if n == 268 { return LX_SETNS; }
  if n == 269 { return LX_SENDMMSG; }
  if n == 270 { return LX_PROCESS_VM_READV; }
  if n == 271 { return LX_PROCESS_VM_WRITEV; }
  if n == 272 { return LX_KCMP; }
  if n == 274 { return LX_SCHED_SETATTR; }
  if n == 275 { return LX_SCHED_GETATTR; }
  if n == 276 { return LX_RENAMEAT2; }
  if n == 277 { return LX_SECCOMP; }
  if n == 278 { return LX_GETRANDOM; }
  if n == 279 { return LX_MEMFD_CREATE; }
  if n == 280 { return LX_BPF; }
  if n == 281 { return LX_EXECVEAT; }
  if n == 283 { return LX_MEMBARRIER; }
  if n == 284 { return LX_MLOCK2; }
  if n == 285 { return LX_COPY_FILE_RANGE; }
  if n == 286 { return LX_PREADV2; }
  if n == 287 { return LX_PWRITEV2; }
  if n == 291 { return LX_STATX; }
  if n == 293 { return LX_RSEQ; }
  if n == 424 { return LX_PIDFD_SEND_SIGNAL; }
  if n == 425 { return LX_IO_URING_SETUP; }
  if n == 428 { return LX_OPEN_TREE; }
  if n == 429 { return LX_MOVE_MOUNT; }
  if n == 430 { return LX_FSOPEN; }
  if n == 431 { return LX_FSCONFIG; }
  if n == 432 { return LX_FSMOUNT; }
  if n == 433 { return LX_FSPICK; }
  if n == 434 { return LX_PIDFD_OPEN; }
  if n == 435 { return LX_CLONE3; }
  if n == 436 { return LX_CLOSE_RANGE; }
  if n == 437 { return LX_OPENAT2; }
  if n == 438 { return LX_PIDFD_GETFD; }
  if n == 439 { return LX_FACCESSAT2; }
  if n == 441 { return LX_EPOLL_PWAIT2; }
  if n == 452 { return LX_FCHMODAT2; }
  return LX_NONE;
}
