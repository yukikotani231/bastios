import "lxfd.bastio";
import "lxdir.bastio";
import "lxsock.bastio";
import "lxnetlink.bastio";
import "lxtcp.bastio";
import "lxsig.bastio";
import "sigframe.bastio";
import "lxtime.bastio";
import "lxunix.bastio";
import "lxmem.bastio";
import "lxmisc.bastio";
import "lxkeys.bastio";
import "lxaio.bastio";
import "lxthread.bastio";
import "lxdev.bastio";
import "lxevent.bastio";
import "lxptimer.bastio";
import "lxmore.bastio";
import "lxextra.bastio";
import "lxpidfd.bastio";
import "lxptrace.bastio";
import "lxsplice.bastio";
import "lxmsg.bastio";
import "lxcred.bastio";
import "lxprio.bastio";
import "lxipc.bastio";
import "lxmq.bastio";
import "lxsys.bastio";
import "lxlock.bastio";
import "lxowner.bastio";
import "lxsysctl.bastio";
import "lxprocfs.bastio";
import "lxprctl.bastio";
import "lxrlimit.bastio";
import "lxcore.bastio";
import "lxcap.bastio";
import "lxlink.bastio";
import "lxloop.bastio";
import "lxpty.bastio";
import "lxxattr.bastio";
import "lxmount.bastio";
import "lxns.bastio";
import "lxnsk.bastio";
import "lxuser.bastio";
import "lxcgroup.bastio";
import "lxseccomp.bastio";
import "lxbpf.bastio";
import "lxperm.bastio";
import "lxopen2.bastio";
import "lxhandle.bastio";
import "lxinotify.bastio";
import "lazy.bastio";
import "lxanon.bastio";
import "lxcow.bastio";
import "lxsnd.bastio";
import "lxrtc.bastio";
import "lxmouse.bastio";
import "kernel.bastio";
import "initfiles.bastio";
import "lxnum.bastio";

const V_TIMER: u64 = 32;
const V_LTIMER: u64 = 48;     // the tick of a processor other than the boot one
const V_SYSCALL: u64 = 128;
const V_ABORT: u64 = 14;

fn fault_name(con: &mut Con, v: u64)
  requires con_ok(con)
  ensures con_ok(con)
{
  if v == V_ABORT {
    puts(&mut con, "abort");
  } else {
    puts(&mut con, "exception");
  }
}

fn tick(t: u64) -> u64 {
  if t < 18446744073709551615 {
    return t + 1;
  }
  return t;
}

// The kernel's state and the console devices, which one processor owns.
struct Sys { k: Kernel, con: Con, stop: bool }
  invariant kok(k) && con_ok(con);

spec fn sys_ok(s: &Sys) -> bool {
  kok(s.k) && con_ok(s.con)
}

// A process taken out to run: its id, its lease on its address space and
// its FP/SIMD page.
struct Task { pid: u64, lease: Lease, fpu: Frame }

enum Job { Stop, Idle, Run(Task) }

/// Writes the kernel's waiting output to the serial line.
fn drain(ser: &Serial, c: &mut Con)
  requires con_ok(c)
  ensures con_ok(c)
{
  let mut out = true;
  while out
    invariant con_ok(c)
  {
    let mut b = balloc(256);
    let got = con_take(&mut c, &mut b);
    let mut i = 0;
    while i < got && i < blen(b)
      invariant con_ok(c)
    {
      serial_write(ser, bget(b, i));
      i = i + 1;
    }
    bfree(b);
    out = got == 256;
  }
}

/// Moves typed bytes from the serial line into the kernel and its output to
/// the line.
fn pump(ser: &Serial, s: &mut Sys)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  let mut typed = false;
  let mut c = serial_poll(ser);
  let mut n = 0;
  while c < 256 && n < 4096
    invariant sys_ok(s)
  {
    q_push(&mut s.k.q, c);
    typed = true;
    n = n + 1;
    c = serial_poll(ser);
  }
  if typed {
    tty_intr(&mut s.con, &mut s.k);
    tty_cook(&mut s.con, &mut s.k);
    wake_readers(&mut s.k.procs, &mut s.k.q, s.k.line, s.k.pid_hi);
  }
  drain(ser, &mut s.con);
  wake_writers(&mut s.k.procs);
}

/// The clock: the generic timer's counter scaled to nanoseconds (src/tsc.bastio),
/// or the timer ticks (10 ms each) if the platform reports no counter rate.
/// CLOCK_MONOTONIC and the wall clock the file system stamps files with.
fn set_clock(s: &mut Sys, cpu: &Cpu)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  if s.k.tsc.mult == 0 {
    s.k.ns = (s.k.ticks % 1000000000000) * NS_PER_TICK;
  } else {
    s.k.ns = tsc_now(s.k.tsc, s.k.ns, cpu);
  }
  s.k.fs.now = sat_add(s.k.epoch, s.k.ns) / 1000000000;
}

/// What the processor does next. Starting at `from` (round robin), takes
/// the next READY process out, with its registers loaded into `cpu`, and
/// marks it RUNNING.
fn next_job(s: &mut Sys, cpu: &mut Cpu, mmu: &mut Mmu, from: u64) -> Job
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  ensures sys_ok(s)
  ensures result is Job::Run ==> (1 <= result.Run.pid && result.Run.pid < NPROC)
  ensures !(result is Job::Run) ==> mmu_root(mmu) == KERNEL_ROOT
{
  if s.stop {
    return Job::Stop;
  }
  rng_stir(&mut s.k, cpu);
  nic_feed(&mut s.k.nic, &mut s.k.mem);
  nic_poll(&mut s.k.nic);
  net_wake(&mut s.k);
  disk_wake(&mut s.k);
  sock_wake(&mut s.k);
  if s.k.naps {
    sleepers_due(&mut s.k);
  }
  let p = lx_pick(&mut s.k, from);
  if p == 0 {
    if live_count(s.k.procs, s.k.pid_hi) == 0 {
      s.stop = true;
      return Job::Stop;
    }
    return Job::Idle;
  }
  group_take(&mut s.k, mmu, p);                 // a thread gets its group's space
  if !lx_deliver(&mut s.k, mmu, p) {
    return Job::Idle;                       // a signal ended it
  }
  match take_space(&mut s.k.spaces, p) {
    Space::Empty => {
      // A READY process always has a space; end it rather than spin on it.
      terminate(&mut s.k, mmu, p, 139);
      return Job::Idle;
    },
    Space::Mapped(root) => {
      match take_fpu(&mut s.k.fpus, p) {
        Fpu::None => {
          put_space(&mut s.k.spaces, p, Space::Mapped(root));
          terminate(&mut s.k, mmu, p, 139);
          return Job::Idle;
        },
        Fpu::State(f) => {
          let mut sp = root;
          let l = mmu_enter(&mut mmu, &mut sp);
          put_space(&mut s.k.spaces, p, Space::Mapped(sp));
          let mut r = 0;
          while r < NLOAD
            invariant r <= NLOAD && ptab_ok(s.k.procs)
          {
            cpu_set(&mut cpu, r, pget(s.k.procs, p, reg_word(r)));
            r = r + 1;
          }
          cpu_set(&mut cpu, R_TLS, pget(s.k.procs, p, reg_word(R_TLS)));
          pset(&mut s.k.procs, p, F_STATE, RUNNING);
          return Job::Run(Task { pid: p, lease: l, fpu: f });
        },
      }
    },
  }
}

/// After process `p` ran until a trap with vector `v` (its lease given
/// back): puts its FP/SIMD page `fpu` and registers back and handles the
/// trap. Returns where the round robin goes on.
fn finish(s: &mut Sys, cpu: &mut Cpu, mmu: &Mmu, p: u64, fpu: Frame, v: u64) -> u64
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  requires 1 <= p && p < NPROC
  ensures sys_ok(s) && result < NPROC
{
  restore_fpu(&mut s.k.mem, &mut s.k.fpus, p, Fpu::State(fpu));
  let mut r = 0;
  while r < NREGS
    invariant r <= NREGS && ptab_ok(s.k.procs)
  {
    pset(&mut s.k.procs, p, reg_word(r), cpu_get(cpu, r));
    r = r + 1;
  }
  if v == V_TIMER {
    s.k.ticks = tick(s.k.ticks);
    set_clock(&mut s, cpu);
  }
  if state(s.k.procs, p) == EXITING {
    thread_free(&mut s.k, mmu, p, tgid(s.k.procs, p));
    return (p + 1) % NPROC;
  }
  group_take(&mut s.k, mmu, p);
  let killed = state(s.k.procs, p) == KILLED;
  if state(s.k.procs, p) == RUNNING || killed {
    pset(&mut s.k.procs, p, F_STATE, READY);
  }
  if killed {
    terminate(&mut s.k, mmu, p, 137);
    return (p + 1) % NPROC;
  }
  if v != V_TIMER && v != V_LTIMER && pget(s.k.procs, p, F_TGID) != 0 && !has_space(&mut s.k.spaces, p) {
    // A thread whose group has lent its address space to a vfork child
    // (lx_vfork_vm) trapped on another processor, and group_take found
    // nothing to bring: its descriptors, working directory and signal
    // actions are with the vforking thread, and the call or fault would
    // see empty ones (a read of an open descriptor failing with EBADF).
    // It runs the instruction again once the space is back, which the
    // scheduler waits for (group_free). The same as src/main.bastio.
    let pc = pget(s.k.procs, p, F_REGS + R_RIP);
    if v == V_SYSCALL && pc >= SYSCALL_LEN {
      pset(&mut s.k.procs, p, F_REGS + R_RIP, pc - SYSCALL_LEN);
    }
    if v == V_SYSCALL || v == V_ABORT {
      return (p + 1) % NPROC;
    }
  }
  if v == V_TIMER || v == V_LTIMER {
    // A process waiting in a system call is READY with its pc on the
    // call and F_RESTART set; a tick that finds it there has run none of
    // its own code, so it is not charged CPU time.
    if pget(s.k.procs, p, F_RESTART) == 0 {
      pset(&mut s.k.procs, p, F_TICKS, tick(pget(s.k.procs, p, F_TICKS)));
      cpu_timers_tick(&mut s.k, p);
      cg_cpu_tick(&mut s.k, p);             // cpu.max and cpu.weight (src/lxcgroup.bastio)
      if pget(s.k.procs, p, F_TICKS) % 16 == 0 {
        cg_oom_tick(&mut s.k, p);           // memory.max, as src/main.bastio does
      }
    } else {
      // Nobody is charged, but a cpu.max period must still end on time: a
      // throttled group's processes are not picked, so while the processors
      // only run waiting calls again no other tick would start the next
      // period (cg_cpu_tick with no process, as an idle tick does). The
      // same as src/main.bastio.
      set_clock(&mut s, cpu);
      cg_cpu_tick(&mut s.k, 0);
    }
    lx_alarms(&mut s.k);
    return (p + 1) % NPROC;
  }
  if v == V_SYSCALL && pget(s.k.procs, p, F_ABI) != 0 {
    // A Linux arm64 program: the call number is in x8, turned into the
    // number the Linux layer uses and kept apart (R_LXNR), so that x8 comes
    // back to the program unchanged. A call that runs again keeps its number.
    set_clock(&mut s, cpu);
    let began = s.k.ns;
    if pget(s.k.procs, p, F_RESTART) == 0 {
      pset(&mut s.k.procs, p, F_REGS + R_LXNR, lx_number(pget(s.k.procs, p, reg_word(R_NUM))));
    }
    if pt_sys_entry(&mut s.k, p, pget(s.k.procs, p, F_RESTART) != 0) {
      return (p + 1) % NPROC;               // stopped for its tracer before the call (src/lxptrace.bastio)
    }
    ino_before(&mut s.k, p);                // src/lxinotify.bastio
    let what = linux_syscall(&mut s.con, &mut s.k, mmu, p);
    ino_after(&mut s.k, p);
    set_clock(&mut s, cpu);
    if s.k.ns > began {
      tm_sys_add(&mut s.k, p, s.k.ns - began);   // system time (src/lxrlimit.bastio)
    }
    call_done(&mut s.k, p);
    if what == POWEROFF || what == REBOOT {
      s.stop = true;
    }
    sock_wake(&mut s.k);
    if what == SWITCH {
      sig_wake_now(&mut s.k, p);            // a signal posted while it ran is not lost to its sleep
    }
    if disk_hold(&mut s.k, p, EIO) || what == SWITCH {
      return (p + 1) % NPROC;
    }
    if what == KEEP && pt_sys_exit(&mut s.k, p) {
      return (p + 1) % NPROC;               // stopped for its tracer after the call
    }
    return p;
  }
  if v == V_SYSCALL {
    set_clock(&mut s, cpu);
    let what = syscall(&mut s.con, &mut s.k, mmu, p);
    if what == POWEROFF || what == REBOOT {
      s.stop = true;
    }
    sock_wake(&mut s.k);
    if disk_hold(&mut s.k, p, NO_RESULT) {
      return (p + 1) % NPROC;
    }
    if what == KEEP {
      return p;
    }
    return (p + 1) % NPROC;
  }
  if v == V_ABORT {
    let lz = lazy_fault(&mut s.k, p);
    if lz == LZ_WAIT && state(s.k.procs, p) == READY {
      pset(&mut s.k.procs, p, F_STATE, DISKWAIT);
      pset(&mut s.k.procs, p, F_WAIT, RETRY_BIT + s.k.fs.disk.q.moved % RETRY_BIT);
      disk_wake(&mut s.k);
      if state(s.k.procs, p) == DISKWAIT {
        return (p + 1) % NPROC;
      }
      return p;
    }
    if lz != LZ_NO || anon_fault(&mut s.k, p) || cow_fault(&mut s.k, p) || stack_fault(&mut s.k, p) || write_raced(&mut s.k, p) {
      return p;                             // code read, a page mapped or copied, or the stack grew: run the instruction again
    }
  }
  if v == 6 && emulate_idreg(&mut s.k, p) {
    return p;
  }
  // Any other trap, or an abort nothing could mend: the process dies of the
  // signal Linux would send (a SIGSEGV), unless it has a handler.
  let mut sig = SIGSEGV;
  if v == 6 {
    sig = SIGILL;
  } else if v == 3 {
    sig = SIGTRAP;
  } else if v == 1 {
    sig = SIGTRAP;                          // a single step (src/lxptrace.bastio)
    pt_stepped(&mut s.k, p);
  } else if v == 17 {
    sig = SIGBUS;
  }
  let addr = pget(s.k.procs, p, reg_word(R_FAULT));
  if fault_caught(&mut s.k, p, sig, addr) {
    return (p + 1) % NPROC;
  }
  puts(&mut s.con, "\r\n[pid ");
  put_num(&mut s.con, p);
  puts(&mut s.con, " (");
  puts(&mut s.con, prog_name(pget(s.k.procs, p, F_PROG)));
  puts(&mut s.con, "): ");
  fault_name(&mut s.con, v);
  puts(&mut s.con, " at pc ");
  put_hex(&mut s.con, pget(s.k.procs, p, reg_word(R_PC)));
  puts(&mut s.con, ", address ");
  put_hex(&mut s.con, addr);
  puts(&mut s.con, "; killed]\r\n");
  let dumped = core_dump(&mut s.k, p, sig);
  terminate(&mut s.k, mmu, p, death_code(sig, dumped));
  return (p + 1) % NPROC;
}

/// A write that faulted on a read-only mapping, found writable by the time
/// the abort is handled: another processor broke the copy-on-write page, or
/// a kernel write for this process did (process_vm_writev on a child that
/// has not run yet). The ESR says a data abort (class 0x24) on a write
/// (WnR, bit 6) with a permission fault (status 0x0d to 0x0f); the
/// instruction runs again and now succeeds.
fn write_raced(k: &mut Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let esr = pget(k.procs, p, reg_word(34));
  let st = esr % 64;
  if (esr >> 26) != 0x24 || ((esr >> 6) % 2) != 1 || st < 0x0d || st > 0x0f {
    return false;
  }
  return user_page_writable(&mut k.spaces, p, pget(k.procs, p, reg_word(R_FAULT)));
}

/// An EL0 read of an identification register (MIDR_EL1, ID_AA64ISAR0_EL1,
/// ...: op0 3, op1 0, CRn 0, CRm 0 to 7), which the processor reports as an
/// unknown instruction. Linux emulates these (HWCAP_CPUID), and the Go
/// runtime reads ID_AA64ISAR0_EL1 when it starts. Every register reads as
/// zero here, which says no optional feature exists, so a program falls
/// back to the baseline instructions. Returns true if the instruction at the
/// program counter was one, and has been stepped over.
fn emulate_idreg(k: &mut Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  if (pget(k.procs, p, reg_word(34)) >> 26) != 0 {
    return false;                           // only the unknown-reason class
  }
  let pc = pget(k.procs, p, reg_word(R_PC));
  if pc % 4 != 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, p, pc, &mut k.fs.xfer, 4) != 4 {
    return false;
  }
  let w = get_u64(k.fs.xfer, 0) % 0x100000000;
  if (w >> 12) != 0xd5380 || ((w >> 8) % 16) > 7 {
    return false;
  }
  let rt = w % 32;
  if rt < 31 {
    pset(&mut k.procs, p, reg_word(rt), 0);
  }
  pset(&mut k.procs, p, reg_word(R_PC), wrap_add(pc, 4));
  return true;
}

// What a trap's handling can leave behind: see after_trap in src/main.bastio.
fn after_trap(s: &mut Sys, p: u64)
  requires sys_ok(s) && p < NPROC
  ensures sys_ok(s)
{
  if pget(s.k.procs, p, F_RESTART) == 0 {
    sleepers_wake(&mut s.k);
  }
}

/// Under the lock, after an idle wait ended with vector `v`. Only the boot
/// processor's tick (V_TIMER) counts the kernel's time and moves the console.
fn idled(s: &mut Sys, cpu: &Cpu, v: u64, ser: &Serial)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  if v == V_TIMER {
    s.k.ticks = tick(s.k.ticks);
    set_clock(&mut s, cpu);
    cg_cpu_tick(&mut s.k, 0);
    lx_alarms(&mut s.k);
    sleepers_wake(&mut s.k);
    pump(ser, &mut s);
  } else {
    sleepers_wake(&mut s.k);
  }
}

// What `turn` hands back: the next job, and where the round robin goes on.
struct Next { job: Job, from: u64 }

/// `finish` for task `t`, then `next_job` from where it leaves the round
/// robin, in one critical section. The boot processor's tick also moves the
/// console.
fn turn(s: &mut Sys, cpu: &mut Cpu, mmu: &mut Mmu, p: u64, fpu: Frame, v: u64, ser: &Serial) -> Next
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  requires 1 <= p && p < NPROC
  ensures sys_ok(s) && result.from < NPROC
  ensures result.job is Job::Run ==> (1 <= result.job.Run.pid && result.job.Run.pid < NPROC)
  ensures !(result.job is Job::Run) ==> mmu_root(mmu) == KERNEL_ROOT
{
  let c = finish(&mut s, &mut cpu, mmu, p, fpu, v);
  after_trap(&mut s, p);
  if v == V_TIMER {
    pump(ser, &mut s);
  }
  let j = next_job(&mut s, &mut cpu, &mut mmu, c);
  return Next { job: j, from: c };
}

/// `finish` for a task the loop below still holds when the kernel stops.
fn finish_end(s: &mut Sys, cpu: &mut Cpu, mmu: &Mmu, p: u64, fpu: Frame, v: u64) -> u64
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  requires 1 <= p && p < NPROC
  ensures sys_ok(s) && result < NPROC
{
  let c = finish(&mut s, &mut cpu, mmu, p, fpu, v);
  after_trap(&mut s, p);
  return c;
}

/// The scheduler loop every processor runs, with its own `cpu` and `mmu`,
/// until the kernel stops (no process left, or a power off). The kernel's
/// state is taken under `s` for each job and each trap; a process runs in
/// user mode without it, on the lease its processor holds on its address
/// space (see the top of the scheduling section of src/main.bastio, which
/// this follows).
fn sched(cpu: &mut Cpu, mmu: &mut Mmu, s: &Lock[Sys], ser: &Serial)
  requires mmu_root(mmu) == KERNEL_ROOT
  ensures mmu_root(mmu) == KERNEL_ROOT
{
  let mut cur = 1;
  let mut going = true;
  let mut j = locked(s, next_job, &mut cpu, &mut mmu, cur);
  while going
    invariant cur < NPROC
    invariant !(j is Job::Run) ==> mmu_root(mmu) == KERNEL_ROOT
    invariant j is Job::Run ==> (1 <= j.Run.pid && j.Run.pid < NPROC)
  {
    match j {
      Job::Stop => {
        going = false;
        j = Job::Stop;
      },
      Job::Idle => {
        // Nothing to run: sleep until the next interrupt (the timer ticks).
        let v = cpu_idle(&mut cpu);
        locked(s, idled, cpu, v, ser);
        j = locked(s, next_job, &mut cpu, &mut mmu, cur);
      },
      Job::Run(t) => {
        cpu_fpu_load(&mut cpu, t.fpu);
        let v = cpu_run(&mut cpu, mmu);
        mmu_exit(&mut mmu, t.lease);
        let mut f = t.fpu;
        cpu_fpu_save(&mut cpu, &mut f);
        let next = locked(s, turn, &mut cpu, &mut mmu, t.pid, f, v, ser);
        cur = next.from;
        j = next.job;
      },
    }
  }
  // Only Stop ends the loop; a task here would be put back as after a tick.
  match j {
    Job::Run(t) => {
      mmu_exit(&mut mmu, t.lease);
      let c = locked(s, finish_end, &mut cpu, mmu, t.pid, t.fpu, V_TIMER);
    },
    Job::Idle => {},
    Job::Stop => {},
  }
}

/// The time now in seconds since 1970-01-01 UTC, from the PL031 real-time
/// clock the device tree lists (QEMU's virt machine has one; its data
/// register counts seconds), 0 without one.
/// The clock for a generic timer counting at `hz` (CNTFRQ_EL0), as the
/// platform reports it; no clock (the ticks keep the time) if that is 0 or
/// outside the range src/tsc.bastio accepts.
fn tsc_from_hz(cpu: &Cpu, hz: u64) -> Tsc {
  if hz < TSC_MIN_HZ || hz > TSC_MAX_HZ {
    return Tsc { base: 0, mult: 0, at: 0 };
  }
  return Tsc { base: cpu_tsc(cpu), mult: 1000000000 * TWO32 / hz, at: 0 };
}

fn rtc_seconds(win: &mut MmioSpace, cpu: &Cpu) -> u64
  requires forall a: u64 :: bar_space(a) ==> mmio_free(win, a)
  ensures forall a: u64 :: bar_space(a) ==> mmio_free(win, a)
  ensures result < 4294967296
{
  let at = dt_first(cpu, "arm,pl031");
  if at == 0 || at % 4 != 0 || at >= WIN_LOW_TOP || at + 4096 > WIN_LOW_TOP {
    return 0;
  }
  let mut r = mmio_claim(&mut win, at, 4096);
  let v = cast[u64](mmio_read32(&mut r, 0));
  mmio_release(&mut win, r);
  return v;
}

fn main(con: &mut Serial, pool: &mut Pool, win: &mut MmioSpace, mmu: &mut Mmu, cpu: &mut Cpu) -> u64 {
  let mut m = mem_new(pool);
  let mut console = con_new();
  puts(&mut console, "\r\nBastiOS 0.2 (aarch64): ");
  put_num(&mut console, count_avail(m.bm));
  puts(&mut console, " pages of memory, ");
  put_num(&mut console, cpu_count(cpu));
  if cpu_count(cpu) == 1 {
    puts(&mut console, " processor\r\n");
  } else {
    puts(&mut console, " processors\r\n");
  }
  let wall = rtc_seconds(&mut win, cpu);        // CLOCK_REALTIME = this + the clock, which starts at 0
  let vm_where = dt_slots(cpu);
  puts(&mut console, "devicetree: ");
  put_num(&mut console, vm_where.slots);
  puts(&mut console, " virtio-mmio slots from ");
  put_hex(&mut console, vm_where.first);
  puts(&mut console, "\r\n");
  let ecam = dt_first(cpu, "pci-host-ecam-generic");
  let dev = blk_find(&mut m, &mut win, vm_where, ecam);
  let dk_lo = blk_mmio_lo(dev);
  let dk_hi = blk_mmio_hi(dev);
  let disk = disk_mount(dev);
  let tsc = tsc_from_hz(cpu, boot_info(cpu, INFO_CNTFRQ, 0));   // 0 Hz: the clock follows the timer ticks (set_clock)
  if blk_is_virtio(disk.dev) {
    puts(&mut console, "disk: virtio\r\n");
  }
  if blk_is_nvme(disk.dev) {
    puts(&mut console, "disk: NVMe\r\n");
  }
  if blk_is_usb(disk.dev) {
    puts(&mut console, "disk: USB, the BastiOS partition (");
    put_num(&mut console, blk_sectors(disk.dev));
    puts(&mut console, " sectors)\r\n");
  }
  if disk.blocks > 0 {
    puts(&mut console, "disk: the BastiOS file system, ");
    put_num(&mut console, disk.blocks);
    puts(&mut console, " blocks of 4 KiB\r\n");
  }
  let nic = nic_find(&mut m, &mut win, 4, dk_lo, dk_hi, vm_where, ecam);
  if nic_e1000(nic) {
    puts(&mut console, "net: e1000\r\n");
  }
  let mut k = kernel_new(m, disk, nic, Snd::None, RtcHw::Soft(SoftRtc { sec: wall, at: 0 }), mice_new(false), tsc, 0, wall * 1000000000, cpu_count(cpu));
  install_files(&mut console, &mut k);
  if spawn(&mut k, 0, 0) == 0 {
    puts(&mut console, "cannot start the shell\r\n");
  }
  let mut s0 = Sys { k: k, con: console, stop: false };
  pump(con, &mut s0);
  // Every processor runs the scheduler until the kernel stops; then they
  // are all parked again and the state is this one's.
  let sl = lock_new(s0);
  smp_run(sched, &mut cpu, &mut mmu, sl, con);
  let mut s = lock_end(sl);
  // Power off: tear down whatever is left, so every page goes back.
  kernel_drop_spaces(&mut s.k, mmu);
  match s.k.shm {
    Store::None => {},
    Store::Table(t) => { free_l2(&mut s.k.mem, t); },
  }
  match s.k.txt {
    Store::None => {},
    Store::Table(t) => { free_l2(&mut s.k.mem, t); },
  }
  let devs = vfs_free(s.k.fs, &mut s.k.mem);
  blk_free(&mut win, devs.lo, &mut s.k.mem);
  blk_free(&mut win, devs.disk, &mut s.k.mem);
  nic_free(&mut win, s.k.nic, &mut s.k.mem);
  snd_free(s.k.snd, &mut s.k.mem);
  puts(&mut s.con, "\r\nBastiOS: ");
  put_num(&mut s.con, count_free(s.k.mem.bm));
  puts(&mut s.con, " pages free at power off\r\n");
  drain(con, &mut s.con);
  con_free(s.con);
  vec_free(s.k.spaces);
  vec_free(s.k.fpus);
  free(s.k.mem.bm);
  free(s.k.procs);
  queue_free(s.k.q);
  free(s.k.line);
  free(s.k.lxfd);
  free(s.k.ofd);
  free(s.k.pipes);
  while vec_len(s.k.pipebuf) > 0 {
    match vec_pop(&mut s.k.pipebuf) {
      PipeBuf::None => {},
      PipeBuf::Ring(b) => { bfree(b); },
    }
  }
  vec_free(s.k.pipebuf);
  free(s.k.sigact);
  free(s.k.cwd);
  free(s.k.croot);
  free(s.k.dpath);
  free(s.k.alarms);
  free(s.k.maps);
  free(s.k.holes);
  free(s.k.lazy);
  free(s.k.anon);
  free(s.k.locks);
  free(s.k.loops);
  free(s.k.ptys);
  bfree(s.k.ptyb);
  bfree(s.k.mice);
  free(s.k.ipc);
  bfree(s.k.ipcb);
  free(s.k.sys);
  free(s.k.inet6);
  free(s.k.rng);
  free(s.k.evt);
  free(s.k.sigsave);
  free(s.k.ux);
  bfree(s.k.uxb);
  free(s.k.mns);
  free(s.k.scf);
  bfree(s.k.mstr);
  pool = s.k.mem.pool;
  return 0;
}
