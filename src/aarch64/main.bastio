const V_TIMER: u64 = 32;
const V_SYSCALL: u64 = 128;
const V_ABORT: u64 = 14;

fn fault_name(con: &mut Con, v: u64)
  requires con_ok(con)
  ensures con_ok(con)
{
  if v == V_ABORT {
    puts(&mut con, "abort");
  } else {
    puts(&mut con, "exception");
  }
}

fn tick(t: u64) -> u64 {
  if t < 18446744073709551615 {
    return t + 1;
  }
  return t;
}

// The kernel's state and the console devices, which one processor owns.
struct Sys { k: Kernel, con: Con, stop: bool }
  invariant kok(k) && con_ok(con);

spec fn sys_ok(s: &Sys) -> bool {
  kok(s.k) && con_ok(s.con)
}

// A process taken out to run: its id, its lease on its address space and
// its FP/SIMD page.
struct Task { pid: u64, lease: Lease, fpu: Frame }

enum Job { Stop, Idle, Run(Task) }

/// Writes the kernel's waiting output to the serial line.
fn drain(ser: &Serial, c: &mut Con)
  requires con_ok(c)
  ensures con_ok(c)
{
  let mut out = true;
  while out
    invariant con_ok(c)
  {
    let mut b = balloc(256);
    let got = con_take(&mut c, &mut b);
    let mut i = 0;
    while i < got && i < blen(b)
      invariant con_ok(c)
    {
      serial_write(ser, bget(b, i));
      i = i + 1;
    }
    bfree(b);
    out = got == 256;
  }
}

/// Moves typed bytes from the serial line into the kernel and its output to
/// the line.
fn pump(ser: &Serial, s: &mut Sys)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  let mut typed = false;
  let mut c = serial_poll(ser);
  let mut n = 0;
  while c < 256 && n < 4096
    invariant sys_ok(s)
  {
    q_push(&mut s.k.q, c);
    typed = true;
    n = n + 1;
    c = serial_poll(ser);
  }
  if typed {
    tty_intr(&mut s.con, &mut s.k);
    tty_cook(&mut s.con, &mut s.k);
    wake_readers(&mut s.k.procs, &mut s.k.q, s.k.line);
  }
  drain(ser, &mut s.con);
  wake_writers(&mut s.k.procs);
}

/// The clock, from the timer ticks (10 ms each): CLOCK_MONOTONIC and the
/// wall clock the file system stamps files with.
fn set_clock(s: &mut Sys)
  requires sys_ok(s)
  ensures sys_ok(s)
{
  s.k.ns = (s.k.ticks % 1000000000000) * NS_PER_TICK;
  s.k.fs.now = sat_add(s.k.epoch, s.k.ns) / 1000000000;
}

/// What the processor does next. Starting at `from` (round robin), takes
/// the next READY process out, with its registers loaded into `cpu`, and
/// marks it RUNNING.
fn next_job(s: &mut Sys, cpu: &mut Cpu, mmu: &mut Mmu, from: u64) -> Job
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  ensures sys_ok(s)
  ensures result is Job::Run ==> (1 <= result.Run.pid && result.Run.pid < NPROC)
  ensures !(result is Job::Run) ==> mmu_root(mmu) == KERNEL_ROOT
{
  if s.stop {
    return Job::Stop;
  }
  rng_stir(&mut s.k, cpu);
  nic_feed(&mut s.k.nic, &mut s.k.mem);
  nic_poll(&mut s.k.nic);
  net_wake(&mut s.k);
  disk_wake(&mut s.k);
  sock_wake(&mut s.k);
  if s.k.naps {
    sleepers_due(&mut s.k);
  }
  let p = lx_pick(&mut s.k, from);
  if p == 0 {
    if live_count(s.k.procs) == 0 {
      s.stop = true;
      return Job::Stop;
    }
    return Job::Idle;
  }
  group_take(&mut s.k, mmu, p);                 // a thread gets its group's space
  if !lx_deliver(&mut s.k, mmu, p) {
    return Job::Idle;                       // a signal ended it
  }
  match take_space(&mut s.k.spaces, p) {
    Space::Empty => {
      // A READY process always has a space; end it rather than spin on it.
      terminate(&mut s.k, mmu, p, 139);
      return Job::Idle;
    },
    Space::Mapped(root) => {
      match take_fpu(&mut s.k.fpus, p) {
        Fpu::None => {
          put_space(&mut s.k.spaces, p, Space::Mapped(root));
          terminate(&mut s.k, mmu, p, 139);
          return Job::Idle;
        },
        Fpu::State(f) => {
          let mut sp = root;
          let l = mmu_enter(&mut mmu, &mut sp);
          put_space(&mut s.k.spaces, p, Space::Mapped(sp));
          let mut r = 0;
          while r < NLOAD
            invariant r <= NLOAD && ptab_ok(s.k.procs)
          {
            cpu_set(&mut cpu, r, pget(s.k.procs, p, reg_word(r)));
            r = r + 1;
          }
          cpu_set(&mut cpu, R_TLS, pget(s.k.procs, p, reg_word(R_TLS)));
          pset(&mut s.k.procs, p, F_STATE, RUNNING);
          return Job::Run(Task { pid: p, lease: l, fpu: f });
        },
      }
    },
  }
}

/// After process `p` ran until a trap with vector `v` (its lease given
/// back): puts its FP/SIMD page `fpu` and registers back and handles the
/// trap. Returns where the round robin goes on.
fn finish(s: &mut Sys, cpu: &mut Cpu, mmu: &Mmu, p: u64, fpu: Frame, v: u64) -> u64
  requires sys_ok(s) && mmu_root(mmu) == KERNEL_ROOT
  requires 1 <= p && p < NPROC
  ensures sys_ok(s) && result < NPROC
{
  restore_fpu(&mut s.k.mem, &mut s.k.fpus, p, Fpu::State(fpu));
  let mut r = 0;
  while r < NREGS
    invariant r <= NREGS && ptab_ok(s.k.procs)
  {
    pset(&mut s.k.procs, p, reg_word(r), cpu_get(cpu, r));
    r = r + 1;
  }
  if v == V_TIMER {
    s.k.ticks = tick(s.k.ticks);
    set_clock(&mut s);
  }
  if state(s.k.procs, p) == EXITING {
    thread_free(&mut s.k, mmu, p, tgid(s.k.procs, p));
    return (p + 1) % NPROC;
  }
  group_take(&mut s.k, mmu, p);
  let killed = state(s.k.procs, p) == KILLED;
  if state(s.k.procs, p) == RUNNING || killed {
    pset(&mut s.k.procs, p, F_STATE, READY);
  }
  if killed {
    terminate(&mut s.k, mmu, p, 137);
    return (p + 1) % NPROC;
  }
  if v == V_TIMER {
    if pget(s.k.procs, p, F_RESTART) == 0 {
      pset(&mut s.k.procs, p, F_TICKS, tick(pget(s.k.procs, p, F_TICKS)));
      cpu_timers_tick(&mut s.k, p);
    }
    lx_alarms(&mut s.k);
    return (p + 1) % NPROC;
  }
  if v == V_SYSCALL {
    set_clock(&mut s);
    let what = syscall(&mut s.con, &mut s.k, mmu, p);
    if what == POWEROFF || what == REBOOT {
      s.stop = true;
    }
    sock_wake(&mut s.k);
    if disk_hold(&mut s.k, p, NO_RESULT) {
      return (p + 1) % NPROC;
    }
    if what == KEEP {
      return p;
    }
    return (p + 1) % NPROC;
  }
  if v == V_ABORT {
    let lz = lazy_fault(&mut s.k, p);
    if lz == LZ_WAIT && state(s.k.procs, p) == READY {
      pset(&mut s.k.procs, p, F_STATE, DISKWAIT);
      pset(&mut s.k.procs, p, F_WAIT, RETRY_BIT + s.k.fs.disk.q.moved % RETRY_BIT);
      disk_wake(&mut s.k);
      if state(s.k.procs, p) == DISKWAIT {
        return (p + 1) % NPROC;
      }
      return p;
    }
    if lz != LZ_NO || anon_fault(&mut s.k, p) || cow_fault(&mut s.k, p) || stack_fault(&mut s.k, p) {
      return p;                             // code read, a page mapped or copied, or the stack grew: run the instruction again
    }
  }
  // Any other trap, or an abort nothing could mend: the process dies of the
  // signal Linux would send (a SIGSEGV), unless it has a handler.
  let sig = SIGSEGV;
  let addr = pget(s.k.procs, p, reg_word(R_FAULT));
  if fault_caught(&mut s.k, p, sig, addr) {
    return (p + 1) % NPROC;
  }
  puts(&mut s.con, "\r\n[pid ");
  put_num(&mut s.con, p);
  puts(&mut s.con, " (");
  puts(&mut s.con, prog_name(pget(s.k.procs, p, F_PROG)));
  puts(&mut s.con, "): ");
  fault_name(&mut s.con, v);
  puts(&mut s.con, " at pc ");
  put_hex(&mut s.con, pget(s.k.procs, p, reg_word(R_PC)));
  puts(&mut s.con, ", address ");
  put_hex(&mut s.con, addr);
  puts(&mut s.con, "; killed]\r\n");
  terminate(&mut s.k, mmu, p, SIG_DEATH + sig);
  return (p + 1) % NPROC;
}

fn main(con: &mut Serial, pool: &mut Pool, mmu: &mut Mmu, cpu: &mut Cpu) -> u64 {
  let m = mem_new(pool);
  let disk = disk_mount(Blk::Loop(loopdev_new(vec_new[Slot](), 0)));
  let tsc = Tsc { base: 0, mult: 0, at: 0 };      // the clock follows the timer ticks (set_clock)
  let mut console = con_new();
  puts(&mut console, "\r\nBastiOS 0.2 (aarch64): ");
  put_num(&mut console, count_avail(m.bm));
  puts(&mut console, " pages of memory, 1 processor\r\n");
  let mut k = kernel_new(m, disk, Nic::None, Snd::None, mice_new(false), tsc, 0, 0, 1);
  install_files(&mut console, &mut k);
  if spawn(&mut k, 0, 0) == 0 {
    puts(&mut console, "cannot start the shell\r\n");
  }
  let mut s = Sys { k: k, con: console, stop: false };
  pump(con, &mut s);
  let mut cur = 1;
  let mut job = next_job(&mut s, &mut cpu, &mut mmu, cur);
  let mut going = true;
  while going
    invariant sys_ok(s) && cur < NPROC
    invariant !(job is Job::Run) ==> mmu_root(mmu) == KERNEL_ROOT
    invariant job is Job::Run ==> (1 <= job.Run.pid && job.Run.pid < NPROC)
  {
    match job {
      Job::Stop => {
        going = false;
        job = Job::Stop;
      },
      Job::Idle => {
        // Nothing to run: sleep until the next interrupt (the timer ticks).
        let v = cpu_idle(&mut cpu);
        if v == V_TIMER {
          s.k.ticks = tick(s.k.ticks);
          set_clock(&mut s);
          lx_alarms(&mut s.k);
        }
        sleepers_wake(&mut s.k);
        pump(con, &mut s);
        job = next_job(&mut s, &mut cpu, &mut mmu, cur);
      },
      Job::Run(t) => {
        cpu_fpu_load(&mut cpu, t.fpu);
        let v = cpu_run(&mut cpu, mmu);
        mmu_exit(&mut mmu, t.lease);
        let mut f = t.fpu;
        cpu_fpu_save(&mut cpu, &mut f);
        cur = finish(&mut s, &mut cpu, mmu, t.pid, f, v);
        if v == V_TIMER {
          pump(con, &mut s);
        }
        job = next_job(&mut s, &mut cpu, &mut mmu, cur);
      },
    }
  }
  match job {
    Job::Run(t) => {
      mmu_exit(&mut mmu, t.lease);
      let c = finish(&mut s, &mut cpu, mmu, t.pid, t.fpu, V_TIMER);
    },
    Job::Idle => {},
    Job::Stop => {},
  }
  // Power off: tear down whatever is left, so every page goes back.
  kernel_drop_spaces(&mut s.k, mmu);
  match s.k.shm {
    Store::None => {},
    Store::Table(t) => { free_l2(&mut s.k.mem, t); },
  }
  match s.k.txt {
    Store::None => {},
    Store::Table(t) => { free_l2(&mut s.k.mem, t); },
  }
  let devs = vfs_free(s.k.fs, &mut s.k.mem);
  blk_free(devs.lo, &mut s.k.mem);
  blk_free(devs.disk, &mut s.k.mem);
  nic_free(s.k.nic, &mut s.k.mem);
  snd_free(s.k.snd, &mut s.k.mem);
  puts(&mut s.con, "\r\nBastiOS: ");
  put_num(&mut s.con, count_free(s.k.mem.bm));
  puts(&mut s.con, " pages free at power off\r\n");
  drain(con, &mut s.con);
  con_free(s.con);
  vec_free(s.k.spaces);
  vec_free(s.k.fpus);
  free(s.k.mem.bm);
  free(s.k.procs);
  queue_free(s.k.q);
  free(s.k.line);
  free(s.k.lxfd);
  free(s.k.ofd);
  free(s.k.pipes);
  while vec_len(s.k.pipebuf) > 0 {
    match vec_pop(&mut s.k.pipebuf) {
      PipeBuf::None => {},
      PipeBuf::Ring(b) => { bfree(b); },
    }
  }
  vec_free(s.k.pipebuf);
  free(s.k.sigact);
  free(s.k.cwd);
  free(s.k.croot);
  free(s.k.dpath);
  free(s.k.alarms);
  free(s.k.maps);
  free(s.k.holes);
  free(s.k.lazy);
  free(s.k.anon);
  free(s.k.locks);
  free(s.k.loops);
  free(s.k.ptys);
  bfree(s.k.ptyb);
  bfree(s.k.mice);
  free(s.k.ipc);
  bfree(s.k.ipcb);
  free(s.k.sys);
  free(s.k.inet6);
  free(s.k.rng);
  free(s.k.evt);
  free(s.k.sigsave);
  free(s.k.ux);
  bfree(s.k.uxb);
  free(s.k.mns);
  free(s.k.scf);
  bfree(s.k.mstr);
  pool = s.k.mem.pool;
  return 0;
}
