// Where devices may lie on AArch64. The device window starts at 0 here and
// the kernel image and the page pool's RAM are excluded by the platform
// (docs/language.md, MmioSpace). QEMU's virt machine puts its devices in
// the first GiB, below RAM at 0x40000000, and (with its default "highmem")
// the PCI Express configuration window in the GiB at 256 GiB, where
// 64-bit BARs could sit too; nothing else is claimed.
const WIN_LO: u64 = 0;
const WIN_LOW_TOP: u64 = 0x40000000;
const WIN_HIGH: u64 = 0x4000000000;
const WIN_TOP: u64 = 0x4040000000;

spec fn bar_space(a: u64) -> bool {
  (WIN_LO <= a && a < WIN_LOW_TOP) || (WIN_HIGH <= a && a < WIN_TOP)
}

// Where the virtio-mmio slots are by default (QEMU virt: 32 devices from here, 0x200 apart).
const VM_SLOT0: u64 = 0x0a000000;
const VM_SLOTS: u64 = 32;

// Where a PCI Express host bridge's 32-bit memory window lies on QEMU's virt
// machine (below its RAM): BARs are assigned from here (src/pci.bastio).
const PCI_WIN_LO: u64 = 0x10000000;
const PCI_WIN_HI: u64 = 0x3eff0000;
