// The program images built into the AArch64 kernel (build/aarch64/user) and
// the vDSO page. Only the first four programs of the table and the Linux arm64 mhello, mtest and ash exist so far; the
// others read as empty images, which the loader refuses.

import "pages.bastio";
import "elf.bastio";
import "tsc.bastio";

fn prog_image(i: u64) -> Str {
  if i == 0 {
    return include_bytes("../../../build/aarch64/user/sh.bin");
  }
  if i == 1 {
    return include_bytes("../../../build/aarch64/user/hello.bin");
  }
  if i == 2 {
    return include_bytes("../../../build/aarch64/user/spin.bin");
  }
  if i == 3 {
    return include_bytes("../../../build/aarch64/user/true.bin");
  }
  if i == 10 {
    return include_bytes("../../../build/aarch64/user/mhello.elf");
  }
  if i == 13 {
    return include_bytes("../../../build/aarch64/user/ash.elf");
  }
  if i == 12 {
    return include_bytes("../../../build/aarch64/user/mtest.elf");
  }
  return "";
}

/// Whether the vDSO page holds an ELF image for AT_SYSINFO_EHDR to point at.
/// It does not yet on AArch64, and musl's dynamic linker reads whatever
/// that address holds as an ELF header.
fn vdso_is_elf() -> bool {
  return false;
}

/// Fills the vDSO page: AArch64 has no vDSO image yet, only the clock words
/// and the signal return trampoline (`mov x8, #139; svc #0`).
fn vdso_fill(f: &mut Frame, t: Tsc, epoch: u64) {
  frame_write(&mut f, VDSO_DATA, t.mult);
  frame_write(&mut f, VDSO_DATA + 1, t.base);
  frame_write(&mut f, VDSO_DATA + 2, t.at);
  frame_write(&mut f, VDSO_DATA + 3, epoch);
  frame_write(&mut f, SIGTRAMP_AT / 8, 0xD4000001D2801168);
}
