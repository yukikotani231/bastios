// Finding and starting the network card on AArch64 (virtio on the
// memory-mapped transport), and releasing it at power off.

import "card.bastio";
import "netconst.bastio";
import "e1000.bastio";
import "pci.bastio";
import "vpci.bastio";

/// A virtio network card over the transport `io`, given the nine pages
/// from page `at` on.
fn virtio_nic_start(m: &mut Mem, at: u64, io: Vt) -> Nic
  requires mem_ok(m) && vt_ok(io) && at + NET_PAGES <= NPAGES && at + NET_PAGES <= len(m.bm)
  requires forall i: u64 :: at <= i && i < at + NET_PAGES ==> get(m.bm, i) == 1
  ensures nic_ok(result) && mem_ok(m)
{
  let q0 = take_low_page(&mut m, at);
  let q1 = take_low_page(&mut m, at + 1);
  let q2 = take_low_page(&mut m, at + 2);
  let t0 = take_low_page(&mut m, at + 3);
  let t1 = take_low_page(&mut m, at + 4);
  let t2 = take_low_page(&mut m, at + 5);
  let b0 = take_low_page(&mut m, at + 6);
  let b1 = take_low_page(&mut m, at + 7);
  let b2 = take_low_page(&mut m, at + 8);
  return net_up(Card::Virtio(vnet_new(io, q0, q1, q2, t0, t1, t2, b0, b1, b2, false)));
}

/// A card on the PCI Express bus whose configuration window starts at
/// `ecam` (0: the machine has none): a modern virtio network function (nine
/// pages from page `at` on), else an Intel e1000 family card (six), if its
/// registers lie in the device window clear of `dk_lo .. dk_hi`; none
/// otherwise. BARs are assigned first (a no-op for those the disk probe
/// already placed). Polled: no interrupt is routed.
fn pci_nic_start(m: &mut Mem, win: &mut MmioSpace, at: u64, dk_lo: u64, dk_hi: u64, ecam: u64) -> Nic
  requires mem_ok(m) && at + NET_PAGES <= NPAGES && E1K_PAGES <= NET_PAGES && at + NET_PAGES <= len(m.bm)
  requires forall a: u64 :: bar_space(a) && !(dk_lo <= a && a < dk_hi) ==> mmio_free(win, a)
  ensures nic_ok(result) && mem_ok(m)
{
  if ecam >= WIN_TOP || ecam % 4096 != 0 || !((ecam >= WIN_LO && ecam + ECAM_LEN <= WIN_LOW_TOP) || (ecam >= WIN_HIGH && ecam + ECAM_LEN <= WIN_TOP))
    || !(ecam + ECAM_LEN <= dk_lo || ecam >= dk_hi) || !pages_free(m, at, NET_PAGES) {
    return Nic::None;
  }
  let mut pci = Pci { cfg: mmio_claim(&mut win, ecam, ECAM_LEN) };
  pci_assign(&mut pci, PCI_WIN_LO, PCI_WIN_HI);
  match vpci_locate(&mut pci, VM_ID_NET) {
    VpFound::At(a) => {
      if a.bar < WIN_LO || !(a.bar + a.end <= dk_lo || a.bar >= dk_hi) || !(a.bar + a.end <= ecam || a.bar >= ecam + ECAM_LEN) {
        pci_free(&mut win, pci);
        return Nic::None;
      }
      pci_enable(&mut pci, a.dev);
      pci_free(&mut win, pci);
      return virtio_nic_start(&mut m, at, vpci_open(&mut win, a));
    },
    VpFound::None => {},
  }
  let e = e1k_find(&mut pci);
  if e >= PCI_NONE {
    pci_free(&mut win, pci);
    return Nic::None;
  }
  let bar = pci_mem_bar(&mut pci, e);
  let id = pci_read(&mut pci, e, PCI_ID);
  if bar < WIN_LO || bar + E1K_LEN > WIN_LOW_TOP || bar % 4096 != 0 || !(bar + E1K_LEN <= dk_lo || bar >= dk_hi)
    || !(bar + E1K_LEN <= ecam || bar >= ecam + ECAM_LEN) {
    pci_free(&mut win, pci);
    return Nic::None;
  }
  pci_enable(&mut pci, e);
  pci_free(&mut win, pci);
  let r = take_low_page(&mut m, at);
  let b0 = take_low_page(&mut m, at + 1);
  let b1 = take_low_page(&mut m, at + 2);
  let b2 = take_low_page(&mut m, at + 3);
  let b3 = take_low_page(&mut m, at + 4);
  let b4 = take_low_page(&mut m, at + 5);
  let b5 = take_low_page(&mut m, at + 6);
  let b6 = take_low_page(&mut m, at + 7);
  let b7 = take_low_page(&mut m, at + 8);
  let regs = mmio_claim(&mut win, bar, E1K_LEN);
  return net_up(Card::E1000(e1k_new(regs, e1k_model(id % 65536, id / 65536 % 65536), r, b0, b1, b2, b3, b4, b5, b6, b7)));
}

/// Starts the network card: the first virtio network device in the slots
/// `vm`, clear of `dk_lo .. dk_hi` (the disk's registers), with nine pages
/// from page `at` on; else a virtio or e1000 family card on the PCI Express bus at
/// `ecam` (see `pci_nic_start`); none if there is no such device.
fn nic_find(m: &mut Mem, win: &mut MmioSpace, at: u64, dk_lo: u64, dk_hi: u64, vm: VmWhere, ecam: u64) -> Nic
  requires mem_ok(m) && vmw_ok(vm) && at + NET_PAGES <= NPAGES && E1K_PAGES <= NET_PAGES
  requires forall a: u64 :: bar_space(a) && !(dk_lo <= a && a < dk_hi) ==> mmio_free(win, a)
  ensures nic_ok(result) && mem_ok(m)
{
  if !pages_free(m, at, NET_PAGES) {
    return Nic::None;
  }
  match vm_find(&mut win, VM_ID_NET, vm, dk_lo, dk_hi, 0, 0, 0, 0, 0, 0) {
    VmFound::Found(d) => { return virtio_nic_start(&mut m, at, Vt::Mem(d)); },
    VmFound::None => { return pci_nic_start(&mut m, &mut win, at, dk_lo, dk_hi, ecam); },
  }
}

/// Resets the card and takes its pages back (at power off).
fn nic_free(win: &mut MmioSpace, c: Nic, m: &mut Mem)
  requires nic_ok(c) && mem_ok(m)
  ensures mem_ok(m)
{
  match c {
    Nic::None => {},
    Nic::Up(n) => {
      card_free(&mut win, net_dismantle(n, &mut m), &mut m);
    },
  }
}
