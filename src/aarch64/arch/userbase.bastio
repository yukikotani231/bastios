// Where the user window starts, and where a PIE goes in it (AArch64). The
// kernel and the user window share one top-level table here: slot 0 maps
// the kernel and slot 1 the window, which starts at 512 GiB. A program
// image starts at the window's first page (PIE_AT is an offset into it).
const USER_BASE: u64 = 0x8000000000;
const PIE_AT: u64 = 0;
