// Where the user window starts, and where a PIE goes in it (AArch64). The
// CPU runs user code on a table of its own (boot/aarch64/boot.S), so the
// window starts at address 0 and nothing of the kernel is in it. Nothing is
// mapped below PIE_AT, so a null pointer (and a small offset from one) faults,
// and a non-PIE executable linked at 0x400000, where Linux puts one, loads
// where it was linked.
const USER_BASE: u64 = 0;
const PIE_AT: u64 = 0x400000;
