// USB on an xHCI (USB 3) host controller: a keyboard and a mouse, for PCs
// without PS/2 ports, and a USB stick or disk to keep the file system on. When the
// stick is the disk and the controller has MSI-X, its event ring raises
// V_DISK, as the other disks do, so a process waiting for it sleeps;
// otherwise the controller is polled.
//
// The driver brings up the controller and looks at the devices on its
// root ports and on the hubs below them. The first that offers a HID boot
// keyboard interface (every USB keyboard does, for firmware setup screens)
// becomes the keyboard: it gets a device slot, and its interrupt IN
// endpoint is configured. From then on, one 8-byte transfer is kept
// queued on that endpoint; each completed one is a boot report (modifier
// bits, then up to six keys held down), and keys that were not down in the
// last report become the bytes a serial terminal would send, as for PS/2.
// The first that offers a HID boot mouse interface becomes the mouse, the
// same way: its boot reports (buttons, then the motion in x and y, down
// positive, then, from most mice, the wheel, up positive) become PS/2
// packets with the wheel (src/kbd.bastio), which the console moves
// to /dev/input/mice (src/lxmouse.bastio). A wireless receiver offers both
// interfaces on one device, which then serves as both, on one slot.
//
// The first that offers a mass-storage interface (SCSI commands over the
// bulk-only transport, as every USB stick does) gets a slot too, and
// its two bulk endpoints. Each SCSI command is three transfers: a 31-byte
// command block wrapper out, the data, and a 13-byte status wrapper in.
// The driver uses the disk only if its GPT has a partition of the BastiOS
// type (BASTIOS_PART), and then only that partition: a stick holding the
// boot image (`make usb`) keeps Limine and the kernel in the partitions
// before it. A stick without one is left alone.
// Hubs (USB 2) are followed two deep: a device on a hub's port gets a
// route string and, if it is low or full speed behind a high-speed hub,
// that hub's transaction translator. A USB 3 hub is only seen through
// the USB 2 hub inside it, so a SuperSpeed device behind one is not found.
//
// The registers are a block of the device window claimed as an `Mmio`.
// The controller reads and writes only the eleven pages lent to it at
// start (`Dma`), which come back after a controller reset at power off:
//
//   dcbaa   0: the device context base address array; 2048: the scratchpad array
//           (up to XHCI_SP_MAX entries)
//   cmd     the command ring
//   evt     0: the event ring segment table (one segment); 64: the event ring
//   ctx     0: slot 1's device context; 2048: slot 2's (written by the controller)
//   ctx2    0: slot 3's; 2048: slot 4's
//   inp     0: the input context (up to 33 contexts of 64 bytes);
//           3072: data of control transfers
//   ep0     the default control endpoint rings of slots 1-4, 1024 bytes each
//   intr    0: the keyboard's interrupt transfer ring; 2048: its report;
//           3072: the mouse's report
//   bulk    0: the disk's bulk OUT ring; 1024: the command block wrapper;
//           2048: its bulk IN ring; 3072: the status wrapper
//   data    the data of the disk's commands: up to a 4 KiB block
//   ctx3    0: slot 5's device context; 2048: its control ring;
//           3072: the mouse's interrupt transfer ring
//
// and the scratchpad pages the controller asks for (`sps`: Intel's want 34
// or so; QEMU's none), taken from the pool wherever they are free.
//
// Rings are RING_N TRBs of 16 bytes, the last a link back to the start.
// Producer and consumer positions are kept as index * 2 + cycle bit.

import "pci.bastio";
import "pages.bastio";
import "bio.bastio";
import "blkconst.bastio";

const XHCI_CLASS: u64 = 0x0C0330;      // serial bus controller, USB, xHCI
const XHCI_PAGES: u64 = 13;
const USB_AT: u64 = 32;                // the controller's pages: 32 .. 44
const XHCI_SLOTS: u64 = 6;             // the keyboard's, the mouse's, the disk's, the serial port's, and two hubs'
const MQ_N: u64 = 16;                  // mouse packets kept, not yet taken
const XHCI_DEPTH: u64 = 2;             // hubs followed: one on a root port, and one on that
const XHCI_MAX_LEN: u64 = 0x100000;    // registers claimed: the BAR, up to 1 MiB
const XHCI_SPINS: u64 = 20000000;
const XHCI_SP_MAX: u64 = 256;          // scratchpad pages: the array's half page holds 256
const XHCI_SETTLE_MS: u64 = 1000;
const XHCI_TRIES: u64 = 8;             // the most controllers looked at      // the longest wait for devices to show up on the ports
const RING_N: u64 = 64;
const EVT_N: u64 = 252;                // event ring TRBs: offsets 64 .. 4096
const SQ_N: u64 = 1024;                // serial bytes received, not yet taken
const SER_IN_RING: u64 = 1024;         // in the serial page: the bulk OUT ring is at 0, the IN ring here,
const SER_TX_BUF: u64 = 2048;          // the bytes being sent (at most SER_TX_MAX),
const SER_RX_BUF: u64 = 2560;          // and the packet received (at most SER_RX_MAX)
const SER_TX_MAX: u64 = 512;
const SER_RX_MAX: u64 = 512;
const RAW_AT: u64 = 3072;              // the control-transfer data area
const RAW_LEN: u64 = 1024;
const CBW_AT: u64 = 1024;              // in the bulk page
const IN_RING: u64 = 2048;
const CSW_AT: u64 = 3072;
const CBW_SIG: u64 = 0x43425355;       // "USBC"
const CSW_SIG: u64 = 0x53425355;       // "USBS"
const GPT_SIG: u64 = 0x5452415020494645;   // "EFI PART"
// The BastiOS partition type, e0c9ea2a-d5f1-45b3-a799-0a7bec83d701, as
// the two little-endian words a GPT entry stores it in.
const BASTIOS_PART_LO: u64 = 0x45b3d5f1e0c9ea2a;
const BASTIOS_PART_HI: u64 = 0x01d783ec7b0a99a7;
const MSD_NONE: u64 = 0;               // no mass-storage device
const MSD_UNUSED: u64 = 1;             // one, but no BastiOS partition on it
const MSD_ON: u64 = 2;                 // one, and its partition is the disk
const USB_SECTOR: u64 = 512;

// Operational registers (from the end of the capability registers).
const USBCMD: u64 = 0x00;
const USBSTS: u64 = 0x04;
const PAGESIZE: u64 = 0x08;
const CRCR: u64 = 0x18;
const DCBAAP: u64 = 0x30;
const CONFIG: u64 = 0x38;
const PORTSC: u64 = 0x400;
// Interrupter 0 (from the runtime registers).
const IMAN: u64 = 0x20;
const IMOD: u64 = 0x24;
const ERSTSZ: u64 = 0x28;
const ERSTBA: u64 = 0x30;
const ERDP: u64 = 0x38;

const CMD_RUN: u64 = 1;
const CMD_RESET: u64 = 2;
const CMD_INTE: u64 = 4;
const STS_HALTED: u64 = 1;
const STS_NOT_READY: u64 = 0x800;
const PORT_CONNECTED: u64 = 1;
const PORT_ENABLED: u64 = 2;
const PORT_RESET: u64 = 0x10;
const PORT_POWER: u64 = 0x200;
const PORT_CHANGES: u64 = 0xFE0000;    // write-1-to-clear change bits
const PORT_RESET_DONE: u64 = 0x200000;
const PORT_KEEP: u64 = 0xFF01FFFD;     // writing these back changes nothing

// TRB types.
const TRB_NORMAL: u64 = 1;
const TRB_SETUP: u64 = 2;
const TRB_DATA: u64 = 3;
const TRB_STATUS: u64 = 4;
const TRB_LINK: u64 = 6;
const TRB_ENABLE_SLOT: u64 = 9;
const TRB_DISABLE_SLOT: u64 = 10;
const TRB_ADDRESS: u64 = 11;
const TRB_CONFIGURE: u64 = 12;
const TRB_EVALUATE: u64 = 13;
const TRB_RESET_EP: u64 = 14;
const TRB_STOP_EP: u64 = 15;
const TRB_SET_DEQ: u64 = 16;
const TRB_TRANSFER_EV: u64 = 32;
// Hub port features (USB 2.0, 11.24.2).
const HUB_RESET: u64 = 4;
const HUB_POWER: u64 = 8;
const HUB_C_CONNECTION: u64 = 16;
const HUB_C_RESET: u64 = 20;
const TRB_COMMAND_EV: u64 = 33;
const CC_SUCCESS: u64 = 1;
const CC_SHORT: u64 = 13;
const EV_TAKEN: u64 = 64;              // evt_step: an event the driver took itself

// SCSI commands.
const SCSI_TEST_READY: u64 = 0x00;
const SCSI_SENSE: u64 = 0x03;
const SCSI_INQUIRY: u64 = 0x12;
const SCSI_CAPACITY: u64 = 0x25;
const SCSI_READ: u64 = 0x28;
const SCSI_WRITE: u64 = 0x2A;
const SCSI_SYNC: u64 = 0x35;

/// The serial port (an FTDI adapter or a CDC-ACM device): one packet at a
/// time is kept queued on its bulk IN endpoint, and one write at a time on
/// its OUT endpoint.
struct SerPort {
  kind: u64,          // SER_NONE, SER_FTDI or SER_ACM
  slot: u8,
  in_dci: u64,
  out_dci: u64,
  in_at: u64,         // the IN and OUT rings' positions
  out_at: u64,
  e0: u64,            // its control ring's
  mps: u64,           // the IN endpoint's packet size: the length of each transfer queued on it
  q: Bytes,           // bytes received, not yet taken
  qn: u64,
  wait: bool,         // is the IN endpoint idle, for lack of room in q?
  tx_busy: bool,      // is a write on the OUT ring?
  dead: bool,         // did a transfer fail? The port is then ignored
}

struct Xhci {
  regs: Mmio,
  dcbaa: Dma, cmd: Dma, evt: Dma, ctx: Dma, ctx2: Dma, inp: Dma, ep0: Dma, intr: Dma,
  bulk: Dma, data: Dma, ctx3: Dma, ctx4: Dma, ser: Dma,
  sps: Vec[Dma],      // the scratchpad pages
  op: u64,            // where the operational registers start
  rt: u64,            // the runtime registers
  db: u64,            // the doorbells
  csz: u64,           // bytes per context: 32 or 64
  ports: u64,
  cmd_at: u64,        // ring positions: index * 2 + cycle
  evt_at: u64,
  e0a: u64,           // slot 1's control ring
  e0b: u64,           // slot 2's
  e0c: u64,
  e0d: u64,
  e0e: u64,
  int_at: u64,
  ev_p: u64,          // the last event taken: parameter, status, control
  ev_s: u32,
  ev_c: u32,
  // The keyboard.
  slot: u8, 
  dci: u64,           // its endpoint's context index
  port: u8, 
  keys: Bytes,        // keys down in the last report
  q: Bytes,           // bytes typed, not yet taken
  qn: u64,
  shift: bool,
  ctrl: bool,
  live: bool,         // is there a keyboard?
  // The mouse.
  mslot: u8,
  mdci: u64,          // its endpoint's context index
  m_at: u64,          // its ring's position
  mq: Bytes,          // packets (4 bytes each), not yet taken
  mqn: u64,
  mbtn: u64,          // the buttons in the last report
  mlive: bool,        // is there a mouse?
  // The disk.
  msd: u64,           // MSD_NONE, MSD_UNUSED or MSD_ON
  ds: u8,             // its slot
  dout: u64,          // its bulk endpoints' context indexes
  din: u64,
  iface: u8,          // its interface, for a reset
  out_at: u64,
  in_at: u64,
  tag: u32,           // the last command's tag
  plo: u64,           // the partition: its first sector, and its size
  sectors: u64,
  busy: bool,         // a command is running
  stage: u64,         // 1 while its data comes in, before the status wrapper is asked for
  done: bool,         // and the controller has said it ended
  dcc: u64,           // how: the completion code
  bop: u64,           // what it is: BIO_READ, BIO_WRITE or BIO_FLUSH
  irq: bool,          // do events raise an interrupt (MSI-X)?
  sp: SerPort,         // the serial port
}

spec fn xhci_ok(x: &Xhci) -> bool {
  mmio_base(x.regs) % 4096 == 0 && mmio_len(x.regs) <= XHCI_MAX_LEN
  && x.op % 8 == 0 && x.op + PORTSC + 4096 <= mmio_len(x.regs)
  && x.rt % 32 == 0 && x.rt + 64 <= mmio_len(x.regs)
  && x.db % 4 == 0 && x.db + 1024 <= mmio_len(x.regs)
  && (x.csz == 32 || x.csz == 64)
  && x.cmd_at < RING_N * 2 && x.e0a < RING_N * 2 && x.e0b < RING_N * 2
  && x.e0c < RING_N * 2 && x.e0d < RING_N * 2 && x.e0e < RING_N * 2 && x.int_at < RING_N * 2
  && x.sp.e0 < RING_N * 2 && x.sp.in_at < RING_N * 2 && x.sp.out_at < RING_N * 2 && x.sp.in_dci < 32 && x.sp.out_dci < 32
  && x.sp.mps <= SER_RX_MAX && x.sp.kind <= SER_ACM && blen(x.sp.q) == SQ_N && x.sp.qn <= SQ_N
  && x.m_at < RING_N * 2 && x.mdci < 32 && blen(x.mq) == MQ_N * 4 && x.mqn <= MQ_N && x.mbtn < 8
  && x.evt_at < EVT_N * 2 && x.out_at < RING_N * 2 && x.in_at < RING_N * 2
  && x.dci < 32 && x.dout < 32 && x.din < 32
  && x.plo <= 4294967296 && x.sectors <= 4294967296
  && blen(x.keys) == 6 && blen(x.q) == 16 && x.qn <= 16 && vlen(x.sps) <= XHCI_SP_MAX
}

fn xr(x: &mut Xhci, off: u64) -> u32
  requires xhci_ok(x) && off % 4 == 0 && off + 4 <= mmio_len(x.regs)
  ensures xhci_ok(x)
{
  return mmio_read32(&mut x.regs, off);
}

fn xw(x: &mut Xhci, off: u64, v: u32)
  requires xhci_ok(x) && off % 4 == 0 && off + 4 <= mmio_len(x.regs)
  ensures xhci_ok(x)
{
  mmio_write32(&mut x.regs, off, v);
}

/// A 64-bit register as two 32-bit writes, low half first.
fn xw64(x: &mut Xhci, off: u64, v: u64)
  requires xhci_ok(x) && off % 8 == 0 && off + 8 <= mmio_len(x.regs)
  ensures xhci_ok(x)
{
  xw(&mut x, off, cast[u32](v & 0xFFFFFFFF));
  xw(&mut x, off + 4, cast[u32](v >> 32));
}

/// Writes a TRB at ring position `at` (index * 2 + cycle) of the ring at
/// byte `base` of page `d`, and returns the next position, through the
/// link TRB at the end when it gets there. The control word, with the
/// cycle bit that hands the TRB to the controller, is written last.
fn trb_put(d: &mut Dma, base: u64, at: u64, p: u64, s: u32, c: u32) -> u64
  requires at < RING_N * 2 && base % 16 == 0 && base + RING_N * 16 <= 4096
  ensures result < RING_N * 2
{
  let i = at / 2;
  let cyc = at % 2;
  dma_write64(&mut d, base + i * 16, p);
  dma_write32(&mut d, base + i * 16 + 8, s);
  dma_write32(&mut d, base + i * 16 + 12, (c & 0xFFFFFFFE) | cast[u32](cyc));
  if i + 2 < RING_N {
    return at + 2;
  }
  // The link: back to the start, toggling the cycle bit.
  let l = base + (RING_N - 1) * 16;
  let a = dma_phys(d);
  dma_write64(&mut d, l, a + base);
  dma_write32(&mut d, l + 8, 0);
  dma_write32(&mut d, l + 12, cast[u32](TRB_LINK * 1024 + 2 + cyc));
  return 1 - cyc;
}

fn zero_page(d: &mut Dma, from: u64, to: u64)
  requires from % 8 == 0 && from <= to && to <= 4096
{
  let mut o = from;
  while o + 8 <= to
    invariant o % 8 == 0 && o <= to && to <= 4096
  {
    dma_write64(&mut d, o, 0);
    o = o + 8;
  }
}

/// Takes the next event off the event ring into ev_p, ev_s, ev_c, if the
/// controller has written one.
fn evt_next(x: &mut Xhci) -> bool
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let i = x.evt_at / 2;
  let o = 64 + i * 16;
  let c = dma_read32(&mut x.evt, o + 12);
  if cast[u64](c % 2) != x.evt_at % 2 {
    return false;
  }
  x.ev_p = dma_read64(&mut x.evt, o);
  x.ev_s = dma_read32(&mut x.evt, o + 8);
  x.ev_c = c;
  if i + 1 < EVT_N {
    x.evt_at = x.evt_at + 2;
  } else {
    x.evt_at = 1 - x.evt_at % 2;
  }
  // Tell the controller how far we have read (and clear its busy bit).
  let a = dma_phys(x.evt);
  xw64(&mut x, x.rt + ERDP, (a + 64 + x.evt_at / 2 * 16) | 8);
  return true;
}

/// Takes the next event, if there is one, and returns its type (0: none).
/// The keyboard's and the mouse's reports and the end of a disk command are dealt with
/// here, whoever is waiting, and come back as EV_TAKEN: one event ring
/// serves every device.
fn evt_step(x: &mut Xhci) -> u64
  requires xhci_ok(x)
  ensures xhci_ok(x) && result <= EV_TAKEN
{
  if !evt_next(&mut x) {
    return 0;
  }
  let t = cast[u64]((x.ev_c >> 10) & 63);
  if t == TRB_TRANSFER_EV {
    let s = cast[u64](x.ev_c >> 24);
    let e = cast[u64]((x.ev_c >> 16) & 31);
    let cc = cast[u64](x.ev_s >> 24);
    if x.live && s == cast[u64](x.slot) && e == x.dci {
      if cc == CC_SUCCESS || cc == CC_SHORT {
        kbd_report(&mut x);
      }
      kbd_queue(&mut x);
      return EV_TAKEN;
    }
    if x.mlive && s == cast[u64](x.mslot) && e == x.mdci {
      if cc == CC_SUCCESS || cc == CC_SHORT {
        mouse_report(&mut x, 8 - smaller(cast[u64](x.ev_s & 0xFFFFFF), 8));
      }
      mouse_queue(&mut x);
      return EV_TAKEN;
    }
    if x.sp.kind != SER_NONE && s == cast[u64](x.sp.slot) {
      if e == x.sp.in_dci {
        ser_rx(&mut x, cc, cast[u64](x.ev_s & 0xFFFFFF));
        return EV_TAKEN;
      }
      if e == x.sp.out_dci {
        x.sp.tx_busy = false;
        if cc != CC_SUCCESS && cc != CC_SHORT {
          x.sp.dead = true;
        }
        return EV_TAKEN;
      }
    }
    // Only data coming in and the status wrapper ask for an event; any
    // other comes from an error, which ends the command too.
    if x.busy && s == cast[u64](x.ds) && (e == x.din || e == x.dout) {
      if cc != CC_SUCCESS && cc != CC_SHORT {
        x.done = true;
        x.dcc = cc;
      } else if e == x.din && x.stage == 1 {
        x.stage = 0;
        csw_queue(&mut x);
      } else if e == x.din {
        x.done = true;
        x.dcc = cc;
      }
      return EV_TAKEN;
    }
  }
  return t;
}

/// Waits for the next event of type `t` (for a transfer, on slot `slot`)
/// that evt_step does not take, dropping others, and returns its
/// completion code, or 0 if none came.
fn evt_wait(x: &mut Xhci, t: u64, slot: u64) -> u64
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let mut n = 0;
  while n < XHCI_SPINS
    invariant xhci_ok(x)
  {
    let k = evt_step(&mut x);
    if k == t && (t != TRB_TRANSFER_EV || cast[u64](x.ev_c >> 24) == slot) {
      return cast[u64](x.ev_s >> 24);
    }
    n = n + 1;
  }
  return 0;
}

/// Runs one command and returns whether it succeeded.
fn xhci_command(x: &mut Xhci, p: u64, c: u32) -> bool
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  x.cmd_at = trb_put(&mut x.cmd, 0, x.cmd_at, p, 0, c);
  xw(&mut x, x.db, 0);
  return evt_wait(&mut x, TRB_COMMAND_EV, 0) == CC_SUCCESS;
}

/// Puts a TRB on the control ring of slot `slot` (1 to 6).
fn ep0_put(x: &mut Xhci, slot: u64, p: u64, s: u32, c: u32)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  if slot == 6 {
    x.sp.e0 = trb_put(&mut x.ctx4, 2048, x.sp.e0, p, s, c);
  } else if slot == 5 {
    x.e0e = trb_put(&mut x.ctx3, 2048, x.e0e, p, s, c);
  } else if slot == 4 {
    x.e0d = trb_put(&mut x.ep0, 3072, x.e0d, p, s, c);
  } else if slot == 3 {
    x.e0c = trb_put(&mut x.ep0, 2048, x.e0c, p, s, c);
  } else if slot == 2 {
    x.e0b = trb_put(&mut x.ep0, 1024, x.e0b, p, s, c);
  } else {
    x.e0a = trb_put(&mut x.ep0, 0, x.e0a, p, s, c);
  }
}

/// Waits about `ms` milliseconds, by the controller's microframe index
/// (MFINDEX: 125 us steps, 14 bits), which counts while it runs. Bounded
/// by XHCI_SPINS reads in case it does not.
fn xhci_delay(x: &mut Xhci, ms: u64)
  requires xhci_ok(x) && ms <= 1000
  ensures xhci_ok(x)
{
  let mut prev = cast[u64](xr(&mut x, x.rt) & 0x3FFF);
  let mut seen = 0;
  let mut n = 0;
  while seen < ms * 8 && n < XHCI_SPINS
    invariant xhci_ok(x) && prev <= 0x3FFF && seen < 8000 + 0x4000 && ms <= 1000
  {
    let now = cast[u64](xr(&mut x, x.rt) & 0x3FFF);
    seen = seen + (now + 0x4000 - prev) % 0x4000;
    prev = now;
    n = n + 1;
  }
}

/// A control transfer on the default endpoint of slot `slot`: the 8-byte
/// setup packet, then `n` bytes in (`dir_in`) or none, into the data area
/// of the input-context page.
fn xhci_control(x: &mut Xhci, slot: u64, setup: u64, n: u64, dir_in: bool) -> bool
  requires xhci_ok(x) && 1 <= slot && slot <= XHCI_SLOTS && n <= RAW_LEN
  ensures xhci_ok(x)
{
  let mut trt = 0;                    // no data stage
  if n > 0 && dir_in {
    trt = 3;
  }
  ep0_put(&mut x, slot, setup, 8, cast[u32](TRB_SETUP * 1024 + 64 + trt * 65536));
  let mut status_dir = 65536;         // the status stage goes the other way
  if n > 0 && dir_in {
    let a = dma_phys(x.inp);
    ep0_put(&mut x, slot, a + RAW_AT, cast[u32](n), cast[u32](TRB_DATA * 1024 + 65536));
    status_dir = 0;
  }
  ep0_put(&mut x, slot, 0, 0, cast[u32](TRB_STATUS * 1024 + 32 + status_dir));
  xw(&mut x, x.db + slot * 4, 1);
  let cc = evt_wait(&mut x, TRB_TRANSFER_EV, slot);
  return cc == CC_SUCCESS || cc == CC_SHORT;
}

/// Byte i of the data the last control transfer brought in.
fn raw(x: &mut Xhci, i: u64) -> u64
  requires xhci_ok(x)
  ensures xhci_ok(x) && result <= 255
{
  if i < RAW_LEN {
    return cast[u64](dma_read8(&mut x.inp, RAW_AT + i));
  }
  return 0;
}

/// Writes 32-bit word w of context c (0 the input control context, 1 the
/// slot, 2 and up the endpoints) of the input context.
fn ictx(x: &mut Xhci, c: u64, w: u64, v: u32)
  requires xhci_ok(x) && c <= 32 && w < 8
  ensures xhci_ok(x)
{
  dma_write32(&mut x.inp, c * x.csz + w * 4, v);
}

/// Resets root port p (from 1) if it needs it, and returns its speed, or 0
/// if no device is enabled on it.
fn port_up(x: &mut Xhci, p: u64) -> u64
  requires xhci_ok(x) && 1 <= p && p <= 256
  ensures xhci_ok(x) && result < 16
{
  let o = x.op + PORTSC + (p - 1) * 16;
  let sc = xr(&mut x, o);
  if sc & PORT_CONNECTED == 0 {
    return 0;
  }
  if sc & PORT_ENABLED == 0 {
    // USB 2 ports need a reset to enable the device; USB 3 ones train
    // their link on their own.
    xw(&mut x, o, (sc & PORT_KEEP) | PORT_RESET);
    let mut n = 0;
    while n < XHCI_SPINS && xr(&mut x, o) & PORT_RESET_DONE == 0
      invariant xhci_ok(x) && o % 4 == 0 && o + 4 <= mmio_len(x.regs)
    {
      n = n + 1;
    }
    xhci_delay(&mut x, 10);           // reset recovery (USB 2.0, 7.1.7.5)
  }
  let now = xr(&mut x, o);
  xw(&mut x, o, (now & PORT_KEEP) | (now & PORT_CHANGES));
  if now & PORT_ENABLED == 0 {
    return 0;
  }
  return cast[u64]((now >> 10) & 15);
}

/// Sets up the device below root port p (speed `speed`), reached through
/// `depth` hubs by route string `route`, with `tt` the slot context's
/// transaction translator word: a slot and an address, then, from its
/// configuration, the keyboard or the mouse (or both) if it is one and
/// there is none yet (see hid_setup), else
/// the disk if it is a mass-storage device and there is none yet, else a
/// hub (see hub_setup) if it is one and not too deep. Otherwise the slot
/// is given back. True if it was taken.
fn dev_attach(x: &mut Xhci, p: u64, route: u64, tt: u64, speed: u64, depth: u64) -> bool
  requires xhci_ok(x) && 1 <= p && p < 256 && speed < 16 && route < 256 && tt < 65536 && depth <= XHCI_DEPTH
  requires depth == 0 ==> route == 0
  requires depth == 1 ==> route < 16
  ensures xhci_ok(x)
{
  if !xhci_command(&mut x, 0, cast[u32](TRB_ENABLE_SLOT * 1024)) {
    return false;
  }
  let s = cast[u64](x.ev_c >> 24);
  if s < 1 || s > XHCI_SLOTS {
    return false;
  }
  // The device context: half a page of ctx or ctx2. The control ring: a
  // quarter of ep0. Slots 5 and 6 have both in ctx3 and ctx4.
  let half = ((s - 1) % 2) * 2048;
  let mut ca = dma_phys(x.ctx) + half;
  let quarter = ((s - 1) % 4) * 1024;
  let mut ea = dma_phys(x.ep0) + quarter;
  if s == 6 {
    zero_page(&mut x.ctx4, 0, 3072);
    ca = dma_phys(x.ctx4);
    ea = ca + 2048;
  } else if s == 5 {
    zero_page(&mut x.ctx3, 0, 3072);
    ca = dma_phys(x.ctx3);
    ea = ca + 2048;
  } else if s <= 2 {
    zero_page(&mut x.ctx, half, half + 2048);
  } else {
    zero_page(&mut x.ctx2, half, half + 2048);
    ca = dma_phys(x.ctx2) + half;
  }
  zero_page(&mut x.inp, 0, 4096);
  if s <= 4 {
    zero_page(&mut x.ep0, quarter, quarter + 1024);
  }
  if s == 1 {
    x.e0a = 1;
  } else if s == 2 {
    x.e0b = 1;
  } else if s == 3 {
    x.e0c = 1;
  } else if s == 4 {
    x.e0d = 1;
  } else if s == 5 {
    x.e0e = 1;
  } else {
    x.sp.e0 = 1;
  }
  dma_write64(&mut x.dcbaa, s * 8, ca);
  // Address the device: the slot and its default control endpoint.
  let mut mps = 8;
  if speed == 3 {
    mps = 64;                         // high speed
  } else if speed >= 4 {
    mps = 512;                        // SuperSpeed
  }
  ictx(&mut x, 0, 1, 3);              // add the slot and endpoint 0
  ictx(&mut x, 1, 0, cast[u32](route | (speed << 20) | (1 << 27)));
  ictx(&mut x, 1, 1, cast[u32](p << 16));
  ictx(&mut x, 1, 2, cast[u32](tt));
  ictx(&mut x, 2, 1, cast[u32](6 + 4 * 8 + (mps << 16)));   // 3 retries, control endpoint
  ictx(&mut x, 2, 2, cast[u32](ea & 0xFFFFFFFF) | 1);
  ictx(&mut x, 2, 3, cast[u32](ea >> 32));
  ictx(&mut x, 2, 4, 8);
  let ia = dma_phys(x.inp);
  if !xhci_command(&mut x, ia, cast[u32](TRB_ADDRESS * 1024 + s * 16777216)) {
    return dev_detach(&mut x, s);
  }
  // A full-speed device says its endpoint 0 packet size in its descriptor.
  if !xhci_control(&mut x, s, 0x0008000001000680, 8, true) {
    return dev_detach(&mut x, s);
  }
  let mps0 = raw(&mut x, 7);
  if speed == 1 && mps0 != 8 && (mps0 == 16 || mps0 == 32 || mps0 == 64) {
    ictx(&mut x, 0, 1, 2);
    ictx(&mut x, 2, 1, cast[u32](6 + 4 * 8 + (mps0 << 16)));
    if !xhci_command(&mut x, ia, cast[u32](TRB_EVALUATE * 1024 + s * 16777216)) {
      return dev_detach(&mut x, s);
    }
  }
  // The vendor, to tell an FTDI adapter (whose interface is vendor-specific).
  let mut vid = 0;
  if xhci_control(&mut x, s, 0x0012000001000680, 18, true) {
    vid = raw(&mut x, 8) + raw(&mut x, 9) * 256;
  }
  // The configuration: a boot keyboard or boot mouse interface and its
  // interrupt IN endpoint, or a SCSI bulk-only mass-storage interface and
  // its two bulk endpoints, or the bulk endpoints of a serial port: an FTDI
  // adapter's vendor interface or a CDC data interface (with the CDC
  // control interface's number, to raise DTR).
  if !xhci_control(&mut x, s, 0x0200000002000680, 512, true) {
    return dev_detach(&mut x, s);
  }
  let total = raw(&mut x, 2) + raw(&mut x, 3) * 256;
  let config = raw(&mut x, 5);
  let mut iface = 256;
  let mut ep = 0;
  let mut emps = 0;
  let mut ival = 0;
  let mut riface = 256;               // the mouse's
  let mut rep = 0;
  let mut rmps = 0;
  let mut rival = 0;
  let mut miface = 256;
  let mut ein = 0;
  let mut eout = 0;
  let mut mpin = 0;
  let mut mpout = 0;
  let mut sface = 256;                // the serial port's data interface
  let mut cface = 256;                // and the CDC control interface (ACM)
  let mut skind = SER_NONE;
  let mut sin = 0;
  let mut sout = 0;
  let mut spin = 0;
  let mut spout = 0;
  let mut in_ser = false;
  let mut i = 0;
  let mut in_kbd = false;
  let mut in_mouse = false;
  let mut in_msd = false;
  let mut hub = false;
  while i < total && i < 512
    invariant xhci_ok(x) && iface <= 256 && ep < 16 && emps < 2048 && ival <= 255
    invariant miface <= 256 && ein < 16 && eout < 16 && mpin < 2048 && mpout < 2048
    invariant sface <= 256 && cface <= 256 && skind <= SER_ACM && sin < 16 && sout < 16 && spin < 2048 && spout < 2048
    invariant riface <= 256 && rep < 16 && rmps < 2048 && rival <= 255
  {
    let dl = raw(&mut x, i);
    let ty = raw(&mut x, i + 1);
    if dl < 2 {
      i = 512;
    } else {
      if ty == 4 {
        let class = raw(&mut x, i + 5);
        let sub = raw(&mut x, i + 6);
        let proto = raw(&mut x, i + 7);
        in_kbd = class == 3 && sub == 1 && proto == 1 && !x.live;
        in_mouse = class == 3 && sub == 1 && proto == 2 && !x.mlive;
        in_msd = class == 8 && sub == 6 && proto == 0x50 && x.msd == MSD_NONE && miface == 256;
        if in_kbd && iface == 256 {
          iface = raw(&mut x, i + 2);
        }
        if in_mouse && riface == 256 {
          riface = raw(&mut x, i + 2);
        }
        if in_msd {
          miface = raw(&mut x, i + 2);
        }
        if class == 9 {
          hub = true;
        }
        if class == 2 && sub == 2 && cface == 256 {
          cface = raw(&mut x, i + 2);
        }
        let inum = raw(&mut x, i + 2);
        in_ser = ((class == 255 && vid == 0x0403) || class == 10) && x.sp.kind == SER_NONE && (sface == 256 || sface == inum);
        if in_ser {
          sface = inum;
          skind = SER_FTDI;
          if class == 10 {
            skind = SER_ACM;
          }
        }
      } else if ty == 5 {
        let addr = raw(&mut x, i + 2);
        let attr = raw(&mut x, i + 3) & 3;
        let size = (raw(&mut x, i + 4) + raw(&mut x, i + 5) * 256) & 0x7FF;
        if in_kbd && ep == 0 && addr >= 128 && attr == 3 {
          ep = addr & 15;
          emps = size;
          ival = raw(&mut x, i + 6);
        }
        if in_mouse && rep == 0 && addr >= 128 && attr == 3 {
          rep = addr & 15;
          rmps = size;
          rival = raw(&mut x, i + 6);
        }
        if in_msd && attr == 2 {
          if addr >= 128 && ein == 0 {
            ein = addr & 15;
            mpin = size;
          } else if addr < 128 && eout == 0 {
            eout = addr & 15;
            mpout = size;
          }
        }
        if in_ser && attr == 2 {
          if addr >= 128 && sin == 0 {
            sin = addr & 15;
            spin = size;
          } else if addr < 128 && sout == 0 {
            sout = addr & 15;
            spout = size;
          }
        }
      }
      i = i + dl;
    }
  }
  if (iface < 256 && ep != 0 && emps != 0) || (riface < 256 && rep != 0 && rmps != 0) {
    return hid_setup(&mut x, s, p, route, tt, speed, config, iface, ep, emps, ival, riface, rep, rmps, rival);
  }
  if miface < 256 && ein != 0 && eout != 0 && mpin != 0 && mpout != 0 {
    return msd_setup(&mut x, s, p, route, tt, speed, config, miface, ein, eout, mpin, mpout);
  }
  if sface < 256 && sin != 0 && sout != 0 && spin != 0 && spout != 0 {
    return ser_setup(&mut x, s, p, route, tt, speed, config, skind, cface, sin, sout, spin, spout);
  }
  if hub && depth < XHCI_DEPTH {
    return hub_setup(&mut x, s, p, route, tt, speed, depth, config);
  }
  return dev_detach(&mut x, s);
}

/// GET_STATUS of port k of the hub on slot s: the port status in the low
/// 16 bits, its changes above (0 if the request fails).
fn hub_status(x: &mut Xhci, s: u64, k: u64) -> u64
  requires xhci_ok(x) && 1 <= s && s <= XHCI_SLOTS && k < 256
  ensures xhci_ok(x)
{
  if !xhci_control(&mut x, s, 0x00040000000000A3 | (k << 32), 4, true) {
    return 0;
  }
  return raw(&mut x, 0) + raw(&mut x, 1) * 256 + raw(&mut x, 2) * 65536 + raw(&mut x, 3) * 16777216;
}

/// SET_FEATURE (`set`) or CLEAR_FEATURE of feature f on port k of the hub
/// on slot s.
fn hub_feature(x: &mut Xhci, s: u64, k: u64, f: u64, set: bool) -> bool
  requires xhci_ok(x) && 1 <= s && s <= XHCI_SLOTS && k < 256 && f < 256
  ensures xhci_ok(x)
{
  let mut req = 0x0123;               // CLEAR_FEATURE, class, other (a port)
  if set {
    req = 0x0323;
  }
  return xhci_control(&mut x, s, req | (f << 16) | (k << 32), 0, false);
}

/// The USB 2 hub on slot s (below root port p, at `depth`): told it is a
/// hub, its ports powered, and each port with a device on it reset and the
/// device attached (dev_attach) until there are a keyboard, a mouse and a
/// disk. If
/// nothing below it was taken, its slot is given back.
fn hub_setup(x: &mut Xhci, s: u64, p: u64, route: u64, tt: u64, speed: u64, depth: u64, config: u64) -> bool
  requires xhci_ok(x) && 1 <= s && s <= XHCI_SLOTS && 1 <= p && p < 256 && speed < 16
  requires route < 256 && tt < 65536 && depth < XHCI_DEPTH && config <= 255
  requires depth == 0 ==> route == 0
  requires depth == 1 ==> route < 16
  ensures xhci_ok(x)
{
  // SET_CONFIGURATION, then the hub descriptor: its port count, its
  // characteristics (the TT think time) and its power-on delay.
  if !xhci_control(&mut x, s, (config << 16) | 0x0900, 0, false)
    || !xhci_control(&mut x, s, 0x00080000290006A0, 8, true) {
    return dev_detach(&mut x, s);
  }
  let mut n = raw(&mut x, 2);
  if n > 15 {
    n = 15;                           // a route string has four bits a tier
  }
  let think = (raw(&mut x, 3) >> 5) & 3;
  let wait = raw(&mut x, 5) * 2;
  // The slot context says it is a hub, with how many ports.
  zero_page(&mut x.inp, 0, RAW_AT);
  let mut ttw = tt;
  if speed == 3 {
    ttw = tt | (think << 16);
  }
  ictx(&mut x, 0, 1, 1);
  ictx(&mut x, 1, 0, cast[u32](route | (speed << 20) | (1 << 26) | (1 << 27)));
  ictx(&mut x, 1, 1, cast[u32]((p << 16) | (n << 24)));
  ictx(&mut x, 1, 2, cast[u32](ttw));
  let ia = dma_phys(x.inp);
  if !xhci_command(&mut x, ia, cast[u32](TRB_CONFIGURE * 1024 + s * 16777216)) {
    return dev_detach(&mut x, s);
  }
  let mut k = 1;
  while k <= n
    invariant xhci_ok(x) && k >= 1
  {
    hub_feature(&mut x, s, k, HUB_POWER, true);
    k = k + 1;
  }
  xhci_delay(&mut x, wait + 100);     // power good, then connection debounce
  let had_kbd = x.live;
  let had_mouse = x.mlive;
  let had_msd = x.msd;
  let had_ser = x.sp.kind;
  k = 1;
  while k <= n && (!x.live || !x.mlive || x.msd == MSD_NONE || x.sp.kind == SER_NONE)
    invariant xhci_ok(x) && k >= 1 && n <= 15
  {
    if hub_status(&mut x, s, k) & 1 != 0 && hub_feature(&mut x, s, k, HUB_RESET, true) {
      let mut st = 0;
      let mut w = 0;
      while w < 50 && st & 0x100000 == 0
        invariant xhci_ok(x)
      {
        xhci_delay(&mut x, 10);
        st = hub_status(&mut x, s, k);
        w = w + 1;
      }
      hub_feature(&mut x, s, k, HUB_C_RESET, false);
      hub_feature(&mut x, s, k, HUB_C_CONNECTION, false);
      st = hub_status(&mut x, s, k);
      if st & 2 != 0 {
        xhci_delay(&mut x, 10);       // reset recovery
        let mut cs = 1;               // full speed
        if st & 0x200 != 0 {
          cs = 2;                     // low speed
        } else if st & 0x400 != 0 {
          cs = 3;                     // high speed
        }
        let mut cr = k;
        if depth == 1 {
          cr = route + k * 16;
        }
        // A low- or full-speed device below a high-speed hub goes through
        // that hub's transaction translator, on this port.
        let mut ctt = tt;
        if speed == 3 && cs <= 2 {
          ctt = s + k * 256;
        }
        dev_attach(&mut x, p, cr, ctt, cs, depth + 1);
      }
    }
    k = k + 1;
  }
  if x.live == had_kbd && x.mlive == had_mouse && x.msd == had_msd && x.sp.kind == had_ser {
    return dev_detach(&mut x, s);
  }
  return true;
}

/// Gives slot s back after a failed attach; returns false.
fn dev_detach(x: &mut Xhci, s: u64) -> bool
  requires xhci_ok(x)
  ensures xhci_ok(x) && !result
{
  if s >= 1 && s <= XHCI_SLOTS {
    xhci_command(&mut x, 0, cast[u32](TRB_DISABLE_SLOT * 1024 + s * 16777216));
    dma_write64(&mut x.dcbaa, s * 8, 0);
  }
  return false;
}

/// The interval of an interrupt endpoint at `speed` whose descriptor says
/// `ival`, as its endpoint context wants it: 2^n x 125 us.
fn ep_interval(speed: u64, ival: u64) -> u64
  requires ival <= 255
  ensures result < 16
{
  let mut interval = 3;
  if speed <= 2 {
    let mut ms = 1;                   // low and full speed: milliseconds
    while ms * 2 <= ival && interval < 10
      invariant interval <= 10 && ms <= 1024
    {
      ms = ms * 2;
      interval = interval + 1;
    }
  } else if ival >= 1 && ival <= 16 {
    interval = ival - 1;
  }
  return interval;
}

/// The input context of interrupt IN endpoint `dci`, its ring at `ring`.
fn int_ctx(x: &mut Xhci, dci: u64, interval: u64, mps: u64, ring: u64)
  requires xhci_ok(x) && 2 <= dci && dci < 32 && interval < 16 && mps < 2048 && ring < 0x2000000000000
  ensures xhci_ok(x)
{
  ictx(&mut x, dci + 1, 0, cast[u32](interval << 16));
  ictx(&mut x, dci + 1, 1, cast[u32](6 + 7 * 8 + (mps << 16)));   // 3 retries, interrupt IN
  ictx(&mut x, dci + 1, 2, cast[u32](ring & 0xFFFFFFFF) | 1);
  ictx(&mut x, dci + 1, 3, cast[u32](ring >> 32));
  ictx(&mut x, dci + 1, 4, cast[u32](8 + (mps << 16)));
}

/// The keyboard (interface kif, interrupt IN endpoint kep, kif 256 if
/// none) and the mouse (mif, mep) on slot s: the boot protocol and their
/// interrupt endpoints. Either is dropped if it refuses the boot protocol;
/// the slot, if both are.
fn hid_setup(x: &mut Xhci, s: u64, p: u64, route: u64, tt: u64, speed: u64, config: u64,
  kif: u64, kep: u64, kmps: u64, kival: u64, mif: u64, mep: u64, mmps: u64, mival: u64) -> bool
  requires xhci_ok(x) && 1 <= s && s <= XHCI_SLOTS && p < 256 && speed < 16 && route < 256 && tt < 65536
  requires config <= 255 && kif <= 256 && kep < 16 && kmps < 2048 && kival <= 255
  requires mif <= 256 && mep < 16 && mmps < 2048 && mival <= 255
  ensures xhci_ok(x)
{
  if !xhci_control(&mut x, s, (config << 16) | 0x0900, 0, false) {
    return dev_detach(&mut x, s);
  }
  // SET_PROTOCOL (boot), then SET_IDLE (report only changes; a device may
  // refuse it), on each interface.
  let mut kbd = false;
  if kif < 256 && kep != 0 && kmps != 0 {
    kbd = xhci_control(&mut x, s, (kif << 32) | 0x0B21, 0, false);
    if kbd {
      xhci_control(&mut x, s, (kif << 32) | 0x0A21, 0, false);
    }
  }
  let mut mouse = false;
  if mif < 256 && mep != 0 && mmps != 0 && (!kbd || mep != kep) {
    mouse = xhci_control(&mut x, s, (mif << 32) | 0x0B21, 0, false);
    if mouse {
      xhci_control(&mut x, s, (mif << 32) | 0x0A21, 0, false);
    }
  }
  if !kbd && !mouse {
    return dev_detach(&mut x, s);
  }
  // The interrupt endpoints: context index 2 * number + 1 (IN).
  let kdci = kep * 2 + 1;
  let mdci = mep * 2 + 1;
  zero_page(&mut x.inp, 0, RAW_AT);
  let mut add = 1;
  let mut top = 1;
  if kbd {
    zero_page(&mut x.intr, 0, 3072);
    x.int_at = 1;
    add = add | (1 << kdci);
    top = kdci;
    let ra = dma_phys(x.intr);
    int_ctx(&mut x, kdci, ep_interval(speed, kival), kmps, ra);
  }
  if mouse {
    zero_page(&mut x.ctx3, 3072, 4096);
    x.m_at = 1;
    add = add | (1 << mdci);
    if mdci > top {
      top = mdci;
    }
    let ma = dma_phys(x.ctx3);
    int_ctx(&mut x, mdci, ep_interval(speed, mival), mmps, ma + 3072);
  }
  ictx(&mut x, 0, 1, cast[u32](add));
  ictx(&mut x, 1, 0, cast[u32](route | (speed << 20) | (top << 27)));
  ictx(&mut x, 1, 1, cast[u32](p << 16));
  ictx(&mut x, 1, 2, cast[u32](tt));
  let ia = dma_phys(x.inp);
  if !xhci_command(&mut x, ia, cast[u32](TRB_CONFIGURE * 1024 + s * 16777216)) {
    return dev_detach(&mut x, s);
  }
  if kbd {
    x.slot = cast[u8](s);
    x.dci = kdci;
    x.port = cast[u8](p);
    x.live = true;
    kbd_queue(&mut x);
  }
  if mouse {
    x.mslot = cast[u8](s);
    x.mdci = mdci;
    x.mbtn = 0;
    x.mlive = true;
    mouse_queue(&mut x);
  }
  return true;
}

/// Queues a transfer for the next report.
fn kbd_queue(x: &mut Xhci)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let a = dma_phys(x.intr);
  x.int_at = trb_put(&mut x.intr, 0, x.int_at, a + 2048, 8, cast[u32](TRB_NORMAL * 1024 + 32 + 4));  // IOC, ISP
  xw(&mut x, x.db + cast[u64](x.slot) * 4, cast[u32](x.dci));
}

/// Queues a transfer for the mouse's next report.
fn mouse_queue(x: &mut Xhci)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let a = dma_phys(x.intr);
  x.m_at = trb_put(&mut x.ctx3, 3072, x.m_at, a + 3072, 8, cast[u32](TRB_NORMAL * 1024 + 32 + 4));  // IOC, ISP
  xw(&mut x, x.db + cast[u64](x.mslot) * 4, cast[u32](x.mdci));
}

/// The mass-storage device on slot s: its bulk endpoints, then the SCSI
/// device behind them (msd_start). The slot is kept even if no BastiOS
/// partition turns up, so another one is not looked for.
fn msd_setup(x: &mut Xhci, s: u64, p: u64, route: u64, tt: u64, speed: u64, config: u64, iface: u64, ein: u64,
  eout: u64, mpin: u64, mpout: u64) -> bool
  requires xhci_ok(x) && 1 <= s && s <= XHCI_SLOTS && p < 256 && speed < 16 && route < 256 && tt < 65536
  requires config <= 255 && iface < 256 && 1 <= ein && ein < 16 && 1 <= eout && eout < 16
  requires mpin < 2048 && mpout < 2048
  ensures xhci_ok(x)
{
  if !xhci_control(&mut x, s, (config << 16) | 0x0900, 0, false) {
    return dev_detach(&mut x, s);
  }
  let dout = eout * 2;
  let din = ein * 2 + 1;
  let mut top = dout;
  if din > top {
    top = din;
  }
  zero_page(&mut x.inp, 0, RAW_AT);
  zero_page(&mut x.bulk, 0, 4096);
  x.out_at = 1;
  x.in_at = 1;
  let ba = dma_phys(x.bulk);
  let ia = ba + IN_RING;
  ictx(&mut x, 0, 1, cast[u32](1 | (1 << dout) | (1 << din)));
  ictx(&mut x, 1, 0, cast[u32](route | (speed << 20) | (top << 27)));
  ictx(&mut x, 1, 1, cast[u32](p << 16));
  ictx(&mut x, 1, 2, cast[u32](tt));
  ictx(&mut x, dout + 1, 1, cast[u32](6 + 2 * 8 + (mpout << 16)));   // 3 retries, bulk OUT
  ictx(&mut x, dout + 1, 2, cast[u32](ba & 0xFFFFFFFF) | 1);
  ictx(&mut x, dout + 1, 3, cast[u32](ba >> 32));
  ictx(&mut x, dout + 1, 4, 3072);
  ictx(&mut x, din + 1, 1, cast[u32](6 + 6 * 8 + (mpin << 16)));     // 3 retries, bulk IN
  ictx(&mut x, din + 1, 2, cast[u32](ia & 0xFFFFFFFF) | 1);
  ictx(&mut x, din + 1, 3, cast[u32](ia >> 32));
  ictx(&mut x, din + 1, 4, 3072);
  let pa = dma_phys(x.inp);
  if !xhci_command(&mut x, pa, cast[u32](TRB_CONFIGURE * 1024 + s * 16777216)) {
    return dev_detach(&mut x, s);
  }
  x.ds = cast[u8](s);
  x.dout = dout;
  x.din = din;
  x.iface = cast[u8](iface);
  x.msd = MSD_UNUSED;
  if msd_start(&mut x) {
    x.msd = MSD_ON;
  }
  return true;
}

/// The serial port on slot s: its bulk endpoints (one packet at a time is
/// queued on the IN one), then, for an FTDI adapter, 115200 baud and DTR
/// and RTS up, or, for a CDC-ACM device (`cface` its control interface, 256
/// if none), DTR and RTS up. The line coding of a CDC device is left as it
/// is. A device whose packets are bigger than SER_RX_MAX is not used.
fn ser_setup(x: &mut Xhci, s: u64, p: u64, route: u64, tt: u64, speed: u64, config: u64, kind: u64, cface: u64,
  ein: u64, eout: u64, mpin: u64, mpout: u64) -> bool
  requires xhci_ok(x) && 1 <= s && s <= XHCI_SLOTS && p < 256 && speed < 16 && route < 256 && tt < 65536
  requires config <= 255 && kind <= SER_ACM && cface <= 256 && 1 <= ein && ein < 16 && 1 <= eout && eout < 16
  requires mpin < 2048 && mpout < 2048
  ensures xhci_ok(x)
{
  if mpin > SER_RX_MAX || !xhci_control(&mut x, s, (config << 16) | 0x0900, 0, false) {
    return dev_detach(&mut x, s);
  }
  let dout = eout * 2;
  let din = ein * 2 + 1;
  let mut top = dout;
  if din > top {
    top = din;
  }
  zero_page(&mut x.inp, 0, RAW_AT);
  zero_page(&mut x.ser, 0, 4096);
  x.sp.out_at = 1;
  x.sp.in_at = 1;
  let ba = dma_phys(x.ser);
  let ia = ba + SER_IN_RING;
  ictx(&mut x, 0, 1, cast[u32](1 | (1 << dout) | (1 << din)));
  ictx(&mut x, 1, 0, cast[u32](route | (speed << 20) | (top << 27)));
  ictx(&mut x, 1, 1, cast[u32](p << 16));
  ictx(&mut x, 1, 2, cast[u32](tt));
  ictx(&mut x, dout + 1, 1, cast[u32](6 + 2 * 8 + (mpout << 16)));   // 3 retries, bulk OUT
  ictx(&mut x, dout + 1, 2, cast[u32](ba & 0xFFFFFFFF) | 1);
  ictx(&mut x, dout + 1, 3, cast[u32](ba >> 32));
  ictx(&mut x, dout + 1, 4, 512);
  ictx(&mut x, din + 1, 1, cast[u32](6 + 6 * 8 + (mpin << 16)));     // 3 retries, bulk IN
  ictx(&mut x, din + 1, 2, cast[u32](ia & 0xFFFFFFFF) | 1);
  ictx(&mut x, din + 1, 3, cast[u32](ia >> 32));
  ictx(&mut x, din + 1, 4, 512);
  let pa = dma_phys(x.inp);
  if !xhci_command(&mut x, pa, cast[u32](TRB_CONFIGURE * 1024 + s * 16777216)) {
    return dev_detach(&mut x, s);
  }
  if kind == SER_FTDI {
    xhci_control(&mut x, s, 0x001A0340, 0, false);       // SET_BAUD_RATE: divisor 26 (3 MHz / 26 = 115200)
    xhci_control(&mut x, s, 0x03030140, 0, false);       // SET_MODEM_CTRL: DTR and RTS up
  } else if cface < 256 {
    xhci_control(&mut x, s, (cface << 32) | 0x00032221, 0, false);   // SET_CONTROL_LINE_STATE: DTR and RTS up
  }
  x.sp.slot = cast[u8](s);
  x.sp.in_dci = din;
  x.sp.out_dci = dout;
  x.sp.mps = mpin;
  x.sp.qn = 0;
  x.sp.wait = false;
  x.sp.tx_busy = false;
  x.sp.dead = false;
  x.sp.kind = kind;
  ser_in_queue(&mut x);
  return true;
}

/// Queues one packet's worth of transfer for the serial port's next bytes.
fn ser_in_queue(x: &mut Xhci)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let b = dma_phys(x.ser);
  x.sp.in_at = trb_put(&mut x.ser, SER_IN_RING, x.sp.in_at, b + SER_RX_BUF, cast[u32](x.sp.mps), cast[u32](TRB_NORMAL * 1024 + 32 + 4));  // IOC, ISP
  xw(&mut x, x.db + cast[u64](x.sp.slot) * 4, cast[u32](x.sp.in_dci));
}

/// A transfer on the serial port's IN endpoint ended with completion code
/// cc, `left` bytes short of the packet queued: the bytes received (past
/// the two status bytes that begin each packet of an FTDI adapter) join sq,
/// and the next transfer is queued if sq has room for a packet.
fn ser_rx(x: &mut Xhci, cc: u64, left: u64)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  if cc != CC_SUCCESS && cc != CC_SHORT {
    x.sp.dead = true;
    return;
  }
  let got = x.sp.mps - smaller(left, x.sp.mps);
  let mut i = 0;
  if x.sp.kind == SER_FTDI {
    i = 2;
  }
  while i < got && x.sp.qn < SQ_N && i < SER_RX_MAX
    invariant xhci_ok(x) && i <= SER_RX_MAX
  {
    bset(&mut x.sp.q, x.sp.qn, dma_read8(&mut x.ser, SER_RX_BUF + i));
    x.sp.qn = x.sp.qn + 1;
    i = i + 1;
  }
  if x.sp.qn + x.sp.mps <= SQ_N {
    ser_in_queue(&mut x);
  } else {
    x.sp.wait = true;
  }
}

/// Sends the first n bytes of src to the serial port, at most SER_TX_MAX,
/// if the last write has ended; returns how many were taken (0 if there is
/// no port or a write is still running, all of them if the port failed).
fn xhci_ser_send(x: &mut Xhci, src: &Bytes, n: u64) -> u64
  requires xhci_ok(x)
  ensures xhci_ok(x) && result <= n && result <= blen(src)
{
  let want = smaller(n, blen(src));
  if x.sp.kind == SER_NONE {
    return 0;
  }
  if x.sp.dead {
    return want;
  }
  if x.sp.tx_busy || want == 0 {
    return 0;
  }
  let m = smaller(want, SER_TX_MAX);
  let mut i = 0;
  while i < m
    invariant xhci_ok(x) && i <= m && m <= SER_TX_MAX && m <= blen(src)
  {
    dma_write8(&mut x.ser, SER_TX_BUF + i, bget(src, i));
    i = i + 1;
  }
  let b = dma_phys(x.ser);
  x.sp.out_at = trb_put(&mut x.ser, 0, x.sp.out_at, b + SER_TX_BUF, cast[u32](m), cast[u32](TRB_NORMAL * 1024 + 32));   // IOC
  xw(&mut x, x.db + cast[u64](x.sp.slot) * 4, cast[u32](x.sp.out_dci));
  x.sp.tx_busy = true;
  return m;
}

// ---------------------------------------------------------------- bulk-only transport

/// Byte i of the command block.
fn cb(x: &mut Xhci, i: u64, v: u8)
  requires xhci_ok(x) && i < 16
  ensures xhci_ok(x)
{
  dma_write8(&mut x.bulk, CBW_AT + 15 + i, v);
}

/// Writes SCSI command `op` into the command block: the six-byte form for
/// the three commands that have only that (with `n` as the allocation
/// length), else the ten-byte form with sector `lba` and `count` sectors.
/// Returns the block's length.
fn cdb(x: &mut Xhci, op: u8, lba: u32, count: u16, n: u64) -> u64
  requires xhci_ok(x)
  requires (op == SCSI_TEST_READY || op == SCSI_SENSE || op == SCSI_INQUIRY) ==> n <= 255
  ensures xhci_ok(x) && result <= 16
{
  let mut i = 0;
  while i < 16
    invariant xhci_ok(x)
  {
    cb(&mut x, i, 0);
    i = i + 1;
  }
  cb(&mut x, 0, op);
  if op == SCSI_TEST_READY || op == SCSI_SENSE || op == SCSI_INQUIRY {
    cb(&mut x, 4, cast[u8](n));
    return 6;
  }
  cb(&mut x, 2, cast[u8](lba >> 24));
  cb(&mut x, 3, cast[u8]((lba >> 16) & 255));
  cb(&mut x, 4, cast[u8]((lba >> 8) & 255));
  cb(&mut x, 5, cast[u8](lba & 255));
  cb(&mut x, 7, cast[u8](count >> 8));
  cb(&mut x, 8, cast[u8](count & 255));
  return 10;
}

/// Starts the command in the command block (`len` bytes): the wrapper on
/// the OUT ring, `n` bytes of the data page in (`dir_in`) or out, and the
/// status wrapper on the IN ring, which alone raises an event.
fn bot_go(x: &mut Xhci, len: u64, n: u64, dir_in: bool)
  requires xhci_ok(x) && len <= 16 && n <= 4096
  ensures xhci_ok(x) && x.busy
{
  x.tag = wrap_add(x.tag, 1);
  dma_write32(&mut x.bulk, CBW_AT, cast[u32](CBW_SIG));
  dma_write32(&mut x.bulk, CBW_AT + 4, x.tag);
  dma_write32(&mut x.bulk, CBW_AT + 8, cast[u32](n));
  if dir_in {
    dma_write8(&mut x.bulk, CBW_AT + 12, 0x80);
  } else {
    dma_write8(&mut x.bulk, CBW_AT + 12, 0);
  }
  dma_write8(&mut x.bulk, CBW_AT + 13, 0);             // LUN 0
  dma_write8(&mut x.bulk, CBW_AT + 14, cast[u8](len));
  dma_write32(&mut x.bulk, CSW_AT, 0);
  let b = dma_phys(x.bulk);
  let d = dma_phys(x.data);
  x.out_at = trb_put(&mut x.bulk, 0, x.out_at, b + CBW_AT, 31, cast[u32](TRB_NORMAL * 1024));
  if n > 0 && !dir_in {
    x.out_at = trb_put(&mut x.bulk, 0, x.out_at, d, cast[u32](n), cast[u32](TRB_NORMAL * 1024));
  }
  // Data coming in raises an event (IOC, and ISP for a short one), and
  // only then is the status wrapper asked for: a device may not take the
  // request for it while it is still sending the data (QEMU's does not).
  x.stage = 0;
  if n > 0 && dir_in {
    x.in_at = trb_put(&mut x.bulk, IN_RING, x.in_at, d, cast[u32](n), cast[u32](TRB_NORMAL * 1024 + 32 + 4));
    x.stage = 1;
  } else {
    x.in_at = trb_put(&mut x.bulk, IN_RING, x.in_at, b + CSW_AT, 13, cast[u32](TRB_NORMAL * 1024 + 32));   // IOC
  }
  x.busy = true;
  x.done = false;
  x.dcc = 0;
  xw(&mut x, x.db + cast[u64](x.ds) * 4, cast[u32](x.dout));
  xw(&mut x, x.db + cast[u64](x.ds) * 4, cast[u32](x.din));
}

/// Asks for the status wrapper, once the data has come in.
fn csw_queue(x: &mut Xhci)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let b = dma_phys(x.bulk);
  x.in_at = trb_put(&mut x.bulk, IN_RING, x.in_at, b + CSW_AT, 13, cast[u32](TRB_NORMAL * 1024 + 32));   // IOC
  xw(&mut x, x.db + cast[u64](x.ds) * 4, cast[u32](x.din));
}

/// After the controller said the command ended: its SCSI status (0 good,
/// 1 check condition), or 2 if the transfer failed or the status wrapper
/// is not this command's, in which case the device is reset.
fn bot_end(x: &mut Xhci) -> u64
  requires xhci_ok(x)
  ensures xhci_ok(x) && !x.busy && result <= 2
{
  x.busy = false;
  if x.dcc != CC_SUCCESS && x.dcc != CC_SHORT {
    bot_recover(&mut x);
    return 2;
  }
  let sig = cast[u64](dma_read32(&mut x.bulk, CSW_AT));
  let tag = dma_read32(&mut x.bulk, CSW_AT + 4);
  let st = cast[u64](dma_read8(&mut x.bulk, CSW_AT + 12));
  if sig != CSW_SIG || tag != x.tag {
    bot_recover(&mut x);
    return 2;
  }
  if st <= 1 {
    return st;
  }
  bot_recover(&mut x);                // a phase error
  return 2;
}

/// Waits for the started command to end; as bot_end.
fn bot_wait(x: &mut Xhci) -> u64
  requires xhci_ok(x)
  ensures xhci_ok(x) && !x.busy && result <= 2
{
  let mut n = 0;
  while n < XHCI_SPINS && !x.done
    invariant xhci_ok(x)
  {
    evt_step(&mut x);
    n = n + 1;
  }
  if !x.done {
    x.busy = false;
    bot_recover(&mut x);
    return 2;
  }
  return bot_end(&mut x);
}

/// Puts the disk's endpoint `e` (ring at `base`, enqueue position `at`)
/// back in order after an error: reset if it halted, stopped if it runs,
/// and its dequeue pointer moved past whatever was still queued.
fn ep_recover(x: &mut Xhci, e: u64, base: u64, at: u64)
  requires xhci_ok(x) && e < 32 && base + RING_N * 16 <= 4096 && at < RING_N * 2
  ensures xhci_ok(x)
{
  let c = cast[u64](x.ds) * 16777216 + e * 65536;
  xhci_command(&mut x, 0, cast[u32](TRB_RESET_EP * 1024 + c));
  xhci_command(&mut x, 0, cast[u32](TRB_STOP_EP * 1024 + c));
  let b = dma_phys(x.bulk);
  xhci_command(&mut x, b + base + at / 2 * 16 + at % 2, cast[u32](TRB_SET_DEQ * 1024 + c));
}

/// Reset recovery, as the bulk-only transport specifies it: both
/// endpoints put back in order, a mass-storage reset, and both endpoints'
/// halts cleared.
fn bot_recover(x: &mut Xhci)
  requires xhci_ok(x)
  ensures xhci_ok(x) && !x.busy
{
  x.busy = false;
  x.done = false;
  if x.ds < 1 || x.ds > XHCI_SLOTS {
    return;
  }
  let s = cast[u64](x.ds);
  ep_recover(&mut x, x.dout, 0, x.out_at);
  ep_recover(&mut x, x.din, IN_RING, x.in_at);
  xhci_control(&mut x, s, (cast[u64](x.iface) << 32) | 0xFF21, 0, false);
  xhci_control(&mut x, s, ((x.dout / 2) << 32) | 0x0102, 0, false);
  xhci_control(&mut x, s, ((x.din / 2 + 128) << 32) | 0x0102, 0, false);
}

/// Runs SCSI command `op` (see cdb) with `n` bytes of the data page in or
/// out, and returns its status as bot_end.
fn scsi(x: &mut Xhci, op: u8, lba: u32, count: u16, n: u64, dir_in: bool) -> u64
  requires xhci_ok(x) && n <= 4096
  requires (op == SCSI_TEST_READY || op == SCSI_SENSE || op == SCSI_INQUIRY) ==> n <= 255
  ensures xhci_ok(x) && !x.busy && result <= 2
{
  let len = cdb(&mut x, op, lba, count, n);
  bot_go(&mut x, len, n, dir_in);
  return bot_wait(&mut x);
}

/// The big-endian u32 at byte o of the data page.
fn data_be32(x: &mut Xhci, o: u64) -> u64
  requires xhci_ok(x) && o + 4 <= 4096
  ensures xhci_ok(x) && result <= 4294967295
{
  let a = cast[u64](dma_read8(&mut x.data, o));
  let b = cast[u64](dma_read8(&mut x.data, o + 1));
  let c = cast[u64](dma_read8(&mut x.data, o + 2));
  let d = cast[u64](dma_read8(&mut x.data, o + 3));
  return a * 16777216 + b * 65536 + c * 256 + d;
}

/// Brings up the SCSI disk behind the bulk endpoints and finds its BastiOS
/// partition; true if there is one (plo and sectors say where).
fn msd_start(x: &mut Xhci) -> bool
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  if scsi(&mut x, SCSI_INQUIRY, 0, 0, 36, true) == 2 {
    return false;
  }
  if cast[u64](dma_read8(&mut x.data, 0)) & 31 != 0 {
    return false;                     // not a direct-access block device
  }
  // A device may say it is not ready (a medium change, say) a few times
  // first; the sense data it then has must be fetched.
  let mut ready = false;
  let mut k = 0;
  while k < 20 && !ready
    invariant xhci_ok(x)
  {
    let st = scsi(&mut x, SCSI_TEST_READY, 0, 0, 0, false);
    if st == 0 {
      ready = true;
    } else {
      scsi(&mut x, SCSI_SENSE, 0, 0, 18, true);
      let mut w = 0;
      while w < 1000000 {
        w = w + 1;
      }
    }
    k = k + 1;
  }
  if !ready || scsi(&mut x, SCSI_CAPACITY, 0, 0, 8, true) != 0 {
    return false;
  }
  let last = data_be32(&mut x, 0);
  if data_be32(&mut x, 4) != USB_SECTOR || last < 34 {
    return false;
  }
  // The GPT: its header in sector 1, then its entries, 128 bytes each,
  // read 32 at a time.
  if scsi(&mut x, SCSI_READ, 1, 1, USB_SECTOR, true) != 0 || dma_read64(&mut x.data, 0) != GPT_SIG {
    return false;
  }
  let elba = dma_read64(&mut x.data, 72);
  let count = cast[u64](dma_read32(&mut x.data, 80));
  let esz = cast[u64](dma_read32(&mut x.data, 84));
  if esz != 128 || elba < 2 || elba > last {
    return false;
  }
  let mut i = 0;
  while i < count && i < 1024
    invariant xhci_ok(x) && last <= 4294967295 && elba <= last
  {
    let sec = elba + i / 4;
    if sec + 8 > last + 1 || scsi(&mut x, SCSI_READ, cast[u32](sec), 8, 4096, true) != 0 {
      return false;
    }
    let mut j = 0;
    while j < 32
      invariant xhci_ok(x) && last <= 4294967295
    {
      let o = j * 128;
      if i + j < count && dma_read64(&mut x.data, o) == BASTIOS_PART_LO && dma_read64(&mut x.data, o + 8) == BASTIOS_PART_HI {
        let first = dma_read64(&mut x.data, o + 32);
        let end = dma_read64(&mut x.data, o + 40);
        if first < 1 || first > end || end > last {
          return false;
        }
        x.plo = first;
        x.sectors = end - first + 1;
        return true;
      }
      j = j + 1;
    }
    i = i + 32;
  }
  return false;
}

// ---------------------------------------------------------------- the disk, for blk.bastio

/// Reads sector `lba` of the partition into buf[0..512]; false if the
/// disk fails, a command is running, or the sector is past the end.
fn usbd_read(x: &mut Xhci, lba: u64, buf: &mut Bytes) -> bool
  requires xhci_ok(x) && blen(buf) >= USB_SECTOR
  ensures xhci_ok(x) && blen(buf) == old(blen(buf))
{
  if x.msd != MSD_ON || x.busy || lba >= x.sectors || x.plo + lba > 4294967295 {
    return false;
  }
  if scsi(&mut x, SCSI_READ, cast[u32](x.plo + lba), 1, USB_SECTOR, true) != 0 {
    return false;
  }
  dma_to_bytes(&mut buf, 0, &mut x.data, 0, USB_SECTOR);
  return true;
}

/// Writes buf[0..512] to sector `lba` of the partition.
fn usbd_write(x: &mut Xhci, lba: u64, buf: &Bytes) -> bool
  requires xhci_ok(x) && blen(buf) >= USB_SECTOR
  ensures xhci_ok(x)
{
  if x.msd != MSD_ON || x.busy || lba >= x.sectors || x.plo + lba > 4294967295 {
    return false;
  }
  bytes_to_dma(&mut x.data, 0, buf, 0, USB_SECTOR);
  return scsi(&mut x, SCSI_WRITE, cast[u32](x.plo + lba), 1, USB_SECTOR, false) == 0;
}

/// Is the 4 KiB block at `lba` (a multiple of 8) whole in the partition?
fn usbd_fits(x: &Xhci, lba: u64) -> bool
  requires xhci_ok(x)
  ensures result ==> lba < x.sectors && x.plo + lba + 8 <= 4294967296
{
  return x.msd == MSD_ON && lba % 8 == 0 && lba < x.sectors && x.sectors - lba >= 8 && x.plo + lba + 8 <= 4294967296;
}

/// SYNCHRONIZE CACHE. Many sticks do not know the command and answer with
/// a check condition: they are taken to write through.
fn usbd_sync(x: &mut Xhci) -> bool
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  return scsi(&mut x, SCSI_SYNC, 0, 0, 0, false) != 2;
}

fn usbd_read_block(x: &mut Xhci, lba: u64, out: &mut Bytes, at: u64) -> bool
  requires xhci_ok(x) && at + 4096 <= blen(out)
  ensures xhci_ok(x) && blen(out) == old(blen(out))
{
  if x.busy || !usbd_fits(x, lba) {
    return false;
  }
  if scsi(&mut x, SCSI_READ, cast[u32](x.plo + lba), 8, 4096, true) != 0 {
    return false;
  }
  dma_to_bytes(&mut out, at, &mut x.data, 0, 4096);
  return true;
}

fn usbd_write_block(x: &mut Xhci, lba: u64, src: &Bytes, at: u64) -> bool
  requires xhci_ok(x) && at + 4096 <= blen(src)
  ensures xhci_ok(x)
{
  if x.busy || !usbd_fits(x, lba) {
    return false;
  }
  bytes_to_dma(&mut x.data, 0, src, at, 4096);
  return scsi(&mut x, SCSI_WRITE, cast[u32](x.plo + lba), 8, 4096, false) == 0 && usbd_sync(&mut x);
}

/// Starts BIO_READ, BIO_WRITE (from src[at .. at + 4096]) or BIO_FLUSH, as
/// blk_begin; it ends in usbd_poll.
fn usbd_begin(x: &mut Xhci, op: u64, lba: u64, src: &Bytes, at: u64) -> bool
  requires xhci_ok(x) && op <= BIO_FLUSH && at + 4096 <= blen(src)
  ensures xhci_ok(x)
{
  if x.msd != MSD_ON || x.busy {
    return false;
  }
  x.bop = op;
  if op == BIO_FLUSH {
    let len = cdb(&mut x, SCSI_SYNC, 0, 0, 0);
    bot_go(&mut x, len, 0, false);
    return true;
  }
  if !usbd_fits(x, lba) {
    return false;
  }
  if op == BIO_WRITE {
    bytes_to_dma(&mut x.data, 0, src, at, 4096);
    let len = cdb(&mut x, SCSI_WRITE, cast[u32](x.plo + lba), 8, 0);
    bot_go(&mut x, len, 4096, false);
  } else {
    let len = cdb(&mut x, SCSI_READ, cast[u32](x.plo + lba), 8, 0);
    bot_go(&mut x, len, 4096, true);
  }
  return true;
}

/// BIO_RUNNING while the started command runs, then once BIO_OK or
/// BIO_FAILED; BIO_IDLE if none was started.
fn usbd_poll(x: &mut Xhci) -> u64
  requires xhci_ok(x)
  ensures xhci_ok(x) && result <= BIO_IDLE
{
  if !x.busy {
    return BIO_IDLE;
  }
  let mut n = 0;
  while n < 16 && !x.done
    invariant xhci_ok(x)
  {
    if evt_step(&mut x) == 0 {
      n = 16;
    }
    n = n + 1;
  }
  if !x.done {
    return BIO_RUNNING;
  }
  let st = bot_end(&mut x);
  if st == 0 || (st == 1 && x.bop == BIO_FLUSH) {
    return BIO_OK;
  }
  return BIO_FAILED;
}

/// After usbd_poll said BIO_OK for a read: the block, into out[at ..].
fn usbd_fetch(x: &mut Xhci, out: &mut Bytes, at: u64)
  requires xhci_ok(x) && at + 4096 <= blen(out)
  ensures xhci_ok(x) && blen(out) == old(blen(out))
{
  dma_to_bytes(&mut out, at, &mut x.data, 0, 4096);
}

/// Points MSI-X table entry 0, at `table` in the registers, at `addr` with
/// vector `data`, and has interrupter 0 raise it for every event (no
/// moderation). True if it is on.
fn xhci_msix(x: &mut Xhci, table: u64, addr: u64, data: u64) -> bool
  requires xhci_ok(x) && addr <= 4294967295 && data <= 4294967295
  ensures xhci_ok(x)
{
  if table % 16 != 0 || table >= mmio_len(x.regs) || mmio_len(x.regs) - table < 16 {
    return false;
  }
  xw(&mut x, table, cast[u32](addr));
  xw(&mut x, table + 4, 0);
  xw(&mut x, table + 8, cast[u32](data));
  xw(&mut x, table + 12, 0);           // unmasked
  xw(&mut x, x.rt + IMOD, 0);
  xw(&mut x, x.rt + IMAN, 3);          // enabled; a pending flag cleared
  let c = xr(&mut x, x.op + USBCMD);
  xw(&mut x, x.op + USBCMD, c | CMD_INTE);
  x.irq = true;
  return true;
}

/// Stops the controller and resets it, so it no longer touches the pages.
fn xhci_halt(x: &mut Xhci) -> bool
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let c = xr(&mut x, x.op + USBCMD);
  xw(&mut x, x.op + USBCMD, c & 0xFFFFFFFE);
  let mut n = 0;
  while n < XHCI_SPINS && xr(&mut x, x.op + USBSTS) & STS_HALTED == 0
    invariant xhci_ok(x)
  {
    n = n + 1;
  }
  xw(&mut x, x.op + USBCMD, CMD_RESET);
  let mut k = 0;
  while k < XHCI_SPINS
    invariant xhci_ok(x)
  {
    if xr(&mut x, x.op + USBCMD) & CMD_RESET == 0 && xr(&mut x, x.op + USBSTS) & STS_NOT_READY == 0 {
      return true;
    }
    k = k + 1;
  }
  return false;
}

/// Takes the firmware's hold on the controller away (USB legacy support:
/// the firmware may be emulating a PS/2 keyboard with it).
fn xhci_handoff(x: &mut Xhci, xecp: u64)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let mut o = xecp;
  let mut n = 0;
  while n < 64 && o >= 0x20 && o <= XHCI_MAX_LEN && o % 4 == 0 && o + 8 <= mmio_len(x.regs)
    invariant xhci_ok(x)
  {
    let v = xr(&mut x, o);
    if v & 255 == 1 {
      xw(&mut x, o, v | 0x1000000);  // OS owned
      let mut k = 0;
      while k < XHCI_SPINS && xr(&mut x, o) & 0x10000 != 0
        invariant xhci_ok(x) && o % 4 == 0 && o + 8 <= mmio_len(x.regs)
      {
        k = k + 1;
      }
      // No more SMIs from it; clear the ones it raised.
      let ctl = xr(&mut x, o + 4);
      xw(&mut x, o + 4, (ctl & 0x1FFF1FEE) | 0xE0000000);
      return;
    }
    let next = cast[u64]((v >> 8) & 255);
    if next == 0 {
      return;
    }
    o = o + next * 4;
    n = n + 1;
  }
}

/// Takes n scratchpad pages from m into x.sps and writes their addresses
/// into the scratchpad array. Without 64-bit addressing (`ac64`) each page
/// must lie below 4 GiB. False if the pool has too few such pages (the
/// ones taken stay in x.sps, to go back with the rest).
fn sp_take(x: &mut Xhci, m: &mut Mem, n: u64, ac64: bool) -> bool
  requires xhci_ok(x) && mem_ok(m) && n <= XHCI_SP_MAX && vlen(x.sps) == 0
  ensures xhci_ok(x) && mem_ok(m)
{
  let mut i = 0;
  while i < n
    invariant xhci_ok(x) && mem_ok(m) && i <= n && n <= XHCI_SP_MAX && vlen(x.sps) == i
  {
    let f = find_free(&mut m);
    if f == NPAGES {
      return false;
    }
    let d = dma_lend(take_page(&mut m, f));
    let a = dma_phys(d);
    vec_push(&mut x.sps, d);
    if a == 0 || (!ac64 && a >= 4294967296) {
      return false;
    }
    dma_write64(&mut x.dcbaa, 2048 + i * 8, a);
    i = i + 1;
  }
  return true;
}

/// Powers every root port (with port power control they may start off;
/// writing it on changes nothing otherwise), then waits for devices to
/// show up: USB 2 ones connect within some 100 ms of power and are
/// debounced, USB 3 ones train their links first. The wait ends once the
/// connected ports have stayed the same for 200 ms, after at least 300 ms,
/// or after XHCI_SETTLE_MS. QEMU's devices are there at once; a real
/// controller's are not, after the reset at start.
fn ports_settle(x: &mut Xhci)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let mut p = 1;
  while p <= x.ports && p <= 256
    invariant xhci_ok(x) && p >= 1
  {
    let o = x.op + PORTSC + (p - 1) * 16;
    let sc = xr(&mut x, o);
    if sc & PORT_POWER == 0 {
      xw(&mut x, o, (sc & PORT_KEEP) | PORT_POWER);
    }
    p = p + 1;
  }
  let mut last = 0;
  let mut same = 0;
  let mut t = 0;
  while t < XHCI_SETTLE_MS && (t < 300 || same < 200)
    invariant xhci_ok(x) && t <= XHCI_SETTLE_MS + 50 && same <= t
  {
    xhci_delay(&mut x, 50);
    t = t + 50;
    let mut now = 0;
    let mut q = 1;
    while q <= x.ports && q <= 256
      invariant xhci_ok(x) && q >= 1 && q <= 257 && now <= q * 256
    {
      if xr(&mut x, x.op + PORTSC + (q - 1) * 16) & PORT_CONNECTED != 0 {
        now = now + q;
      }
      q = q + 1;
    }
    if now == last {
      same = same + 50;
    } else {
      same = 0;
      last = now;
    }
  }
}

/// Starts the controller in the registers `regs` with eleven pages (and
/// the scratchpad pages it asks for, from m), and attaches the first boot
/// keyboard, boot mouse and mass-storage device on its root ports and the
/// hubs below them. `live` says whether there is a keyboard, `mlive` a
/// mouse and `msd` a disk; with none, the controller is left reset.
fn xhci_new(regs: Mmio, m: &mut Mem, f0: Frame, f1: Frame, f2: Frame, f3: Frame, f4: Frame, f5: Frame, f6: Frame,
  f7: Frame, f8: Frame, f9: Frame, f10: Frame, f11: Frame, f12: Frame) -> Xhci
  requires mmio_base(regs) % 4096 == 0 && mmio_len(regs) <= XHCI_MAX_LEN && mmio_len(regs) >= 0x2000
  requires mem_ok(m)
  ensures xhci_ok(result) && mem_ok(m)
  ensures mmio_base(result.regs) == mmio_base(regs) && mmio_len(result.regs) == mmio_len(regs)
{
  let mut x = Xhci { regs: regs, dcbaa: dma_lend(f0), cmd: dma_lend(f1), evt: dma_lend(f2), ctx: dma_lend(f3),
    inp: dma_lend(f4), ep0: dma_lend(f5), intr: dma_lend(f6),
    bulk: dma_lend(f7), data: dma_lend(f8), ctx2: dma_lend(f9), ctx3: dma_lend(f10), ctx4: dma_lend(f11), ser: dma_lend(f12), sps: vec_new[Dma](), op: 0, rt: 0, db: 0,
    csz: 32, ports: 0, cmd_at: 1, evt_at: 1, e0a: 1, e0b: 1, e0c: 1, e0d: 1, e0e: 1, int_at: 1, ev_p: 0, ev_s: 0, ev_c: 0, slot: 0,
    dci: 0, port: 0, keys: balloc(6), q: balloc(16), qn: 0, shift: false, ctrl: false, live: false,
    mslot: 0, mdci: 0, m_at: 1, mq: balloc(MQ_N * 4), mqn: 0, mbtn: 0, mlive: false,
    msd: MSD_NONE, ds: 0, dout: 0, din: 0, iface: 0, out_at: 1, in_at: 1, tag: 0, plo: 0, sectors: 0,
    busy: false, stage: 0, done: false, dcc: 0, bop: 0, irq: false,
    sp: SerPort { kind: SER_NONE, slot: 0, in_dci: 0, out_dci: 0, in_at: 1, out_at: 1, e0: 1, mps: 0, q: balloc(SQ_N), qn: 0,
      wait: false, tx_busy: false, dead: false } };
  let cap = cast[u64](xr(&mut x, 0) & 255);
  let hcs1 = cast[u64](xr(&mut x, 4));
  let hcs2 = cast[u64](xr(&mut x, 8));
  let hcc1 = cast[u64](xr(&mut x, 0x10));
  let dboff = cast[u64](xr(&mut x, 0x14));
  let rtoff = cast[u64](xr(&mut x, 0x18));
  let db = dboff - dboff % 4;
  let rt = rtoff - rtoff % 32;
  let size = mmio_len(x.regs);
  if cap % 8 != 0 || cap + PORTSC + 4096 > size || rt + 64 > size || db + 1024 > size {
    return x;
  }
  x.op = cap;
  x.rt = rt;
  x.db = db;
  if hcc1 & 4 != 0 {
    x.csz = 64;
  }
  x.ports = hcs1 >> 24;
  let spads = ((hcs2 >> 21) & 31) * 32 + (hcs2 >> 27);
  xhci_handoff(&mut x, (hcc1 >> 16) * 4);
  if spads > XHCI_SP_MAX || xr(&mut x, x.op + PAGESIZE) & 1 == 0 || !xhci_halt(&mut x) {
    return x;
  }
  // The structures the controller reads: the device slots, the scratchpad
  // array and its pages, the command ring and the event ring.
  zero_page(&mut x.dcbaa, 0, 4096);
  zero_page(&mut x.cmd, 0, 4096);
  zero_page(&mut x.evt, 0, 4096);
  if !sp_take(&mut x, &mut m, spads, hcc1 % 2 == 1) {
    return x;
  }
  let da = dma_phys(x.dcbaa);
  if spads > 0 {
    dma_write64(&mut x.dcbaa, 0, da + 2048);
  }
  let ea = dma_phys(x.evt);
  dma_write64(&mut x.evt, 0, ea + 64);
  dma_write32(&mut x.evt, 8, cast[u32](EVT_N));
  let cra = dma_phys(x.cmd);
  xw(&mut x, x.op + CONFIG, cast[u32](XHCI_SLOTS));
  xw64(&mut x, x.op + DCBAAP, da);
  xw64(&mut x, x.op + CRCR, cra | 1);
  xw(&mut x, x.rt + ERSTSZ, 1);
  xw64(&mut x, x.rt + ERDP, ea + 64);
  xw64(&mut x, x.rt + ERSTBA, ea);
  xw(&mut x, x.rt + IMAN, 0);
  xw(&mut x, x.op + USBCMD, CMD_RUN);
  let mut n = 0;
  while n < XHCI_SPINS && xr(&mut x, x.op + USBSTS) & STS_HALTED != 0
    invariant xhci_ok(x)
  {
    n = n + 1;
  }
  ports_settle(&mut x);
  // The first boot keyboard, boot mouse and mass-storage device on a root
  // port, or on a hub.
  let mut p = 1;
  while p <= x.ports && p < 256 && (!x.live || !x.mlive || x.msd == MSD_NONE || x.sp.kind == SER_NONE)
    invariant xhci_ok(x) && p >= 1
  {
    let speed = port_up(&mut x, p);
    if speed != 0 {
      dev_attach(&mut x, p, 0, 0, speed, 0);
    }
    p = p + 1;
  }
  if !x.live && !x.mlive && x.msd != MSD_ON && x.sp.kind == SER_NONE {
    xhci_halt(&mut x);
  }
  return x;
}

/// Stops the controller and takes its pages back (at power off). The
/// registers go back to the caller.
fn xhci_free(x: Xhci, m: &mut Mem) -> Mmio
  requires xhci_ok(x) && mem_ok(m)
  ensures mem_ok(m)
  ensures mmio_base(result) == mmio_base(x.regs) && mmio_len(result) == mmio_len(x.regs)
{
  let mut d = x;
  xhci_halt(&mut d);
  give_page(&mut m, dma_take(d.dcbaa));
  give_page(&mut m, dma_take(d.cmd));
  give_page(&mut m, dma_take(d.evt));
  give_page(&mut m, dma_take(d.ctx));
  give_page(&mut m, dma_take(d.ctx2));
  give_page(&mut m, dma_take(d.inp));
  give_page(&mut m, dma_take(d.ep0));
  give_page(&mut m, dma_take(d.intr));
  while vec_len(d.sps) > 0
    invariant mem_ok(m)
  {
    give_page(&mut m, dma_take(vec_pop(&mut d.sps)));
  }
  vec_free(d.sps);
  give_page(&mut m, dma_take(d.bulk));
  give_page(&mut m, dma_take(d.data));
  give_page(&mut m, dma_take(d.ctx3));
  give_page(&mut m, dma_take(d.ctx4));
  give_page(&mut m, dma_take(d.ser));
  bfree(d.sp.q);
  bfree(d.keys);
  bfree(d.q);
  bfree(d.mq);
  return d.regs;
}

// HID usages 0x04-0x38 to characters (0: none).
fn usage_map() -> Str {
  return "abcdefghijklmnopqrstuvwxyz1234567890\r\0\0\t -=[]\\\0;'`,./";
}

fn usage_map_shift() -> Str {
  return "ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()\r\0\0\t _+{}|\0:\"~<>?";
}

/// The byte key usage `k` types, with the modifiers held, or 256.
fn usage_byte(x: &Xhci, k: u64) -> u64
  ensures result <= 256
{
  if k == 0x29 {
    return 27;                        // Esc
  }
  if k == 0x2A {
    return 127;                       // Backspace, as DEL
  }
  if k == 0x58 {
    return 13;                        // keypad Enter
  }
  let m = usage_map();
  let ms = usage_map_shift();
  if k < 4 || k - 4 >= slen(m) || k - 4 >= slen(ms) {
    return 256;
  }
  let mut c = cast[u64](sget(m, k - 4));
  if x.shift {
    c = cast[u64](sget(ms, k - 4));
  }
  if x.ctrl && c >= 97 && c <= 122 {
    c = c - 96;                       // Ctrl-A is 1
  }
  if c == 0 {
    return 256;
  }
  return c;
}

/// Reads a finished report: keys down now that were not before are typed.
fn kbd_report(x: &mut Xhci)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let mods = cast[u64](dma_read8(&mut x.intr, 2048));
  x.ctrl = mods & 0x11 != 0;
  x.shift = mods & 0x22 != 0;
  let mut i = 0;
  while i < 6
    invariant i <= 6 && xhci_ok(x)
  {
    let k = cast[u64](dma_read8(&mut x.intr, 2050 + i));
    let mut was = false;
    let mut j = 0;
    while j < 6
      invariant j <= 6 && xhci_ok(x)
    {
      if cast[u64](bget(x.keys, j)) == k {
        was = true;
      }
      j = j + 1;
    }
    let b = usage_byte(x, k);
    if k >= 4 && !was && b < 256 && x.qn < 16 {
      bset(&mut x.q, x.qn, cast[u8](b));
      x.qn = x.qn + 1;
    }
    i = i + 1;
  }
  let mut j = 0;
  while j < 6
    invariant j <= 6 && xhci_ok(x)
  {
    bset(&mut x.keys, j, dma_read8(&mut x.intr, 2050 + j));
    j = j + 1;
  }
}

/// Reads a finished mouse report of n bytes: the buttons (bit 0 left, 1
/// right, 2 middle), the motion in x and y (signed bytes, down positive)
/// and, if there is a fourth byte, the wheel (up positive) become a PS/2
/// packet (y up positive) with an ImPS/2 wheel byte (up negative), queued
/// unless nothing changed.
fn mouse_report(x: &mut Xhci, n: u64)
  requires xhci_ok(x)
  ensures xhci_ok(x)
{
  let b = cast[u64](dma_read8(&mut x.intr, 3072)) % 8;
  let dx = cast[u64](dma_read8(&mut x.intr, 3073));
  let dy = cast[u64](dma_read8(&mut x.intr, 3074));
  let mut dz = 0;
  if n >= 4 {
    dz = cast[u64](dma_read8(&mut x.intr, 3075));
  }
  if (dx == 0 && dy == 0 && dz == 0 && b == x.mbtn) || x.mqn >= MQ_N {
    return;
  }
  x.mbtn = b;
  let mut b0 = b + 8;
  if dx >= 128 {
    b0 = b0 + 16;                     // x negative
  }
  if dy >= 1 && dy <= 127 {
    b0 = b0 + 32;                     // down, so y negative
  }
  let at = x.mqn * 4;
  bset(&mut x.mq, at, cast[u8](b0));
  bset(&mut x.mq, at + 1, cast[u8](dx));
  bset(&mut x.mq, at + 2, cast[u8]((256 - dy) % 256));
  bset(&mut x.mq, at + 3, cast[u8]((256 - dz) % 256));
  x.mqn = x.mqn + 1;
}

/// The next byte typed on the keyboard, a mouse packet (MOUSE_PKT plus
/// its bytes, as kbd_poll gives), or 256 if there is neither.
fn xhci_poll(x: &mut Xhci) -> u64
  requires xhci_ok(x)
  ensures xhci_ok(x) && (result <= 256 || (result >= MOUSE_PKT && result < 2 * MOUSE_PKT) || (result >= SER_PKT && result < SER_PKT + 256))
{
  if !x.live && !x.mlive && x.sp.kind == SER_NONE {
    return 256;
  }
  let mut n = 0;
  while x.qn == 0 && x.mqn == 0 && x.sp.qn == 0 && n < 8 && evt_step(&mut x) != 0
    invariant xhci_ok(x)
  {
    n = n + 1;
  }
  if x.qn == 0 && x.mqn > 0 {
    let p = MOUSE_PKT + cast[u64](bget(x.mq, 0)) * 16777216 + cast[u64](bget(x.mq, 1)) * 65536
      + cast[u64](bget(x.mq, 2)) * 256 + cast[u64](bget(x.mq, 3));
    let last = x.mqn * 4 - 4;
    let mut j = 0;
    while j < last
      invariant xhci_ok(x) && x.mqn >= 1 && last + 4 <= MQ_N * 4 && j <= last
    {
      bset(&mut x.mq, j, bget(x.mq, j + 4));
      j = j + 1;
    }
    x.mqn = x.mqn - 1;
    return p;
  }
  if x.qn == 0 && x.sp.qn > 0 {
    let sb = cast[u64](bget(x.sp.q, 0));
    let mut j = 0;
    while j + 1 < x.sp.qn
      invariant xhci_ok(x) && x.sp.qn >= 1 && j < x.sp.qn
    {
      bset(&mut x.sp.q, j, bget(x.sp.q, j + 1));
      j = j + 1;
    }
    x.sp.qn = x.sp.qn - 1;
    if x.sp.wait && x.sp.qn + x.sp.mps <= SQ_N {
      x.sp.wait = false;
      ser_in_queue(&mut x);
    }
    return SER_PKT + sb;
  }
  if x.qn == 0 {
    return 256;
  }
  let b = cast[u64](bget(x.q, 0));
  let mut i = 0;
  while i + 1 < x.qn
    invariant xhci_ok(x) && x.qn >= 1 && i < x.qn
  {
    bset(&mut x.q, i, bget(x.q, i + 1));
    i = i + 1;
  }
  x.qn = x.qn - 1;
  return b;
}

enum Usb { None, Xhci(Xhci) }

spec fn usb_ok(u: &Usb) -> bool {
  u is Usb::Xhci ==> xhci_ok(u.Xhci)
}

fn usb_live(u: &Usb) -> bool {
  match u {
    Usb::None => { return false; },
    Usb::Xhci(x) => { return x.live; },
  }
}

/// Is there a USB mouse?
fn usb_mouse(u: &Usb) -> bool {
  match u {
    Usb::None => { return false; },
    Usb::Xhci(x) => { return x.mlive; },
  }
}

/// SER_NONE, SER_FTDI or SER_ACM: is there a USB serial port?
fn usb_ser(u: &Usb) -> u64
  ensures result <= SER_ACM
{
  match u {
    Usb::None => { return SER_NONE; },
    Usb::Xhci(x) => { return ser_kind_of(x.sp.kind); },
  }
}

/// k, if it is a kind of serial port, else SER_NONE.
fn ser_kind_of(k: u64) -> u64
  ensures result <= SER_ACM
{
  if k == SER_FTDI || k == SER_ACM {
    return k;
  }
  return SER_NONE;
}

/// Sends the first n bytes of src to the USB serial port, if there is one:
/// how many it took (xhci_ser_send).
fn usb_ser_send(u: &mut Usb, src: &Bytes, n: u64) -> u64
  requires usb_ok(u)
  ensures usb_ok(u) && result <= n && result <= blen(src)
{
  match u {
    Usb::None => { u = Usb::None; return 0; },
    Usb::Xhci(mut x) => {
      let r = xhci_ser_send(&mut x, src, n);
      u = Usb::Xhci(x);
      return r;
    },
  }
}

/// MSD_NONE, MSD_UNUSED or MSD_ON: is there a USB disk, and is it the disk?
fn usb_msd(u: &Usb) -> u64 {
  match u {
    Usb::None => { return MSD_NONE; },
    Usb::Xhci(x) => { return x.msd; },
  }
}

fn usb_poll(u: &mut Usb) -> u64
  requires usb_ok(u)
  ensures usb_ok(u) && (result <= 256 || (result >= MOUSE_PKT && result < 2 * MOUSE_PKT) || (result >= SER_PKT && result < SER_PKT + 256))
{
  match u {
    Usb::None => { u = Usb::None; return 256; },
    Usb::Xhci(mut x) => {
      let b = xhci_poll(&mut x);
      u = Usb::Xhci(x);
      return b;
    },
  }
}

/// Intel's 7-, 8- and 9-series chipsets (Panther Point, Lynx Point,
/// Wildcat Point) power up with the USB 2 ports of the shared lanes routed
/// to the EHCI controller, and the super-speed switch off; the xHCI
/// controller then sees no device behind those ports. Routing them (and
/// switching the SuperSpeed ports on) is two registers in its PCI
/// configuration space: XUSB2PR (0xD0, whose supported mask is at 0xD4) and
/// USB3_PSSEN (0xD8, mask at 0xDC). It is what Linux does too. Untested:
/// QEMU's xHCI has no such registers.
fn xhci_route_ports(pci: &mut Pci, dev: u64)
  requires pci_ok(pci) && dev < PCI_NONE
{
  let id = pci_read(&mut pci, dev, PCI_ID);
  if id == 0x1E318086 || id == 0x8C318086 || id == 0x9C318086 || id == 0x8CB18086 || id == 0x9CB18086 {
    let usb2 = pci_read(&mut pci, dev, 0xD4);
    let usb3 = pci_read(&mut pci, dev, 0xDC);
    pci_write(&mut pci, dev, 0xD8, usb3);
    pci_write(&mut pci, dev, 0xD0, usb2);
  }
}

/// The xHCI controller `dev` on PCI, whose registers are bar ..
/// bar + size, started with pages at .. at+10, if the registers lie in the
/// device window (`bar_space`) clear of the framebuffer at lo .. hi and
/// the block at lo2 .. hi2; else none. A controller with neither a
/// keyboard, mouse, serial port nor a disk with a BastiOS partition is stopped and given back
/// at once.
fn usb_new(pci: &mut Pci, m: &mut Mem, win: &mut MmioSpace, at: u64, lo: u64, hi: u64, lo2: u64, hi2: u64,
  dev: u64, bar: u64, size: u64, msi: u64, vec: u64) -> Usb
  requires pci_ok(pci) && mem_ok(m) && at + XHCI_PAGES <= NPAGES && bar < WIN_TOP && size <= XHCI_MAX_LEN
  requires msi <= 4294967295 && vec <= 255
  requires forall a: u64 :: bar_space(a) && !(lo <= a && a < hi) && !(lo2 <= a && a < hi2) ==> mmio_free(win, a)
  ensures usb_ok(result) && mem_ok(m)
  ensures forall a: u64 :: bar_space(a) && !(lo <= a && a < hi) && !(lo2 <= a && a < hi2) && !(bar <= a && a < bar + size) ==> mmio_free(win, a)
  ensures result is Usb::Xhci ==> mmio_base(result.Xhci.regs) == bar && mmio_len(result.Xhci.regs) == size
  ensures !(result is Usb::Xhci) ==> forall a: u64 :: bar_space(a) && !(lo <= a && a < hi) && !(lo2 <= a && a < hi2) ==> mmio_free(win, a)
{
  if dev >= PCI_NONE || size < 0x2000 || bar % 4096 != 0
    || !((bar >= WIN_LO && bar + size <= WIN_LOW_TOP) || (bar >= WIN_HIGH && bar + size <= WIN_TOP))
    || !(bar + size <= lo || bar >= hi) || !(bar + size <= lo2 || bar >= hi2) || !pages_free(m, at, XHCI_PAGES) {
    return Usb::None;
  }
  pci_enable(&mut pci, dev);
  xhci_route_ports(&mut pci, dev);
  let f0 = take_low_page(&mut m, at);
  let f1 = take_low_page(&mut m, at + 1);
  let f2 = take_low_page(&mut m, at + 2);
  let f3 = take_low_page(&mut m, at + 3);
  let f4 = take_low_page(&mut m, at + 4);
  let f5 = take_low_page(&mut m, at + 5);
  let f6 = take_low_page(&mut m, at + 6);
  let f7 = take_low_page(&mut m, at + 7);
  let f8 = take_low_page(&mut m, at + 8);
  let f9 = take_low_page(&mut m, at + 9);
  let f10 = take_low_page(&mut m, at + 10);
  let f11 = take_low_page(&mut m, at + 11);
  let f12 = take_low_page(&mut m, at + 12);
  let regs = mmio_claim(&mut win, bar, size);
  let mut x = xhci_new(regs, &mut m, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12);
  if !x.live && !x.mlive && x.msd != MSD_ON && x.sp.kind == SER_NONE {
    mmio_release(&mut win, xhci_free(x, &mut m));
    return Usb::None;
  }
  // The disk's completions by MSI-X, unless `msi` is 0, if the table is
  // in the claimed registers (BAR 0).
  let mut cap = 0;
  if x.msd == MSD_ON && msi != 0 {
    cap = pci_cap(&mut pci, dev, CAP_MSIX);
  }
  if cap != 0 && cap < 252 {
    let table = pci_msix_table(&mut pci, dev, cap);
    if table < 4294967296 {
      pci_intx_off(&mut pci, dev);
      pci_msix_on(&mut pci, dev, cap);
      xhci_msix(&mut x, table, msi, vec);
    }
  }
  return Usb::Xhci(x);
}

spec fn usb_claims(u: &Usb, a: u64) -> bool {
  u is Usb::Xhci && mmio_base(u.Xhci.regs) <= a && a < mmio_base(u.Xhci.regs) + mmio_len(u.Xhci.regs)
}

/// Where the kept controller's registers start (0 without one).
fn usb_base(u: &Usb) -> u64
  ensures u is Usb::Xhci ==> result == mmio_base(u.Xhci.regs)
  ensures !(u is Usb::Xhci) ==> result == 0
{
  match u {
    Usb::Xhci(x) => { return mmio_base(x.regs); },
    Usb::None => { return 0; },
  }
}

/// Where they end (0 without one).
fn usb_top(u: &Usb) -> u64
  ensures u is Usb::Xhci ==> result == mmio_base(u.Xhci.regs) + mmio_len(u.Xhci.regs)
  ensures !(u is Usb::Xhci) ==> result == 0
{
  match u {
    Usb::Xhci(x) => { return mmio_base(x.regs) + mmio_len(x.regs); },
    Usb::None => { return 0; },
  }
}

/// The first xHCI controller on PCI that has a keyboard, a mouse or a
/// disk with a BastiOS partition (usb_new), trying them in turn, at most
/// XHCI_TRIES: a PC often has several, and the first is not always the
/// one with the keyboard (recent Intel ones put a controller for the
/// USB-C ports ahead of the chipset's, AMD ones have two or three). The
/// controllers it does not keep are stopped and given back. Devices on
/// two controllers are not both used: the first controller with any
/// wins.
fn usb_find(pci: &mut Pci, m: &mut Mem, win: &mut MmioSpace, at: u64, lo: u64, hi: u64, msi: u64, vec: u64) -> Usb
  requires pci_ok(pci) && mem_ok(m) && at + XHCI_PAGES <= NPAGES && msi <= 4294967295 && vec <= 255
  requires forall a: u64 :: bar_space(a) && !(lo <= a && a < hi) ==> mmio_free(win, a)
  ensures usb_ok(result) && mem_ok(m) && pci_ok(pci)
  ensures forall a: u64 :: bar_space(a) && !(lo <= a && a < hi) && !usb_claims(result, a) ==> mmio_free(win, a)
{
  let mut d = 0;
  let mut n = 0;
  while d < PCI_NONE && n < XHCI_TRIES
    invariant pci_ok(pci) && mem_ok(m) && d <= PCI_NONE
    invariant forall a: u64 :: bar_space(a) && !(lo <= a && a < hi) ==> mmio_free(win, a)
  {
    d = pci_class_from(&mut pci, XHCI_CLASS, d);
    if d >= PCI_NONE {
      return Usb::None;
    }
    let bar = usb_bar(&mut pci, d);
    let size = usb_bar_size(&mut pci, d);
    match usb_new(&mut pci, &mut m, &mut win, at, lo, hi, 0, 0, d, bar, size, msi, vec) {
      Usb::None => {},
      Usb::Xhci(x) => { return Usb::Xhci(x); },
    }
    d = pci_next(&mut pci, d);
    n = n + 1;
  }
  return Usb::None;
}

/// How many xHCI controllers there are on PCI (up to XHCI_TRIES).
fn usb_count(pci: &mut Pci) -> u64
  requires pci_ok(pci)
  ensures pci_ok(pci)
{
  let mut d = 0;
  let mut n = 0;
  while d < PCI_NONE && n < XHCI_TRIES
    invariant pci_ok(pci) && d <= PCI_NONE
  {
    d = pci_class_from(&mut pci, XHCI_CLASS, d);
    if d < PCI_NONE {
      n = n + 1;
      d = pci_next(&mut pci, d);
    }
  }
  return n;
}

/// The registers of xHCI controller `dev` (32: none): base, then size
/// (both 0 if it has no usable memory BAR).
fn usb_bar(pci: &mut Pci, dev: u64) -> u64
  requires pci_ok(pci)
  ensures result < WIN_TOP
{
  if dev >= PCI_NONE {
    return 0;
  }
  return pci_mem_bar64(&mut pci, dev);
}

fn usb_bar_size(pci: &mut Pci, dev: u64) -> u64
  requires pci_ok(pci)
  ensures result <= XHCI_MAX_LEN
{
  if dev >= PCI_NONE {
    return 0;
  }
  let n = pci_bar_size(&mut pci, dev);
  if n > XHCI_MAX_LEN {
    return XHCI_MAX_LEN;
  }
  return n;
}

/// Stops the controller and gives its registers and pages back (at power
/// off); the keyboard is gone afterwards.
fn usb_off(u: &mut Usb, win: &mut MmioSpace, m: &mut Mem)
  requires usb_ok(u) && mem_ok(m)
  ensures usb_ok(u) && mem_ok(m)
{
  match u {
    Usb::None => { u = Usb::None; },
    Usb::Xhci(x) => {
      mmio_release(&mut win, xhci_free(x, &mut m));
      u = Usb::None;
    },
  }
}
