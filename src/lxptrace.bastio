// ptrace: a process (the tracer) watches and steers another (the tracee).
//
// The tracer is kept in the tracee's word in k.sys from SYS_PT (see
// src/proc.bastio): TRACEME names the parent, ATTACH and SEIZE the caller.
// A traced process stops, in a ptrace-stop, instead of acting on each
// signal it takes (src/lxsig.bastio lx_deliver), and after the SIGTRAP
// that follows an execve. The stop is the job-control stop (STOPPED, with
// its report for wait4 and waitid): a tracer hears of it without asking
// for WUNTRACED. PTRACE_CONT, PTRACE_DETACH and PTRACE_KILL end it; a
// signal given to CONT or DETACH is delivered in place of the one that
// stopped the process. While it is stopped the tracer reads and writes its
// memory and registers.
//
// The registers are those of the interrupted program: a stop at a signal
// is between two instructions, and one at a system call (below) is just
// before or after it. The
// flags, rip, rsp and fs base the kernel puts back are checked on the way
// to user mode (boot/boot.S), so a tracer cannot hand a process a kernel
// address or a segment.
//
// PTRACE_SYSCALL stops a process before and after each system call (a
// second word per process, from SYS_PT2, tells which: pt_sys_entry and
// pt_sys_exit, called from the trap handler in src/main.bastio). The stop
// before a call leaves rax at -ENOSYS and orig_rax at the call; when the
// tracer resumes it the call starts again, as a waiting call does, with
// whatever number the tracer left in orig_rax. A traced task is marked
// slow (Task.slow), so getpid and gettid, which a processor otherwise
// answers without the kernel lock, are seen too.
// PTRACE_SINGLESTEP sets the trap flag in the saved flags; the debug trap
// (vector 1) is SIGTRAP, which stops the process as any signal does.
//
// The events PTRACE_O_TRACEFORK, TRACEVFORK, TRACECLONE and TRACEEXEC ask
// for are reported: the tracer's tracee stops with SIGTRAP and the event in
// the status (status >> 16), PTRACE_GETEVENTMSG gives the new child's id
// (or the old thread's, for exec), and the new child starts attached to the
// same tracer, stopped by SIGSTOP. A vfork parent hears of its event only
// when it runs again.
//
// SECCOMP_RET_TRACE with PTRACE_O_TRACESECCOMP stops the tracee before the
// call as a PTRACE_SYSCALL stop does, but with PTRACE_EVENT_SECCOMP in the
// status and the filter's data as the event message (pt_seccomp_stop).
//
// PTRACE_GET_SYSCALL_INFO says at a system call stop (entry, exit or
// SECCOMP_RET_TRACE) which one it is, with the call's number and arguments,
// the result at an exit and the filter's data at a seccomp stop.
//
// PTRACE_O_TRACEEXIT stops the tracee before exit and exit_group finish
// (PTRACE_EVENT_EXIT, the status as the event message; the call starts again
// when the tracer resumes it), and PTRACE_O_TRACEVFORKDONE stops a vfork
// parent when its child lets the address space go. A stop signal stops a
// seized tracee in a ptrace-stop of its own (PTRACE_EVENT_STOP, the signal in
// the status), which PTRACE_LISTEN turns into a plain group-stop: the tracee
// stays stopped, and SIGCONT ends it with another event stop.
//
// Not done: the exit event of a process a signal ends, the debug registers.
// A tracer that is not the parent hears of its
// tracee's end once, then the parent reaps it. There is no Yama scope: the
// caller needs root or the target's user and group ids, as for
// pidfd_getfd.

import "ptfmt.bastio";
import "lxpidfd.bastio";

const LX_PTRACE: u64 = 101;
const PTRACE_TRACEME: u64 = 0;
const PTRACE_PEEKTEXT: u64 = 1;
const PTRACE_PEEKDATA: u64 = 2;
const PTRACE_PEEKUSER: u64 = 3;
const PTRACE_POKETEXT: u64 = 4;
const PTRACE_POKEDATA: u64 = 5;
const PTRACE_POKEUSER: u64 = 6;
const PTRACE_CONT: u64 = 7;
const PTRACE_SINGLESTEP: u64 = 9;
const PTRACE_SYSCALL: u64 = 24;
const PTRACE_KILL: u64 = 8;
const PTRACE_GETREGS: u64 = 12;
const PTRACE_SETREGS: u64 = 13;
const PTRACE_GETFPREGS: u64 = 14;
const PTRACE_SETFPREGS: u64 = 15;
const PTRACE_ATTACH: u64 = 16;
const PTRACE_DETACH: u64 = 17;
const PTRACE_SETOPTIONS: u64 = 0x4200;
const EV_EXIT: u64 = 6;                // PTRACE_EVENT_EXIT
const EV_VFORK_DONE: u64 = 5;          // PTRACE_EVENT_VFORK_DONE
const PTRACE_GETEVENTMSG: u64 = 0x4201;
const PTRACE_GETSIGINFO: u64 = 0x4202;
const PTRACE_SETSIGINFO: u64 = 0x4203;
const PTRACE_GETREGSET: u64 = 0x4204;
const PTRACE_SETREGSET: u64 = 0x4205;
const PTRACE_SEIZE: u64 = 0x4206;
const PTRACE_INTERRUPT: u64 = 0x4207;
const PTRACE_LISTEN: u64 = 0x4208;
const PTRACE_GET_SYSCALL_INFO: u64 = 0x420e;
const NT_PRSTATUS: u64 = 1;
const USER_DEBUGREG: u64 = 848;          // offsetof(struct user, u_debugreg)
const PTRACE_O_VALID: u64 = 0x1000FF;    // the options there are (events and EXITKILL)

fn is_ptrace_call(n: u64) -> bool {
  return n == LX_PTRACE;
}

/// Word i of the registers of stopped process c.
fn ur_read(k: &Kernel, c: u64, i: u64) -> u64
  requires kok(k) && c < NPROC && i < USER_REGS
{
  let r = ur_reg(i);
  if r < UR_NREG {
    return pget(k.procs, c, F_REGS + r);
  }
  if i == UR_ORIG {
    let t = tr2_get(k, c);
    if t / TS_ENTRY % 2 == 1 || t / TS_EXIT % 2 == 1 {
      return t / TS_NR % 1024;              // orig_rax: the call it stopped at
    }
    return 0xFFFFFFFFFFFFFFFF;              // not in a system call
  }
  return ur_const(i);
}

/// Sets word i of the registers of stopped process c (cs, ss, the other
/// segments and gs_base cannot be changed).
fn ur_write(k: &mut Kernel, c: u64, i: u64, v: u64)
  requires kok(k) && c < NPROC && i < USER_REGS
  ensures kok(k)
{
  let r = ur_reg(i);
  if r < UR_NREG {
    pset(&mut k.procs, c, F_REGS + r, v);
  }
  if i == UR_ORIG {
    // orig_rax at a system call stop: the call to run (anything else, -1
    // included, makes it fail with ENOSYS).
    let t = tr2_get(k, c);
    tr2_put(&mut k, c, t % TS_NR + smaller(v, 1023) * TS_NR);
  }
}

/// Whether process c is stopped for its tracer, process pid.
fn pt_ready(k: &Kernel, pid: u64, c: u64) -> bool
  requires kok(k) && pid < NPROC && c < NPROC
{
  return state(k.procs, c) == STOPPED && traced_by(k, c, pid) && tr_stopped(tr_get(k, c)) == 1;
}

/// Lets stopped process c go on, passing signal sig (0: none) in place of
/// the one that stopped it. With `detach` it is no longer traced; with
/// `sys` it stops at its next system call, before and after it; with `step`
/// after its next instruction.
fn pt_resume(k: &mut Kernel, c: u64, sig: u64, detach: bool, sys: bool, step: bool)
  requires kok(k) && 1 <= c && c < NPROC && sig <= NSIG
  ensures kok(k)
{
  let w = tr_get(k, c);
  let t = tr2_get(k, c);
  if t / TS_OWE % 2 == 1 && sys && !detach {
    // Resumed from the event stop of a call: now the stop after the call.
    tr2_put(&mut k, c, TS_SYS + TS_EXIT + t / TS_NR % 1024 * TS_NR);
    tr_stop(&mut k, c, 5 + 128 * (tr_opt(w) % 2));
    return;
  }
  let mut skip = 0;
  if sig != 0 && !detach {
    skip = 1;
  }
  if detach {
    tr_put(&mut k, c, 0);
  } else {
    tr_put(&mut k, c, tr_make(w % 65536, tr_att(w), 0, skip, 0, tr_opt(w)));
  }
  let mut next = t / TS_NR % 1024 * TS_NR;   // the call's number stays
  if has_sig(pget(k.procs, c, F_SIGPEND), 5) {
    next = next + t / TS_EV * TS_EV;       // the event belongs to the SIGTRAP still to be taken
  }
  if sys && !detach {
    next = next + TS_SYS;
  }
  if step && !detach {
    next = next + TS_STEP;
    let fl = pget(k.procs, c, F_REGS + R_RFLAGS);
    pset(&mut k.procs, c, F_REGS + R_RFLAGS, step_flags(fl, true));
  }
  if t / TS_ENTRY % 2 == 1 {
    // Stopped before a system call: it runs now, as the tracer left it.
    let rip = pget(k.procs, c, F_REGS + R_RIP);
    if rip >= SYSCALL_LEN {
      pset(&mut k.procs, c, F_REGS + R_RIP, rip - SYSCALL_LEN);
    }
    pset(&mut k.procs, c, F_REGS + R_LXNR, t / TS_NR % 1024);
    if sys && !detach {
      next = next + TS_NOENT;               // the stop before it is done; the one after it is not
    }
  }
  if t / TS_CUT % 2 == 1 && t / TS_EXIT % 2 == 1 && sys && !detach {
    next = next + TS_CUT;                   // the signal that cut the call short is next
  }
  tr2_put(&mut k, c, sat_add(next, t / TS_XEV % 2 * TS_XEV));
  if t / TS_VFDONE % 2 == 1 && t / TS_EV % 16 == 2 && !detach {
    // The vfork event is over: the vfork-done one comes next, with the
    // same message (the child's id).
    tr2_put(&mut k, c, tr2_get(k, c) % TS_EV + EV_VFORK_DONE * TS_EV + t / TS_MSG % 65536 * TS_MSG);
    post_from(&mut k, c, 5, c);
  }
  jc_set(&mut k, c, jc_get(k, c) / JC_EXECED % 2 * JC_EXECED);   // the stop is no news any more
  if sig != 0 {
    pset(&mut k.procs, c, F_SIGPEND, pget(k.procs, c, F_SIGPEND) | sbit(sig));
  }
  if state(k.procs, c) == STOPPED {
    pset(&mut k.procs, c, F_STATE, READY);
  }
}

/// Process p took a debug trap (vector 1): a single step its tracer asked
/// for ends, and the trap flag goes.
fn pt_stepped(k: &mut Kernel, p: u64)
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let t = smaller(tr2_get(k, p), 0xFFFFFFFFFFFFFF);   // the word is far below this
  if t / TS_STEP % 2 == 1 {
    let fl = pget(k.procs, p, F_REGS + R_RFLAGS);
    pset(&mut k.procs, p, F_REGS + R_RFLAGS, step_flags(fl, false));
    tr2_put(&mut k, p, t % TS_STEP + t / (2 * TS_STEP) * (2 * TS_STEP) + TS_TRAP);
  }
}

/// Process p took a breakpoint trap (vector 3): if it is traced, the stop
/// that follows says so in its siginfo.
fn pt_brk(k: &mut Kernel, p: u64)
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let t = smaller(tr2_get(k, p), 0xFFFFFFFFFFFFFF);   // the word is far below this
  if tr_tracer(k, p) != 0 && t / TS_BRK % 2 == 0 {
    tr2_put(&mut k, p, t + TS_BRK);
  }
}

/// Process p is about to make a system call (it has been charged for none
/// yet). If its tracer asked to see calls it stops before the call, which
/// starts again when the tracer resumes it: true. The call's number is kept
/// for the stop after it. A call that waits and starts again is not seen again.
fn pt_sys_entry(k: &mut Kernel, p: u64, restarted: bool) -> bool
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let t = tr2_get(k, p);
  if tr_tracer(k, p) == 0 || t % 2 == 0 || restarted {
    return false;
  }
  let nr = smaller(pget(k.procs, p, F_REGS + R_LXNR), 1023);
  if t / TS_NOENT % 2 == 1 {
    tr2_put(&mut k, p, TS_SYS + nr * TS_NR + t / TS_EV * TS_EV);
    return false;
  }
  tr2_put(&mut k, p, TS_SYS + TS_ENTRY + nr * TS_NR + t / TS_EV * TS_EV);
  if PT_ENTRY_RET == 1 {
    pset(&mut k.procs, p, F_REGS + R_RET, ENOSYS);   // what a tracer reads in rax before the call
  }
  tr_stop(&mut k, p, 5 + 128 * (tr_opt(tr_get(k, p)) % 2));   // SIGTRAP, with 0x80 for PTRACE_O_TRACESYSGOOD
  return true;
}

/// Whether process p is traced by a tracer that asked to hear of
/// SECCOMP_RET_TRACE (PTRACE_O_TRACESECCOMP).
fn pt_wants_seccomp(k: &Kernel, p: u64) -> bool
  requires kok(k) && 1 <= p && p < NPROC
{
  return tr_tracer(k, p) != 0 && tr_opt(tr_get(k, p)) / 128 % 2 == 1;
}

/// A filter of process p answered SECCOMP_RET_TRACE with data (16 bits) and
/// its tracer asked for that: p stops before the call with SIGTRAP and
/// PTRACE_EVENT_SECCOMP in the status (PTRACE_GETEVENTMSG gives data). It
/// stops as before a system call (rax is -ENOSYS, the call's number stays
/// for the tracer to read or change), and the call starts again when the
/// tracer resumes it, without the filters (SPS_TRACED, src/lxseccomp.bastio).
fn pt_seccomp_stop(k: &mut Kernel, p: u64, data: u64)
  requires kok(k) && 1 <= p && p < NPROC && data < 65536
  ensures kok(k)
{
  let t = tr2_get(k, p);
  let nr = smaller(pget(k.procs, p, F_REGS + R_LXNR), 1023);
  tr2_put(&mut k, p, t % TS_ENTRY + TS_ENTRY + TS_SECC + nr * TS_NR + 7 * TS_EV + data * TS_MSG);
  if PT_ENTRY_RET == 1 {
    pset(&mut k.procs, p, F_REGS + R_RET, ENOSYS);
  }
  tr_stop(&mut k, p, 5);
}

/// Process p has made its system call. If its tracer asked to see calls it
/// stops now, with the result in rax: true. Not if the call waits.
fn pt_sys_exit(k: &mut Kernel, p: u64) -> bool
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let t = tr2_get(k, p);
  let st = state(k.procs, p);
  if tr_tracer(k, p) == 0 || t % 2 == 0 || pget(k.procs, p, F_RESTART) != 0 || (st != READY && st != RUNNING) {
    return false;
  }
  let ev = t / TS_EV % 16;
  if ev != 0 && ev != EV_STOP && has_sig(pget(k.procs, p, F_SIGPEND), 5) {
    // An event (fork, exec, ...) of this very call: as on Linux, its stop
    // comes first, and the stop after the call when the tracer resumes it.
    pset(&mut k.procs, p, F_SIGPEND, pget(k.procs, p, F_SIGPEND) & !sbit(5));
    tr2_put(&mut k, p, t % TS_NR + t / TS_NR % 1024 * TS_NR + TS_OWE + ev * TS_EV + t / TS_MSG % 65536 * TS_MSG);
    tr_stop(&mut k, p, 5);
    return true;
  }
  tr2_put(&mut k, p, t % TS_NR + t / TS_NR % 1024 * TS_NR + TS_EXIT + t / TS_EV * TS_EV);
  tr_stop(&mut k, p, 5 + 128 * (tr_opt(tr_get(k, p)) % 2));
  return true;
}

/// Process p has made process c (kind 1: fork, 2: vfork, 3: clone). If its
/// tracer asked for that event (PTRACE_O_TRACEFORK, TRACEVFORK or
/// TRACECLONE) the child starts traced by the same tracer, stopped by
/// SIGSTOP, and p stops with SIGTRAP and the event once it runs again.
fn pt_fork_event(k: &mut Kernel, p: u64, c: u64, kind: u64)
  requires kok(k) && 1 <= p && p < NPROC && c < NPROC && 1 <= kind && kind <= 3
  ensures kok(k)
{
  let w = tr_get(k, p);
  if w % 65536 == 0 || c == 0 || c == p {
    return;
  }
  let opt = tr_opt(w);
  let mut bit = 8;
  if kind == 1 {
    bit = 2;
  } else if kind == 2 {
    bit = 4;
  }
  if opt / bit % 2 == 0 {
    return;
  }
  tr_put(&mut k, c, tr_make(w % 65536, 1, 0, 0, 0, opt));
  if opt / 512 % 2 == 1 {
    // A seizing tracer meets the new child in an event stop (SIGTRAP and
    // PTRACE_EVENT_STOP), not in a SIGSTOP.
    tr2_put(&mut k, c, EV_STOP * TS_EV);
    tr_stop(&mut k, c, 5);
  } else {
    tr2_put(&mut k, c, 0);
    tr_stop(&mut k, c, 19);                 // SIGSTOP: where the new child waits for its tracer
  }
  tr2_put(&mut k, p, tr2_get(k, p) % TS_EV + kind * TS_EV + vpid_of(k, p, c) % 65536 * TS_MSG);
  post_from(&mut k, p, 5, p);               // SIGTRAP, which the stop reports with the event
}

/// Process p calls exit or exit_group with status `code`. With
/// PTRACE_O_TRACEEXIT its tracer is told first: p stops with SIGTRAP and
/// PTRACE_EVENT_EXIT (the status, code << 8, is the event message), and the
/// call starts again when the tracer resumes it. True if p stops.
fn pt_exit_event(k: &mut Kernel, p: u64, code: u64) -> bool
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let w = tr_get(k, p);
  let t = tr2_get(k, p);
  let rip = pget(k.procs, p, F_REGS + R_RIP);
  if w % 65536 == 0 || tr_opt(w) / 64 % 2 == 0 || t / TS_XEV % 2 == 1 || rip < SYSCALL_LEN {
    return false;
  }
  pset(&mut k.procs, p, F_REGS + R_RIP, rip - SYSCALL_LEN);
  tr2_put(&mut k, p, t % TS_EV + EV_EXIT * TS_EV + (code % 256) * 256 * TS_MSG + TS_XEV);
  post_from(&mut k, p, 5, p);
  return true;
}

/// Process p has made a child with vfork (a copy here: the parent does not
/// wait). If its tracer asked for PTRACE_O_TRACEVFORKDONE, the stop for the
/// vfork event is followed by one for the child's end of the borrowing, as
/// soon as the tracer resumes it (pt_resume).
fn pt_vfork_copied(k: &mut Kernel, p: u64)
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let w = tr_get(k, p);
  let t = tr2_get(k, p);
  if w % 65536 != 0 && tr_opt(w) / 32 % 2 == 1 && t / TS_EV % 16 == 2 {
    tr2_put(&mut k, p, sat_add(t, TS_VFDONE * (1 - t / TS_VFDONE % 2)));
  }
}

/// Process p's vfork child c has let go of the address space: with
/// PTRACE_O_TRACEVFORKDONE p's tracer is told (the child's id is the message).
fn pt_vfork_done(k: &mut Kernel, p: u64, c: u64)
  requires kok(k) && 1 <= p && p < NPROC && c < NPROC
  ensures kok(k)
{
  let w = tr_get(k, p);
  if w % 65536 != 0 && tr_opt(w) / 32 % 2 == 1 {
    tr2_put(&mut k, p, tr2_get(k, p) % TS_EV + EV_VFORK_DONE * TS_EV + vpid_of(k, p, c) % 65536 * TS_MSG);
    post_from(&mut k, p, 5, p);
  }
}

/// Process p has made a new program (execve). With PTRACE_O_TRACEEXEC its
/// tracer is told with the event instead of a plain SIGTRAP.
fn pt_exec_event(k: &mut Kernel, p: u64)
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let w = tr_get(k, p);
  if w % 65536 != 0 && tr_opt(w) / 16 % 2 == 1 {
    tr2_put(&mut k, p, tr2_get(k, p) % TS_EV + 4 * TS_EV + vpid_of(k, p, p) % 65536 * TS_MSG);
  }
}

/// PTRACE_TRACEME: the parent traces the caller.
fn pt_traceme(k: &mut Kernel, pid: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let par = pget(k.procs, pid, F_PARENT);
  if tr_tracer(k, pid) != 0 || par == 0 || par >= NPROC {
    return EPERM;
  }
  tr_put(&mut k, pid, tr_make(par + 1, 0, 0, 0, 0, 0));
  return 0;
}

/// PTRACE_ATTACH (stops the target with SIGSTOP) and PTRACE_SEIZE.
fn pt_attach(k: &mut Kernel, pid: u64, p: u64, seize: bool) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  if p == 0 || p >= NPROC || state(k.procs, p) == FREE || state(k.procs, p) == ZOMBIE {
    return ESRCH;
  }
  if tgid(k.procs, p) == tgid(k.procs, pid) || tr_tracer(k, p) != 0 {
    return EPERM;                           // itself, a thread of its group, or traced already
  }
  if !cred_root(k.procs, pid) && !same_ids(k.procs, pid, p) {
    return EPERM;
  }
  tr_put(&mut k, p, tr_make(pid + 1, 1, 0, 0, 0, 0));
  if state(k.procs, p) == STOPPED && !seize {
    // Already stopped by a signal: it is now stopped for its tracer, who
    // hears of it (its own stop was reported to the parent already).
    let sig = jc_get(k, p) % 256;
    tr_put(&mut k, p, tr_make(pid + 1, 1, 1, 0, sig, 0));
    jc_set(&mut k, p, sig + JC_STOP + jc_get(k, p) / JC_EXECED % 2 * JC_EXECED);
    tr_tell(&mut k, p);
  }
  if !seize {
    post_from(&mut k, p, SIGSTOP, pid);
  }
  return 0;
}

/// Reads the code pages of the tracee's program that cover the word at addr,
/// if they are not read yet (src/lazy.bastio): a tracer looking at code the
/// tracee has not run, as a debugger does at its first stop, finds it there.
fn pt_fill(k: &mut Kernel, c: u64, addr: u64)
  requires kok(k) && 1 <= c && c < NPROC
  ensures kok(k)
{
  if addr >= USER_BASE && addr < 0x8000000000000000 {
    let g = tgid(k.procs, c);
    let first = lazy_read(&mut k, g, (addr - USER_BASE) / 4096, true);
    let second = lazy_read(&mut k, g, (addr + 7 - USER_BASE) / 4096, true);
  }
}

/// Peeks (a word at addr of the tracee's memory, or of its registers) and
/// stores the word at `data`, as the raw system call does.
fn pt_peek(k: &mut Kernel, pid: u64, c: u64, req: u64, addr: u64, data: u64) -> u64
  requires kok(k) && pid < NPROC && 1 <= c && c < NPROC
  ensures kok(k)
{
  let mut v = 0;
  if req == PTRACE_PEEKUSER {
    if PT_USER_API == 0 || addr % 8 != 0 {
      return EIO;
    }
    if addr < USER_REGS_SIZE {
      v = ur_read(k, c, addr / 8);
    } else if addr < USER_DEBUGREG || addr >= USER_DEBUGREG + 64 {
      return EIO;
    }                                       // the debug registers read as zero
  } else {
    pt_fill(&mut k, c, addr);
    let tp = fd_row(&mut k, tgid(k.procs, c));
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, tp, addr, &mut k.fs.xfer, 8) != 8 {
      return EIO;
    }
    v = rd64(k.fs.xfer, 0);
  }
  xfer_u64(&mut k.fs.xfer, 0, v);
  return lx_put_out(&mut k, pid, data, 8);
}

/// Pokes data into a word of the tracee's memory or registers.
fn pt_poke(k: &mut Kernel, c: u64, req: u64, addr: u64, data: u64) -> u64
  requires kok(k) && 1 <= c && c < NPROC
  ensures kok(k)
{
  if req == PTRACE_POKEUSER {
    if PT_USER_API == 0 || addr % 8 != 0 {
      return EIO;
    }
    if addr < USER_REGS_SIZE {
      ur_write(&mut k, c, addr / 8, data);
      return 0;
    }
    if addr >= USER_DEBUGREG && addr < USER_DEBUGREG + 64 {
      // The debug registers are not kept, but an address watch must be one
      // a user program could touch.
      if (addr - USER_DEBUGREG) / 8 < 4 && data >= 0x800000000000 {
        return EINVAL;
      }
      return 0;
    }
    return EIO;
  }
  pt_fill(&mut k, c, addr);
  if addr >= USER_BASE && addr < 0x8000000000000000 {
    // Shared program text is read-only for everyone: the tracee gets a copy of
    // the pages the word is on, to hold what the tracer writes there.
    let g = tgid(k.procs, c);
    let first = own_touch(&mut k.mem, &mut k.spaces, g, (addr - USER_BASE) / 4096, true);
    let second = own_touch(&mut k.mem, &mut k.spaces, g, (addr + 7 - USER_BASE) / 4096, true);
  }
  let tp = fd_row(&mut k, tgid(k.procs, c));
  xfer_u64(&mut k.fs.xfer, 0, data);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, tp, addr, k.fs.xfer, 8) != 8 && force_to_user(&mut k.spaces, tp, addr, k.fs.xfer, 8) != 8 {
    return EIO;
  }
  return 0;
}

/// The registers of the tracee to `to` (a user_regs_struct), n bytes.
fn pt_getregs(k: &mut Kernel, pid: u64, c: u64, to: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && 1 <= c && c < NPROC && n <= USER_REGS_SIZE
  ensures kok(k)
{
  let mut i = 0;
  while i < USER_REGS
    invariant i <= USER_REGS && kok(k)
  {
    xfer_u64(&mut k.fs.xfer, i * 8, ur_read(k, c, i));
    i = i + 1;
  }
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, to, k.fs.xfer, n) != n {
    return EFAULT;
  }
  return 0;
}

/// The tracee's registers from `from` (a user_regs_struct), n bytes.
fn pt_setregs(k: &mut Kernel, pid: u64, c: u64, from: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && 1 <= c && c < NPROC && n <= USER_REGS_SIZE
  ensures kok(k)
{
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, from, &mut k.fs.xfer, n) != n {
    return EFAULT;
  }
  let mut i = 0;
  while i < USER_REGS && i * 8 + 8 <= n
    invariant i <= USER_REGS && kok(k)
  {
    ur_write(&mut k, c, i, rd64(k.fs.xfer, i * 8));
    i = i + 1;
  }
  return 0;
}

/// PTRACE_GETFPREGS and SETFPREGS: the tracee's x87 and SSE registers, as
/// the 512 bytes FXSAVE keeps (a user_fpregs_struct), to or from `to`.
fn pt_fpregs(k: &mut Kernel, pid: u64, c: u64, to: u64, set: bool) -> u64
  requires kok(k) && pid < NPROC && 1 <= c && c < NPROC
  ensures kok(k)
{
  if set {
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, to, &mut k.fs.xfer, 512) != 512 {
      return EFAULT;
    }
  }
  match take_fpu(&mut k.fpus, c) {
    Fpu::None => {
      put_fpu(&mut k.fpus, c, Fpu::None);
      if !set {
        let mut i = 0;
        while i < 512
          invariant i <= 512 && kok(k)
        {
          bset(&mut k.fs.xfer, i, 0);
          i = i + 1;
        }
        xfer_u64(&mut k.fs.xfer, 0, 0x37f);       // the state a process starts with
        xfer_u64(&mut k.fs.xfer, 24, 0x1f80);
      }
    },
    Fpu::State(mut f) => {
      let mut i = 0;
      while i < 512
        invariant i <= 512 && kok(k)
      {
        if set {
          frame_write(&mut f, i, bget(k.fs.xfer, i));
        } else {
          let v = frame_read8(f, i);
          bset(&mut k.fs.xfer, i, v);
        }
        i = i + 1;
      }
      put_fpu(&mut k.fpus, c, Fpu::State(f));
    },
  }
  if !set {
    if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, to, k.fs.xfer, 512) != 512 {
      return EFAULT;
    }
  }
  return 0;
}

/// PTRACE_GETREGSET and SETREGSET of NT_PRSTATUS: data is an iovec.
fn pt_regset(k: &mut Kernel, pid: u64, c: u64, set: bool, kind: u64, data: u64) -> u64
  requires kok(k) && pid < NPROC && 1 <= c && c < NPROC
  ensures kok(k)
{
  if kind != NT_PRSTATUS {
    return EINVAL;
  }
  if data > 0xFFFFFFFFFFFFFFF0 {
    return EFAULT;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, data, &mut k.fs.xfer, 16) != 16 {
    return EFAULT;
  }
  let base = rd64(k.fs.xfer, 0);
  let len = smaller(rd64(k.fs.xfer, 8), USER_REGS_SIZE);
  let mut r = 0;
  if set {
    r = pt_setregs(&mut k, pid, c, base, len);
  } else {
    r = pt_getregs(&mut k, pid, c, base, len);
  }
  if r != 0 {
    return r;
  }
  xfer_u64(&mut k.fs.xfer, 0, len);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, data + 8, k.fs.xfer, 8) != 8 {
    return EFAULT;
  }
  return 0;
}

/// ptrace(req, p, addr, data). Peeks give their word through `data`.
fn lx_ptrace(k: &mut Kernel, pid: u64, req0: u64, p0: u64, addr: u64, data: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let req = req0 % 0x100000000;
  let p = p0 % 0x100000000;
  if req == PTRACE_TRACEME {
    return pt_traceme(&mut k, pid);
  }
  if req == PTRACE_ATTACH || req == PTRACE_SEIZE {
    if req == PTRACE_SEIZE && data & !PTRACE_O_VALID != 0 {
      return EINVAL;
    }
    let r = pt_attach(&mut k, pid, p, req == PTRACE_SEIZE);
    if r == 0 && req == PTRACE_SEIZE && p < NPROC {
      // SEIZE takes its options in data and does not stop the tracee.
      let w = tr_get(k, p);
      tr_put(&mut k, p, tr_make(w % 65536, tr_att(w), tr_stopped(w), tr_skip(w), tr_sig(w), data % 256 + data / 0x100000 % 2 * 256 + 512));
    }
    return r;
  }
  if p == 0 || p >= NPROC || state(k.procs, p) == FREE || !traced_by(k, p, pid) {
    return ESRCH;
  }
  if req == PTRACE_SETOPTIONS && state(k.procs, p) != ZOMBIE {
    // Allowed whenever it is traced, as on Linux, but only valid options.
    if data & !PTRACE_O_VALID != 0 {
      return EINVAL;
    }
    let w = tr_get(k, p);
    tr_put(&mut k, p, tr_make(w % 65536, tr_att(w), tr_stopped(w), tr_skip(w), tr_sig(w), data % 256 + data / 0x100000 % 2 * 256 + tr_opt(w) / 512 * 512));
    return 0;
  }
  if req == PTRACE_INTERRUPT && state(k.procs, p) != ZOMBIE {
    // Stops a running tracee with an event stop (SIGTRAP and
    // PTRACE_EVENT_STOP in the status); one that is stopped already stays so.
    if state(k.procs, p) != STOPPED {
      tr2_put(&mut k, p, tr2_get(k, p) % TS_EV + EV_STOP * TS_EV);
      post_from(&mut k, p, 5, pid);
    }
    return 0;
  }
  if !pt_ready(k, pid, p) {
    return ESRCH;                           // it must be stopped
  }
  if req == PTRACE_PEEKTEXT || req == PTRACE_PEEKDATA || req == PTRACE_PEEKUSER {
    return pt_peek(&mut k, pid, p, req, addr, data);
  }
  if req == PTRACE_POKETEXT || req == PTRACE_POKEDATA || req == PTRACE_POKEUSER {
    return pt_poke(&mut k, p, req, addr, data);
  }
  if PT_USER_API == 1 && req == PTRACE_GETREGS {
    return pt_getregs(&mut k, pid, p, data, USER_REGS_SIZE);
  }
  if PT_USER_API == 1 && req == PTRACE_SETREGS {
    return pt_setregs(&mut k, pid, p, data, USER_REGS_SIZE);
  }
  if req == PTRACE_GETFPREGS || req == PTRACE_SETFPREGS {
    return pt_fpregs(&mut k, pid, p, data, req == PTRACE_SETFPREGS);
  }
  if req == PTRACE_GETREGSET || req == PTRACE_SETREGSET {
    return pt_regset(&mut k, pid, p, req == PTRACE_SETREGSET, addr, data);
  }
  if req == PTRACE_CONT || req == PTRACE_DETACH || req == PTRACE_SYSCALL || req == PTRACE_SINGLESTEP {
    if data > NSIG {
      return EIO;
    }
    pt_resume(&mut k, p, data, req == PTRACE_DETACH, req == PTRACE_SYSCALL, req == PTRACE_SINGLESTEP);
    return 0;
  }
  if req == PTRACE_KILL {
    post_from(&mut k, p, SIGKILL, pid);
    return 0;
  }
  if req == PTRACE_LISTEN {
    // Only a seized tracee: it is restarted, but kept from running, as by a
    // stop signal; SIGCONT ends the stop with an event stop (post_sig).
    let w = tr_get(k, p);
    if tr_opt(w) / 512 % 2 == 0 {
      return EIO;
    }
    tr_put(&mut k, p, tr_make(w % 65536, tr_att(w), 0, 0, 0, tr_opt(w)));
    tr2_put(&mut k, p, tr2_get(k, p) % TS_EV + TS_LISTEN);
    return 0;
  }
  if req == PTRACE_GET_SYSCALL_INFO {
    // struct ptrace_syscall_info: op, arch, ip, sp, then entry (nr, six
    // arguments), exit (result, is_error) or seccomp (nr, arguments,
    // ret_data). The result is the size the stop needs; at most addr bytes
    // are copied. Not at a system call stop it is op 0 and the header only.
    let t2 = tr2_get(k, p);
    let mut op = 0;
    let mut size = 24;
    if t2 / TS_EXIT % 2 == 1 {
      op = 2;
      size = 33;
    } else if t2 / TS_ENTRY % 2 == 1 && t2 / TS_SECC % 2 == 1 {
      op = 3;
      size = 84;
    } else if t2 / TS_ENTRY % 2 == 1 {
      op = 1;
      size = 80;
    }
    lx_fill(&mut k, 0, 88);
    xfer_u64(&mut k.fs.xfer, 0, op + PT_AUDIT_ARCH * 0x100000000);
    xfer_u64(&mut k.fs.xfer, 8, ur_read(k, p, UR_IP));
    xfer_u64(&mut k.fs.xfer, 16, ur_read(k, p, UR_SP));
    if op == 0 {
      size = 24;
    } else if op == 2 {
      let r = ur_read(k, p, UR_RET);
      xfer_u64(&mut k.fs.xfer, 24, r);
      if r >= 0xFFFFFFFFFFFFF001 {
        xfer_u64(&mut k.fs.xfer, 32, 1);        // is_error: -4095 .. -1
      }
    } else {
      let mut nr = t2 / TS_NR % 1024;
      if UR_NUM < USER_REGS {
        nr = ur_read(k, p, UR_NUM);          // the number as the process gave it
      }
      xfer_u64(&mut k.fs.xfer, 24, nr);
      let mut i = 0;
      while i < 6
        invariant i <= 6 && kok(k)
      {
        xfer_u64(&mut k.fs.xfer, 32 + i * 8, ur_read(k, p, ur_arg(i)));
        i = i + 1;
      }
      if op == 3 {
        xfer_u64(&mut k.fs.xfer, 80, t2 / TS_MSG % 65536);
      }
    }
    let mut n = size;
    if addr < n {
      n = addr;
    }
    if n > 0 {
      let e = lx_put_out(&mut k, pid, data, n);
      if e != 0 {
        return e;
      }
    }
    return size;
  }
  if req == PTRACE_GETEVENTMSG {
    xfer_u64(&mut k.fs.xfer, 0, tr2_get(k, p) / TS_MSG % 65536);
    return lx_put_out(&mut k, pid, data, 8);
  }
  if req == PTRACE_GETSIGINFO {
    // The signal that stopped it, and for a SIGTRAP why: a single step
    // (TRAP_TRACE), an event (PTRACE_EVENT in the second byte), else the
    // trap of a breakpoint instruction (SI_KERNEL), which a debugger tells
    // from the trap of an exec. Any other signal is from a user process
    // (SI_USER).
    lx_fill(&mut k, 0, 128);
    let sig = tr_sig(tr_get(k, p));
    let t2 = tr2_get(k, p);
    let mut code = 0;
    if sig == 5 {
      let mut ev = t2 / TS_EV % 16;
      if (t2 / TS_ENTRY % 2 == 1 || t2 / TS_EXIT % 2 == 1) && t2 / TS_SECC % 2 == 0 {
        ev = 0;
      }
      if ev == EV_STOP {
        ev = 128;
      }
      if ev != 0 {
        code = 5 + ev * 256;
      } else if t2 / TS_TRAP % 2 == 1 {
        code = 2;                             // TRAP_TRACE
      } else if t2 / TS_BRK % 2 == 1 {
        code = 0x80;                          // SI_KERNEL
      }
    }
    xfer_u64(&mut k.fs.xfer, 0, sig);
    xfer_u64(&mut k.fs.xfer, 8, code);
    if sig != 5 && 1 <= sig && sig <= NSIG {
      // The siginfo the signal was sent with: its sender, SI_TKILL, the
      // address of a fault, a queued value (the word of src/lxsig.bastio).
      info_from(&mut k.fs.xfer, 0, wget(k.sigsave, sender_at(p, sig)), wget(k.sigsave, value_at(p, sig)));
    }
    return lx_put_out(&mut k, pid, data, 128);
  }
  if req == PTRACE_SETSIGINFO {
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, data, &mut k.fs.xfer, 128) != 128 {
      return EFAULT;
    }
    return 0;                               // read, and not kept
  }
  return EIO;
}

fn lx_ptrace_call(k: &mut Kernel, pid: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let r = lx_ptrace(&mut k, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10));
  ret(&mut k.procs, pid, r);
  if pget(k.procs, pid, F_SIGPEND) & !pget(k.procs, pid, F_SIGMASK) != 0 {
    return SWITCH;
  }
  return KEEP;
}
