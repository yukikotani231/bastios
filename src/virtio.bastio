// A virtio block device (legacy PCI interface, virtio 0.9.5 / the "legacy"
// sections of virtio 1.x), driven by polling. Its registers are I/O ports in
// the device's BAR 0; requests travel through one virtqueue in memory the
// device reads and writes on its own (DMA).
//
// Every page the device can touch is a `Dma`: lent to the device when the
// driver starts and taken back only after the device has been reset at power
// off, so the proof shows none of them is freed, mapped into a process or
// reused while the device may still write it. Every access to them is
// volatile and proved inside the page. The device's own behaviour (that it
// writes only the buffers it is given, and stops when reset) is trusted.
//
// Memory, four pages:
//   r0..r2  the virtqueue, which must be physically contiguous: descriptor
//           table at 0, available ring at `avail`, used ring at `used`
//   req     one request: header at 0 (16 bytes), status byte at 16, the
//           sector's data at 512

const VIRTIO_VENDOR: u64 = 0x1AF4;
const VIRTIO_BLK: u64 = 0x1001;       // legacy (transitional) block device id

// Legacy registers, as offsets from BAR 0 (no MSI-X, so the device's
// configuration starts at 0x14).
const VIO_HOST_FEATURES: u64 = 0x00;
const VIO_GUEST_FEATURES: u64 = 0x04;
const VIO_QUEUE_PFN: u64 = 0x08;      // physical page number of the queue
const VIO_QUEUE_SIZE: u64 = 0x0C;
const VIO_QUEUE_SEL: u64 = 0x0E;
const VIO_QUEUE_NOTIFY: u64 = 0x10;
const VIO_STATUS: u64 = 0x12;
const VIO_CAPACITY: u64 = 0x14;       // 64 bits: the size in 512-byte sectors
const VIO_PORTS: u64 = 32;

const VIO_ACK: u64 = 1;
const VIO_DRIVER: u64 = 2;
const VIO_DRIVER_OK: u64 = 4;

const DESC_NEXT: u64 = 1;
const DESC_WRITE: u64 = 2;            // the device writes this buffer
const AVAIL_NO_INTERRUPT: u64 = 1;    // we poll

const BLK_IN: u64 = 0;                // read
const BLK_OUT: u64 = 1;               // write

const RING_BYTES: u64 = 12288;        // r0, r1, r2
const REQ_STATUS: u64 = 16;
const REQ_DATA: u64 = 512;
const VIO_SECTOR: u64 = 512;
const VIO_SPINS: u64 = 1000000;
const ADDR_LIMIT: u64 = 0x100000000;  // legacy queues take a 32-bit page number

struct Virtio {
  io: PortIo,
  r0: Dma,
  r1: Dma,
  r2: Dma,
  req: Dma,
  n: u64,             // queue size
  avail: u64,         // offsets into the queue
  used: u64,
  idx: u64,           // our next available-ring index (mod 2^16)
  sectors: u64,       // 0 when the device could not be started
}

spec fn virtio_ok(v: &Virtio) -> bool {
  port_count(v.io) == VIO_PORTS && v.n >= 3 && v.n <= 256
  && v.avail % 2 == 0 && v.avail + 6 + 2 * v.n <= v.used
  && v.used % 4 == 0 && v.used + 6 + 8 * v.n <= RING_BYTES
  && v.idx <= 65535
}

// ---------------------------------------------------------------- the queue
// The queue spans three pages; these pick the page an offset falls in.

fn ring_w16(v: &mut Virtio, off: u64, x: u64)
  requires off + 2 <= RING_BYTES && off % 2 == 0 && x <= 65535
{
  if off < 4096 {
    dma_write16(&mut v.r0, off, x);
  } else if off < 8192 {
    dma_write16(&mut v.r1, off - 4096, x);
  } else {
    dma_write16(&mut v.r2, off - 8192, x);
  }
}

fn ring_r16(v: &mut Virtio, off: u64) -> u64
  requires off + 2 <= RING_BYTES && off % 2 == 0
  ensures result <= 65535
{
  if off < 4096 {
    return dma_read16(&mut v.r0, off);
  } else if off < 8192 {
    return dma_read16(&mut v.r1, off - 4096);
  }
  return dma_read16(&mut v.r2, off - 8192);
}

/// Descriptor `i` (of the three the driver uses): buffer address, length,
/// flags and the next descriptor in the chain. The table is in r0.
fn put_desc(v: &mut Virtio, i: u64, addr: u64, size: u64, flags: u64, next: u64)
  requires i < 3 && size <= 4294967295 && flags <= 65535 && next <= 65535
{
  dma_write64(&mut v.r0, i * 16, addr);
  dma_write32(&mut v.r0, i * 16 + 8, size);
  dma_write16(&mut v.r0, i * 16 + 12, flags);
  dma_write16(&mut v.r0, i * 16 + 14, next);
}

// ---------------------------------------------------------------- the device

/// Claims the device's ports, lends it four pages and starts it. A device
/// that cannot be started (bad queue size, pages out of its reach) is left
/// with `sectors` 0, and every later operation on it fails.
fn virtio_new(ports: &mut Ports, base: u64, f0: Frame, f1: Frame, f2: Frame, f3: Frame) -> Virtio
  requires base + VIO_PORTS <= 65536
  requires forall k: u64 :: base <= k && k < base + VIO_PORTS ==> port_free(ports, k)
  ensures virtio_ok(result)
{
  let mut v = Virtio {
    io: port_claim(&mut ports, base, VIO_PORTS),
    r0: dma_lend(f0), r1: dma_lend(f1), r2: dma_lend(f2), req: dma_lend(f3),
    n: 3, avail: 48, used: 4096, idx: 0, sectors: 0,
  };
  pio_out8(&mut v.io, VIO_STATUS, 0);                     // reset
  pio_out8(&mut v.io, VIO_STATUS, VIO_ACK);
  pio_out8(&mut v.io, VIO_STATUS, VIO_ACK + VIO_DRIVER);
  let offered = pio_in32(&mut v.io, VIO_HOST_FEATURES);
  pio_out32(&mut v.io, VIO_GUEST_FEATURES, 0);            // none of them
  pio_out16(&mut v.io, VIO_QUEUE_SEL, 0);
  let n = pio_in16(&mut v.io, VIO_QUEUE_SIZE);
  // The queue must be physically contiguous and reachable with a 32-bit
  // page number; pages taken in a row from the pool are, but check.
  let q = dma_addr(v.r0);
  let r = dma_addr(v.req);
  if offered == 0xFFFFFFFF || n < 3 || n > 256 || q % 4096 != 0 || q > ADDR_LIMIT - RING_BYTES
    || r > ADDR_LIMIT - 4096 || dma_addr(v.r1) != q + 4096 || dma_addr(v.r2) != q + 8192 {
    pio_out8(&mut v.io, VIO_STATUS, 0);
    return v;
  }
  // The legacy layout: descriptors, then the available ring, then the used
  // ring on the next page boundary.
  v.n = n;
  v.avail = 16 * n;
  v.used = (18 * n + 6 + 4095) / 4096 * 4096;
  // Every request is the same chain: header -> data -> status.
  put_desc(&mut v, 0, r, 16, DESC_NEXT, 1);
  put_desc(&mut v, 1, r + REQ_DATA, VIO_SECTOR, DESC_NEXT, 2);
  put_desc(&mut v, 2, r + REQ_STATUS, 1, DESC_WRITE, 0);
  ring_w16(&mut v, v.avail, AVAIL_NO_INTERRUPT);
  pio_out32(&mut v.io, VIO_QUEUE_PFN, q / 4096);
  pio_out8(&mut v.io, VIO_STATUS, VIO_ACK + VIO_DRIVER + VIO_DRIVER_OK);
  let lo = pio_in32(&mut v.io, VIO_CAPACITY);
  let hi = pio_in32(&mut v.io, VIO_CAPACITY + 4);
  v.sectors = lo + hi * 4294967296;
  return v;
}

/// Resets the device, so it stops using the pages, takes them back into
/// the allocator and gives the ports back (at power off).
fn virtio_free(ports: &mut Ports, v: Virtio, m: &mut Mem)
  requires virtio_ok(v) && mem_ok(m)
  ensures mem_ok(m)
{
  let mut d = v;
  pio_out8(&mut d.io, VIO_STATUS, 0);
  pio_out32(&mut d.io, VIO_QUEUE_PFN, 0);
  give_page(&mut m, dma_take(d.r0));
  give_page(&mut m, dma_take(d.r1));
  give_page(&mut m, dma_take(d.r2));
  give_page(&mut m, dma_take(d.req));
  port_release(&mut ports, d.io);
}

/// Sends the request set up in `req` and waits for the device to finish it.
fn virtio_submit(v: &mut Virtio, data_flags: u64) -> bool
  requires virtio_ok(v) && data_flags <= 65535
  ensures virtio_ok(v) && v.sectors == old(v.sectors)
{
  dma_write8(&mut v.req, REQ_STATUS, 255);
  dma_write16(&mut v.r0, 16 + 12, data_flags);            // descriptor 1's flags
  ring_w16(&mut v, v.avail + 4 + 2 * (v.idx % v.n), 0);   // the chain starts at 0
  v.idx = (v.idx + 1) % 65536;
  ring_w16(&mut v, v.avail + 2, v.idx);                   // publish it
  pio_out16(&mut v.io, VIO_QUEUE_NOTIFY, 0);
  let mut spins = 0;
  while spins < VIO_SPINS && ring_r16(&mut v, v.used + 2) != v.idx
    invariant virtio_ok(v)
  {
    spins = spins + 1;
  }
  return spins < VIO_SPINS && dma_read8(&mut v.req, REQ_STATUS) == 0;
}

/// Writes the request header for sector `lba`.
fn virtio_header(v: &mut Virtio, kind: u64, lba: u64)
  requires kind <= 1
{
  dma_write32(&mut v.req, 0, kind);
  dma_write32(&mut v.req, 4, 0);
  dma_write64(&mut v.req, 8, lba);
}

/// Reads sector `lba` into buf[0..512]. Returns false if the device fails
/// or the sector is past its end.
fn virtio_read(v: &mut Virtio, lba: u64, buf: &mut Bytes) -> bool
  requires virtio_ok(v) && blen(buf) >= VIO_SECTOR
  ensures virtio_ok(v) && v.sectors == old(v.sectors) && blen(buf) == old(blen(buf))
{
  if lba >= v.sectors {
    return false;
  }
  virtio_header(&mut v, BLK_IN, lba);
  if !virtio_submit(&mut v, DESC_NEXT + DESC_WRITE) {
    return false;
  }
  let l = blen(buf);
  let mut i = 0;
  while i < VIO_SECTOR
    invariant i <= VIO_SECTOR && virtio_ok(v) && blen(buf) == l && l >= VIO_SECTOR
  {
    bset(&mut buf, i, dma_read8(&mut v.req, REQ_DATA + i));
    i = i + 1;
  }
  return true;
}

/// Writes buf[0..512] to sector `lba` and waits until the device has it.
fn virtio_write(v: &mut Virtio, lba: u64, buf: &Bytes) -> bool
  requires virtio_ok(v) && blen(buf) >= VIO_SECTOR
  ensures virtio_ok(v) && v.sectors == old(v.sectors)
{
  if lba >= v.sectors {
    return false;
  }
  let mut i = 0;
  while i < VIO_SECTOR
    invariant i <= VIO_SECTOR && virtio_ok(v)
  {
    dma_write8(&mut v.req, REQ_DATA + i, bget(buf, i));
    i = i + 1;
  }
  virtio_header(&mut v, BLK_OUT, lba);
  return virtio_submit(&mut v, DESC_NEXT);
}
