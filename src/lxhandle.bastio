// name_to_handle_at and open_by_handle_at: a file handle names a file or
// directory of the file layer by its handle (the number vfs_lookup and
// vfs_dir_lookup give, which stays the same through renames), so it can
// be opened again later without its path.
//
// struct file_handle { u32 handle_bytes; i32 handle_type; u8 f_handle[]; }:
// type 1 carries the handle in 8 bytes. /proc and the other generated
// files have no handle to export (EOPNOTSUPP), except with AT_HANDLE_FID,
// whose handles only identify (type 0xF1, never opened: ESTALE).
//
// Not done as on Linux: a handle has no generation number, so after its
// file is removed and the handle reused by a new file, the old handle
// opens the new file instead of failing with ESTALE. The mount id is 1
// for every file.

const LX_NAME_TO_HANDLE_AT: u64 = 303;
const LX_OPEN_BY_HANDLE_AT: u64 = 304;
const EOVERFLOW: u64 = 18446744073709551541;  // 2^64 - 75
const ESTALE: u64 = 18446744073709551500;     // 2^64 - 116
const MAX_HANDLE_SZ: u64 = 128;
const FH_BYTES: u64 = 8;                      // what a handle here needs
const FH_FILE: u64 = 1;                       // type: a file layer handle
const FH_FID: u64 = 0xF1;                     // type: an AT_HANDLE_FID handle of a generated file
const AT_HANDLE_FID: u64 = 0x200;
const AT_HANDLE_MNT_ID_UNIQUE: u64 = 1;
const AT_HANDLE_CONNECTABLE: u64 = 2;
const CAP_DAC_READ_SEARCH: u64 = 2;

fn is_handle_call(n: u64) -> bool {
  return n == LX_NAME_TO_HANDLE_AT || n == LX_OPEN_BY_HANDLE_AT;
}

/// The file layer handle of the name in the first n bytes of the transfer
/// buffer (a file, a link or a directory), or NO_FILE.
fn handle_of(k: &mut Kernel, n: u64) -> u64
  requires kok(k) && n <= FNAME_MAX
  ensures kok(k)
{
  let f = vfs_lookup(&mut k.fs, n);
  if f != NO_FILE {
    return f;
  }
  if proc_file(k.procs, k.fs.xfer, n) != 0 || proc_dir(k.procs, k.fs.xfer, n) != NO_FILE || dev_at(k.fs.xfer, n) != DEV_NONE {
    return NO_FILE;                         // generated: nothing to find again
  }
  return vfs_dir_lookup(&mut k.fs, n);
}

/// name_to_handle_at(dirfd, path, handle, mount_id, flags).
fn lx_name_to_handle(k: &mut Kernel, pid: u64, dirfd: u64, path: u64, fh: u64, mnt: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let fl = flags % 0x100000000;
  if fl & !(AT_SYMLINK_FOLLOW | AT_EMPTY_PATH | AT_HANDLE_FID | AT_HANDLE_MNT_ID_UNIQUE | AT_HANDLE_CONNECTABLE) != 0 {
    return EINVAL;
  }
  if fl & AT_HANDLE_CONNECTABLE != 0 && fl & AT_HANDLE_FID != 0 {
    return EINVAL;                          // a FID is never connectable
  }
  // The name: dirfd itself for "" with AT_EMPTY_PATH, else the path.
  let mut f = NO_FILE;
  let mut generated = false;
  if fl & AT_EMPTY_PATH != 0 && user_empty(&mut k, pid, path) {
    if dirfd % 0x100000000 == AT_FDCWD {
      let cl = base_len(k, pid, OFD_N);
      let mut i = 0;
      while i < cl
        invariant i <= cl && cl <= FNAME_MAX && kok(k) && pid < NPROC
      {
        bset(&mut k.fs.xfer, i, base_byte(k, pid, OFD_N, i));
        i = i + 1;
      }
      f = handle_of(&mut k, cl);
      generated = f == NO_FILE;
    } else {
      let d = fd_look(k, pid, dirfd);
      if d.kind == K_BAD {
        return EBADF;
      }
      if d.kind == K_FILE {
        f = vfs_row_file(k.fs, d.x);
      } else if d.kind == K_DIR {
        let h = dir_ofd(k, pid, dirfd);
        if h < OFD_N {
          let dl = base_len(k, pid, h);
          let mut i = 0;
          while i < dl
            invariant i <= dl && dl <= FNAME_MAX && kok(k) && pid < NPROC && h < OFD_N
          {
            bset(&mut k.fs.xfer, i, base_byte(k, pid, h, i));
            i = i + 1;
          }
          f = handle_of(&mut k, dl);
        }
      }
      generated = f == NO_FILE;
    }
  } else {
    let mut n = NO_RESULT;
    if fl & AT_SYMLINK_FOLLOW != 0 {
      n = lx_path_at(&mut k, pid, dirfd, path);
    } else {
      n = lx_path_at_nf(&mut k, pid, dirfd, path);
    }
    if n == NO_RESULT {
      return k.perr;
    }
    let pf = proc_file(k.procs, k.fs.xfer, n);
    f = handle_of(&mut k, n);
    if f == NO_FILE && pf == 0 && dir_at(&mut k, n) == NO_FILE && dev_at(k.fs.xfer, n) == DEV_NONE {
      return ENOENT;
    }
    generated = f == NO_FILE;
  }
  // The caller's struct: its size first.
  let hb = user_u32(&mut k, pid, fh);
  if !hb.ok {
    return EFAULT;
  }
  if hb.v > MAX_HANDLE_SZ {
    return EINVAL;
  }
  if generated && fl & AT_HANDLE_FID == 0 {
    return EOPNOTSUPP;                      // nothing to open it by again
  }
  let mut ty = FH_FILE;
  let mut v = f;
  if generated {
    ty = FH_FID;
    v = 0;
  }
  // The mount id first: put_user_u32 goes through the transfer buffer.
  if !put_user_u32(&mut k, pid, mnt, 1) {
    return EFAULT;
  }
  let mut e = 0;
  lx_fill(&mut k, 0, 8 + FH_BYTES);
  xfer_u64(&mut k.fs.xfer, 0, FH_BYTES + ty * 0x100000000);
  if hb.v < FH_BYTES {
    e = EOVERFLOW;                          // says how much room it needs, and nothing else
  } else {
    xfer_u64(&mut k.fs.xfer, 8, v);
  }
  let mut out = 8 + FH_BYTES;
  if e != 0 {
    out = 4;
  }
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, fh, k.fs.xfer, out) != out {
    return EFAULT;
  }
  return e;
}

/// open_by_handle_at(mount_fd, handle, flags): needs CAP_DAC_READ_SEARCH.
fn lx_open_by_handle(k: &mut Kernel, pid: u64, mfd: u64, fh: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if !cap_has(k, pid, CAP_DAC_READ_SEARCH) {
    return EPERM;
  }
  let mut other = false;
  if mfd % 0x100000000 != AT_FDCWD {
    let d = fd_look(k, pid, mfd);
    if d.kind == K_BAD {
      return EBADF;
    }
    other = d.kind != K_FILE && d.kind != K_DIR;   // on no file system of the file layer
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, fh, &mut k.fs.xfer, 8) != 8 {
    return EFAULT;
  }
  let hb = get_u64(k.fs.xfer, 0) % 0x100000000;
  let ty = get_u64(k.fs.xfer, 0) / 0x100000000;
  if hb == 0 || hb > MAX_HANDLE_SZ {
    return EINVAL;
  }
  if other || ty != FH_FILE || hb != FH_BYTES {
    return ESTALE;
  }
  if fh >= USER_BASE + USER_SIZE || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, fh + 8, &mut k.fs.xfer, 8) != 8 {
    return EFAULT;
  }
  let f = get_u64(k.fs.xfer, 0);
  // Its name now, from the handle.
  let mut n = NO_FILE;
  if f == VDIR_ROOT {
    n = 0;
  } else if f == VDIR_DISK {
    n = name_out(&mut k.fs.xfer, "disk");
  } else if f < HFILES {
    n = vfs_dirent(&mut k.fs, f);
  }
  if n == NO_FILE || n > FNAME_MAX || (n == 0 && f != VDIR_ROOT) {
    return ESTALE;                          // gone
  }
  let g = vfs_lookup(&mut k.fs, n);
  if g != NO_FILE && vfs_is_link(&mut k.fs, g) && flags & LO_PATH == 0 {
    return ELOOP;                           // a link is not followed from its handle
  }
  return lx_open_n(&mut k, pid, n, flags % 0x100000000, 0);
}

fn lx_handle_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64, d: u64, e: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_NAME_TO_HANDLE_AT {
    return lx_name_to_handle(&mut k, pid, a, b, c, d, e);
  }
  return lx_open_by_handle(&mut k, pid, a, b, c);
}
