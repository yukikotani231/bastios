// Linux scheduling priorities: getpriority/setpriority (and so nice), and
// the sched_* calls that set a policy or a CPU mask. The values are kept
// in each process's row (F_NICE, F_SCHED) and handed back, with Linux's
// checks and errors. The scheduler weighs a thread's nice value and
// SCHED_IDLE as Linux does (nice_tick, nice_debtor), runs a SCHED_FIFO or
// SCHED_RR thread before every thread of a lower priority (rt_pick), and
// runs a thread only on the processors its mask allows (aff_ok).
// ioprio_set and ioprio_get keep an I/O priority per thread (k.sys from
// SYS_IOP) the same way, with Linux 6.1's checks: the disk queue does not
// look at it.

const LX_GETPRIORITY: u64 = 140;
const LX_SETPRIORITY: u64 = 141;
const LX_SCHED_SETPARAM: u64 = 142;
const LX_SCHED_GETPARAM: u64 = 143;
const LX_SCHED_SETSCHEDULER: u64 = 144;
const LX_SCHED_GETSCHEDULER: u64 = 145;
const LX_SCHED_GET_PRIORITY_MAX: u64 = 146;
const LX_SCHED_GET_PRIORITY_MIN: u64 = 147;
const LX_SCHED_RR_GET_INTERVAL: u64 = 148;
const LX_SCHED_SETAFFINITY: u64 = 203;
const LX_SCHED_GETAFFINITY: u64 = 204;
const LX_SCHED_SETATTR: u64 = 314;
const LX_SCHED_GETATTR: u64 = 315;
const ATTR_VER0: u64 = 48;                  // struct sched_attr's first size
const ATTR_SIZE: u64 = 56;                  // and its size now
const SCHED_DEADLINE: u64 = 6;
const PRIO_PROCESS: u64 = 0;
const PRIO_PGRP: u64 = 1;
const PRIO_USER: u64 = 2;
const SCHED_FIFO: u64 = 1;
const SCHED_RR: u64 = 2;
const SCHED_BATCH: u64 = 3;
const SCHED_IDLE: u64 = 5;
const SCHED_RESET_ON_FORK: u64 = 0x40000000;
const RESET_KEPT: u64 = 0x10000;         // F_SCHED: SCHED_RESET_ON_FORK is set
const INT_SPAN: u64 = 0x100000000;          // an int argument's 32 bits
const LX_IOPRIO_SET: u64 = 251;
const LX_IOPRIO_GET: u64 = 252;
const IOPRIO_RT: u64 = 1;                   // classes, in bits 13-15
const IOPRIO_BE: u64 = 2;
const IOPRIO_IDLE: u64 = 3;
const IOPRIO_NORM: u64 = 0x4004;            // best effort, level 4: what "none" counts as

/// Process p's nice value plus 20: 0 (nice -20) to 39 (nice 19).
fn nice_of(procs: &Buf, p: u64) -> u64
  requires ptab_ok(procs) && p < NPROC
  ensures result < 40
{
  let w = pget(procs, p, F_NICE);
  if w == 0 || w > 40 {
    return 20;
  }
  return w - 1;
}

/// The nice value an int argument asks for, plus 20, clamped as Linux
/// clamps it to -20 .. 19.
fn nice_arg(a: u64) -> u64
  ensures result < 40
{
  let x = a % INT_SPAN;
  if x >= 0x80000000 {
    let m = INT_SPAN - x;                   // a negative value, -m
    if m >= 20 {
      return 0;
    }
    return 20 - m;
  }
  if x > 19 {
    return 39;
  }
  return x + 20;
}

/// Does process p (alive) match getpriority's (which, who)? who is
/// already resolved: a pid, a process group or a real user id.
fn prio_match(procs: &Buf, p: u64, which: u64, who: u64) -> bool
  requires ptab_ok(procs) && p < NPROC
{
  if state(procs, p) == FREE || state(procs, p) == ZOMBIE {
    return false;
  }
  if which == PRIO_PROCESS {
    return p == who;
  }
  if which == PRIO_PGRP {
    return pgid_of(procs, p) == who;
  }
  return id_get(procs, p, F_UID, false) == who;
}

/// who 0 resolved to the caller's own pid, group or real user.
fn prio_who(procs: &Buf, pid: u64, which: u64, who: u64) -> u64
  requires ptab_ok(procs) && pid < NPROC
{
  let w = who % INT_SPAN;
  if w != 0 {
    return w;
  }
  if which == PRIO_PROCESS {
    return pid;
  }
  if which == PRIO_PGRP {
    return pgid_of(procs, pid);
  }
  return id_get(procs, pid, F_UID, false);
}

/// getpriority: 20 - nice of the matching process with the lowest nice,
/// as the system call encodes it (1 .. 40).
fn lx_getpriority(k: &Kernel, pid: u64, which: u64, who: u64) -> u64
  requires kok(k) && pid < NPROC
{
  if which > PRIO_USER {
    return EINVAL;
  }
  let w = prio_who(k.procs, pid, which, who);
  let mut best = 40;
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && best <= 40
  {
    if prio_match(k.procs, p, which, w) {
      let n = nice_of(k.procs, p);
      if n < best {
        best = n;
      }
    }
    p = p + 1;
  }
  if best == 40 {
    return ESRCH;
  }
  return 40 - best;
}

/// setpriority: every matching process gets the nice value; lowering it
/// takes root (EACCES), and changing another user's process takes root or
/// a matching user (EPERM).
fn lx_setpriority(k: &mut Kernel, pid: u64, which: u64, who: u64, prio: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if which > PRIO_USER {
    return EINVAL;
  }
  let w = prio_who(k.procs, pid, which, who);
  let v = nice_arg(prio);
  let root = cap_has(k, pid, CAP_SYS_NICE);
  let euid = id_get(k.procs, pid, F_UID, true);
  let mut r = ESRCH;
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && kok(k)
  {
    if prio_match(k.procs, p, which, w) {
      if !root && id_get(k.procs, p, F_UID, false) != euid && id_get(k.procs, p, F_UID, true) != euid {
        r = EPERM;
      } else if !root && v < nice_of(k.procs, p) {
        r = EACCES;
      } else {
        pset(&mut k.procs, p, F_NICE, v + 1);
        if r == ESRCH {
          r = 0;
        }
      }
    }
    p = p + 1;
  }
  return r;
}

/// The process a sched_* call names: pid, or the caller for 0; NPROC
/// when the pid is negative (EINVAL) and NPROC + 1 when there is none.
fn sched_target(procs: &Buf, pid: u64, who: u64) -> u64
  requires ptab_ok(procs) && pid < NPROC
  ensures result <= NPROC + 1
{
  let w = who % INT_SPAN;
  if w >= 0x80000000 {
    return NPROC;
  }
  if w == 0 {
    return pid;
  }
  if w >= NPROC || state(procs, w) == FREE {
    return NPROC + 1;
  }
  return w;
}

/// May pid change process t's scheduling? Root may; anyone else only
/// when its effective user is t's real or effective user (else EPERM).
fn may_sched(procs: &Buf, pid: u64, t: u64) -> bool
  requires ptab_ok(procs) && pid < NPROC && t < NPROC
{
  if cred_root(procs, pid) {
    return true;
  }
  let euid = id_get(procs, pid, F_UID, true);
  return id_get(procs, t, F_UID, false) == euid || id_get(procs, t, F_UID, true) == euid;
}

fn rt_policy(policy: u64) -> bool {
  return policy == SCHED_FIFO || policy == SCHED_RR;
}

fn good_policy(policy: u64) -> bool {
  return policy == 0 || rt_policy(policy) || policy == SCHED_BATCH || policy == SCHED_IDLE;
}

/// sched_setscheduler (policy) or sched_setparam (keep is true): the
/// static priority read from param, checked against the policy.
fn sched_set(k: &mut Kernel, pid: u64, who: u64, policy: u64, param: u64, keep: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let t = sched_target(k.procs, pid, who);
  let mut pol = policy % INT_SPAN;
  let mut reset = 0;
  if !keep {
    if pol & SCHED_RESET_ON_FORK != 0 {
      reset = RESET_KEPT;
    }
    pol = pol & (0xFFFFFFFF - SCHED_RESET_ON_FORK);
    if !good_policy(pol) {
      return EINVAL;
    }
  }
  if t == NPROC || param == 0 {
    return EINVAL;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, param, &mut k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  let prio = get_u64(k.fs.xfer, 0) % INT_SPAN;
  if t > NPROC {
    return ESRCH;
  }
  if !may_sched(k.procs, pid, t) {
    return EPERM;
  }
  if keep {
    pol = pget(k.procs, t, F_SCHED) % 256;
    reset = pget(k.procs, t, F_SCHED) / RESET_KEPT % 2 * RESET_KEPT;
  }
  if rt_policy(pol) {
    if prio < 1 || prio > 99 {
      return EINVAL;
    }
    if !cap_has(k, pid, CAP_SYS_NICE) {
      return EPERM;
    }
  } else if prio != 0 {
    return EINVAL;
  }
  pset(&mut k.procs, t, F_SCHED, pol + 256 * prio + reset);
  sched_changed(&mut k, t);
  return 0;
}

/// sched_getscheduler (param 0) or sched_getparam (into param).
fn sched_get(k: &mut Kernel, pid: u64, who: u64, param: u64, want_param: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let t = sched_target(k.procs, pid, who);
  if t == NPROC || (want_param && param == 0) {
    return EINVAL;
  }
  if t > NPROC {
    return ESRCH;
  }
  let s = pget(k.procs, t, F_SCHED);
  if !want_param {
    return s % 256 + s / RESET_KEPT % 2 * SCHED_RESET_ON_FORK;
  }
  xfer_u64(&mut k.fs.xfer, 0, s / 256 % 256);
  return lx_put_out(&mut k, pid, param, 4);
}

/// sched_rr_get_interval: a 100 ms time slice for SCHED_RR, 0 otherwise.
fn sched_interval(k: &mut Kernel, pid: u64, who: u64, ts: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let t = sched_target(k.procs, pid, who);
  if t == NPROC {
    return EINVAL;
  }
  if t > NPROC {
    return ESRCH;
  }
  xfer_u64(&mut k.fs.xfer, 0, 0);
  let mut ns = 0;
  if pget(k.procs, t, F_SCHED) % 256 == SCHED_RR {
    ns = 100000000;
  }
  xfer_u64(&mut k.fs.xfer, 8, ns);
  return lx_put_out(&mut k, pid, ts, 16);
}

/// The processors Linux programs are told about: every one that runs (up
/// to the 64 one mask word holds), as a bit mask.
fn cpu_mask(k: &Kernel) -> u64
  requires kok(k)
{
  let c = smaller(k.cpus, 64);
  if c >= 64 {
    return 0xFFFFFFFFFFFFFFFF;
  }
  if c == 0 {
    return 1;
  }
  return (1 << c) - 1;
}

/// sched_setaffinity: any mask that names a processor Linux programs are
/// told about (sched_getaffinity) is accepted and kept for sched_getaffinity;
/// where a process runs is not restricted.
fn sched_affinity(k: &mut Kernel, pid: u64, who: u64, size: u64, mask: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let t = sched_target(k.procs, pid, who);
  if t == NPROC {
    return EINVAL;
  }
  if size == 0 {
    return EINVAL;
  }
  let want = smaller(size, 8);
  xfer_u64(&mut k.fs.xfer, 0, 0);
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, mask, &mut k.fs.xfer, want) != want {
    return EFAULT;
  }
  if t > NPROC {
    return ESRCH;
  }
  if get_u64(k.fs.xfer, 0) & cpu_mask(k) == 0 {
    return EINVAL;                          // no processor it may run on
  }
  if !may_sched(k.procs, pid, t) {
    return EPERM;
  }
  let m = get_u64(k.fs.xfer, 0) & cpu_mask(k);
  k.sys = set(k.sys, SYS_AFF + t, m);
  return 0;
}

/// The processor getcpu and /proc/PID/stat name for thread p: the one it
/// was last picked on (aff_ran).
fn aff_cpu(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures result < 64
{
  return get(k.sys, SYS_ONCPU + p) % 64;
}

/// May thread p run on processor `me` (its number, 0 for the bootstrap
/// one)? Yes unless its mask (sched_setaffinity) names some processor that
/// runs and not this one. A processor numbered past the mask word takes
/// any thread.
fn aff_ok(k: &Kernel, p: u64, me: u64) -> bool
  requires kok(k) && p < NPROC
{
  let m = get(k.sys, SYS_AFF + p) & cpu_mask(k);
  if m == 0 || me >= 64 {
    return true;
  }
  return (m >> me) % 2 == 1;
}

/// Thread p was picked to run on processor `me`.
fn aff_ran(k: &mut Kernel, p: u64, me: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  if me < 64 {
    k.sys = set(k.sys, SYS_ONCPU + p, me);
  }
}

// Nice values. A processor's ticks are shared among the threads that want
// it in proportion to their weights, as Linux shares its time: a nice-0
// thread weighs 1024 and each step of nice weighs 1.25 times less (nice 19
// about 15, nice -20 about 88761), and SCHED_IDLE weighs 3. A thread is
// charged, at each tick that finds it running its own code, 1024 * 1024 /
// weight (SLICE units: 1024 of them are a nice-0 thread's tick); the word
// at SYS_SLICE keeps what it was charged and not yet paid for. Once that
// reaches SLICE the thread pays it and gives the processor up (nice_tick),
// so a nice-0 thread runs a tick a turn, as before, and a thread that
// weighs more runs several. A thread that weighs less is left with a debt,
// which it pays one SLICE at a time by being passed over when the round
// robin comes to it (nice_debtor). A debtor that is the only thread a
// processor could run still runs (lx_pick), and a thread that waits in a
// call or sleeps owes nothing for it: only ticks charge.
const SLICE: u64 = 1024;

/// What a tick costs thread p, in SLICE units: SLICE * 1024 / its weight.
fn nice_cost(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures 0 < result && result <= 400000
{
  if pget(k.procs, p, F_SCHED) % 256 == SCHED_IDLE {
    return SLICE * 1024 / 3;
  }
  let n = nice_of(k.procs, p);
  // The weight, times 1024 (so that the steps keep their fractions).
  let mut w = 1048576;
  let mut i = 0;
  if n > 20 {
    while i < n - 20
      invariant i <= 19 && w <= 1048576
    {
      w = w * 4 / 5;
      i = i + 1;
    }
  } else {
    while i < 20 - n
      invariant i <= 20 && w <= 1048576 * 87 && w >= 1048576
    {
      w = w * 5 / 4;
      if w > 1048576 * 87 {
        w = 1048576 * 87;
      }
      i = i + 1;
    }
  }
  if w < 3000 {
    return 360000;                          // not reached: nice 19 leaves w near 15000
  }
  let c = SLICE * 1024 * 1024 / w;
  if c == 0 {
    return 1;
  }
  if c > 360000 {
    return 360000;
  }
  return c;
}

/// A tick found thread p running its own code: charges it. True if it
/// keeps the processor (it has paid for less than a SLICE).
fn nice_tick(k: &mut Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let owed = get(k.sys, SYS_SLICE + p);
  if owed == 0 && nice_of(k.procs, p) == 20 && pget(k.procs, p, F_SCHED) % 256 != SCHED_IDLE {
    return false;                           // nice 0: a tick a turn
  }
  let a = sat_add(owed, nice_cost(k, p));
  if a < SLICE {
    k.sys = set(k.sys, SYS_SLICE + p, a);
    return true;
  }
  k.sys = set(k.sys, SYS_SLICE + p, a - SLICE);
  return false;
}

/// The round robin came to READY thread p: if it owes a SLICE or more, it
/// pays one and is passed over (true).
fn nice_debtor(k: &mut Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let owed = get(k.sys, SYS_SLICE + p);
  if owed < SLICE {
    return false;
  }
  k.sys = set(k.sys, SYS_SLICE + p, owed - SLICE);
  return true;
}

// Real-time policies. A READY thread under SCHED_FIFO or SCHED_RR runs
// before any thread of a lower real-time priority and before every other
// thread (rt_pick, which lx_pick asks first); among threads of one
// priority the round robin goes on from where the processor left it. A
// SCHED_FIFO thread keeps its processor at the tick, so it runs until it
// blocks, yields, or a thread of a higher priority is ready; a SCHED_RR
// thread gives it up to the next one of its priority after RR_TICKS ticks
// (sched_rr_get_interval's 100 ms). A thread that a futex wake or the end
// of a sleep makes ready takes the processor of a lower one at once (the
// other processors get V_WAKE: rt_kick, rt_preempt_kick); any other at
// that processor's next tick (10 ms). A thread waiting in a call that it
// runs again each time it is picked (F_RESTART) has no priority until the
// call is done, unless it is a timed wait that is over (rt_ready). As Linux does by default (sched_rt_runtime_us 950000 of
// sched_rt_period_us 1000000), real-time threads get at most RT_SHARE
// ticks of each processor in each RT_PERIOD ticks: past that, other
// threads that are ready run first until the period ends (rt_throttled),
// so a real-time thread that spins cannot lock the shell out.
// SCHED_DEADLINE is kept and handed back but runs as SCHED_OTHER.
const RR_TICKS: u64 = 10;
const RT_PERIOD: u64 = 100;
const RT_SHARE: u64 = 95;

/// Thread p's real-time priority: 1 to 99 under SCHED_FIFO or SCHED_RR,
/// else 0.
fn rt_prio(procs: &Buf, p: u64) -> u64
  requires ptab_ok(procs) && p < NPROC
  ensures result < 100
{
  let s = pget(procs, p, F_SCHED);
  if !rt_policy(s % 256) {
    return 0;
  }
  let r = s / 256 % 256;
  if r > 99 {
    return 99;
  }
  return r;
}

/// Have the real-time threads used their share of processor `me` in this
/// period? (A processor numbered past SYS_RTUSE's 64 words is never held
/// back.) A period is RT_PERIOD of that processor's own ticks that found a
/// thread running its code, not of the bootstrap processor's: under an
/// emulator on a busy host one processor's ticks can come late or merge,
/// and a period of the other's would then end before the share was used,
/// so the other threads would never get their turn.
fn rt_throttled(k: &Kernel, me: u64) -> bool
  requires kok(k)
{
  if me >= 64 {
    return false;
  }
  return get(k.sys, SYS_RTUSE + me) >= RT_SHARE;
}

/// A tick on processor `me` found thread p running its own code: charges
/// it (its nice value, or the real-time share). True if it keeps the
/// processor.
fn sched_tick(k: &mut Kernel, p: u64, me: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let rt = rt_prio(k.procs, p) > 0;
  if me < 64 && get(k.sys, SYS_RTON) != 0 {
    let n = sat_add(get(k.sys, SYS_RTPER + me), 1);
    if n >= RT_PERIOD {
      k.sys = set(k.sys, SYS_RTPER + me, 0);
      k.sys = set(k.sys, SYS_RTUSE + me, 0);
    } else {
      k.sys = set(k.sys, SYS_RTPER + me, n);
    }
    if rt {
      k.sys = set(k.sys, SYS_RTUSE + me, sat_add(get(k.sys, SYS_RTUSE + me), 1));
    }
  }
  if !rt {
    return nice_tick(&mut k, p);
  }
  if pget(k.procs, p, F_SCHED) % 256 == SCHED_RR {
    let n = sat_add(get(k.sys, SYS_SLICE + p), 1);
    if n >= RR_TICKS {
      k.sys = set(k.sys, SYS_SLICE + p, 0);
      rt_requeue(&mut k, p);
      return false;
    }
    k.sys = set(k.sys, SYS_SLICE + p, n);
  }
  return true;
}

/// Thread t's policy or priority was just set: it starts afresh (no nice
/// debt, a whole SCHED_RR slice), and the scheduler starts looking for
/// real-time threads if t is one.
fn sched_changed(k: &mut Kernel, t: u64)
  requires kok(k) && t < NPROC
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_SLICE + t, 0);
  rt_requeue(&mut k, t);
  if rt_prio(k.procs, t) != 0 {
    k.sys = set(k.sys, SYS_RTON, 1);
  }
}

/// A real-time thread q was just made READY: the call that did it
/// interrupts the other processors (SYS_KICK, V_WAKE), so that one running
/// a thread of a lower priority, or idle, picks q now rather than at its
/// next tick, up to 10 ms later. One that has nothing better to run keeps
/// its thread (finish returns it, and lx_pick starts from it).
///
/// The first thread a call kicks for is the most urgent it woke (futex_wake
/// wakes in that order), and rt_preempt_kick is told so (the mark in
/// SYS_RTON): if the caller then blocks before an idle processor has taken
/// q, its next call would see q still READY and that processor still idle
/// and interrupt it again, and under QEMU the second interrupt reached it
/// just after it had taken q, holding q back while the caller's processor
/// ran the next thread (a woken reader took a rwlock before the writer
/// woken ahead of it).
fn rt_kick(k: &mut Kernel, q: u64)
  requires kok(k) && q < NPROC
  ensures kok(k)
{
  if get(k.sys, SYS_RTON) != 0 && rt_prio(k.procs, q) > 0 {
    if get(k.sys, SYS_KICK) == 0 {
      k.sys = set(k.sys, SYS_RTON, 2 + q + NPROC * (k.ticks % 0x100000000));
    }
    k.sys = set(k.sys, SYS_KICK, 1);
  }
}

/// Whether READY thread p would run its own code if picked, so that its
/// real-time priority counts: it is not in a call it runs again each time
/// (F_RESTART), or it is in a timed wait (F_RESTART is the deadline + 2)
/// whose deadline has passed, a sleep that is over, which its next try
/// ends. A reader of an empty pipe tries again until there is data and so
/// gets no priority until then (or it would keep the writer from running).
fn rt_ready(k: &Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
{
  if state(k.procs, p) != READY {
    return false;
  }
  let w = pget(k.procs, p, F_RESTART);
  return w == 0 || (w >= 2 && w - 2 <= k.ns);
}

/// Is there a READY real-time thread (other than `except`) that a
/// processor would take now if it looked: one it may run on that is idle,
/// or that runs a thread of a lower priority, and whose real-time share is
/// not used up? Only the most urgent such thread is weighed. A thread a
/// sleep's end, a pipe or a socket woke is found this way; the caller then
/// interrupts the other processors (V_WAKE) instead of leaving it for their
/// next tick. Processor `here` (the caller's; 64 or more for none) does not
/// count: the interrupt goes to the others, and it picks its next thread
/// itself. Counting it idle once its thread blocked sent the interrupt to
/// a processor that had already taken the head of the queue, and the
/// interrupt held that thread back while `here` ran the next one (a
/// writer woken with a reader lost the rwlock to it under QEMU).
fn rt_preempt_due(k: &Kernel, except: u64, here: u64) -> u64
  requires kok(k)
  ensures result < NPROC
{
  if get(k.sys, SYS_RTON) == 0 {
    return 0;
  }
  let cap = smaller(len(k.procs) / STRIDE, k.pid_hi);
  let mut q = 0;
  let mut qp = 0;
  let mut p = 1;
  while p < cap
    invariant 1 <= p && cap <= NPROC && q < NPROC && kok(k)
  {
    if p != except && rt_ready(k, p) {
      let r = rt_prio(k.procs, p);
      if r > qp {
        q = p;
        qp = r;
      }
    }
    p = p + 1;
  }
  if q == 0 {
    return 0;
  }
  // The processors that run a thread now; one whose thread q outranks.
  let mut busy = 0;
  if here < 64 {
    busy = 1 << here;
  }
  p = 1;
  while p < cap
    invariant 1 <= p && cap <= NPROC && q < NPROC && kok(k)
  {
    if state(k.procs, p) == RUNNING {
      let c = aff_cpu(k, p);
      busy = busy | (1 << c);
      if c != here && rt_prio(k.procs, p) < qp && aff_ok(k, q, c) && !rt_throttled(k, c) {
        return q;
      }
    }
    p = p + 1;
  }
  let mut c = 0;
  let n = smaller(k.cpus, 64);
  while c < n
    invariant c <= n && n <= 64 && q < NPROC && kok(k)
  {
    if (busy >> c) % 2 == 0 && aff_ok(k, q, c) && !rt_throttled(k, c) {
      return q;
    }
    c = c + 1;
  }
  return 0;
}

/// Should the caller send V_WAKE because of rt_preempt_due? At most once
/// per tick for the same thread (SYS_RTON keeps which, and when): a
/// thread the processors cannot take after all (its group's space is
/// lent, say) does not draw an interrupt from every call until the tick.
fn rt_preempt_kick(k: &mut Kernel, except: u64, here: u64) -> bool
  requires kok(k)
  ensures kok(k)
{
  let q = rt_preempt_due(k, except, here);
  if q == 0 {
    return false;
  }
  let mark = 2 + q + NPROC * (k.ticks % 0x100000000);
  if get(k.sys, SYS_RTON) == mark {
    return false;
  }
  k.sys = set(k.sys, SYS_RTON, mark);
  return true;
}

/// Where real-time thread p stands in the queue of its priority: the
/// stamp it got when it became ready (rt_pick hands them out in order),
/// stamping it now if it has none. A thread taken off its processor by
/// one of a higher priority keeps its stamp, so it goes on first (the
/// head of its queue, as on Linux); one that blocks, yields, or ends its
/// SCHED_RR slice loses it (rt_requeue) and goes to the tail.
fn rt_seq(k: &mut Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let s = get(k.sys, SYS_RTSEQ + p);
  if s != 0 {
    return s;
  }
  let n = sat_add(get(k.sys, SYS_RTSEQ + NPROC), 1);
  k.sys = set(k.sys, SYS_RTSEQ + NPROC, n);
  k.sys = set(k.sys, SYS_RTSEQ + p, n);
  return n;
}

/// Thread p begins a futex wait: it is stamped with the order waits
/// began in, so that waiters of one real-time priority are woken first in,
/// first out, as Linux's futex queues do (futex_rt_first).
fn futex_queued(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let n = sat_add(get(k.sys, SYS_FXSEQ + NPROC), 1);
  k.sys = set(k.sys, SYS_FXSEQ + NPROC, n);
  k.sys = set(k.sys, SYS_FXSEQ + p, n);
}

/// Thread p blocked, yielded or used up its SCHED_RR slice: it goes to the
/// tail of its priority's queue when it is next ready.
fn rt_requeue(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_RTSEQ + p, 0);
}

/// The READY real-time thread of the highest priority that may run on
/// processor `me`, the one at the head of that priority's queue (rt_seq),
/// or 0. (cap as in lx_pick; base is where the scan starts, which only
/// decides the order in which threads that became ready together are
/// stamped.)
fn rt_pick(k: &mut Kernel, base: u64, cap: u64, me: u64) -> u64
  requires kok(k) && base < cap && cap <= NPROC
  ensures kok(k) && result < NPROC
{
  let mut best = 0;
  let mut bp = 0;
  let mut bs = 0;
  let mut i = 0;
  while i < cap
    invariant i <= cap && base < cap && cap <= NPROC && bp < NPROC && kok(k)
  {
    let mut p = base + i;
    if p >= cap {
      p = p - cap;
    }
    // A thread that waits in a call is READY and runs the call again each
    // time it is picked (F_RESTART): it goes with the others, or a
    // real-time reader of an empty pipe would keep the writer from running.
    if p != 0 && rt_ready(k, p) {
      let r = rt_prio(k.procs, p);
      let mut q = 0;
      if r > 0 {
        q = rt_seq(&mut k, p);          // every ready one, so that the stamps keep the order they became ready in
      }
      if r > 0 && r >= best && aff_ok(k, p, me) && !cg_held(k, p) && group_free(&mut k, p) {
        if r > best || q < bs {
          best = r;
          bp = p;
          bs = q;
        }
      }
    }
    i = i + 1;
  }
  return bp;
}

/// Is a READY real-time thread that may run on processor `me` waiting
/// with a priority above running thread q's (and not held back by the
/// share, when q is not real-time)?
fn rt_above(k: &Kernel, q: u64, me: u64) -> bool
  requires kok(k) && q < NPROC
{
  if get(k.sys, SYS_RTON) == 0 {
    return false;
  }
  let mine = rt_prio(k.procs, q);
  if mine == 0 && rt_throttled(k, me) {
    return false;
  }
  let cap = smaller(len(k.procs) / STRIDE, k.pid_hi);
  let mut p = 1;
  while p < cap
    invariant 1 <= p && cap <= NPROC && kok(k)
  {
    if rt_ready(k, p) && rt_prio(k.procs, p) > mine && aff_ok(k, p, me) {
      return true;
    }
    p = p + 1;
  }
  return false;
}

/// Thread p left the processor: by itself (a call that blocked or yielded,
/// involuntary false) or because the tick took it away (true). Counted for
/// /proc/PID/status, getrusage and /proc/stat.
fn csw_count(k: &mut Kernel, p: u64, involuntary: bool)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let mut i = 2 * p;
  if involuntary {
    i = i + 1;
  }
  k.sys = set(k.sys, SYS_CSW + i, sat_add(get(k.sys, SYS_CSW + i), 1));
  k.sys = set(k.sys, SYS_CSWT, sat_add(get(k.sys, SYS_CSWT), 1));
}

/// Thread p's call n that just finished (its result in the return register) moved bytes with read or write: add
/// them to the characters it read or wrote and count the call
/// (/proc/PID/io). Calls that failed or blocked count nothing.
fn io_account(k: &mut Kernel, p: u64, n: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let r = pget(k.procs, p, reg_word(R_RET));
  if r >= 0x4000000000000000 {
    return;
  }
  let mut w = 4;
  if n == LX_READ || n == LX_PREAD64 || n == LX_READV || n == LX_PREADV || n == LX_PREADV2 {
    w = 0;
  } else if n == LX_WRITE || n == LX_PWRITE64 || n == LX_WRITEV || n == LX_PWRITEV || n == LX_PWRITEV2 {
    w = 1;
  }
  if w < 4 {
    k.sys = set(k.sys, SYS_IO + 4 * p + w, sat_add(get(k.sys, SYS_IO + 4 * p + w), r));
    k.sys = set(k.sys, SYS_IO + 4 * p + w + 2, sat_add(get(k.sys, SYS_IO + 4 * p + w + 2), 1));
  }
}

/// Thread p's i-th word of /proc/PID/io: 0 characters read, 1 written,
/// 2 read calls, 3 write calls.
fn io_get(k: &Kernel, p: u64, i: u64) -> u64
  requires kok(k) && p < NPROC && i < 4
{
  return get(k.sys, SYS_IO + 4 * p + i);
}

/// Thread p had a page fault (counted for perf_event_open, getrusage and /proc/PID/stat).
fn pf_count(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_PF + p, sat_add(get(k.sys, SYS_PF + p), 1));
}

/// The page faults thread p has had.
fn pf_get(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
{
  return get(k.sys, SYS_PF + p);
}

/// Thread p's count of voluntary (involuntary false) or involuntary switches.
fn csw_get(k: &Kernel, p: u64, involuntary: bool) -> u64
  requires kok(k) && p < NPROC
{
  let mut i = 2 * p;
  if involuntary {
    i = i + 1;
  }
  return get(k.sys, SYS_CSW + i);
}

/// sched_getaffinity: the processors the process was last confined to (sched_setaffinity), else every one that runs; the size must be a whole
/// number of 8-byte words, and the words past the first are zero.
fn get_affinity(k: &mut Kernel, pid: u64, who: u64, size: u64, mask: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let t = sched_target(k.procs, pid, who);
  if size < 8 || size % 8 != 0 {
    return EINVAL;
  }
  if t >= NPROC {
    return ESRCH;                           // none by that id; a negative id too, unlike the other sched calls
  }
  let mut m = get(k.sys, SYS_AFF + t) & cpu_mask(k);
  if m == 0 {
    m = cpu_mask(k);
  }
  xfer_u64(&mut k.fs.xfer, 0, m);
  let r = lx_put_out(&mut k, pid, mask, 8);
  if r != 0 {
    return r;
  }
  return 8;
}

/// Process p's SCHED_DEADLINE runtime (i 0), deadline (1) or period (2),
/// in ns; kept in k.sys from SYS_DL and only handed back.
fn dl_get(k: &Kernel, p: u64, i: u64) -> u64
  requires kok(k) && p < NPROC && i < 3
{
  return get(k.sys, SYS_DL + 3 * p + i);
}

fn dl_set(k: &mut Kernel, p: u64, i: u64, v: u64)
  requires kok(k) && p < NPROC && i < 3
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_DL + 3 * p + i, v);
}

/// A new process or thread c of p keeps its deadline parameters along with
/// its policy, unless p asked for SCHED_RESET_ON_FORK.
fn dl_fork(k: &mut Kernel, p: u64, c: u64)
  requires kok(k) && p < NPROC && c < NPROC
  ensures kok(k)
{
  dl_set(&mut k, c, 0, dl_get(k, p, 0));
  dl_set(&mut k, c, 1, dl_get(k, p, 1));
  dl_set(&mut k, c, 2, dl_get(k, p, 2));
  // SCHED_RESET_ON_FORK: the child starts as SCHED_OTHER, with no
  // priority and a nice value no lower than 0, and without the flag.
  let s = pget(k.procs, c, F_SCHED);
  if s / RESET_KEPT % 2 == 1 {
    if rt_policy(s % 256) || s % 256 == SCHED_DEADLINE {
      pset(&mut k.procs, c, F_SCHED, 0);
    } else {
      pset(&mut k.procs, c, F_SCHED, s % 256);
    }
    if nice_of(k.procs, c) < 20 {
      pset(&mut k.procs, c, F_NICE, 0);
    }
  }
}

/// sched_setattr with SCHED_DEADLINE for process t (runtime, deadline and
/// period from the struct in xfer): checked as Linux checks them and kept.
/// The scheduler does not honour them: no runtime is reserved.
fn sched_set_dl(k: &mut Kernel, pid: u64, t: u64) -> u64
  requires kok(k) && pid < NPROC && t < NPROC
  ensures kok(k)
{
  let run = get_u64(k.fs.xfer, 24);
  let dl = get_u64(k.fs.xfer, 32);
  let mut per = get_u64(k.fs.xfer, 40);
  if per == 0 {
    per = dl;
  }
  if dl == 0 || run < 1024 || run > dl || dl > per || per >= 0x8000000000000000 {
    return EINVAL;
  }
  if !may_sched(k.procs, pid, t) || !cap_has(k, pid, CAP_SYS_NICE) {
    return EPERM;
  }
  dl_set(&mut k, t, 0, run);
  dl_set(&mut k, t, 1, dl);
  dl_set(&mut k, t, 2, per);
  pset(&mut k.procs, t, F_SCHED, SCHED_DEADLINE);
  return 0;
}

/// sched_setattr(who, attr, flags) for the policies sched_setscheduler
/// knows, with the nice value for the normal ones, and SCHED_DEADLINE
/// (sched_set_dl).
fn sched_setattr(k: &mut Kernel, pid: u64, who: u64, attr: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let t = sched_target(k.procs, pid, who);
  if t == NPROC || attr == 0 || flags % INT_SPAN != 0 {
    return EINVAL;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, attr, &mut k.fs.xfer, 4) != 4 {
    return EFAULT;
  }
  let mut size = get_u64(k.fs.xfer, 0) % INT_SPAN;
  if size == 0 {
    size = ATTR_VER0;
  }
  if size < ATTR_VER0 {
    xfer_u64(&mut k.fs.xfer, 0, ATTR_SIZE);
    let w = lx_put_out(&mut k, pid, attr, 4);  // tells the caller the size known
    return E2BIG;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, attr, &mut k.fs.xfer, ATTR_VER0) != ATTR_VER0 {
    return EFAULT;
  }
  if t > NPROC {
    return ESRCH;
  }
  let pol = get_u64(k.fs.xfer, 0) / INT_SPAN;
  let sflags = get_u64(k.fs.xfer, 8);
  let nice = nice_arg(get_u64(k.fs.xfer, 16));
  let prio = get_u64(k.fs.xfer, 20) % INT_SPAN;
  if pol == SCHED_DEADLINE && sflags <= 1 {
    return sched_set_dl(&mut k, pid, t);
  }
  if !good_policy(pol) || sflags > 1 {
    return EINVAL;                          // SCHED_FLAG_RESET_ON_FORK only
  }
  if !may_sched(k.procs, pid, t) {
    return EPERM;
  }
  if rt_policy(pol) {
    if prio < 1 || prio > 99 {
      return EINVAL;
    }
    if !cap_has(k, pid, CAP_SYS_NICE) {
      return EPERM;
    }
  } else {
    if prio != 0 {
      return EINVAL;
    }
    if nice < nice_of(k.procs, t) && !cap_has(k, pid, CAP_SYS_NICE) {
      return EPERM;
    }
    pset(&mut k.procs, t, F_NICE, nice + 1);
  }
  pset(&mut k.procs, t, F_SCHED, pol + 256 * prio + sflags * RESET_KEPT);
  sched_changed(&mut k, t);
  return 0;
}

/// sched_getattr(who, attr, size, flags): the policy, priority and nice
/// value, in as much of struct sched_attr as size has room for.
fn sched_getattr(k: &mut Kernel, pid: u64, who: u64, attr: u64, size: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let t = sched_target(k.procs, pid, who);
  let sz = size % INT_SPAN;
  if t == NPROC || attr == 0 || flags % INT_SPAN != 0 || sz < ATTR_VER0 || sz > 4096 {
    return EINVAL;
  }
  if t > NPROC {
    return ESRCH;
  }
  let mut n = ATTR_SIZE;
  if sz < n {
    n = sz;
  }
  let s = pget(k.procs, t, F_SCHED);
  let v = nice_of(k.procs, t);
  let mut nice = 0;
  if v >= 20 {
    nice = v - 20;
  } else {
    nice = INT_SPAN - (20 - v);             // a negative int
  }
  xfer_zero(&mut k, ATTR_SIZE);
  xfer_u64(&mut k.fs.xfer, 0, n + s % 256 * INT_SPAN);
  xfer_u64(&mut k.fs.xfer, 8, s / RESET_KEPT % 2);     // sched_flags: SCHED_FLAG_RESET_ON_FORK
  xfer_u64(&mut k.fs.xfer, 16, nice + s / 256 % 256 * INT_SPAN);
  if s % 256 == SCHED_DEADLINE {
    xfer_u64(&mut k.fs.xfer, 16, 0);
    xfer_u64(&mut k.fs.xfer, 24, dl_get(k, t, 0));
    xfer_u64(&mut k.fs.xfer, 32, dl_get(k, t, 1));
    xfer_u64(&mut k.fs.xfer, 40, dl_get(k, t, 2));
  }
  return lx_put_out(&mut k, pid, attr, n);
}

/// ioprio_set(which, who, ioprio): which 1 a thread, 2 a process group,
/// 3 a user, as getpriority's plus one. Every match gets the priority.
fn lx_ioprio_set(k: &mut Kernel, pid: u64, which: u64, who: u64, ioprio: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let v = ioprio % 65536;                   // Linux keeps an unsigned short
  let class = v / 8192;
  let data = v % 8192;
  if class == 0 && data != 0 {
    return EINVAL;                          // "none" has no level
  }
  if class > IOPRIO_IDLE || ((class == IOPRIO_RT || class == IOPRIO_BE) && data >= 8) {
    return EINVAL;
  }
  if class == IOPRIO_RT && !cap_has(k, pid, CAP_SYS_NICE) && !cap_has(k, pid, CAP_SYS_ADMIN) {
    return EPERM;
  }
  let wh = which % INT_SPAN;
  if wh < 1 || wh > 3 {
    return EINVAL;
  }
  let w = prio_who(k.procs, pid, wh - 1, who);
  let nice = cap_has(k, pid, CAP_SYS_NICE);
  let mut r = ESRCH;
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && kok(k)
  {
    if prio_match(k.procs, p, wh - 1, w) {
      let uid = id_get(k.procs, p, F_UID, false);
      if !nice && uid != id_get(k.procs, pid, F_UID, true) && uid != id_get(k.procs, pid, F_UID, false) {
        r = EPERM;
      } else {
        k.sys = set(k.sys, SYS_IOP + p, v);
        if r == ESRCH {
          r = 0;
        }
      }
    }
    p = p + 1;
  }
  return r;
}

/// ioprio_get(which, who): the priority of the thread, or the highest
/// among a group's or a user's ("none" counting as best effort, level 4).
fn lx_ioprio_get(k: &Kernel, pid: u64, which: u64, who: u64) -> u64
  requires kok(k) && pid < NPROC
{
  let wh = which % INT_SPAN;
  if wh < 1 || wh > 3 {
    return EINVAL;
  }
  let w = prio_who(k.procs, pid, wh - 1, who);
  let mut r = ESRCH;
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC
  {
    if prio_match(k.procs, p, wh - 1, w) {
      let v = get(k.sys, SYS_IOP + p) % 65536;
      if r == ESRCH {
        r = v;
      } else {
        let mut a = r;
        let mut b = v;
        if a < 8192 {
          a = IOPRIO_NORM;
        }
        if b < 8192 {
          b = IOPRIO_NORM;
        }
        r = smaller(a, b);
      }
    }
    p = p + 1;
  }
  return r;
}

fn is_prio_call(n: u64) -> bool {
  return n == LX_IOPRIO_SET || n == LX_IOPRIO_GET || n == LX_GETPRIORITY || n == LX_SETPRIORITY || (LX_SCHED_SETPARAM <= n && n <= LX_SCHED_RR_GET_INTERVAL)
    || n == LX_SCHED_SETAFFINITY || n == LX_SCHED_GETAFFINITY || n == LX_SCHED_SETATTR || n == LX_SCHED_GETATTR;
}

fn lx_prio_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64, d: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_SCHED_SETATTR {
    return sched_setattr(&mut k, pid, a, b, c);
  }
  if n == LX_SCHED_GETATTR {
    return sched_getattr(&mut k, pid, a, b, c, d);
  }
  if n == LX_GETPRIORITY {
    return lx_getpriority(k, pid, a, b);
  }
  if n == LX_IOPRIO_SET {
    return lx_ioprio_set(&mut k, pid, a, b, c);
  }
  if n == LX_IOPRIO_GET {
    return lx_ioprio_get(k, pid, a, b);
  }
  if n == LX_SETPRIORITY {
    return lx_setpriority(&mut k, pid, a, b, c);
  }
  if n == LX_SCHED_SETPARAM {
    return sched_set(&mut k, pid, a, 0, b, true);
  }
  if n == LX_SCHED_SETSCHEDULER {
    return sched_set(&mut k, pid, a, b, c, false);
  }
  if n == LX_SCHED_GETPARAM {
    return sched_get(&mut k, pid, a, b, true);
  }
  if n == LX_SCHED_GETSCHEDULER {
    return sched_get(&mut k, pid, a, 0, false);
  }
  if n == LX_SCHED_RR_GET_INTERVAL {
    return sched_interval(&mut k, pid, a, b);
  }
  if n == LX_SCHED_SETAFFINITY {
    return sched_affinity(&mut k, pid, a, b, c);
  }
  if n == LX_SCHED_GETAFFINITY {
    return get_affinity(&mut k, pid, a, b, c);
  }
  let p = a % INT_SPAN;
  if p == SCHED_DEADLINE {
    return 0;
  }
  if !good_policy(p) {
    return EINVAL;
  }
  if rt_policy(p) {
    if n == LX_SCHED_GET_PRIORITY_MAX {
      return 99;
    }
    return 1;
  }
  return 0;
}
