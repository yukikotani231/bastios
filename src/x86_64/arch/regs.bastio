// The saved user registers of a process on x86-64: a row holds 21 words in
// `cpu_get` order (see R_* in src/proc.bastio) and the native system-call ABI
// passes the number in rax and arguments in rdi, rsi, rdx.

import "pages.bastio";

const EM_NATIVE: u64 = 62;       // the ELF machine of the programs it runs: EM_X86_64
const NREGS: u64 = 21;           // saved words, in `cpu_get` order
const REGS_EXT: u64 = 0;         // words a row holds past the usual 72 for registers beyond 21

const R_NUM: u64 = 0;            // the native system call number
const R_RET: u64 = 0;            // its result
const R_ARG0: u64 = 5;
const R_ARG1: u64 = 4;
const R_ARG2: u64 = 3;
const R_PC: u64 = 15;
const R_SP: u64 = 16;
const R_FAULT: u64 = 19;          // the faulting address (CR2; FAR_EL1)
const R_FLAGS: u64 = 17;
const R_TLS: u64 = 20;           // FS base
const NLOAD: u64 = 18;           // words cpu_set takes in order, before R_TLS
const FLAGS_INIT: u64 = 0x202;   // rflags of a new process: interrupts on

// What the Linux layer calls registers. Each is an offset from F_REGS into
// a process's row (see reg_word), not a `cpu_get` index: they are the same
// numbers on x86-64, where all 21 registers sit in the register block.
const R_RAX: u64 = 0;
const R_RDX: u64 = 3;            // Linux system call arguments 3, 2, 1, 6, 5, 4
const R_RSI: u64 = 4;
const R_RDI: u64 = 5;
const R_R8: u64 = 7;
const R_R9: u64 = 8;
const R_R10: u64 = 9;
const R_RIP: u64 = 15;
const R_RSP: u64 = 16;
const R_RFLAGS: u64 = 17;
const R_FSBASE: u64 = 20;
const R_CLONE_CTID: u64 = 9;     // clone(flags, stack, ptid, ctid, tls) on x86-64: r10 and r8
const R_CLONE_TLS: u64 = 7;
const R_LXNR: u64 = 0;           // the Linux call being made (or run again): rax, which the result then replaces
const RED_ZONE: u64 = 128;       // bytes below the stack pointer that user code may use without moving it
const SIGACT_SIZE: u64 = 32;     // the kernel's struct sigaction: handler, flags, restorer, mask
const SA_MASK_AT: u64 = 24;
const SA_RESTORER_AT: u64 = 16;  // where the restorer is; 0 if the structure has none
const RESTORER_REQUIRED: u64 = 1; // a handler needs the restorer the C library gives it
const EPOLL_EVENT: u64 = 12;     // struct epoll_event: packed on x86-64, u32 events then u64 data
const EPOLL_DATA_AT: u64 = 4;
const SYSCALL_LEN: u64 = 2;      // bytes of the instruction that traps into the kernel (`syscall`)

/// The x87/SSE state a Linux process starts with: control word 0x37F and
/// MXCSR 0x1F80 (every exception masked, round to nearest).
fn fpu_init(f: &mut Frame) {
  frame_write8(&mut f, 0, 0x7F);
  frame_write8(&mut f, 1, 0x03);
  frame_write8(&mut f, 24, 0x80);
  frame_write8(&mut f, 25, 0x1F);
}

/// What uname reports as the machine.
fn uname_machine() -> Str {
  return "x86_64";
}
