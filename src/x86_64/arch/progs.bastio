// The program images built into the kernel (the files under build/user,
// included at build time) and the vDSO page, on x86-64.

import "pages.bastio";
import "elf.bastio";
import "tsc.bastio";

fn prog_image(i: u64) -> Str {
  if i == 0 {
    return include_bytes("../../../build/user/sh.bin");
  }
  if i == 1 {
    return include_bytes("../../../build/user/hello.bin");
  }
  if i == 2 {
    return include_bytes("../../../build/user/spin.bin");
  }
  if i == 3 {
    return include_bytes("../../../build/user/true.bin");
  }
  if i == 4 {
    return include_bytes("../../../build/user/bench.bin");
  }
  if i == 5 {
    return include_bytes("../../../build/user/straddle.bin");
  }
  if i == 6 {
    return include_bytes("../../../build/user/elfexec.elf");
  }
  if i == 7 {
    return include_bytes("../../../build/user/elfpie.elf");
  }
  if i == 8 {
    return include_bytes("../../../build/user/elfbad.elf");
  }
  if i == 9 {
    return include_bytes("../../../build/user/fstest.bin");
  }
  if i == 10 {
    return include_bytes("../../../build/user/mhello.elf");
  }
  if i == 11 {
    return include_bytes("../../../build/user/fpucheck.elf");
  }
  if i == 12 {
    return include_bytes("../../../build/user/mtest.elf");
  }
  if i == 13 {
    return include_bytes("../../../build/user/ash.elf");
  }
  if i == 15 {
    return include_bytes("../../../build/user/mudp.elf");
  }
  if i == 16 {
    return include_bytes("../../../build/user/mtcp.elf");
  }
  if i == 17 {
    return include_bytes("../../../build/user/mtime.elf");
  }
  if i == 18 {
    return include_bytes("../../../build/user/crashme.bin");
  }
  if i == 19 {
    return include_bytes("../../../build/user/mdir.elf");
  }
  if i == 20 {
    return include_bytes("../../../build/user/mmisc.elf");
  }
  if i == 21 {
    return include_bytes("../../../build/user/mspawn.elf");
  }
  if i == 22 {
    return include_bytes("../../../build/user/sysfuzz.elf");
  }
  if i == 23 {
    return include_bytes("../../../build/user/mthread.elf");
  }
  if i == 24 {
    return include_bytes("../../../build/user/mdyn.elf");
  }
  if i == 25 {
    return include_bytes("../../../build/user/ld-musl.so");
  }
  if i == 26 {
    return include_bytes("../../../build/user/diskbench.bin");
  }
  if i == 27 {
    return include_bytes("../../../build/user/mkfs.elf");
  }
  if i == 28 {
    return include_bytes("../../../build/user/mtone.elf");
  }
  if i == 29 {
    return include_bytes("../../../build/user/mmouse.elf");
  }
  if i == 30 {
    return include_bytes("../../../build/user/mns.elf");
  }
  if i == 31 {
    return include_bytes("../../../build/user/mseccomp.elf");
  }
  if i == 32 {
    return include_bytes("../../../build/user/mcont.elf");
  }
  if i == 33 {
    return include_bytes("../../../build/user/mcloud.elf");
  }
  if i == 34 {
    return include_bytes("../../../build/user/mfd.elf");
  }
  if i == 35 {
    return include_bytes("../../../build/user/mproc.elf");
  }
  if i == 36 {
    return include_bytes("../../../build/user/mfb.elf");
  }
  if i == 37 {
    return include_bytes("../../../build/user/bwm.elf");
  }
  if i == 38 {
    return include_bytes("../../../build/user/bhello.elf");
  }
  return include_bytes("../../../build/user/fault.bin");
}

/// Whether the vDSO page holds an ELF image for AT_SYSINFO_EHDR to point at.
fn vdso_is_elf() -> bool {
  return true;
}

/// AT_HWCAP and AT_HWCAP2: empty on x86-64 (a C library reads CPUID itself).
fn hwcap() -> u64 {
  return 0;
}

fn hwcap2() -> u64 {
  return 0;
}

/// Fills the vDSO page: the image, then the clock it reads.
fn vdso_fill(f: &mut Frame, t: Tsc, epoch: u64) {
  copy_page(&mut f, include_bytes("../../../build/user/vdso.so"), 0);
  frame_write(&mut f, VDSO_DATA, t.mult);
  frame_write(&mut f, VDSO_DATA + 1, t.base);
  frame_write(&mut f, VDSO_DATA + 2, t.at);
  frame_write(&mut f, VDSO_DATA + 3, epoch);
}
