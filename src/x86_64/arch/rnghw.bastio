// Finding the virtio entropy source on x86-64 (src/virtio_rng.bastio): on
// PCI, or on virtio-mmio where the machine has no PCI (Firecracker, QEMU's
// microvm). It runs once, before any other driver looks for its device,
// and leaves every port, register and page as it found them.

import "pci.bastio";
import "virtio_rng.bastio";
import "virtio_mmio.bastio";
import "net.bastio";
import "blk.bastio";

/// The pages 0 .. 3 for `vrng_read`, with `io`.
fn rng_run(m: &mut Mem, io: Vt, out: &mut Buf) -> VRngRun
  requires mem_ok(m) && vt_ok(io) && len(out) == VRNG_WORDS
  requires get(m.bm, 0) == 1 && get(m.bm, 1) == 1 && get(m.bm, 2) == 1 && get(m.bm, 3) == 1
  ensures mem_ok(m) && len(out) == VRNG_WORDS && result.n <= VRNG_WORDS && vt_ok(result.io)
  ensures forall k: u64 :: vt_holds(result.io, k) == old(vt_holds(io, k))
  ensures forall a: u64 :: vt_claims(result.io, a) == old(vt_claims(io, a))
{
  let f0 = take_low_page(&mut m, 0);
  let f1 = take_low_page(&mut m, 1);
  let f2 = take_low_page(&mut m, 2);
  let f3 = take_low_page(&mut m, 3);
  return vrng_read(&mut m, io, f0, f1, f2, f3, &mut out);
}

/// Entropy from the machine's virtio-rng, if it has one: the first on PCI
/// whose ports lie clear of the ACPI registers at plo .. phi, else the
/// first on virtio-mmio clear of the framebuffer and the USB controller.
/// Returns how many words are in `out` (0 for none).
fn rng_hw(ports: &mut Ports, pci: &mut Pci, m: &mut Mem, win: &mut MmioSpace, plo: u64, phi: u64,
  fb_lo: u64, fb_hi: u64, usb_lo: u64, usb_hi: u64, vm: VmWhere, out: &mut Buf) -> u64
  requires vmw_ok(vm) && pci_ok(pci) && mem_ok(m) && len(out) == VRNG_WORDS
  requires forall k: u64 :: VIRTIO_PORTS_LO <= k && k < 65536 && !(plo <= k && k < phi) ==> port_free(ports, k)
  requires forall a: u64 :: bar_space(a) && !(fb_lo <= a && a < fb_hi) && !(usb_lo <= a && a < usb_hi) ==> mmio_free(win, a)
  ensures pci_ok(pci) && mem_ok(m) && len(out) == VRNG_WORDS && result <= VRNG_WORDS
  ensures forall k: u64 :: port_free(ports, k) == old(port_free(ports, k))
  ensures forall a: u64 :: bar_space(a) && !(fb_lo <= a && a < fb_hi) && !(usb_lo <= a && a < usb_hi) ==> mmio_free(win, a)
{
  let dev = pci_find(&mut pci, VIRTIO_VENDOR, VIRTIO_RNG);
  if dev < PCI_NONE {
    let base = pci_io_bar(&mut pci, dev);
    if base < VIRTIO_PORTS_LO || base + VIO_PORTS > 65536 || !(base + VIO_PORTS <= plo || base >= phi)
      || !pages_free(m, 0, VRNG_PAGES) {
      return 0;
    }
    pci_enable(&mut pci, dev);
    let r = rng_run(&mut m, Vt::Port(port_claim(&mut ports, base, VIO_PORTS)), &mut out);
    match r.io {
      Vt::Port(q) => {
        assert vt_holds(r.io, base);
        assert vt_holds(r.io, port_base(q));
        port_release(&mut ports, q);
      },
      Vt::Mem(d) => { unreachable; },
    }
    return r.n;
  }
  if pci_absent(&mut pci) && pages_free(m, 0, VRNG_PAGES) {
    match vm_find(&mut win, VM_ID_RNG, vm, fb_lo, fb_hi, usb_lo, usb_hi, 0, 0, 0, 0) {
      VmFound::Found(d) => {
        let r = rng_run(&mut m, Vt::Mem(d), &mut out);
        match r.io {
          Vt::Mem(e) => { mmio_release(&mut win, e.regs); },
          Vt::Port(q) => { unreachable; },
        }
        return r.n;
      },
      VmFound::None => {},
    }
  }
  return 0;
}
