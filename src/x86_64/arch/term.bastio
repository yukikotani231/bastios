// The x86-64 console devices: the 16550 serial port, the screen and the PS/2
// and USB keyboards.

import "uart.bastio";
import "fb.bastio";
import "kbd.bastio";
import "xhci.bastio";
import "console.bastio";
import "vbe.bastio";

struct Term { uart: Uart, screen: Screen, kbd: Kbd, usb: Usb, vbe: PortIo }
  invariant uart_ok(uart) && screen_ok(screen) && kbd_ok(kbd) && usb_ok(usb) && port_count(vbe) == VBE_PORTS;

spec fn term_ok(t: &Term) -> bool {
  uart_ok(t.uart) && screen_ok(t.screen) && kbd_ok(t.kbd) && usb_ok(t.usb) && port_count(t.vbe) == VBE_PORTS
}

fn term_write(t: &mut Term, b: u8)
  requires term_ok(t)
  ensures term_ok(t)
{
  uart_write(&mut t.uart, b);
  screen_put(&mut t.screen, b);
}

/// The next byte typed on the serial line or a keyboard, a PS/2 mouse
/// packet (MOUSE_PKT plus its bytes, src/kbd.bastio), or 256.
fn term_poll(t: &mut Term) -> u64
  requires term_ok(t)
  ensures term_ok(t) && (result <= 256 || (result >= MOUSE_PKT && result < 2 * MOUSE_PKT) || (result >= SER_PKT && result < SER_PKT + 256))
{
  let b = uart_poll(&mut t.uart);
  if b < 256 {
    return b;
  }
  let k = kbd_poll(&mut t.kbd);
  if k != 256 {
    return k;
  }
  return usb_poll(&mut t.usb);
}

/// SER_NONE, SER_FTDI or SER_ACM: is there a USB serial port?
fn term_ser(t: &Term) -> u64
  requires term_ok(t)
  ensures result <= SER_ACM
{
  return usb_ser(t.usb);
}

/// Sends the first n bytes of buf to the USB serial port, if there is one:
/// how many it took.
fn term_ser_send(t: &mut Term, buf: &Bytes, n: u64) -> u64
  requires term_ok(t)
  ensures term_ok(t) && result <= n && result <= blen(buf)
{
  return usb_ser_send(&mut t.usb, buf, n);
}

/// Writes everything waiting to the devices. For when one processor owns
/// both, at boot and at power off.
fn con_flush(t: &mut Term, c: &mut Con)
  requires term_ok(t) && con_ok(c)
  ensures term_ok(t) && con_ok(c)
{
  while !ring_empty(c.r)
    invariant term_ok(t) && con_ok(c)
  {
    term_write(&mut t, bget(c.out, ring_pop(&mut c.r)));
  }
}

/// Writes the first n bytes of buf to the devices.
fn term_send(t: &mut Term, buf: &Bytes, n: u64)
  requires term_ok(t)
  ensures term_ok(t)
{
  let mut i = 0;
  while i < n && i < blen(buf)
    invariant term_ok(t)
  {
    term_write(&mut t, bget(buf, i));
    i = i + 1;
  }
}

/// Whether the display is a Bochs one in the mode w by h (src/vbe.bastio),
/// so that `term_mode` may change it.
fn term_vbe(t: &mut Term, w: u64, h: u64) -> bool
  requires term_ok(t)
  ensures term_ok(t)
{
  return vbe_probe(&mut t.vbe, w, h);
}

/// Puts the display in the mode w by h.
fn term_mode(t: &mut Term, w: u64, h: u64)
  requires term_ok(t)
  ensures term_ok(t)
{
  vbe_set(&mut t.vbe, w, h);
}
