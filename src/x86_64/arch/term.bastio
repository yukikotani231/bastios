// The x86-64 console devices: the 16550 serial port, the screen and the PS/2
// and USB keyboards.

import "uart.bastio";
import "fb.bastio";
import "kbd.bastio";
import "xhci.bastio";

struct Term { uart: Uart, screen: Screen, kbd: Kbd, usb: Usb }
  invariant uart_ok(uart) && screen_ok(screen) && kbd_ok(kbd) && usb_ok(usb);

spec fn term_ok(t: &Term) -> bool {
  uart_ok(t.uart) && screen_ok(t.screen) && kbd_ok(t.kbd) && usb_ok(t.usb)
}

fn term_write(t: &mut Term, b: u8)
  requires term_ok(t)
  ensures term_ok(t)
{
  uart_write(&mut t.uart, b);
  screen_put(&mut t.screen, b);
}

/// The next byte typed on the serial line or a keyboard, a PS/2 mouse
/// packet (MOUSE_PKT plus its bytes, src/kbd.bastio), or 256.
fn term_poll(t: &mut Term) -> u64
  requires term_ok(t)
  ensures term_ok(t) && (result <= 256 || (result >= MOUSE_PKT && result < 2 * MOUSE_PKT))
{
  let b = uart_poll(&mut t.uart);
  if b < 256 {
    return b;
  }
  let k = kbd_poll(&mut t.kbd);
  if k != 256 {
    return k;
  }
  return usb_poll(&mut t.usb);
}

