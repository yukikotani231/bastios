// The network card under the IPv4 stack: virtio, e1000 or ENA. The stack sees
// only these calls.

import "virtio_net.bastio";
import "e1000.bastio";
import "ena.bastio";

enum Card { Virtio(VNet), E1000(E1k), Ena(Ena) }

spec fn card_ok(d: &Card) -> bool {
  (d is Card::Virtio ==> vnet_ok(d.Virtio)) && (d is Card::E1000 ==> e1k_ok(d.E1000)) && (d is Card::Ena ==> ena_ok(d.Ena))
}

fn card_mac(d: &Card) -> u64
  ensures result < 281474976710656
{
  match d {
    Card::Virtio(v) => { return v.mac % 281474976710656; },
    Card::E1000(e) => { return e.mac % 281474976710656; },
    Card::Ena(a) => { return a.mac % 281474976710656; },
  }
}

fn card_live(d: &Card) -> bool {
  match d {
    Card::Virtio(v) => { return v.live; },
    Card::E1000(e) => { return e.live; },
    Card::Ena(a) => { return a.live; },
  }
}

fn card_is_e1000(d: &Card) -> bool {
  return d is Card::E1000;
}

fn card_is_ena(d: &Card) -> bool {
  return d is Card::Ena;
}

/// Why an ENA that could not be started was given up on (ENA_ERR_*), else 0.
fn card_why(d: &Card) -> u64 {
  match d {
    Card::Ena(a) => { return a.why; },
    Card::Virtio(v) => { return 0; },
    Card::E1000(e) => { return 0; },
  }
}

/// True if received frames raise an interrupt rather than wait for a poll.
fn card_irq(d: &Card) -> bool {
  match d {
    Card::Virtio(v) => { return v.irq; },
    Card::E1000(e) => { return e.irq; },
    Card::Ena(a) => { return false; },
  }
}

/// An e1000's line is unmasked at the 8259 (see `e1k_irq_on`).
fn card_irq_on(d: &mut Card)
  requires card_ok(d)
  ensures card_ok(d)
{
  match d {
    Card::Virtio(v) => { d = Card::Virtio(v); },
    Card::E1000(mut e) => {
      e1k_irq_on(&mut e);
      d = Card::E1000(e);
    },
    Card::Ena(a) => { d = Card::Ena(a); },
  }
}

/// Whether received frames raise the card's interrupt (when it has one).
fn card_irq_set(d: &mut Card, on: bool)
  requires card_ok(d)
  ensures card_ok(d)
{
  match d {
    Card::Virtio(mut v) => {
      vnet_irq(&mut v, on);
      d = Card::Virtio(v);
    },
    Card::E1000(mut e) => {
      e1k_irq(&mut e, on);
      d = Card::E1000(e);
    },
    Card::Ena(a) => { d = Card::Ena(a); },
  }
}

/// Before a poll: lets an e1000 lower its interrupt line.
fn card_ack(d: &mut Card)
  requires card_ok(d)
  ensures card_ok(d)
{
  match d {
    Card::Virtio(v) => { d = Card::Virtio(v); },
    Card::E1000(mut e) => {
      e1k_ack(&mut e);
      d = Card::E1000(e);
    },
    Card::Ena(a) => { d = Card::Ena(a); },
  }
}

fn card_recv(d: &mut Card, pkt: &mut Bytes) -> u64
  requires card_ok(d) && blen(pkt) >= RX_BUF
  ensures card_ok(d) && blen(pkt) == old(blen(pkt)) && result <= RX_BUF - NET_HDR
{
  match d {
    Card::Virtio(mut v) => {
      let n = vnet_recv(&mut v, &mut pkt);
      d = Card::Virtio(v);
      return n;
    },
    Card::E1000(mut e) => {
      let n = e1k_recv(&mut e, &mut pkt);
      d = Card::E1000(e);
      return n;
    },
    Card::Ena(mut a) => {
      let n = ena_recv(&mut a, &mut pkt);
      d = Card::Ena(a);
      return n;
    },
  }
}

/// After a run of card_recv: the card learns of the buffers it got back.
fn card_rx_flush(d: &mut Card)
  requires card_ok(d)
  ensures card_ok(d)
{
  match d {
    Card::Virtio(mut v) => {
      vnet_rx_flush(&mut v);
      d = Card::Virtio(v);
    },
    Card::E1000(e) => { d = Card::E1000(e); },
    Card::Ena(mut a) => {
      ena_rx_flush(&mut a);
      d = Card::Ena(a);
    },
  }
}

fn card_send(d: &mut Card, pkt: &Bytes, n: u64) -> bool
  requires card_ok(d) && n <= FRAME_MAX && n <= blen(pkt)
  ensures card_ok(d)
{
  match d {
    Card::Virtio(mut v) => {
      let ok = vnet_send(&mut v, pkt, n);
      d = Card::Virtio(v);
      return ok;
    },
    Card::E1000(mut e) => {
      let ok = e1k_send(&mut e, pkt, n);
      d = Card::E1000(e);
      return ok;
    },
    Card::Ena(mut a) => {
      let ok = ena_send(&mut a, pkt, n);
      d = Card::Ena(a);
      return ok;
    },
  }
}

/// Stops the card and takes its pages back; its ports and registers go
/// back to their owners (at power off).
fn card_free(ports: &mut Ports, win: &mut MmioSpace, d: Card, m: &mut Mem)
  requires card_ok(d) && mem_ok(m)
  ensures mem_ok(m)
{
  match d {
    Card::Virtio(v) => { vt_release(&mut ports, &mut win, vnet_free(v, &mut m)); },
    Card::E1000(e) => { mmio_release(&mut win, e1k_free(e, &mut m)); },
    Card::Ena(a) => { mmio_release(&mut win, ena_free(a, &mut m)); },
  }
}
