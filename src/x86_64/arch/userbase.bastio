// Where the user window starts, and where a PIE goes in it (x86-64). The
// CPU runs user code on a table of its own (boot/boot.S), so the window
// starts at address 0 and nothing of the kernel is in it. Nothing is mapped
// below PIE_AT, so a null pointer (and a small offset from one) faults.
const USER_BASE: u64 = 0;
const PIE_AT: u64 = 0x400000;
// A page that can run code must be made so when its entry is made (NX, W^X),
// so a writable, executable range is mapped at once, not when touched.
const LAZY_EXEC: u64 = 0;
