// Console output helpers for the kernel's own messages.

fn puts(con: &Serial, s: Str) {
  let mut i = 0;
  while i < slen(s)
    invariant i <= slen(s)
  {
    serial_write(con, sget(s, i));
    i = i + 1;
  }
}

fn put_num(con: &Serial, n: u64) {
  let mut p = 1;
  while p <= n / 10
    invariant p >= 1
  {
    p = p * 10;
  }
  let mut q = p;
  while q > 0 {
    serial_write(con, 48 + (n / q) % 10);
    q = q / 10;
  }
}

fn put_hex(con: &Serial, n: u64) {
  puts(con, "0x");
  let mut q = 0x1000000000000000;
  while q > 0 {
    let d = (n / q) % 16;
    if d < 10 {
      serial_write(con, 48 + d);
    } else {
      serial_write(con, 87 + d);
    }
    q = q / 16;
  }
}

// `n` right-aligned in a field of `w` characters.
fn put_num_pad(con: &Serial, n: u64, w: u64) {
  let mut digits = 1;
  let mut q = n;
  while q >= 10
    invariant digits <= 20
  {
    q = q / 10;
    if digits < 20 {
      digits = digits + 1;
    }
  }
  let mut k = digits;
  while k < w {
    serial_write(con, 32);
    k = k + 1;
  }
  put_num(con, n);
}
