// More Linux file calls: sendfile and copy_file_range, preadv and
// pwritev, statx, fallocate and fadvise64, flock, memfd_create and getcpu.
//
// Not done: sendfile and copy_file_range read only from files, and write
// only to files, pipes, TCP connections and the console. flock is src/lxlock.bastio's.
// fallocate only grows a file (mode 0).
// getcpu says processor 0, node 0, wherever the caller runs.

import "lxmisc.bastio";
import "statfmt.bastio";

const LX_SENDFILE: u64 = 40;
const LX_FLOCK: u64 = 73;
const LX_FADVISE64: u64 = 221;
const LX_FALLOCATE: u64 = 285;
const LX_PREADV: u64 = 295;
const LX_PWRITEV: u64 = 296;
const LX_GETCPU: u64 = 309;
const LX_MEMFD_CREATE: u64 = 319;
const LX_COPY_FILE_RANGE: u64 = 326;
const LX_STATX: u64 = 332;
const STATX_SIZE: u64 = 256;              // struct statx
const STATX_BASIC: u64 = 0x7FF;           // STATX_BASIC_STATS: what statx fills in
const LOCK_SH: u64 = 1;
const LOCK_EX: u64 = 2;
const LOCK_UN: u64 = 8;
const MFD_CLOEXEC: u64 = 1;
const F_SEAL_ALL: u64 = 63;            // SEAL, SHRINK, GROW, WRITE, FUTURE_WRITE, EXEC
const COPY_MAX: u64 = 0x7FFFF000;         // the most one sendfile moves, as on Linux
const ENODEV: u64 = 18446744073709551597;     // 2^64 - 19

fn is_more_call(n: u64) -> bool {
  return n == LX_SENDFILE || n == LX_FLOCK || n == LX_FADVISE64 || n == LX_FALLOCATE || n == LX_PREADV
    || n == LX_PWRITEV || n == LX_GETCPU || n == LX_MEMFD_CREATE || n == LX_COPY_FILE_RANGE || n == LX_STATX;
}

/// Puts the first n transfer bytes into pipe p from the kernel side (no
/// user buffer): a short count when it is nearly full, -EAGAIN when it is
/// full, -EPIPE with no reader.
fn pipe_put_xfer(k: &mut Kernel, p: u64, n: u64) -> u64
  requires kok(k) && p < NPIPES && n <= XFER
  ensures kok(k)
  ensures result <= n || result > XFER
{
  if pi_get(k.pipes, p, 2) == 0 {
    return EPIPE;
  }
  let mut r = pipe_ring(k.pipes, p);
  let room = pipe_room_for(&mut k, p, r.n, n);
  if room == 0 {
    return EAGAIN;
  }
  let put = smaller(n, room);
  pipe_ring_in(&mut k, p, ring_slot(r, r.n), 0, put);
  ring_push_n(&mut r, put);
  pipe_keep(&mut k.pipes, p, r);
  sigio_pipe(&mut k, p);
  return put;
}

/// Writes the first n transfer bytes to descriptor `out` of process pid,
/// at `off` (a file's own offset when off is u64::MAX). The count written,
/// or -errno, EAGAIN for a full pipe, CON_FULL or DISK_RETRY.
fn put_xfer(con: &mut Con, k: &mut Kernel, pid: u64, out: u64, n: u64, off: u64) -> u64
  requires con_ok(con) && kok(k) && pid < NPROC && n <= XFER
  ensures kok(k) && con_ok(con)
  ensures result <= n || result > XFER
{
  let d = fd_look(k, pid, out);
  if d.kind == K_PIPE_W || (d.kind == K_PIPE_R && pipe_both(k, pid, out)) {
    return pipe_put_xfer(&mut k, d.x, n);
  }
  if d.kind == K_CONSOLE {
    if 2 * n > con_room(con) && con_room(con) < OUTCAP {
      return CON_FULL;
    }
    let fits = smaller(n, con_room(con) / 2);
    let mut i = 0;
    while i < fits
      invariant i <= fits && fits <= n && n <= XFER && kok(k) && con_ok(con)
    {
      let ch = bget(k.fs.xfer, i);
      if ch == 10 {
        con_write(&mut con, 13);
      }
      con_write(&mut con, ch);
      i = i + 1;
    }
    return fits;
  }
  if d.kind == K_DEV && d.x >= PROC_DEV {
    if is_uts_file(d.x) {
      return uts_xfer_write(&mut k, pid, uts_file_index(d.x), n);   // src/lxsys.bastio
    }
    if !proc_xfer_writable(d.x) {
      return EINVAL;
    }
    if n > 32 {
      return EINVAL;
    }
    return proc_write_xfer(&mut k, d.x, n);   // a sysctl written through splice
  }
  if d.kind == K_DEV {
    return n;
  }
  if d.kind == K_SOCK && is_tcp(k, pid, out) {
    let w = tcp_send_xfer(&mut k, pid, out, n, false);  // src/lxtcp.bastio
    if w > n && w <= XFER {
      return n;                             // (tcp_send never takes more than it is given)
    }
    return w;
  }
  if d.kind == K_SOCK && is_unix(k, pid, out) {
    let w = ux_send_xfer(&mut k, pid, out, n);
    if w == SK_WAIT {
      return EAGAIN;                        // the channel is full: try again
    }
    return w;
  }
  if d.kind != K_FILE {
    return EINVAL;                          // other sockets and the rest: not done
  }
  let was = vfs_offset(k.fs, d.x);
  if off != 0xFFFFFFFFFFFFFFFF {
    vfs_seek(&mut k.fs, d.x, off);
  }
  let w = vfs_write(&mut k.fs, &mut k.mem, d.x, n);
  if off != 0xFFFFFFFFFFFFFFFF {
    vfs_seek(&mut k.fs, d.x, was);
  }
  if w == NO_FD {
    return EBADF;
  }
  if w == VFS_MISS {
    return DISK_RETRY;
  }
  return w;
}

/// Whether descriptor fd of pid may be written: not a bad one, not a
/// pipe's read end, not a file opened only for reading.
fn out_writable(k: &Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let d = fd_look(k, pid, fd);
  if d.kind == K_BAD || (d.kind == K_PIPE_R && !pipe_both(k, pid, fd)) {
    return false;
  }
  if d.kind == K_FILE {
    return fget(k.fs.ftab, d.x, FD_MODE) / O_WRITE % 2 == 1;
  }
  return true;
}

/// sendfile(out, in, offp, count) and copy_file_range(in, inoffp, out,
/// outoffp, count, flags): copies from file `in` (at *inp, or its own
/// offset when inp is 0) to `out` (at *outp, or its own offset). Stops
/// short when the destination fills; the count, or -errno (EAGAIN,
/// CON_FULL or DISK_RETRY when nothing was copied yet).
fn lx_copy(con: &mut Con, k: &mut Kernel, pid: u64, out: u64, outp: u64, inp: u64, from: u64, count: u64, cfr: bool) -> u64
  requires con_ok(con) && kok(k) && pid < NPROC
  ensures kok(k) && con_ok(con)
{
  let d = fd_look(k, pid, from);
  if d.kind == K_BAD {
    return EBADF;
  }
  if d.kind != K_FILE {
    return EINVAL;                          // only files are read from
  }
  if fget(k.fs.ftab, d.x, FD_MODE) / O_READ % 2 != 1 {
    return EBADF;                           // `in` was not opened for reading
  }
  if !out_writable(k, pid, out) {
    return EBADF;
  }
  let f = vfs_row_file(k.fs, d.x);
  let mut ioff = vfs_offset(k.fs, d.x);
  if inp != 0 {
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, inp, &mut k.fs.xfer, 8) != 8 {
      return EFAULT;
    }
    ioff = get_u64(k.fs.xfer, 0);
    if ioff >= 0x8000000000000000 {
      return EINVAL;                        // a negative offset
    }
  }
  let mut ooff = 0xFFFFFFFFFFFFFFFF;
  if outp != 0 {
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, outp, &mut k.fs.xfer, 8) != 8 {
      return EFAULT;
    }
    ooff = get_u64(k.fs.xfer, 0);
    if ooff >= 0x8000000000000000 {
      return EINVAL;
    }
  }
  if cfr {
    // copy_file_range's checks on the two ranges (Linux's generic_copy_file_checks).
    let od = fd_look(k, pid, out);
    let mut ostart = ooff;
    if od.kind == K_FILE && od.x < FD_ROWS && outp == 0 {
      ostart = vfs_offset(k.fs, od.x);
    }
    if ostart != 0xFFFFFFFFFFFFFFFF {
      if count > 0xFFFFFFFFFFFFFFFF - ostart || count > 0xFFFFFFFFFFFFFFFF - ioff {
        return EOVERFLOW;
      }
      if ostart > 0x7FFFFFFFFFFFFFFF || count > 0x7FFFFFFFFFFFFFFF - ostart {
        return EFBIG;
      }
      if od.kind == K_FILE && od.x < FD_ROWS && vfs_row_file(k.fs, od.x) == f
         && count > 0 && ioff < ostart + smaller(count, COPY_MAX) && ostart < ioff + smaller(count, COPY_MAX) {
        return EINVAL;                      // the ranges overlap in one file
      }
    }
  }
  let total = smaller(count, COPY_MAX);
  let mut done = 0;
  let mut err = 0;
  while done < total && err == 0
    invariant done <= total && kok(k) && con_ok(con)
  {
    let step = smaller(XFER, total - done);
    let got = vfs_read_at(&mut k.fs, f, sat_add(ioff, done), step);
    if got == NO_FD || got == 0 {
      err = 1;                              // the end of the file (or no file)
    } else {
      let mut at = ooff;
      if ooff != 0xFFFFFFFFFFFFFFFF {
        at = sat_add(ooff, done);
      }
      let w = put_xfer(&mut con, &mut k, pid, out, got, at);
      if w > XFER {
        if done == 0 {
          return w;                         // -errno, or wait
        }
        err = 1;
      } else {
        done = done + w;
        if w < got {
          err = 1;                          // the destination filled up
        }
      }
    }
  }
  // Where the copy ended: through the pointers given, or the descriptors'
  // own offsets.
  if inp != 0 {
    xfer_u64(&mut k.fs.xfer, 0, sat_add(ioff, done));
    if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, inp, k.fs.xfer, 8) != 8 {
      return EFAULT;
    }
  } else {
    vfs_seek(&mut k.fs, d.x, sat_add(ioff, done));
  }
  if outp != 0 {
    xfer_u64(&mut k.fs.xfer, 0, sat_add(ooff, done));
    if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, outp, k.fs.xfer, 8) != 8 {
      return EFAULT;
    }
  }
  return done;
}

/// The errors preadv and pwritev give before they move anything, in
/// Linux's order, or NO_RESULT to go on.
fn piov_early(k: &mut Kernel, pid: u64, write: bool, fd: u64, iov: u64, cnt: u64, off: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if off >= 0x8000000000000000 {
    return EINVAL;
  }
  let d = fd_look(k, pid, fd);
  if d.kind == K_BAD {
    return EBADF;
  }
  if d.kind == K_PIPE_R || d.kind == K_PIPE_W || d.kind == K_SOCK || d.kind == K_CONSOLE {
    return ESPIPE;
  }
  let bad = iov_check(&mut k, pid, iov, cnt);
  if bad != 0 {
    return bad;                             // too many vectors, a negative length, an unreadable array
  }
  if d.kind == K_DIR && !write {
    return EISDIR;
  }
  return NO_RESULT;
}

/// preadv and pwritev: each iovec at off and on, until one comes up short.
fn lx_piov(con: &mut Con, k: &mut Kernel, pid: u64, write: bool, fd: u64, iov: u64, cnt: u64, off: u64) -> u64
  requires con_ok(con) && kok(k) && pid < NPROC
  ensures kok(k) && con_ok(con)
{
  let early = piov_early(&mut k, pid, write, fd, iov, cnt, off);
  if early != NO_RESULT {
    return early;
  }
  if write && seal_no_write(&mut k, pid, fd) {
    return EPERM;                           // F_SEAL_WRITE
  }
  if cnt > 1024 || off >= 0x8000000000000000 {
    return EINVAL;
  }
  // As on Linux, the whole vector is checked before anything moves: a
  // length past SSIZE_MAX, alone or in total, is EINVAL.
  let mut total = 0;
  let mut v = 0;
  while v < cnt
    invariant v <= cnt && cnt <= 1024 && total < 0x8000000000000000 && kok(k)
  {
    if iov > 0xFFFFFFFFFFFF0000 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, iov + 16 * v, &mut k.fs.xfer, 16) != 16 {
      return EFAULT;
    }
    let len = get_u64(k.fs.xfer, 8);
    if len >= 0x8000000000000000 - total {
      return EINVAL;
    }
    total = total + len;
    v = v + 1;
  }
  let mut done = 0;
  let mut i = 0;
  while i < cnt
    invariant i <= cnt && cnt <= 1024 && kok(k) && con_ok(con)
  {
    if iov > 0xFFFFFFFFFFFF0000 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, iov + 16 * i, &mut k.fs.xfer, 16) != 16 {
      return EFAULT;
    }
    let base = get_u64(k.fs.xfer, 0);
    let len = get_u64(k.fs.xfer, 8);
    if len > 0 {
      let r = lx_pio(&mut con, &mut k, pid, write, fd, base, len, sat_add(off, done));
      if r > 0x7FFFFFFFFFFFFFFF {
        if done == 0 {
          return r;                         // -errno, or DISK_RETRY
        }
        return done;
      }
      done = sat_add(done, r);
      if r < len {
        return done;
      }
    }
    i = i + 1;
  }
  return done;
}

/// statx(dirfd, path, flags, mask, buf): stat's answer, written into buf
/// first as a struct stat and then rewritten in place as a struct statx.
fn lx_statx(k: &mut Kernel, pid: u64, dirfd: u64, path: u64, flags: u64, buf: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let f = flags % 0x100000000;
  if f & !(AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT | AT_EMPTY_PATH | 0x6000) != 0 || f & 0x6000 == 0x6000 {
    return EINVAL;                          // unknown flags, or both AT_STATX_FORCE_SYNC and DONT_SYNC
  }
  let mask = pget(k.procs, pid, F_REGS + R_R10);
  if mask & 0x80000000 != 0 {
    return EINVAL;                          // STATX__RESERVED
  }
  if buf == 0 || buf > 0xFFFFFFFFFFFF0000 {
    return EFAULT;
  }
  let mut r = 0;
  if flags / AT_EMPTY_PATH % 2 == 1 && user_empty(&mut k, pid, path) {
    r = lx_fstat_at(&mut k, pid, dirfd, buf);
  } else {
    r = lx_stat(&mut k, pid, dirfd, path, buf, (flags & AT_SYMLINK_NOFOLLOW) == 0);
  }
  if r != 0 {
    return r;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, &mut k.fs.xfer, STAT_SIZE) != STAT_SIZE {
    return EFAULT;
  }
  let ino = get_u64(k.fs.xfer, 8);
  let nlink = st_nlink(k.fs.xfer);
  let mode = st_mode(k.fs.xfer);
  let uid = st_uid(k.fs.xfer);
  let gid = st_gid(k.fs.xfer);
  let size = get_u64(k.fs.xfer, 48);
  let rdev = st_rdev(k.fs.xfer);
  let blocks = get_u64(k.fs.xfer, 64);
  let atime = get_u64(k.fs.xfer, 72);
  let mtime = get_u64(k.fs.xfer, 88);
  let ctime = get_u64(k.fs.xfer, 104);
  let mut z = 0;
  while z < STATX_SIZE
    invariant z <= STATX_SIZE && kok(k)
  {
    bset(&mut k.fs.xfer, z, 0);
    z = z + 1;
  }
  let mut smask = STATX_BASIC;
  if mode / 4096 == 6 && mask / 0x2000 % 2 == 1 {
    smask = smask + 0x2000;                 // STATX_DIOALIGN, answered for a block device
    xfer_u64(&mut k.fs.xfer, 152, 512 + 512 * 0x100000000);   // stx_dio_mem_align, stx_dio_offset_align
  }
  xfer_u64(&mut k.fs.xfer, 0, smask + 4096 * 0x100000000);   // stx_mask, stx_blksize
  xfer_u64(&mut k.fs.xfer, 16, nlink % 0x100000000 + uid * 0x100000000);   // stx_nlink, stx_uid
  xfer_u64(&mut k.fs.xfer, 24, gid + mode % 65536 * 0x100000000);   // stx_gid, stx_mode
  xfer_u64(&mut k.fs.xfer, 32, ino);
  xfer_u64(&mut k.fs.xfer, 40, size);
  xfer_u64(&mut k.fs.xfer, 48, blocks);
  xfer_u64(&mut k.fs.xfer, 64, atime);                              // stx_atime.tv_sec
  xfer_u64(&mut k.fs.xfer, 96, ctime);                              // stx_ctime.tv_sec
  xfer_u64(&mut k.fs.xfer, 112, mtime);                             // stx_mtime.tv_sec
  // stx_rdev_major and stx_rdev_minor, from Linux's 32-bit encoding
  xfer_u64(&mut k.fs.xfer, 128, rdev % 0x100000 / 256 + (rdev % 256 + rdev / 4096 / 256 * 256) * 0x100000000);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, buf, k.fs.xfer, STATX_SIZE) != STATX_SIZE {
    return EFAULT;
  }
  return 0;
}

/// The mode bits Linux's fallocate knows (FALLOC_FL_SUPPORTED_MASK:
/// KEEP_SIZE, PUNCH_HOLE, COLLAPSE_RANGE, ZERO_RANGE, INSERT_RANGE,
/// UNSHARE_RANGE, WRITE_ZEROES).
const FALLOC_KNOWN: u64 = 0xFB;

/// fallocate(fd, mode, off, len): mode 0, which grows the file to off +
/// len if it is shorter, and FALLOC_FL_KEEP_SIZE alone, which succeeds
/// without changing anything (no blocks are reserved ahead); other known
/// modes fail with -EOPNOTSUPP after the checks Linux makes first.
fn lx_fallocate(k: &mut Kernel, pid: u64, fd: u64, mode: u64, off: u64, len: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  // In Linux's order: the descriptor, then vfs_fallocate's checks of the
  // range, the mode bits, the access, the kind of file and the size.
  let d = fd_look(k, pid, fd);
  if d.kind == K_BAD {
    return EBADF;
  }
  if len == 0 || off >= 0x8000000000000000 || len >= 0x8000000000000000 {
    return EINVAL;
  }
  if mode & !FALLOC_KNOWN != 0 {
    return EOPNOTSUPP;
  }
  if d.kind == K_PIPE_R || d.kind == K_DIR || d.kind == K_FILE && (d.x >= FD_ROWS || fget(k.fs.ftab, d.x, FD_MODE) / O_WRITE % 2 == 0) {
    return EBADF;                           // not open for writing
  }
  if d.kind == K_PIPE_W {
    return ESPIPE;
  }
  if d.kind != K_FILE {
    return ENODEV;
  }
  if off + len >= 0x8000000000000000 {
    return EFBIG;                           // past the largest file offset
  }
  if mode == 1 {
    return 0;                               // FALLOC_FL_KEEP_SIZE: blocks are not reserved ahead here, so nothing to do
  }
  if seal_no_resize(&mut k, pid, fd, off + len) && off + len > vfs_size(&mut k.fs, vfs_row_file(k.fs, d.x)) {
    return EPERM;                           // F_SEAL_GROW
  }
  if mode != 0 {
    return EOPNOTSUPP;                      // no blocks are punched or zeroed
  }
  let size = vfs_size(&mut k.fs, vfs_row_file(k.fs, d.x));
  if size == NO_FILE {
    return EBADF;
  }
  if off + len <= size {
    return 0;
  }
  if !vfs_truncate(&mut k.fs, &mut k.mem, d.x, off + len) {
    return EFBIG;                           // read-only, or the file or disk is full
  }
  return 0;
}

/// Checks memfd_create's name at user address va: -EFAULT if it cannot
/// be read, -EINVAL if it is longer than 249 bytes (MFD_NAME_MAX_LEN),
/// else 0. The name itself is only for /proc on Linux, so it is not kept.
fn memfd_name_ok(k: &mut Kernel, pid: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut i = 0;
  while i < 250
    invariant i <= 250 && kok(k)
  {
    if va >= 0x800000000000 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + i, &mut k.fs.xfer, 1) != 1 {
      return EFAULT;
    }
    if bget(k.fs.xfer, 0) == 0 {
      return 0;
    }
    i = i + 1;
  }
  return EINVAL;
}

/// memfd_create(name, flags): a file in /tmp that is unlinked at once, so
/// it lives as long as a descriptor or mapping holds it.
fn lx_memfd(k: &mut Kernel, pid: u64, name: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if name == 0 || name >= 0x800000000000 {   // not a user address
    return EFAULT;
  }
  let nm = memfd_name_ok(&mut k, pid, name);
  if nm != 0 {
    return nm;
  }
  if flags / 2 != 0 && flags != MFD_CLOEXEC + 2 {
    return EINVAL;                          // MFD_ALLOW_SEALING (2) is accepted; nothing else
  }
  let mut oflags = LO_RDWR + LO_CREAT + LO_EXCL;
  if flags % 2 == MFD_CLOEXEC {
    oflags = oflags + LO_CLOEXEC;
  }
  let mut tries = 0;
  lpath_ro_clear(&mut k);                   // a name made here, in no mount of a namespace
  while tries < 16
    invariant tries <= 16 && kok(k)
  {
    let n = memfd_name(&mut k, pid, sat_add(k.ns, tries));
    let fd = lx_open_n(&mut k, pid, n, oflags, 511);   // 0777, as Linux: a memfd may be executed
    if fd < LXNFD {
      seal_new(&mut k, pid, fd, flags / 2 % 2 == 1);
      let n2 = memfd_name(&mut k, pid, sat_add(k.ns, tries));
      vfs_unlink(&mut k.fs, &mut k.mem, n2);
      return fd;
    }
    if fd != EEXIST {
      return fd;
    }
    tries = tries + 1;
  }
  return EEXIST;
}

/// The slot of the sealing table for file f, or SEAL_N if it has none. A
/// slot is only for a file without a name (a memfd is never linked): one
/// whose file was freed and its node reused for a file with a name is stale,
/// and is dropped here.
fn seal_slot(k: &mut Kernel, f: u64) -> u64
  requires kok(k)
  ensures kok(k) && result <= SEAL_N
{
  let mut e = 0;
  while e < SEAL_N
    invariant e <= SEAL_N && kok(k)
  {
    let w = get(k.sys, SYS_SEAL + 2 * e);
    if w != 0 && w - 1 == f {
      if vfs_orphan(&mut k.fs, f) {
        return e;
      }
      k.sys = set(k.sys, SYS_SEAL + 2 * e, 0);
    }
    e = e + 1;
  }
  return SEAL_N;
}

/// A new memfd on descriptor fd: its seals start empty, or sealed against
/// sealing (F_SEAL_SEAL) without MFD_ALLOW_SEALING. The table is a ring of
/// SEAL_N entries (the oldest is overwritten).
fn seal_new(k: &mut Kernel, pid: u64, fd: u64, allow: bool)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  if d.kind != K_FILE {
    return;
  }
  let f = vfs_row_file(k.fs, d.x);
  if f == NO_FILE || f >= 0xFFFFFFFFFFFFFFFF {
    return;                                 // the table holds f + 1
  }
  let mut e = seal_slot(&mut k, f);
  if e >= SEAL_N {
    e = k.ns / 1000 % SEAL_N;
    let mut i = 0;
    while i < SEAL_N && get(k.sys, SYS_SEAL + 2 * e) != 0
      invariant i <= SEAL_N && e < SEAL_N && kok(k)
    {
      e = (e + 1) % SEAL_N;
      i = i + 1;
    }
  }
  k.sys = set(k.sys, SYS_SEAL + 2 * e, f + 1);
  if allow {
    k.sys = set(k.sys, SYS_SEAL + 2 * e + 1, 0);
  } else {
    k.sys = set(k.sys, SYS_SEAL + 2 * e + 1, 1);
  }
}

const SEAL_SHRINK: u64 = 2;
const SEAL_GROW: u64 = 4;
const SEAL_WRITE: u64 = 8;
const SEAL_FUTURE_WRITE: u64 = 16;

/// The seals of the file open on descriptor fd: 0 for one that is not a
/// memfd made here.
fn seals_of(k: &mut Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  if d.kind != K_FILE {
    return 0;
  }
  let f = vfs_row_file(k.fs, d.x);
  if f == NO_FILE || f >= 0xFFFFFFFFFFFFFFFF {
    return 0;
  }
  let e = seal_slot(&mut k, f);
  if e >= SEAL_N {
    return 0;
  }
  return get(k.sys, SYS_SEAL + 2 * e + 1) % 64;
}

/// Whether the seals of descriptor fd forbid writing to it (write, pwrite,
/// a new writable shared mapping): F_SEAL_WRITE and F_SEAL_FUTURE_WRITE.
fn seal_no_write(k: &mut Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  return seals_of(&mut k, pid, fd) / SEAL_WRITE % 4 != 0;
}

/// Whether the seals of descriptor fd forbid giving its file the size
/// `size` (ftruncate, fallocate): F_SEAL_SHRINK below the current size,
/// F_SEAL_GROW above it.
fn seal_no_resize(k: &mut Kernel, pid: u64, fd: u64, size: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let sl = seals_of(&mut k, pid, fd);
  if sl / SEAL_SHRINK % 4 == 0 {
    return false;
  }
  let d = fd_look(k, pid, fd);
  if d.kind != K_FILE {
    return false;
  }
  let cur = vfs_size(&mut k.fs, vfs_row_file(k.fs, d.x));
  if cur == NO_FILE {
    return false;
  }
  return (size < cur && sl / SEAL_SHRINK % 2 == 1) || (size > cur && sl / SEAL_GROW % 2 == 1);
}

/// fcntl F_ADD_SEALS and F_GET_SEALS. Writes, truncation and new writable
/// shared mappings obey the seals (seal_no_write, seal_no_resize).
/// A file that is not a memfd made here has none (EINVAL), as on Linux.
fn lx_seals(k: &mut Kernel, pid: u64, fd: u64, cmd: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  if d.kind != K_FILE {
    return EINVAL;
  }
  let f = vfs_row_file(k.fs, d.x);
  if f == NO_FILE || f >= 0xFFFFFFFFFFFFFFFF {
    return EINVAL;
  }
  let e = seal_slot(&mut k, f);
  if e >= SEAL_N {
    return EINVAL;
  }
  let cur = get(k.sys, SYS_SEAL + 2 * e + 1) % 64;
  if cmd == F_GET_SEALS {
    return cur;
  }
  if arg > F_SEAL_ALL {
    return EINVAL;
  }
  if cur % 2 == 1 {
    return EPERM;                           // sealed against sealing
  }
  k.sys = set(k.sys, SYS_SEAL + 2 * e + 1, cur | arg);
  return 0;
}

/// Writes "tmp/.memfd-P-T" (P the pid, T a stamp in hex) to the transfer
/// buffer; its length.
fn memfd_name(k: &mut Kernel, pid: u64, t: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k) && result <= 40
{
  let mut i = 0;
  let pre = "tmp/.memfd-";
  while i < slen(pre) && i < 11
    invariant i <= 11 && kok(k)
  {
    bset(&mut k.fs.xfer, i, sget(pre, i));
    i = i + 1;
  }
  bset(&mut k.fs.xfer, 11, cast[u8](48 + pid % 10));      // the pid, digits reversed
  bset(&mut k.fs.xfer, 12, cast[u8](48 + pid / 10 % 10));
  bset(&mut k.fs.xfer, 13, cast[u8](48 + pid / 100 % 10));
  bset(&mut k.fs.xfer, 14, 45);             // '-'
  let mut j = 0;
  while j < 16
    invariant j <= 16 && kok(k)
  {
    let digit = t / (1 << (4 * j)) % 16;
    let mut ch = 48 + digit;
    if digit >= 10 {
      ch = 87 + digit;                      // 'a' ..
    }
    bset(&mut k.fs.xfer, 15 + j, cast[u8](ch));
    j = j + 1;
  }
  return 31;
}

fn is_dir_fd(k: &Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let d = fd_look(k, pid, fd);
  return d.kind == K_DIR;
}

fn is_bad_fd(k: &Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let d = fd_look(k, pid, fd);
  return d.kind == K_BAD;
}

/// Whether descriptor fd of pid is a file opened with O_APPEND.
fn is_append_fd(k: &Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let d = fd_look(k, pid, fd);
  return d.kind == K_FILE && d.x < FD_ROWS && fget(k.fs.ftab, d.x, FD_MODE) / O_APPEND % 2 == 1;
}

fn out_is_file(k: &Kernel, pid: u64, fd: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let d = fd_look(k, pid, fd);
  return d.kind == K_FILE;
}

/// sendfile(out, in, offp, count). A full pipe or connection (put_xfer
/// says EAGAIN or SK_WAIT) is -EAGAIN when `out` is nonblocking, as nginx
/// expects, and otherwise a wait for room.
fn lx_sendfile(con: &mut Con, k: &mut Kernel, pid: u64, out: u64, from: u64, offp: u64) -> u64
  requires con_ok(con) && kok(k) && pid < NPROC
  ensures kok(k) && con_ok(con)
{
  let r = lx_copy(&mut con, &mut k, pid, out, 0, offp, from, pget(k.procs, pid, F_REGS + R_R10), false);
  if (r == EAGAIN || r == SK_WAIT) && pipe_nonblock(k, pid, out) {
    ret(&mut k.procs, pid, EAGAIN);
    return KEEP;
  }
  if r == SK_WAIT {
    return sock_retry(&mut k, pid, LX_SENDFILE);   // sleep until an ACK makes room
  }
  if r == EAGAIN {
    return lx_retry(&mut k, pid, LX_SENDFILE);
  }
  if r == CON_FULL {
    return con_block(&mut k, pid, LX_SENDFILE);
  }
  if r == DISK_RETRY {
    return disk_retry(&mut k, pid, LX_SENDFILE);
  }
  ret(&mut k.procs, pid, r);
  return KEEP;
}

/// The result of system call n among those is_more_call names, other than
/// sendfile (which lx_more_call handles).
fn lx_more_result(con: &mut Con, k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires con_ok(con) && kok(k) && pid < NPROC
  ensures kok(k) && con_ok(con)
{
  let r10 = pget(k.procs, pid, F_REGS + R_R10);
  let r8 = pget(k.procs, pid, F_REGS + R_R8);
  let mut r = 0;
  if n == LX_COPY_FILE_RANGE {
    if pget(k.procs, pid, F_REGS + R_R9) != 0 {
      r = EINVAL;                           // no flags are defined
    } else if is_dir_fd(k, pid, c) {
      r = EISDIR;
    } else if !out_is_file(k, pid, c) {
      r = EINVAL;                           // a pipe, device or socket (the read end too)
      if is_bad_fd(k, pid, c) {
        r = EBADF;
      }
    } else if is_append_fd(k, pid, c) {
      r = EBADF;                            // there is no offset to copy to
    } else {
      r = lx_copy(&mut con, &mut k, pid, c, r10, b, a, r8, true);
    }
  } else if n == LX_PREADV || n == LX_PWRITEV {
    r = lx_piov(&mut con, &mut k, pid, n == LX_PWRITEV, a, b, c, r10);
  } else if n == LX_STATX {
    r = lx_statx(&mut k, pid, a, b, c, r8);
  } else if n == LX_FALLOCATE {
    r = lx_fallocate(&mut k, pid, a, b, c, r10);
  } else if n == LX_FLOCK {
    r = lx_flock(&mut k, pid, a, b);        // src/lxlock.bastio
  } else if n == LX_FADVISE64 {
    let d = fd_look(k, pid, a);
    if d.kind == K_BAD {
      r = EBADF;
    } else if d.kind != K_FILE {
      r = ESPIPE;
    }
    // Otherwise accepted: advice is not taken.
  } else if n == LX_GETCPU {
    lx_fill(&mut k, 0, 4);
    if a != 0 {
      r = lx_put_out(&mut k, pid, a, 4);
    }
    if r == 0 && b != 0 {
      r = lx_put_out(&mut k, pid, b, 4);
    }
  } else if n == LX_MEMFD_CREATE {
    r = lx_memfd(&mut k, pid, a, b);
  }
  return r;
}

/// System call n of the ones is_more_call names.
fn lx_more_call(con: &mut Con, k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires con_ok(con) && kok(k) && pid < NPROC
  ensures kok(k) && con_ok(con)
{
  if n == LX_SENDFILE {
    return lx_sendfile(&mut con, &mut k, pid, a, b, c);
  }
  let r = lx_more_result(&mut con, &mut k, pid, n, a, b, c);
  if r == LK_WAIT && n == LX_FLOCK {
    return lx_retry(&mut k, pid, n);        // someone else's flock is in the way
  }
  if r == EAGAIN && n != LX_FLOCK {
    return lx_retry(&mut k, pid, n);         // a full pipe: wait for room
  }
  if r == CON_FULL {
    return con_block(&mut k, pid, n);
  }
  if r == DISK_RETRY {
    return disk_retry(&mut k, pid, n);
  }
  ret(&mut k.procs, pid, r);
  return KEEP;
}
