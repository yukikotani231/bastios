// Capabilities (capget, capset, PR_CAPBSET_*, PR_*_SECUREBITS).
//
// Who holds a capability still follows from the user ids, as before: a
// process whose effective user is root holds every capability, and any
// other holds none, with one exception: a process that gives up its last
// root user id while PR_SET_KEEPCAPS is set keeps its permitted set, as
// Linux does, and may then choose (capset) the part of it to hold in its
// effective set. That is how chronyd and dnsmasq drop root and keep the
// clock or the low ports. The kept sets are explicit words (CAPW_HP,
// CAPW_HE); they end at execve and when a root id comes back. What this
// file adds to the user ids is giving capabilities up. Each process has
// CAP_W words in k.sys from SYS_CAP: the capabilities dropped from its
// effective set, those dropped from its permitted set, its inheritable
// set, those dropped from its bounding set and the two kept sets. All 0
// means the full sets of root. A fork copies the words; execve gives back
// what the bounding set allows (as Linux does for root), keeps the
// inheritable set and ends the kept sets.
//
// Only some checks ask for a capability (cap_has) instead of root:
// CAP_SYS_TIME (setting the clock, adjtimex), CAP_SYS_RESOURCE (pipe
// sizes, raising a hard limit, message queue sizes), CAP_SYS_NICE
// (priorities and policies), CAP_IPC_LOCK (mlock past RLIMIT_MEMLOCK),
// CAP_NET_BIND_SERVICE (ports below 1024), CAP_SYS_ADMIN (host names,
// namespaces), CAP_SYS_BOOT (reboot) and CAP_SETPCAP (the bounding set).
// The others (file permissions, credentials, signals) still test for an
// effective user of root.

import "lxprctl.bastio";

const CAP_W: u64 = 6;
const CAPW_EFF: u64 = 0;                 // dropped from the effective set
const CAPW_PERM: u64 = 1;                // dropped from the permitted set
const CAPW_INH: u64 = 2;                 // the inheritable set
const CAPW_BSET: u64 = 3;                // dropped from the bounding set
const CAPW_HP: u64 = 4;                  // KEEPCAPS: the permitted set a non-root process keeps, plus CAP_HELD
const CAPW_HE: u64 = 5;                  // KEEPCAPS: its effective set
const CAP_HELD: u64 = 0x4000000000000000;   // in CAPW_HP while the process holds such sets
const CAP_LAST: u64 = 40;                // CAP_CHECKPOINT_RESTORE
const CAP_FULL: u64 = 0x1FFFFFFFFFF;     // capabilities 0 to CAP_LAST
const CAP_V1: u64 = 0x19980330;          // _LINUX_CAPABILITY_VERSION_1: 32-bit sets
const CAP_V2: u64 = 0x20071026;
const CAP_V3: u64 = 0x20080522;          // the version this kernel prefers

fn cap_word(k: &Kernel, p: u64, w: u64) -> u64
  requires kok(k) && p < NPROC && w < CAP_W
{
  return get(k.sys, SYS_CAP + p * CAP_W + w) & CAP_FULL;
}

fn cap_put(k: &mut Kernel, p: u64, w: u64, v: u64)
  requires kok(k) && p < NPROC && w < CAP_W
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_CAP + p * CAP_W + w, v & CAP_FULL);
}

/// A kept-set word, as it stands (cap_word would cut off CAP_HELD).
fn cap_raw(k: &Kernel, p: u64, w: u64) -> u64
  requires kok(k) && p < NPROC && w < CAP_W
  ensures result == get(k.sys, SYS_CAP + p * CAP_W + w)
{
  return get(k.sys, SYS_CAP + p * CAP_W + w);
}

fn cap_raw_put(k: &mut Kernel, p: u64, w: u64, v: u64)
  requires kok(k) && p < NPROC && w < CAP_W
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_CAP + p * CAP_W + w, v);
}

/// Does process p hold kept sets (it gave up root with KEEPCAPS set)? For
/// specifications.
spec fn is_kept(k: &Kernel, p: u64) -> bool {
  SYS_CAP + p * CAP_W + CAPW_HP < len(k.sys) && get(k.sys, SYS_CAP + p * CAP_W + CAPW_HP) >= CAP_HELD
}

fn cap_kept(k: &Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
  ensures result == is_kept(k, p)
{
  return cap_raw(k, p, CAPW_HP) >= CAP_HELD;
}

/// The kept sets begin: permitted set perm, nothing effective yet (the
/// effective user is no longer root).
fn cap_keep(k: &mut Kernel, p: u64, perm: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  cap_raw_put(&mut k, p, CAPW_HP, CAP_HELD + (perm & CAP_FULL));
  cap_raw_put(&mut k, p, CAPW_HE, 0);
}

/// The kept sets end.
fn cap_unkeep(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  cap_raw_put(&mut k, p, CAPW_HP, 0);
  cap_raw_put(&mut k, p, CAPW_HE, 0);
}

/// Process p's effective set: everything not dropped, for root; what a
/// KEEPCAPS process chose to hold, for another.
fn cap_eff(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures !is_root(k.procs, p) && !is_kept(k, p) ==> result == 0
{
  if !cred_root(k.procs, p) {
    if cap_kept(k, p) {
      return cap_raw(k, p, CAPW_HE) & CAP_FULL;
    }
    return 0;
  }
  return CAP_FULL & !cap_word(k, p, CAPW_EFF) & !cap_word(k, p, CAPW_PERM);
}

/// Process p's permitted set: kept while any of its user ids is root.
fn cap_perm(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
{
  let r = id_get(k.procs, p, F_UID, false);
  let e = id_get(k.procs, p, F_UID, true);
  let s = id_get(k.procs, p, F_SUID, false);
  if r != 0 && e != 0 && s != 0 {
    if cap_kept(k, p) {
      return cap_raw(k, p, CAPW_HP) & CAP_FULL;
    }
    return 0;
  }
  return CAP_FULL & !cap_word(k, p, CAPW_PERM);
}

/// Whether process p holds capability c in its effective set. Only root
/// holds any, and a process that kept some when it gave up root: a
/// capability refines the root rule of docs/security.md, never widens it.
fn cap_has(k: &Kernel, p: u64, c: u64) -> bool
  requires kok(k) && p < NPROC && c <= CAP_LAST
  ensures result ==> is_root(k.procs, p) || is_kept(k, p)
{
  return (cap_eff(k, p) >> c) % 2 == 1;
}


/// The effective set capget shows and capset starts from: as cap_eff, and
/// for the root of a user namespace what it has not dropped (it holds it in
/// that namespace only, src/lxuser.bastio).
fn cap_eff_v(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
{
  if !cred_root(k.procs, p) && !cap_kept(k, p) && ns_root(k, p) {
    return CAP_FULL & !cap_word(k, p, CAPW_EFF) & !cap_word(k, p, CAPW_PERM);
  }
  return cap_eff(k, p);
}

/// The permitted set, the same way.
fn cap_perm_v(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
{
  if !cred_root(k.procs, p) && !cap_kept(k, p) && ns_root(k, p) {
    return CAP_FULL & !cap_word(k, p, CAPW_PERM);
  }
  return cap_perm(k, p);
}

/// After a successful setuid, setreuid or setresuid by pid, whose user ids
/// held a root before or not (was_root) and whose permitted set was
/// was_perm: Linux's rules for the capabilities. Giving up the last root id
/// loses them, unless PR_SET_KEEPCAPS is set, which keeps the permitted
/// set and empties the effective one; a root id back ends the kept sets.
fn cap_after_setuid(k: &mut Kernel, pid: u64, was_root: bool, was_perm: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if any_uid_root(k.procs, pid) {
    cap_unkeep(&mut k, pid);
    return;
  }
  if !was_root {
    return;                                 // not root before either: whatever it kept stays
  }
  if pr_get(k, pid, PRW_DEATH) / PRD_KEEPCAPS % 2 == 1 {
    cap_keep(&mut k, pid, was_perm);
  } else {
    cap_unkeep(&mut k, pid);
  }
}

/// Set w (0 inheritable, 1 permitted, 2 effective, 3 bounding) of process
/// p, as /proc/PID/status shows it.
fn cap_status(k: &Kernel, p: u64, w: u64) -> u64
  requires kok(k) && p < NPROC
{
  if w == 0 {
    return cap_word(k, p, CAPW_INH);
  }
  if w == 1 {
    return cap_perm_v(k, p);
  }
  if w == 2 {
    return cap_eff_v(k, p);
  }
  return CAP_FULL & !cap_word(k, p, CAPW_BSET);
}

/// A new process or thread c of p: the sets carry over.
fn cap_fork(k: &mut Kernel, p: u64, c: u64)
  requires kok(k) && p < NPROC && c < NPROC
  ensures kok(k)
{
  let mut w = 0;
  while w < CAP_W
    invariant w <= CAP_W && kok(k)
  {
    cap_raw_put(&mut k, c, w, cap_raw(k, p, w));
    w = w + 1;
  }
}

/// execve: the effective and permitted sets become the bounding set, and
/// the kept sets of a process that is not root end.
fn cap_exec(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let b = cap_word(k, p, CAPW_BSET);
  cap_put(&mut k, p, CAPW_EFF, b);
  cap_put(&mut k, p, CAPW_PERM, b);
  cap_unkeep(&mut k, p);
}

/// Clears process p's words for the next process in its slot.
fn cap_clear(k: &mut Kernel, p: u64)
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let mut w = 0;
  while w < CAP_W
    invariant w <= CAP_W && kok(k)
  {
    cap_put(&mut k, p, w, 0);
    w = w + 1;
  }
}

/// The header at hdr: its version (EINVAL for an unknown one, which is
/// replaced by CAP_V3 there) and pid. Returns the number of 32-bit set
/// structures the version moves (1 or 2), or -errno; the pid is in
/// k.fs.xfer bytes 4..8.
fn cap_header(k: &mut Kernel, pid: u64, hdr: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if hdr == 0 || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, hdr, &mut k.fs.xfer, 8) != 8 {
    return EFAULT;
  }
  let v = get_u64(k.fs.xfer, 0) % 0x100000000;
  if v == CAP_V1 {
    return 1;
  }
  if v == CAP_V2 || v == CAP_V3 {
    return 2;
  }
  if !put_user_u32(&mut k, pid, hdr, CAP_V3) {
    return EFAULT;
  }
  return EINVAL;
}

/// capget(hdr, data): the effective, permitted and inheritable sets of
/// the process hdr names (0: the caller).
fn lx_capget(k: &mut Kernel, pid: u64, hdr: u64, data: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = cap_header(&mut k, pid, hdr);
  if data == 0 && (n == 1 || n == 2 || n == EINVAL) {
    return 0;                               // asking only for the version
  }
  if n != 1 && n != 2 {
    return n;
  }
  let who = get_u64(k.fs.xfer, 0) / 0x100000000;
  if who >= 0x80000000 {
    return EINVAL;
  }
  let mut t = pid;
  if who != 0 {
    t = who;
  }
  if t >= NPROC || state(k.procs, t) == FREE {
    return ESRCH;
  }
  let e = cap_eff_v(k, t);
  let p = cap_perm_v(k, t);
  let i = cap_word(k, t, CAPW_INH);
  xfer_u64(&mut k.fs.xfer, 0, e % 0x100000000 + 0x100000000 * (p % 0x100000000));
  xfer_u64(&mut k.fs.xfer, 8, i % 0x100000000 + 0x100000000 * (e / 0x100000000));
  xfer_u64(&mut k.fs.xfer, 16, p / 0x100000000 + 0x100000000 * (i / 0x100000000));
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, data, k.fs.xfer, 12 * n) != 12 * n {
    return EFAULT;
  }
  return 0;
}

/// capset(hdr, data): the caller's own sets only (EPERM for another
/// process). A set may only shrink: the new permitted set within the old
/// one, the new effective set within the new permitted one, and the new
/// inheritable set within the old inheritable and permitted sets.
fn lx_capset(k: &mut Kernel, pid: u64, hdr: u64, data: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = cap_header(&mut k, pid, hdr);
  if n != 1 && n != 2 {
    return n;
  }
  let who = get_u64(k.fs.xfer, 0) / 0x100000000;
  if who >= 0x80000000 {
    return EINVAL;
  }
  if who != 0 && who != pid {
    return EPERM;
  }
  xfer_u64(&mut k.fs.xfer, 0, 0);
  xfer_u64(&mut k.fs.xfer, 8, 0);
  xfer_u64(&mut k.fs.xfer, 16, 0);
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, data, &mut k.fs.xfer, 12 * n) != 12 * n {
    return EFAULT;
  }
  let w0 = get_u64(k.fs.xfer, 0);
  let w1 = get_u64(k.fs.xfer, 8);
  let w2 = get_u64(k.fs.xfer, 16);
  let e = (w0 % 0x100000000 + 0x100000000 * (w1 / 0x100000000 % 0x200)) & CAP_FULL;
  let p = (w0 / 0x100000000 + 0x100000000 * (w2 % 0x200)) & CAP_FULL;
  let i = (w1 % 0x100000000 + 0x100000000 * (w2 / 0x100000000 % 0x200)) & CAP_FULL;
  let op = cap_perm_v(k, pid);
  let oi = cap_word(k, pid, CAPW_INH);
  if p & !op != 0 || e & !p != 0 || i & !(oi | op) != 0 {
    return EPERM;
  }
  if !cred_root(k.procs, pid) && cap_kept(k, pid) {
    cap_raw_put(&mut k, pid, CAPW_HP, CAP_HELD + p);
    cap_raw_put(&mut k, pid, CAPW_HE, e);
    cap_put(&mut k, pid, CAPW_INH, i);
    return 0;
  }
  cap_put(&mut k, pid, CAPW_PERM, CAP_FULL & !p);
  cap_put(&mut k, pid, CAPW_EFF, CAP_FULL & !e);
  cap_put(&mut k, pid, CAPW_INH, i);
  return 0;
}

/// prctl's capability options: PR_CAPBSET_READ (23), PR_CAPBSET_DROP
/// (24), PR_GET_SECUREBITS (27) and PR_SET_SECUREBITS (28). No securebits
/// are kept: only 0 may be set. EINVAL for any other option.
fn cap_prctl(k: &mut Kernel, pid: u64, op: u64, a: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if op == 23 || op == 24 {
    if op == 24 && !ns_cap(k, pid, CAP_SETPCAP) {
      return EPERM;
    }
    if a > CAP_LAST {
      return EINVAL;
    }
    let b = cap_word(k, pid, CAPW_BSET);
    if op == 23 {
      return 1 - (b >> a) % 2;
    }
    cap_put(&mut k, pid, CAPW_BSET, b | (1 << a));
    return 0;
  }
  if op == 27 {
    return 0;
  }
  if op == 28 {
    if !ns_cap(k, pid, CAP_SETPCAP) {
      return EPERM;
    }
    if a != 0 {
      return EINVAL;
    }
    return 0;
  }
  return EINVAL;
}

/// PR_CAP_AMBIENT: sub-command a on capability b. The ambient set holds
/// capabilities that are both permitted and inheritable; it is kept as is
/// through fork and execve (a root process holds them all in any case).
fn pr_ambient(k: &mut Kernel, p: u64, a: u64, b: u64) -> u64
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let w = smaller(pr_get(k, p, PRW_DEATH), 0xFFFFFFFFFFFFFFF);
  if a == 4 {                              // PR_CAP_AMBIENT_CLEAR_ALL
    if b != 0 {
      return EINVAL;
    }
    pr_set(&mut k, p, PRW_DEATH, w % PRD_AMBIENT);
    return 0;
  }
  if a < 1 || a > 3 || b > CAP_LAST {
    return EINVAL;
  }
  let bit = 1 << b;
  let amb = w / PRD_AMBIENT;
  if a == 1 {                              // PR_CAP_AMBIENT_IS_SET
    return amb / bit % 2;
  }
  if a == 3 {                              // PR_CAP_AMBIENT_LOWER
    if amb / bit % 2 == 1 {
      pr_set(&mut k, p, PRW_DEATH, w - bit * PRD_AMBIENT);
    }
    return 0;
  }
  // RAISE: needs the capability permitted and inheritable
  if (cap_perm(k, p) >> b) % 2 == 0 || (cap_word(k, p, CAPW_INH) >> b) % 2 == 0 {
    return EPERM;
  }
  if amb / bit % 2 == 0 {
    pr_set(&mut k, p, PRW_DEATH, w + bit * PRD_AMBIENT);
  }
  return 0;
}
