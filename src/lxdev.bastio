// Device files for Linux programs: /dev/null, /dev/zero, /dev/random,
// /dev/urandom and /dev/tty, the loop devices (src/lxloop.bastio), /dev/dsp
// (src/lxsnd.bastio), /dev/input/mice and /dev/psaux (src/lxmouse.bastio),
// and /dev
// itself as a directory to stat.
// Opening one makes an open file description of kind OF_DEV whose x is the
// device; /dev/tty opens the console itself.
//
// /dev/random and /dev/urandom come from a ChaCha20 generator over an
// entropy pool (see "randomness" below).

import "linux.bastio";

const DEV_NONE: u64 = 0;
const DEV_NULL: u64 = 1;
const DEV_ZERO: u64 = 2;
const DEV_TTY: u64 = 4;
const DEV_DIR: u64 = 5;             // /dev itself

/// The device the n-byte path in the transfer buffer ("dev/null", from
/// lx_path_in) names, or DEV_NONE.
fn dev_at(x: &Bytes, n: u64) -> u64
  requires blen(x) == XFER && n <= FNAME_MAX
{
  if xfer_is(x, 0, n, "dev") {
    return DEV_DIR;
  }
  if xfer_is(x, 0, n, "dev/null") {
    return DEV_NULL;
  }
  if xfer_is(x, 0, n, "dev/zero") {
    return DEV_ZERO;
  }
  if xfer_is(x, 0, n, "dev/full") {
    return DEV_FULL;
  }
  if xfer_is(x, 0, n, "dev/random") || xfer_is(x, 0, n, "dev/urandom") {
    return DEV_RANDOM;
  }
  if xfer_is(x, 0, n, "dev/tty") || xfer_is(x, 0, n, "dev/console") {
    return DEV_TTY;
  }
  if xfer_is(x, 0, n, "dev/dsp") {
    return DEV_DSP;                         // src/lxsnd.bastio
  }
  if xfer_is(x, 0, n, "dev/input/mice") || xfer_is(x, 0, n, "dev/psaux") {
    return DEV_MICE;                        // src/lxmouse.bastio
  }
  if xfer_is(x, 0, n, "dev/fb0") {
    return DEV_FB;                          // src/lxfb.bastio
  }
  if xfer_is(x, 0, n, "dev/ptmx") {
    return DEV_PTMX;
  }
  if xfer_is(x, 0, n, "dev/pts") {
    return DEV_PTSDIR;
  }
  let pts = pts_at(x, n);                   // src/lxpty.bastio
  if pts != DEV_NONE {
    return pts;
  }
  return loop_at(x, n);                     // src/lxloop.bastio
}

/// Device d's number, as Linux numbers it (major * 256 + minor).
fn dev_rdev(d: u64) -> u64 {
  if d == DEV_NULL {
    return 0x103;
  }
  if d == DEV_ZERO {
    return 0x105;
  }
  if d == DEV_FULL {
    return 0x107;
  }
  if d == DEV_RANDOM {
    return 0x109;                           // /dev/urandom's
  }
  if d == DEV_TTY {
    return 0x500;
  }
  if d == DEV_PTMX {
    return 0x502;                           // 5:2
  }
  if d >= DEV_LOOP && d < DEV_LOOP + LOOP_N {
    return 0x700 + d - DEV_LOOP;            // block major 7
  }
  if d == DEV_LOOPCTL {
    return 0xAED;                           // 10:237
  }
  if d == DEV_FB {
    return 0x1D00;                          // 29:0, /dev/fb0
  }
  if d == DEV_MICE {
    return 0xD3F;                           // 13:63, /dev/input/mice
  }
  return 0;
}

/// The device a device node numbered rdev opens, or DEV_NONE.
fn rdev_dev(rdev: u64) -> u64 {
  if rdev == 0x103 {
    return DEV_NULL;
  }
  if rdev == 0x105 {
    return DEV_ZERO;
  }
  if rdev == 0x107 {
    return DEV_FULL;
  }
  if rdev == 0x108 || rdev == 0x109 {
    return DEV_RANDOM;
  }
  if rdev == 0x500 || rdev == 0x501 {
    return DEV_TTY;
  }
  if rdev == 0x502 {
    return DEV_PTMX;                        // a /dev/ptmx made by mknod, in a chroot
  }
  if rdev >= 0x700 && rdev < 0x700 + LOOP_N {
    return DEV_LOOP + rdev - 0x700;
  }
  if rdev == 0xAED {
    return DEV_LOOPCTL;
  }
  if rdev == 0x1D00 {
    return DEV_FB;
  }
  if rdev == 0xD3F || rdev == 0xA01 {
    return DEV_MICE;                        // /dev/input/mice, /dev/psaux (10:1)
  }
  return DEV_NONE;
}

/// What stat says about device d (for a device, size is the device
/// number: see put_stat).
fn dev_meta(d: u64) -> Meta {
  if d >= PROC_DEV {
    return proc_meta(d);                    // a /proc file (src/lxprocfs.bastio)
  }
  if d == DEV_PTSDIR {
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: 6, mtime: 0, own: 0 };
  }
  if d == DEV_DIR {
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: 3, mtime: 0, own: 0 };
  }
  // The loop devices are root's and group disk's (src/lxfd.bastio checks
  // it at open); /dev/loop-control is a character device.
  if is_loop(d) {
    return Meta { ok: true, mode: S_IFBLK, size: dev_rdev(d), ino: 128 + d - DEV_LOOP, mtime: 0, own: DISK_GID * 0x100000000 };
  }
  if d == DEV_LOOPCTL {
    return Meta { ok: true, mode: 0x21B0, size: dev_rdev(d), ino: 30 + d % 16, mtime: 0, own: DISK_GID * 0x100000000 };
  }
  if d >= DEV_PTM && d < DEV_PTS + PTY_N {
    return Meta { ok: true, mode: S_IFCHR, size: 0, ino: 200 + d - DEV_PTM, mtime: 0, own: 0 };
  }
  return Meta { ok: true, mode: S_IFCHR, size: dev_rdev(d), ino: 30 + d % 16, mtime: 0, own: 0 };
}

// ---------------------------------------------------------------- randomness
//
// /dev/urandom and getrandom come from ChaCha20 (RFC 8439) keyed by a pool
// that keeps absorbing entropy: the time-stamp counter on every scheduler
// pass (rng_stir), whose low bits depend on when interrupts, frames and
// keystrokes arrived, plus the wall clock and the HPET at boot. Each
// refill folds the pool into the key, makes one block, and keeps half of
// it as the next key ("fast key erasure"), so earlier output cannot be
// recomputed from a later state. The counter's jitter is an estimate of
// entropy, not a measured one. A virtio-rng, if the machine has one, adds
// 64 bytes at boot (src/virtio_rng.bastio). A processor with RDSEED or
// RDRAND gives 64 bytes at boot and one more word every RNG_HWEVERY
// scheduler passes (rng_hw_boot, rng_stir). Neither source is trusted alone:
// each word only goes into the pool, which the key absorbs with the rest.
//
// k.rng holds RNG_LEN words:
const RNG_KEY: u64 = 0;             // 8 key words of 32 bits
const RNG_CTR: u64 = 8;             // the block counter
const RNG_HAVE: u64 = 9;            // how many of the buffered words are left
const RNG_OUT: u64 = 10;            // 4 buffered 64-bit words of output
const RNG_POOL: u64 = 14;           // 4 pool words
const RNG_AT: u64 = 18;             // the pool word the next sample goes into
const RNG_PASSES: u64 = 19;         // scheduler passes since the last hardware word
const RNG_HW: u64 = 20;             // the processor's generators (INFO_RAND 0), 0 for none
const RNG_HWEVERY: u64 = 4096;
// RNG_LEN is in src/proc.bastio, which kok needs it before this file.

/// A new generator whose pool starts from `seed`.
fn rng_new(seed: u64) -> Buf
  ensures len(result) == RNG_LEN
{
  let mut r = alloc(RNG_LEN);
  let mut i = 0;
  while i < RNG_LEN
    invariant i <= RNG_LEN && len(r) == RNG_LEN
  {
    r = set(r, i, 0);
    i = i + 1;
  }
  r = set(r, RNG_POOL, seed);
  return r;
}

/// Mixes the 64-bit sample x into the pool (a multiply-xorshift step, so
/// every bit of x reaches every bit of the word).
fn rng_add(r: &mut Buf, x: u64)
  requires len(r) == RNG_LEN
  ensures len(r) == RNG_LEN
{
  let j = RNG_POOL + get(r, RNG_AT) % 4;
  let mut z = get(r, j) ^ x;
  z = wrap_mul(z ^ (z >> 30), 0xBF58476D1CE4E5B9);
  z = wrap_mul(z ^ (z >> 27), 0x94D049BB133111EB);
  r = set(r, j, z ^ (z >> 31));
  r = set(r, RNG_AT, (get(r, RNG_AT) % 4 + 1) % 4);
}

/// Adds the time-stamp counter now to the pool (each scheduler pass), and
/// every RNG_HWEVERY passes a word from the processor's generator, if it has one.
fn rng_stir(k: &mut Kernel, cpu: &Cpu)
  requires kok(k)
  ensures kok(k)
{
  rng_add(&mut k.rng, cpu_tsc(cpu));
  if get(k.rng, RNG_HW) != 0 {
    let n = smaller(get(k.rng, RNG_PASSES), RNG_HWEVERY) + 1;
    if n >= RNG_HWEVERY {
      k.rng = set(k.rng, RNG_PASSES, 0);
      rng_add(&mut k.rng, boot_info(cpu, INFO_RAND, 1));
    } else {
      k.rng = set(k.rng, RNG_PASSES, n);
    }
  }
}

/// At boot: notes which generators the processor has, and if there is one,
/// adds 8 words from it to the pool. Returns how many bytes that gave
/// (0: the processor has none).
fn rng_hw_boot(k: &mut Kernel, cpu: &Cpu) -> u64
  requires kok(k)
  ensures kok(k) && result <= 64
{
  let have = boot_info(cpu, INFO_RAND, 0) % 4;
  k.rng = set(k.rng, RNG_HW, have);
  if have == 0 {
    return 0;
  }
  let mut i = 0;
  while i < 8
    invariant i <= 8 && kok(k)
  {
    rng_add(&mut k.rng, boot_info(cpu, INFO_RAND, 1));
    i = i + 1;
  }
  return 64;
}

/// Adds the 64-bit word x, from a source outside the kernel (a virtio-rng at
/// boot), to the pool.
fn rng_feed(k: &mut Kernel, x: u64)
  requires kok(k)
  ensures kok(k)
{
  rng_add(&mut k.rng, x);
}

/// x rotated left by n bits, as a 32-bit word.
fn rotl32(x: u64, n: u64) -> u64
  requires x < 4294967296 && 0 < n && n < 32
  ensures result < 4294967296
{
  // The remainder last, so the bound needs no reasoning about bits: the
  // low 32 bits of the two halves' union are the rotated word.
  return ((x << n) | (x >> (32 - n))) % 4294967296;
}

/// The ChaCha quarter round on words a, b, c, d of the 16-word state s.
fn qround(s: &mut Buf, a: u64, b: u64, c: u64, d: u64)
  requires len(s) == 16 && a < 16 && b < 16 && c < 16 && d < 16
  ensures len(s) == 16
{
  let mut va = get(s, a) % TWO32;
  let mut vb = get(s, b) % TWO32;
  let mut vc = get(s, c) % TWO32;
  let mut vd = get(s, d) % TWO32;
  va = (va + vb) % TWO32;
  vd = rotl32((vd ^ va) % TWO32, 16);
  vc = (vc + vd) % TWO32;
  vb = rotl32((vb ^ vc) % TWO32, 12);
  va = (va + vb) % TWO32;
  vd = rotl32((vd ^ va) % TWO32, 8);
  vc = (vc + vd) % TWO32;
  vb = rotl32((vb ^ vc) % TWO32, 7);
  s = set(s, a, va);
  s = set(s, b, vb);
  s = set(s, c, vc);
  s = set(s, d, vd);
}

/// The ChaCha20 constant "expand 32-byte k", word i < 4.
fn chacha_const(i: u64) -> u64 {
  if i == 0 {
    return 0x61707865;
  }
  if i == 1 {
    return 0x3320646E;
  }
  if i == 2 {
    return 0x79622D32;
  }
  return 0x6B206574;
}

/// One ChaCha20 block (RFC 8439 2.3) into `out` (16 words of 32 bits),
/// with the 8 key words at k[key..], block counter ctr and a zero nonce.
fn chacha_block(key: &Buf, at: u64, ctr: u64, out: &mut Buf)
  requires at + 8 <= len(key) && len(out) == 16
  ensures len(out) == 16
{
  let mut i = 0;
  while i < 16
    invariant i <= 16 && len(out) == 16
  {
    let mut v = 0;
    if i < 4 {
      v = chacha_const(i);
    } else if i < 12 {
      v = get(key, at + i - 4) % TWO32;
    } else if i == 12 {
      v = ctr % TWO32;
    } else if i == 13 {
      v = ctr / TWO32 % TWO32;
    }
    out = set(out, i, v);
    i = i + 1;
  }
  let mut x = alloc(16);
  i = 0;
  while i < 16
    invariant i <= 16 && len(out) == 16 && len(x) == 16
  {
    x = set(x, i, get(out, i));
    i = i + 1;
  }
  let mut round = 0;
  while round < 10
    invariant round <= 10 && len(x) == 16 && len(out) == 16
  {
    qround(&mut x, 0, 4, 8, 12);
    qround(&mut x, 1, 5, 9, 13);
    qround(&mut x, 2, 6, 10, 14);
    qround(&mut x, 3, 7, 11, 15);
    qround(&mut x, 0, 5, 10, 15);
    qround(&mut x, 1, 6, 11, 12);
    qround(&mut x, 2, 7, 8, 13);
    qround(&mut x, 3, 4, 9, 14);
    round = round + 1;
  }
  i = 0;
  while i < 16
    invariant i <= 16 && len(out) == 16 && len(x) == 16
  {
    out = set(out, i, (get(x, i) % TWO32 + get(out, i) % TWO32) % TWO32);
    i = i + 1;
  }
  free(x);
}

/// Refills the output buffer: folds the pool into the key, makes a block,
/// takes words 0-7 as the next key and words 8-15 as four 64-bit outputs.
fn rng_refill(r: &mut Buf)
  requires len(r) == RNG_LEN
  ensures len(r) == RNG_LEN && get(r, RNG_HAVE) == 4
{
  let mut i = 0;
  while i < 4
    invariant i <= 4 && len(r) == RNG_LEN
  {
    let p = get(r, RNG_POOL + i);
    r = set(r, RNG_KEY + 2 * i, (get(r, RNG_KEY + 2 * i) ^ p) % TWO32);
    r = set(r, RNG_KEY + 2 * i + 1, (get(r, RNG_KEY + 2 * i + 1) ^ (p >> 32)) % TWO32);
    i = i + 1;
  }
  let ctr = get(r, RNG_CTR);
  r = set(r, RNG_CTR, wrap_add(ctr, 1));
  let mut b = alloc(16);
  chacha_block(r, RNG_KEY, ctr, &mut b);
  i = 0;
  while i < 8
    invariant i <= 8 && len(r) == RNG_LEN && len(b) == 16
  {
    r = set(r, RNG_KEY + i, get(b, i) % TWO32);
    i = i + 1;
  }
  i = 0;
  while i < 4
    invariant i <= 4 && len(r) == RNG_LEN && len(b) == 16
  {
    r = set(r, RNG_OUT + i, get(b, 8 + 2 * i) % TWO32 + TWO32 * (get(b, 9 + 2 * i) % TWO32));
    i = i + 1;
  }
  free(b);
  r = set(r, RNG_HAVE, 4);
}

/// The next 64 random bits of generator r.
fn rng_word(r: &mut Buf) -> u64
  requires len(r) == RNG_LEN
  ensures len(r) == RNG_LEN
{
  if get(r, RNG_HAVE) == 0 || get(r, RNG_HAVE) > 4 {
    rng_refill(&mut r);
  }
  let h = get(r, RNG_HAVE);
  r = set(r, RNG_HAVE, h - 1);
  let v = get(r, RNG_OUT + h - 1);
  r = set(r, RNG_OUT + h - 1, 0);            // given out: not kept
  return v;
}

/// The next 64 random bits.
fn rng_next(k: &mut Kernel) -> u64
  requires kok(k)
  ensures kok(k)
{
  return rng_word(&mut k.rng);
}

/// The sysctl kernel.randomize_va_space: 0 for none, 1 for the stack, the
/// mmap area, the interpreter and PIEs, 2 (the default) the program break
/// too. Larger values count as 2.
fn aslr_level(sys: &Buf) -> u64
  requires len(sys) == SYS_LEN
  ensures result <= 2
{
  let w = get(sys, SYS_SCT + 18);
  if w == 0 {
    return 2;
  }
  return smaller(w - 1, 2);
}

/// What the program process `pid` is about to start draws: 16 bytes for
/// AT_RANDOM from the generator, and the random distances that move the
/// stack, the mmap area, a PIE and the program break (src/elf.bastio),
/// unless randomize_va_space is 0 or the process asked for personality
/// ADDR_NO_RANDOMIZE (0x0040000, which an exec keeps). The distances come
/// from the same generator, so one start does not tell the next.
fn layout_rnd(rng: &mut Buf, sys: &Buf, procs: &Buf, pid: u64) -> Rnd
  requires len(rng) == RNG_LEN && len(sys) == SYS_LEN && ptab_ok(procs) && pid < NPROC
  ensures len(rng) == RNG_LEN && rnd_ok(result)
{
  let a = rng_word(&mut rng);
  let b = rng_word(&mut rng);
  let c = rng_word(&mut rng);
  let d = rng_word(&mut rng);
  let lvl = aslr_level(sys);
  if lvl == 0 || (pget(procs, pid, F_PERSONA) / 262144) % 2 == 1 {
    return rnd_fixed(a, b);
  }
  let mut brk = 0;
  if lvl >= 2 {
    brk = (d >> 24) % BRK_RND_PAGES;
  }
  return Rnd {
    a: a, b: b,
    mmap_pg: c % MMAP_RND_PAGES,
    pie_pg: (c >> 24) % PIE_RND_PAGES,
    brk_pg: brk,
    shift: (c >> 48) % 128 * 4096 + d % 256 * 16
  };
}

/// read(2) on device d: nothing from /dev/null, zeros or random bytes from
/// the others, up to READ_MAX bytes a call (Linux gives a whole read of
/// /dev/zero, so `dd bs=64k` gets full blocks). Returns the count, or
/// -EFAULT if nothing could be written.
fn dev_read(k: &mut Kernel, pid: u64, d: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if d == DEV_NULL || n == 0 {
    return 0;
  }
  if d != DEV_ZERO && d != DEV_RANDOM && d != DEV_FULL {
    return EBADF;
  }
  if va > 0xFFFFFFFFFFFFFFFF - READ_MAX {
    return EFAULT;
  }
  let total = smaller(n, READ_MAX);
  let mut done = 0;
  while done < total
    invariant done <= total && total <= READ_MAX && kok(k)
  {
    let got = dev_read1(&mut k, pid, d, va + done, total - done);
    if got == 0 || got > total - done {
      if done == 0 {
        return EFAULT;
      }
      return done;                          // the rest of the buffer faulted
    }
    done = done + got;
  }
  return done;
}

/// One piece of dev_read: at most XFER bytes. 0 if it could not be written.
fn dev_read1(k: &mut Kernel, pid: u64, d: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let want = smaller(n, XFER);
  let mut i = 0;
  let mut r = 0;
  while i < want
    invariant i <= want && want <= XFER && kok(k)
  {
    let mut v: u8 = 0;
    if d == DEV_RANDOM {
      if i % 8 == 0 {
        r = rng_next(&mut k);
      }
      v = cast[u8](r % 256);
      r = r / 256;
    }
    bset(&mut k.fs.xfer, i, v);
    i = i + 1;
  }
  let put = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, want);
  if put == NO_RESULT {
    return 0;
  }
  return put;
}
