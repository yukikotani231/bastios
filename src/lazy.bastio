// Code pages read when first touched.
//
// execve maps a program's pages before it runs, reading each from its
// file. A program from a file system leaves out its largest code segment
// instead (lazy_plan, src/elf.bastio): Z3 has 24 MiB of code and answers a
// query from a few hundred pages of it. The process keeps a record of
// those pages here, LZ_W words in k.lazy: the first page + 1 (0: no
// record), how many, a hold on the file (vfs_hold, so removing the file's
// name while it runs changes nothing) and the file offset of the first.
// A page fault on one of them maps the page read-only and the instruction
// runs again (lazy_fault). The page comes from the page cache
// (src/pcache.bastio) when its file offset is page-aligned, so every
// process running the program maps the same page and the disk is read once;
// otherwise it is a copy of its own. If the page's blocks are not in the
// disk's cache, their reads are queued and the process sleeps in DISKWAIT
// (src/main.bastio, finish) rather than the kernel polling the disk with
// its lock held; it faults again once the queue has moved.
//
// What is trusted: nothing new. The page is filled before it is mapped,
// and pt_put_frame (pt_put_shared for a cached page) writes the entry in
// one store, so another thread of the process sees either no page or the
// whole of it. A cached page is a TXT_PAGE, so mprotect gives the process
// a copy of its own before it may write it (w_protect), as for the pages
// exec shares (share_text).
//
// What is different from mapping every page: the kernel reading the
// program's own code (write(2) from it, say) gets EFAULT for a page the
// program has not run yet. Only code is left out, never data, for that
// reason.

import "linux.bastio";

fn lz_at(p: u64, f: u64) -> u64
  requires p < NPROC && f < LZ_W
  ensures result < LAZY_LEN
{
  return p * LZ_W + f;
}

/// Process pid's program was just installed from `src`, with file hold
/// `hold` (HOLD_N: none): records the code pages it left out, or lets go
/// of the hold if there are none. `rn` is what exec drew for the layout:
/// the pages are the ones of the program as placed (elf_parse_rnd).
fn lazy_set(k: &mut Kernel, pid: u64, src: Src, hold: u64, rn: Rnd)
  requires kok(k) && pid < NPROC && rnd_ok(rn)
  ensures kok(k)
{
  let mut lz = lz_none();
  if hold < HOLD_N && src.file {
    let e = elf_parse_rnd(&mut k.fs, src, rn);
    if e.ok {
      lz = lazy_plan(&mut k.fs, src, e);
    }
  }
  if lz.pages == 0 && hold < HOLD_N && src.file && src.f < NFILES && vfs_dirent(&mut k.fs, src.f) == 0 {
    // A program run from a file with no name (a memfd, an unlinked file) is
    // kept alive by this hold, as Linux keeps it by the process's exe link:
    // /proc/self/exe opens it (crun's second stage does). An empty record
    // covers no page, so no fault looks at it.
    k.lazy = set(k.lazy, lz_at(pid, 0), 1);
    k.lazy = set(k.lazy, lz_at(pid, 1), 0);
    k.lazy = set(k.lazy, lz_at(pid, 2), hold);
    k.lazy = set(k.lazy, lz_at(pid, 3), 0);
    return;
  }
  if lz.pages == 0 {
    vfs_unhold(&mut k.fs, &mut k.mem, hold);
    k.lazy = set(k.lazy, lz_at(pid, 0), 0);
    return;
  }
  k.lazy = set(k.lazy, lz_at(pid, 0), lz.first + 1);
  k.lazy = set(k.lazy, lz_at(pid, 1), lz.pages);
  k.lazy = set(k.lazy, lz_at(pid, 2), hold);
  k.lazy = set(k.lazy, lz_at(pid, 3), lz.off);
}

/// Process pid's record goes, and its reference on the file.
fn lazy_drop(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if get(k.lazy, lz_at(pid, 0)) != 0 {
    k.lazy = set(k.lazy, lz_at(pid, 0), 0);
    vfs_unhold(&mut k.fs, &mut k.mem, get(k.lazy, lz_at(pid, 2)));
  }
}

/// A new thread's row: the group's record stays with its holder, so the
/// row has none (no reference to drop).
fn lazy_clear(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  k.lazy = set(k.lazy, lz_at(pid, 0), 0);
}

/// fork: the child's window is a copy of the parent's, pages not read yet
/// included, so it gets the record too, with a reference of its own.
fn lazy_fork(k: &mut Kernel, pid: u64, c: u64)
  requires kok(k) && pid < NPROC && c < NPROC
  ensures kok(k)
{
  let mut f = 0;
  while f < LZ_W
    invariant f <= LZ_W && kok(k)
  {
    k.lazy = set(k.lazy, lz_at(c, f), get(k.lazy, lz_at(pid, f)));
    f = f + 1;
  }
  if get(k.lazy, lz_at(c, 0)) != 0 {
    vfs_hold_dup(&mut k.fs, get(k.lazy, lz_at(c, 2)));
  }
}

/// Window pages from .. to of process pid are going away (munmap, a
/// mapping over them, exit, execve): the record no longer covers them. A
/// hole in the middle drops it; pages after it that were never touched
/// stay unmapped, as Linux would leave them if they had been unmapped.
fn lazy_forget(k: &mut Kernel, pid: u64, from: u64, to: u64)
  requires kok(k) && pid < NPROC && from <= to && to <= WPAGES
  ensures kok(k)
{
  let first1 = get(k.lazy, lz_at(pid, 0));
  if first1 == 0 {
    return;
  }
  let first = first1 - 1;
  let end = sat_add(first, get(k.lazy, lz_at(pid, 1)));
  if end == first {
    // An empty record (lazy_set's hold on a program with no name) covers no
    // page: only the whole window going (exit, execve) lets go of the hold.
    if from == 0 && to == WPAGES {
      lazy_drop(&mut k, pid);
    }
    return;
  }
  if to <= first || end <= from {
    return;                                 // none of it
  }
  if from <= first && end <= to {
    lazy_drop(&mut k, pid);                 // all of it
  } else if from <= first {
    // The head goes: the record starts at `to`.
    k.lazy = set(k.lazy, lz_at(pid, 0), to + 1);
    k.lazy = set(k.lazy, lz_at(pid, 1), end - to);
    k.lazy = set(k.lazy, lz_at(pid, 3), sat_add(get(k.lazy, lz_at(pid, 3)), (to - first) * 4096));
  } else if end <= to {
    k.lazy = set(k.lazy, lz_at(pid, 1), from - first);   // the tail goes
  } else {
    lazy_drop(&mut k, pid);
  }
}

/// Whether window page q is one of the pages process pid's record covers.
fn lazy_covers(k: &Kernel, pid: u64, q: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let first1 = get(k.lazy, lz_at(pid, 0));
  return first1 != 0 && q >= first1 - 1 && q - (first1 - 1) < get(k.lazy, lz_at(pid, 1));
}

// What lazy_read reports.
const LZ_NO: u64 = 0;                  // not a page the record covers (or no memory)
const LZ_OK: u64 = 1;                  // mapped: run the instruction again
const LZ_WAIT: u64 = 2;                // its blocks are being read: sleep in DISKWAIT

/// Reads window page q of process pid, if its record covers it and it is
/// not mapped, and maps it read-only. If `wait` is false and the page's
/// blocks are not in the disk's cache, their reads are queued and it
/// reports LZ_WAIT instead of waiting for them with the kernel lock held.
fn lazy_read(k: &mut Kernel, pid: u64, q: u64, wait: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result <= LZ_WAIT
{
  let first1 = get(k.lazy, lz_at(pid, 0));
  if first1 == 0 || q >= WPAGES || q < first1 - 1 || q - (first1 - 1) >= get(k.lazy, lz_at(pid, 1)) {
    return LZ_NO;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, USER_BASE + q * 4096, &mut k.fs.xfer, 1) == 1 {
    return LZ_NO;                           // mapped already
  }
  let h = vfs_held(k.fs, get(k.lazy, lz_at(pid, 2)));
  let off = sat_add(get(k.lazy, lz_at(pid, 3)), (q - (first1 - 1)) * 4096);
  if h == NO_FILE {
    return LZ_NO;
  }
  let mut slot = PC_N;
  if off % 4096 == 0 {
    slot = pc_get(&mut k.fs.pc, h, off / 4096);
  }
  if slot >= PC_N {
    let mut r = VFS_MISS;
    if !wait {
      r = vfs_read_try(&mut k.fs, h, off, 4096);
      if r == VFS_MISS && !dq_idle(k.fs.disk.q) {
        return LZ_WAIT;
      }
    }
    if r == VFS_MISS {
      // Nothing queued that would wake a sleeper: wait here.
      r = vfs_read_at(&mut k.fs, h, off, 4096);
    }
    if r != 4096 {
      return LZ_NO;
    }
    if off % 4096 == 0 {
      // Into the page cache: every process running the program maps the
      // same page, read from the disk once.
      slot = pc_add(&mut k.fs.pc, &mut k.mem, h, off / 4096, k.fs.xfer, 4096, true);
    }
  }
  if slot < PC_N {
    if lazy_share(&mut k, pid, q, slot) {
      return LZ_OK;
    }
    return LZ_NO;
  }
  let b = find_free(&mut k.mem);
  if b >= NPAGES {
    return LZ_NO;
  }
  let f = dirty_fill(take_dirty(&mut k.mem, b), k.fs.xfer, 0);
  match take_space(&mut k.spaces, pid) {
    Space::Empty => {
      give_page(&mut k.mem, f);
      return LZ_NO;
    },
    Space::Mapped(mut root) => {
      let mut ok = false;
      let sg = wseg_of(q * 4096);
      if root_seg(&mut k.mem, &mut root, sg) {
        ok = pt_borrow(&mut root, 1 + sg, lazy_l3, &mut k.mem, q - sg * WSEG_PAGES, f);
      } else {
        give_page(&mut k.mem, f);
      }
      put_space(&mut k.spaces, pid, Space::Mapped(root));
      if ok {
        return LZ_OK;
      }
      return LZ_NO;
    },
  }
}

/// Maps page cache slot `slot` read-only at window page q of process pid.
fn lazy_share(k: &mut Kernel, pid: u64, q: u64, slot: u64) -> bool
  requires kok(k) && pid < NPROC && q < WPAGES && slot < PC_N
  ensures kok(k)
{
  match take_space(&mut k.spaces, pid) {
    Space::Empty => { return false; },
    Space::Mapped(mut root) => {
      let mut ok = false;
      let sg = wseg_of(q * 4096);
      if root_seg(&mut k.mem, &mut root, sg) {
        ok = pt_borrow(&mut root, 1 + sg, share_l3, &mut k.mem, &mut k.fs.pc, q - sg * WSEG_PAGES, slot);
      }
      put_space(&mut k.spaces, pid, Space::Mapped(root));
      return ok;
    },
  }
}

fn share_l3(l3: &mut PageTable, m: &mut Mem, c: &mut PCache, q: u64, slot: u64) -> bool
  requires pt_level(l3) == 3 && mem_ok(m) && pc_ok(c) && q < WSEG_PAGES && slot < PC_N
  ensures mem_ok(m) && pc_ok(c)
{
  let t = q / L2_PAGES;
  if !pt_has(l3, t) {
    let a = find_free(&mut m);
    if a >= NPAGES {
      return false;
    }
    pt_put(&mut l3, t, pt_new(take_page(&mut m, a), 2));
  }
  return pt_borrow(&mut l3, t, share_l2, &mut m, &mut c, q % L2_PAGES, slot);
}

fn share_l2(l2: &mut PageTable, m: &mut Mem, c: &mut PCache, q: u64, slot: u64) -> bool
  requires pt_level(l2) == 2 && mem_ok(m) && pc_ok(c) && q < L2_PAGES && slot < PC_N
  ensures mem_ok(m) && pc_ok(c)
{
  let t = q / 512;
  if !pt_has(l2, t) {
    let a = find_free(&mut m);
    if a >= NPAGES {
      return false;
    }
    pt_put(&mut l2, t, pt_new(take_page(&mut m, a), 1));
  }
  return pt_borrow(&mut l2, t, pc_map_text, &mut c, slot, q % 512);
}

fn lazy_l3(l3: &mut PageTable, m: &mut Mem, q: u64, f: Frame) -> bool
  requires pt_level(l3) == 3 && mem_ok(m) && q < WSEG_PAGES
  ensures mem_ok(m)
{
  let t = q / L2_PAGES;
  if !pt_has(l3, t) {
    let a = find_free(&mut m);
    if a >= NPAGES {
      give_page(&mut m, f);
      return false;
    }
    pt_put(&mut l3, t, pt_new(take_page(&mut m, a), 2));
  }
  return pt_borrow(&mut l3, t, lazy_l2, &mut m, q % L2_PAGES, f);
}

fn lazy_l2(l2: &mut PageTable, m: &mut Mem, q: u64, f: Frame) -> bool
  requires pt_level(l2) == 2 && mem_ok(m) && q < L2_PAGES
  ensures mem_ok(m)
{
  let t = q / 512;
  if !pt_has(l2, t) {
    let a = find_free(&mut m);
    if a >= NPAGES {
      give_page(&mut m, f);
      return false;
    }
    pt_put(&mut l2, t, pt_new(take_page(&mut m, a), 1));
  }
  return pt_borrow(&mut l2, t, lazy_l1, &mut m, q % 512, f);
}

fn lazy_l1(l1: &mut PageTable, m: &mut Mem, i: u64, f: Frame) -> bool
  requires pt_level(l1) == 1 && mem_ok(m) && i < 512
  ensures mem_ok(m)
{
  if pt_has(l1, i) {
    give_page(&mut m, f);                   // another thread got there first
    return true;
  }
  pt_put_frame(&mut l1, i, f, false);
  return true;
}

/// A page fault of process p on a code page not read yet: reads it
/// (LZ_OK: run p again), or queues the reads of its blocks (LZ_WAIT).
fn lazy_fault(k: &mut Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
  ensures kok(k)
  ensures result <= LZ_WAIT
{
  let va = pget(k.procs, p, reg_word(R_FAULT));
  if va < USER_BASE {
    return LZ_NO;
  }
  return lazy_read(&mut k, p, (va - USER_BASE) / 4096, false);
}

/// Reads every page of window pages from .. to the record covers (before
/// mprotect changes them, which needs them mapped).
fn lazy_fill(k: &mut Kernel, pid: u64, from: u64, to: u64)
  requires kok(k) && pid < NPROC && to <= WPAGES
  ensures kok(k)
{
  let mut q = from;
  while q < to
    invariant kok(k) && pid < NPROC
  {
    let r = lazy_read(&mut k, pid, q, true);
    q = q + 1;
  }
}
