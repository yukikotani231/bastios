// A SATA disk on an AHCI controller (the SATA controllers of PCs from the
// last fifteen years; QEMU's -device ahci, and the q35 machine's own),
// driven by polling: the controller runs, but never interrupts.
//
// The driver takes the controller from the firmware, switches it to AHCI
// mode, and uses the first port with a SATA disk on it. Each read or
// write is one command in slot 0, for one 512-byte sector or one 4 KiB
// block, whose data goes through a page lent to the controller; the driver
// waits for it to finish before doing anything else. A write is followed
// by a cache flush, so the data is on the medium when the write returns.
//
// Disks with logical sectors longer than 512 bytes are left alone (QEMU
// cannot emulate one on AHCI, so a driver for them could not be tested).
//
// The registers (BAR 5) are a block of the device window claimed as an
// `Mmio`. The controller reads and writes only the two pages lent to it at
// start (`Dma`), which come back after the port is stopped at power off:
//
//   cmd   0: the command list (32 headers; only slot 0 is used);
//         1024: the received-FIS area; 2048: slot 0's command table
//         (the command FIS, then one PRD entry at 2048 + 128)
//   buf   identify data, then each sector's data

import "pci.bastio";
import "pages.bastio";
import "bio.bastio";

const AHCI_CLASS: u64 = 0x010601;      // mass storage, SATA, AHCI 1.0
const AHCI_PAGES: u64 = 2;
const AHCI_MAX_LEN: u64 = 0x1100;      // the generic registers and 32 ports
const AHCI_SPINS: u64 = 20000000;
// Polls a command may take; as long as ATA's, since a command that times out
// is still pending in the port and would be mistaken for the next one.
const AHCI_IO_SPINS: u64 = 500000000;
const AHCI_SECTOR: u64 = 512;
const PCI_BAR5: u64 = 0x24;

// Generic host control.
const HBA_CAP: u64 = 0x00;
const CAP_SSS: u64 = 0x8000000;        // staggered spin-up: each port waits for PxCMD.SUD
const HBA_GHC: u64 = 0x04;
const HBA_IS: u64 = 0x08;              // which ports have an interrupt pending
const GHC_IE: u64 = 2;                 // interrupts on
const IE_DONE: u64 = 0x40000003;       // a D2H register or PIO setup FIS, or an error
const HBA_PI: u64 = 0x0C;
const HBA_CAP2: u64 = 0x24;
const HBA_BOHC: u64 = 0x28;
const GHC_AE: u64 = 0x80000000;        // AHCI enable
// A port's registers, from 0x100 + 0x80 * port.
const PX_CLB: u64 = 0x00;
const PX_FB: u64 = 0x08;
const PX_IS: u64 = 0x10;
const PX_IE: u64 = 0x14;
const PX_CMD: u64 = 0x18;
const PX_TFD: u64 = 0x20;
const PX_SIG: u64 = 0x24;
const PX_SSTS: u64 = 0x28;
const PX_SCTL: u64 = 0x2C;
const PX_SERR: u64 = 0x30;
const PX_CI: u64 = 0x38;
const CMD_ST: u64 = 1;
const CMD_SUD: u64 = 2;                // spin up the device
const CMD_POD: u64 = 4;                // power it on (when CMD_CPD says the port can)
const CMD_CPD: u64 = 0x100000;
const SIG_NONE: u64 = 0xFFFFFFFF;      // no D2H register FIS has come since the link reset
const RESET_HOLD: u64 = 20000;         // register reads that hold COMRESET for more than 1 ms
const CMD_FRE: u64 = 0x10;
const CMD_FR: u64 = 0x4000;
const CMD_CR: u64 = 0x8000;
const TFD_BUSY: u64 = 0x88;            // BSY | DRQ
const TFD_ERR: u64 = 1;
const IS_TFE: u64 = 0x40000000;        // task file error
const SIG_SATA: u64 = 0x101;
// ATA commands (and ATA_IDENTIFY, from ata.bastio).
const ATA_READ_EXT: u64 = 0x25;
const ATA_WRITE_EXT: u64 = 0x35;
const ATA_FLUSH_EXT: u64 = 0xEA;

const FIS_AT: u64 = 1024;
const TBL_AT: u64 = 2048;

struct Ahci {
  regs: Mmio,
  cmd: Dma, buf: Dma,
  px: u64,            // where the port's registers start
  sectors: u64,       // 0 when no disk could be started
  busy: bool,         // a command started by ahci_begin has not been polled to its end
  irq: bool,          // the port's completions raise an interrupt (ahci_irq_on)
  extra: Vec[Extra],  // empty, or VIO_BATCH - 1 pages (ahci_install): the data pages of blocks 1 on of a batch
  pages: u64,         // the first `pages` of them are there
}

spec fn ahci_ok(h: &Ahci) -> bool {
  mmio_base(h.regs) % 1024 == 0 && mmio_len(h.regs) <= AHCI_MAX_LEN
  && h.px % 128 == 0 && h.px + 128 <= mmio_len(h.regs)
  && h.pages < VIO_BATCH
}

/// v with bit b (a power of two below 2^32) set, or cleared.
fn bit_set(v: u64, b: u64) -> u64
  requires v <= 4294967295 && 1 <= b && b <= 0x80000000
  ensures result <= 4294967295
{
  if v / b % 2 == 1 || v + b > 4294967295 {
    return v;
  }
  return v + b;
}

fn bit_clear(v: u64, b: u64) -> u64
  requires v <= 4294967295 && 1 <= b && b <= 0x80000000
  ensures result <= 4294967295
{
  if v / b % 2 == 1 && v >= b {
    return v - b;
  }
  return v;
}

fn ar(h: &mut Ahci, off: u64) -> u64
  requires mmio_base(h.regs) % 1024 == 0 && off % 4 == 0 && off + 4 <= mmio_len(h.regs)
  ensures result <= 4294967295
{
  return cast[u64](mmio_read32(&mut h.regs, off));
}

fn aw(h: &mut Ahci, off: u64, v: u64)
  requires mmio_base(h.regs) % 1024 == 0 && off % 4 == 0 && off + 4 <= mmio_len(h.regs) && v <= 4294967295
{
  mmio_write32(&mut h.regs, off, cast[u32](v));
}

/// Port register r.
fn pr(h: &mut Ahci, r: u64) -> u64
  requires ahci_ok(h) && r % 4 == 0 && r < 128
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && result <= 4294967295
{
  return ar(&mut h, h.px + r);
}

fn pw(h: &mut Ahci, r: u64, v: u64)
  requires ahci_ok(h) && r % 4 == 0 && r < 128 && v <= 4294967295
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  aw(&mut h, h.px + r, v);
}

/// Waits until port register r has none of the bits in `mask` set.
fn port_clear(h: &mut Ahci, r: u64, mask: u64) -> bool
  requires ahci_ok(h) && r % 4 == 0 && r < 128
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  let sec0 = h.sectors;
  let mut i = 0;
  while i < AHCI_SPINS
    invariant ahci_ok(h) && h.sectors == sec0
  {
    if pr(&mut h, r) & mask == 0 {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Stops the port's command engine and its FIS receiving: afterwards the
/// controller does not touch the command list or the FIS area.
fn port_stop(h: &mut Ahci) -> bool
  requires ahci_ok(h)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  let c = pr(&mut h, PX_CMD);
  pw(&mut h, PX_CMD, bit_clear(c, CMD_ST));
  if !port_clear(&mut h, PX_CMD, CMD_CR) {
    return false;
  }
  let c2 = pr(&mut h, PX_CMD);
  pw(&mut h, PX_CMD, bit_clear(c2, CMD_FRE));
  return port_clear(&mut h, PX_CMD, CMD_FR);
}

/// Brings up the port's link if the firmware did not. A controller with
/// staggered spin-up leaves each device off until its port's SUD bit is
/// set, and firmware that boots fast (from another disk) may leave a port's
/// link down. Such a port gets SUD (and POD), and, if its link is still not
/// up, a COMRESET: SCTL's DET field at 1 for over a millisecond, then 0,
/// and a wait for the link. The device's signature may then come only once
/// FIS receiving is on (ahci_new). A port whose link is up is left as it
/// is, unless `reset` (the boot option ahci_reset, for a disk that is not
/// found otherwise).
fn port_wake(h: &mut Ahci, sss: bool, reset: bool)
  requires ahci_ok(h)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  let c = pr(&mut h, PX_CMD);
  let mut v = c;
  if sss {
    v = bit_set(v, CMD_SUD);
  }
  if c / CMD_CPD % 2 == 1 {
    v = bit_set(v, CMD_POD);
  }
  if v != c {
    pw(&mut h, PX_CMD, v);
  }
  let det = pr(&mut h, PX_SSTS) % 16;
  if (det == 3 && !reset) || (det == 0 && !sss) {
    return;                           // up, or nothing attached
  }
  if !port_stop(&mut h) {
    return;                           // a COMRESET needs the port stopped
  }
  let sctl = pr(&mut h, PX_SCTL);
  let base = sctl - sctl % 16;
  pw(&mut h, PX_SCTL, base + 1);
  let mut i = 0;
  while i < RESET_HOLD
    invariant ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
  {
    pr(&mut h, PX_SSTS);
    i = i + 1;
  }
  pw(&mut h, PX_SCTL, base);
  let mut up = false;
  i = 0;
  while i < AHCI_SPINS && !up
    invariant ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
  {
    up = pr(&mut h, PX_SSTS) % 16 == 3;
    i = i + 1;
  }
  pw(&mut h, PX_SERR, 4294967295);
}

/// Issues the command set up in slot 0 and waits for it; true if the disk
/// reported no error.
fn ahci_issue(h: &mut Ahci) -> bool
  requires ahci_ok(h)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  ahci_fire(&mut h);
  let sec0 = h.sectors;
  let busy0 = h.busy;
  let mut i = 0;
  while i < AHCI_IO_SPINS
    invariant ahci_ok(h) && h.sectors == sec0 && h.busy == busy0
  {
    let st = ahci_check(&mut h);
    if st != BIO_RUNNING {
      return st == BIO_OK;
    }
    i = i + 1;
  }
  // Timed out. The command may still be running, and would then write to
  // our data page when it ends, in the middle of the next command. Stopping
  // the command engine ends it (PxCI is cleared); then it is started again,
  // so that the next command has an engine to run on.
  if port_stop(&mut h) {
    let c1 = pr(&mut h, PX_CMD);
    pw(&mut h, PX_CMD, bit_set(c1, CMD_FRE));
    let c2 = pr(&mut h, PX_CMD);
    pw(&mut h, PX_CMD, bit_set(c2, CMD_ST));
  }
  return false;
}

/// Issues the command set up in slot 0.
fn ahci_fire(h: &mut Ahci)
  requires ahci_ok(h)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  pw(&mut h, PX_IS, 4294967295);
  pw(&mut h, PX_CI, 1);
}

/// How the command issued in slot 0 stands: BIO_RUNNING, BIO_OK or
/// BIO_FAILED.
fn ahci_check(h: &mut Ahci) -> u64
  requires ahci_ok(h)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy) && result <= BIO_FAILED
{
  if pr(&mut h, PX_IS) & IS_TFE != 0 {
    return BIO_FAILED;
  }
  if pr(&mut h, PX_CI) % 2 == 0 {
    if pr(&mut h, PX_TFD) & TFD_ERR == 0 {
      return BIO_OK;
    }
    return BIO_FAILED;
  }
  return BIO_RUNNING;
}

/// Sets up slot 0 for ATA command `op` on logical sector `lba`, `count`
/// of them, moving `bytes` bytes (at most a page; 0 for none) through
/// `buf` (to the disk if `write`), and runs it. Fails while a command
/// started by ahci_begin runs.
fn ahci_cmd(h: &mut Ahci, op: u64, lba: u64, count: u64, bytes: u64, write: bool) -> bool
  requires ahci_ok(h) && op < 256 && lba < 0x1000000000000 && count < 65536 && bytes <= 4096
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  if h.busy {
    return false;
  }
  ahci_setup(&mut h, op, lba, count, bytes, write);
  return ahci_issue(&mut h);
}

/// Sets up slot 0 for ATA command `op` (see ahci_cmd) without issuing it.
fn ahci_setup(h: &mut Ahci, op: u64, lba: u64, count: u64, bytes: u64, write: bool)
  requires ahci_ok(h) && op < 256 && lba < 0x1000000000000 && count < 65536 && bytes <= 4096
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  let t = dma_phys(h.cmd) + TBL_AT;
  let mut flags = 5;                  // the command FIS is 5 dwords
  if write {
    flags = flags + 64;
  }
  if bytes > 0 {
    flags = flags + 65536;            // one PRD entry
  }
  dma_write32(&mut h.cmd, 0, cast[u32](flags));
  dma_write32(&mut h.cmd, 4, 0);
  dma_write64(&mut h.cmd, 8, t);
  dma_write64(&mut h.cmd, 16, 0);
  dma_write64(&mut h.cmd, 24, 0);
  // The command FIS: register, host to device.
  let sec0 = h.sectors;
  let busy0 = h.busy;
  let mut i = 0;
  while i < 128
    invariant i <= 128 && i % 8 == 0 && ahci_ok(h) && h.sectors == sec0 && h.busy == busy0
  {
    dma_write64(&mut h.cmd, TBL_AT + i, 0);
    i = i + 8;
  }
  dma_write8(&mut h.cmd, TBL_AT, 0x27);
  dma_write8(&mut h.cmd, TBL_AT + 1, 0x80);
  dma_write8(&mut h.cmd, TBL_AT + 2, cast[u8](op));
  dma_write8(&mut h.cmd, TBL_AT + 4, cast[u8](lba % 256));
  dma_write8(&mut h.cmd, TBL_AT + 5, cast[u8](lba / 256 % 256));
  dma_write8(&mut h.cmd, TBL_AT + 6, cast[u8](lba / 65536 % 256));
  dma_write8(&mut h.cmd, TBL_AT + 7, 0x40);              // LBA mode
  dma_write8(&mut h.cmd, TBL_AT + 8, cast[u8](lba / 16777216 % 256));
  dma_write8(&mut h.cmd, TBL_AT + 9, cast[u8](lba / 4294967296 % 256));
  dma_write8(&mut h.cmd, TBL_AT + 10, cast[u8](lba / 1099511627776 % 256));
  dma_write8(&mut h.cmd, TBL_AT + 12, cast[u8](count % 256));
  dma_write8(&mut h.cmd, TBL_AT + 13, cast[u8](count / 256));
  // The PRD entry: the data page.
  if bytes > 0 {
    dma_write64(&mut h.cmd, TBL_AT + 128, dma_phys(h.buf));
    dma_write32(&mut h.cmd, TBL_AT + 136, 0);
    dma_write32(&mut h.cmd, TBL_AT + 140, cast[u32](bytes - 1));
  }
}

/// Reads or writes `count` sectors from `lba` through the data page.
fn ahci_io(h: &mut Ahci, write: bool, lba: u64, count: u64) -> bool
  requires ahci_ok(h) && lba < 0x1000000000000 && 1 <= count && count <= 8
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  let bytes = count * AHCI_SECTOR;
  if write {
    return ahci_cmd(&mut h, ATA_WRITE_EXT, lba, count, bytes, true);
  }
  return ahci_cmd(&mut h, ATA_READ_EXT, lba, count, bytes, false);
}

fn ahci_flush(h: &mut Ahci) -> bool
  requires ahci_ok(h)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  return ahci_cmd(&mut h, ATA_FLUSH_EXT, 0, 0, 0, false);
}

/// Starts the first SATA disk on the controller whose registers are
/// `regs`, lending it two pages. Without one, `sectors` stays 0.
/// Points the port at the pages and turns FIS receiving on; true if the
/// device is then ready and is a SATA disk. Otherwise the port is stopped
/// again.
fn port_start(h: &mut Ahci) -> bool
  requires ahci_ok(h)
  ensures ahci_ok(h)
{
  if !port_stop(&mut h) {
    return false;
  }
  let mut i = 0;
  while i < 4096
    invariant i <= 4096 && i % 8 == 0 && ahci_ok(h)
  {
    dma_write64(&mut h.cmd, i, 0);
    i = i + 8;
  }
  let c = dma_phys(h.cmd);
  pw(&mut h, PX_CLB, c % 4294967296);
  pw(&mut h, PX_CLB + 4, c / 4294967296 % 4294967296);
  pw(&mut h, PX_FB, (c + FIS_AT) % 4294967296);
  pw(&mut h, PX_FB + 4, (c + FIS_AT) / 4294967296 % 4294967296);
  pw(&mut h, PX_SERR, 4294967295);
  pw(&mut h, PX_IS, 4294967295);
  pw(&mut h, PX_IE, 0);
  let c1 = pr(&mut h, PX_CMD);
  pw(&mut h, PX_CMD, bit_set(c1, CMD_FRE));
  let mut k = 0;
  while k < AHCI_SPINS && pr(&mut h, PX_SIG) == SIG_NONE
    invariant ahci_ok(h)
  {
    k = k + 1;
  }
  if pr(&mut h, PX_SIG) == SIG_SATA && port_clear(&mut h, PX_TFD, TFD_BUSY) {
    return true;
  }
  port_stop(&mut h);
  return false;
}

fn ahci_new(regs: Mmio, f0: Frame, f1: Frame, reset: bool) -> Ahci
  requires mmio_base(regs) % 1024 == 0 && mmio_len(regs) <= AHCI_MAX_LEN && mmio_len(regs) >= 0x180
  ensures ahci_ok(result) && mmio_base(result.regs) == mmio_base(regs) && mmio_len(result.regs) == mmio_len(regs) && vlen(result.extra) == 0
{
  let mut h = Ahci { regs: regs, cmd: dma_lend(f0), buf: dma_lend(f1), px: 0x100, sectors: 0, busy: false, irq: false,
    extra: vec_new[Extra](), pages: 0 };
  // Take the controller from the firmware if it supports the handoff,
  // then switch it to AHCI mode.
  if ar(&mut h, HBA_CAP2) % 2 == 1 {
    let bohc = ar(&mut h, HBA_BOHC);
    aw(&mut h, HBA_BOHC, bit_set(bohc, 2));
    let mut i = 0;
    while i < AHCI_SPINS
      invariant ahci_ok(h)
    {
      if ar(&mut h, HBA_BOHC) % 2 == 0 {
        i = AHCI_SPINS;
      } else {
        i = i + 1;
      }
    }
  }
  let ghc = ar(&mut h, HBA_GHC);
  aw(&mut h, HBA_GHC, bit_set(ghc, GHC_AE));
  // The first implemented port with a device present and a SATA disk's
  // signature (an ATAPI drive, such as a CD, has another). A port with its
  // link up but no signature yet (one the firmware left alone, or that
  // port_wake reset) is tried too: its device sends the signature only
  // once FIS receiving is on (port_start).
  let mut pi = ar(&mut h, HBA_PI);
  let sss = ar(&mut h, HBA_CAP) / CAP_SSS % 2 == 1;
  let n = mmio_len(h.regs);
  let mut p = 0;
  let mut found = false;
  while p < 32 && !found
    invariant p <= 32 && ahci_ok(h) && mmio_len(h.regs) == n
  {
    let px = 0x100 + p * 128;
    if pi % 2 == 1 && px + 128 <= n {
      h.px = px;
      port_wake(&mut h, sss, reset);
      if pr(&mut h, PX_SSTS) % 16 == 3 {
        let sig = pr(&mut h, PX_SIG);
        if sig == SIG_SATA || sig == SIG_NONE {
          found = port_start(&mut h);
        }
      }
    }
    if !found {
      p = p + 1;
      pi = pi / 2;
    }
  }
  if !found {
    return h;
  }
  let c2 = pr(&mut h, PX_CMD);
  pw(&mut h, PX_CMD, bit_set(c2, CMD_ST));
  // IDENTIFY DEVICE: words 100-103 are the LBA48 sector count. Word 106
  // says (bit 12, when bits 15-14 are 01) that sectors are longer than
  // 512 bytes.
  if !ahci_cmd(&mut h, ATA_IDENTIFY, 0, 0, 512, false) {
    return h;
  }
  let size = dma_read64(&mut h.buf, 200);
  let w106 = cast[u64](dma_read16(&mut h.buf, 212));
  let long = w106 / 16384 == 1 && w106 / 4096 % 2 == 1;
  if size < 0x1000000000000 && !long {
    h.sectors = size;
  }
  return h;
}

/// Stops the port (so the controller lets go of the pages) and takes the
/// pages back (at power off). Returns the registers.
fn ahci_free(h: Ahci, m: &mut Mem) -> Mmio
  requires ahci_ok(h) && mem_ok(m)
  ensures mem_ok(m) && mmio_base(result) == mmio_base(h.regs) && mmio_len(result) == mmio_len(h.regs)
{
  let mut d = h;
  port_stop(&mut d);
  give_page(&mut m, dma_take(d.cmd));
  give_page(&mut m, dma_take(d.buf));
  while vec_len(d.extra) > 0
    invariant mem_ok(m)
  {
    match vec_pop(&mut d.extra) {
      Extra::None => {},
      Extra::Page(x) => { give_page(&mut m, dma_take(x)); },
    }
  }
  vec_free(d.extra);
  return d.regs;
}

/// Copies the data page's bytes from `from` (cnt bytes, multiples of 8) to
/// out[at..].
fn ahci_out(d: &mut Dma, from: u64, cnt: u64, out: &mut Bytes, at: u64)
  requires from + cnt <= 4096 && from % 8 == 0 && cnt % 8 == 0 && at + cnt <= blen(out)
  ensures blen(out) == old(blen(out))
{
  dma_to_bytes(&mut out, at, &mut d, from, cnt);
}

/// Copies src[at..at + cnt] into the data page from `to`.
fn ahci_in(d: &mut Dma, to: u64, cnt: u64, src: &Bytes, at: u64)
  requires to + cnt <= 4096 && to % 8 == 0 && cnt % 8 == 0 && at + cnt <= blen(src)
{
  bytes_to_dma(&mut d, to, src, at, cnt);
}

/// Reads sector `lba` into buf[0..512]. Returns false if the disk fails or
/// the sector is past its end.
fn ahci_read(h: &mut Ahci, lba: u64, buf: &mut Bytes) -> bool
  requires ahci_ok(h) && blen(buf) >= AHCI_SECTOR
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy) && blen(buf) == old(blen(buf))
{
  if lba >= h.sectors || lba >= 0x1000000000000 {
    return false;
  }
  if !ahci_io(&mut h, false, lba, 1) {
    return false;
  }
  ahci_out(&mut h.buf, 0, AHCI_SECTOR, &mut buf, 0);
  return true;
}

/// Writes buf[0..512] to sector `lba`, then flushes the disk's cache.
fn ahci_write(h: &mut Ahci, lba: u64, buf: &Bytes) -> bool
  requires ahci_ok(h) && blen(buf) >= AHCI_SECTOR
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  if lba >= h.sectors || lba >= 0x1000000000000 {
    return false;
  }
  ahci_in(&mut h.buf, 0, AHCI_SECTOR, buf, 0);
  return ahci_io(&mut h, true, lba, 1) && ahci_flush(&mut h);
}

/// Reads the 4 KiB block at sector `lba` (a multiple of 8) into
/// out[at..at + 4096] with one command.
fn ahci_read_block(h: &mut Ahci, lba: u64, out: &mut Bytes, at: u64) -> bool
  requires ahci_ok(h) && at + 4096 <= blen(out)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy) && blen(out) == old(blen(out))
{
  if lba % 8 != 0 || lba >= h.sectors || h.sectors - lba < 8 || lba >= 0x1000000000000 {
    return false;
  }
  if !ahci_io(&mut h, false, lba, 8) {
    return false;
  }
  ahci_out(&mut h.buf, 0, 4096, &mut out, at);
  return true;
}

/// Writes src[at..at + 4096] to the 4 KiB block at sector `lba` (a
/// multiple of 8) with one command, then flushes the disk's cache.
fn ahci_write_block(h: &mut Ahci, lba: u64, src: &Bytes, at: u64) -> bool
  requires ahci_ok(h) && at + 4096 <= blen(src)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  if lba % 8 != 0 || lba >= h.sectors || h.sectors - lba < 8 || lba >= 0x1000000000000 {
    return false;
  }
  ahci_in(&mut h.buf, 0, 4096, src, at);
  return ahci_io(&mut h, true, lba, 8) && ahci_flush(&mut h);
}

// Commands that run while the kernel does something else (see
// src/bio.bastio): one at a time, in slot 0.

/// Starts reading or writing (from src[at..at + 4096]) the block at
/// sector `lba` (a multiple of 8), or flushing the disk's cache. False if
/// a command is already running or the block is not whole on the disk.
fn ahci_begin(h: &mut Ahci, op: u64, lba: u64, src: &Bytes, at: u64) -> bool
  requires ahci_ok(h) && op <= BIO_FLUSH && at + 4096 <= blen(src)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && (result ==> h.busy)
{
  if h.busy {
    return false;
  }
  if op == BIO_FLUSH {
    ahci_setup(&mut h, ATA_FLUSH_EXT, 0, 0, 0, false);
  } else {
    if lba % 8 != 0 || lba >= h.sectors || h.sectors - lba < 8 || lba >= 0x1000000000000 {
      return false;
    }
    if op == BIO_WRITE {
      ahci_in(&mut h.buf, 0, 4096, src, at);
      ahci_setup(&mut h, ATA_WRITE_EXT, lba, 8, 4096, true);
    } else {
      ahci_setup(&mut h, ATA_READ_EXT, lba, 8, 4096, false);
    }
  }
  ahci_fire(&mut h);
  h.busy = true;
  return true;
}

fn ahci_poll(h: &mut Ahci) -> u64
  requires ahci_ok(h)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && result <= BIO_IDLE
  ensures result == BIO_RUNNING ==> h.busy
{
  if !h.busy {
    return BIO_IDLE;
  }
  let st = ahci_check(&mut h);
  if st != BIO_RUNNING {
    h.busy = false;
    if h.irq {
      // Acknowledge it: the port's status, then the controller's.
      pw(&mut h, PX_IS, 4294967295);
      aw(&mut h, HBA_IS, ahci_port_bit(h.px));
    }
  }
  return st;
}

/// The bit of port register block `px` in HBA_IS and PI.
fn ahci_port_bit(px: u64) -> u64
  ensures 1 <= result && result <= 2147483648
{
  let mut b = 1;
  let mut i = 0;
  while i < 31 && 0x100 + i * 128 < px && b <= 1073741824
    invariant 1 <= b && b <= 2147483648 && i <= 31
  {
    b = b * 2;
    i = i + 1;
  }
  return b;
}

/// Lets the port's completions and errors raise the controller's
/// interrupt, which the caller has pointed somewhere (MSI).
fn ahci_irq_on(h: &mut Ahci)
  requires ahci_ok(h)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  pw(&mut h, PX_IS, 4294967295);
  pw(&mut h, PX_IE, IE_DONE);
  let ghc = ar(&mut h, HBA_GHC);
  aw(&mut h, HBA_GHC, bit_set(ghc, GHC_IE));
  h.irq = true;
}

/// Copies the data page (a finished read's block) to out[at..at + 4096].
fn ahci_fetch(h: &mut Ahci, out: &mut Bytes, at: u64)
  requires ahci_ok(h) && at + 4096 <= blen(out)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy) && blen(out) == old(blen(out))
{
  ahci_out(&mut h.buf, 0, 4096, &mut out, at);
}

/// Gives the port the pages of batched commands: `extra` holds VIO_BATCH - 1
/// entries, data pages for blocks 1 on; `pages` of them (from the first) are
/// there.
fn ahci_install(h: &mut Ahci, extra: Vec[Extra], pages: u64)
  requires ahci_ok(h) && vlen(extra) == VIO_BATCH - 1 && pages < VIO_BATCH && vlen(h.extra) == 0
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  vec_free(h.extra);
  h.extra = extra;
  h.pages = pages;
}

/// The address of extra data page i, or 0 if it is not there.
fn ahci_extra_addr(h: &mut Ahci, i: u64) -> u64
  requires ahci_ok(h) && i < VIO_BATCH - 1
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  if i >= vec_len(h.extra) {
    return 0;
  }
  match vec_swap(&mut h.extra, i, Extra::None) {
    Extra::None => { return 0; },
    Extra::Page(x) => {
      let a = dma_phys(x);
      match vec_swap(&mut h.extra, i, Extra::Page(x)) {
        Extra::None => {},
        Extra::Page(_y) => { unreachable; },
      }
      return a;
    },
  }
}

/// How many consecutive blocks from sector `lba` one command can take (up
/// to `want`): the pages there are, and the end of the disk.
fn ahci_room(h: &Ahci, lba: u64, want: u64) -> u64
  requires ahci_ok(h)
  ensures result >= 1 && result <= VIO_BATCH
{
  if want <= 1 || h.pages == 0 || lba >= h.sectors || lba >= 0x1000000000000 {
    return 1;
  }
  let mut c = want;
  if c > h.pages + 1 {
    c = h.pages + 1;
  }
  let left = (h.sectors - lba) / 8;
  if c > left {
    c = left;
  }
  if c < 1 {
    return 1;
  }
  return c;
}

/// Starts reading `cnt` (from ahci_room) consecutive blocks from sector
/// `lba` in one command: the first into the data page, the rest into the
/// extra pages, one PRD entry each. With `wr`, writes the blocks ahci_stage
/// put in place instead. False if a command is running or a page is missing.
fn ahci_begin_n(h: &mut Ahci, lba: u64, cnt: u64, wr: bool) -> bool
  requires ahci_ok(h) && cnt >= 1 && cnt <= VIO_BATCH
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && (result ==> h.busy)
{
  if h.busy || cnt > h.pages + 1 || lba % 8 != 0 || lba >= h.sectors || lba >= 0x1000000000000
    || (h.sectors - lba) / 8 < cnt {
    return false;
  }
  // Every page must be there before anything is set up.
  let mut j = 1;
  while j < cnt
    invariant j >= 1 && j <= cnt && cnt <= VIO_BATCH && ahci_ok(h)
  {
    if ahci_extra_addr(&mut h, j - 1) == 0 {
      return false;
    }
    j = j + 1;
  }
  if wr {
    ahci_setup(&mut h, ATA_WRITE_EXT, lba, cnt * 8, 4096, true);
  } else {
    ahci_setup(&mut h, ATA_READ_EXT, lba, cnt * 8, 4096, false);
  }
  // The header counts cnt PRD entries (ahci_setup wrote one); the entries
  // after the first follow it in the command table.
  let mut flags = 5 + cnt * 65536;
  if wr {
    flags = flags + 64;
  }
  dma_write32(&mut h.cmd, 0, cast[u32](flags));
  let mut k = 1;
  while k < cnt
    invariant k >= 1 && k <= cnt && cnt <= VIO_BATCH && ahci_ok(h)
  {
    let a = ahci_extra_addr(&mut h, k - 1);
    dma_write64(&mut h.cmd, TBL_AT + 128 + k * 16, a);
    dma_write32(&mut h.cmd, TBL_AT + 136 + k * 16, 0);
    dma_write32(&mut h.cmd, TBL_AT + 140 + k * 16, 4095);
    k = k + 1;
  }
  ahci_fire(&mut h);
  h.busy = true;
  return true;
}

/// Puts src[at ..] where block j of the next ahci_begin_n write is taken
/// from. False where there is no such page.
fn ahci_stage(h: &mut Ahci, j: u64, src: &Bytes, at: u64) -> bool
  requires ahci_ok(h)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy)
{
  if h.busy || j >= VIO_BATCH || at > blen(src) || blen(src) - at < 4096 {
    return false;
  }
  if j == 0 {
    ahci_in(&mut h.buf, 0, 4096, src, at);
    return true;
  }
  if h.pages == 0 || j > h.pages || j > vec_len(h.extra) {
    return false;
  }
  match vec_swap(&mut h.extra, j - 1, Extra::None) {
    Extra::None => { return false; },
    Extra::Page(x) => {
      let mut d = x;
      ahci_in(&mut d, 0, 4096, src, at);
      match vec_swap(&mut h.extra, j - 1, Extra::Page(d)) {
        Extra::None => {},
        Extra::Page(_y) => { unreachable; },
      }
      return true;
    },
  }
}

/// After a read started by ahci_begin_n has finished well: block j of it
/// into out[at .. at + 4096].
fn ahci_fetch_n(h: &mut Ahci, j: u64, out: &mut Bytes, at: u64)
  requires ahci_ok(h) && at + 4096 <= blen(out)
  ensures ahci_ok(h) && h.sectors == old(h.sectors) && h.busy == old(h.busy) && blen(out) == old(blen(out))
{
  if j == 0 {
    ahci_out(&mut h.buf, 0, 4096, &mut out, at);
    return;
  }
  if h.pages == 0 || j > h.pages || j > vec_len(h.extra) {
    return;
  }
  match vec_swap(&mut h.extra, j - 1, Extra::None) {
    Extra::None => {},
    Extra::Page(x) => {
      let mut d = x;
      ahci_out(&mut d, 0, 4096, &mut out, at);
      match vec_swap(&mut h.extra, j - 1, Extra::Page(d)) {
        Extra::None => {},
        Extra::Page(_y) => { unreachable; },
      }
    },
  }
}
