// Linux process calls: fork, execve, wait4, and the file metadata calls a
// shell needs to find programs (stat, access). Programs are the kernel's
// built-in images, found at /bin/NAME; files are the file system's, at
// /NAME.

import "linux.bastio";
import "lxdev.bastio";
import "core/endian.bastio";
import "core/bytes.bastio";

const BANG_MAX: u64 = 256;               // the bytes of a "#!" line looked at, as Linux

// ---------------------------------------------------------------- fork

/// fork (and vfork, which may share memory but need not): a copy of
/// process `pid` (its window, registers, FPU state, program break) that
/// returns 0 where the parent gets the child's id. The child shares the
/// parent's open descriptors. Returns the child's id or -errno.
fn lx_fork(k: &mut Kernel, mmu: &Mmu, pid: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let lim = nproc_check(k, pid);
  if lim != 0 {
    return lim;                             // -EAGAIN: RLIMIT_NPROC
  }
  if !cg_fork_ok(k, pid) {
    return EAGAIN;                          // a control group's pids.max (src/lxcgroup.bastio)
  }
  if !pidns_room(k, pid) {
    return ENOMEM;                          // the init of its PID namespace has ended
  }
  let c = new_pid(&mut k);
  if c == 0 {
    return EAGAIN;
  }
  pidfd_reuse(&mut k, c);                   // pidfds on the slot's last process (src/lxpidfd.bastio)
  let fp = find_free(&mut k.mem);
  if fp >= NPAGES {
    return ENOMEM;
  }
  let mut fpu = take_page(&mut k.mem, fp);
  match take_fpu(&mut k.fpus, pid) {
    Fpu::None => {},
    Fpu::State(g) => {
      copy_frame(&mut fpu, g);
      put_fpu(&mut k.fpus, pid, Fpu::State(g));
    },
  }
  let solo = group_alone(&mut k, pid);
  match fork_space(&mut k.mem, &mut k.spaces, pid, solo) {
    Space::Empty => {
      give_page(&mut k.mem, fpu);
      return ENOMEM;
    },
    Space::Mapped(t) => { return fork_into(&mut k, mmu, pid, c, t, fpu); },
  }
}

/// clone(CLONE_VM | CLONE_VFORK, stack), as posix_spawn makes it: the
/// child runs in the parent's own address space, on `stack`, while the
/// parent waits (LXVFORK). The space is not shared: it moves to the child
/// and moves back when the child calls execve or ends (vfork_give_back).
fn lx_vfork_vm(k: &mut Kernel, mmu: &Mmu, pid: u64, stack: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  if !pidns_room(k, pid) {
    return ENOMEM;                          // the init of its PID namespace has ended
  }
  if !cg_fork_ok(k, pid) {
    return EAGAIN;                          // a control group's pids.max (src/lxcgroup.bastio)
  }
  let c = new_pid(&mut k);
  if c == 0 {
    return EAGAIN;
  }
  pidfd_reuse(&mut k, c);                   // pidfds on the slot's last process (src/lxpidfd.bastio)
  // fork_into frees the space it is given if c turns out to have one:
  // that must never be the parent's.
  match take_space(&mut k.spaces, c) {
    Space::Empty => {},
    Space::Mapped(u) => {
      put_space(&mut k.spaces, c, Space::Mapped(u));
      return EAGAIN;
    },
  }
  let fp = find_free(&mut k.mem);
  if fp >= NPAGES {
    return ENOMEM;
  }
  let mut fpu = take_page(&mut k.mem, fp);
  match take_fpu(&mut k.fpus, pid) {
    Fpu::None => {},
    Fpu::State(g) => {
      copy_frame(&mut fpu, g);
      put_fpu(&mut k.fpus, pid, Fpu::State(g));
    },
  }
  match take_space(&mut k.spaces, pid) {
    Space::Empty => {
      give_page(&mut k.mem, fpu);
      return ENOMEM;
    },
    Space::Mapped(t) => {
      if fork_into(&mut k, mmu, pid, c, t, fpu) != c {
        return EAGAIN;
      }
    },
  }
  if stack != 0 {
    pset(&mut k.procs, c, F_REGS + R_RSP, stack);
  }
  ret(&mut k.procs, pid, vpid_of(k, pid, c));
  pset(&mut k.procs, pid, F_WAIT, c);
  pset(&mut k.procs, pid, F_STATE, LXVFORK);
  return c;
}

/// If process `c` runs in an address space its parent lent it (see
/// lx_vfork_vm), gives the space back and wakes the parent. Afterwards c
/// has no address space.
fn vfork_give_back(k: &mut Kernel, mmu: &Mmu, c: u64)
  requires kok(k) && 1 <= c && c < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let par = pget(k.procs, c, F_PARENT);
  if par == 0 || par >= NPROC || state(k.procs, par) != LXVFORK || pget(k.procs, par, F_WAIT) != c {
    return;
  }
  match take_space(&mut k.spaces, c) {
    Space::Empty => {},
    Space::Mapped(t) => {
      match take_space(&mut k.spaces, par) {
        Space::Empty => { put_space(&mut k.spaces, par, Space::Mapped(t)); },
        Space::Mapped(u) => {
          put_space(&mut k.spaces, par, Space::Mapped(u));
          free_space(&mut k.mem, mmu, t);
        },
      }
    },
  }
  pset(&mut k.procs, par, F_WAIT, 0);
  pset(&mut k.procs, par, F_STATE, READY);
}

/// lx_fork, once the child's address space `t` and FPU page are made:
/// installs them as process `c`, a copy of `pid`.
fn fork_into(k: &mut Kernel, mmu: &Mmu, pid: u64, c: u64, t: PageTable, fpu: Frame) -> u64
  requires kok(k) && pid < NPROC && 1 <= c && c < NPROC && pt_level(t) == 4 && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  // A FREE process has no address space; check it rather than assume it.
  match take_space(&mut k.spaces, c) {
    Space::Empty => {},
    Space::Mapped(u) => {
      put_space(&mut k.spaces, c, Space::Mapped(u));
      free_space(&mut k.mem, mmu, t);
      give_page(&mut k.mem, fpu);
      return EAGAIN;
    },
  }
  put_space(&mut k.spaces, c, Space::Mapped(t));
  drop_fpu(&mut k.mem, take_fpu(&mut k.fpus, c));
  put_fpu(&mut k.fpus, c, Fpu::State(fpu));
  let mut f = 0;
  while f < STRIDE
    invariant f <= STRIDE && ptab_ok(k.procs)
  {
    pset(&mut k.procs, c, f, pget(k.procs, pid, f));
    f = f + 1;
  }
  pset(&mut k.procs, c, F_WAIT, 0);
  pset(&mut k.procs, c, F_CODE, 0);
  pset(&mut k.procs, c, F_TICKS, 0);
  pset(&mut k.procs, c, F_START, k.ns / 10000000 + 1);
  pset(&mut k.procs, c, F_PARENT, pid);
  pset(&mut k.procs, c, F_REGS + R_RAX, 0);
  pset(&mut k.procs, c, F_TGID, 0);         // a fork of a thread is a new process
  pr_fork(&mut k, pid, c);
  group_fork(&mut k.procs, pid, c);
  pset(&mut k.procs, c, F_CTID, 0);
  pset(&mut k.procs, c, F_FUTEX, 0);
  pset(&mut k.procs, c, F_QUIET, 0);
  let mut w = F_VTIMER;
  while w < F_PTIMER + 2
    invariant F_VTIMER <= w && w <= F_PTIMER + 2 && ptab_ok(k.procs) && kok(k)
  {
    pset(&mut k.procs, c, w, 0);            // a child does not inherit interval timers
    w = w + 1;
  }
  lx_fd_fork(&mut k, pid, c);
  map_fork(&mut k, pid, c);
  hole_fork(&mut k, pid, c);
  anon_fork(&mut k, pid, c);
  lazy_fork(&mut k, pid, c);
  shm_fork(&mut k, pid, c);
  sig_fork(&mut k.sigact, pid, c);
  cwd_fork(&mut k.cwd, pid, c);
  cwd_fork(&mut k.croot, pid, c);
  k.mns = set(k.mns, c, get(k.mns, pid));   // the same mount namespace (src/lxns.bastio)
  nsk_fork(&mut k.mns, pid, c);             // and the same others (src/lxnsk.bastio)
  pidns_enter(&mut k, pid, c);              // with an id in the PID namespace children start in
  pset(&mut k.procs, c, F_SIGPEND, 0);
  pset(&mut k.procs, c, F_RESTART, 0);
  pset(&mut k.procs, c, F_ASLEEP, 0);       // it has not run yet, whatever its parent was doing
  pset(&mut k.procs, c, F_STATE, READY);
  return c;
}

/// A copy of process `pid`'s address space, or `Space::Empty`.
/// Copy-on-write (`solo`: pid has no other thread, src/lxcow.bastio) if
/// no processor runs the space now.
fn fork_space(m: &mut Mem, spaces: &mut Vec[Space], pid: u64, solo: bool) -> Space
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC
  ensures mem_ok(m) && spaces_ok(spaces)
  ensures result is Space::Mapped ==> pt_level(result.Mapped) == 4
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return Space::Empty; },
    Space::Mapped(mut root) => {
      let cow = solo && pt_lease_count(&mut root) == 0;
      let c = clone_space(&mut m, &mut root, cow);
      put_space(&mut spaces, pid, Space::Mapped(root));
      return c;
    },
  }
}

// ---------------------------------------------------------------- execve

/// execve(path, argv, envp): replaces process `pid`'s program with the one
/// at `path` (/bin/NAME, or an ELF file /NAME), passing argv and envp.
/// Descriptors stay open unless marked close-on-exec. Returns 0 (the new program's rax) or -errno, in
/// which case the old program carries on. execveat's dirfd and flags
/// (AT_FDCWD and 0 for execve) say where a relative path starts, and with
/// AT_EMPTY_PATH and "" that dirfd itself is the file.
fn lx_execve(k: &mut Kernel, mmu: &Mmu, pid: u64, dirfd: u64, path: u64, argv: u64, envp: u64, flags: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  k.perr = ENOENT;
  let mut src = lx_src_at(&mut k, pid, dirfd, path, flags);
  if !src.file && src.prog >= NPROGS {
    return k.perr;
  }
  if src.file && file_writing(k, src.f) && seal_slot(k, src.f) >= SEAL_N {
    return ETXTBSY;                         // open for writing somewhere
  }
  let mut args = balloc(ARGS_MAX);
  // A script starting with "#!": its interpreter runs instead, with the
  // line's argument and the script's path before the rest of argv.
  let mut first = 0;
  let mut av = argv;
  let mut line = balloc(BANG_MAX);
  let bang = bang_line(&mut k.fs, src, &mut line);
  if bang > BANG_MAX {
    bfree(line);
    bfree(args);
    return ENOEXEC;
  }
  if bang > 0 {
    first = bang_args(&mut k, pid, line, bang, path, &mut args);
    if first > ARGS_MAX {
      bfree(line);
      bfree(args);
      return first;                           // -errno
    }
    av = argv_rest(&mut k, pid, argv);
    src = bang_src(&mut k, pid, line);
    if !src.file && src.prog >= NPROGS {
      bfree(line);
      bfree(args);
      return k.perr;
    }
  }
  bfree(line);
  let mut alen = lx_args(&mut k, pid, av, &mut args, first, ARGV_MAX);
  if alen > ARGS_MAX {
    bfree(args);
    return alen;                              // -errno
  }
  if alen == 0 {
    bset(&mut args, 0, 0);                  // no arguments: argv[0] is "", as on Linux
    alen = 1;
  }
  let total = lx_args(&mut k, pid, envp, &mut args, alen, ENVC_MAX);
  if total > ARGS_MAX || total < alen {
    bfree(args);
    return E2BIG;
  }
  // A dynamically linked program's interpreter, found as execve finds a
  // program: from the caller's root (chroot), through symbolic links.
  let isrc = elf_interp(&mut k, pid, src);
  let from_file = src.file;
  let image = src.f;
  // A hold keeps the file in place while its code is read on demand
  // (src/lazy.bastio); without one, every page is read now.
  let mut hold = HOLD_N;
  if src.file {
    hold = vfs_hold(&mut k.fs, src.f);
  }
  let sp = load_image(&mut k.mem, &mut k.txt, &mut k.fs, &mut k.procs, k.ticks % 0x100000000 * NPROC + pid, k.tsc, k.epoch, pid, src, isrc, args, alen, total, hold < HOLD_N);
  bfree(args);
  match sp {
    Space::Empty => {
      vfs_unhold(&mut k.fs, &mut k.mem, hold);
      return ENOEXEC;
    },
    Space::Mapped(new) => {
      map_drop_all(&mut k, pid);            // shared file pages go back first
      vfork_give_back(&mut k, mmu, pid);
      match take_space(&mut k.spaces, pid) {
        Space::Empty => {},
        Space::Mapped(t) => { free_space(&mut k.mem, mmu, t); },
      }
      put_space(&mut k.spaces, pid, Space::Mapped(new));
    },
  }
  hole_clear(&mut k, pid);                // a new window has no holes
  anon_clear(&mut k, pid);
  lazy_set(&mut k, pid, src, hold);       // map_drop_all dropped the old record
  shm_drop_all(&mut k, pid);
  lx_fd_close_all(&mut k, pid, true);
  sig_reset(&mut k.sigact, pid, true);
  pset(&mut k.procs, pid, F_ALTSIZE, 0);  // and the alternate signal stack
  pr_exec(&mut k, pid);                   // the name becomes the program's
  ptimer_clear(&mut k, pid);              // execve deletes POSIX timers
  exec_ids(&mut k, pid, from_file, image); // set-user-ID and set-group-ID files
  match take_fpu(&mut k.fpus, pid) {
    Fpu::None => {},
    Fpu::State(mut f) => {
      let mut i = 0;
      while i < 512
        invariant i <= 512
      {
        frame_write(&mut f, i, 0);
        i = i + 1;
      }
      fpu_init(&mut f);
      put_fpu(&mut k.fpus, pid, Fpu::State(f));
    },
  }
  if pid >= 1 && tr_tracer(k, pid) != 0 {
    pt_exec_event(&mut k, pid);
    post_from(&mut k, pid, 5, pid);   // SIGTRAP: a traced process stops after execve (src/lxptrace.bastio)
  }
  return 0;
}

/// The executable at user path `va`: built-in image NAME for /bin/NAME,
/// otherwise the file. Not found: a built-in Src with prog NPROGS, and
/// the -errno in k.perr (EACCES for a file the process may not run).
fn lx_src_at(k: &mut Kernel, pid: u64, dirfd: u64, va: u64, flags: u64) -> Src
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let none = Src { file: false, prog: NPROGS, f: 0, size: 0 };
  if flags & !(AT_EMPTY_PATH | AT_SYMLINK_NOFOLLOW) != 0 {
    k.perr = EINVAL;
    return none;
  }
  if flags & AT_EMPTY_PATH != 0 && user_empty(&mut k, pid, va) {
    return fd_src(&mut k, pid, dirfd);
  }
  if flags & AT_SYMLINK_NOFOLLOW != 0 {
    let ln = lx_path_at_nf(&mut k, pid, dirfd, va);
    if ln != NO_RESULT {
      let lf = vfs_lookup(&mut k.fs, ln);
      if lf != NO_FILE && vfs_is_link(&mut k.fs, lf) {
        k.perr = ELOOP;                     // the file itself is a link
        return none;
      }
    }
  }
  return src_named(&mut k, pid, lx_path_at(&mut k, pid, dirfd, va));
}

/// lx_src_at for the name n that a path walk left in the transfer buffer.
fn src_named(k: &mut Kernel, pid: u64, n: u64) -> Src
  requires kok(k) && pid < NPROC
  requires n == NO_RESULT || n <= FNAME_MAX
  ensures kok(k)
{
  let none = Src { file: false, prog: NPROGS, f: 0, size: 0 };
  if n == NO_RESULT {
    return none;
  }
  let mut pf = 0;
  if n <= XFER {
    pf = proc_node(k, n);
  }
  if is_exe_file(pf) {
    return exe_src(&mut k, (pf - PROC_DEV) / 16);
  }
  // /proc/PID/fd/N of this process (a thread of it): the file the descriptor
  // holds, as Linux follows these links; this is how an unlinked file, a
  // memfd, is run.
  if n <= XFER {
    let pfd = proc_fd(k.procs, k.fs.xfer, n);
    if pfd != NO_RESULT && tgid(k.procs, pfd / LXNFD) == tgid(k.procs, pid) {
      return fd_src(&mut k, pfd / LXNFD, pfd % LXNFD);
    }
  }
  if n > 4 && xfer_bin(k.fs.xfer) {
    let mut suid = 0;
    if n <= FNAME_MAX && bin_suid(k.fs.xfer, n) {
      suid = 1;                             // f marks a set-user-ID-root built-in (exec_ids)
    }
    let prog = bin_prog(k.fs.xfer, n);
    if prog >= NPROGS {
      k.perr = ENOENT;                      // no such built-in (not the path walk's last word)
    }
    return Src { file: false, prog: prog, f: suid, size: slen(prog_image(prog)) };
  }
  k.perr = ENOENT;
  let f = vfs_lookup(&mut k.fs, n);
  if f == NO_FILE {
    if dir_at(&mut k, n) != NO_FILE {
      k.perr = EACCES;                      // a directory
    }
    return none;
  }
  if may_path(&mut k, pid, n, MAY_X) != 0 {
    k.perr = EACCES;                        // no execute permission (src/lxperm.bastio)
    return none;
  }
  let size = vfs_size(&mut k.fs, f);
  if size == NO_FILE {
    return none;
  }
  return Src { file: true, prog: NPROGS, f: f, size: size };
}

/// The file open on descriptor fd of process pid, for execveat's
/// AT_EMPTY_PATH (fexecve): it needs execute permission, as a path does.
fn fd_src(k: &mut Kernel, pid: u64, fd: u64) -> Src
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let none = Src { file: false, prog: NPROGS, f: 0, size: 0 };
  let d = fd_look(k, pid, fd);
  if d.kind == K_BAD {
    k.perr = EBADF;
    return none;
  }
  k.perr = EACCES;                          // a directory, pipe, socket or device
  if d.kind != K_FILE {
    return none;
  }
  let f = vfs_row_file(k.fs, d.x);
  let m = file_meta(&mut k.fs, f);
  if !m.ok || !may_meta(k.procs, pid, m.mode, m.own, MAY_X) {
    return none;
  }
  let size = vfs_size(&mut k.fs, f);
  if size == NO_FILE {
    return none;
  }
  return Src { file: true, prog: NPROGS, f: f, size: size };
}

/// Whether file f is open for writing (by any open file description,
/// which includes a writable MAP_SHARED mapping's): execve of it is then
/// ETXTBSY, as on Linux.
fn file_writing(k: &Kernel, f: u64) -> bool
  requires kok(k)
{
  let mut row = 0;
  while row < FD_ROWS
    invariant row <= FD_ROWS && kok(k)
  {
    if fget(k.fs.ftab, row, FD_MODE) / O_WRITE % 2 == 1 && row_file(k.fs, row) == f {
      return true;
    }
    row = row + 1;
  }
  return false;
}

/// Whether a live process runs the program in file f: opening it for
/// writing or truncating it is then ETXTBSY, as on Linux.
fn file_running(k: &Kernel, f: u64) -> bool
  requires kok(k)
{
  if f >= NO_FILE - NPROGS - 1 {
    return false;
  }
  let mut p = 1;
  while p < NPROC
    invariant p <= NPROC && kok(k)
  {
    if state(k.procs, p) != FREE && state(k.procs, p) != ZOMBIE && pget(k.procs, p, F_PROG) == NPROGS + 1 + f {
      return true;
    }
    p = p + 1;
  }
  return false;
}

/// The program process p is running, for an exec of /proc/PID/exe (as
/// BusyBox's ash does to run a script that execve calls ENOEXEC). Not
/// there: a built-in Src with prog NPROGS.
fn exe_src(k: &mut Kernel, p: u64) -> Src
  requires kok(k)
  ensures kok(k)
{
  let none = Src { file: false, prog: NPROGS, f: 0, size: 0 };
  if p >= NPROC {
    return none;
  }
  let prog = pget(k.procs, p, F_PROG);
  if prog < NPROGS {
    return Src { file: false, prog: prog, f: 0, size: slen(prog_image(prog)) };
  }
  if prog == NPROGS {
    return none;
  }
  let f = prog - NPROGS - 1;
  let size = vfs_size(&mut k.fs, f);
  if size == NO_FILE {
    return none;
  }
  return Src { file: true, prog: NPROGS, f: f, size: size };
}

/// Whether the transfer buffer starts with "bin/".
fn xfer_bin(x: &Bytes) -> bool
  requires blen(x) == XFER
{
  return bget(x, 0) == 98 && bget(x, 1) == 105 && bget(x, 2) == 110 && bget(x, 3) == 47;
}

/// Whether bytes from..to of x are `name`.
fn xfer_is(x: &Bytes, from: u64, to: u64, name: Str) -> bool
  requires from <= to && to <= blen(x)
{
  return bytes_span_eq_str(x, from, to, name);
}

/// Copies the strings of the NULL-ended array of at most `most` string
/// pointers at user address `argv` into `args` from byte `from`, each with
/// its NUL. Returns where they end, or -errno (more than ARGS_MAX) if a
/// pointer is bad or they do not fit.
fn lx_args(k: &mut Kernel, pid: u64, argv: u64, args: &mut Bytes, from: u64, most: u64) -> u64
  requires kok(k) && pid < NPROC && blen(args) == ARGS_MAX && from <= ARGS_MAX
  ensures kok(k) && blen(args) == ARGS_MAX
  ensures result <= ARGS_MAX ==> from <= result
{
  if argv == 0 {
    return from;
  }
  if argv < USER_BASE || argv >= USER_BASE + USER_SIZE || most > ARGV_MAX {
    return EFAULT;
  }
  let mut alen = from;
  let mut j = 0;
  while j < most
    invariant j <= most && most <= ARGV_MAX && from <= alen && alen <= ARGS_MAX && kok(k) && blen(args) == ARGS_MAX
    invariant argv < USER_BASE + USER_SIZE
  {
    let w = user_u64(&mut k.spaces, pid, argv + 8 * j);
    if !w.ok {
      return EFAULT;
    }
    if w.v == 0 {
      return alen;
    }
    let end = lx_str(&mut k, pid, w.v, &mut args, alen);
    if end > ARGS_MAX {
      return end;                             // -errno
    }
    alen = end;
    j = j + 1;
  }
  return E2BIG;
}

/// Copies the string at user address va, with its NUL, into args from
/// byte `from`. Returns where it ends, or -errno (more than ARGS_MAX) if va
/// is bad or the string does not fit.
fn lx_str(k: &mut Kernel, pid: u64, va: u64, args: &mut Bytes, from: u64) -> u64
  requires kok(k) && pid < NPROC && blen(args) == ARGS_MAX && from <= ARGS_MAX
  ensures kok(k) && blen(args) == ARGS_MAX
  ensures result <= ARGS_MAX ==> from < result
{
  if va < USER_BASE || va >= USER_BASE + USER_SIZE {
    return EFAULT;
  }
  // A transfer buffer at a time, up to the NUL.
  let mut alen = from;
  let mut at = va;
  let mut done = false;
  while !done
    invariant from <= alen && alen <= ARGS_MAX && kok(k) && blen(args) == ARGS_MAX && USER_BASE <= at
    invariant done ==> from < alen
  {
    if alen >= ARGS_MAX {
      return E2BIG;                         // no NUL in what fits
    }
    if at >= USER_BASE + USER_SIZE {
      return EFAULT;
    }
    let want = smaller(smaller(ARGS_MAX - alen, XFER), USER_SIZE - (at - USER_BASE));
    let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, at, &mut k.fs.xfer, want);
    if got == NO_RESULT || got == 0 {
      return EFAULT;
    }
    let mut i = 0;
    while i < got && !done
      invariant i <= got && got <= want && want <= ARGS_MAX - alen && want <= XFER && kok(k) && blen(args) == ARGS_MAX
      invariant from <= alen && alen < ARGS_MAX && USER_BASE <= at
      invariant done ==> i > 0
    {
      let c = bget(k.fs.xfer, i);
      bset(&mut args, alen + i, c);
      if c == 0 {
        done = true;
      }
      i = i + 1;
    }
    alen = alen + i;
    at = at + i;
  }
  return alen;
}

// ---------------------------------------------------------------- "#!" scripts


/// Whether byte c ends a word of a "#!" line: space, tab, newline or NUL.
fn bang_gap(c: u64) -> bool {
  return c == 32 || c == 9 || c == 10 || c == 0;
}

/// If the program src starts with "#!", puts the interpreter's path and
/// then the line's argument, if any, each with a NUL, at the start of
/// `line`, and returns how many bytes that is. 0 if src is not a script,
/// more than BANG_MAX for a "#!" line that names no interpreter.
fn bang_line(v: &mut Vfs, src: Src, line: &mut Bytes) -> u64
  requires vfs_ok(v) && blen(line) == BANG_MAX
  ensures vfs_ok(v) && blen(line) == BANG_MAX
  ensures result <= BANG_MAX || result == BANG_MAX + 1
  ensures result <= BANG_MAX ==> result == 0 || 2 <= result
{
  let n = smaller(src.size, BANG_MAX);
  if n < 2 || !src_read(&mut v, src, 0, n) {
    return 0;
  }
  if bget(v.xfer, 0) != 35 || bget(v.xfer, 1) != 33 {
    return 0;                               // not "#!"
  }
  let mut i = 2;
  while i < n && (bget(v.xfer, i) == 32 || bget(v.xfer, i) == 9)
    invariant 2 <= i && i <= n && n <= BANG_MAX && vfs_ok(v)
  {
    i = i + 1;
  }
  let start = i;
  while i < n && !bang_gap(cast[u64](bget(v.xfer, i)))
    invariant start <= i && i <= n && n <= BANG_MAX && vfs_ok(v)
  {
    i = i + 1;
  }
  if i == start {
    return BANG_MAX + 1;
  }
  let iend = i;
  let mut o = 0;
  while o < i - start
    invariant o <= i - start && 2 <= start && start <= i && i <= n && n <= BANG_MAX && vfs_ok(v) && blen(line) == BANG_MAX
  {
    bset(&mut line, o, bget(v.xfer, start + o));
    o = o + 1;
  }
  bset(&mut line, o, 0);
  o = o + 1;
  // The argument: the rest of the line, less the blanks around it.
  while i < n && (bget(v.xfer, i) == 32 || bget(v.xfer, i) == 9)
    invariant iend <= i && i <= n && n <= BANG_MAX && o == iend - start + 1 && vfs_ok(v)
  {
    i = i + 1;
  }
  let a = i;
  while i < n && bget(v.xfer, i) != 10 && bget(v.xfer, i) != 0
    invariant a <= i && i <= n && n <= BANG_MAX && vfs_ok(v)
  {
    i = i + 1;
  }
  let mut e = i;
  while e > a && (bget(v.xfer, e - 1) == 32 || bget(v.xfer, e - 1) == 9)
    invariant a <= e && e <= i && i <= n && n <= BANG_MAX && vfs_ok(v)
  {
    e = e - 1;
  }
  if e > a && o + (e - a) < BANG_MAX {
    let mut c = 0;
    while c < e - a
      invariant c <= e - a && o + (e - a) < BANG_MAX && a <= e && e <= n && n <= BANG_MAX && vfs_ok(v) && blen(line) == BANG_MAX
    {
      bset(&mut line, o + c, bget(v.xfer, a + c));
      c = c + 1;
    }
    bset(&mut line, o + c, 0);
    o = o + c + 1;
  }
  return o;
}

/// The start of a script's arguments: the n bytes of `line` (the
/// interpreter and its argument), then the script's path as the caller
/// gave it at user address `path`. Returns where they end, or -errno.
fn bang_args(k: &mut Kernel, pid: u64, line: &Bytes, n: u64, path: u64, args: &mut Bytes) -> u64
  requires kok(k) && pid < NPROC && blen(line) == BANG_MAX && n <= BANG_MAX && blen(args) == ARGS_MAX
  ensures kok(k) && blen(args) == ARGS_MAX
{
  let mut i = 0;
  while i < n
    invariant i <= n && n <= BANG_MAX && BANG_MAX < ARGS_MAX && blen(args) == ARGS_MAX && kok(k)
  {
    bset(&mut args, i, bget(line, i));
    i = i + 1;
  }
  return lx_str(&mut k, pid, path, &mut args, n);
}

/// argv without its first string (the interpreter's argv takes the
/// script's path in its place). An empty or bad argv stays as it is.
fn argv_rest(k: &mut Kernel, pid: u64, argv: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if argv < USER_BASE || argv >= USER_BASE + USER_SIZE - 8 {
    return argv;
  }
  let w = user_u64(&mut k.spaces, pid, argv);
  if !w.ok || w.v == 0 {
    return argv;
  }
  return argv + 8;
}

/// The interpreter a "#!" line names (the first string in `line`), found
/// as execve finds a program. Not found: a built-in Src with prog NPROGS,
/// and the -errno in k.perr.
fn bang_src(k: &mut Kernel, pid: u64, line: &Bytes) -> Src
  requires kok(k) && pid < NPROC && blen(line) == BANG_MAX
  ensures kok(k)
{
  let mut e = 0;
  while e < BANG_MAX && bget(line, e) != 0
    invariant e <= BANG_MAX && blen(line) == BANG_MAX && kok(k)
  {
    bset(&mut k.fs.xfer, e, bget(line, e));
    e = e + 1;
  }
  k.perr = ENOENT;
  if e == 0 || e >= BANG_MAX {
    return Src { file: false, prog: NPROGS, f: 0, size: 0 };
  }
  let n = perm_walk(&mut k, pid, lx_path_xfer(&mut k, pid, e, OFD_N, true));
  return src_named(&mut k, pid, n);
}

/// The interpreter (PT_INTERP) the ELF program src names, found as execve
/// finds a program: its path is taken from the caller's root, so a chroot
/// sees its own /lib64/ld-linux-x86-64.so.2, and symbolic links on the way
/// are followed. A built-in Src with prog NPROGS when src names none or it
/// is not found; load_image then looks the path up itself (interp_src),
/// which knows musl's built-in /lib/ld-musl-x86_64.so.1.
fn elf_interp(k: &mut Kernel, pid: u64, src: Src) -> Src
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let none = Src { file: false, prog: NPROGS, f: 0, size: 0 };
  if !src.file {
    return none;
  }
  let e = elf_parse(&mut k.fs, src);
  if !e.ok || e.ilen < 2 || !src_read(&mut k.fs, src, e.interp, e.ilen) {
    return none;
  }
  let n = e.ilen - 1;                       // less the NUL
  if bget(k.fs.xfer, n) != 0 {
    return none;
  }
  let mut i = 0;
  while i < n && bget(k.fs.xfer, i) != 0
    invariant i <= n && n < INTERP_MAX && kok(k)
  {
    i = i + 1;
  }
  if i < n || n == 0 {
    return none;                            // a NUL inside the path
  }
  let found = src_named(&mut k, pid, perm_walk(&mut k, pid, lx_path_xfer(&mut k, pid, n, OFD_N, true)));
  if !found.file {
    return none;
  }
  return found;
}

// ---------------------------------------------------------------- wait4

/// Whether wait4's pid argument `want` names child c of pid: -1 any child,
/// 0 one in pid's process group, -g one in group g, else that pid.
fn wait_match(procs: &Buf, pid: u64, c: u64, want: u64) -> bool
  requires ptab_ok(procs) && pid < NPROC && c < NPROC
{
  if want == 0xFFFFFFFFFFFFFFFF {
    return true;
  }
  if want == 0 {
    return pgid_of(procs, c) == pgid_of(procs, pid);
  }
  if want >= 0x8000000000000000 {
    return pgid_of(procs, c) == 0xFFFFFFFFFFFFFFFF - want + 1;
  }
  return c == want;
}

/// Is c a child of the thread group that pid is in? Children belong to the
/// group: any of its threads may wait for one another made.
fn child_of_group(procs: &Buf, c: u64, pid: u64) -> bool
  requires ptab_ok(procs) && c < NPROC && pid < NPROC
{
  let par = pget(procs, c, F_PARENT);
  return par < NPROC && par != 0 && tgid(procs, par) == tgid(procs, pid);
}

/// wait4(want, status, options, rusage): collects a child that has ended
/// (one wait_match names), storing its exit code as the Linux
/// status at user address `status` if not NULL. With none ended yet, the
/// process blocks (WNOHANG: returns 0) and the call is restarted once a
/// child ends. rusage is not filled in.
fn lx_wait4(k: &mut Kernel, pid: u64, pidarg: u64, status: u64, options: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  // WNOHANG, WUNTRACED, WCONTINUED, __WNOTHREAD, __WALL and __WCLONE.
  if options % 0x100000000 & !0xE000000B != 0 {
    ret(&mut k.procs, pid, EINVAL);
    return KEEP;
  }
  let p32 = pidarg % 0x100000000;           // a pid_t
  if p32 == 0x80000000 {
    ret(&mut k.procs, pid, ESRCH);          // INT_MIN has no group to name
    return KEEP;
  }
  let mut want = p32;
  if p32 > 0x80000000 {
    want = 0xFFFFFFFF00000000 + p32;        // negative: sign-extend
  }
  let mut found = false;
  let mut c = 1;
  while c < NPROC
    invariant 1 <= c && c <= NPROC && kok(k)
  {
    if (child_of_group(k.procs, c, pid) || traced_by(k, c, pid)) && state(k.procs, c) != FREE && wait_match(k.procs, pid, c, want) {
      found = true;
      // WUNTRACED: stopped (status sig << 8 | 0x7f); WCONTINUED: 0xffff.
      // A tracer hears of the stops of what it traces without asking.
      let jr = jc_report(&mut k, c, options & 2 != 0 || traced_by(k, c, pid), options & 8 != 0, false);
      if jr != 0 {
        if status != 0 {
          lx_fill(&mut k, 0, 4);
          if jr < 512 {
            bset(&mut k.fs.xfer, 0, 0x7f);
            bset(&mut k.fs.xfer, 1, cast[u8](jr % 256));
            if traced_by(k, c, pid) {
              bset(&mut k.fs.xfer, 2, cast[u8](tr2_get(k, c) / TS_EV % 16));   // the event, if it is one (src/lxptrace.bastio)
            }
          } else {
            bset(&mut k.fs.xfer, 0, 0xff);
            bset(&mut k.fs.xfer, 1, 0xff);
          }
          if lx_put_out(&mut k, pid, status, 4) != 0 {
            ret(&mut k.procs, pid, EFAULT);
            return KEEP;
          }
        }
        ret(&mut k.procs, pid, vpid_of(k, pid, c));
        return KEEP;
      }
      if state(k.procs, c) == ZOMBIE {
        if status != 0 {
          lx_fill(&mut k, 0, 4);
          let code = pget(k.procs, c, F_CODE);
          if code >= SIG_DEATH {
            bset(&mut k.fs.xfer, 0, cast[u8](code % 128));   // ended by a signal
          } else {
            bset(&mut k.fs.xfer, 1, cast[u8](code % 256));
          }
          if lx_put_out(&mut k, pid, status, 4) != 0 {
            ret(&mut k.procs, pid, EFAULT);
            return KEEP;
          }
        }
        if child_of_group(k.procs, c, pid) {
          tm_reap(&mut k, pid, c);
          pset(&mut k.procs, c, F_STATE, FREE);
        } else {
          tr_put(&mut k, c, 0);             // its tracer has heard; the parent reaps it
        }
        ret(&mut k.procs, pid, vpid_of(k, pid, c));
        return KEEP;
      }
    }
    c = c + 1;
  }
  if !found {
    ret(&mut k.procs, pid, ECHILD);
    return KEEP;
  }
  if options % 2 == WNOHANG {
    ret(&mut k.procs, pid, 0);
    return KEEP;
  }
  let rip = pget(k.procs, pid, F_REGS + R_RIP);
  if rip < 2 {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  pset(&mut k.procs, pid, F_REGS + R_RIP, rip - 2);
  pset(&mut k.procs, pid, F_REGS + R_RAX, LX_WAIT4);
  pset(&mut k.procs, pid, F_STATE, LXWAITING);
  pset(&mut k.procs, pid, F_RESTART, 1);
  return SWITCH;
}

/// waitid(idtype, id, info, options): like wait4, with the answer in a
/// siginfo (SIGCHLD, CLD_EXITED or CLD_KILLED, the pid and the status).
/// P_ALL waits for any child, P_PID for one, P_PGID for one in a group.
/// WNOWAIT leaves the child to be waited for again. WEXITED reports ended
/// children, WSTOPPED stopped ones and WCONTINUED continued ones; WNOHANG
/// with none returns 0 with the siginfo's pid 0.
fn lx_waitid(k: &mut Kernel, pid: u64, idtype: u64, id: u64, info: u64, options: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  // P_PIDFD (src/lxpidfd.bastio) waits as P_PID for the child its pidfd
  // names; a nonblocking pidfd says -EAGAIN rather than wait.
  let mut kind = idtype;
  let mut ident = id;
  let mut nb = false;
  if idtype == P_PIDFD {
    let p = pidfd_target(k, pid, id, false);
    if p == EBADF {
      ret(&mut k.procs, pid, EBADF);
      return KEEP;
    }
    kind = 1;
    ident = p;
    nb = pipe_nonblock(k, pid, id);
  }
  if options & 14 == 0 || kind > 2 {
    ret(&mut k.procs, pid, EINVAL);         // none of WEXITED, WSTOPPED, WCONTINUED
    return KEEP;
  }
  // P_ALL any child, P_PID child id, P_PGID one in group id (0: pid's own).
  let mut want = 0xFFFFFFFFFFFFFFFF;
  if kind == 1 {
    want = ident % 0x80000000;
  } else if kind == 2 {
    want = 0;
    if id % 0x80000000 != 0 {
      want = 0xFFFFFFFFFFFFFFFF - id % 0x80000000 + 1;
    }
  }
  let mut found = false;
  let mut c = 1;
  while c < NPROC
    invariant 1 <= c && c <= NPROC && kok(k)
  {
    if (child_of_group(k.procs, c, pid) || traced_by(k, c, pid)) && state(k.procs, c) != FREE && wait_match(k.procs, pid, c, want) {
      found = true;
      let jr = jc_report(&mut k, c, options & 2 != 0 || traced_by(k, c, pid), options & 8 != 0, options & 0x1000000 != 0);
      if jr != 0 {
        if info != 0 {
          lx_fill(&mut k, 0, 128);
          bset(&mut k.fs.xfer, 0, 17);              // si_signo: SIGCHLD
          bset(&mut k.fs.xfer, 8, cast[u8](4 + jr / 256));   // CLD_STOPPED (5), CLD_CONTINUED (6)
          xfer_u64(&mut k.fs.xfer, 16, vpid_of(k, pid, c));   // si_pid (and a zero si_uid)
          bset(&mut k.fs.xfer, 24, cast[u8](jr % 256));      // si_status: the signal
          if lx_put_out(&mut k, pid, info, 128) != 0 {
            ret(&mut k.procs, pid, EFAULT);
            return KEEP;
          }
        }
        ret(&mut k.procs, pid, 0);
        return KEEP;
      }
      if state(k.procs, c) == ZOMBIE && options & 4 != 0 {
        if info != 0 {
          lx_fill(&mut k, 0, 128);
          let code = pget(k.procs, c, F_CODE);
          bset(&mut k.fs.xfer, 0, 17);              // si_signo: SIGCHLD
          xfer_u64(&mut k.fs.xfer, 16, vpid_of(k, pid, c));   // si_pid (and a zero si_uid)
          if code >= SIG_DEATH {
            bset(&mut k.fs.xfer, 8, 2);             // si_code: CLD_KILLED
            bset(&mut k.fs.xfer, 24, cast[u8](code % 128));
          } else {
            bset(&mut k.fs.xfer, 8, 1);             // CLD_EXITED
            bset(&mut k.fs.xfer, 24, cast[u8](code % 256));
          }
          if lx_put_out(&mut k, pid, info, 128) != 0 {
            ret(&mut k.procs, pid, EFAULT);
            return KEEP;
          }
        }
        if options & 0x1000000 == 0 {
          if child_of_group(k.procs, c, pid) {
            tm_reap(&mut k, pid, c);
            pset(&mut k.procs, c, F_STATE, FREE);
          } else {
            tr_put(&mut k, c, 0);           // its tracer has heard; the parent reaps it
          }
        }
        ret(&mut k.procs, pid, 0);
        return KEEP;
      }
    }
    c = c + 1;
  }
  if !found {
    ret(&mut k.procs, pid, ECHILD);
    return KEEP;
  }
  if nb && options % 2 != WNOHANG {
    ret(&mut k.procs, pid, EAGAIN);
    return KEEP;
  }
  if options % 2 == WNOHANG {
    if info != 0 {
      lx_fill(&mut k, 0, 128);
      if lx_put_out(&mut k, pid, info, 128) != 0 {
        ret(&mut k.procs, pid, EFAULT);
        return KEEP;
      }
    }
    ret(&mut k.procs, pid, 0);
    return KEEP;
  }
  let r = lx_retry(&mut k, pid, LX_WAITID);
  if r == SWITCH {
    pset(&mut k.procs, pid, F_STATE, LXWAITING);
  }
  return r;
}

/// times(buf): the caller's user and system time, and its waited-for
/// children's, in clock ticks; returns the ticks since boot.
fn lx_times(k: &mut Kernel, pid: u64, buf: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if buf != 0 {
    lx_fill(&mut k, 0, 32);
    xfer_u64(&mut k.fs.xfer, 0, pget(k.procs, pid, F_TICKS));
    xfer_u64(&mut k.fs.xfer, 8, tm_ticks(k, pid, 0));
    xfer_u64(&mut k.fs.xfer, 16, tm_ticks(k, pid, 1));
    xfer_u64(&mut k.fs.xfer, 24, tm_ticks(k, pid, 2));
    if lx_put_out(&mut k, pid, buf, 32) != 0 {
      return EFAULT;
    }
  }
  return k.ticks;
}

// ---------------------------------------------------------------- stat

/// What stat says about a path or descriptor.
struct Meta { ok: bool, mode: u64, size: u64, ino: u64, mtime: u64, own: u64 }   // own: uid + gid * 2^32

/// stat(path, buf): "/", "/bin" and the file layer's directories are
/// directories, /bin/NAME a built-in program, anything else a file. The mode's permission bits, the owner and the times come from the file system (root owns the rest). Returns 0 or
/// -errno; with `buf` 0 it only checks that the path exists (access).
fn lx_stat(k: &mut Kernel, pid: u64, dirfd: u64, path: u64, buf: u64, follow: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut n = NO_RESULT;
  if follow {
    n = lx_path_at(&mut k, pid, dirfd, path);
  } else {
    n = lx_path_at_nf(&mut k, pid, dirfd, path);   // lstat: a link itself
  }
  if n == NO_RESULT {
    return k.perr;
  }
  let pf = proc_node(k, n);
  let mut m = path_meta(&mut k, n);
  if !follow && pf != 0 && is_ns_file(pf) {
    m = nsf_link_meta(pf);                  // lstat: the /proc/PID/ns link itself
  }
  if !m.ok {
    return ENOENT;
  }
  if buf == 0 {
    return 0;
  }
  return put_stat(&mut k, pid, buf, m);
}

/// fstat for the *at calls with AT_EMPTY_PATH: dirfd itself, or the
/// working directory for AT_FDCWD.
fn lx_fstat_at(k: &mut Kernel, pid: u64, dirfd: u64, buf: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if dirfd % 0x100000000 != AT_FDCWD {
    return lx_fstat(&mut k, pid, dirfd, buf);
  }
  let cl = base_len(k, pid, OFD_N);
  let mut i = 0;
  while i < cl
    invariant i <= cl && cl <= FNAME_MAX && kok(k) && pid < NPROC
  {
    bset(&mut k.fs.xfer, i, base_byte(k, pid, OFD_N, i));
    i = i + 1;
  }
  let m = path_meta(&mut k, cl);
  if !m.ok {
    return ENOENT;
  }
  return put_stat(&mut k, pid, buf, m);
}

/// The metadata of the path in the first n bytes of the transfer buffer.
fn path_meta(k: &mut Kernel, n: u64) -> Meta
  requires kok(k) && n <= FNAME_MAX
  ensures kok(k)
{
  let none = Meta { ok: false, mode: 0, size: 0, ino: 0, mtime: 0, own: 0 };
  let dev = dev_at(k.fs.xfer, n);
  if dev >= DEV_PTS && dev < DEV_PTS + PTY_N && !pty_live(k, dev - DEV_PTS) {
    return none;                            // /dev/pts/N exists while pair N does
  }
  if dev != DEV_NONE {
    return dev_meta(dev);
  }
  let pf = proc_node(k, n);
  if pf != 0 && is_ns_file(pf) {
    return nsf_meta(k, pf);                 // the namespace's nsfs file (src/lxnsk.bastio)
  }
  if pf != 0 && is_um_file(pf) {
    return um_meta(k, pf);                  // src/lxuser.bastio
  }
  if pf != 0 && is_cg_file(pf) {
    return cg_file_meta(pf);                // src/lxcgroup.bastio
  }
  if pf != 0 {
    return proc_meta(pf);
  }
  let dir = dir_at(&mut k, n);
  if dir != NO_FILE {
    return dir_meta(&mut k, dir);
  }
  if n > 4 && xfer_bin(k.fs.xfer) {
    let prog = bin_prog(k.fs.xfer, n);
    if prog >= NPROGS {
      return none;
    }
    let mut bm = S_IFREG_X;
    if bin_suid(k.fs.xfer, n) {
      bm = S_IFREG_X + S_ISUID;
    }
    return Meta { ok: true, mode: bm, size: slen(prog_image(prog)), ino: INO_PROGS + prog, mtime: 0, own: 0 };
  }
  return file_meta(&mut k.fs, vfs_lookup(&mut k.fs, n));
}

/// The metadata of directory dir (as dir_at gives it), the same whether
/// it is reached by path or by an open descriptor.
fn dir_meta(k: &mut Kernel, dir: u64) -> Meta
  requires kok(k)
  ensures kok(k)
{
  if dir >= DIR_CG {
    return cg_dir_meta(dir - DIR_CG);
  }
  if dir >= DIR_PROC {
    return proc_dir_meta(dir);
  }
  if dir >= DIR_VFS {
    let dm = vfs_meta(&mut k.fs, dir - DIR_VFS);
    return Meta { ok: true, mode: S_IFMT_DIR + dm.mode % 4096, size: 0, ino: 1 + dir, mtime: dm.mtime, own: dm.own };
  }
  return Meta { ok: true, mode: S_IFDIR, size: 0, ino: 1 + dir, mtime: 0, own: 0 };
}

/// The metadata of file f (a vfs_lookup handle). Its inode number is the
/// handle, past the ones the directories and built-in programs use.
fn file_meta(v: &mut Vfs, f: u64) -> Meta
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let size = vfs_size(&mut v, f);
  let fm = vfs_meta(&mut v, f);
  if size == NO_FILE || !fm.ok || f >= HFILES {
    return Meta { ok: false, mode: 0, size: 0, ino: 0, mtime: 0, own: 0 };
  }
  let mut kind = S_IFMT_REG;
  if fm.mode % 65536 / 4096 * 4096 == T_LINK {
    kind = T_LINK;                          // a symbolic link: only lstat gets this far
  } else if fm.mode % 65536 / 4096 * 4096 == T_FIFO {
    kind = T_FIFO;                          // a named pipe
  } else if fm.mode % 65536 / 4096 * 4096 == T_SOCK {
    return Meta { ok: true, mode: T_SOCK + fm.mode % 4096, size: 0, ino: INO_FILES + f, mtime: fm.mtime, own: fm.own };
  } else if fm.mode % 65536 / 4096 * 4096 == T_CHR || fm.mode % 65536 / 4096 * 4096 == T_BLK {
    // A device node: size carries its number (see put_stat).
    let t = fm.mode % 65536 / 4096 * 4096;
    return Meta { ok: true, mode: t + fm.mode % 4096, size: vfs_node_dev(&mut v, f), ino: INO_FILES + f, mtime: fm.mtime, own: fm.own };
  }
  return Meta { ok: true, mode: kind + fm.mode % 4096, size: size, ino: INO_FILES + f, mtime: fm.mtime, own: fm.own };
}

/// fstat(fd, buf): the console is a terminal, a pipe a FIFO; a file's size
/// comes from its row.
fn lx_fstat(k: &mut Kernel, pid: u64, fd: u64, buf: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  let mut m = dev_meta(DEV_TTY);           // the console is /dev/tty
  if d.kind == K_BAD {
    return EBADF;
  } else if d.kind == K_PIPE_R || d.kind == K_PIPE_W {
    m = Meta { ok: true, mode: S_IFIFO, size: 0, ino: 4, mtime: 0, own: 0 };
    // A named pipe's ends are its file, as lstat on its path sees it: the
    // open, lstat, fstat check of os.fwalk and shutil compares the two.
    let ff = pi_get(k.pipes, d.x, 4);
    if ff >= 1 && ff - 1 < FIFO_N {
      let h = get(k.evt, FIFO_AT + (ff - 1) * FIFO_STRIDE);
      if h >= 1 {
        let fm = file_meta(&mut k.fs, h - 1);
        if fm.ok {
          m = fm;
        }
      }
    }
  } else if d.kind == K_DIR {
    m = dir_meta(&mut k, d.x);              // as stat on its path says, so shutil.rmtree trusts it
  } else if d.kind == K_SOCK {
    m = Meta { ok: true, mode: S_IFSOCK, size: 0, ino: 5, mtime: 0, own: 0 };
  } else if d.kind == K_DEV && is_ns_file(d.x) {
    m = nsf_fd_meta(k, pid, fd, d.x);       // src/lxnsk.bastio
  } else if d.kind == K_DEV && is_um_file(d.x) {
    m = um_meta(k, d.x);
  } else if d.kind == K_DEV && is_cg_file(d.x) {
    m = cg_file_meta(d.x);
  } else if d.kind == K_DEV {
    m = dev_meta(d.x);
  } else if d.kind == K_FILE {
    m = file_meta(&mut k.fs, vfs_row_file(k.fs, d.x));
    if !m.ok {
      m = Meta { ok: true, mode: S_IFREG, size: 0, ino: 100, mtime: 0, own: 0 };
    }
  }
  return put_stat(&mut k, pid, buf, m);
}

/// Writes a struct stat for m to user address buf. Returns 0 or -EFAULT.
/// For a character or block device, m.size is the device number (st_rdev)
/// and the size is 0.
fn put_stat(k: &mut Kernel, pid: u64, buf: u64, mo: Meta) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut m = mo;
  let mut rdev = 0;
  if m.mode % 65536 / 4096 * 4096 == T_CHR || m.mode % 65536 / 4096 * 4096 == T_BLK {
    rdev = m.size;
    m.size = 0;
  }
  let mut nlink = 1;
  if m.ino >= INO_FILES && m.ino < INO_FILES + HFILES {
    nlink = vfs_nlink(&mut k.fs, m.ino - INO_FILES);   // a file and its hard links
  }
  lx_fill(&mut k, 0, STAT_SIZE);
  xfer_u64(&mut k.fs.xfer, 8, m.ino);         // st_ino
  xfer_u64(&mut k.fs.xfer, 16, nlink);        // st_nlink
  let uid = id_out(k, pid, 0, m.own % 0x100000000);   // as the reader's user namespace sees them (src/lxuser.bastio)
  let gid = id_out(k, pid, 1, m.own / 0x100000000 % 0x100000000);
  xfer_u64(&mut k.fs.xfer, 24, m.mode % 0x100000000 + uid % 0x100000000 * 0x100000000);   // st_mode, st_uid
  xfer_u64(&mut k.fs.xfer, 32, gid);                 // st_gid
  xfer_u64(&mut k.fs.xfer, 40, rdev);         // st_rdev
  xfer_u64(&mut k.fs.xfer, 48, m.size);       // st_size
  xfer_u64(&mut k.fs.xfer, 56, 4096);         // st_blksize
  let mut blocks = m.size / 512;
  if m.size % 512 != 0 {
    blocks = blocks + 1;
  }
  xfer_u64(&mut k.fs.xfer, 64, blocks);       // st_blocks
  let mut atime = m.mtime;
  if m.ino >= INO_FILES && m.ino < INO_FILES + HFILES {
    atime = atime_of(&mut k, m.ino - INO_FILES, m.mtime);   // set by utime, else the modification time
  }
  xfer_u64(&mut k.fs.xfer, 72, atime);        // st_atime
  xfer_u64(&mut k.fs.xfer, 88, m.mtime);      // st_mtime
  xfer_u64(&mut k.fs.xfer, 104, m.mtime);     // st_ctime
  return lx_put_out(&mut k, pid, buf, STAT_SIZE);
}

/// Whether the first n bytes of x are "bin".
fn is_bin(x: &Bytes, n: u64) -> bool
  requires blen(x) == XFER
{
  return n == 3 && bget(x, 0) == 98 && bget(x, 1) == 105 && bget(x, 2) == 110;
}

/// The built-in program "bin/NAME" in the first n bytes of x names, or
/// NPROGS. BusyBox's applet names are BusyBox (it picks the applet from
/// argv[0]), and so is /bin/sh: a Linux program running sh (system,
/// popen) wants a POSIX shell, not the BastiOS one.
fn bin_prog(x: &Bytes, n: u64) -> u64
  requires blen(x) == XFER && 4 <= n && n <= FNAME_MAX
{
  if xfer_is(x, 4, n, "sh") {
    return ASH_PROG;
  }
  let mut i = 0;
  while i < NPROGS
    invariant i <= NPROGS
  {
    if xfer_is(x, 4, n, prog_name(i)) {
      return i;
    }
    i = i + 1;
  }
  let mut j = 0;
  while j < NAPPLETS
    invariant j <= NAPPLETS
  {
    if xfer_is(x, 4, n, applet_name(j)) {
      return ASH_PROG;
    }
    j = j + 1;
  }
  return NPROGS;
}

/// The BusyBox applets built in (user/busybox.config), seen as /bin/NAME.
fn applet_name(j: u64) -> Str {
  if j == 0 {
    return "ls";
  }
  if j == 1 {
    return "cat";
  }
  if j == 2 {
    return "wc";
  }
  if j == 3 {
    return "head";
  }
  if j == 4 {
    return "rm";
  }
  if j == 5 {
    return "cp";
  }
  if j == 6 {
    return "kill";
  }
  if j == 7 {
    return "sleep";
  }
  if j == 8 {
    return "mkdir";
  }
  if j == 9 {
    return "rmdir";
  }
  if j == 10 {
    return "pwd";
  }
  if j == 11 {
    return "mv";
  }
  if j == 12 {
    return "chmod";
  }
  if j == 13 {
    return "touch";
  }
  if j == 14 {
    return "stat";
  }
  if j == 15 {
    return "ln";
  }
  if j == 16 {
    return "readlink";
  }
  if j == 17 {
    return "reboot";
  }
  if j == 18 {
    return "poweroff";
  }
  if j == 19 {
    return "mkfifo";
  }
  if j == 20 {
    return "mount";
  }
  if j == 21 {
    return "umount";
  }
  if j == 22 {
    return "truncate";
  }
  if j == 23 {
    return "chown";
  }
  if j >= 34 {
    return ns_applet(j - 34);
  }
  return suid_name(j - 24);
}

/// The applets past applet 33: mount namespaces (src/lxns.bastio).
fn ns_applet(j: u64) -> Str {
  if j == 0 {
    return "unshare";
  }
  if j == 1 {
    return "pivot_root";
  }
  if j == 2 {
    return "chroot";
  }
  if j == 3 {
    return "hostname";
  }
  return "nsenter";
}

/// The applets past applet 23, which deal with users: su and passwd first
/// (NSUID_APPLETS of them), which run as root (bin_suid), then the rest.
fn suid_name(j: u64) -> Str {
  if j == 0 {
    return "su";
  }
  if j == 1 {
    return "passwd";
  }
  if j == 2 {
    return "login";
  }
  if j == 3 {
    return "id";
  }
  if j == 4 {
    return "whoami";
  }
  if j == 5 {
    return "adduser";
  }
  if j == 6 {
    return "addgroup";
  }
  if j == 7 {
    return "deluser";
  }
  if j == 8 {
    return "delgroup";
  }
  return "chpasswd";
}

/// Whether /bin/NAME (the n-byte path in x) is a set-user-ID-root
/// program: su and passwd, as a BusyBox installed set-user-ID root has
/// them. BusyBox itself (CONFIG_FEATURE_SUID) drops root at once unless
/// the applet its argv[0] names needs it, so a /bin/su run under another
/// argv[0] gets nothing.
fn bin_suid(x: &Bytes, n: u64) -> bool
  requires blen(x) == XFER && 4 <= n && n <= FNAME_MAX
{
  let mut j = 0;
  while j < NSUID_APPLETS
    invariant j <= NSUID_APPLETS
  {
    if xfer_is(x, 4, n, suid_name(j)) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// Stores v little-endian in bytes at..at+8 of x.
fn xfer_u64(x: &mut Bytes, at: u64, v: u64)
  requires at + 8 <= blen(x)
  ensures blen(x) == old(blen(x))
{
  store_le64(&mut x, at, v);
}
