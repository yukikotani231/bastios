// Linux process calls: fork, execve, wait4, and the file metadata calls a
// shell needs to find programs (stat, access). Programs are the kernel's
// built-in images, found at /bin/NAME; files are the file system's, at
// /NAME.

import "linux.bastio";

// ---------------------------------------------------------------- fork

/// fork (and vfork, which may share memory but need not): a copy of
/// process `pid` (its window, registers, FPU state, program break) that
/// returns 0 where the parent gets the child's id. The child shares the
/// parent's open descriptors. Returns the child's id or -errno.
fn lx_fork(k: &mut Kernel, mmu: &Mmu, pid: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let c = free_pid(k.procs);
  if c == 0 {
    return EAGAIN;
  }
  let fp = find_free(&mut k.mem);
  if fp >= NPAGES {
    return ENOMEM;
  }
  let mut fpu = take_page(&mut k.mem, fp);
  match take_fpu(&mut k.fpus, pid) {
    Fpu::None => {},
    Fpu::State(g) => {
      copy_frame(&mut fpu, g);
      put_fpu(&mut k.fpus, pid, Fpu::State(g));
    },
  }
  match fork_space(&mut k.mem, &mut k.spaces, pid) {
    Space::Empty => {
      give_page(&mut k.mem, fpu);
      return ENOMEM;
    },
    Space::Mapped(t) => { return fork_into(&mut k, mmu, pid, c, t, fpu); },
  }
}

/// lx_fork, once the child's address space `t` and FPU page are made:
/// installs them as process `c`, a copy of `pid`.
fn fork_into(k: &mut Kernel, mmu: &Mmu, pid: u64, c: u64, t: PageTable, fpu: Frame) -> u64
  requires kok(k) && pid < NPROC && 1 <= c && c < NPROC && pt_level(t) == 4 && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  // A FREE process has no address space; check it rather than assume it.
  match take_space(&mut k.spaces, c) {
    Space::Empty => {},
    Space::Mapped(u) => {
      put_space(&mut k.spaces, c, Space::Mapped(u));
      free_space(&mut k.mem, mmu, t);
      give_page(&mut k.mem, fpu);
      return EAGAIN;
    },
  }
  put_space(&mut k.spaces, c, Space::Mapped(t));
  drop_fpu(&mut k.mem, take_fpu(&mut k.fpus, c));
  put_fpu(&mut k.fpus, c, Fpu::State(fpu));
  let mut f = 0;
  while f < STRIDE
    invariant f <= STRIDE && len(k.procs) == PTAB_LEN
  {
    pset(&mut k.procs, c, f, pget(k.procs, pid, f));
    f = f + 1;
  }
  pset(&mut k.procs, c, F_WAIT, 0);
  pset(&mut k.procs, c, F_CODE, 0);
  pset(&mut k.procs, c, F_TICKS, 0);
  pset(&mut k.procs, c, F_PARENT, pid);
  pset(&mut k.procs, c, F_REGS + R_RAX, 0);
  lx_fd_fork(&mut k, pid, c);
  pset(&mut k.procs, c, F_STATE, READY);
  return c;
}

/// A copy of process `pid`'s address space, or `Space::Empty`.
fn fork_space(m: &mut Mem, spaces: &mut Vec[Space], pid: u64) -> Space
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC
  ensures mem_ok(m) && spaces_ok(spaces)
  ensures result is Space::Mapped ==> pt_level(result.Mapped) == 4
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return Space::Empty; },
    Space::Mapped(mut root) => {
      let c = clone_space(&mut m, &mut root);
      put_space(&mut spaces, pid, Space::Mapped(root));
      return c;
    },
  }
}

// ---------------------------------------------------------------- execve

/// execve(path, argv, envp): replaces process `pid`'s program with the one
/// at `path` (/bin/NAME), passing argv and envp.
/// Descriptors stay open unless marked close-on-exec. Returns 0 (the new program's rax) or -errno, in
/// which case the old program carries on.
fn lx_execve(k: &mut Kernel, mmu: &Mmu, pid: u64, path: u64, argv: u64, envp: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let prog = lx_prog_at(&mut k, pid, path);
  if prog >= NPROGS {
    return ENOENT;
  }
  let mut args = balloc(ARGS_MAX);
  let alen = lx_args(&mut k, pid, argv, &mut args, 0, ARGV_MAX);
  if alen > ARGS_MAX {
    bfree(args);
    return alen;                              // -errno
  }
  let total = lx_args(&mut k, pid, envp, &mut args, alen, ENVC_MAX);
  if total > ARGS_MAX || total < alen {
    bfree(args);
    return E2BIG;
  }
  let sp = load_image(&mut k.mem, &mut k.procs, k.ticks % 0x100000000 * NPROC + pid, pid, prog, args, alen, total);
  bfree(args);
  match sp {
    Space::Empty => { return ENOEXEC; },
    Space::Mapped(new) => {
      match take_space(&mut k.spaces, pid) {
        Space::Empty => {},
        Space::Mapped(t) => { free_space(&mut k.mem, mmu, t); },
      }
      put_space(&mut k.spaces, pid, Space::Mapped(new));
    },
  }
  lx_fd_close_all(&mut k, pid, true);
  match take_fpu(&mut k.fpus, pid) {
    Fpu::None => {},
    Fpu::State(mut f) => {
      let mut i = 0;
      while i < 512
        invariant i <= 512
      {
        frame_write(&mut f, i, 0);
        i = i + 1;
      }
      fpu_init(&mut f);
      put_fpu(&mut k.fpus, pid, Fpu::State(f));
    },
  }
  return 0;
}

/// The program at user path `va`: /bin/NAME for a built-in image NAME.
/// Returns its index, or NPROGS if there is none.
fn lx_prog_at(k: &mut Kernel, pid: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_in(&mut k, pid, va);
  if n == NO_RESULT || n <= 4 || !xfer_bin(k.fs.xfer) {
    return NPROGS;
  }
  let mut i = 0;
  while i < NPROGS
    invariant i <= NPROGS && n <= FNAME_MAX && kok(k)
  {
    if xfer_is(k.fs.xfer, 4, n, prog_name(i)) {
      return i;
    }
    i = i + 1;
  }
  return NPROGS;
}

/// Whether the transfer buffer starts with "bin/".
fn xfer_bin(x: &Bytes) -> bool
  requires blen(x) == XFER
{
  return bget(x, 0) == 98 && bget(x, 1) == 105 && bget(x, 2) == 110 && bget(x, 3) == 47;
}

/// Whether bytes from..to of x are `name`.
fn xfer_is(x: &Bytes, from: u64, to: u64, name: Str) -> bool
  requires from <= to && to <= blen(x)
{
  if to - from != slen(name) {
    return false;
  }
  let mut i = 0;
  while i < slen(name)
    invariant i <= slen(name) && from + slen(name) == to
  {
    if bget(x, from + i) != sget(name, i) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// Copies the strings of the NULL-ended array of at most `most` string
/// pointers at user address `argv` into `args` from byte `from`, each with
/// its NUL. Returns where they end, or -errno (more than ARGS_MAX) if a
/// pointer is bad or they do not fit.
fn lx_args(k: &mut Kernel, pid: u64, argv: u64, args: &mut Bytes, from: u64, most: u64) -> u64
  requires kok(k) && pid < NPROC && blen(args) == ARGS_MAX && from <= ARGS_MAX
  ensures kok(k) && blen(args) == ARGS_MAX
  ensures result <= ARGS_MAX ==> from <= result
{
  if argv == 0 {
    return from;
  }
  if argv < USER_BASE || argv >= USER_BASE + USER_SIZE || most > ARGV_MAX {
    return EFAULT;
  }
  let mut alen = from;
  let mut j = 0;
  while j < most
    invariant j <= most && most <= ARGV_MAX && from <= alen && alen <= ARGS_MAX && kok(k) && blen(args) == ARGS_MAX
    invariant argv < USER_BASE + USER_SIZE
  {
    let w = user_u64(&mut k.spaces, pid, argv + 8 * j);
    if !w.ok {
      return EFAULT;
    }
    if w.v == 0 {
      return alen;
    }
    if w.v < USER_BASE || w.v >= USER_BASE + USER_SIZE {
      return EFAULT;
    }
    let want = smaller(ARGS_MAX - alen, USER_SIZE - (w.v - USER_BASE));
    let got = copy_from_user(&mut k.spaces, pid, w.v, &mut k.fs.xfer, want);
    if got == NO_RESULT {
      return EFAULT;
    }
    let mut e = 0;
    while e < got && bget(k.fs.xfer, e) != 0
      invariant e <= got && got <= want && kok(k)
    {
      e = e + 1;
    }
    if e >= got {
      return E2BIG;                           // no NUL in what fits
    }
    let mut i = 0;
    while i <= e
      invariant i <= e + 1 && e < got && got <= ARGS_MAX - alen && kok(k) && blen(args) == ARGS_MAX
    {
      bset(&mut args, alen + i, bget(k.fs.xfer, i));
      i = i + 1;
    }
    alen = alen + e + 1;
    j = j + 1;
  }
  return E2BIG;
}

// ---------------------------------------------------------------- wait4

/// wait4(want, status, options, rusage): collects a child that has ended
/// (child `want`, or any for -1 or 0), storing its exit code as the Linux
/// status at user address `status` if not NULL. With none ended yet, the
/// process blocks (WNOHANG: returns 0) and the call is restarted once a
/// child ends. rusage is not filled in.
fn lx_wait4(k: &mut Kernel, pid: u64, want: u64, status: u64, options: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  let any = want == 0 || want >= 0x8000000000000000;
  let mut found = false;
  let mut c = 1;
  while c < NPROC
    invariant 1 <= c && c <= NPROC && kok(k)
  {
    if pget(k.procs, c, F_PARENT) == pid && state(k.procs, c) != FREE && (any || c == want) {
      found = true;
      if state(k.procs, c) == ZOMBIE {
        if status != 0 {
          lx_fill(&mut k, 0, 4);
          bset(&mut k.fs.xfer, 1, pget(k.procs, c, F_CODE) % 256);
          if lx_put_out(&mut k, pid, status, 4) != 0 {
            ret(&mut k.procs, pid, EFAULT);
            return KEEP;
          }
        }
        pset(&mut k.procs, c, F_STATE, FREE);
        ret(&mut k.procs, pid, c);
        return KEEP;
      }
    }
    c = c + 1;
  }
  if !found {
    ret(&mut k.procs, pid, ECHILD);
    return KEEP;
  }
  if options % 2 == WNOHANG {
    ret(&mut k.procs, pid, 0);
    return KEEP;
  }
  let rip = pget(k.procs, pid, F_REGS + R_RIP);
  if rip < 2 {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  pset(&mut k.procs, pid, F_REGS + R_RIP, rip - 2);
  pset(&mut k.procs, pid, F_REGS + R_RAX, LX_WAIT4);
  pset(&mut k.procs, pid, F_STATE, LXWAITING);
  return SWITCH;
}

// ---------------------------------------------------------------- stat

/// stat(path, buf): "/bin" is a directory, /bin/NAME a built-in program,
/// /NAME a file. Owner root, one link, no times. Returns 0 or -errno; with
/// `buf` 0 it only checks that the path exists (access).
fn lx_stat(k: &mut Kernel, pid: u64, path: u64, buf: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_in(&mut k, pid, path);
  if n == NO_RESULT {
    return ENOENT;
  }
  let mut mode = S_IFREG;
  let mut size = 0;
  let mut ino = 1;
  if n == 3 && bget(k.fs.xfer, 0) == 98 && bget(k.fs.xfer, 1) == 105 && bget(k.fs.xfer, 2) == 110 {
    mode = S_IFDIR;
  } else if n > 4 && xfer_bin(k.fs.xfer) {
    let mut i = 0;
    let mut prog = NPROGS;
    while i < NPROGS
      invariant i <= NPROGS && n <= FNAME_MAX && kok(k)
    {
      if xfer_is(k.fs.xfer, 4, n, prog_name(i)) {
        prog = i;
      }
      i = i + 1;
    }
    if prog >= NPROGS {
      return ENOENT;
    }
    mode = S_IFREG_X;
    size = slen(prog_image(prog));
    ino = 2 + prog;
  } else {
    size = vfs_stat(&mut k.fs, n);
    if size == NO_FILE {
      return ENOENT;
    }
    ino = 100;
  }
  if buf == 0 {
    return 0;
  }
  lx_fill(&mut k, 0, STAT_SIZE);
  xfer_u64(&mut k.fs.xfer, 8, ino);           // st_ino
  xfer_u64(&mut k.fs.xfer, 16, 1);            // st_nlink
  xfer_u64(&mut k.fs.xfer, 24, mode);         // st_mode (and st_uid 0)
  xfer_u64(&mut k.fs.xfer, 48, size);         // st_size
  xfer_u64(&mut k.fs.xfer, 56, 4096);         // st_blksize
  let mut blocks = size / 512;
  if size % 512 != 0 {
    blocks = blocks + 1;
  }
  xfer_u64(&mut k.fs.xfer, 64, blocks);       // st_blocks
  return lx_put_out(&mut k, pid, buf, STAT_SIZE);
}

/// Stores v little-endian in bytes at..at+8 of x.
fn xfer_u64(x: &mut Bytes, at: u64, v: u64)
  requires at + 8 <= blen(x)
  ensures blen(x) == old(blen(x))
{
  let mut r = v;
  let mut i = 0;
  while i < 8
    invariant i <= 8 && at + 8 <= blen(x)
  {
    bset(&mut x, at + i, r % 256);
    r = r / 256;
    i = i + 1;
  }
}
