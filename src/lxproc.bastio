// Linux process calls: fork, execve, wait4, and the file metadata calls a
// shell needs to find programs (stat, access). Programs are the kernel's
// built-in images, found at /bin/NAME; files are the file system's, at
// /NAME.

import "linux.bastio";
import "lxdev.bastio";
import "core/endian.bastio";
import "core/bytes.bastio";

// ---------------------------------------------------------------- fork

/// fork (and vfork, which may share memory but need not): a copy of
/// process `pid` (its window, registers, FPU state, program break) that
/// returns 0 where the parent gets the child's id. The child shares the
/// parent's open descriptors. Returns the child's id or -errno.
fn lx_fork(k: &mut Kernel, mmu: &Mmu, pid: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let lim = nproc_check(k, pid);
  if lim != 0 {
    return lim;                             // -EAGAIN: RLIMIT_NPROC
  }
  let c = free_pid(k.procs);
  if c == 0 {
    return EAGAIN;
  }
  let fp = find_free(&mut k.mem);
  if fp >= NPAGES {
    return ENOMEM;
  }
  let mut fpu = take_page(&mut k.mem, fp);
  match take_fpu(&mut k.fpus, pid) {
    Fpu::None => {},
    Fpu::State(g) => {
      copy_frame(&mut fpu, g);
      put_fpu(&mut k.fpus, pid, Fpu::State(g));
    },
  }
  match fork_space(&mut k.mem, &mut k.spaces, pid) {
    Space::Empty => {
      give_page(&mut k.mem, fpu);
      return ENOMEM;
    },
    Space::Mapped(t) => { return fork_into(&mut k, mmu, pid, c, t, fpu); },
  }
}

/// clone(CLONE_VM | CLONE_VFORK, stack), as posix_spawn makes it: the
/// child runs in the parent's own address space, on `stack`, while the
/// parent waits (LXVFORK). The space is not shared: it moves to the child
/// and moves back when the child calls execve or ends (vfork_give_back).
fn lx_vfork_vm(k: &mut Kernel, mmu: &Mmu, pid: u64, stack: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let c = free_pid(k.procs);
  if c == 0 {
    return EAGAIN;
  }
  // fork_into frees the space it is given if c turns out to have one:
  // that must never be the parent's.
  match take_space(&mut k.spaces, c) {
    Space::Empty => {},
    Space::Mapped(u) => {
      put_space(&mut k.spaces, c, Space::Mapped(u));
      return EAGAIN;
    },
  }
  let fp = find_free(&mut k.mem);
  if fp >= NPAGES {
    return ENOMEM;
  }
  let mut fpu = take_page(&mut k.mem, fp);
  match take_fpu(&mut k.fpus, pid) {
    Fpu::None => {},
    Fpu::State(g) => {
      copy_frame(&mut fpu, g);
      put_fpu(&mut k.fpus, pid, Fpu::State(g));
    },
  }
  match take_space(&mut k.spaces, pid) {
    Space::Empty => {
      give_page(&mut k.mem, fpu);
      return ENOMEM;
    },
    Space::Mapped(t) => {
      if fork_into(&mut k, mmu, pid, c, t, fpu) != c {
        return EAGAIN;
      }
    },
  }
  if stack != 0 {
    pset(&mut k.procs, c, F_REGS + R_RSP, stack);
  }
  ret(&mut k.procs, pid, c);
  pset(&mut k.procs, pid, F_WAIT, c);
  pset(&mut k.procs, pid, F_STATE, LXVFORK);
  return c;
}

/// If process `c` runs in an address space its parent lent it (see
/// lx_vfork_vm), gives the space back and wakes the parent. Afterwards c
/// has no address space.
fn vfork_give_back(k: &mut Kernel, mmu: &Mmu, c: u64)
  requires kok(k) && 1 <= c && c < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let par = pget(k.procs, c, F_PARENT);
  if par == 0 || par >= NPROC || state(k.procs, par) != LXVFORK || pget(k.procs, par, F_WAIT) != c {
    return;
  }
  match take_space(&mut k.spaces, c) {
    Space::Empty => {},
    Space::Mapped(t) => {
      match take_space(&mut k.spaces, par) {
        Space::Empty => { put_space(&mut k.spaces, par, Space::Mapped(t)); },
        Space::Mapped(u) => {
          put_space(&mut k.spaces, par, Space::Mapped(u));
          free_space(&mut k.mem, mmu, t);
        },
      }
    },
  }
  pset(&mut k.procs, par, F_WAIT, 0);
  pset(&mut k.procs, par, F_STATE, READY);
}

/// lx_fork, once the child's address space `t` and FPU page are made:
/// installs them as process `c`, a copy of `pid`.
fn fork_into(k: &mut Kernel, mmu: &Mmu, pid: u64, c: u64, t: PageTable, fpu: Frame) -> u64
  requires kok(k) && pid < NPROC && 1 <= c && c < NPROC && pt_level(t) == 4 && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  // A FREE process has no address space; check it rather than assume it.
  match take_space(&mut k.spaces, c) {
    Space::Empty => {},
    Space::Mapped(u) => {
      put_space(&mut k.spaces, c, Space::Mapped(u));
      free_space(&mut k.mem, mmu, t);
      give_page(&mut k.mem, fpu);
      return EAGAIN;
    },
  }
  put_space(&mut k.spaces, c, Space::Mapped(t));
  drop_fpu(&mut k.mem, take_fpu(&mut k.fpus, c));
  put_fpu(&mut k.fpus, c, Fpu::State(fpu));
  let mut f = 0;
  while f < STRIDE
    invariant f <= STRIDE && len(k.procs) == PTAB_LEN
  {
    pset(&mut k.procs, c, f, pget(k.procs, pid, f));
    f = f + 1;
  }
  pset(&mut k.procs, c, F_WAIT, 0);
  pset(&mut k.procs, c, F_CODE, 0);
  pset(&mut k.procs, c, F_TICKS, 0);
  pset(&mut k.procs, c, F_PARENT, pid);
  pset(&mut k.procs, c, F_REGS + R_RAX, 0);
  pset(&mut k.procs, c, F_TGID, 0);         // a fork of a thread is a new process
  pr_fork(&mut k, pid, c);
  group_fork(&mut k.procs, pid, c);
  pset(&mut k.procs, c, F_CTID, 0);
  pset(&mut k.procs, c, F_FUTEX, 0);
  pset(&mut k.procs, c, F_QUIET, 0);
  let mut w = F_VTIMER;
  while w < F_PTIMER + 2
    invariant F_VTIMER <= w && w <= F_PTIMER + 2 && len(k.procs) == PTAB_LEN && kok(k)
  {
    pset(&mut k.procs, c, w, 0);            // a child does not inherit interval timers
    w = w + 1;
  }
  lx_fd_fork(&mut k, pid, c);
  map_fork(&mut k, pid, c);
  shm_fork(&mut k, pid, c);
  sig_fork(&mut k.sigact, pid, c);
  cwd_fork(&mut k.cwd, pid, c);
  pset(&mut k.procs, c, F_SIGPEND, 0);
  pset(&mut k.procs, c, F_RESTART, 0);
  pset(&mut k.procs, c, F_STATE, READY);
  return c;
}

/// A copy of process `pid`'s address space, or `Space::Empty`.
fn fork_space(m: &mut Mem, spaces: &mut Vec[Space], pid: u64) -> Space
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC
  ensures mem_ok(m) && spaces_ok(spaces)
  ensures result is Space::Mapped ==> pt_level(result.Mapped) == 4
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return Space::Empty; },
    Space::Mapped(mut root) => {
      let c = clone_space(&mut m, &mut root);
      put_space(&mut spaces, pid, Space::Mapped(root));
      return c;
    },
  }
}

// ---------------------------------------------------------------- execve

/// execve(path, argv, envp): replaces process `pid`'s program with the one
/// at `path` (/bin/NAME, or an ELF file /NAME), passing argv and envp.
/// Descriptors stay open unless marked close-on-exec. Returns 0 (the new program's rax) or -errno, in
/// which case the old program carries on.
fn lx_execve(k: &mut Kernel, mmu: &Mmu, pid: u64, path: u64, argv: u64, envp: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  k.perr = ENOENT;
  let src = lx_src_at(&mut k, pid, path);
  if !src.file && src.prog >= NPROGS {
    return k.perr;
  }
  let mut args = balloc(ARGS_MAX);
  let mut alen = lx_args(&mut k, pid, argv, &mut args, 0, ARGV_MAX);
  if alen > ARGS_MAX {
    bfree(args);
    return alen;                              // -errno
  }
  if alen == 0 {
    bset(&mut args, 0, 0);                  // no arguments: argv[0] is "", as on Linux
    alen = 1;
  }
  let total = lx_args(&mut k, pid, envp, &mut args, alen, ENVC_MAX);
  if total > ARGS_MAX || total < alen {
    bfree(args);
    return E2BIG;
  }
  let from_file = src.file;
  let image = src.f;
  let sp = load_image(&mut k.mem, &mut k.fs, &mut k.procs, k.ticks % 0x100000000 * NPROC + pid, k.tsc, k.epoch, pid, src, args, alen, total);
  bfree(args);
  match sp {
    Space::Empty => { return ENOEXEC; },
    Space::Mapped(new) => {
      map_drop_all(&mut k, pid);            // shared file pages go back first
      vfork_give_back(&mut k, mmu, pid);
      match take_space(&mut k.spaces, pid) {
        Space::Empty => {},
        Space::Mapped(t) => { free_space(&mut k.mem, mmu, t); },
      }
      put_space(&mut k.spaces, pid, Space::Mapped(new));
    },
  }
  shm_drop_all(&mut k, pid);
  lx_fd_close_all(&mut k, pid, true);
  sig_reset(&mut k.sigact, pid, true);
  pset(&mut k.procs, pid, F_ALTSIZE, 0);  // and the alternate signal stack
  pr_exec(&mut k, pid);                   // the name becomes the program's
  ptimer_clear(&mut k, pid);              // execve deletes POSIX timers
  exec_ids(&mut k, pid, from_file, image); // set-user-ID and set-group-ID files
  match take_fpu(&mut k.fpus, pid) {
    Fpu::None => {},
    Fpu::State(mut f) => {
      let mut i = 0;
      while i < 512
        invariant i <= 512
      {
        frame_write(&mut f, i, 0);
        i = i + 1;
      }
      fpu_init(&mut f);
      put_fpu(&mut k.fpus, pid, Fpu::State(f));
    },
  }
  return 0;
}

/// The executable at user path `va`: built-in image NAME for /bin/NAME,
/// otherwise the file. Not found: a built-in Src with prog NPROGS, and
/// the -errno in k.perr (EACCES for a file the process may not run).
fn lx_src_at(k: &mut Kernel, pid: u64, va: u64) -> Src
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let none = Src { file: false, prog: NPROGS, f: 0, size: 0 };
  let n = lx_path_in(&mut k, pid, va);
  if n == NO_RESULT {
    return none;
  }
  let mut pf = 0;
  if n <= XFER {
    pf = proc_file(k.procs, k.fs.xfer, n);
  }
  if is_exe_file(pf) {
    return exe_src(&mut k, (pf - PROC_DEV) / 16);
  }
  if n > 4 && xfer_bin(k.fs.xfer) {
    let prog = lx_prog_at(&mut k, pid, va);
    return Src { file: false, prog: prog, f: 0, size: slen(prog_image(prog)) };
  }
  k.perr = ENOENT;
  let f = vfs_lookup(&mut k.fs, n);
  if f == NO_FILE {
    if dir_at(&mut k, n) != NO_FILE {
      k.perr = EACCES;                      // a directory
    }
    return none;
  }
  if may_path(&mut k, pid, n, MAY_X) != 0 {
    k.perr = EACCES;                        // no execute permission (src/lxperm.bastio)
    return none;
  }
  let size = vfs_size(&mut k.fs, f);
  if size == NO_FILE {
    return none;
  }
  return Src { file: true, prog: NPROGS, f: f, size: size };
}

/// The program process p is running, for an exec of /proc/PID/exe (as
/// BusyBox's ash does to run a script that execve calls ENOEXEC). Not
/// there: a built-in Src with prog NPROGS.
fn exe_src(k: &mut Kernel, p: u64) -> Src
  requires kok(k)
  ensures kok(k)
{
  let none = Src { file: false, prog: NPROGS, f: 0, size: 0 };
  if p >= NPROC {
    return none;
  }
  let prog = pget(k.procs, p, F_PROG);
  if prog < NPROGS {
    return Src { file: false, prog: prog, f: 0, size: slen(prog_image(prog)) };
  }
  if prog == NPROGS {
    return none;
  }
  let f = prog - NPROGS - 1;
  let size = vfs_size(&mut k.fs, f);
  if size == NO_FILE {
    return none;
  }
  return Src { file: true, prog: NPROGS, f: f, size: size };
}

/// The program at user path `va`: /bin/NAME for a built-in image NAME.
/// Returns its index, or NPROGS if there is none.
fn lx_prog_at(k: &mut Kernel, pid: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_in(&mut k, pid, va);
  if n == NO_RESULT || n <= 4 || !xfer_bin(k.fs.xfer) {
    return NPROGS;
  }
  return bin_prog(k.fs.xfer, n);
}

/// Whether the transfer buffer starts with "bin/".
fn xfer_bin(x: &Bytes) -> bool
  requires blen(x) == XFER
{
  return bget(x, 0) == 98 && bget(x, 1) == 105 && bget(x, 2) == 110 && bget(x, 3) == 47;
}

/// Whether bytes from..to of x are `name`.
fn xfer_is(x: &Bytes, from: u64, to: u64, name: Str) -> bool
  requires from <= to && to <= blen(x)
{
  return bytes_span_eq_str(x, from, to, name);
}

/// Copies the strings of the NULL-ended array of at most `most` string
/// pointers at user address `argv` into `args` from byte `from`, each with
/// its NUL. Returns where they end, or -errno (more than ARGS_MAX) if a
/// pointer is bad or they do not fit.
fn lx_args(k: &mut Kernel, pid: u64, argv: u64, args: &mut Bytes, from: u64, most: u64) -> u64
  requires kok(k) && pid < NPROC && blen(args) == ARGS_MAX && from <= ARGS_MAX
  ensures kok(k) && blen(args) == ARGS_MAX
  ensures result <= ARGS_MAX ==> from <= result
{
  if argv == 0 {
    return from;
  }
  if argv < USER_BASE || argv >= USER_BASE + USER_SIZE || most > ARGV_MAX {
    return EFAULT;
  }
  let mut alen = from;
  let mut j = 0;
  while j < most
    invariant j <= most && most <= ARGV_MAX && from <= alen && alen <= ARGS_MAX && kok(k) && blen(args) == ARGS_MAX
    invariant argv < USER_BASE + USER_SIZE
  {
    let w = user_u64(&mut k.spaces, pid, argv + 8 * j);
    if !w.ok {
      return EFAULT;
    }
    if w.v == 0 {
      return alen;
    }
    if w.v < USER_BASE || w.v >= USER_BASE + USER_SIZE {
      return EFAULT;
    }
    let want = smaller(ARGS_MAX - alen, USER_SIZE - (w.v - USER_BASE));
    let got = copy_from_user(&mut k.spaces, pid, w.v, &mut k.fs.xfer, want);
    if got == NO_RESULT {
      return EFAULT;
    }
    let mut e = 0;
    while e < got && bget(k.fs.xfer, e) != 0
      invariant e <= got && got <= want && kok(k)
    {
      e = e + 1;
    }
    if e >= got {
      return E2BIG;                           // no NUL in what fits
    }
    let mut i = 0;
    while i <= e
      invariant i <= e + 1 && e < got && got <= ARGS_MAX - alen && kok(k) && blen(args) == ARGS_MAX
    {
      bset(&mut args, alen + i, bget(k.fs.xfer, i));
      i = i + 1;
    }
    alen = alen + e + 1;
    j = j + 1;
  }
  return E2BIG;
}

// ---------------------------------------------------------------- wait4

/// Whether wait4's pid argument `want` names child c of pid: -1 any child,
/// 0 one in pid's process group, -g one in group g, else that pid.
fn wait_match(procs: &Buf, pid: u64, c: u64, want: u64) -> bool
  requires len(procs) == PTAB_LEN && pid < NPROC && c < NPROC
{
  if want == 0xFFFFFFFFFFFFFFFF {
    return true;
  }
  if want == 0 {
    return pgid_of(procs, c) == pgid_of(procs, pid);
  }
  if want >= 0x8000000000000000 {
    return pgid_of(procs, c) == 0xFFFFFFFFFFFFFFFF - want + 1;
  }
  return c == want;
}

/// wait4(want, status, options, rusage): collects a child that has ended
/// (one wait_match names), storing its exit code as the Linux
/// status at user address `status` if not NULL. With none ended yet, the
/// process blocks (WNOHANG: returns 0) and the call is restarted once a
/// child ends. rusage is not filled in.
fn lx_wait4(k: &mut Kernel, pid: u64, pidarg: u64, status: u64, options: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  // WNOHANG, WUNTRACED, WCONTINUED, __WNOTHREAD, __WALL and __WCLONE.
  if options % 0x100000000 & !0xE000000B != 0 {
    ret(&mut k.procs, pid, EINVAL);
    return KEEP;
  }
  let p32 = pidarg % 0x100000000;           // a pid_t
  if p32 == 0x80000000 {
    ret(&mut k.procs, pid, ESRCH);          // INT_MIN has no group to name
    return KEEP;
  }
  let mut want = p32;
  if p32 > 0x80000000 {
    want = 0xFFFFFFFF00000000 + p32;        // negative: sign-extend
  }
  let mut found = false;
  let mut c = 1;
  while c < NPROC
    invariant 1 <= c && c <= NPROC && kok(k)
  {
    if pget(k.procs, c, F_PARENT) == pid && state(k.procs, c) != FREE && wait_match(k.procs, pid, c, want) {
      found = true;
      // WUNTRACED: stopped (status sig << 8 | 0x7f); WCONTINUED: 0xffff.
      let jr = jc_report(&mut k, c, options & 2 != 0, options & 8 != 0, false);
      if jr != 0 {
        if status != 0 {
          lx_fill(&mut k, 0, 4);
          if jr < 512 {
            bset(&mut k.fs.xfer, 0, 0x7f);
            bset(&mut k.fs.xfer, 1, cast[u8](jr % 256));
          } else {
            bset(&mut k.fs.xfer, 0, 0xff);
            bset(&mut k.fs.xfer, 1, 0xff);
          }
          if lx_put_out(&mut k, pid, status, 4) != 0 {
            ret(&mut k.procs, pid, EFAULT);
            return KEEP;
          }
        }
        ret(&mut k.procs, pid, c);
        return KEEP;
      }
      if state(k.procs, c) == ZOMBIE {
        if status != 0 {
          lx_fill(&mut k, 0, 4);
          let code = pget(k.procs, c, F_CODE);
          if code >= SIG_DEATH {
            bset(&mut k.fs.xfer, 0, cast[u8](code % 128));   // ended by a signal
          } else {
            bset(&mut k.fs.xfer, 1, cast[u8](code % 256));
          }
          if lx_put_out(&mut k, pid, status, 4) != 0 {
            ret(&mut k.procs, pid, EFAULT);
            return KEEP;
          }
        }
        tm_reap(&mut k, pid, c);
        pset(&mut k.procs, c, F_STATE, FREE);
        ret(&mut k.procs, pid, c);
        return KEEP;
      }
    }
    c = c + 1;
  }
  if !found {
    ret(&mut k.procs, pid, ECHILD);
    return KEEP;
  }
  if options % 2 == WNOHANG {
    ret(&mut k.procs, pid, 0);
    return KEEP;
  }
  let rip = pget(k.procs, pid, F_REGS + R_RIP);
  if rip < 2 {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  pset(&mut k.procs, pid, F_REGS + R_RIP, rip - 2);
  pset(&mut k.procs, pid, F_REGS + R_RAX, LX_WAIT4);
  pset(&mut k.procs, pid, F_STATE, LXWAITING);
  pset(&mut k.procs, pid, F_RESTART, 1);
  return SWITCH;
}

/// waitid(idtype, id, info, options): like wait4, with the answer in a
/// siginfo (SIGCHLD, CLD_EXITED or CLD_KILLED, the pid and the status).
/// P_ALL waits for any child, P_PID for one, P_PGID for one in a group.
/// WNOWAIT leaves the child to be waited for again. WEXITED reports ended
/// children, WSTOPPED stopped ones and WCONTINUED continued ones; WNOHANG
/// with none returns 0 with the siginfo's pid 0.
fn lx_waitid(k: &mut Kernel, pid: u64, idtype: u64, id: u64, info: u64, options: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  if options & 14 == 0 || idtype > 2 {
    ret(&mut k.procs, pid, EINVAL);         // none of WEXITED, WSTOPPED, WCONTINUED
    return KEEP;
  }
  // P_ALL any child, P_PID child id, P_PGID one in group id (0: pid's own).
  let mut want = 0xFFFFFFFFFFFFFFFF;
  if idtype == 1 {
    want = id % 0x80000000;
  } else if idtype == 2 {
    want = 0;
    if id % 0x80000000 != 0 {
      want = 0xFFFFFFFFFFFFFFFF - id % 0x80000000 + 1;
    }
  }
  let mut found = false;
  let mut c = 1;
  while c < NPROC
    invariant 1 <= c && c <= NPROC && kok(k)
  {
    if pget(k.procs, c, F_PARENT) == pid && state(k.procs, c) != FREE && wait_match(k.procs, pid, c, want) {
      found = true;
      let jr = jc_report(&mut k, c, options & 2 != 0, options & 8 != 0, options & 0x1000000 != 0);
      if jr != 0 {
        if info != 0 {
          lx_fill(&mut k, 0, 128);
          bset(&mut k.fs.xfer, 0, 17);              // si_signo: SIGCHLD
          bset(&mut k.fs.xfer, 8, cast[u8](4 + jr / 256));   // CLD_STOPPED (5), CLD_CONTINUED (6)
          bset(&mut k.fs.xfer, 16, cast[u8](c));    // si_pid
          bset(&mut k.fs.xfer, 24, cast[u8](jr % 256));      // si_status: the signal
          if lx_put_out(&mut k, pid, info, 128) != 0 {
            ret(&mut k.procs, pid, EFAULT);
            return KEEP;
          }
        }
        ret(&mut k.procs, pid, 0);
        return KEEP;
      }
      if state(k.procs, c) == ZOMBIE && options & 4 != 0 {
        if info != 0 {
          lx_fill(&mut k, 0, 128);
          let code = pget(k.procs, c, F_CODE);
          bset(&mut k.fs.xfer, 0, 17);              // si_signo: SIGCHLD
          bset(&mut k.fs.xfer, 16, cast[u8](c));    // si_pid
          if code >= SIG_DEATH {
            bset(&mut k.fs.xfer, 8, 2);             // si_code: CLD_KILLED
            bset(&mut k.fs.xfer, 24, cast[u8](code % 128));
          } else {
            bset(&mut k.fs.xfer, 8, 1);             // CLD_EXITED
            bset(&mut k.fs.xfer, 24, cast[u8](code % 256));
          }
          if lx_put_out(&mut k, pid, info, 128) != 0 {
            ret(&mut k.procs, pid, EFAULT);
            return KEEP;
          }
        }
        if options & 0x1000000 == 0 {
          tm_reap(&mut k, pid, c);
          pset(&mut k.procs, c, F_STATE, FREE);
        }
        ret(&mut k.procs, pid, 0);
        return KEEP;
      }
    }
    c = c + 1;
  }
  if !found {
    ret(&mut k.procs, pid, ECHILD);
    return KEEP;
  }
  if options % 2 == WNOHANG {
    if info != 0 {
      lx_fill(&mut k, 0, 128);
      if lx_put_out(&mut k, pid, info, 128) != 0 {
        ret(&mut k.procs, pid, EFAULT);
        return KEEP;
      }
    }
    ret(&mut k.procs, pid, 0);
    return KEEP;
  }
  let r = lx_retry(&mut k, pid, LX_WAITID);
  if r == SWITCH {
    pset(&mut k.procs, pid, F_STATE, LXWAITING);
  }
  return r;
}

/// times(buf): the caller's user and system time, and its waited-for
/// children's, in clock ticks; returns the ticks since boot.
fn lx_times(k: &mut Kernel, pid: u64, buf: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if buf != 0 {
    lx_fill(&mut k, 0, 32);
    xfer_u64(&mut k.fs.xfer, 0, pget(k.procs, pid, F_TICKS));
    xfer_u64(&mut k.fs.xfer, 8, tm_ticks(k, pid, 0));
    xfer_u64(&mut k.fs.xfer, 16, tm_ticks(k, pid, 1));
    xfer_u64(&mut k.fs.xfer, 24, tm_ticks(k, pid, 2));
    if lx_put_out(&mut k, pid, buf, 32) != 0 {
      return EFAULT;
    }
  }
  return k.ticks;
}

// ---------------------------------------------------------------- stat

/// What stat says about a path or descriptor.
struct Meta { ok: bool, mode: u64, size: u64, ino: u64, mtime: u64, own: u64 }   // own: uid + gid * 2^32

/// stat(path, buf): "/", "/bin" and the file layer's directories are
/// directories, /bin/NAME a built-in program, anything else a file. The mode's permission bits, the owner and the times come from the file system (root owns the rest). Returns 0 or
/// -errno; with `buf` 0 it only checks that the path exists (access).
fn lx_stat(k: &mut Kernel, pid: u64, dirfd: u64, path: u64, buf: u64, follow: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut n = NO_RESULT;
  if follow {
    n = lx_path_at(&mut k, pid, dirfd, path);
  } else {
    n = lx_path_at_nf(&mut k, pid, dirfd, path);   // lstat: a link itself
  }
  if n == NO_RESULT {
    return k.perr;
  }
  let m = path_meta(&mut k, n);
  if !m.ok {
    return ENOENT;
  }
  if buf == 0 {
    return 0;
  }
  return put_stat(&mut k, pid, buf, m);
}

/// The metadata of the path in the first n bytes of the transfer buffer.
fn path_meta(k: &mut Kernel, n: u64) -> Meta
  requires kok(k) && n <= FNAME_MAX
  ensures kok(k)
{
  let none = Meta { ok: false, mode: 0, size: 0, ino: 0, mtime: 0, own: 0 };
  let dev = dev_at(k.fs.xfer, n);
  if dev != DEV_NONE {
    return dev_meta(dev);
  }
  let pf = proc_file(k.procs, k.fs.xfer, n);
  if pf != 0 {
    return proc_meta(pf);
  }
  let dir = dir_at(&mut k, n);
  if dir != NO_FILE {
    if dir >= DIR_PROC {
      return proc_dir_meta(dir);
    }
    if dir >= DIR_VFS {
      let dm = vfs_meta(&mut k.fs, dir - DIR_VFS);
      return Meta { ok: true, mode: S_IFMT_DIR + dm.mode % 4096, size: 0, ino: 1 + dir, mtime: dm.mtime, own: dm.own };
    }
    return Meta { ok: true, mode: S_IFDIR, size: 0, ino: 1 + dir, mtime: 0, own: 0 };
  }
  if n > 4 && xfer_bin(k.fs.xfer) {
    let prog = bin_prog(k.fs.xfer, n);
    if prog >= NPROGS {
      return none;
    }
    return Meta { ok: true, mode: S_IFREG_X, size: slen(prog_image(prog)), ino: INO_PROGS + prog, mtime: 0, own: 0 };
  }
  return file_meta(&mut k.fs, vfs_lookup(&mut k.fs, n));
}

/// The metadata of file f (a vfs_lookup handle). Its inode number is the
/// handle, past the ones the directories and built-in programs use.
fn file_meta(v: &mut Vfs, f: u64) -> Meta
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let size = vfs_size(&mut v, f);
  let fm = vfs_meta(&mut v, f);
  if size == NO_FILE || !fm.ok || f >= HFILES {
    return Meta { ok: false, mode: 0, size: 0, ino: 0, mtime: 0, own: 0 };
  }
  let mut kind = S_IFMT_REG;
  if fm.mode % 65536 / 4096 * 4096 == T_LINK {
    kind = T_LINK;                          // a symbolic link: only lstat gets this far
  } else if fm.mode % 65536 / 4096 * 4096 == T_FIFO {
    kind = T_FIFO;                          // a named pipe
  }
  return Meta { ok: true, mode: kind + fm.mode % 4096, size: size, ino: INO_FILES + f, mtime: fm.mtime, own: fm.own };
}

/// fstat(fd, buf): the console is a terminal, a pipe a FIFO; a file's size
/// comes from its row.
fn lx_fstat(k: &mut Kernel, pid: u64, fd: u64, buf: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  let mut m = dev_meta(DEV_TTY);           // the console is /dev/tty
  if d.kind == K_BAD {
    return EBADF;
  } else if d.kind == K_PIPE_R || d.kind == K_PIPE_W {
    m = Meta { ok: true, mode: S_IFIFO, size: 0, ino: 4, mtime: 0, own: 0 };
  } else if d.kind == K_DIR {
    m = Meta { ok: true, mode: S_IFDIR, size: 0, ino: 1, mtime: 0, own: 0 };
  } else if d.kind == K_SOCK {
    m = Meta { ok: true, mode: S_IFSOCK, size: 0, ino: 5, mtime: 0, own: 0 };
  } else if d.kind == K_DEV {
    m = dev_meta(d.x);
  } else if d.kind == K_FILE {
    m = file_meta(&mut k.fs, vfs_row_file(k.fs, d.x));
    if !m.ok {
      m = Meta { ok: true, mode: S_IFREG, size: 0, ino: 100, mtime: 0, own: 0 };
    }
  }
  return put_stat(&mut k, pid, buf, m);
}

/// Writes a struct stat for m to user address buf. Returns 0 or -EFAULT.
fn put_stat(k: &mut Kernel, pid: u64, buf: u64, m: Meta) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut nlink = 1;
  if m.ino >= INO_FILES && m.ino < INO_FILES + HFILES {
    nlink = vfs_nlink(&mut k.fs, m.ino - INO_FILES);   // a file and its hard links
  }
  lx_fill(&mut k, 0, STAT_SIZE);
  xfer_u64(&mut k.fs.xfer, 8, m.ino);         // st_ino
  xfer_u64(&mut k.fs.xfer, 16, nlink);        // st_nlink
  xfer_u64(&mut k.fs.xfer, 24, m.mode % 0x100000000 + m.own % 0x100000000 * 0x100000000);   // st_mode, st_uid
  xfer_u64(&mut k.fs.xfer, 32, m.own / 0x100000000);                 // st_gid
  xfer_u64(&mut k.fs.xfer, 48, m.size);       // st_size
  xfer_u64(&mut k.fs.xfer, 56, 4096);         // st_blksize
  let mut blocks = m.size / 512;
  if m.size % 512 != 0 {
    blocks = blocks + 1;
  }
  xfer_u64(&mut k.fs.xfer, 64, blocks);       // st_blocks
  xfer_u64(&mut k.fs.xfer, 72, m.mtime);      // st_atime: not kept apart
  xfer_u64(&mut k.fs.xfer, 88, m.mtime);      // st_mtime
  xfer_u64(&mut k.fs.xfer, 104, m.mtime);     // st_ctime
  return lx_put_out(&mut k, pid, buf, STAT_SIZE);
}

/// Whether the first n bytes of x are "bin".
fn is_bin(x: &Bytes, n: u64) -> bool
  requires blen(x) == XFER
{
  return n == 3 && bget(x, 0) == 98 && bget(x, 1) == 105 && bget(x, 2) == 110;
}

/// The built-in program "bin/NAME" in the first n bytes of x names, or
/// NPROGS. BusyBox's applet names are BusyBox (it picks the applet from
/// argv[0]), and so is /bin/sh: a Linux program running sh (system,
/// popen) wants a POSIX shell, not the BastiOS one.
fn bin_prog(x: &Bytes, n: u64) -> u64
  requires blen(x) == XFER && 4 <= n && n <= FNAME_MAX
{
  if xfer_is(x, 4, n, "sh") {
    return ASH_PROG;
  }
  let mut i = 0;
  while i < NPROGS
    invariant i <= NPROGS
  {
    if xfer_is(x, 4, n, prog_name(i)) {
      return i;
    }
    i = i + 1;
  }
  let mut j = 0;
  while j < NAPPLETS
    invariant j <= NAPPLETS
  {
    if xfer_is(x, 4, n, applet_name(j)) {
      return ASH_PROG;
    }
    j = j + 1;
  }
  return NPROGS;
}

/// The BusyBox applets built in (user/busybox.config), seen as /bin/NAME.
fn applet_name(j: u64) -> Str {
  if j == 0 {
    return "ls";
  }
  if j == 1 {
    return "cat";
  }
  if j == 2 {
    return "wc";
  }
  if j == 3 {
    return "head";
  }
  if j == 4 {
    return "rm";
  }
  if j == 5 {
    return "cp";
  }
  if j == 6 {
    return "kill";
  }
  if j == 7 {
    return "sleep";
  }
  if j == 8 {
    return "mkdir";
  }
  if j == 9 {
    return "rmdir";
  }
  if j == 10 {
    return "pwd";
  }
  if j == 11 {
    return "mv";
  }
  if j == 12 {
    return "chmod";
  }
  if j == 13 {
    return "touch";
  }
  if j == 14 {
    return "stat";
  }
  if j == 15 {
    return "ln";
  }
  if j == 16 {
    return "readlink";
  }
  if j == 17 {
    return "reboot";
  }
  if j == 18 {
    return "poweroff";
  }
  if j == 19 {
    return "mkfifo";
  }
  if j == 20 {
    return "mount";
  }
  if j == 21 {
    return "umount";
  }
  if j == 22 {
    return "truncate";
  }
  return "chown";
}

/// Stores v little-endian in bytes at..at+8 of x.
fn xfer_u64(x: &mut Bytes, at: u64, v: u64)
  requires at + 8 <= blen(x)
  ensures blen(x) == old(blen(x))
{
  store_le64(&mut x, at, v);
}
