// Copying between user memory and kernel byte buffers. The kernel never
// reads or writes memory through an address: it takes the tables of the
// process's user window out of their parents, takes each page out of the
// last table, copies the bytes it wants on that page, and puts everything
// back. The proof shows that only bytes inside [va, va + n) of the window
// are touched, and only bytes inside the kernel buffer's length.

import "pages.bastio";
import "space.bastio";
import "proc.bastio";

/// Is [va, va + n) inside the user window?
fn user_range(va: u64, n: u64) -> bool
  ensures result ==> va >= USER_BASE && va - USER_BASE + n <= USER_SIZE
{
  if va < USER_BASE || va - USER_BASE > USER_SIZE {
    return false;
  }
  return n <= USER_SIZE - (va - USER_BASE);
}

/// How many of the `left` bytes wanted from window offset `a` lie on a's
/// page.
fn chunk(a: u64, left: u64) -> u64
  ensures result <= left && a % 4096 + result <= 4096
  ensures left > 0 ==> result > 0
{
  let room = 4096 - a % 4096;
  if room < left {
    return room;
  }
  return left;
}

/// Copies n bytes from user address va of process pid into the start of
/// buf. Returns the count, short at an unmapped page, or NO_RESULT if the
/// range is not inside the user window. A page of anonymous memory not
/// touched yet (an, src/lxanon.bastio) gets its zero page first, as a
/// fault from the program would.
fn copy_from_user(spaces: &mut Vec[Space], m: &mut Mem, an: &Buf, pid: u64, va: u64, buf: &mut Bytes, n: u64) -> u64
  requires spaces_ok(spaces) && mem_ok(m) && pid < NPROC && n <= blen(buf)
  ensures spaces_ok(spaces) && mem_ok(m) && blen(buf) == old(blen(buf))
  ensures result <= n || result == NO_RESULT
{
  if !user_range(va, n) {
    return NO_RESULT;
  }
  let off = va - USER_BASE;
  let l = blen(buf);
  let mut k = 0;
  let mut last = WPAGES;
  let mut go = true;
  while go
    invariant k <= n && n <= blen(buf) && blen(buf) == l && off + n <= USER_SIZE && spaces_ok(spaces) && mem_ok(m)
  {
    let r = raw_from_user(&mut spaces, pid, off, &mut buf, k, n);
    if r == NO_RESULT {
      return NO_RESULT;
    }
    k = r;
    go = false;
    if k < n && (off + k) / 4096 != last {
      last = (off + k) / 4096;
      go = anon_touch(&mut m, &mut spaces, an, pid, last);
    }
  }
  return k;
}

/// The bytes from k0 on of copy_from_user, without faulting anything in:
/// the new count (k0 or more), or NO_RESULT if pid has no window.
fn raw_from_user(spaces: &mut Vec[Space], pid: u64, off: u64, buf: &mut Bytes, k0: u64, n: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC && k0 <= n && n <= blen(buf) && off + n <= USER_SIZE
  ensures spaces_ok(spaces) && blen(buf) == old(blen(buf))
  ensures (k0 <= result && result <= n) || result == NO_RESULT
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NO_RESULT; },
    Space::Mapped(mut root) => {
      let mut k = k0;
      if pt_has(root, 1) {
        k = pt_borrow(&mut root, 1, l3_to_bytes, off, &mut buf, k0, n);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return k;
    },
  }
}

/// copy_from_user below the top-level table (in place, as other threads
/// may be running on the space).
fn l3_to_bytes(l3: &mut PageTable, off: u64, buf: &mut Bytes, k0: u64, n: u64) -> u64
  requires pt_level(l3) == 3 && off + n <= USER_SIZE && k0 <= n && n <= blen(buf)
  ensures blen(buf) == old(blen(buf))
  ensures k0 <= result && result <= n
{
  let l = blen(buf);
  let mut k = k0;
  let mut ok = true;
  while ok && k < n
    invariant k0 <= k && k <= n && n <= blen(buf) && blen(buf) == l && pt_level(l3) == 3
  {
    let a = off + k;
    let m = chunk(a, n - k);
    if w_read(&mut l3, a, &mut buf, k, m) {
      k = k + m;
    } else {
      ok = false;
    }
  }
  return k;
}

/// Copies the first n bytes of buf to user address va of process pid.
/// Returns the count, short at an unmapped page, or NO_RESULT if the range
/// is not inside the user window. As copy_from_user, a page of anonymous
/// memory not touched yet gets its zero page first, and a copy-on-write
/// page its own copy (cow_touch).
fn copy_to_user(spaces: &mut Vec[Space], m: &mut Mem, an: &Buf, pid: u64, va: u64, buf: &Bytes, n: u64) -> u64
  requires spaces_ok(spaces) && mem_ok(m) && pid < NPROC && n <= blen(buf)
  ensures spaces_ok(spaces) && mem_ok(m)
  ensures result <= n || result == NO_RESULT
{
  if !user_range(va, n) {
    return NO_RESULT;
  }
  let off = va - USER_BASE;
  let mut k = 0;
  let mut last = WPAGES;
  let mut go = true;
  while go
    invariant k <= n && n <= blen(buf) && off + n <= USER_SIZE && spaces_ok(spaces) && mem_ok(m)
  {
    let r = raw_to_user(&mut spaces, pid, off, buf, k, n);
    if r == NO_RESULT {
      return NO_RESULT;
    }
    k = r;
    go = false;
    if k < n && (off + k) / 4096 != last {
      last = (off + k) / 4096;
      // A copy-on-write page first: anon_touch says true for any page
      // that is mapped, a read-only one included.
      go = cow_touch(&mut m, &mut spaces, pid, last) || anon_touch(&mut m, &mut spaces, an, pid, last);
    }
  }
  return k;
}

/// Copies src[s .. s + n] to user address va of process pid as copy_to_user
/// copies a buffer, but straight from the page: no staging buffer between
/// them. Returns the count, short at a page that is not written, or
/// NO_RESULT if the range is not inside the user window.
fn copy_frame_to_user(spaces: &mut Vec[Space], m: &mut Mem, an: &Buf, pid: u64, va: u64, src: &Frame, s: u64, n: u64) -> u64
  requires spaces_ok(spaces) && mem_ok(m) && pid < NPROC && s + n <= 4096
  ensures spaces_ok(spaces) && mem_ok(m)
  ensures result <= n || result == NO_RESULT
{
  if !user_range(va, n) {
    return NO_RESULT;
  }
  let off = va - USER_BASE;
  let mut k = 0;
  let mut last = WPAGES;
  let mut go = true;
  while go
    invariant k <= n && s + n <= 4096 && off + n <= USER_SIZE && spaces_ok(spaces) && mem_ok(m)
  {
    let r = raw_frame_to_user(&mut spaces, pid, off, src, s, k, n);
    if r == NO_RESULT {
      return NO_RESULT;
    }
    k = r;
    go = false;
    if k < n && (off + k) / 4096 != last {
      last = (off + k) / 4096;
      go = cow_touch(&mut m, &mut spaces, pid, last) || anon_touch(&mut m, &mut spaces, an, pid, last);
    }
  }
  return k;
}

/// The bytes from k0 on of copy_frame_to_user, without faulting anything in.
fn raw_frame_to_user(spaces: &mut Vec[Space], pid: u64, off: u64, src: &Frame, s: u64, k0: u64, n: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC && k0 <= n && s + n <= 4096 && off + n <= USER_SIZE
  ensures spaces_ok(spaces)
  ensures (k0 <= result && result <= n) || result == NO_RESULT
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NO_RESULT; },
    Space::Mapped(mut root) => {
      let mut k = k0;
      if pt_has(root, 1) {
        k = pt_borrow(&mut root, 1, frame_to_l3, off, src, s, k0, n);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return k;
    },
  }
}

/// copy_frame_to_user below the top-level table, in place.
fn frame_to_l3(l3: &mut PageTable, off: u64, src: &Frame, s: u64, k0: u64, n: u64) -> u64
  requires pt_level(l3) == 3 && off + n <= USER_SIZE && k0 <= n && s + n <= 4096
  ensures k0 <= result && result <= n
{
  let mut k = k0;
  let mut ok = true;
  while ok && k < n
    invariant k0 <= k && k <= n && pt_level(l3) == 3
  {
    let a = off + k;
    let m = chunk(a, n - k);
    if w_write_fr(&mut l3, a, src, s + k, m) {
      k = k + m;
    } else {
      ok = false;
    }
  }
  return k;
}

/// Copies the first n bytes of buf to user address va of process pid as
/// copy_to_user does, but into a read-only page too if it is the process's
/// own (not shared with others). Faults nothing in. Returns the count, short
/// at a page that is not written, or NO_RESULT if the range is not inside
/// the user window.
fn force_to_user(spaces: &mut Vec[Space], pid: u64, va: u64, buf: &Bytes, n: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC && n <= blen(buf)
  ensures spaces_ok(spaces)
  ensures result <= n || result == NO_RESULT
{
  if !user_range(va, n) {
    return NO_RESULT;
  }
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NO_RESULT; },
    Space::Mapped(mut root) => {
      let mut k = 0;
      if pt_has(root, 1) {
        k = pt_borrow(&mut root, 1, force_to_l3, va - USER_BASE, buf, n);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return k;
    },
  }
}

fn force_to_l3(l3: &mut PageTable, off: u64, buf: &Bytes, n: u64) -> u64
  requires pt_level(l3) == 3 && off + n <= USER_SIZE && n <= blen(buf)
  ensures result <= n
{
  let mut k = 0;
  let mut ok = true;
  while ok && k < n
    invariant k <= n && pt_level(l3) == 3
  {
    let a = off + k;
    let m = chunk(a, n - k);
    if w_write_force(&mut l3, a, buf, k, m) {
      k = k + m;
    } else {
      ok = false;
    }
  }
  return k;
}

/// The bytes from k0 on of copy_to_user, without faulting anything in.
fn raw_to_user(spaces: &mut Vec[Space], pid: u64, off: u64, buf: &Bytes, k0: u64, n: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC && k0 <= n && n <= blen(buf) && off + n <= USER_SIZE
  ensures spaces_ok(spaces)
  ensures (k0 <= result && result <= n) || result == NO_RESULT
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NO_RESULT; },
    Space::Mapped(mut root) => {
      let mut k = k0;
      if pt_has(root, 1) {
        k = pt_borrow(&mut root, 1, bytes_to_l3, off, buf, k0, n);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return k;
    },
  }
}

/// copy_to_user below the top-level table, in place.
fn bytes_to_l3(l3: &mut PageTable, off: u64, buf: &Bytes, k0: u64, n: u64) -> u64
  requires pt_level(l3) == 3 && off + n <= USER_SIZE && k0 <= n && n <= blen(buf)
  ensures k0 <= result && result <= n
{
  let mut k = k0;
  let mut ok = true;
  while ok && k < n
    invariant k0 <= k && k <= n && pt_level(l3) == 3
  {
    let a = off + k;
    let m = chunk(a, n - k);
    if w_write(&mut l3, a, buf, k, m) {
      k = k + m;
    } else {
      ok = false;
    }
  }
  return k;
}

/// The page number behind user address va of process pid if a shared page
/// (MAP_SHARED) is mapped there, or NO_RESULT. Futexes on such a page are
/// known by it (lx_futex), so processes that share the page meet there.
/// A copy-on-write page (`bm` marks it COW_PAGE) is private memory, so it
/// is not one.
fn user_shared_page(spaces: &mut Vec[Space], bm: &Buf, pid: u64, va: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces)
  ensures result < NPAGES || result == NO_RESULT
{
  if !user_range(va, 1) {
    return NO_RESULT;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NO_RESULT; },
    Space::Mapped(mut root) => {
      let mut r = NO_RESULT;
      if pt_has(root, 1) {
        r = pt_borrow(&mut root, 1, l3_shared, off);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      if r < len(bm) && bm_cow(get(bm, r)) {
        return NO_RESULT;
      }
      return r;
    },
  }
}

/// Whether the page at user address va of process pid is a copy-on-write
/// page (`bm` marks it COW_PAGE). The kernel cannot give such a page its
/// own copy while a processor runs user code on the space (cow_touch
/// refuses, see src/lxcow.bastio), so a kernel write for the process that
/// fails there has to wait and try again: the lease may be gone by the time
/// the caller looks, so this does not ask about it.
fn user_cow_page(spaces: &mut Vec[Space], bm: &Buf, pid: u64, va: u64) -> bool
  requires spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces)
{
  if !user_range(va, 1) {
    return false;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return false; },
    Space::Mapped(mut root) => {
      let mut r = NO_RESULT;
      if pt_has(root, 1) {
        r = pt_borrow(&mut root, 1, l3_shared, off);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return r < len(bm) && bm_cow(get(bm, r));
    },
  }
}

/// Is the page at user address va of process pid mapped writable?
fn user_page_writable(spaces: &mut Vec[Space], pid: u64, va: u64) -> bool
  requires spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces)
{
  if !user_range(va, 1) {
    return false;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return false; },
    Space::Mapped(mut root) => {
      let mut r = false;
      if pt_has(root, 1) {
        r = pt_borrow(&mut root, 1, l3_writable, off);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return r;
    },
  }
}

fn l3_writable(l3: &mut PageTable, off: u64) -> bool
  requires pt_level(l3) == 3 && off < USER_SIZE
{
  let t = off / L2_SIZE;
  if !pt_has(l3, t) {
    return false;
  }
  return pt_borrow(&mut l3, t, l2_writable, off % L2_SIZE);
}

fn l2_writable(l2: &mut PageTable, off: u64) -> bool
  requires pt_level(l2) == 2 && off < L2_SIZE
{
  let p = off / 4096;
  let t = p / 512;
  if !pt_has(l2, t) {
    return false;
  }
  return pt_borrow(&mut l2, t, l1_writable, p % 512);
}

fn l1_writable(l1: &mut PageTable, i: u64) -> bool
  requires pt_level(l1) == 1 && i < 512
{
  return pt_has(l1, i) && pt_writable(l1, i);
}

fn l3_shared(l3: &mut PageTable, off: u64) -> u64
  requires pt_level(l3) == 3 && off < USER_SIZE
  ensures result < NPAGES || result == NO_RESULT
{
  let t = off / L2_SIZE;
  if !pt_has(l3, t) {
    return NO_RESULT;
  }
  return pt_borrow(&mut l3, t, l2_shared, off % L2_SIZE);
}

fn l2_shared(l2: &mut PageTable, off: u64) -> u64
  requires pt_level(l2) == 2 && off < L2_SIZE
  ensures result < NPAGES || result == NO_RESULT
{
  let p = off / 4096;
  let t = p / 512;
  if !pt_has(l2, t) {
    return NO_RESULT;
  }
  return pt_borrow(&mut l2, t, l1_shared, p % 512);
}

fn l1_shared(l1: &mut PageTable, i: u64) -> u64
  requires pt_level(l1) == 1 && i < 512
  ensures result < NPAGES || result == NO_RESULT
{
  if !pt_has(l1, i) || !pt_shared(l1, i) {
    return NO_RESULT;
  }
  return pt_borrow_frame(&mut l1, i, frame_page);
}

fn frame_page(f: &mut Frame) -> u64
  ensures result < NPAGES
{
  return frame_id(f);
}

// ------------------------------------- anonymous memory not touched yet
//
// Private anonymous mmap memory gets its pages when first touched, not at
// mmap (src/lxanon.bastio keeps the records). The lookup and the mapping
// of one page are here, so the copies above can bring a page in when the
// kernel is the first to touch it.

/// Word f of record i of process p in k.anon.
fn an_at(p: u64, i: u64, f: u64) -> u64
  requires p < NPROC && i < AN_N && f < 2
  ensures result < ANON_LEN
{
  return (p * AN_N + i) * 2 + f;
}


/// Word i of an, or 0 past its end.
fn an_get(an: &Buf, i: u64) -> u64 {
  if i < len(an) {
    return get(an, i);
  }
  return 0;
}

/// Whether a record of process pid covers window page q: anonymous memory
/// that reads as zeros until touched.
fn anon_covers(an: &Buf, pid: u64, q: u64) -> bool
  requires pid < NPROC
{
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && pid < NPROC
  {
    let first1 = an_get(an, an_at(pid, i, 0));
    if first1 != 0 && first1 - 1 <= q && q - (first1 - 1) < an_get(an, an_at(pid, i, 1)) % AN_X {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Whether the record of process pid that covers window page q is of
/// memory the program may also run code from (mprotect or mmap with
/// PROT_WRITE and PROT_EXEC).
fn anon_exec(an: &Buf, pid: u64, q: u64) -> bool
  requires pid < NPROC
{
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && pid < NPROC
  {
    let first1 = an_get(an, an_at(pid, i, 0));
    let w = an_get(an, an_at(pid, i, 1));
    if first1 != 0 && first1 - 1 <= q && q - (first1 - 1) < w % AN_X {
      return w / AN_X == 1;
    }
    i = i + 1;
  }
  return false;
}

/// Where the record of process pid that covers window page q ends (the
/// first page after it); q if none does.
fn anon_end(an: &Buf, pid: u64, q: u64) -> u64
  requires pid < NPROC && q < WPAGES
  ensures q <= result && result <= WPAGES
{
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && pid < NPROC && q < WPAGES
  {
    let first1 = an_get(an, an_at(pid, i, 0));
    let pages = an_get(an, an_at(pid, i, 1)) % AN_X;
    if first1 != 0 && first1 - 1 <= q && q - (first1 - 1) < pages && pages <= WPAGES - (first1 - 1) {
      return first1 - 1 + pages;
    }
    i = i + 1;
  }
  return q;
}

/// The first window page above q where a record of process pid begins
/// (WPAGES if none).
fn anon_after(an: &Buf, pid: u64, q: u64) -> u64
  requires pid < NPROC
  ensures result <= WPAGES
{
  let mut best = WPAGES;
  let mut i = 0;
  while i < AN_N
    invariant i <= AN_N && pid < NPROC && best <= WPAGES
  {
    let first1 = an_get(an, an_at(pid, i, 0));
    let pages = an_get(an, an_at(pid, i, 1)) % AN_X;
    if first1 != 0 && first1 - 1 > q && first1 - 1 < best && pages != 0 {
      best = first1 - 1;
    }
    i = i + 1;
  }
  return best;
}

/// Window page q of process pid, if a record covers it: maps a fresh zero
/// page there unless one is there, one that may run code if the record says
/// so. True if q is mapped now.
fn anon_touch(m: &mut Mem, spaces: &mut Vec[Space], an: &Buf, pid: u64, q: u64) -> bool
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC
  ensures mem_ok(m) && spaces_ok(spaces)
{
  if q >= WPAGES || !anon_covers(an, pid, q) {
    return false;
  }
  match take_space(&mut spaces, pid) {
    Space::Empty => { return false; },
    Space::Mapped(mut root) => {
      let mut ok = false;
      if pt_has(root, 1) {
        ok = pt_borrow(&mut root, 1, touch_l3, &mut m, q, anon_exec(an, pid, q));
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return ok;
    },
  }
}

fn touch_l3(l3: &mut PageTable, m: &mut Mem, q: u64, x: bool) -> bool
  requires pt_level(l3) == 3 && mem_ok(m) && q < WPAGES
  ensures mem_ok(m)
{
  if !x {
    return w_map(&mut m, &mut l3, q, false);
  }
  if !w_tables(&mut m, &mut l3, q) || !pt_has(l3, q / L2_PAGES) {
    return false;
  }
  return pt_borrow(&mut l3, q / L2_PAGES, touch_l2_x, &mut m, q % L2_PAGES);
}

fn touch_l2_x(l2: &mut PageTable, m: &mut Mem, p: u64) -> bool
  requires pt_level(l2) == 2 && mem_ok(m) && p < L2_PAGES
  ensures mem_ok(m)
{
  if !pt_has(l2, p / 512) {
    return false;
  }
  return pt_borrow(&mut l2, p / 512, touch_l1_x, &mut m, p % 512);
}

/// A fresh zero page in slot i that the program may write and run code
/// from, as l2_protect (src/lxmem.bastio) leaves a page mprotect makes
/// readable, writable and executable: mapped read-only, which may run,
/// then given write access, which leaves that alone. The tree may be
/// leased: a new entry is one store, and it only allows more than none.
fn touch_l1_x(l1: &mut PageTable, m: &mut Mem, i: u64) -> bool
  requires pt_level(l1) == 1 && mem_ok(m) && i < 512
  ensures mem_ok(m)
{
  if pt_has(l1, i) {
    return true;
  }
  let b = find_free(&mut m);
  if b >= NPAGES {
    return false;
  }
  let f = take_page(&mut m, b);
  mark_x(&mut m, f, true);
  pt_put_frame(&mut l1, i, f, false);
  pt_set_access(&mut l1, i, 2);
  return true;
}

// ---------------------------------------------- copy-on-write pages
//
// The copy a write to a COW_PAGE needs (src/pages.bastio,
// src/lxcow.bastio), here so that copy_to_user can make it when the
// kernel is the one writing.

// What cow_l1 reports.
const COW_NONE: u64 = 0;               // not a copy-on-write page
const COW_DONE: u64 = 1;               // copied: the page is private and writable now
const COW_NOMEM: u64 = 2;              // no page for the copy: it stays shared

/// Window page q of process pid, if it maps a copy-on-write page: replaces
/// it with a private, writable copy. True if q is now writable that way.
/// Only with no processor running the space, so the page can come out of
/// its table; fork makes copy-on-write pages only in a process with one
/// thread, and a second thread copies them all first (cow_break_all), so a
/// space that has them is never running while its process is in the
/// kernel.
fn cow_touch(m: &mut Mem, spaces: &mut Vec[Space], pid: u64, q: u64) -> bool
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC
  ensures mem_ok(m) && spaces_ok(spaces)
{
  return own_touch(&mut m, &mut spaces, pid, q, false);
}

/// cow_touch, and if `text` also for a page of shared program text: the
/// process's own copy of it, still read-only (ptrace writes a breakpoint
/// into code, which a program itself or the kernel for it may not).
fn own_touch(m: &mut Mem, spaces: &mut Vec[Space], pid: u64, q: u64, text: bool) -> bool
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC
  ensures mem_ok(m) && spaces_ok(spaces)
{
  if q >= WPAGES {
    return false;
  }
  match take_space(&mut spaces, pid) {
    Space::Empty => { return false; },
    Space::Mapped(mut root) => {
      let mut r = COW_NONE;
      if pt_lease_count(&mut root) == 0 && pt_has(root, 1) {
        r = pt_borrow(&mut root, 1, cow_l3, &mut m, q, text);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return r == COW_DONE;
    },
  }
}

fn cow_l3(l3: &mut PageTable, m: &mut Mem, q: u64, text: bool) -> u64
  requires pt_level(l3) == 3 && pt_leases(l3) == 0 && mem_ok(m) && q < WPAGES
  ensures mem_ok(m) && result <= COW_NOMEM
{
  let t = q / L2_PAGES;
  if !pt_has(l3, t) {
    return COW_NONE;
  }
  return pt_borrow(&mut l3, t, cow_l2, &mut m, q % L2_PAGES, text);
}

fn cow_l2(l2: &mut PageTable, m: &mut Mem, q: u64, text: bool) -> u64
  requires pt_level(l2) == 2 && pt_leases(l2) == 0 && mem_ok(m) && q < L2_PAGES
  ensures mem_ok(m) && result <= COW_NOMEM
{
  let t = q / 512;
  if !pt_has(l2, t) {
    return COW_NONE;
  }
  return pt_borrow(&mut l2, t, cow_l1, &mut m, q % 512, text);
}

/// Slot i of level-1 table l1, if it maps a copy-on-write page: its own
/// writable copy instead.
fn cow_l1(l1: &mut PageTable, m: &mut Mem, i: u64, text: bool) -> u64
  requires pt_level(l1) == 1 && pt_leases(l1) == 0 && mem_ok(m) && i < 512
  ensures pt_level(l1) == 1 && pt_leases(l1) == 0 && mem_ok(m) && result <= COW_NOMEM
{
  if !pt_has(l1, i) || !pt_shared(l1, i) || pt_writable(l1, i) {
    return COW_NONE;
  }
  let s = pt_take_shared(&mut l1, i);
  let cow = is_cow_page(m, s);
  if !cow && !(text && is_text_page(m, s)) {
    pt_put_shared(&mut l1, i, s, false);
    return COW_NONE;
  }
  let b = find_free(&mut m);
  if b >= NPAGES {
    pt_put_shared(&mut l1, i, s, false);
    return COW_NOMEM;
  }
  let x = is_cow_x(m, s);
  let f = shared_copy(take_dirty(&mut m, b), s);
  drop_shared(&mut m, s);
  if x {
    mark_x(&mut m, f, true);
    pt_put_frame(&mut l1, i, f, false);
    pt_set_access(&mut l1, i, 2);           // read, write and run, as before fork
  } else {
    pt_put_frame(&mut l1, i, f, cow);
  }
  return COW_DONE;
}

/// Whether the page of va is mapped in pid's window, even PROT_NONE
/// (which copy_from_user cannot read).
fn user_present(spaces: &mut Vec[Space], pid: u64, va: u64) -> bool
  requires spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces)
{
  if !user_range(va, 1) {
    return false;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return false; },
    Space::Mapped(mut root) => {
      let mut r = false;
      if pt_has(root, 1) {
        r = pt_borrow(&mut root, 1, l3_present, off);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return r;
    },
  }
}

fn l3_present(l3: &mut PageTable, off: u64) -> bool
  requires pt_level(l3) == 3 && off < USER_SIZE
{
  let t = off / L2_SIZE;
  if !pt_has(l3, t) {
    return false;
  }
  return pt_borrow(&mut l3, t, l2_present, off % L2_SIZE);
}

fn l2_present(l2: &mut PageTable, a: u64) -> bool
  requires pt_level(l2) == 2 && a < L2_SIZE
{
  let p = a / 4096;
  if !pt_has(l2, p / 512) {
    return false;
  }
  return pt_borrow(&mut l2, p / 512, l1_present, p % 512);
}

fn l1_present(l1: &mut PageTable, i: u64) -> bool
  requires pt_level(l1) == 1 && i < 512
{
  return pt_has(l1, i);
}

/// What process pid's page tables say of window page q: 0 if unmapped, else
/// 1 plus 2 if readable (not PROT_NONE), 4 if writable, 8 if its frame is
/// shared (MAP_SHARED, or copy-on-write after fork).
fn user_page_bits(spaces: &mut Vec[Space], pid: u64, q: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces) && result < 16
{
  if q >= WPAGES {
    return 0;
  }
  match take_space(&mut spaces, pid) {
    Space::Empty => { return 0; },
    Space::Mapped(mut root) => {
      let mut r = 0;
      if pt_has(root, 1) {
        r = pt_borrow(&mut root, 1, l3_bits, q * 4096);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return r;
    },
  }
}

fn l3_bits(l3: &mut PageTable, off: u64) -> u64
  requires pt_level(l3) == 3 && off < USER_SIZE
  ensures result < 16
{
  let t = off / L2_SIZE;
  if !pt_has(l3, t) {
    return 0;
  }
  return pt_borrow(&mut l3, t, l2_bits, off % L2_SIZE);
}

fn l2_bits(l2: &mut PageTable, off: u64) -> u64
  requires pt_level(l2) == 2 && off < L2_SIZE
  ensures result < 16
{
  let p = off / 4096;
  if !pt_has(l2, p / 512) {
    return 0;
  }
  return pt_borrow(&mut l2, p / 512, l1_bits, p % 512);
}

fn l1_bits(l1: &mut PageTable, i: u64) -> u64
  requires pt_level(l1) == 1 && i < 512
  ensures result < 16
{
  if !pt_has(l1, i) {
    return 0;
  }
  let mut r = 1;
  if pt_accessible(l1, i) {
    r = r + 2;
  }
  if pt_writable(l1, i) {
    r = r + 4;
  }
  if pt_shared(l1, i) {
    r = r + 8;
  }
  return r;
}

/// The first window page from q on that may be mapped in process pid's
/// window (WPAGES if none): a lower bound that skips the empty tables.
fn user_next_mapped(spaces: &mut Vec[Space], pid: u64, q: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC && q <= WPAGES
  ensures spaces_ok(spaces) && q <= result && result <= WPAGES
{
  if q >= WPAGES {
    return WPAGES;
  }
  match take_space(&mut spaces, pid) {
    Space::Empty => { return WPAGES; },
    Space::Mapped(mut root) => {
      let mut r = WPAGES;
      if pt_has(root, 1) {
        r = pt_borrow(&mut root, 1, l3_next, q);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return r;
    },
  }
}

fn l3_next(l3: &mut PageTable, q: u64) -> u64
  requires pt_level(l3) == 3 && q < WPAGES
  ensures q <= result && result <= WPAGES
{
  return w_next(&mut l3, q);
}
