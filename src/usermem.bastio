// Copying between user memory and kernel byte buffers. The kernel never
// reads or writes memory through an address: it takes the tables of the
// process's user window out of their parents, takes each page out of the
// last table, copies the bytes it wants on that page, and puts everything
// back. The proof shows that only bytes inside [va, va + n) of the window
// are touched, and only bytes inside the kernel buffer's length.

import "pages.bastio";
import "space.bastio";
import "proc.bastio";

/// Is [va, va + n) inside the user window?
fn user_range(va: u64, n: u64) -> bool
  ensures result ==> va >= USER_BASE && va - USER_BASE + n <= USER_SIZE
{
  if va < USER_BASE || va - USER_BASE > USER_SIZE {
    return false;
  }
  return n <= USER_SIZE - (va - USER_BASE);
}

/// How many of the `left` bytes wanted from window offset `a` lie on a's
/// page.
fn chunk(a: u64, left: u64) -> u64
  ensures result <= left && a % 4096 + result <= 4096
  ensures left > 0 ==> result > 0
{
  let room = 4096 - a % 4096;
  if room < left {
    return room;
  }
  return left;
}

/// Copies n bytes from user address va of process pid into the start of
/// buf. Returns the count, short at an unmapped page, or NO_RESULT if the
/// range is not inside the user window.
fn copy_from_user(spaces: &mut Vec[Space], pid: u64, va: u64, buf: &mut Bytes, n: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC && n <= blen(buf)
  ensures spaces_ok(spaces) && blen(buf) == old(blen(buf))
  ensures result <= n || result == NO_RESULT
{
  if !user_range(va, n) {
    return NO_RESULT;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NO_RESULT; },
    Space::Mapped(mut root) => {
      let mut k = 0;
      if pt_has(root, 1) {
        k = pt_borrow(&mut root, 1, l3_to_bytes, off, &mut buf, n);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return k;
    },
  }
}

/// copy_from_user below the top-level table (in place, as other threads
/// may be running on the space).
fn l3_to_bytes(l3: &mut PageTable, off: u64, buf: &mut Bytes, n: u64) -> u64
  requires pt_level(l3) == 3 && off + n <= USER_SIZE && n <= blen(buf)
  ensures blen(buf) == old(blen(buf))
  ensures result <= n
{
  if !pt_has(l3, 0) {
    return 0;
  }
  return pt_borrow(&mut l3, 0, l2_to_bytes, off, &mut buf, n);
}

/// copy_from_user below the window table, a page at a time.
fn l2_to_bytes(l2: &mut PageTable, off: u64, buf: &mut Bytes, n: u64) -> u64
  requires pt_level(l2) == 2 && off + n <= USER_SIZE && n <= blen(buf)
  ensures pt_level(l2) == 2 && blen(buf) == old(blen(buf))
  ensures result <= n
{
  let l = blen(buf);
  let mut k = 0;
  let mut ok = true;
  while ok && k < n
    invariant k <= n && n <= blen(buf) && blen(buf) == l && pt_level(l2) == 2
  {
    let a = off + k;
    let m = chunk(a, n - k);
    if w_read(&mut l2, a, &mut buf, k, m) {
      k = k + m;
    } else {
      ok = false;
    }
  }
  return k;
}

/// Copies the first n bytes of buf to user address va of process pid.
/// Returns the count, short at an unmapped page, or NO_RESULT if the range
/// is not inside the user window.
fn copy_to_user(spaces: &mut Vec[Space], pid: u64, va: u64, buf: &Bytes, n: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC && n <= blen(buf)
  ensures spaces_ok(spaces)
  ensures result <= n || result == NO_RESULT
{
  if !user_range(va, n) {
    return NO_RESULT;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NO_RESULT; },
    Space::Mapped(mut root) => {
      let mut k = 0;
      if pt_has(root, 1) {
        k = pt_borrow(&mut root, 1, bytes_to_l3, off, buf, n);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return k;
    },
  }
}

/// copy_to_user below the top-level table, in place.
fn bytes_to_l3(l3: &mut PageTable, off: u64, buf: &Bytes, n: u64) -> u64
  requires pt_level(l3) == 3 && off + n <= USER_SIZE && n <= blen(buf)
  ensures result <= n
{
  if !pt_has(l3, 0) {
    return 0;
  }
  return pt_borrow(&mut l3, 0, bytes_to_l2, off, buf, n);
}

/// copy_to_user below the window table, a page at a time.
fn bytes_to_l2(l2: &mut PageTable, off: u64, buf: &Bytes, n: u64) -> u64
  requires pt_level(l2) == 2 && off + n <= USER_SIZE && n <= blen(buf)
  ensures pt_level(l2) == 2
  ensures result <= n
{
  let mut k = 0;
  let mut ok = true;
  while ok && k < n
    invariant k <= n && pt_level(l2) == 2
  {
    let a = off + k;
    let m = chunk(a, n - k);
    if w_write(&mut l2, a, buf, k, m) {
      k = k + m;
    } else {
      ok = false;
    }
  }
  return k;
}
