// The editing keys as a terminal sends them: ESC [ A for Up and so on. A
// key gives ESC at once and the rest of its bytes packed into one number
// (first byte lowest, none zero), so a keyboard driver that hands over one
// byte at a time can feed them out afterwards.

const NAV_UP: u64 = 0;
const NAV_DOWN: u64 = 1;
const NAV_RIGHT: u64 = 2;
const NAV_LEFT: u64 = 3;
const NAV_HOME: u64 = 4;
const NAV_END: u64 = 5;
const NAV_DELETE: u64 = 6;
const NAV_PGUP: u64 = 7;
const NAV_PGDN: u64 = 8;
const NAV_INSERT: u64 = 9;
const NAV_F1: u64 = 10;              // F1 to F12 are NAV_F1 .. NAV_F1 + 11
const NAV_NONE: u64 = 30;            // no such key

/// The bytes after ESC for navigation key n (NAV_*): `[` and a letter,
/// `[`, a digit and `~`, `O` and a letter (F1 to F4), or `[`, two digits
/// and `~` (F5 to F12). At most four bytes.
fn nav_rest(n: u64) -> u64
  ensures result < 4294967296
{
  if n >= NAV_F1 && n < NAV_F1 + 4 {
    return 79 + (80 + n - NAV_F1) * 256;
  } else if n >= NAV_F1 + 4 && n < NAV_F1 + 12 {
    let v = nav_fcode(n - NAV_F1);         // 15 17 18 19 20 21 23 24
    return 91 + (48 + v / 10) * 256 + (48 + v % 10) * 65536 + 126 * 16777216;
  } else if n == NAV_INSERT {
    return 91 + 50 * 256 + 126 * 65536;
  }
  if n == NAV_UP {
    return 91 + 65 * 256;
  } else if n == NAV_DOWN {
    return 91 + 66 * 256;
  } else if n == NAV_RIGHT {
    return 91 + 67 * 256;
  } else if n == NAV_LEFT {
    return 91 + 68 * 256;
  } else if n == NAV_HOME {
    return 91 + 72 * 256;
  } else if n == NAV_END {
    return 91 + 70 * 256;
  } else if n == NAV_DELETE {
    return 91 + 51 * 256 + 126 * 65536;
  } else if n == NAV_PGUP {
    return 91 + 53 * 256 + 126 * 65536;
  } else if n == NAV_PGDN {
    return 91 + 54 * 256 + 126 * 65536;
  }
  return 0;
}

/// The key for PS/2 extended scan code c (after 0xE0), or NAV_NONE.
fn nav_ps2(c: u64) -> u64
  ensures result <= NAV_NONE
{
  if c == 0x48 {
    return NAV_UP;
  } else if c == 0x50 {
    return NAV_DOWN;
  } else if c == 0x4D {
    return NAV_RIGHT;
  } else if c == 0x4B {
    return NAV_LEFT;
  } else if c == 0x47 {
    return NAV_HOME;
  } else if c == 0x4F {
    return NAV_END;
  } else if c == 0x53 {
    return NAV_DELETE;
  } else if c == 0x49 {
    return NAV_PGUP;
  } else if c == 0x51 {
    return NAV_PGDN;
  } else if c == 0x52 {
    return NAV_INSERT;
  }
  return NAV_NONE;
}

/// The key for HID usage u, or NAV_NONE.
fn nav_usb(u: u64) -> u64
  ensures result <= NAV_NONE
{
  if u == 0x52 {
    return NAV_UP;
  } else if u == 0x51 {
    return NAV_DOWN;
  } else if u == 0x4F {
    return NAV_RIGHT;
  } else if u == 0x50 {
    return NAV_LEFT;
  } else if u == 0x4A {
    return NAV_HOME;
  } else if u == 0x4D {
    return NAV_END;
  } else if u == 0x4C {
    return NAV_DELETE;
  } else if u == 0x4B {
    return NAV_PGUP;
  } else if u == 0x4E {
    return NAV_PGDN;
  } else if u == 0x49 {
    return NAV_INSERT;
  } else if u >= 0x3A && u <= 0x45 {
    return NAV_F1 + u - 0x3A;
  }
  return NAV_NONE;
}

/// The key for the PS/2 scan code c (not extended) of a function key, or
/// NAV_NONE: F1 to F10 are 0x3B to 0x44, F11 0x57 and F12 0x58.
fn nav_ps2_fn(c: u64) -> u64
  ensures result <= NAV_NONE
{
  if c >= 0x3B && c <= 0x44 {
    return NAV_F1 + c - 0x3B;
  } else if c == 0x57 {
    return NAV_F1 + 10;
  } else if c == 0x58 {
    return NAV_F1 + 11;
  }
  return NAV_NONE;
}

/// The number in ESC [ number ~ for F5 (n = 4) to F12 (n = 11).
fn nav_fcode(n: u64) -> u64
  ensures result < 100
{
  if n == 4 {
    return 15;
  } else if n == 5 {
    return 17;
  } else if n == 6 {
    return 18;
  } else if n == 7 {
    return 19;
  } else if n == 8 {
    return 20;
  } else if n == 9 {
    return 21;
  } else if n == 10 {
    return 23;
  }
  return 24;
}

/// The Linux key code (input-event-codes.h) of the key that the PS/2 set-1
/// code c names after an 0xE0 prefix, or 0 for a key without one here.
/// Without the prefix, set-1 codes 1 to 88 are the Linux key codes.
fn evkey_ext(c: u64) -> u64
  ensures result < 256
{
  if c == 0x48 {
    return 103;                             // KEY_UP
  } else if c == 0x50 {
    return 108;                             // KEY_DOWN
  } else if c == 0x4B {
    return 105;                             // KEY_LEFT
  } else if c == 0x4D {
    return 106;                             // KEY_RIGHT
  } else if c == 0x47 {
    return 102;                             // KEY_HOME
  } else if c == 0x4F {
    return 107;                             // KEY_END
  } else if c == 0x49 {
    return 104;                             // KEY_PAGEUP
  } else if c == 0x51 {
    return 109;                             // KEY_PAGEDOWN
  } else if c == 0x52 {
    return 110;                             // KEY_INSERT
  } else if c == 0x53 {
    return 111;                             // KEY_DELETE
  } else if c == 0x1C {
    return 96;                              // KEY_KPENTER
  } else if c == 0x1D {
    return 97;                              // KEY_RIGHTCTRL
  } else if c == 0x38 {
    return 100;                             // KEY_RIGHTALT
  } else if c == 0x35 {
    return 98;                              // KEY_KPSLASH
  } else if c == 0x5B {
    return 125;                             // KEY_LEFTMETA
  } else if c == 0x5C {
    return 126;                             // KEY_RIGHTMETA
  } else if c == 0x5D {
    return 127;                             // KEY_COMPOSE
  }
  return 0;
}

/// The Linux key code of the modifier in bit b (0 to 7) of a HID boot
/// report's first byte: Ctrl, Shift, Alt and the Meta key, left then right.
fn evkey_mod(b: u64) -> u64
  ensures result < 128
{
  if b == 0 {
    return 29;                              // KEY_LEFTCTRL
  } else if b == 1 {
    return 42;                              // KEY_LEFTSHIFT
  } else if b == 2 {
    return 56;                              // KEY_LEFTALT
  } else if b == 3 {
    return 125;                             // KEY_LEFTMETA
  } else if b == 4 {
    return 97;                              // KEY_RIGHTCTRL
  } else if b == 5 {
    return 54;                              // KEY_RIGHTSHIFT
  } else if b == 6 {
    return 100;                             // KEY_RIGHTALT
  }
  return 126;                               // KEY_RIGHTMETA
}

/// The Linux key codes of HID usages 0x04 to 0x1D (a to z), each plus 32.
fn evkey_letters() -> Str {
  return ">PN@2ABC7DEFRQ8903?46O1M5L";
}

/// The Linux key code (input-event-codes.h) of HID usage u, or 0 for a key
/// without one here.
fn evkey_usb(u: u64) -> u64
  ensures result < 128
{
  if u >= 0x04 && u <= 0x1D {
    let m = evkey_letters();
    if u - 4 < slen(m) {
      let c = cast[u64](sget(m, u - 4));
      if c >= 32 && c < 128 {
        return c - 32;
      }
    }
    return 0;
  } else if u >= 0x1E && u <= 0x26 {
    return u - 0x1E + 2;                    // KEY_1 to KEY_9
  } else if u == 0x27 {
    return 11;                              // KEY_0
  } else if u == 0x28 {
    return 28;                              // KEY_ENTER
  } else if u == 0x29 {
    return 1;                               // KEY_ESC
  } else if u == 0x2A {
    return 14;                              // KEY_BACKSPACE
  } else if u == 0x2B {
    return 15;                              // KEY_TAB
  } else if u == 0x2C {
    return 57;                              // KEY_SPACE
  } else if u == 0x2D {
    return 12;                              // KEY_MINUS
  } else if u == 0x2E {
    return 13;                              // KEY_EQUAL
  } else if u == 0x2F {
    return 26;                              // KEY_LEFTBRACE
  } else if u == 0x30 {
    return 27;                              // KEY_RIGHTBRACE
  } else if u == 0x31 || u == 0x32 {
    return 43;                              // KEY_BACKSLASH
  } else if u == 0x33 {
    return 39;                              // KEY_SEMICOLON
  } else if u == 0x34 {
    return 40;                              // KEY_APOSTROPHE
  } else if u == 0x35 {
    return 41;                              // KEY_GRAVE
  } else if u == 0x36 {
    return 51;                              // KEY_COMMA
  } else if u == 0x37 {
    return 52;                              // KEY_DOT
  } else if u == 0x38 {
    return 53;                              // KEY_SLASH
  } else if u == 0x39 {
    return 58;                              // KEY_CAPSLOCK
  } else if u >= 0x3A && u <= 0x43 {
    return u - 0x3A + 59;                   // KEY_F1 to KEY_F10
  } else if u == 0x44 {
    return 87;                              // KEY_F11
  } else if u == 0x45 {
    return 88;                              // KEY_F12
  } else if u == 0x49 {
    return 110;                             // KEY_INSERT
  } else if u == 0x4A {
    return 102;                             // KEY_HOME
  } else if u == 0x4B {
    return 104;                             // KEY_PAGEUP
  } else if u == 0x4C {
    return 111;                             // KEY_DELETE
  } else if u == 0x4D {
    return 107;                             // KEY_END
  } else if u == 0x4E {
    return 109;                             // KEY_PAGEDOWN
  } else if u == 0x4F {
    return 106;                             // KEY_RIGHT
  } else if u == 0x50 {
    return 105;                             // KEY_LEFT
  } else if u == 0x51 {
    return 108;                             // KEY_DOWN
  } else if u == 0x52 {
    return 103;                             // KEY_UP
  } else if u == 0x58 {
    return 96;                              // KEY_KPENTER
  }
  return 0;
}
