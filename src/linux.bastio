// Linux system calls: what a program gets when it runs the `syscall`
// instruction (vector 0x81 from the trap entry). The number is in rax and
// the arguments in rdi, rsi, rdx, r10, r8, r9; the result goes back in rax,
// a negative errno as two's complement. `int 0x80` keeps the BastiOS ABI.
//
// Only a few calls exist so far; every other number returns -ENOSYS, which
// a Linux program can handle, rather than killing it.

import "pages.bastio";
import "proc.bastio";
import "console.bastio";
import "space.bastio";
import "syscall.bastio";

const V_LINUX: u64 = 0x81;

const LX_READ: u64 = 0;
const LX_WRITE: u64 = 1;
const LX_OPEN: u64 = 2;
const LX_CLOSE: u64 = 3;
const LX_LSEEK: u64 = 8;
const LX_MMAP: u64 = 9;
const LX_MPROTECT: u64 = 10;
const LX_MUNMAP: u64 = 11;
const LX_BRK: u64 = 12;
const LX_IOCTL: u64 = 16;
const LX_WRITEV: u64 = 20;
const LX_READV: u64 = 19;
const LX_GETPID: u64 = 39;
const LX_EXIT: u64 = 60;
const LX_GETPPID: u64 = 110;
const LX_ARCH_PRCTL: u64 = 158;
const LX_SET_TID_ADDRESS: u64 = 218;
const LX_SET_ROBUST_LIST: u64 = 273;
const LX_GET_ROBUST_LIST: u64 = 274;
const LX_RSEQ: u64 = 334;
const LX_CLONE3: u64 = 435;
const LX_UNSHARE: u64 = 272;
const LX_IO_SETUP: u64 = 206;          // Linux AIO: nginx tries it and does without
const LX_OPENAT: u64 = 257;
const LX_STAT: u64 = 4;
const LX_LSTAT: u64 = 6;
const LX_ACCESS: u64 = 21;
const LX_FACCESSAT: u64 = 269;
const LX_FACCESSAT2: u64 = 439;
const LX_NEWFSTATAT: u64 = 262;
const LX_RT_SIGACTION: u64 = 13;
const LX_RT_SIGPROCMASK: u64 = 14;
const LX_GETCWD: u64 = 79;
const LX_GETUID: u64 = 102;
const LX_GETGID: u64 = 104;
const LX_GETEUID: u64 = 107;
const LX_GETEGID: u64 = 108;
const ERANGE: u64 = 18446744073709551582;   // 2^64 - 34
const LX_UNLINK: u64 = 87;
const LX_UNLINKAT: u64 = 263;


// open flags
const LO_ACCMODE: u64 = 3;
const LO_WRONLY: u64 = 1;
const LO_RDWR: u64 = 2;
const LO_CREAT: u64 = 0x40;
const LO_TRUNC: u64 = 0x200;
const LO_APPEND: u64 = 0x400;
const LO_NONBLOCK: u64 = 0x800;
const LO_ASYNC: u64 = 0x2000;

const READ_MAX: u64 = 262144;          // the most one read of a file returns
const MAP_SHARED: u64 = 1;
const MAP_FIXED: u64 = 0x10;
const MAP_ANONYMOUS: u64 = 0x20;
const MAP_PRIVATE: u64 = 2;
const MAP_SHARED_VALIDATE: u64 = 3;
const MAP_32BIT: u64 = 0x40;
const MAP_FIXED_NOREPLACE: u64 = 0x100000;
// The flags MAP_SHARED_VALIDATE accepts (Linux's LEGACY_MAP_MASK): the
// type, FIXED, ANONYMOUS, 32BIT, GROWSDOWN, DENYWRITE, EXECUTABLE, LOCKED,
// NORESERVE, POPULATE, NONBLOCK, STACK, HUGETLB, the huge page sizes and
// UNINITIALIZED; and FIXED_NOREPLACE.
const MAP_LEGACY_MASK: u64 = 0xFC17F973;
const PATH_MAX_LX: u64 = 4096;          // the longest path read from user memory (Linux's PATH_MAX)
const PATH_FIRST: u64 = 256;            // read first; most paths end within it
const PATH_OUT: u64 = 512;              // room for a name being built

const ARCH_SET_FS: u64 = 0x1002;
const ARCH_GET_FS: u64 = 0x1003;
const ARCH_GET_CPUID: u64 = 0x1011;
const ARCH_SET_CPUID: u64 = 0x1012;
const IOV_MAX: u64 = 1024;
const EISDIR: u64 = 18446744073709551595;     // 2^64 - 21
const ESRCH: u64 = 18446744073709551613;      // 2^64 - 3
const ENXIO: u64 = 18446744073709551610;      // 2^64 - 6
const TOTAL_MAX: u64 = 0x100000000000;      // more than writev can move in the window
const LX_EXIT_GROUP: u64 = 231;

// -errno as u64.
const ENOSYS: u64 = 18446744073709551578;   // 2^64 - 38
const EFAULT: u64 = 18446744073709551602;   // 2^64 - 14
const EBADF: u64 = 18446744073709551607;    // 2^64 - 9
const EINVAL: u64 = 18446744073709551594;   // 2^64 - 22
const ENOTTY: u64 = 18446744073709551591;   // 2^64 - 25
const ENOENT: u64 = 18446744073709551614;   // 2^64 - 2
const ENOMEM: u64 = 18446744073709551604;   // 2^64 - 12

// Process calls and file metadata (src/lxproc.bastio).
const LX_CLONE: u64 = 56;
const CLONE_VM: u64 = 0x100;
const CLONE_VFORK: u64 = 0x4000;
const CLONE_THREAD: u64 = 0x10000;
const LX_FORK: u64 = 57;
const LX_VFORK: u64 = 58;
const LX_EXECVE: u64 = 59;
const LX_GETDENTS: u64 = 78;
const LX_EXECVEAT: u64 = 322;
const LX_WAIT4: u64 = 61;
const LX_GETTID: u64 = 186;
const LX_FUTEX: u64 = 202;
const LX_REBOOT: u64 = 169;

// What thread_exec says.
const EXEC_GO: u64 = 0;              // no other thread is left: go on
const EXEC_NO: u64 = 1;              // pid is a thread but not the leader
const EXEC_WAIT: u64 = 2;            // others are still on processors

const SIGCHLD: u64 = 17;
const SIGPIPE: u64 = 13;
const WNOHANG: u64 = 1;

const E2BIG: u64 = 18446744073709551609;    // 2^64 - 7
const ENOEXEC: u64 = 18446744073709551608;  // 2^64 - 8
const ECHILD: u64 = 18446744073709551606;   // 2^64 - 10
const EAGAIN: u64 = 18446744073709551605;   // 2^64 - 11

const STAT_SIZE: u64 = 144;                 // struct stat on x86-64
const S_IFDIR: u64 = 0x41ED;                // a directory, rwxr-xr-x
const S_IFREG_X: u64 = 0x81ED;              // a regular file, rwxr-xr-x
const S_IFREG: u64 = 0x81A4;                // a regular file, rw-r--r--
const S_IFMT_DIR: u64 = 0x4000;             // the type bits of a directory
const S_IFMT_REG: u64 = 0x8000;             // and of a regular file
// Inode numbers: directories 1 + their DIR_* number (at most 1 + DIR_VFS +
// VDIR_LO), then the built-in programs, then files (past both), then
// /proc (INO_PROC, 8192 up).
const INO_PROGS: u64 = 2304;                // the built-in programs: this + the program
const INO_FILES: u64 = 2560;                // files: this + the handle (below INO_PROC)

// ---------------------------------------------------------------- user memory

/// A word read from user memory, if it was there.
struct Word { ok: bool, v: u64 }

/// The little-endian u64 at user address va of process pid.
fn user_u64(spaces: &mut Vec[Space], pid: u64, va: u64) -> Word
  requires spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces)
{
  if !user_range(va, 8) {
    return Word { ok: false, v: 0 };
  }
  match take_space(&mut spaces, pid) {
    Space::Empty => { return Word { ok: false, v: 0 }; },
    Space::Mapped(mut root) => {
      let w = read_root(&mut root, va - USER_BASE);
      put_space(&mut spaces, pid, Space::Mapped(root));
      return w;
    },
  }
}

/// user_u64 below the top-level table: window offset off.
fn read_root(root: &mut PageTable, off: u64) -> Word
  requires pt_level(root) == 4 && off + 8 <= USER_SIZE
  ensures pt_level(root) == 4
{
  if !pt_has(root, 1) {
    return Word { ok: false, v: 0 };
  }
  return pt_borrow(&mut root, 1, read_l3, off);
}

/// read_root below the top-level table, in place.
fn read_l3(l3: &mut PageTable, off: u64) -> Word
  requires pt_level(l3) == 3 && off + 8 <= USER_SIZE
{
  if !pt_has(l3, 0) {
    return Word { ok: false, v: 0 };
  }
  return pt_borrow(&mut l3, 0, read_l2, off);
}

/// The 8 bytes at window offset off, most significant first.
fn read_l2(l2: &mut PageTable, off: u64) -> Word
  requires pt_level(l2) == 2 && off + 8 <= USER_SIZE
  ensures pt_level(l2) == 2
{
  let mut v = 0;
  let mut i = 8;
  while i > 0
    invariant i <= 8 && pt_level(l2) == 2
    invariant (i == 8 ==> v == 0) && (i == 7 ==> v < 0x100) && (i == 6 ==> v < 0x10000)
    invariant (i == 5 ==> v < 0x1000000) && (i == 4 ==> v < 0x100000000)
    invariant (i == 3 ==> v < 0x10000000000) && (i == 2 ==> v < 0x1000000000000)
    invariant (i == 1 ==> v < 0x100000000000000)
  {
    i = i - 1;
    let ch = w_byte(&mut l2, off + i);
    if ch == 256 {
      return Word { ok: false, v: 0 };
    }
    v = v * 256 + ch;
  }
  return Word { ok: true, v: v };
}

/// Handles the Linux system call process `pid` just made.
fn linux_syscall(con: &mut Con, k: &mut Kernel, mmu: &Mmu, pid: u64) -> u64
  requires con_ok(con) && kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k) && con_ok(con)
{
  let n = lx_alias(k, pid, pget(k.procs, pid, F_REGS + R_RAX));   // src/lxextra.bastio
  let sp = pget(k.procs, pid, F_REGS + R_RSP);
  if sp >= USER_BASE + 128 {
    stack_reach(&mut k.mem, &mut k.spaces, pid, sp - 128);   // the red zone too
  }
  let was = pget(k.procs, pid, F_RESTART);  // a timed wait keeps its deadline here
  pset(&mut k.procs, pid, F_RESTART, 0);
  let a = pget(k.procs, pid, F_REGS + R_RDI);
  let b = pget(k.procs, pid, F_REGS + R_RSI);
  let c = pget(k.procs, pid, F_REGS + R_RDX);
  if opath_denied(k, pid, n) {
    ret(&mut k.procs, pid, EBADF);          // an O_PATH handle (src/lxextra.bastio)
    return KEEP;
  }
  if n == LX_EXIT && thread_only(k.procs, pid) {
    lx_thread_exit(&mut k, mmu, pid);
    return SWITCH;
  }
  if n == LX_EXIT || n == LX_EXIT_GROUP {
    // The process ends, with all its threads (src/lxthread.bastio). Linux
    // keeps the low 8 bits of the status.
    terminate(&mut k, mmu, pid, a % 256);
    return SWITCH;
  }
  if n == LX_FUTEX {
    return lx_futex(&mut k, pid, was, a, b, c);
  }
  if n == LX_REBOOT {
    // reboot(2), for root alone holding CAP_SYS_BOOT (cap_has implies
    // root; Linux checks it first too), after its two magic numbers:
    // RESTART restarts the machine, POWER_OFF and HALT power it off.
    // CAD_ON and CAD_OFF (what Ctrl-Alt-Del does) succeed doing nothing:
    // the console never reboots on it.
    if !cap_has(k, pid, CAP_SYS_BOOT) {
      ret(&mut k.procs, pid, EPERM);
      return KEEP;
    }
    if a != 0xFEE1DEAD || (b != 672274793 && b != 85072278 && b != 369367448 && b != 537993216) {
      ret(&mut k.procs, pid, EINVAL);
      return KEEP;
    }
    ret(&mut k.procs, pid, 0);
    let cmd = c % 0x100000000;                // an int: HALT, POWER_OFF and CAD_ON are negative
    if cmd == 0x01234567 {
      return REBOOT;
    }
    if cmd == 0x4321FEDC || cmd == 0xCDEF0123 {
      return POWEROFF;
    }
    if cmd == 0x89ABCDEF || cmd == 0 {
      return KEEP;                          // LINUX_REBOOT_CMD_CAD_ON, CAD_OFF
    }
    ret(&mut k.procs, pid, EINVAL);
    return KEEP;
  }
  if n == LX_READ || n == LX_READV {
    let early = rw_early(&mut k, pid, n, a, b, c);
    if early != NO_RESULT {
      ret(&mut k.procs, pid, early);
      return KEEP;
    }
    let rv = fd_look(k, pid, a);
    if n == LX_READV && rv.kind == K_FILE {
      let got = file_readv(&mut k, pid, rv.x, b, c);
      if got == DISK_RETRY {
        return disk_retry(&mut k, pid, n);   // nothing read yet: wait for the disk
      }
      ret(&mut k.procs, pid, got);
      return KEEP;
    }
    // readv on anything but a file reads into the first buffer that has
    // room: a short read, as Linux allows (a later buffer could wait).
    let mut va = b;
    let mut cnt = c;
    if n == LX_READV {
      let v = first_iov(&mut k, pid, b, c);
      if v.err != 0 {
        ret(&mut k.procs, pid, v.err);
        return KEEP;
      }
      va = v.base;
      cnt = v.len;
    }
    let d = fd_look(k, pid, a);
    if d.kind == K_CONSOLE {
      return console_read(&mut k, pid, va, cnt, was);
    }
    let mut r = EBADF;
    if d.kind == K_FILE {
      r = lx_file_read(&mut k, pid, d.x, va, cnt);
    } else if d.kind == K_PIPE_R {
      r = pipe_read(&mut k, pid, d.x, va, cnt);
    } else if d.kind == K_EVENT || d.kind == K_TIMER {
      r = ev_read(&mut k, pid, d.kind, d.x, va, cnt);
    } else if d.kind == K_SIGFD {
      r = sfd_read(&mut k, pid, d.x, va, cnt);
    } else if d.kind == K_INOTIFY && d.x < INO_N {
      r = ino_read(&mut k, pid, d.x, va, cnt);   // src/lxinotify.bastio
    } else if d.kind == K_DEV && d.x >= PROC_DEV {
      r = proc_read(&mut k, pid, a, d.x, va, cnt);
    } else if d.kind == K_DEV && is_loop(d.x) {
      r = loop_io(&mut con, &mut k, pid, a, d.x, false, va, cnt);
    } else if d.kind == K_DEV && is_pty_dev(d.x) {
      r = pty_read(&mut k, pid, d.x, va, cnt);   // src/lxpty.bastio
    } else if d.kind == K_DEV {
      r = dev_read(&mut k, pid, d.x, va, cnt);
    } else if d.kind == K_SOCK {
      r = lx_recvfrom(&mut k, pid, a, va, cnt, 0, 0, 0);
      if r == SK_WAIT && !is_unix(k, pid, a) {
        return sock_retry(&mut k, pid, n);  // a network socket: sleep until a frame comes in
      }
      if r == SK_WAIT {
        r = EAGAIN;                         // wait for a datagram, below
      } else if r == EAGAIN {
        ret(&mut k.procs, pid, r);          // nonblocking: say so
        return KEEP;
      }
    }
    if r == EAGAIN && !pipe_nonblock(k, pid, a) {
      return lx_retry(&mut k, pid, n);       // an empty pipe: wait for a writer
    }
    if r == DISK_RETRY {
      return disk_retry(&mut k, pid, n);     // blocks not cached yet: wait for the disk
    }
    ret(&mut k.procs, pid, r);
    return KEEP;
  }
  if n == LX_WRITE || n == LX_WRITEV {
    return lx_write_call(&mut con, &mut k, pid, n, a, b, c);
  }
  if n == LX_PIPE || n == LX_PIPE2 {
    let mut flags = 0;
    if n == LX_PIPE2 {
      flags = b;
    }
    ret(&mut k.procs, pid, lx_pipe(&mut k, pid, a, flags));
    return KEEP;
  }
  if n == LX_DUP {
    ret(&mut k.procs, pid, lx_dup(&mut k, pid, a, 0, false));
    return KEEP;
  }
  if n == LX_DUP2 || n == LX_DUP3 {
    if n == LX_DUP3 && (a == b || c % 0x100000000 & !LO_CLOEXEC != 0) {
      ret(&mut k.procs, pid, EINVAL);
    } else {
      ret(&mut k.procs, pid, lx_dup2(&mut k, pid, a, b, n == LX_DUP3 && c / LO_CLOEXEC % 2 == 1));
    }
    return KEEP;
  }
  if is_sock_call(n) {
    return lx_sock_call(&mut k, pid, n, a, b, c);
  }
  if is_msg_call(n) {
    return lx_msg_call(&mut k, pid, n, a, b, c);
  }
  if is_misc_call(n) {
    return lx_misc_call(&mut con, &mut k, pid, n, a, b, c);
  }
  if is_time_call(n) {
    return lx_time_call(&mut k, pid, n, was, a, b, c);
  }
  if is_more_call(n) {
    return lx_more_call(&mut con, &mut k, pid, n, a, b, c);
  }
  if is_xattr_call(n) {
    return lx_xattr_call(&mut k, pid, n, a);  // src/lxxattr.bastio
  }
  if is_splice_call(n) {
    return lx_splice_call(&mut con, &mut k, pid, n, a, b, c);
  }
  if is_ptimer_call(n) {
    return lx_ptimer_call(&mut k, pid, n, a, b, c, pget(k.procs, pid, F_REGS + R_R10));
  }
  if is_inotify_call(n) {
    return lx_inotify_call(&mut k, pid, n, a, b, c);   // src/lxinotify.bastio
  }
  if is_pidfd_call(n) {
    return lx_pidfd_call(&mut k, pid, n, a, b, c);   // src/lxpidfd.bastio
  }
  if is_extra_call(n) {
    return lx_extra_call(&mut con, &mut k, pid, n, a, b, c);   // src/lxextra.bastio
  }
  if is_event_call(n) {
    return lx_event_call(&mut k, pid, n, was, a, b, c, pget(k.procs, pid, F_REGS + R_R10));
  }
  if n == LX_FCNTL {
    let r = lx_fcntl(&mut k, pid, a, b, c);
    if r == LK_WAIT {
      return lx_retry(&mut k, pid, n);     // F_SETLKW: someone else's lock is in the way
    }
    ret(&mut k.procs, pid, r);
    return KEEP;
  }
  if n == LX_OPEN || n == LX_OPENAT {
    let mut r = 0;
    if n == LX_OPEN {
      r = lx_open(&mut k, pid, AT_FDCWD, a, b, c);
    } else {
      r = lx_open(&mut k, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10));
    }
    if r == SK_WAIT {
      return lx_retry(&mut k, pid, n);      // a FIFO's writer waits for a reader
    }
    ret(&mut k.procs, pid, r);
    return KEEP;
  }
  if n == LX_UNLINK || n == LX_UNLINKAT {
    let mut path = a;
    let mut dirfd = AT_FDCWD;
    if n == LX_UNLINKAT {
      path = b;
      dirfd = a;
    }
    if n == LX_UNLINKAT && c & AT_REMOVEDIR != 0 {
      ret(&mut k.procs, pid, lx_rmdir(&mut k, pid, dirfd, path));
      return KEEP;
    }
    ret(&mut k.procs, pid, lx_unlink(&mut k, pid, dirfd, path));
    return KEEP;
  }
  if n == LX_CLOSE {
    if lx_fd_close(&mut k, pid, a) {
      ret(&mut k.procs, pid, 0);
    } else {
      ret(&mut k.procs, pid, EBADF);
    }
    return KEEP;
  }
  if n == LX_LSEEK {
    ret(&mut k.procs, pid, lx_lseek(&mut k, pid, a, b, c));
    return KEEP;
  }
  if n == LX_BRK {
    ret(&mut k.procs, pid, lx_brk(&mut k, pid, a));
    return KEEP;
  }
  if n == LX_MMAP {
    let flags = pget(k.procs, pid, F_REGS + R_R10);
    let fd = pget(k.procs, pid, F_REGS + R_R8);
    let off = pget(k.procs, pid, F_REGS + R_R9);
    if flags / MAP_FIXED % 2 == 1 && !win_quiet(&mut k, pid) {
      return lx_retry(&mut k, pid, n);      // MAP_FIXED unmaps: another thread of pid runs on a processor
    }
    let r = lx_mmap(&mut k, pid, a, b, c, flags, fd, off);
    if flags & 0x2000 != 0 && r < 0x8000000000000000 {
      lock_mapped(&mut k, pid, b);          // MAP_LOCKED
    }
    ret(&mut k.procs, pid, r);
    return KEEP;
  }
  if n == LX_STAT || n == LX_LSTAT {
    ret(&mut k.procs, pid, lx_stat(&mut k, pid, AT_FDCWD, a, b, n == LX_STAT));
    return KEEP;
  }
  if n == LX_NEWFSTATAT {
    let r10 = pget(k.procs, pid, F_REGS + R_R10);
    if (r10 % 0x100000000) & !(AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT | AT_EMPTY_PATH) != 0 {
      ret(&mut k.procs, pid, EINVAL);
    } else if r10 / AT_EMPTY_PATH % 2 == 1 && user_empty(&mut k, pid, b) {
      ret(&mut k.procs, pid, lx_fstat_at(&mut k, pid, a, c));   // fstat by another name
    } else {
      ret(&mut k.procs, pid, lx_stat(&mut k, pid, a, b, c, (r10 & AT_SYMLINK_NOFOLLOW) == 0));
    }
    return KEEP;
  }
  if n == LX_FSTAT {
    ret(&mut k.procs, pid, lx_fstat(&mut k, pid, a, b));
    return KEEP;
  }
  if n == LX_GETDENTS64 || n == LX_GETDENTS {
    ret(&mut k.procs, pid, lx_getdents(&mut k, pid, a, b, c, n == LX_GETDENTS));
    return KEEP;
  }
  if n == LX_FACCESSAT || n == LX_FACCESSAT2 {
    let mut fl = 0;
    if n == LX_FACCESSAT2 {
      fl = pget(k.procs, pid, F_REGS + R_R10);
    }
    ret(&mut k.procs, pid, lx_access(&mut k, pid, a, b, c, fl));
    return KEEP;
  }
  if n == LX_ACCESS {
    ret(&mut k.procs, pid, lx_access(&mut k, pid, AT_FDCWD, a, b, 0));
    return KEEP;
  }
  if n == LX_CLONE && a & CLONE_VM != 0 && a & CLONE_VFORK != 0 && a & CLONE_THREAD == 0 {
    let r = lx_vfork_vm(&mut k, mmu, pid, b);
    if r >= NPROC {
      ret(&mut k.procs, pid, r);            // -errno: no child
      return KEEP;
    }
    return SWITCH;                          // the parent waits until the child lets go
  }
  if n == LX_CLONE && a & CLONE_THREAD != 0 {
    ret(&mut k.procs, pid, lx_thread_clone(&mut k, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10), pget(k.procs, pid, F_REGS + R_R8)));
    return KEEP;
  }
  if n == LX_UNSHARE {
    ret(&mut k.procs, pid, lx_unshare(&mut k, pid, a));
    return KEEP;
  }
  if n == LX_CLONE && clone_proc_flags(a) {
    ret(&mut k.procs, pid, lx_clone_proc(&mut k, mmu, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10), pget(k.procs, pid, F_REGS + R_R8)));
    return KEEP;
  }
  if n == LX_FORK || n == LX_VFORK {
    ret(&mut k.procs, pid, lx_fork(&mut k, mmu, pid));
    return KEEP;
  }
  if n == LX_EXECVE || n == LX_EXECVEAT {
    let te = thread_exec(&mut k, mmu, pid);
    if te == EXEC_NO {
      ret(&mut k.procs, pid, EINVAL);       // from a thread other than the leader
      return KEEP;
    }
    if te == EXEC_WAIT {
      return lx_retry(&mut k, pid, n);      // its other threads are still ending
    }
    let mut at = AT_FDCWD;
    let mut path = a;
    let mut argv = b;
    let mut envp = c;
    let mut flags = 0;
    if n == LX_EXECVEAT {
      at = a;
      path = b;
      argv = c;
      envp = pget(k.procs, pid, F_REGS + R_R10);
      flags = pget(k.procs, pid, F_REGS + R_R8);
    }
    let r = lx_execve(&mut k, mmu, pid, at, path, argv, envp, flags);
    ret(&mut k.procs, pid, r);
    return KEEP;
  }
  if n == LX_WAITID {
    return lx_waitid(&mut k, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10));
  }
  if n == LX_TIMES {
    ret(&mut k.procs, pid, lx_times(&mut k, pid, a));
    return KEEP;
  }
  if n == LX_WAIT4 {
    return lx_wait4(&mut k, pid, a, b, c);
  }
  if n == LX_GETTID {
    ret(&mut k.procs, pid, pid);            // a thread's id is its row
    return KEEP;
  }
  if n == LX_RT_SIGSUSPEND {
    return lx_sigsuspend(&mut k, pid, was, a);
  }
  if is_sig_call(n) {
    return lx_sig_call(&mut k, pid, n, a, b, c);
  }
  if is_pq_call(n) {
    return lx_pq_call(&mut k, pid, n, was, a, b, c);
  }
  if is_ipc_call(n) {
    return lx_ipc_call(&mut k, pid, n, was, a, b, c);
  }
  if is_sys_call(n) {
    return lx_sys_call(&mut k, pid, n, a, b);
  }
  if is_prio_call(n) {
    ret(&mut k.procs, pid, lx_prio_call(&mut k, pid, n, a, b, c, pget(k.procs, pid, F_REGS + R_R10)));
    return KEEP;
  }
  if is_cred_call(n) {
    return lx_cred_call(&mut k, pid, n, a, b, c);
  }
  if n == LX_GETCWD {
    ret(&mut k.procs, pid, lx_getcwd(&mut k, pid, a, b));
    return KEEP;
  }
  if is_link_call(n) {
    ret(&mut k.procs, pid, lx_link_call(&mut k, pid, n, a, b, c));
    return KEEP;
  }
  if is_mount_call(n) {
    ret(&mut k.procs, pid, lx_mount_call(&mut k, pid, n, a, b, c));
    return KEEP;
  }
  if is_procfs_call(n) {
    ret(&mut k.procs, pid, lx_procfs_call(&mut k, pid, n, a, b, c));
    return KEEP;
  }
  if is_dir_call(n) {
    ret(&mut k.procs, pid, lx_dir_call(&mut k, pid, n, a, b, c));
    return KEEP;
  }
  if n == LX_GETPID {
    ret(&mut k.procs, pid, tgid(k.procs, pid));
    return KEEP;
  }
  if n == LX_GETPPID {
    ret(&mut k.procs, pid, pget(k.procs, tgid(k.procs, pid), F_PARENT));
    return KEEP;
  }
  if n == LX_IOCTL {
    ret(&mut k.procs, pid, lx_ioctl(&mut k, pid, a, b, c));
    return KEEP;
  }
  if n == LX_ARCH_PRCTL {
    if a == ARCH_SET_FS {
      pset(&mut k.procs, pid, F_REGS + R_FSBASE, b);
      ret(&mut k.procs, pid, 0);
    } else if a == ARCH_GET_FS {
      xfer_u64(&mut k.fs.xfer, 0, pget(k.procs, pid, F_REGS + R_FSBASE));
      ret(&mut k.procs, pid, lx_put_out(&mut k, pid, b, 8));
    } else if a == ARCH_GET_CPUID {
      ret(&mut k.procs, pid, 1);              // cpuid runs
    } else if a == ARCH_SET_CPUID {
      ret(&mut k.procs, pid, 18446744073709551597);   // -ENODEV: no CPUID faulting to turn it off with
    } else {
      ret(&mut k.procs, pid, EINVAL);
    }
    return KEEP;
  }
  if n == LX_SET_TID_ADDRESS {
    pset(&mut k.procs, pid, F_CTID, a);
    ret(&mut k.procs, pid, pid);
    return KEEP;
  }
  if n == LX_SET_ROBUST_LIST {
    ret(&mut k.procs, pid, lx_set_robust_list(&mut k, pid, a, b));
    return KEEP;
  }
  if n == LX_GET_ROBUST_LIST {
    ret(&mut k.procs, pid, lx_get_robust_list(&mut k, pid, a, b, c));
    return KEEP;
  }
  // glibc asks for these and carries on without them: restartable
  // sequences (sched_getcpu falls back to the system call), and clone3
  // (pthread_create falls back to clone, as on Linux before 5.3); nginx
  // goes on without Linux AIO (io_setup). Refused quietly, as known gaps.
  if n == LX_RSEQ || n == LX_CLONE3 || n == LX_IO_SETUP {
    ret(&mut k.procs, pid, ENOSYS);
    return KEEP;
  }
  puts(&mut con, "[pid ");
  put_num(&mut con, pid);
  puts(&mut con, ": Linux system call ");
  put_num(&mut con, n);
  puts(&mut con, " not implemented]\r\n");
  ret(&mut k.procs, pid, ENOSYS);
  return KEEP;
}

/// write and writev, from linux_syscall: the call, then what its result
/// means for the caller (an answer, or a wait for room).
fn lx_write_call(con: &mut Con, k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires con_ok(con) && kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k) && con_ok(con)
{
  let early = rw_early(&mut k, pid, n, a, b, c);
  if early != NO_RESULT {
    ret(&mut k.procs, pid, early);
    return KEEP;
  }
  let mut w = 0;
  if n == LX_WRITE {
    w = lx_write_fd(&mut con, &mut k, pid, a, b, c);
  } else {
    w = do_writev(&mut con, &mut k, pid, a, b, c);
  }
  if (w == EAGAIN || w == SK_WAIT) && pipe_nonblock(k, pid, a) {
    ret(&mut k.procs, pid, EAGAIN);        // a full nonblocking pipe or connection: say so
    return KEEP;
  }
  if w == SK_WAIT && is_tcp(k, pid, a) {
    return sock_retry(&mut k, pid, n);     // a full connection: sleep until an ACK comes in
  }
  if w == EAGAIN || w == SK_WAIT {
    return lx_retry(&mut k, pid, n);       // a full pipe or connection: wait for room
  }
  if w == CON_FULL {
    return con_block(&mut k, pid, n);      // a full console: wait for the pump
  }
  if w == DISK_RETRY {
    return disk_retry(&mut k, pid, n);     // blocks not cached yet: wait for the disk
  }
  ret(&mut k.procs, pid, w);
  if w == EPIPE {
    post_sig(&mut k, pid, SIGPIPE);        // no reader left
    return SWITCH;
  }
  return KEEP;
}

const TCGETS: u64 = 0x5401;
const TCSETS: u64 = 0x5402;
const TCSETSF: u64 = 0x5404;              // TCSETSW (0x5403) lies between
const TIOCGWINSZ: u64 = 0x5413;
const FIONREAD: u64 = 0x541B;
const FIONBIO: u64 = 0x5421;
const FIONCLEX: u64 = 0x5450;
const FIOCLEX: u64 = 0x5451;
const FIOASYNC: u64 = 0x5452;
const SIOCATMARK: u64 = 0x8905;
const SIOCGIFCONF: u64 = 0x8912;
const SIOCGIFFLAGS: u64 = 0x8913;
const SIOCSIFFLAGS: u64 = 0x8914;
const IFREQ_SIZE: u64 = 40;
const IFF_LO: u64 = 0x49;              // IFF_UP | IFF_LOOPBACK | IFF_RUNNING
const TIOCGPGRP: u64 = 0x540F;
const TIOCSPGRP: u64 = 0x5410;
const TIOCGSID: u64 = 0x5429;
const WINSIZE_SIZE: u64 = 8;

// The terminal's settings (struct termios, kept after the line in k.line).
const ISIG: u64 = 1;                      // c_lflag: Ctrl-C sends SIGINT
const ICANON: u64 = 2;                    // c_lflag: canonical mode (lines)
const ECHO: u64 = 8;                      // c_lflag: echo what is typed
const ICRNL: u64 = 0x100;                 // c_iflag: CR typed reads as LF
const OPOST: u64 = 1;                     // c_oflag: process output
const ONLCR: u64 = 4;                     // c_oflag: LF goes out as CR LF
const VTIME_AT: u64 = 22;                 // c_cc[VTIME], in tenths of a second
const VMIN_AT: u64 = 23;                  // c_cc[VMIN]

/// Byte i of the terminal's settings until a program sets them: canonical
/// mode with echo, as a Linux console starts.
fn tt_default(i: u64) -> u64 {
  if i == 1 { return 1; }                 // c_iflag: ICRNL (0x100)
  if i == 4 { return 5; }                 // c_oflag: OPOST | ONLCR
  if i == 8 { return 0xBF; }              // c_cflag: B38400 | CS8 | CREAD
  if i == 12 { return 0x3B; }             // c_lflag: ISIG | ICANON | ECHO | ECHOE | ECHOK
  if i == 13 { return 0x8A; }             //   | ECHOCTL | ECHOKE | IEXTEN (0x8A3B)
  if i == 17 { return 3; }                // c_cc[VINTR] = Ctrl-C
  if i == 18 { return 0x1C; }             // c_cc[VQUIT] = Ctrl-\
  if i == 19 { return 0x7F; }             // c_cc[VERASE] = DEL
  if i == 20 { return 0x15; }             // c_cc[VKILL] = Ctrl-U
  if i == 21 { return 4; }                // c_cc[VEOF] = Ctrl-D
  if i == VMIN_AT { return 1; }
  return 0;
}

/// Byte i of the terminal's struct termios.
fn tt_byte(l: &Buf, i: u64) -> u64
  requires lineok(l) && i < TERMIOS_SIZE
  ensures result < 256
{
  if get(l, TT_SET) == 0 {
    return tt_default(i) % 256;
  }
  return get(l, TT0 + i) % 256;
}

/// The 16-bit flag word at byte i of the settings (the low half of a
/// tcflag_t: every flag used here lives there).
fn tt_flags(l: &Buf, i: u64) -> u64
  requires lineok(l) && i + 1 < TERMIOS_SIZE
{
  return tt_byte(l, i) + 256 * tt_byte(l, i + 1);
}

fn tt_canon(l: &Buf) -> bool
  requires lineok(l)
{
  return tt_flags(l, 12) & ICANON != 0;
}

/// ioctl(fd, req, arg). Descriptors 0-2 are the console, a terminal with
/// 24 rows of 80 columns. Its settings (tt_byte) start in canonical mode
/// with echo; a program may turn off canonical mode, echo, ISIG, ICRNL
/// and output processing, and set VMIN and VTIME, as editors and REPLs
/// do (tty_cook, console_read). The other settings are kept and reported
/// but change nothing. Files are not terminals.
fn lx_ioctl(k: &mut Kernel, pid: u64, fd: u64, req: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  if d.kind == K_BAD {
    return EBADF;
  }
  // On any descriptor, as on Linux: FIONBIO sets or clears O_NONBLOCK
  // (nginx and CPython use it rather than fcntl), FIOASYNC O_ASYNC, and
  // FIOCLEX and FIONCLEX close-on-exec. They go through fcntl, which
  // knows where each kind of description keeps the flag.
  if req == FIONBIO || req == FIOASYNC {
    let v = pty_int_in(&mut k, pid, arg);
    if v == NO_RESULT {
      return EFAULT;
    }
    let mut bit = LO_NONBLOCK;
    if req == FIOASYNC {
      bit = 0x2000;                           // O_ASYNC
    }
    let fl = lx_fcntl(&mut k, pid, fd, F_GETFL, 0);
    if fl >= 0x100000000 {
      return fl;                              // an errno
    }
    let mut nf = fl - fl / bit % 2 * bit;
    if v != 0 {
      nf = nf + bit;
    }
    let r = lx_fcntl(&mut k, pid, fd, F_SETFL, nf);
    return r;
  }
  if req == FIOCLEX || req == FIONCLEX {
    let mut on = 0;
    if req == FIOCLEX {
      on = 1;
    }
    let r = lx_fcntl(&mut k, pid, fd, F_SETFD, on);
    return r;
  }
  if req == FIONREAD && (d.kind == K_PIPE_R || d.kind == K_PIPE_W) {
    // The bytes waiting in the pipe, as an int.
    xfer_u64(&mut k.fs.xfer, 0, smaller(pi_get(k.pipes, d.x, 1), PIPE_CAP));
    return lx_put_out(&mut k, pid, arg, 4);
  }
  if d.kind == K_DEV && (is_loop(d.x) || d.x == DEV_LOOPCTL) {
    return loop_ioctl(&mut k, pid, d.x, req % 0x100000000, arg);   // the request is an unsigned int
  }
  if d.kind == K_DEV && is_pty_dev(d.x) {
    return pty_ioctl(&mut k, pid, fd, d.x, req % 0x100000000, arg);   // src/lxpty.bastio
  }
  if d.kind == K_SOCK && (req == SIOCATMARK || (req >= SIOCGIFCONF && req <= SIOCSIFFLAGS)) {
    return sock_ioctl(&mut k, pid, fd, req, arg);
  }
  if d.kind != K_CONSOLE {
    return ENOTTY;
  }
  if req == TCSETS || (req > TCSETS && req <= TCSETSF) {
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, &mut k.fs.xfer, TERMIOS_SIZE) != TERMIOS_SIZE {
      return EFAULT;
    }
    let mut i = 0;
    while i < TERMIOS_SIZE
      invariant i <= TERMIOS_SIZE && kok(k)
    {
      k.line = set(k.line, TT0 + i, cast[u64](bget(k.fs.xfer, i)));
      i = i + 1;
    }
    k.line = set(k.line, TT_SET, 1);
    if req == TCSETSF {
      ring_clear(&mut k.q.r);               // TCSAFLUSH: drop what was typed and not read
      k.line = set(k.line, 0, 0);
      k.line = set(k.line, 1, 0);
    }
    return 0;
  }
  if req == TCGETS {
    let mut i = 0;
    while i < TERMIOS_SIZE
      invariant i <= TERMIOS_SIZE && kok(k)
    {
      bset(&mut k.fs.xfer, i, cast[u8](tt_byte(k.line, i)));
      i = i + 1;
    }
    return lx_put_out(&mut k, pid, arg, TERMIOS_SIZE);
  }
  if req == TIOCGPGRP || req == TIOCGSID {
    // The console's foreground group is whatever group asks: there is no
    // job control to put one in the background.
    let mut g = pgid_of(k.procs, pid);
    if req == TIOCGSID {
      g = sid_of(k.procs, pid);
    }
    xfer_u64(&mut k.fs.xfer, 0, g);
    return lx_put_out(&mut k, pid, arg, 4);
  }
  if req == TIOCSPGRP {
    return 0;                               // accepted: see TIOCGPGRP
  }
  if req == TIOCGWINSZ {
    lx_fill(&mut k, 0, WINSIZE_SIZE);
    bset(&mut k.fs.xfer, 0, 24);            // ws_row
    bset(&mut k.fs.xfer, 2, 80);            // ws_col
    return lx_put_out(&mut k, pid, arg, WINSIZE_SIZE);
  }
  return EINVAL;
}

/// The socket ioctls: SIOCATMARK on TCP (never at urgent data, which is
/// never kept), and the interface list, which names only the loopback "lo":
/// SIOCGIFCONF lists it, SIOCGIFFLAGS reports it up, SIOCSIFFLAGS is
/// accepted and changes nothing.
fn sock_ioctl(k: &mut Kernel, pid: u64, fd: u64, req: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if req == SIOCATMARK {
    if !is_tcp(k, pid, fd) {
      return ENOTTY;                        // as Linux: only a stream socket knows the mark
    }
    xfer_u64(&mut k.fs.xfer, 0, 0);
    return lx_put_out(&mut k, pid, arg, 4);
  }
  if req == SIOCGIFCONF {
    // struct ifconf: int ifc_len, then the buffer's address.
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, &mut k.fs.xfer, 16) != 16 {
      return EFAULT;
    }
    let room = get_u64(k.fs.xfer, 0) % 4294967296;
    let buf = get_u64(k.fs.xfer, 8);
    let mut n = 0;
    if buf == 0 || room >= IFREQ_SIZE {
      n = IFREQ_SIZE;                       // with no buffer, the size needed
    }
    if buf != 0 && n > 0 {
      lx_fill(&mut k, 0, IFREQ_SIZE);
      bset(&mut k.fs.xfer, 0, 108);         // "lo"
      bset(&mut k.fs.xfer, 1, 111);
      bset(&mut k.fs.xfer, 16, 2);          // ifr_addr: AF_INET 127.0.0.1
      bset(&mut k.fs.xfer, 20, 127);
      bset(&mut k.fs.xfer, 23, 1);
      let r = lx_put_out(&mut k, pid, buf, IFREQ_SIZE);
      if r != 0 {
        return r;
      }
    }
    xfer_u64(&mut k.fs.xfer, 0, n);
    return lx_put_out(&mut k, pid, arg, 4);
  }
  // SIOCGIFFLAGS, SIOCSIFFLAGS: struct ifreq, the name in its first 16 bytes.
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, &mut k.fs.xfer, IFREQ_SIZE) != IFREQ_SIZE {
    return EFAULT;
  }
  if bget(k.fs.xfer, 0) != 108 || bget(k.fs.xfer, 1) != 111 || bget(k.fs.xfer, 2) != 0 {
    return 18446744073709551597;            // ENODEV (src/lxmore.bastio comes later)
  }
  if req == SIOCSIFFLAGS {
    return 0;
  }
  bset(&mut k.fs.xfer, 16, cast[u8](IFF_LO));
  bset(&mut k.fs.xfer, 17, 0);
  return lx_put_out(&mut k, pid, arg, IFREQ_SIZE);
}

/// Sets the first n transfer bytes to v.
fn lx_fill(k: &mut Kernel, v: u64, n: u64)
  requires kok(k) && v <= 255 && n <= 160
  ensures kok(k)
{
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 160 && kok(k)
  {
    bset(&mut k.fs.xfer, i, cast[u8](v));
    i = i + 1;
  }
}

/// Copies the first n transfer bytes to user address va. Returns 0, or
/// -EFAULT.
fn lx_put_out(k: &mut Kernel, pid: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= 160
  ensures kok(k)
{
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, n) != n {
    return EFAULT;
  }
  return 0;
}

/// Fills the n bytes at user address va with zeros, if va is not 0 (NULL).
/// Returns 0, or -EFAULT.
fn lx_zero_out(k: &mut Kernel, pid: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= 64
  ensures kok(k)
{
  if va == 0 {
    return 0;
  }
  lx_fill(&mut k, 0, n);
  return lx_put_out(&mut k, pid, va, n);
}

// ---------------------------------------------------------------- reading and writing

/// The terminal's line discipline for Linux programs, like a Linux tty.
/// While one is blocked reading the console, typed bytes go to k.line. In
/// canonical mode they are echoed and gathered, Backspace erases, and
/// Enter or Ctrl-D finishes the line, which wakes the reader. In
/// noncanonical mode (an editor, a REPL) every byte can be read as soon as
/// it is typed, echoed only if ECHO is on. Bytes typed while no Linux
/// program reads stay queued for the native shell.
fn tty_cook(con: &mut Con, k: &mut Kernel)
  requires con_ok(con) && kok(k)
  ensures kok(k) && con_ok(con)
{
  if !lx_reading(k.procs) {
    return;
  }
  if !tt_canon(k.line) {
    let echo = tt_flags(k.line, 12) & ECHO != 0;
    let crnl = tt_flags(k.line, 0) & ICRNL != 0;
    while k.q.r.n > 0 && get(k.line, 0) < LINE_MAX
      invariant kok(k) && con_ok(con)
    {
      let mut c = q_pop(&mut k.q) % 256;
      if c == 13 && crnl {
        c = 10;
      }
      let n = get(k.line, 0);
      k.line = set(k.line, 2 + n, c);
      k.line = set(k.line, 0, n + 1);
      k.line = set(k.line, 1, 1);
      if echo {
        con_write(&mut con, cast[u8](c));
      }
    }
    return;
  }
  let echo = tt_flags(k.line, 12) & ECHO != 0;
  while get(k.line, 1) == 0 && k.q.r.n > 0
    invariant kok(k) && con_ok(con)
  {
    tty_key(&mut con, &mut k.line, q_pop(&mut k.q), echo);
  }
}

/// Whether some process is blocked in a Linux read of the console, or
/// waits in poll (which may be for the console: a poll on pipes or sockets
/// alone also lets typed bytes go to the Linux line).
fn lx_reading(procs: &Buf) -> bool
  requires ptab_ok(procs)
{
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC
  {
    if state(procs, p) == LXREADING {
      return true;
    }
    let n = pget(procs, p, F_REGS + R_RAX);
    if pget(procs, p, F_RESTART) >= 2 && (n == LX_POLL || n == LX_PPOLL || n == LX_READ) {
      return true;                          // a timed read is one of the console's (console_read)
    }
    p = p + 1;
  }
  return false;
}

/// One typed byte c, added to the unfinished line l.
fn tty_key(con: &mut Con, l: &mut Buf, c: u64, echo: bool)
  requires con_ok(con) && lineok(l) && get(l, 1) == 0
  ensures lineok(l) && con_ok(con)
{
  let n = get(l, 0);
  if c == 13 || c == 10 {
    // Enter: the line ends with LF, so a full line keeps room for it.
    if echo {
      puts(&mut con, "\r\n");
    }
    if n < LINE_MAX {
      l = set(l, 2 + n, 10);
      l = set(l, 0, n + 1);
    }
    l = set(l, 1, 1);
  } else if c == 4 {
    // Ctrl-D: the line ends as it is; on an empty line the read returns 0.
    l = set(l, 1, 1);
  } else if c == 127 || c == 8 {
    if n > 0 {
      l = set(l, 0, n - 1);
      if echo {
        con_write(&mut con, 8);
        con_write(&mut con, 32);
        con_write(&mut con, 8);
      }
    }
  } else if c >= 32 && c <= 255 && n + 1 < LINE_MAX {
    l = set(l, 2 + n, c);
    l = set(l, 0, n + 1);
    if echo {
      con_write(&mut con, cast[u8](c));
    }
  }
}

/// read(0, buf, n): up to n bytes of the finished line. With no finished
/// line the process blocks and the call is restarted (rip moved back over
/// the 2-byte `syscall`) once there is one, so tty_cook can gather it.
/// In noncanonical mode a read returns once a byte is there (VMIN above 1
/// is read as 1); with VMIN 0 it waits at most VTIME tenths of a second,
/// or not at all, and may return 0. `was` is the call's F_RESTART, which
/// keeps such a wait's deadline.
fn console_read(k: &mut Kernel, pid: u64, va: u64, n: u64, was: u64) -> u64
  requires kok(k) && 1 <= pid && pid < NPROC
  ensures kok(k)
{
  if n == 0 {
    ret(&mut k.procs, pid, 0);
    return KEEP;
  }
  if !user_range(va, 1) {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  if get(k.line, 1) == 0 && !tt_canon(k.line) && tt_byte(k.line, VMIN_AT) == 0 {
    let mut dl = sat_add(k.ns, tt_byte(k.line, VTIME_AT) * 100000000);
    if was >= 2 {
      dl = was - 2;
    }
    if k.ns >= dl || dl > 18446744073709551613 {   // past FOREVER (src/lxtime.bastio)
      ret(&mut k.procs, pid, 0);            // nothing typed in time
      return KEEP;
    }
    return wait_until(&mut k, pid, LX_READ, dl);
  }
  if get(k.line, 1) == 0 {
    let rip = pget(k.procs, pid, F_REGS + R_RIP);
    if rip < 2 {
      ret(&mut k.procs, pid, EFAULT);
      return KEEP;
    }
    pset(&mut k.procs, pid, F_REGS + R_RIP, rip - 2);
    pset(&mut k.procs, pid, F_REGS + R_RAX, LX_READ);
    pset(&mut k.procs, pid, F_STATE, LXREADING);
    pset(&mut k.procs, pid, F_RESTART, 1);
    return SWITCH;
  }
  // Take only what fits in the window from va, so no byte is lost.
  let have = get(k.line, 0);
  let room = USER_SIZE - (va - USER_BASE);
  let want = smaller(smaller(n, room), have);
  let mut i = 0;
  while i < want
    invariant i <= want && want <= have && have <= LINE_MAX && kok(k)
  {
    bset(&mut k.fs.xfer, i, cast[u8](get(k.line, 2 + i) % 256));
    i = i + 1;
  }
  let put = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, want);
  if put == NO_RESULT || (put == 0 && want > 0) {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  ret(&mut k.procs, pid, put);
  line_take(&mut k.line, put);
  return KEEP;
}

/// Drops the first `t` bytes of the finished line l; once it is empty the
/// next line can be typed.
fn line_take(l: &mut Buf, t: u64)
  requires lineok(l) && t <= get(l, 0)
  ensures lineok(l)
{
  let n = get(l, 0);
  let mut i = 0;
  while i + t < n
    invariant i + t <= n && n <= LINE_MAX && lineok(l)
  {
    l = set(l, 2 + i, get(l, 2 + i + t));
    i = i + 1;
  }
  l = set(l, 0, n - t);
  if n == t {
    l = set(l, 1, 0);
  }
}

/// read from the file open on native row `row`: up to READ_MAX bytes, a
/// transfer buffer at a time, so a regular file is not read short (as
/// programs expect of one) unless it ends or the disk must be waited for.
fn lx_file_read(k: &mut Kernel, pid: u64, row: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && row < FD_ROWS
  ensures kok(k)
{
  let want = smaller(n, READ_MAX);
  let mut done = 0;
  while done < want
    invariant done <= want && want <= READ_MAX && kok(k)
  {
    let got = vfs_read(&mut k.fs, row, smaller(want - done, XFER));
    if got == NO_FD {
      return EBADF;
    }
    if got == VFS_MISS {
      if done > 0 {
        return done;                        // what came so far; the rest waits
      }
      return DISK_RETRY;                    // sleep until the disk catches up
    }
    if va > 0xFFFFFFFFFFFFFFFF - READ_MAX {
      return EFAULT;
    }
    let put = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + done, k.fs.xfer, got);
    if put == NO_RESULT || (put == 0 && got > 0) {
      if done > 0 {
        return done;
      }
      return EFAULT;
    }
    vfs_advance(&mut k.fs, row, vfs_offset(k.fs, row), put);
    if put > want - done {
      return want;
    }
    done = done + put;
    if put < XFER {
      return done;                          // the end of the file
    }
  }
  return done;
}

/// write(fd, va, n) to the console, a file or a pipe. Returns the count,
/// -errno, or EAGAIN when a pipe is full.
fn lx_write_fd(con: &mut Con, k: &mut Kernel, pid: u64, fd: u64, va: u64, n0: u64) -> u64
  requires con_ok(con) && kok(k) && pid < NPROC
  ensures kok(k) && con_ok(con)
{
  let mut n = n0;
  let d = fd_look(k, pid, fd);
  if d.kind == K_PIPE_W || (d.kind == K_PIPE_R && pipe_both(k, pid, fd)) {
    return pipe_write(&mut k, pid, d.x, va, n);
  }
  if d.kind == K_EVENT {
    return ev_write(&mut k, pid, d.x, va, n);
  }
  if d.kind == K_SOCK {
    return lx_sendto(&mut k, pid, fd, va, n, 0, 0, 0);   // to the connected peer
  }
  if d.kind == K_DEV && is_loop(d.x) {
    return loop_io(&mut con, &mut k, pid, fd, d.x, true, va, n);
  }
  if d.kind == K_DEV && is_pty_dev(d.x) {
    return pty_write(&mut k, pid, d.x, va, n);   // src/lxpty.bastio
  }
  if d.kind == K_DEV {
    return n;                               // a device swallows what it is given
  }
  if d.kind != K_CONSOLE && d.kind != K_FILE {
    return EBADF;
  }
  if d.kind == K_FILE {
    let lim = fsize_room(&mut k, pid, d.x, n);
    if lim > n {
      return lim;                           // -EFBIG: RLIMIT_FSIZE
    }
    n = lim;
  }
  let room = con_room(con);
  if d.kind == K_CONSOLE && 2 * smaller(n, XFER) > room && room < OUTCAP {
    return CON_FULL;                        // the console's ring is too full: wait
  }
  let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, smaller(n, XFER));
  if got == NO_RESULT || (got == 0 && n > 0) {
    return EFAULT;
  }
  if d.kind == K_CONSOLE {
    // The console, with ONLCR as the termios says (on unless a program
    // turned off it or OPOST): LF goes out as CR LF. At most two bytes
    // each, so a full ring makes the write short (only a write longer than
    // the whole ring gets that far).
    let of = tt_flags(k.line, 4);
    let onlcr = of & OPOST != 0 && of & ONLCR != 0;
    let fits = smaller(got, con_room(con) / 2);
    let mut i = 0;
    while i < fits
      invariant i <= fits && fits <= got && got <= XFER && kok(k) && con_ok(con)
    {
      let ch = bget(k.fs.xfer, i);
      if ch == 10 && onlcr {
        con_write(&mut con, 13);
      }
      con_write(&mut con, ch);
      i = i + 1;
    }
    return fits;
  }
  // A file takes the whole count, XFER bytes at a time; each piece is
  // its own write (on the disk, its own commit). If the disk has not
  // caught up after the first piece, the count so far is returned.
  let mut total = 0;
  let mut piece = got;
  let mut more = true;
  while more && total < n
    invariant total <= n && piece <= XFER && kok(k) && pid < NPROC
  {
    if total > 0 {
      if va > 0xFFFFFFFFFFFFFFFF - total {
        return total;
      }
      piece = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + total, &mut k.fs.xfer, smaller(n - total, XFER));
      if piece == NO_RESULT || piece == 0 {
        return total;
      }
    }
    let w = vfs_write(&mut k.fs, &mut k.mem, d.x, piece);
    if w == NO_FD {
      return EBADF;
    }
    if w == VFS_MISS {
      if total == 0 {
        return DISK_RETRY;                  // sleep until the disk catches up
      }
      return total;
    }
    if w > n - total {
      return total;                         // cannot happen: w <= piece <= n - total
    }
    total = total + w;
    more = w == piece && w > 0;
  }
  return total;
}

/// What read, readv, write or writev (n) on fd a returns before it moves
/// anything, or NO_RESULT to go on: EISDIR for a directory, the iov_check
/// verdict, and 0 for zero iovecs or a zero-length write to a file.
fn rw_early(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, a);
  if d.kind == K_BAD {
    return NO_RESULT;                       // EBADF, from the call itself
  }
  if (n == LX_READ || n == LX_READV) && d.kind == K_DIR {
    return EISDIR;
  }
  if n == LX_READV || n == LX_WRITEV {
    let bad = iov_check(&mut k, pid, b, c);
    if bad != 0 || c == 0 {
      return bad;
    }
  }
  if n == LX_WRITE && c == 0 && d.kind == K_FILE {
    return 0;                               // nothing to write, whatever the buffer
  }
  return NO_RESULT;
}

/// The checks readv and writev make before they move anything: cnt at most
/// IOV_MAX, every iovec readable, and no length (nor their total) negative
/// as a ssize_t. 0, EINVAL or EFAULT.
fn iov_check(k: &mut Kernel, pid: u64, iov: u64, cnt: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if cnt > IOV_MAX {
    return EINVAL;
  }
  if iov > USER_BASE + USER_SIZE {
    return EFAULT;
  }
  let mut total = 0;
  let mut i = 0;
  while i < cnt
    invariant i <= cnt && cnt <= IOV_MAX && iov <= USER_BASE + USER_SIZE && kok(k) && total < 0x8000000000000000
  {
    let size = user_u64(&mut k.spaces, pid, iov + 16 * i + 8);
    if !size.ok {
      return EFAULT;
    }
    if size.v >= 0x8000000000000000 - total {
      return EINVAL;
    }
    total = total + size.v;
    i = i + 1;
  }
  return 0;
}

/// The first iovec with room among the cnt at user address iov (or the
/// last, if none has): its base and length, or err.
struct Iov { err: u64, base: u64, len: u64 }

fn first_iov(k: &mut Kernel, pid: u64, iov: u64, cnt: u64) -> Iov
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if cnt == 0 || cnt > IOV_MAX {
    return Iov { err: EINVAL, base: 0, len: 0 };
  }
  if iov > USER_BASE + USER_SIZE {
    return Iov { err: EFAULT, base: 0, len: 0 };
  }
  let mut i = 0;
  while i < cnt
    invariant i <= cnt && cnt <= IOV_MAX && iov <= USER_BASE + USER_SIZE && kok(k)
  {
    let base = user_u64(&mut k.spaces, pid, iov + 16 * i);
    let size = user_u64(&mut k.spaces, pid, iov + 16 * i + 8);
    if !base.ok || !size.ok {
      return Iov { err: EFAULT, base: 0, len: 0 };
    }
    if size.v > 0 || i + 1 == cnt {
      return Iov { err: 0, base: base.v, len: size.v };
    }
    i = i + 1;
  }
  return Iov { err: EINVAL, base: 0, len: 0 };
}

/// readv on file row `row`: fills the cnt (base, length) buffers at user
/// address iov in turn, stopping at the end of the file. Returns the bytes
/// read, or -errno if nothing was.
fn file_readv(k: &mut Kernel, pid: u64, row: u64, iov: u64, cnt: u64) -> u64
  requires kok(k) && pid < NPROC && row < FD_ROWS
  ensures kok(k)
{
  if cnt == 0 || cnt > IOV_MAX {
    return EINVAL;
  }
  if iov > USER_BASE + USER_SIZE {
    return EFAULT;
  }
  let mut total = 0;
  let mut i = 0;
  while i < cnt
    invariant i <= cnt && cnt <= IOV_MAX && iov <= USER_BASE + USER_SIZE && kok(k) && total <= USER_SIZE
  {
    let base = user_u64(&mut k.spaces, pid, iov + 16 * i);
    let size = user_u64(&mut k.spaces, pid, iov + 16 * i + 8);
    if !base.ok || !size.ok {
      if total > 0 {
        return total;
      }
      return EFAULT;
    }
    let r = lx_file_read(&mut k, pid, row, base.v, size.v);
    if r > USER_SIZE {
      if total > 0 {
        return total;
      }
      return r;                             // -errno
    }
    if r > USER_SIZE - total {
      return total;
    }
    total = total + r;
    if r < size.v {
      return total;                         // the end of the file
    }
    i = i + 1;
  }
  return total;
}

/// writev: the cnt (base, length) pairs at user address iov, each written
/// as by write. Returns the bytes written, or -errno if nothing was.
fn do_writev(con: &mut Con, k: &mut Kernel, pid: u64, fd: u64, iov: u64, cnt: u64) -> u64
  requires con_ok(con) && kok(k) && pid < NPROC
  ensures kok(k) && con_ok(con)
{
  if cnt > IOV_MAX {
    return EINVAL;
  }
  if iov > USER_BASE + USER_SIZE {
    return EFAULT;
  }
  let mut total = 0;
  let mut i = 0;
  while i < cnt
    invariant i <= cnt && cnt <= IOV_MAX && iov <= USER_BASE + USER_SIZE && con_ok(con)
    invariant kok(k) && total <= TOTAL_MAX
  {
    let at = iov + 16 * i;
    let base = user_u64(&mut k.spaces, pid, at);
    let size = user_u64(&mut k.spaces, pid, at + 8);
    if !base.ok || !size.ok || base.v > USER_BASE + USER_SIZE {
      return lx_fail_or(total, EFAULT);
    }
    // A file write moves at most XFER bytes at once: go round until done.
    let mut done = 0;
    while done < size.v
      invariant done <= size.v && kok(k) && total <= TOTAL_MAX && con_ok(con)
      invariant base.v <= USER_BASE + USER_SIZE
    {
      let left = size.v - done;
      if done > USER_SIZE {
        return lx_fail_or(total, EFAULT);       // past the window: base + done faults
      }
      let w = lx_write_fd(&mut con, &mut k, pid, fd, base.v + done, left);
      if w > left || w > USER_SIZE {
        return lx_fail_or(total, w);            // an error
      }
      if w == 0 || total + w > TOTAL_MAX {
        return total;
      }
      total = total + w;
      done = done + w;
    }
    i = i + 1;
  }
  return total;
}

/// What a call that moved `total` bytes before failing with `err` returns.
fn lx_fail_or(total: u64, err: u64) -> u64 {
  if total > 0 {
    return total;
  }
  return err;
}

// ---------------------------------------------------------------- files

/// Copies the NUL-terminated path at user address va into the transfer
/// buffer as a name for the file layer: from the top directory, without
/// the leading "/", relative paths taken from process pid's working
/// directory, "." and empty parts dropped and ".." going up a level.
/// Returns its length (0 for the top directory), or NO_RESULT if it is
/// unreadable (k.perr = -EFAULT), too long (-ENAMETOOLONG), loops through
/// links (-ELOOP), goes through a dangling link (-ENOENT) or through
/// something that is not a directory (-ENOTDIR).
fn lx_path_in(k: &mut Kernel, pid: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  let n = lx_path_from(&mut k, pid, va, OFD_N, true);
  return perm_walk(&mut k, pid, n);
}

/// lx_path_in for the *at calls: a relative path starts at directory
/// descriptor dirfd, or at the working directory for AT_FDCWD. NO_RESULT
/// for a relative path and a dirfd that is not an open directory (k.perr
/// says which: EBADF or ENOTDIR).
fn lx_path_at(k: &mut Kernel, pid: u64, dirfd: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  let n = lx_path_from(&mut k, pid, va, dir_ofd(k, pid, dirfd), true);
  return perm_walk(&mut k, pid, n);
}

/// lx_path_at for the calls that act on a symbolic link itself (lstat,
/// readlink, unlink, rename, mkdir, rmdir, mknod): links on the way are
/// followed, a link at the end is not.
fn lx_path_at_nf(k: &mut Kernel, pid: u64, dirfd: u64, va: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  let n = lx_path_from(&mut k, pid, va, dir_ofd(k, pid, dirfd), false);
  return perm_walk(&mut k, pid, n);
}

/// The base a relative path of an *at call starts from: OFD_N for the
/// working directory, a directory description, OFD_N + 1 for a descriptor
/// that is not open, or OFD_N + 2 for one that is not a directory.
fn dir_ofd(k: &Kernel, pid: u64, dirfd: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures result <= OFD_N + 2
{
  if dirfd % 0x100000000 == AT_FDCWD {
    return OFD_N;
  }
  if fd_get(k.lxfd, pid, dirfd) == 0 {
    return OFD_N + 1;
  }
  let v = fd_get(k.lxfd, pid, dirfd) % FD_CLOEXEC;
  if v < FD_OFD || v - FD_OFD >= OFD_N || of_get(k.ofd, v - FD_OFD, 0) != OF_DIR {
    return OFD_N + 2;
  }
  return v - FD_OFD;
}

/// The length of the base path h names (see dir_ofd), and its bytes.
fn base_len(k: &Kernel, pid: u64, h: u64) -> u64
  requires kok(k) && pid < NPROC && h <= OFD_N
  ensures result <= FNAME_MAX
{
  if h == OFD_N {
    return smaller(wget(k.cwd, pid * CWD_STRIDE), FNAME_MAX);
  }
  return smaller(get(k.dpath, h * CWD_STRIDE), FNAME_MAX);
}

fn base_byte(k: &Kernel, pid: u64, h: u64, i: u64) -> u8
  requires kok(k) && pid < NPROC && h <= OFD_N && i < FNAME_MAX
{
  if h == OFD_N {
    return cast[u8](wget(k.cwd, pid * CWD_STRIDE + 1 + i) % 256);
  }
  return cast[u8](get(k.dpath, h * CWD_STRIDE + 1 + i) % 256);
}

/// The length of process pid's root if the name out[0..o] is inside it,
/// else 0 (a working directory left outside by chroot: ".." can climb
/// to the top from there, as on Linux).
fn root_under(k: &Kernel, pid: u64, out: &Bytes, o: u64) -> u64
  requires kok(k) && pid < NPROC && o <= blen(out)
  ensures result <= o && result <= FNAME_MAX
{
  let rl = root_len(k, pid);
  if rl == 0 || o < rl {
    return 0;
  }
  let mut i = 0;
  while i < rl
    invariant i <= rl && rl <= o && o <= blen(out) && rl <= FNAME_MAX && kok(k) && pid < NPROC
  {
    if cast[u64](bget(out, i)) != wget(k.croot, pid * CWD_STRIDE + 1 + i) % 256 {
      return 0;
    }
    i = i + 1;
  }
  if o > rl && bget(out, rl) != 47 {
    return 0;
  }
  return rl;
}

/// lx_path_in from base h (see dir_ofd), following symbolic links (the
/// last one too when `follow`).
fn lx_path_from(k: &mut Kernel, pid: u64, va: u64, h: u64, follow: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  k.perr = EFAULT;
  if va < USER_BASE || va >= USER_BASE + USER_SIZE {
    return NO_RESULT;
  }
  let n = smaller(PATH_MAX_LX, USER_SIZE - (va - USER_BASE));
  let mut want = smaller(PATH_FIRST, n);
  let mut got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, want);
  if got == NO_RESULT {
    return NO_RESULT;
  }
  let mut e = 0;
  while e < got && bget(k.fs.xfer, e) != 0
    invariant e <= got && got <= XFER && kok(k)
  {
    e = e + 1;
  }
  if e >= got && got == want && want < n {
    // Longer than the first read: read up to PATH_MAX.
    want = n;
    got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, want);
    if got == NO_RESULT {
      return NO_RESULT;
    }
    e = 0;
    while e < got && bget(k.fs.xfer, e) != 0
      invariant e <= got && got <= XFER && kok(k)
    {
      e = e + 1;
    }
  }
  if e >= got {
    if got == want {
      k.perr = ENAMETOOLONG;                // no NUL within PATH_MAX
    }
    return NO_RESULT;                       // or EFAULT: unmapped before the NUL
  }
  if e == 0 {
    k.perr = ENOENT;                        // "" names nothing, as on Linux
    return NO_RESULT;
  }
  return lx_path_xfer(&mut k, pid, e, h, follow);
}

/// lx_path_from for a path already in the transfer buffer, bytes 0..e: an
/// interpreter named by a script's "#!" line comes this way.
fn lx_path_xfer(k: &mut Kernel, pid: u64, e: u64, h: u64, follow: bool) -> u64
  requires kok(k) && pid < NPROC && 0 < e && e < XFER
  ensures kok(k)
  ensures result == NO_RESULT || result <= FNAME_MAX
{
  k.perr = ENAMETOOLONG;
  let trail = bget(k.fs.xfer, e - 1) == 47;  // "link/" names what the link points to, as on Linux
  // Build the name in `out`, starting from the working directory unless
  // the path starts at "/", which is the process's root (chroot). ".."
  // stops at `floor`: the root, for a name inside it.
  let mut out = balloc(PATH_OUT);
  let mut o = 0;
  let rl = root_len(k, pid);
  let mut floor = 0;
  if bget(k.fs.xfer, 0) == 47 {
    while o < rl
      invariant o <= rl && rl <= FNAME_MAX && blen(out) == PATH_OUT && kok(k) && pid < NPROC
    {
      bset(&mut out, o, cast[u8](wget(k.croot, pid * CWD_STRIDE + 1 + o) % 256));
      o = o + 1;
    }
    floor = rl;
  } else {
    if h > OFD_N {
      bfree(out);
      k.perr = EBADF;
      if h > OFD_N + 1 {
        k.perr = ENOTDIR;
      }
      return NO_RESULT;                     // relative to no directory
    }
    let cl = base_len(k, pid, h);
    while o < cl
      invariant o <= cl && cl <= FNAME_MAX && blen(out) == PATH_OUT && kok(k) && pid < NPROC && h <= OFD_N
    {
      bset(&mut out, o, base_byte(k, pid, h, o));
      o = o + 1;
    }
    floor = root_under(k, pid, out, o);
  }
  let mut i = 0;
  let mut ok = true;
  while ok && i < e
    invariant i <= e && e < XFER && o <= PATH_OUT && blen(out) == PATH_OUT && kok(k)
  {
    if bget(k.fs.xfer, i) == 47 {
      i = i + 1;
    } else {
      let mut j = i;
      while j < e && bget(k.fs.xfer, j) != 47
        invariant i <= j && j <= e && e < XFER && kok(k)
      {
        j = j + 1;
      }
      let w = j - i;
      if w == 1 && bget(k.fs.xfer, i) == 46 {
        // "." stays here
      } else if w == 2 && bget(k.fs.xfer, i) == 46 && bget(k.fs.xfer, i + 1) == 46 {
        // "..": drop the last part (the root's parent is the root)
        while o > floor && bget(out, o - 1) != 47
          invariant o <= PATH_OUT && blen(out) == PATH_OUT
        {
          o = o - 1;
        }
        if o > floor {
          o = o - 1;
        }
      } else if o + 1 + w > FNAME_MAX {
        ok = false;
      } else {
        if o > 0 {
          bset(&mut out, o, 47);
          o = o + 1;
        }
        let mut c = 0;
        while c < w
          invariant c <= w && i + w <= e && e < XFER && o + w <= PATH_OUT && blen(out) == PATH_OUT && kok(k)
        {
          bset(&mut out, o + c, bget(k.fs.xfer, i + c));
          c = c + 1;
        }
        o = o + w;
      }
      i = j;
    }
  }
  if !ok || o > FNAME_MAX {
    // Too long for the file layer. Walk what fits, so a loop of links
    // (ELOOP) or a missing directory (ENOENT) on the way is still reported
    // as Linux reports it.
    let mut c = 0;
    while c < o && c < FNAME_MAX
      invariant c <= o && blen(out) == PATH_OUT && kok(k)
    {
      bset(&mut k.fs.xfer, c, bget(out, c));
      c = c + 1;
    }
    bfree(out);
    if c > 0 && lx_follow(&mut k, c, true, smaller(floor, c)) == NO_RESULT {
      return NO_RESULT;                     // k.perr says why
    }
    k.perr = ENAMETOOLONG;
    return NO_RESULT;
  }
  let mut c = 0;
  while c < o
    invariant c <= o && o <= FNAME_MAX && blen(out) == PATH_OUT && kok(k)
  {
    bset(&mut k.fs.xfer, c, bget(out, c));
    c = c + 1;
  }
  bfree(out);
  let o2 = proc_self(&mut k.fs.xfer, o, pid);   // "proc/self" is the caller's /proc/PID
  return lx_follow(&mut k, o2, follow || trail, smaller(floor, o2));  // symbolic links (src/lxlink.bastio)
}

/// lseek: SEEK_SET (0), SEEK_CUR (1) and SEEK_END (2), with a signed
/// offset. Returns the new offset or -errno.
fn lx_lseek(k: &mut Kernel, pid: u64, fd: u64, off: u64, whence: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  if d.kind == K_BAD {
    return EBADF;
  }
  if d.kind == K_DEV && is_loop(d.x) {
    return loop_seek(&mut k, pid, fd, d.x, off, whence);
  }
  if d.kind == K_DEV {
    return 0;                               // other devices have no position
  }
  if d.kind == K_DIR {
    return dir_seek(&mut k, pid, fd, off, whence);   // src/lxdir.bastio
  }
  if d.kind != K_FILE {
    return ESPIPE;
  }
  let row = d.x;
  // SEEK_SET from 0, SEEK_CUR from the offset, SEEK_END from the size; off
  // is signed (two's complement).
  let mut base = 0;
  if whence == 1 {
    base = vfs_offset(k.fs, row);
  } else if whence == 2 {
    let size = vfs_size(&mut k.fs, vfs_row_file(k.fs, row));
    if size == NO_FILE {
      return EBADF;
    }
    base = size;
  } else if whence != 0 {
    return EINVAL;
  }
  let mut to = 0;
  if off < 0x8000000000000000 {
    if base > 0x7FFFFFFFFFFFFFFF - off {
      return EINVAL;
    }
    to = base + off;
  } else {
    let back = 0xFFFFFFFFFFFFFFFF - off + 1;
    if whence == 0 || back > base {
      return EINVAL;                        // before the start of the file
    }
    to = base - back;
  }
  if to >= 0x8000000000000000 {
    return EINVAL;
  }
  if !vfs_seek(&mut k.fs, row, to) {
    return EBADF;
  }
  return to;
}

// ---------------------------------------------------------------- memory

/// Maps fresh zero pages at window pages [from, to) of process pid, where
/// none is mapped yet. Returns false if memory ran out (the pages mapped so
/// far stay, and go back when the process exits).
fn lx_map_pages(m: &mut Mem, spaces: &mut Vec[Space], pid: u64, from: u64, to: u64, sh: bool) -> bool
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC && to <= WPAGES
  ensures mem_ok(m) && spaces_ok(spaces)
{
  match take_space(&mut spaces, pid) {
    Space::Empty => { return false; },
    Space::Mapped(mut root) => {
      let mut ok = false;
      if pt_has(root, 1) {
        ok = pt_borrow(&mut root, 1, map_l3, &mut m, from, to, sh);
      }
      put_space(&mut spaces, pid, Space::Mapped(root));
      return ok;
    },
  }
}

/// lx_map_pages below the top-level table, in place: other threads may be
/// running on the space, and the new pages appear to them as they are
/// mapped.
fn map_l3(l3: &mut PageTable, m: &mut Mem, from: u64, to: u64, sh: bool) -> bool
  requires pt_level(l3) == 3 && mem_ok(m) && to <= WPAGES
  ensures mem_ok(m)
{
  if !pt_has(l3, 0) {
    return false;
  }
  return pt_borrow(&mut l3, 0, map_l2, &mut m, from, to, sh);
}

fn map_l2(l2: &mut PageTable, m: &mut Mem, from: u64, to: u64, sh: bool) -> bool
  requires pt_level(l2) == 2 && mem_ok(m) && to <= WPAGES
  ensures mem_ok(m)
{
  let mut ok = true;
  let mut p = from;
  while ok && p < to
    invariant mem_ok(m) && pt_level(l2) == 2 && to <= WPAGES
  {
    ok = w_map(&mut m, &mut l2, p, sh);
    p = p + 1;
  }
  return ok;
}

/// The stack grows down as on Linux: its region is the top STACK_PAGES
/// pages of the window, and a new window maps only the top STACK_MAPPED.
/// Maps fresh zero pages from the one holding va up to the top, where none
/// is mapped yet. False if va is not in the part of the region a new window
/// leaves out, or memory ran out. Called with the stack pointer (less the
/// red zone) on each system call, so the kernel can reach a buffer the
/// program put on its stack without touching it, before a signal frame is
/// written, and on a page fault.
fn stack_reach(m: &mut Mem, spaces: &mut Vec[Space], pid: u64, va: u64) -> bool
  requires mem_ok(m) && spaces_ok(spaces) && pid < NPROC
  ensures mem_ok(m) && spaces_ok(spaces)
{
  if va < USER_BASE + STACK_FIRST * 4096 || va >= USER_BASE + STACK_LOW * 4096 {
    return false;
  }
  return lx_map_pages(&mut m, &mut spaces, pid, (va - USER_BASE) / 4096, WPAGES, false);
}

/// A page fault of process p: if it touched a stack page not mapped yet,
/// the stack grows to it (stack_reach) and true says to run p again.
fn stack_fault(k: &mut Kernel, p: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let va = pget(k.procs, p, F_REGS + 19);   // CR2
  if va < USER_BASE || copy_from_user(&mut k.spaces, &mut k.mem, k.anon, p, va, &mut k.fs.xfer, 1) == 1 {
    return false;                           // mapped: not a stack to grow
  }
  return stack_reach(&mut k.mem, &mut k.spaces, p, va);
}

/// brk: moves the heap's end to `want`, adding the pages it grows into
/// (mapped when first touched) and unmapping the pages it gives back; never below where it started,
/// and never into mmap's pages. Returns the break, as Linux does on
/// failure too.
fn lx_brk(k: &mut Kernel, pid: u64, want: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let cur = pget(k.procs, pid, F_BRK);
  let low = pget(k.procs, pid, F_MMAP);
  if cur > USER_SIZE || low > STACK_FIRST * 4096 {
    return USER_BASE;                       // not a Linux process
  }
  let start = smaller(pget(k.procs, pid, F_BRK0), cur);
  if want < USER_BASE + start || want > USER_BASE + low || want == USER_BASE + cur {
    return USER_BASE + cur;
  }
  let new = want - USER_BASE;
  if new < cur {
    // Shrinking: the pages wholly above the new break go.
    let from = (new + 4095) / 4096;
    let to = (cur + 4095) / 4096;
    if to <= WPAGES {
      anon_forget(&mut k, pid, from, to);
      win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, from, to, 0);
    }
    pset(&mut k.procs, pid, F_BRK, new);
    return want;
  }
  // The new pages come when first touched (src/lxanon.bastio), unless
  // every record is in use.
  let lo = (cur + 4095) / 4096;
  let hi = (new + 4095) / 4096;
  if !(lo < hi && anon_add(&mut k, pid, lo, hi)) && !lx_map_pages(&mut k.mem, &mut k.spaces, pid, lo, hi, false) {
    return USER_BASE + cur;
  }
  pset(&mut k.procs, pid, F_BRK, new);
  return want;
}

/// mmap: private memory, taken downward from the stack, or at addr with
/// MAP_FIXED. A file mapping is a copy of the file's bytes from `off` (the
/// rest of the last page zero), so writes to it never reach the file, even
/// with MAP_SHARED (they are written back at msync, munmap and exit). A
/// MAP_SHARED mapping, of a file or anonymous, is made of shared pages,
/// which fork maps in the child too instead of copying: parent and child
/// see each other's writes. A MAP_SHARED file mapping maps the page
/// cache's pages, so every process that maps the same part of the file
/// shares them too. The address hint without MAP_FIXED is ignored.
fn lx_mmap(k: &mut Kernel, pid: u64, addr: u64, n: u64, prot: u64, flags: u64, fd: u64, off: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  // In Linux's order: the offset, the descriptor, the length, the type.
  if off % 4096 != 0 {
    return EINVAL;
  }
  let mut anon = flags / MAP_ANONYMOUS % 2 == 1;
  if !anon {
    let z = fd_look(k, pid, fd);
    anon = z.kind == K_DEV && z.x == 2;     // /dev/zero (DEV_ZERO): fresh zero pages
  }
  let mut f = NO_FILE;
  let mut mode = 0;
  if !anon {
    let d = fd_look(k, pid, fd);
    if d.kind != K_FILE {
      return EBADF;
    }
    f = row_file(k.fs, d.x);
    if f == NO_FILE || d.x >= FD_ROWS {
      return EBADF;
    }
    mode = fget(k.fs.ftab, d.x, FD_MODE);
  }
  if n == 0 {
    return EINVAL;
  }
  if n > USER_SIZE {
    return ENOMEM;
  }
  let ty = flags % 16;                      // MAP_TYPE
  if ty != MAP_SHARED && ty != MAP_PRIVATE && ty != MAP_SHARED_VALIDATE {
    return EINVAL;
  }
  let sh = ty != MAP_PRIVATE;
  if ty == MAP_SHARED_VALIDATE && !anon && flags & !MAP_LEGACY_MASK != 0 {
    return EOPNOTSUPP;                      // a flag this kernel does not know
  }
  if flags & MAP_32BIT != 0 {
    return ENOMEM;                          // the window is far above 2 GiB: no room there
  }
  // As on Linux: a file is mapped only if it was opened for reading, and
  // a writable MAP_SHARED mapping only if for writing (and not O_APPEND).
  if !anon && (mode / O_READ % 2 == 0 || (sh && prot / 2 % 2 == 1 && (mode / O_WRITE % 2 == 0 || mode / O_APPEND % 2 == 1))) {
    return EACCES;
  }
  let can_write = mode / O_WRITE % 2 == 1;
  let pages = (n + 4095) / 4096;
  // A shared file mapping maps the page cache's pages (src/pcache.bastio)
  // instead of fresh ones, if the file was opened for writing. From a
  // descriptor that may only read, it gets a copy, as a private mapping
  // does: mprotect could make the mapping writable later, and a write to
  // the cache's page would reach every reader of the file
  // (docs/security.md). Such a copy does not see later writes to the file.
  let cached = sh && !anon && f != NO_FILE && can_write;
  // Private writable anonymous memory gets its pages when first touched
  // (src/lxanon.bastio), unless MAP_POPULATE or MAP_LOCKED asks for them
  // now.
  let lazy = anon && !sh && prot / 2 % 2 == 1 && flags & 0xA000 == 0;   // MAP_POPULATE, MAP_LOCKED
  let mut at = 0;
  let noreplace = flags & MAP_FIXED_NOREPLACE != 0;
  if flags / MAP_FIXED % 2 == 1 || noreplace {
    if addr % 4096 != 0 || addr < USER_BASE || addr - USER_BASE > STACK_FIRST * 4096 || pages > STACK_FIRST - (addr - USER_BASE) / 4096 {
      if noreplace && addr % 4096 == 0 {
        return ENOMEM;                      // outside the window: nothing can go there
      }
      return EINVAL;
    }
    at = addr - USER_BASE;
    // MAP_FIXED_NOREPLACE: any page mapped in the range is EEXIST. (A
    // PROT_NONE reservation maps nothing, so it is not seen.)
    if noreplace && anon_count(&mut k, pid, at / 4096, at / 4096 + pages) != 0 {
      return EEXIST;
    }
    // What was there goes, read-only pages too: the new mapping is writable.
    map_forget(&mut k, pid, at / 4096, at / 4096 + pages, false);
    win_op(&mut k.mem, &mut k.spaces, pid, WOP_UNMAP, at / 4096, at / 4096 + pages, 0);
    hole_cut(&mut k, pid, at / 4096, at / 4096 + pages);
    if !cached && !(lazy && anon_add(&mut k, pid, at / 4096, at / 4096 + pages)) && !lx_map_pages(&mut k.mem, &mut k.spaces, pid, at / 4096, at / 4096 + pages, sh) {
      return ENOMEM;
    }
  } else {
    let reserve = (anon && prot == 0) || cached;
    // A hole munmap left first (src/lxmem.bastio): its pages are unmapped.
    let h = hole_take(&mut k, pid, pages);
    if h < STACK_FIRST {
      if !reserve && !(lazy && anon_add(&mut k, pid, h, h + pages)) && !lx_map_pages(&mut k.mem, &mut k.spaces, pid, h, h + pages, sh) {
        hole_add(&mut k, pid, h, h + pages);
        return ENOMEM;
      }
      return lx_mmap_fill(&mut k, pid, h * 4096, pages, prot, flags, fd, off, anon, cached, f, sh);
    }
    let brk = pget(k.procs, pid, F_BRK);
    let low = pget(k.procs, pid, F_MMAP);
    if low > STACK_FIRST * 4096 || brk > low || pages * 4096 > low - brk {
      return ENOMEM;
    }
    at = (low - pages * 4096) / 4096 * 4096;
    if at < brk {
      return ENOMEM;
    }
    // Fresh PROT_NONE memory is only address space: its pages are mapped
    // when an mprotect makes them usable (lx_mprotect), and touching it
    // before that faults, as on Linux.
    if !reserve && !(lazy && anon_add(&mut k, pid, at / 4096, at / 4096 + pages)) && !lx_map_pages(&mut k.mem, &mut k.spaces, pid, at / 4096, low / 4096, sh) {
      return ENOMEM;
    }
    pset(&mut k.procs, pid, F_MMAP, at);
  }
  return lx_mmap_fill(&mut k, pid, at, pages, prot, flags, fd, off, anon, cached, f, sh);
}

/// The rest of mmap once window offset `at` has its pages (a `cached`
/// mapping gets the page cache's instead): a file's bytes copied in, the
/// mapping recorded if shared, and write access taken away without
/// PROT_WRITE.
fn lx_mmap_fill(k: &mut Kernel, pid: u64, at: u64, pages: u64, prot: u64, flags: u64, fd: u64, off: u64, anon: bool, cached: bool, f: u64, sh: bool) -> u64
  requires kok(k) && pid < NPROC && at <= USER_SIZE && pages <= WPAGES && off % 4096 == 0
  ensures kok(k)
{
  // Fresh pages are zero: only a file's bytes need copying in.
  if anon {
    if prot != 0 {
      read_only(&mut k, pid, at / 4096, pages, prot);
    }
    return USER_BASE + at;
  }
  if cached {
    if at / 4096 > WPAGES || pages > WPAGES - at / 4096 {
      return ENOMEM;
    }
    let r = lx_map_file_shared(&mut k, pid, at / 4096, pages, f, off);
    if r != 0 {
      return r;
    }
    map_record(&mut k, pid, fd, at / 4096, pages, off);
    read_only(&mut k, pid, at / 4096, pages, prot);
    return USER_BASE + at;
  }
  let total = pages * 4096;
  let mut done = 0;
  while done < total
    invariant done <= total && kok(k) && pid < NPROC
  {
    let step = smaller(XFER, total - done);
    let mut got = 0;
    if f != NO_FILE && off <= 0xFFFFFFFFFFFFFFFF - done {
      got = vfs_read_at(&mut k.fs, f, off + done, step);
      if got == NO_FD {
        got = 0;
      }
    }
    let mut z = got;
    while z < step
      invariant got <= z && z <= step && step <= XFER && kok(k)
    {
      bset(&mut k.fs.xfer, z, 0);
      z = z + 1;
    }
    if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, USER_BASE + at + done, k.fs.xfer, step) != step {
      return EFAULT;
    }
    done = done + step;
  }
  if sh {
    map_record(&mut k, pid, fd, at / 4096, pages, off);
  }
  read_only(&mut k, pid, at / 4096, pages, prot);
  return USER_BASE + at;
}

/// A new mapping without PROT_WRITE (2): its pages, from window page
/// `first` on, become read-only, so a write faults as on Linux.
fn read_only(k: &mut Kernel, pid: u64, first: u64, pages: u64, prot: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if prot / 2 % 2 == 0 && first <= WPAGES && pages <= WPAGES - first {
    win_op(&mut k.mem, &mut k.spaces, pid, WOP_PROTECT, first, first + pages, 0);
  }
}

/// The file layer's handle for the file open on native row `row`, or
/// NO_FILE.
fn row_file(v: &Vfs, row: u64) -> u64
  requires vfs_ok(v) && row < FD_ROWS
{
  let fs = fget(v.ftab, row, FD_FS);
  let node = fget(v.ftab, row, FD_NODE);
  if fs == FS_RAM && node < NFILES {
    return node;
  }
  if fs == FS_DISK && node < DSLOTS {
    return NFILES + node;
  }
  if fs == FS_LO && node < DSLOTS {
    return LO0 + node;
  }
  return NO_FILE;
}
