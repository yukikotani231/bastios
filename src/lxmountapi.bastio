// The new mount API: fsopen, fsconfig, fsmount and move_mount. A program
// that mounts with it opens a file system context (fsopen), sets its
// parameters (fsconfig), creates it (FSCONFIG_CMD_CREATE), turns it into a
// mount object (fsmount) and attaches that to a directory (move_mount).
//
// All three descriptors are one kind of open file description (OF_MNT),
// whose word 2 is the file system type (FST_*) + 8 * its stage + 64 * the
// mount flags it will have (the MS_* bits mount(2) takes), and whose word
// 3 is 0, or 1 + the source it was given (a disk image file and its loop
// device, or an ext image file): the stage is 0 while it is being
// configured, 1 once created, 2 for a mount object from fsmount and 3
// once move_mount attached it.
//
// Different from Linux: a mount object is not a detached mount tree of its
// own. The mount is made by move_mount, on the directory it names, with
// the same rules as mount(2) (src/lxmount.bastio): a tmpfs, a bstdisk3
// image or an ext image, the directory in memory and empty. A mount object
// can be attached once, and fsopen of another file system type (proc,
// sysfs, overlay, ...) is ENOSYS, so that a program falls back on mount(2); open_tree, fspick, mount_setattr and
// moving a mount that exists are not supported. The parameters a tmpfs
// takes (size, mode, uid, gid, nr_inodes) are accepted and, as for
// mount(2)'s data, not used.

import "lxmount.bastio";
import "lxevent.bastio";
import "lxprocfs.bastio";

const OF_MNT: u64 = 22;               // a file system context or a mount object: see above

const FSOPEN_CLOEXEC: u64 = 1;
const FSMOUNT_CLOEXEC: u64 = 1;
const FSCONFIG_SET_FLAG: u64 = 0;
const FSCONFIG_SET_STRING: u64 = 1;
const FSCONFIG_SET_BINARY: u64 = 2;
const FSCONFIG_SET_PATH: u64 = 3;
const FSCONFIG_SET_PATH_EMPTY: u64 = 4;
const FSCONFIG_SET_FD: u64 = 5;
const FSCONFIG_CMD_CREATE: u64 = 6;
const FSCONFIG_CMD_RECONFIGURE: u64 = 7;

const MOUNT_ATTR_RDONLY: u64 = 1;
const MOUNT_ATTR_NOSUID: u64 = 2;
const MOUNT_ATTR_NODEV: u64 = 4;
const MOUNT_ATTR_NOEXEC: u64 = 8;
const MOUNT_ATTR_ATIME: u64 = 0x70;   // the field: relatime (0), noatime (0x10), strictatime (0x20)
const MOUNT_ATTR_NOATIME: u64 = 0x10;
const MOUNT_ATTR_STRICTATIME: u64 = 0x20;
const MOUNT_ATTR_NODIRATIME: u64 = 0x80;
const MOUNT_ATTR_NOSYMFOLLOW: u64 = 0x200000;

const MOVE_MOUNT_EMPTY_PATH: u64 = 4;           // MOVE_MOUNT_F_EMPTY_PATH
const MOVE_MOUNT_T_EMPTY_PATH: u64 = 0x40;     // the target is the descriptor itself
const MOVE_MOUNT_OK: u64 = 0x377;               // F_SYMLINKS, F_AUTOMOUNTS, F_EMPTY_PATH, T_SYMLINKS, T_AUTOMOUNTS, T_EMPTY_PATH, SET_GROUP, BENEATH

const OPEN_TREE_CLONE: u64 = 1;
const OPEN_TREE_OK: u64 = 0x89901;   // CLONE, CLOEXEC, AT_EMPTY_PATH, AT_NO_AUTOMOUNT, AT_RECURSIVE, AT_SYMLINK_NOFOLLOW
const AT_EMPTY_PATH_FLAG: u64 = 0x1000;

const MNT_STAGES: u64 = 8;
const MNT_FLAGSHIFT: u64 = 64;

fn is_mountapi_call(n: u64) -> bool {
  return n == LX_STATMOUNT || n == LX_LISTMOUNT || n == LX_OPEN_TREE || n == LX_MOVE_MOUNT || n == LX_FSOPEN || n == LX_FSCONFIG || n == LX_FSMOUNT || n == LX_MOUNT_SETATTR;
}

/// Is the NUL-terminated string at user address va s (at most 16 bytes)?
fn key_is(k: &mut Kernel, pid: u64, va: u64, s: Str) -> bool
  requires kok(k) && pid < NPROC && va >= USER_BASE && va < USER_BASE + USER_SIZE - 17
  ensures kok(k)
{
  let l = slen(s);
  if l > 16 {
    return false;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, l + 1) != l + 1 {
    return false;
  }
  return xfer_is(k.fs.xfer, 0, l, s) && bget(k.fs.xfer, l) == 0;
}

/// Is the byte at user address va NUL: an empty string? False if it cannot
/// be read.
fn str_empty(k: &mut Kernel, pid: u64, va: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if va < USER_BASE || va >= USER_BASE + USER_SIZE - 1 {
    return false;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, 1) != 1 {
    return false;
  }
  return bget(k.fs.xfer, 0) == 0;
}

/// The mount(2) flags of mount attributes attrs (MOUNT_ATTR_*), or
/// NO_RESULT for an attribute that is not supported.
fn attr_flags(attrs: u64) -> u64
  ensures result == NO_RESULT || result < 8192
{
  let known = MOUNT_ATTR_RDONLY + MOUNT_ATTR_NOSUID + MOUNT_ATTR_NODEV + MOUNT_ATTR_NOEXEC
    + MOUNT_ATTR_ATIME + MOUNT_ATTR_NODIRATIME + MOUNT_ATTR_NOSYMFOLLOW;
  if attrs & !known != 0 {
    return NO_RESULT;
  }
  let at = attrs & MOUNT_ATTR_ATIME;
  if at != 0 && at != MOUNT_ATTR_NOATIME && at != MOUNT_ATTR_STRICTATIME {
    return NO_RESULT;
  }
  let mut f = 0;
  if attrs & MOUNT_ATTR_RDONLY != 0 {
    f = f + MS_RDONLY;
  }
  if attrs & MOUNT_ATTR_NOSUID != 0 {
    f = f + 2;
  }
  if attrs & MOUNT_ATTR_NODEV != 0 {
    f = f + 4;
  }
  if attrs & MOUNT_ATTR_NOEXEC != 0 {
    f = f + 8;
  }
  if at == MOUNT_ATTR_NOATIME {
    f = f + 1024;
  }
  if attrs & MOUNT_ATTR_NODIRATIME != 0 {
    f = f + 2048;
  }
  if attrs & MOUNT_ATTR_NOSYMFOLLOW != 0 {
    f = f + MS_NOSYMFOLLOW;
  }
  return f;
}

/// The description of descriptor fd if it is a file system context or a
/// mount object, else OFD_N.
fn mnt_desc(k: &Kernel, pid: u64, fd: u64) -> u64
  requires fds_ok(k) && pid < NPROC
  ensures result <= OFD_N
{
  let h = fd_ofd(k, pid, fd);
  if h < OFD_N && of_get(k.ofd, h, 0) == OF_MNT {
    return h;
  }
  return OFD_N;
}

/// fsopen(fsname, flags).
fn lx_fsopen(k: &mut Kernel, pid: u64, name: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & !FSOPEN_CLOEXEC != 0 {
    return EINVAL;
  }
  let t = fs_type(&mut k, pid, name);
  if t > FST_NS {
    return ENOSYS;                          // proc, overlay, ...: runtimes fall back on mount(2) for these
  }
  if t != FST_TMPFS && t != FST_BSTDISK && t != FST_EXT4 {
    return ENODEV;
  }
  return ev_install(&mut k, pid, OF_MNT, t, 0, flags & FSOPEN_CLOEXEC != 0);
}

/// fsconfig(fd, cmd, key, value, aux) on a context fd. The arguments of
/// each command are checked first, in Linux's order, then the descriptor.
fn lx_fsconfig(k: &mut Kernel, pid: u64, fd: u64, cmd: u64, key: u64, value: u64, aux: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let aux_neg = aux >= 0x80000000;          // a negative int
  if cmd == FSCONFIG_SET_FLAG {
    if key == 0 || value != 0 || aux != 0 {
      return EINVAL;
    }
  } else if cmd == FSCONFIG_SET_STRING {
    if key == 0 || value == 0 || aux != 0 {
      return EINVAL;
    }
  } else if cmd == FSCONFIG_SET_BINARY {
    if key == 0 || value == 0 || aux == 0 || aux > 1048576 {
      return EINVAL;
    }
  } else if cmd == FSCONFIG_SET_PATH || cmd == FSCONFIG_SET_PATH_EMPTY {
    if key == 0 || value == 0 || (aux != AT_FDCWD && aux_neg) {
      return EINVAL;
    }
  } else if cmd == FSCONFIG_SET_FD {
    if key == 0 || value != 0 || aux_neg {
      return EINVAL;
    }
  } else if cmd == FSCONFIG_CMD_CREATE || cmd == FSCONFIG_CMD_RECONFIGURE {
    if key != 0 || value != 0 || aux != 0 {
      return EINVAL;
    }
  } else {
    return EOPNOTSUPP;
  }
  if fd >= 0x80000000 {
    return EINVAL;                          // a negative descriptor
  }
  let h = mnt_desc(k, pid, fd);
  if h >= OFD_N {
    if fd_ofd(k, pid, fd) >= OFD_N {
      return EBADF;
    }
    return EINVAL;
  }
  let x = of_get(k.ofd, h, 2);
  let t = x % MNT_STAGES;
  let stage = x / MNT_STAGES % MNT_STAGES;
  let flags = x / MNT_FLAGSHIFT;
  if stage >= 2 {
    return EINVAL;                          // a mount object, not a context
  }
  if cmd == FSCONFIG_CMD_RECONFIGURE {
    return EOPNOTSUPP;
  }
  if cmd == FSCONFIG_CMD_CREATE {
    if stage != 0 {
      return EBUSY;
    }
    if t != FST_TMPFS && of_get(k.ofd, h, 3) == 0 {
      return EINVAL;                        // no source: "no device specified"
    }
    of_set(&mut k.ofd, h, 2, x + MNT_STAGES);
    return 0;
  }
  if stage != 0 {
    return EBUSY;                           // after FSCONFIG_CMD_CREATE
  }
  if cmd == FSCONFIG_SET_BINARY || cmd == FSCONFIG_SET_PATH || cmd == FSCONFIG_SET_PATH_EMPTY || cmd == FSCONFIG_SET_FD {
    return EOPNOTSUPP;                      // no parameter of these types
  }
  if key < USER_BASE || key >= USER_BASE + USER_SIZE - 17 {
    return EFAULT;
  }
  if cmd == FSCONFIG_SET_FLAG {
    if value != 0 {
      return EINVAL;
    }
    // The flag parameters of mount(8): each sets or clears one mount flag.
    let mut set = NO_RESULT;
    let mut bit = 0;
    if key_is(&mut k, pid, key, "ro") {
      set = 1;
      bit = MS_RDONLY;
    } else if key_is(&mut k, pid, key, "rw") {
      set = 0;
      bit = MS_RDONLY;
    } else if key_is(&mut k, pid, key, "nosuid") {
      set = 1;
      bit = 2;
    } else if key_is(&mut k, pid, key, "suid") {
      set = 0;
      bit = 2;
    } else if key_is(&mut k, pid, key, "nodev") {
      set = 1;
      bit = 4;
    } else if key_is(&mut k, pid, key, "dev") {
      set = 0;
      bit = 4;
    } else if key_is(&mut k, pid, key, "noexec") {
      set = 1;
      bit = 8;
    } else if key_is(&mut k, pid, key, "exec") {
      set = 0;
      bit = 8;
    } else if key_is(&mut k, pid, key, "noatime") {
      set = 1;
      bit = 1024;
    } else if key_is(&mut k, pid, key, "atime") {
      set = 0;
      bit = 1024;
    } else if key_is(&mut k, pid, key, "nodiratime") {
      set = 1;
      bit = 2048;
    } else if key_is(&mut k, pid, key, "diratime") {
      set = 0;
      bit = 2048;
    } else if key_is(&mut k, pid, key, "relatime") || key_is(&mut k, pid, key, "norelatime")
       || key_is(&mut k, pid, key, "strictatime") || key_is(&mut k, pid, key, "sync")
       || key_is(&mut k, pid, key, "async") {
      return 0;                             // kept as they are: nothing here depends on them
    } else if key_is(&mut k, pid, key, "nosymfollow") {
      set = 1;
      bit = MS_NOSYMFOLLOW;
    }
    if set == NO_RESULT {
      return EINVAL;                        // no such parameter
    }
    let mut nf = flags;
    if flags / bit % 2 == 1 && set == 0 {
      nf = flags - bit;
    }
    if flags / bit % 2 == 0 && set == 1 {
      nf = flags + bit;
    }
    of_set(&mut k.ofd, h, 2, t + MNT_STAGES * stage + MNT_FLAGSHIFT * nf);
    return 0;
  }
  if cmd != FSCONFIG_SET_STRING {
    return EINVAL;
  }
  if key_is(&mut k, pid, key, "source") {
    if value < USER_BASE || value >= USER_BASE + USER_SIZE - 9 {
      return EFAULT;
    }
    if t == FST_TMPFS {
      let w3 = of_get(k.ofd, h, 3);
      of_set(&mut k.ofd, h, 3, w3 - w3 % 2 + 1);   // any name: a tmpfs has no device
      return 0;
    }
    if t == FST_EXT4 {
      let e = ext_image(&mut k, pid, value);
      if e == NO_FILE {
        return k.perr;
      }
      of_set(&mut k.ofd, h, 3, sat_add(e, 1));
      return 0;
    }
    let ldev = source_loop(&mut k, pid, value);
    let img = image_file(&mut k, pid, value);
    if img >= NFILES {
      return k.perr;
    }
    if ldev > LO_NODEV {
      return EINVAL;
    }
    of_set(&mut k.ofd, h, 3, 1 + img * 256 + ldev);
    return 0;
  }
  if t == FST_TMPFS && key_is(&mut k, pid, key, "size") {
    // A tmpfs's size limit: kept in the pages of word 3 (twice them; its low bit says a source was set).
    if value < USER_BASE || value >= USER_BASE + USER_SIZE - 33 {
      return EFAULT;
    }
    let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, value, &mut k.fs.xfer, 32);
    if got == NO_RESULT {
      return EFAULT;
    }
    let mut e = 0;
    while e < 32 && bget(k.fs.xfer, e) != 0
      invariant e <= 32 && blen(k.fs.xfer) == XBUF && kok(k)
    {
      e = e + 1;
    }
    let sz = size_value(k, k.fs.xfer, 0, e);
    let w3 = of_get(k.ofd, h, 3);
    of_set(&mut k.ofd, h, 3, w3 % 2 + 2 * (sz / 4096));
    return 0;
  }
  if t == FST_TMPFS && (key_is(&mut k, pid, key, "size") || key_is(&mut k, pid, key, "mode")
     || key_is(&mut k, pid, key, "uid") || key_is(&mut k, pid, key, "gid")
     || key_is(&mut k, pid, key, "nr_inodes") || key_is(&mut k, pid, key, "nr_blocks")) {
    return 0;                               // accepted, not used (as mount(2)'s data)
  }
  return EINVAL;
}

/// fsmount(fd, flags, attrs): a mount object for the created context fd.
fn lx_fsmount(k: &mut Kernel, pid: u64, fd: u64, flags: u64, attrs: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & !FSMOUNT_CLOEXEC != 0 {
    return EINVAL;
  }
  let af = attr_flags(attrs);
  if af == NO_RESULT {
    return EINVAL;
  }
  let h = mnt_desc(k, pid, fd);
  if h >= OFD_N {
    if fd_ofd(k, pid, fd) >= OFD_N {
      return EBADF;
    }
    return EINVAL;
  }
  let x = of_get(k.ofd, h, 2);
  if x / MNT_STAGES % MNT_STAGES != 1 {
    return EINVAL;                          // not created yet, or already a mount object
  }
  let nf = (x / MNT_FLAGSHIFT % 8192) | af;
  return ev_install(&mut k, pid, OF_MNT, x % MNT_STAGES + MNT_STAGES * 2 + MNT_FLAGSHIFT * nf,
    of_get(k.ofd, h, 3), flags & FSMOUNT_CLOEXEC != 0);
}

/// move_mount(from_dfd, from_path, to_dfd, to_path, flags): attaches the
/// mount object from_dfd names (with MOVE_MOUNT_F_EMPTY_PATH and an empty
/// from_path) to the directory to_path names.
fn lx_move_mount(k: &mut Kernel, pid: u64, from_dfd: u64, from_path: u64, to_dfd: u64, to_path: u64, flags: u64, full: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & !MOVE_MOUNT_OK != 0 {
    return EINVAL;
  }
  if !str_empty(&mut k, pid, from_path) {
    return ENOENT;                          // a name below a mount object: there is none (and no mount that exists moves)
  }
  if flags & MOVE_MOUNT_EMPTY_PATH == 0 {
    return ENOENT;
  }
  let cd = dir_ofd(k, pid, from_dfd % 0x100000000);
  if cd < OFD_N && of_get(k.ofd, cd, OF_ACC) & ACC_CLONE != 0 {
    // A clone of a directory (open_tree): a bind mount of the directory it
    // names, made now.
    let mut tp = to_path;
    if flags & MOVE_MOUNT_T_EMPTY_PATH != 0 && str_empty(&mut k, pid, to_path) {
      tp = NO_RESULT;
    }
    let dl = dir_resolved(&mut k, pid, cd);
    if dl == NO_RESULT {
      return k.perr;
    }
    let r = ns_mount_at(&mut k, pid, 0, dl, to_dfd, tp, MK_BIND, st_to_ms(of_get(k.ofd, cd, OF_ACC) / 32 % 16384));
    if r == 0 {
      of_set(&mut k.ofd, cd, OF_ACC, ACC_PATH);   // attached: it is a handle again
    }
    return r;
  }
  let h = mnt_desc(k, pid, from_dfd % 0x100000000);
  if h >= OFD_N {
    if fd_ofd(k, pid, from_dfd % 0x100000000) >= OFD_N {
      return EBADF;
    }
    return EINVAL;
  }
  let x = of_get(k.ofd, h, 2);
  if x / MNT_STAGES % MNT_STAGES != 2 {
    return EINVAL;
  }
  let t = x % MNT_STAGES;
  let w = of_get(k.ofd, h, 3);
  let mut img = NFILES;
  let mut eimg = NO_FILE;
  let mut ldev = LO_NODEV;
  if t == FST_BSTDISK && w >= 1 {
    img = smaller((w - 1) / 256, NFILES);
    ldev = (w - 1) % 256;
  }
  if t == FST_EXT4 && w >= 1 {
    eimg = w - 1;
  }
  let n = lx_path_at(&mut k, pid, to_dfd, to_path);
  if n == NO_RESULT {
    return k.perr;
  }
  if t == FST_TMPFS {
    k.sys = set(k.sys, SYS_MNTSZ, smaller(w / 2, 0x100000000000) * 4096);   // the size= fsconfig kept
  }
  let r = mount_at(&mut k, pid, t, img, eimg, ldev, n, x / MNT_FLAGSHIFT, false, full);
  k.sys = set(k.sys, SYS_MNTSZ, 0);
  if r == 0 {
    of_set(&mut k.ofd, h, 2, x + MNT_STAGES);   // attached
  }
  return r;
}

/// The statfs flags (ST_*) of mount(2) flags f (MS_*): nosymfollow is the
/// one that differs.
fn ms_to_st(f: u64) -> u64
  ensures result < 16384
{
  return f % 16 + (f / 1024 % 4) * 1024 + (f / 256 % 2) * 8192;
}

/// The mount(2) flags of statfs flags s.
fn st_to_ms(s: u64) -> u64 {
  return s % 16 + (s / 1024 % 4) * 1024 + (s / 8192 % 2) * 256;
}

/// mount_setattr(dfd, path, flags, attr, size): changes the attributes of a
/// mount. On the clone of a directory open_tree made, they are kept for
/// move_mount; otherwise they are those of the mount the path is in, when
/// it is one of the namespace's own (a bind mount, proc, ...). A propagation
/// type is set as mount(2) sets it (AT_RECURSIVE: for the mounts below too);
/// an ID-mapped mount is ENOSYS.
fn lx_mount_setattr(k: &mut Kernel, pid: u64, dfd: u64, path: u64, flags: u64, uattr: u64, usize: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & !0x9900 != 0 {
    return EINVAL;                          // AT_EMPTY_PATH, AT_RECURSIVE, AT_SYMLINK_NOFOLLOW, AT_NO_AUTOMOUNT
  }
  if usize < 32 {
    return EINVAL;
  }
  if usize > 4096 {
    return E2BIG;
  }
  if uattr < USER_BASE || uattr >= USER_BASE + USER_SIZE - 32 {
    return EFAULT;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, uattr, &mut k.fs.xfer, 32) != 32 {
    return EFAULT;
  }
  let set = get_u64(k.fs.xfer, 0);
  let clr = get_u64(k.fs.xfer, 8);
  let prop = get_u64(k.fs.xfer, 16);
  let userns = get_u64(k.fs.xfer, 24);
  if set & 0x100000 != 0 || clr & 0x100000 != 0 || userns != 0 {
    return ENOSYS;                          // ID-mapped mounts
  }
  if prop != 0 && prop != 0x20000 && prop != 0x40000 && prop != 0x80000 && prop != 0x100000 {
    return EINVAL;
  }
  let sf = attr_flags(set);
  let mut clr2 = clr;
  let mut clrst = 0;
  if clr & MOUNT_ATTR_ATIME != 0 {
    clrst = 1024;                           // the atime field: back to relatime
    clr2 = clr - (clr & MOUNT_ATTR_ATIME);
  }
  let cf = attr_flags(clr2);
  if sf == NO_RESULT || cf == NO_RESULT || set & clr != 0 {
    return EINVAL;
  }
  let setst = ms_to_st(sf);
  clrst = (clrst | ms_to_st(cf)) % 16384;
  let empty = flags & AT_EMPTY_PATH_FLAG != 0 && str_empty(&mut k, pid, path);
  if empty {
    let h = dir_ofd(k, pid, dfd % 0x100000000);
    if h >= OFD_N {
      if fd_get(k.lxfd, pid, dfd % 0x100000000) == 0 {
        return EBADF;
      }
      return ENOTDIR;
    }
    let acc = of_get(k.ofd, h, OF_ACC);
    if acc & ACC_CLONE != 0 {
      let cur = acc / 32 % 16384;
      let nst = (cur & !clrst) | setst;
      of_set(&mut k.ofd, h, OF_ACC, acc % 32 + nst * 32);
      return 0;
    }
    // The directory the descriptor holds, looked up as a path.
    let pn = dir_resolved(&mut k, pid, h);
    if pn == NO_RESULT {
      return k.perr;
    }
    if prop != 0 {
      let pr = ns_prop_apply(&mut k, pid, pn, prop, flags & 0x8000 != 0);   // util-linux's mount --make-shared: open_tree, then this on the descriptor
      if pr != 0 {
        return pr;
      }
    }
    if setst == 0 && clrst == 0 {
      return 0;
    }
    return ns_set_attrs(&mut k, pid, setst, clrst);
  }
  let n = lx_path_at(&mut k, pid, dfd % 0x100000000, path);
  if n == NO_RESULT {
    return k.perr;
  }
  if prop != 0 {
    let pr = ns_prop_apply(&mut k, pid, n, prop, flags & 0x8000 != 0);
    if pr != 0 {
      return pr;
    }
  }
  if setst == 0 && clrst == 0 {
    return 0;
  }
  return ns_set_attrs(&mut k, pid, setst, clrst);
}

/// open_tree(dfd, path, flags): a handle (as O_PATH) for the path. A clone
/// of a directory (OPEN_TREE_CLONE) is the same handle marked ACC_CLONE:
/// move_mount binds the directory it names where the program says (a bind
/// is a view of the same files, which is what a non-recursive clone is).
/// A clone of a file, or a recursive one, answers ENOSYS once the arguments
/// are right and a program falls back to mount(2), as runc and crun do.
fn lx_open_tree(k: &mut Kernel, pid: u64, dfd: u64, path: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & !OPEN_TREE_OK != 0 {
    return EINVAL;
  }
  if flags & AT_EMPTY_PATH_FLAG != 0 && str_empty(&mut k, pid, path) {
    return ENOSYS;                          // a handle for the descriptor itself
  }
  let n = lx_path_at(&mut k, pid, dfd % 0x100000000, path);
  if n == NO_RESULT {
    return k.perr;
  }
  let there = path_meta(&mut k, n);
  if vfs_lookup(&mut k.fs, n) == NO_FILE && dir_at(&mut k, n) == NO_FILE && !there.ok {
    return ENOENT;
  }
  if flags & OPEN_TREE_CLONE != 0 && dir_at(&mut k, n) == NO_FILE {
    return ENOSYS;                          // a copy of a file's mount: not supported
  }
  let n2 = lx_path_at(&mut k, pid, dfd % 0x100000000, path);   // path_meta may have used the transfer buffer
  if n2 == NO_RESULT {
    return k.perr;
  }
  let fd = lx_open_n(&mut k, pid, n2, LO_PATH | (flags & LO_CLOEXEC), 0);
  if flags & OPEN_TREE_CLONE != 0 && fd < LXNFD {
    let ho = fd_ofd(k, pid, fd);
    if ho < OFD_N {
      of_set(&mut k.ofd, ho, OF_ACC, ACC_PATH | ACC_CLONE);
    }
  }
  return fd;
}

// statmount and listmount describe the mounts of the caller's namespace from
// the lines of its /proc/PID/mountinfo, so a mount's id is the id that file
// shows (a position in the table, not stable across mounts and unmounts as
// Linux's 64-bit ids are). Different from Linux: the tree is flat (every mount
// other than the first has the first as its parent), a mount's root is "/"
// and its device numbers are made up, as mountinfo shows them.

const LSMT_ROOT: u64 = 18446744073709551615;
const STATMOUNT_SB_BASIC: u64 = 1;
const STATMOUNT_MNT_BASIC: u64 = 2;
const STATMOUNT_MNT_ROOT: u64 = 8;
const STATMOUNT_MNT_POINT: u64 = 0x10;
const STATMOUNT_FS_TYPE: u64 = 0x20;
const STATMOUNT_SUPPORTED: u64 = 0x3b;
const STATMOUNT_HDR: u64 = 512;           // sizeof(struct statmount): the strings follow

/// The decimal number in t[s..e), or NO_RESULT if there is none or it is long.
fn dec_span(t: &Bytes, s: u64, e: u64, n: u64) -> u64
  requires blen(t) == PROC_OUT && s <= e && e <= n && n <= PROC_OUT
{
  if e == s || e - s > 12 {
    return NO_RESULT;
  }
  let mut v = 0;
  let mut j = s;
  while j < e
    invariant j >= s && j <= e && e <= n && n <= PROC_OUT && blen(t) == PROC_OUT && v < 1000000000000
  {
    let c = bget(t, j);
    if c < 48 || c > 57 {
      return NO_RESULT;
    }
    if v > 99999999999 {
      return NO_RESULT;
    }
    v = v * 10 + cast[u64](c - 48);
    j = j + 1;
  }
  return v;
}

/// The start of the line of t[0..n) whose first field is the number id, or n.
fn mi_line(t: &Bytes, n: u64, id: u64) -> u64
  requires blen(t) == PROC_OUT && n <= PROC_OUT
  ensures result <= n
{
  let mut i = 0;
  while i < n
    invariant i <= n && n <= PROC_OUT && blen(t) == PROC_OUT
  {
    let e = tok_end(t, i, n);
    if dec_span(t, i, e, n) == id {
      return i;
    }
    let mut j = e;
    while j < n && bget(t, j) != 10
      invariant j >= e && j <= n && n <= PROC_OUT && blen(t) == PROC_OUT
    {
      j = j + 1;
    }
    i = smaller(j + 1, n);
    if j >= n {
      i = n;
    }
  }
  return n;
}

/// The start of field idx of the line starting at ls, or n if the line has
/// fewer fields.
fn mi_field(t: &Bytes, n: u64, ls: u64, idx: u64) -> u64
  requires blen(t) == PROC_OUT && n <= PROC_OUT && ls <= n
  ensures result <= n
{
  let mut j = ls;
  let mut c = 0;
  while c < idx
    invariant j >= ls && j <= n && n <= PROC_OUT && blen(t) == PROC_OUT && c <= idx
  {
    if j >= n || bget(t, j) == 10 {
      return n;
    }
    j = tok_end(t, j, n);
    if j < n && bget(t, j) == 32 {
      j = j + 1;
    }
    c = c + 1;
  }
  if j < n && bget(t, j) == 10 {
    return n;
  }
  return j;
}

/// The MOUNT_ATTR_* bits of the comma-separated options t[s..e).
fn mi_attrs(t: &Bytes, s: u64, e: u64, n: u64) -> u64
  requires blen(t) == PROC_OUT && s <= e && e <= n && n <= PROC_OUT
{
  let mut a = 0;
  if e >= s + 2 && bget(t, s) == 114 && bget(t, s + 1) == 111 {
    a = MOUNT_ATTR_RDONLY;                  // "ro"
  }
  let mut i = s;
  while i < e
    invariant i >= s && i <= e && e <= n && n <= PROC_OUT && blen(t) == PROC_OUT
  {
    let mut j = i;
    while j < e && bget(t, j) != 44
      invariant j >= i && j <= e && e <= n && n <= PROC_OUT && blen(t) == PROC_OUT
    {
      j = j + 1;
    }
    if j - i >= 3 && bget(t, i) == 110 && bget(t, i + 1) == 111 {
      let c = bget(t, i + 2);
      if j - i == 6 && c == 115 {
        a = a | MOUNT_ATTR_NOSUID;
      }
      if j - i == 5 && c == 100 {
        a = a | MOUNT_ATTR_NODEV;
      }
      if j - i == 6 && c == 101 {
        a = a | MOUNT_ATTR_NOEXEC;
      }
      if j - i == 7 && c == 97 {
        a = a | MOUNT_ATTR_NOATIME;
      }
    }
    if j < e {
      i = j + 1;
    } else {
      i = e;
    }
  }
  return a;
}

/// The offset from str[] of the byte at a, which follows the header.
fn str_off(a: u64) -> u64
  ensures result <= PROC_OUT
{
  if a >= STATMOUNT_HDR && a <= PROC_OUT {
    return a - STATMOUNT_HDR;
  }
  return 0;
}

/// statmount(req, buf, bufsize, flags): what the mount named by req.mnt_id
/// is, for the fields req.param asks for that are known (the others are left
/// out of the mask it returns).
fn lx_statmount(k: &mut Kernel, pid: u64, ureq: u64, ubuf: u64, bufsize: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags != 0 {
    return EINVAL;
  }
  if bufsize < STATMOUNT_HDR {
    return EOVERFLOW;
  }
  if ureq < USER_BASE || ureq >= USER_BASE + USER_SIZE - 32 {
    return EFAULT;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, ureq, &mut k.fs.xfer, 24) != 24 {
    return EFAULT;
  }
  if rd64(k.fs.xfer, 0) % 0x100000000 < 24 {
    return EINVAL;
  }
  let id = get_u64(k.fs.xfer, 8);
  let want = get_u64(k.fs.xfer, 16) & STATMOUNT_SUPPORTED;
  let mut t = balloc(PROC_OUT);
  let n = smaller(mountinfo_text(&mut k, pid, &mut t), PROC_OUT);
  let ls = mi_line(t, n, id);
  if ls >= n {
    bfree(t);
    return ENOENT;
  }
  let fpar = mi_field(t, n, ls, 1);
  let fmp = mi_field(t, n, ls, 4);
  let fop = mi_field(t, n, ls, 5);
  let mut fd = mi_field(t, n, ls, 6);          // the optional fields, up to the "-"
  let mut peer = 0;
  let mut mst = 0;
  let mut prop = 0x40000;                      // MS_PRIVATE
  let mut guard = 0;
  while fd < n && bget(t, fd) != 45 && guard < 8
    invariant fd <= n && n <= PROC_OUT && blen(t) == PROC_OUT && guard <= 8
  {
    let fe = tok_end(t, fd, n);
    let mut colon = fd;
    while colon < fe && bget(t, colon) != 58
      invariant colon >= fd && colon <= fe && fe <= n && n <= PROC_OUT && blen(t) == PROC_OUT
    {
      colon = colon + 1;
    }
    let v = dec_span(t, smaller(colon + 1, fe), fe, n);
    if colon - fd == 6 && bget(t, fd) == 115 && v != NO_RESULT {
      peer = v;                                // shared:N
      prop = 0x100000;
    }
    if colon - fd == 6 && bget(t, fd) == 109 && v != NO_RESULT {
      mst = v;                                 // master:N
      if prop == 0x40000 {
        prop = 0x80000;
      }
    }
    if fe - fd == 10 && bget(t, fd) == 117 {
      prop = 0x20000;                          // unbindable
    }
    fd = smaller(fe + 1, n);
    guard = guard + 1;
  }
  let fdash = fd;
  let mut ftype = n;
  if fdash < n {
    ftype = smaller(tok_end(t, fdash, n) + 1, n);
  }
  let fpe = tok_end(t, fpar, n);
  let fme = tok_end(t, fmp, n);
  let foe = tok_end(t, fop, n);
  let fte = tok_end(t, ftype, n);
  let parent = dec_span(t, fpar, fpe, n);
  let attrs = mi_attrs(t, fop, foe, n);
  // The magic number of the file system types the kernel has.
  let mut magic = 0;
  if fte - ftype == 5 && bget(t, ftype) == 116 {
    magic = 0x01021994;                        // tmpfs
  }
  if fte - ftype == 4 && bget(t, ftype) == 101 {
    magic = 0xEF53;                            // ext4
  }
  if fte - ftype == 4 && bget(t, ftype) == 112 {
    magic = 0x9fa0;                            // proc
  }
  let mut r = balloc(PROC_OUT);
  zero(&mut r, 0, PROC_OUT);
  put_u64(&mut r, 8, want);
  if want & STATMOUNT_SB_BASIC != 0 {
    put_u64(&mut r, 16, (id % 0x100000000) * 0x100000000);     // major 0 (offset 16), minor (offset 20)
    put_u64(&mut r, 24, magic);
    if attrs & MOUNT_ATTR_RDONLY != 0 {
      put_u64(&mut r, 32, 1);                  // sb_flags: SB_RDONLY (fs_type at 36 stays 0 here)
    }
  }
  if want & STATMOUNT_MNT_BASIC != 0 {
    put_u64(&mut r, 40, id);
    put_u64(&mut r, 48, parent);
    put_u64(&mut r, 56, id % 0x100000000 + (parent % 0x100000000) * 0x100000000);   // the old 32-bit ids
    put_u64(&mut r, 64, attrs);
    put_u64(&mut r, 72, prop);
    put_u64(&mut r, 80, peer);
    put_u64(&mut r, 88, mst);
  }
  let mut a = STATMOUNT_HDR;
  if want & STATMOUNT_MNT_ROOT != 0 {
    put_u64(&mut r, 104, str_off(a));   // mnt_root (low half; mnt_point is the high half); offsets are from str[]
    a = put_s(&mut r, a, "/");
    a = put_c(&mut r, a, 0);
  }
  if want & STATMOUNT_MNT_POINT != 0 {
    let sp = str_off(a);
    a = put_span(&mut r, a, t, fmp, fme, n);
    a = put_c(&mut r, a, 0);
    put_u64(&mut r, 104, get_u64(r, 104) % 0x100000000 + sp * 0x100000000);
  }
  if want & STATMOUNT_FS_TYPE != 0 {
    let sp = str_off(a);
    a = put_span(&mut r, a, t, ftype, fte, n);
    a = put_c(&mut r, a, 0);
    put_u64(&mut r, 32, get_u64(r, 32) % 0x100000000 + sp * 0x100000000);   // fs_type (offset 36) is the high half
  }
  put_u64(&mut r, 0, a);                       // size (low half), the spare after it is 0
  bfree(t);
  if a > bufsize {
    bfree(r);
    return EOVERFLOW;
  }
  let w = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, ubuf, r, a);
  bfree(r);
  if w != a {
    return EFAULT;
  }
  return 0;
}

/// listmount(req, mnt_ids, nr_mnt_ids, flags): the ids of the mounts under
/// req.mnt_id (LSMT_ROOT: all), the ones after req.param, as many as fit.
fn lx_listmount(k: &mut Kernel, pid: u64, ureq: u64, uids: u64, nr: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags & !1 != 0 {
    return EINVAL;
  }
  if ureq < USER_BASE || ureq >= USER_BASE + USER_SIZE - 32 {
    return EFAULT;
  }
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, ureq, &mut k.fs.xfer, 24) != 24 {
    return EFAULT;
  }
  if rd64(k.fs.xfer, 0) % 0x100000000 < 24 {
    return EINVAL;
  }
  let under = get_u64(k.fs.xfer, 8);
  let last = get_u64(k.fs.xfer, 16);
  if nr == 0 || nr > 1024 {
    if nr == 0 {
      return 0;
    }
    return EOVERFLOW;
  }
  if uids < USER_BASE || uids >= USER_BASE + USER_SIZE || 8 * nr > USER_BASE + USER_SIZE - uids {
    return EFAULT;
  }
  let mut t = balloc(PROC_OUT);
  let n = smaller(mountinfo_text(&mut k, pid, &mut t), PROC_OUT);
  let mut ids = balloc(8 * nr);
  let mut cnt = 0;
  let mut id = 1;
  while id < 100 && cnt < nr
    invariant id >= 1 && id <= 100 && cnt <= nr && blen(ids) == 8 * nr && n <= PROC_OUT && blen(t) == PROC_OUT && kok(k)
  {
    let mut cur = id;
    if flags & 1 != 0 {
      cur = 100 - id;                          // newest first
    }
    let ls = mi_line(t, n, cur);
    if ls < n {
      let fpe = mi_field(t, n, ls, 1);
      let parent = dec_span(t, fpe, tok_end(t, fpe, n), n);
      let mut take = under == LSMT_ROOT || parent == under;
      if flags & 1 == 0 && last != 0 && cur <= last {
        take = false;
      }
      if flags & 1 != 0 && last != 0 && cur >= last {
        take = false;
      }
      if take {
        put_u64(&mut ids, 8 * cnt, cur);
        cnt = cnt + 1;
      }
    }
    id = id + 1;
  }
  bfree(t);
  let w = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, uids, ids, 8 * cnt);
  bfree(ids);
  if w != 8 * cnt {
    return EFAULT;
  }
  return cnt;
}

/// The new mount API's calls; full says whether the caller may change the
/// machine's mounts, as for mount(2). fsconfig's key is the third
/// argument, its value the fourth (r10).
fn lx_mountapi_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64, full: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r10 = pget(k.procs, pid, F_REGS + R_R10);
  if n == LX_STATMOUNT {
    return lx_statmount(&mut k, pid, a, b, c, r10);
  }
  if n == LX_LISTMOUNT {
    return lx_listmount(&mut k, pid, a, b, c, r10);
  }
  if n == LX_OPEN_TREE {
    return lx_open_tree(&mut k, pid, a, b, c % 0x100000000);
  }
  if n == LX_MOUNT_SETATTR {
    return lx_mount_setattr(&mut k, pid, a, b, c, r10, pget(k.procs, pid, F_REGS + R_R8));
  }
  if n == LX_FSOPEN {
    return lx_fsopen(&mut k, pid, a, b);
  }
  if n == LX_FSCONFIG {
    return lx_fsconfig(&mut k, pid, a % 0x100000000, b % 0x100000000, c, r10, pget(k.procs, pid, F_REGS + R_R8) % 0x100000000);
  }
  if n == LX_FSMOUNT {
    return lx_fsmount(&mut k, pid, a % 0x100000000, b % 0x100000000, c % 0x100000000);
  }
  let r = lx_move_mount(&mut k, pid, a, b, c, r10, pget(k.procs, pid, F_REGS + R_R8) % 0x100000000, full);
  if r == 0 {
    k.sys = set(k.sys, SYS_MNTEV, sat_add(get(k.sys, SYS_MNTEV), 1));   // wakes pollers of /proc/mounts
  }
  return r;
}
