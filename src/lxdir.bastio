// Directories for Linux programs: listing them (getdents64), the working
// directory (chdir, getcwd), mkdir, rmdir and unlink. "/" holds "bin" and
// the file layer's top directory; "/bin" holds the built-in programs and
// BusyBox's applets; every other directory is the file layer's
// (vfs_dir_lookup, vfs_readdir) but "/proc" (src/lxprocfs.bastio). A
// directory description's x is DIR_ROOT, DIR_BIN, DIR_VFS + the file
// layer's handle or DIR_PROC (+ a pid), and word 3 the index of the next
// entry.

import "linux.bastio";

const LX_CHDIR: u64 = 80;
const LX_CHROOT: u64 = 161;
const LX_FCHDIR: u64 = 81;
const LX_MKDIR: u64 = 83;
const LX_RMDIR: u64 = 84;
const LX_MKDIRAT: u64 = 258;
const ENOTEMPTY: u64 = 18446744073709551577;  // 2^64 - 39
const EXDEV: u64 = 18446744073709551598;      // 2^64 - 18
const LX_RENAME: u64 = 82;
const LX_RENAMEAT: u64 = 264;
const LX_RENAMEAT2: u64 = 316;
const RENAME_NOREPLACE: u64 = 1;
const RENAME_EXCHANGE: u64 = 2;
const DT_FIFO: u64 = 1;
const DT_CHR: u64 = 2;
const DT_DIR: u64 = 4;
const DT_BLK: u64 = 6;
const DT_REG: u64 = 8;
const DT_LNK: u64 = 10;
const DT_SOCK: u64 = 12;
const DENT_HDR: u64 = 19;             // d_ino, d_off, d_reclen, d_type

// One entry: its name is in the transfer buffer.
struct Ent { len: u64, dir: bool, end: bool }

/// Entry `i` of directory `dir`, its name copied into the start of the
/// transfer buffer. len 0 is an unused slot; `end` is past the last.
fn dir_entry(k: &mut Kernel, pid: u64, dir: u64, i: u64) -> Ent
  requires kok(k) && pid < NPROC
  ensures kok(k) && result.len <= XBUF
{
  if dir == DIR_ROOT {
    if i == 0 {
      return Ent { len: name_out(&mut k.fs.xfer, "bin"), dir: true, end: false };
    }
    if i == 1 {
      return Ent { len: name_out(&mut k.fs.xfer, "proc"), dir: true, end: false };
    }
    return vfs_entry(&mut k, VDIR_ROOT, i - 2);
  }
  if dir >= DIR_CG {
    if dir - DIR_CG >= CG_N {
      return Ent { len: 0, dir: false, end: true };
    }
    return cg_entry(&mut k, dir - DIR_CG, i);
  }
  if dir >= DIR_PROC {
    return proc_entry(&mut k, pid, dir, i);
  }
  if dir >= DIR_VFS {
    return vfs_entry(&mut k, dir - DIR_VFS, i);
  }
  if i < NPROGS {
    return Ent { len: name_out(&mut k.fs.xfer, prog_name(i)), dir: false, end: false };
  }
  if i - NPROGS < NAPPLETS {
    return Ent { len: name_out(&mut k.fs.xfer, applet_name(i - NPROGS)), dir: false, end: false };
  }
  return Ent { len: 0, dir: false, end: true };
}

/// How many entries after the one at index i of directory dir (which
/// dir_entry found to hold nothing) hold nothing as well: the disk's
/// directories are listed by asking about every slot, and almost all of them
/// belong to other directories.
fn dir_gap(k: &mut Kernel, dir: u64, i: u64) -> u64
  requires kok(k) && i < 0xFFFFFFFF
  ensures kok(k) && result <= DSLOTS
{
  if dir >= DIR_VFS && dir < DIR_PROC {
    let from = i + 1;
    let j = vfs_skip(&mut k.fs, dir - DIR_VFS, from);
    return j - from;
  }
  return 0;
}

/// Entry i of the file layer's directory d.
fn vfs_entry(k: &mut Kernel, d: u64, i: u64) -> Ent
  requires kok(k)
  ensures kok(k) && result.len <= XBUF
{
  let n = vfs_readdir(&mut k.fs, d, i);
  if n == NO_FILE {
    return Ent { len: 0, dir: false, end: true };
  }
  if n == 0 {
    return Ent { len: 0, dir: false, end: false };
  }
  return Ent { len: n, dir: vfs_is_dir(&mut k.fs, vfs_child(d, i)), end: false };
}

// What getdents64 reports for an entry: d_type and d_ino.
struct Dt { typ: u64, ino: u64 }

/// d_type and d_ino of entry i of directory dir (which dir_entry found):
/// for the file layer's entries the type of the entry itself (a symbolic
/// link is DT_LNK, not what it points to) and the inode number stat
/// reports for it, so scandir's is_dir and inode agree with stat.
fn ent_dt(k: &mut Kernel, dir: u64, i: u64, e: Ent) -> Dt
  requires kok(k) && i < 0x100000000
  ensures kok(k)
{
  let mut fallback = DT_REG;
  if e.dir {
    fallback = DT_DIR;
  }
  let mut d = NO_FILE;
  let mut j = i;
  if dir == DIR_ROOT && i >= 2 {
    d = VDIR_ROOT;
    j = i - 2;
  } else if dir >= DIR_VFS && dir < DIR_PROC {
    d = dir - DIR_VFS;
  } else if dir == DIR_BIN && i < NPROGS {
    return Dt { typ: DT_REG, ino: INO_PROGS + i };
  }
  if d == NO_FILE {
    return Dt { typ: fallback, ino: i + 1 };
  }
  let c = vfs_child(d, j);
  if c == NO_FILE {
    return Dt { typ: fallback, ino: i + 1 };
  }
  let fm = vfs_meta(&mut k.fs, c);
  let t = fm.mode % 65536 / 4096 * 4096;
  let f = vfs_target(&mut k.fs, c);
  if fm.ok && t == T_LINK {
    return Dt { typ: DT_LNK, ino: sat_add(INO_FILES, f) };
  }
  if e.dir {
    return Dt { typ: DT_DIR, ino: sat_add(1 + DIR_VFS, c) };
  }
  let mut typ = DT_REG;
  if fm.ok && t == T_FIFO {
    typ = DT_FIFO;
  } else if fm.ok && t == T_SOCK {
    typ = DT_SOCK;
  } else if fm.ok && t == T_CHR {
    typ = DT_CHR;
  } else if fm.ok && t == T_BLK {
    typ = DT_BLK;
  }
  if f >= HFILES {
    return Dt { typ: typ, ino: i + 1 };
  }
  return Dt { typ: typ, ino: INO_FILES + f };
}

/// Copies `name` (up to FNAME_MAX bytes) into the start of x.
fn name_out(x: &mut Bytes, name: Str) -> u64
  requires blen(x) == XBUF
  ensures blen(x) == XBUF && result <= FNAME_MAX
{
  let n = smaller(slen(name), FNAME_MAX);
  let mut i = 0;
  while i < n
    invariant i <= n && n <= FNAME_MAX && blen(x) == XBUF
  {
    bset(&mut x, i, sget(name, i));
    i = i + 1;
  }
  return n;
}

/// getdents64(fd, buf, count): as many struct linux_dirent64 records as
/// fit in count bytes (and DENT_BUF), from where the last call stopped.
/// Returns the bytes filled, 0 at the end, or -errno. With `legacy`, the
/// old getdents's struct linux_dirent instead: the same size, with the
/// name a byte earlier and d_type in the record's last byte.
fn lx_getdents(k: &mut Kernel, pid: u64, fd: u64, va: u64, count: u64, legacy: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  if v < FD_OFD || v - FD_OFD >= OFD_N {
    if v == FD_CONSOLE {
      return ENOTDIR;
    }
    return EBADF;
  }
  let h = v - FD_OFD;
  if of_get(k.ofd, h, 0) != OF_DIR {
    return ENOTDIR;
  }
  let dir = of_get(k.ofd, h, 2);
  if dir >= DIR_VFS && dir < DIR_PROC && !vfs_is_dir(&mut k.fs, dir - DIR_VFS) {
    return ENOENT;                          // removed while open
  }
  let mut ovp = balloc(PATH_OUT);
  let ov = ovl_rest(&mut k, pid, h, &mut ovp);   // in an overlay mount: its layers merged (src/lxns.bastio)
  let cap = smaller(count, DENT_BUF);
  let mut out = balloc(DENT_BUF);
  let mut used = 0;
  let mut i = of_get(k.ofd, h, 3);
  let mut more = true;
  let mut full = false;
  while more && i < 0x100000000
    invariant used <= cap && cap <= DENT_BUF && blen(out) == DENT_BUF && kok(k)
  {
    // Positions 0 and 1 are "." and "..", as on Linux; the directory's
    // own entries follow.
    let mut e = Ent { len: 0, dir: true, end: false };
    let mut nx = i + 1;                   // where the entry after this one is
    if i < 2 {
      bset(&mut k.fs.xfer, 0, 46);
      bset(&mut k.fs.xfer, 1, 46);
      e = Ent { len: i + 1, dir: true, end: false };
    } else if ov != NO_RESULT {
      e = ovl_dir_entry(&mut k, pid, ov / 4096, &mut ovp, ov % 4096, i - 2);
      nx = ovl_after(k, i);
    } else {
      e = dir_entry(&mut k, pid, dir, i - 2);
      if e.len == 0 && !e.end {
        nx = i + 1 + dir_gap(&mut k, dir, i - 2);
      }
    }
    if e.end {
      more = false;
    } else if e.len == 0 {
      i = nx;
    } else {
      // The record: header, name, NUL, padded to 8 bytes.
      let reclen = (DENT_HDR + e.len + 1 + 7) / 8 * 8;
      if reclen > cap - used {
        more = false;
        full = true;
      } else {
        let mut z = 0;
        while z < reclen
          invariant z <= reclen && used + reclen <= cap && cap <= DENT_BUF && blen(out) == DENT_BUF
        {
          bset(&mut out, used + z, 0);
          z = z + 1;
        }
        xfer_u64(&mut out, used + 8, nx);             // d_off: the next entry
        bset(&mut out, used + 16, cast[u8](reclen % 256));      // d_reclen
        bset(&mut out, used + 17, cast[u8](reclen / 256 % 256));
        let mut at = used + 18;               // d_type
        let mut name = DENT_HDR;
        if legacy {
          at = used + reclen - 1;
          name = DENT_HDR - 1;
        }
        let mut j = 0;
        while j < e.len
          invariant j <= e.len && e.len <= XBUF && DENT_HDR + e.len < reclen && name <= DENT_HDR
          invariant used + reclen <= cap && cap <= DENT_BUF && blen(out) == DENT_BUF && kok(k)
        {
          bset(&mut out, used + name + j, bget(k.fs.xfer, j));
          j = j + 1;
        }
        // After the name: ent_dt may use k.fs.xfer. "." and ".." are directories.
        let mut dt = Dt { typ: DT_DIR, ino: sat_add(1, dir) };
        if i >= 2 && ov != NO_RESULT {
          dt = ent_dt(&mut k, ovl_last_dir(k), ovl_last_idx(k), e);
        } else if i >= 2 {
          dt = ent_dt(&mut k, dir, i - 2, e);
        }
        xfer_u64(&mut out, used, dt.ino);             // d_ino
        bset(&mut out, at, cast[u8](dt.typ % 256));
        used = used + reclen;
        i = nx;
      }
    }
  }
  bfree(ovp);
  if used == 0 && full {
    bfree(out);
    return EINVAL;                          // not even one entry fits
  }
  let put = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, out, used);
  bfree(out);
  if put != used {
    return EFAULT;
  }
  of_set(&mut k.ofd, h, 3, i);
  return used;
}

/// lseek on a directory: the position is getdents's, the count of entries
/// already read ("." and ".." included). SEEK_SET and SEEK_CUR move it, as
/// rewinddir, seekdir and telldir need; SEEK_END is EINVAL, as on Linux's
/// in-memory file systems.
fn dir_seek(k: &mut Kernel, pid: u64, fd: u64, off: u64, whence: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let v = fd_get(k.lxfd, pid, fd) % FD_CLOEXEC;
  if v < FD_OFD || v - FD_OFD >= OFD_N {
    return EBADF;
  }
  let h = v - FD_OFD;
  let pos = of_get(k.ofd, h, 3) % 0x100000000;
  let mut to = off;
  if whence == 1 {
    if off < 0x8000000000000000 {
      to = sat_add(pos, off);
    } else if 0xFFFFFFFFFFFFFFFF - off + 1 <= pos {
      to = pos - (0xFFFFFFFFFFFFFFFF - off + 1);
    } else {
      return EINVAL;
    }
  } else if whence != 0 {
    return EINVAL;
  }
  if to >= 0x100000000 {
    return EINVAL;
  }
  of_set(&mut k.ofd, h, 3, to);
  return to;
}

// ---------------------------------------------------------------- paths

/// The directory description x for the name in the first n bytes of the
/// transfer buffer, or NO_FILE if it is not a directory.
fn dir_at(k: &mut Kernel, n: u64) -> u64
  requires kok(k) && n <= FNAME_MAX
  ensures kok(k)
{
  let dl = dir_look(&mut k, n);
  return dl.d;
}

/// dir_at, and with it what vfs_lookup gives for the name if that was
/// looked up on the way (see DirLook in src/fs.bastio): `d` is the
/// directory description, `f` and `looked` the file handle.
fn dir_look(k: &mut Kernel, n: u64) -> DirLook
  requires kok(k) && n <= FNAME_MAX
  ensures kok(k)
  ensures result.f < HFILES || result.f == NO_FILE
{
  return dir_look_with(&mut k, n, false, NO_FILE);
}

/// dir_look, for a caller that has looked the name up already (see
/// vfs_dir_look_with).
fn dir_look_with(k: &mut Kernel, n: u64, known: bool, f0: u64) -> DirLook
  requires kok(k) && n <= FNAME_MAX && (f0 < HFILES || f0 == NO_FILE)
  ensures kok(k)
  ensures result.f < HFILES || result.f == NO_FILE
{
  if n == 0 {
    return DirLook { d: DIR_ROOT, f: NO_FILE, looked: false };
  }
  if is_bin(k.fs.xfer, n) {
    return DirLook { d: DIR_BIN, f: NO_FILE, looked: false };
  }
  let pd = proc_dir(k.procs, k.fs.xfer, n);
  if pd != NO_FILE {
    return DirLook { d: pd, f: NO_FILE, looked: false };
  }
  let cd = cg_dir(k, n);
  if cd != NO_FILE {
    return DirLook { d: cd, f: NO_FILE, looked: false };
  }
  let dl = vfs_dir_look_with(&mut k.fs, n, known, f0);
  if dl.d == NO_FILE {
    return DirLook { d: NO_FILE, f: dl.f, looked: dl.looked };
  }
  return DirLook { d: DIR_VFS + dl.d, f: dl.f, looked: dl.looked };
}

/// A child process starts in its parent's working directory. False if the
/// rest of a long path has no room (then the child's row is as it was).
fn cwd_fork(t: &mut Buf, tx: &mut Buf, parent: u64, child: u64) -> bool
  requires len(t) <= CWD_LEN && len(tx) <= CWDX_LEN && parent < NPROC && child < NPROC
  ensures len(t) <= CWD_LEN && len(tx) <= CWDX_LEN
{
  // The length word and the path it counts; nothing reads past them.
  let pl = smaller(wget(t, parent * CWD_STRIDE), FNAME_MAX);
  if pl > CWD_INL && !spill_room(&mut tx, child, NPROC) {
    return false;
  }
  let n = 1 + (smaller(pl, CWD_INL) + 7) / 8;
  let mut i = 0;
  while i < n
    invariant i <= n && n <= CWD_STRIDE && len(t) <= CWD_LEN && len(tx) <= CWDX_LEN
  {
    wset(&mut t, child * CWD_STRIDE + i, wget(t, parent * CWD_STRIDE + i));
    i = i + 1;
  }
  wset(&mut t, child * CWD_STRIDE, pl);
  if pl > CWD_INL {
    let w = (pl - CWD_INL + 7) / 8;
    let mut j = 0;
    while j < w
      invariant j <= w && w <= SPILL_STRIDE && len(t) <= CWD_LEN && len(tx) <= CWDX_LEN
    {
      wset(&mut tx, child * SPILL_STRIDE + j, wget(tx, parent * SPILL_STRIDE + j));
      j = j + 1;
    }
  }
  return true;
}

/// Makes room in the spill tables for a copy of pid's working directory and
/// root as process c's, so that cwd_fork cannot fail. False when memory runs out.
fn cwd_reserve(k: &mut Kernel, pid: u64, c: u64) -> bool
  requires kok(k) && pid < NPROC && c < NPROC
  ensures kok(k)
{
  if smaller(wget(k.cwd, pid * CWD_STRIDE), FNAME_MAX) > CWD_INL && !spill_room(&mut k.cwdx, c, NPROC) {
    return false;
  }
  if smaller(wget(k.croot, pid * CWD_STRIDE), FNAME_MAX) > CWD_INL && !spill_room(&mut k.crootx, c, NPROC) {
    return false;
  }
  return true;
}

/// chdir(path): the directory becomes process pid's working directory.
fn lx_chdir(k: &mut Kernel, pid: u64, path: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_in(&mut k, pid, path);
  if n == NO_RESULT {
    return k.perr;
  }
  if dir_at(&mut k, n) == NO_FILE {
    if vfs_lookup(&mut k.fs, n) != NO_FILE {
      return ENOTDIR;
    }
    return ENOENT;
  }
  let e = may_path(&mut k, pid, n, MAY_X);   // search permission (src/lxperm.bastio)
  if e != 0 {
    return e;
  }
  // The logical name, as the lookup left it (src/lxns.bastio).
  let tl = len(k.cwd);
  if (pid + 1) * CWD_STRIDE <= tl {           // a live process has its row
    if !name_keep(&mut k.cwd, &mut k.cwdx, tl, pid, NPROC, k.mstr, lpath_len(k)) {
      return ENOMEM;
    }
  }
  return 0;
}

/// chroot(path): the directory becomes process pid's root, which absolute
/// paths, absolute link targets and ".." at the top stay inside (see
/// lx_path_from). The working directory does not move, as on Linux.
const CAP_SYS_CHROOT: u64 = 18;

/// Needs root (CAP_SYS_CHROOT), checked after the path, as Linux does.
fn lx_chroot(k: &mut Kernel, pid: u64, path: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_in(&mut k, pid, path);
  if n == NO_RESULT {
    return k.perr;
  }
  if dir_at(&mut k, n) == NO_FILE {
    if vfs_lookup(&mut k.fs, n) != NO_FILE {
      return ENOTDIR;
    }
    return ENOENT;
  }
  let e = may_path(&mut k, pid, n, MAY_X);
  if e != 0 {
    return e;
  }
  if id_get(k.procs, pid, F_UID, true) != 0 && !ns_cap(k, pid, CAP_SYS_CHROOT) {
    return EPERM;                           // root of a user namespace chroots there (podman's layer unpack)
  }
  let rlen = len(k.croot);
  if (pid + 1) * CWD_STRIDE <= rlen {         // a live process has its row
    if !name_keep(&mut k.croot, &mut k.crootx, rlen, pid, NPROC, k.mstr, lpath_len(k)) {   // the logical name (src/lxns.bastio)
      return ENOMEM;
    }
  }
  return 0;
}

/// The length of process pid's root (0: the top).
fn root_len(k: &Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures result <= FNAME_MAX
{
  return smaller(wget(k.croot, pid * CWD_STRIDE), FNAME_MAX);
}

/// Is the working directory of process pid inside its root?
fn cwd_in_root(k: &Kernel, pid: u64) -> bool
  requires kok(k) && pid < NPROC
{
  let rl = root_len(k, pid);
  let n = smaller(wget(k.cwd, pid * CWD_STRIDE), FNAME_MAX);
  if n < rl {
    return false;
  }
  let mut i = 0;
  while i < rl
    invariant i <= rl && rl <= n && n <= FNAME_MAX && kok(k) && pid < NPROC
  {
    if rbyte(k.cwd, k.cwdx, pid, i) != rbyte(k.croot, k.crootx, pid, i) {
      return false;
    }
    i = i + 1;
  }
  return n == rl || rl == 0 || rbyte(k.cwd, k.cwdx, pid, rl) == 47;
}

/// Keeps x[0..n] as row `row` of a path table (cwd or dpath), of `rows` rows
/// at most, with tx beside it. False, with the row as it was, if the part
/// past CWD_INL has no room.
fn name_keep(t: &mut Buf, tx: &mut Buf, tlen: u64, row: u64, rows: u64, x: &Bytes, n: u64) -> bool
  requires len(t) == tlen && (row + 1) * CWD_STRIDE <= tlen && row < rows && rows <= NPROC * 8 && len(tx) <= rows * SPILL_STRIDE && n <= FNAME_MAX && n <= blen(x)
  ensures len(t) == tlen && len(tx) <= rows * SPILL_STRIDE
{
  if n > CWD_INL && !spill_room(&mut tx, row, rows) {
    return false;
  }
  let mut i = 0;
  while i < n
    invariant i <= n && n <= FNAME_MAX && n <= blen(x) && len(t) == tlen && (row + 1) * CWD_STRIDE <= tlen && len(tx) <= rows * SPILL_STRIDE
  {
    rsetb(&mut t, &mut tx, row, i, cast[u64](bget(x, i)));
    i = i + 1;
  }
  t = set(t, row * CWD_STRIDE, n);
  return true;
}

/// Saves the last lookup's logical path to t[at..], returning its length.
fn lname_save(k: &Kernel, t: &mut Bytes, at: u64) -> u64
  requires kok(k) && at + FNAME_MAX <= blen(t)
  ensures result <= FNAME_MAX && blen(t) == old(blen(t))
{
  let n = lpath_len(k);
  let mut i = 0;
  while i < n
    invariant i <= n && n <= FNAME_MAX && at + FNAME_MAX <= blen(t) && kok(k) && blen(t) == old(blen(t))
  {
    bset(&mut t, at + i, bget(k.mstr, i));
    i = i + 1;
  }
  return n;
}

/// A directory was renamed from x[0..on] to x[F..F+nn] (F = FNAME_MAX, logical names, saved by lname_save):
/// every row of path table t (cwd or dpath) at or below the old name
/// follows it. A name that would not fit stays as it was.
fn path_moved(t: &mut Buf, tx: &mut Buf, rows: u64, x: &Bytes, on: u64, nn: u64)
  requires len(t) <= DPATH_LEN && rows <= OFD_N && len(tx) <= rows * SPILL_STRIDE && on > 0 && on <= FNAME_MAX && nn <= FNAME_MAX && blen(x) == 2 * FNAME_MAX
  ensures len(t) <= DPATH_LEN && len(tx) <= rows * SPILL_STRIDE
{
  let mut tmp = balloc(FNAME_MAX);
  let mut r = 0;
  while (r + 1) * CWD_STRIDE <= len(t) && r < rows
    invariant len(t) <= DPATH_LEN && len(tx) <= rows * SPILL_STRIDE && rows <= OFD_N && r <= OFD_N && on > 0 && on <= FNAME_MAX && nn <= FNAME_MAX && blen(x) == 2 * FNAME_MAX && blen(tmp) == FNAME_MAX
  {
    let cl = smaller(wget(t, r * CWD_STRIDE), FNAME_MAX);
    let mut hit = cl >= on;
    if hit && cl > on && rbyte(t, tx, r, on) != 47 {
      hit = false;
    }
    let mut i = 0;
    while i < on && hit
      invariant i <= on && on <= FNAME_MAX && cl <= FNAME_MAX && blen(x) == 2 * FNAME_MAX && len(t) <= DPATH_LEN && (r + 1) * CWD_STRIDE <= len(t) && len(tx) <= rows * SPILL_STRIDE
    {
      if rbyte(t, tx, r, i) != cast[u64](bget(x, i)) {
        hit = false;
      }
      i = i + 1;
    }
    if hit && cl >= on && nn + (cl - on) <= FNAME_MAX {
      let rest = cl - on;
      let mut j = 0;
      while j < nn
        invariant j <= nn && nn + rest <= FNAME_MAX && nn <= FNAME_MAX && blen(x) == 2 * FNAME_MAX && blen(tmp) == FNAME_MAX
      {
        bset(&mut tmp, j, bget(x, FNAME_MAX + j));
        j = j + 1;
      }
      let mut q = 0;
      while q < rest
        invariant q <= rest && nn + rest <= FNAME_MAX && on + rest == cl && cl <= FNAME_MAX && blen(tmp) == FNAME_MAX && len(t) <= DPATH_LEN && (r + 1) * CWD_STRIDE <= len(t) && len(tx) <= rows * SPILL_STRIDE
      {
        bset(&mut tmp, nn + q, cast[u8](rbyte(t, tx, r, on + q)));
        q = q + 1;
      }
      let kept = name_keep(&mut t, &mut tx, len(t), r, rows, tmp, nn + rest);
    }
    r = r + 1;
  }
  bfree(tmp);
}

/// Row `h` of k.dpath, grown to hold it (doubling, so a run of directories
/// does not copy the table each time). False, with the table as it was,
/// when memory runs out.
fn dpath_room(t: &mut Buf, h: u64) -> bool
  requires h < OFD_N && len(t) <= DPATH_LEN
  ensures len(t) <= DPATH_LEN && (result ==> (h + 1) * CWD_STRIDE <= len(t))
{
  if (h + 1) * CWD_STRIDE <= len(t) {
    return true;
  }
  let mut rows = len(t) / CWD_STRIDE * 2;
  if rows < 4 {
    rows = 4;
  }
  if rows < h + 1 {
    rows = h + 1;
  }
  if rows > OFD_N {
    rows = OFD_N;
  }
  let ok = zgrow(&mut t, rows * CWD_STRIDE);
  return ok && (h + 1) * CWD_STRIDE <= len(t);
}

/// Keeps x[0..n] as the name of open directory description h. When there
/// is no memory for its row the name is not kept: it reads as empty.
fn dpath_keep(t: &mut Buf, tx: &mut Buf, h: u64, x: &Bytes, n: u64)
  requires h < OFD_N && len(t) <= DPATH_LEN && len(tx) <= DPATHX_LEN && n <= FNAME_MAX && n <= blen(x)
  ensures len(t) <= DPATH_LEN && len(tx) <= DPATHX_LEN
{
  if dpath_room(&mut t, h) {
    let kept = name_keep(&mut t, &mut tx, len(t), h, OFD_N, x, n);
  }
}

/// fchdir(fd): the open directory becomes the working directory.
fn lx_fchdir(k: &mut Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let h = dir_ofd(k, pid, fd);
  if h >= OFD_N {
    if fd_get(k.lxfd, pid, fd) == 0 {
      return EBADF;
    }
    return ENOTDIR;
  }
  // Search permission on it, as chdir needs (src/lxperm.bastio).
  let dl = base_len(k, pid, h);
  let mut c = 0;
  while c < dl
    invariant c <= dl && dl <= FNAME_MAX && kok(k) && pid < NPROC && h < OFD_N
  {
    bset(&mut k.fs.xfer, c, base_byte(k, pid, h, c));
    c = c + 1;
  }
  let e = may_path(&mut k, pid, dl, MAY_X);
  if e != 0 {
    return e;
  }
  if (pid + 1) * CWD_STRIDE <= len(k.cwd) && !name_keep(&mut k.cwd, &mut k.cwdx, len(k.cwd), pid, NPROC, k.fs.xfer, dl) {
    return ENOMEM;
  }
  return 0;
}

/// getcwd(buf, size): "/" and the working directory, NUL-terminated, as
/// seen from the process's root. Returns the bytes written, NUL included.
fn lx_getcwd(k: &mut Kernel, pid: u64, va: u64, size: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = smaller(wget(k.cwd, pid * CWD_STRIDE), FNAME_MAX);
  let rl = root_len(k, pid);
  let mut s = 0;                            // where the part shown starts
  if rl > 0 && cwd_in_root(k, pid) {
    s = smaller(rl + 1, n);                 // past the root and its "/"
  }
  let m = n - s;
  if size < m + 2 {
    return ERANGE;
  }
  bset(&mut k.fs.xfer, 0, 47);
  let mut i = 0;
  while i < m
    invariant i <= m && s + m == n && n <= FNAME_MAX && kok(k) && pid < NPROC
  {
    bset(&mut k.fs.xfer, 1 + i, cast[u8](rbyte(k.cwd, k.cwdx, pid, s + i)));
    i = i + 1;
  }
  bset(&mut k.fs.xfer, m + 1, 0);
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, m + 2) != m + 2 {
    return EFAULT;
  }
  return m + 2;
}

/// mkdir(path, mode): the mode less the umask, and the owner, as for a
/// new file (src/lxperm.bastio).
fn lx_mkdir(k: &mut Kernel, pid: u64, dirfd: u64, path: u64, mode: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_at_nf_w(&mut k, pid, dirfd, path);
  if n == NO_RESULT {
    return k.perr;
  }
  if n == 0 || is_bin(k.fs.xfer, n) || vfs_lookup(&mut k.fs, n) != NO_FILE || vfs_dir_lookup(&mut k.fs, n) != NO_FILE {
    return EEXIST;
  }
  if cg_under(k, n) {
    return cg_mkdir(&mut k, pid, n);        // a control group (src/lxcgroup.bastio)
  }
  let em = meta_keep(&mut k, n, n);
  if em.ok {
    return EEXIST;                          // /dev, /proc and the like
  }
  if path_ro(&mut k, n) {
    return EROFS;
  }
  let e = may_dir(&mut k, pid, n);
  if e != 0 {
    return e;
  }
  let own = new_owner(&mut k, pid, n);
  let sgid = dir_sgid(&mut k, n);
  if !vfs_mkdir(&mut k.fs, n) {
    if parent_ok(&mut k.fs, n) {
      return ENOSPC;                        // no room
    }
    return ENOENT;
  }
  let d = vfs_dir_lookup(&mut k.fs, n);
  if d != NO_FILE {
    made_by(&mut k, pid, d, own, mode % 4096, sgid);
  }
  return 0;
}

/// rmdir(path): only an empty directory goes.
/// Whether the path at user address va (read as far as its first 256
/// bytes) ends in a "." component.
fn ends_in_dot(k: &mut Kernel, pid: u64, va: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if va < USER_BASE || va >= USER_BASE + USER_SIZE {
    return false;
  }
  let got = copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, &mut k.fs.xfer, smaller(256, USER_SIZE - (va - USER_BASE)));
  if got == NO_RESULT {
    return false;
  }
  let mut e = 0;
  while e < got && bget(k.fs.xfer, e) != 0
    invariant e <= got && got <= XFER && kok(k)
  {
    e = e + 1;
  }
  if e >= got || e == 0 || bget(k.fs.xfer, e - 1) != 46 {
    return false;
  }
  return e == 1 || bget(k.fs.xfer, e - 2) == 47;
}

fn lx_rmdir(k: &mut Kernel, pid: u64, dirfd: u64, path: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if ends_in_dot(&mut k, pid, path) {
    return EINVAL;                          // rmdir(".") and "dir/.", as on Linux
  }
  let n = lx_path_at_nf_rm(&mut k, pid, dirfd, path);
  if n == NO_RESULT {
    return k.perr;
  }
  let st = ovl_stash(&mut k, n);               // in an overlay mount: src/lxns.bastio
  let d = dir_at(&mut k, n);
  if d == NO_FILE {
    if vfs_lookup(&mut k.fs, n) != NO_FILE {
      return ENOTDIR;
    }
    return ENOENT;
  }
  if d >= DIR_CG {
    return cg_rmdir(&mut k, pid, n);        // a control group (src/lxcgroup.bastio)
  }
  if d < DIR_VFS || d >= DIR_PROC || d - DIR_VFS == VDIR_ROOT || d - DIR_VFS == VDIR_DISK || d - DIR_VFS == VDIR_LO {
    return EBUSY;                           // "/", "/bin" and "/disk" stay
  }
  if vfs_is_mount(&mut k.fs, n) {
    return EBUSY;                           // a tmpfs mount's directory (src/lxmount.bastio)
  }
  if path_ro(&mut k, n) {
    return EROFS;
  }
  let e = may_remove(&mut k, pid, n);
  if e != 0 {
    return e;
  }
  if st != 0 {
    if !ovl_dir_empty(&mut k, pid) {
      return ENOTEMPTY;                     // the merge has something in it
    }
    if st == 2 {
      return ovl_commit(&mut k, pid);       // a lower layer's: a whiteout hides it
    }
    if !ovl_clear_wh(&mut k, pid) {
      return ENOTEMPTY;
    }
  }
  if !vfs_rmdir(&mut k.fs, &mut k.mem, n) {
    return ENOTEMPTY;
  }
  if st != 0 {
    return ovl_commit(&mut k, pid);
  }
  return 0;
}

/// unlink(path): files only.
fn lx_unlink(k: &mut Kernel, pid: u64, dirfd: u64, path: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_at_nf_rm(&mut k, pid, dirfd, path);
  if n == NO_RESULT {
    return k.perr;
  }
  let st = ovl_stash(&mut k, n);               // in an overlay mount: src/lxns.bastio
  if dir_at(&mut k, n) != NO_FILE {
    return EISDIR;
  }
  if path_ro(&mut k, n) && vfs_lookup(&mut k.fs, n) != NO_FILE {
    return EROFS;
  }
  if vfs_lookup(&mut k.fs, n) != NO_FILE {
    let e = may_remove(&mut k, pid, n);
    if e != 0 {
      return e;
    }
  }
  if st == 2 {
    return ovl_commit(&mut k, pid);         // a lower layer's: a whiteout hides it
  }
  if !vfs_unlink(&mut k.fs, &mut k.mem, n) {
    return ENOENT;
  }
  if st != 0 {
    return ovl_commit(&mut k, pid);
  }
  return 0;
}

/// Copies the first n bytes of the transfer buffer to t at `at`.
fn xfer_save(k: &Kernel, t: &mut Bytes, at: u64, n: u64)
  requires kok(k) && n <= FNAME_MAX && blen(t) == 2 * FNAME_MAX && at <= FNAME_MAX
  ensures blen(t) == 2 * FNAME_MAX
{
  let mut i = 0;
  while i < n
    invariant i <= n && blen(t) == 2 * FNAME_MAX
  {
    bset(&mut t, at + i, bget(k.fs.xfer, i));
    i = i + 1;
  }
}

/// Copies n bytes of t from `at` to the start of the transfer buffer.
fn xfer_load(k: &mut Kernel, t: &Bytes, at: u64, n: u64)
  requires kok(k) && n <= 2 * FNAME_MAX && blen(t) == 2 * FNAME_MAX && at + n <= 2 * FNAME_MAX
  ensures kok(k)
{
  let mut i = 0;
  while i < n
    invariant i <= n && kok(k)
  {
    bset(&mut k.fs.xfer, i, bget(t, at + i));
    i = i + 1;
  }
}

/// Makes room for a rename to the name in the first m bytes of the
/// transfer buffer: removes a file there, or an empty directory when a
/// directory is moving (src_dir). 0, or the error.
fn rename_clear(k: &mut Kernel, m: u64, src_dir: bool, noreplace: bool) -> u64
  requires kok(k) && m <= FNAME_MAX
  ensures kok(k)
{
  let d = dir_at(&mut k, m);
  let is_file = d == NO_FILE && vfs_lookup(&mut k.fs, m) != NO_FILE;
  if d == NO_FILE && !is_file {
    return 0;                               // nothing there
  }
  if noreplace {
    return EEXIST;
  }
  if is_file {
    if src_dir {
      return ENOTDIR;
    }
    if !vfs_unlink(&mut k.fs, &mut k.mem, m) {
      return ENOENT;
    }
    return 0;
  }
  if !src_dir {
    return EISDIR;
  }
  if d < DIR_VFS || d >= DIR_PROC || d - DIR_VFS == VDIR_ROOT || d - DIR_VFS == VDIR_DISK || d - DIR_VFS == VDIR_LO {
    return EBUSY;
  }
  if !vfs_rmdir(&mut k.fs, &mut k.mem, m) {
    return ENOTEMPTY;
  }
  return 0;
}

/// rename, renameat and renameat2 (RENAME_NOREPLACE, or RENAME_EXCHANGE
/// for two names that are not directories; other flags are refused). A
/// file or empty directory at the new name is replaced, by removing it
/// first: not atomically, as Linux does it.
fn lx_rename(k: &mut Kernel, pid: u64, odir: u64, opath: u64, ndir: u64, npath: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if flags == RENAME_EXCHANGE {
    return lx_exchange(&mut k, pid, odir, opath, ndir, npath);
  }
  if flags & !RENAME_NOREPLACE != 0 {
    return EINVAL;                          // RENAME_WHITEOUT, or EXCHANGE with another flag
  }
  let n = lx_path_at_nf_rn(&mut k, pid, odir, opath);
  if n == NO_RESULT {
    return k.perr;
  }
  let st = ovl_stash(&mut k, n);               // in an overlay mount: src/lxns.bastio
  let d = dir_at(&mut k, n);
  let src_f = vfs_lookup(&mut k.fs, n);
  if d == NO_FILE && src_f == NO_FILE {
    return ENOENT;
  }
  if st != 0 && d != NO_FILE && (st == 2 || ovl_stash_low(k)) {
    return EXDEV;                           // a directory a lower layer has: not moved, as Linux says without redirect_dir
  }
  if d != NO_FILE && (d < DIR_VFS || d >= DIR_PROC || d - DIR_VFS == VDIR_ROOT || d - DIR_VFS == VDIR_DISK || d - DIR_VFS == VDIR_LO) {
    return EBUSY;
  }
  if vfs_is_mount(&mut k.fs, n) {
    return EBUSY;
  }
  if path_ro(&mut k, n) {
    return EROFS;
  }
  let e = may_remove(&mut k, pid, n);
  if e != 0 {
    return e;
  }
  let src_disk = vfs_dev_of(&mut k.fs, n);
  let mut t = balloc(2 * FNAME_MAX);
  let mut lg = balloc(2 * FNAME_MAX);      // the two logical names
  xfer_save(k, &mut t, 0, n);
  let oln = lname_save(k, &mut lg, 0);
  let m = lx_path_at_nf_w(&mut k, pid, ndir, npath);
  if m == NO_RESULT {
    bfree(t);
    bfree(lg);
    return k.perr;
  }
  let nln = lname_save(k, &mut lg, FNAME_MAX);
  if k.pdir && d == NO_FILE {
    bfree(t);
    bfree(lg);
    return ENOTDIR;                         // a file renamed to "new/"
  }
  if path_ro(&mut k, m) {
    bfree(t);
    bfree(lg);
    return EROFS;
  }
  let mut e2 = may_dir(&mut k, pid, m);
  if e2 == 0 && (dir_at(&mut k, m) != NO_FILE || vfs_lookup(&mut k.fs, m) != NO_FILE) {
    e2 = may_remove(&mut k, pid, m);        // what it replaces goes away
  }
  if e2 != 0 {
    bfree(t);
    bfree(lg);
    return e2;
  }
  xfer_save(k, &mut t, n, m);
  let mut same = n == m;
  let mut i = 0;
  while i < m && same
    invariant i <= m && m <= FNAME_MAX && n <= FNAME_MAX && blen(t) == 2 * FNAME_MAX
  {
    same = bget(t, i) == bget(t, n + i);
    i = i + 1;
  }
  if same || (d == NO_FILE && vfs_lookup(&mut k.fs, m) == src_f) {
    bfree(t);
    bfree(lg);
    return 0;                               // a name renamed to itself, or to another name of its file
  }
  if d != NO_FILE && m > n && bget(t, n + n) == 47 {
    // A directory into itself: the new name starts with the old one and a "/".
    let mut inside = true;
    let mut j = 0;
    while j < n && inside
      invariant j <= n && n < m && m <= FNAME_MAX && blen(t) == 2 * FNAME_MAX
    {
      inside = bget(t, j) == bget(t, n + j);
      j = j + 1;
    }
    if inside {
      bfree(t);
    bfree(lg);
      return EINVAL;
    }
  }
  if vfs_dev_of(&mut k.fs, m) != src_disk {
    bfree(t);
    bfree(lg);
    return EXDEV;
  }
  let r = rename_clear(&mut k, m, d != NO_FILE, flags & RENAME_NOREPLACE != 0);
  if r != 0 {
    bfree(t);
    bfree(lg);
    return r;
  }
  xfer_load(&mut k, t, 0, n + m);
  if !vfs_rename(&mut k.fs, n, m) {
    bfree(t);
    bfree(lg);
    return ENOENT;                          // no such directory, or a directory into itself
  }
  if d != NO_FILE && oln > 0 {
    // Working directories and open directories under it follow the new name.
    path_moved(&mut k.cwd, &mut k.cwdx, NPROC, lg, oln, nln);
    path_moved(&mut k.dpath, &mut k.dpathx, OFD_N, lg, oln, nln);
  }
  bfree(t);
  bfree(lg);
  if st != 0 {
    return ovl_commit(&mut k, pid);         // a lower layer's name is hidden now
  }
  return 0;
}

/// renameat2 with RENAME_EXCHANGE: the two names swap files (vfs_exchange).
/// Both must exist, on one file system; directories are not offered
/// (EINVAL).
fn lx_exchange(k: &mut Kernel, pid: u64, odir: u64, opath: u64, ndir: u64, npath: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let n = lx_path_at_nf(&mut k, pid, odir, opath);
  if n == NO_RESULT {
    return k.perr;
  }
  let a = vfs_lookup(&mut k.fs, n);
  let ad = dir_at(&mut k, n);
  let a_disk = vfs_dev_of(&mut k.fs, n);
  if (a != NO_FILE || ad != NO_FILE) && path_ro(&mut k, n) {
    return EROFS;
  }
  let e = may_remove(&mut k, pid, n);
  if e != 0 {
    return e;
  }
  let mut t = balloc(2 * FNAME_MAX);
  xfer_save(k, &mut t, 0, n);
  let m = lx_path_at_nf(&mut k, pid, ndir, npath);
  if m == NO_RESULT {
    bfree(t);
    return k.perr;
  }
  let b = vfs_lookup(&mut k.fs, m);
  let bd = dir_at(&mut k, m);
  if (a == NO_FILE && ad == NO_FILE) || (b == NO_FILE && bd == NO_FILE) {
    bfree(t);
    return ENOENT;
  }
  if ad != NO_FILE || bd != NO_FILE {
    bfree(t);
    return EINVAL;
  }
  if vfs_dev_of(&mut k.fs, m) != a_disk {
    bfree(t);
    return EXDEV;
  }
  if a == b {
    bfree(t);
    return 0;                               // two names of one file
  }
  if path_ro(&mut k, m) {
    bfree(t);
    return EROFS;
  }
  let e2 = may_remove(&mut k, pid, m);
  if e2 != 0 {
    bfree(t);
    return e2;
  }
  xfer_save(k, &mut t, n, m);
  xfer_load(&mut k, t, 0, n + m);
  bfree(t);
  if !vfs_exchange(&mut k.fs, n, m) {
    return EIO;
  }
  return 0;
}

fn is_dir_call(n: u64) -> bool {
  return n == LX_CHDIR || n == LX_CHROOT || n == LX_FCHDIR || n == LX_MKDIR || n == LX_RMDIR || n == LX_MKDIRAT
    || n == LX_RENAME || n == LX_RENAMEAT || n == LX_RENAMEAT2;
}

/// chdir, chroot, fchdir, mkdir, mkdirat, rmdir and the renames.
fn lx_dir_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_CHDIR {
    return lx_chdir(&mut k, pid, a);
  }
  if n == LX_FCHDIR {
    return lx_fchdir(&mut k, pid, a);
  }
  if n == LX_CHROOT {
    return lx_chroot(&mut k, pid, a);
  }
  if n == LX_MKDIR {
    return lx_mkdir(&mut k, pid, AT_FDCWD, a, b);
  }
  if n == LX_MKDIRAT {
    return lx_mkdir(&mut k, pid, a, b, c);
  }
  if n == LX_RENAME {
    return lx_rename(&mut k, pid, AT_FDCWD, a, AT_FDCWD, b, 0);
  }
  if n == LX_RENAMEAT || n == LX_RENAMEAT2 {
    let mut flags = 0;
    if n == LX_RENAMEAT2 {
      flags = pget(k.procs, pid, F_REGS + R_R8);
    }
    return lx_rename(&mut k, pid, a, b, c, pget(k.procs, pid, F_REGS + R_R10), flags);
  }
  return lx_rmdir(&mut k, pid, AT_FDCWD, a);
}
