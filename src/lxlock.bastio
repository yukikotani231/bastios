// Linux file locks: fcntl's record locks (F_GETLK, F_SETLK, F_SETLKW),
// open file description locks (F_OFD_GETLK and friends) and flock.
//
// k.locks is a table of LK_N held locks, LK_W words each: the file plus 1
// (0: a free entry), the owner, the type (F_RDLCK or F_WRLCK), the first
// byte, the byte after the last (LK_EOF: to the end of the file, however
// far it grows) and the class (LKC_FCNTL or LKC_FLOCK). The owner of a
// record lock is the thread group's leader; the owner of an OFD lock or a
// flock is LK_DESC + the open file description. Record locks and OFD
// locks see each other; flock locks see only flock locks, as on Linux.
//
// A process loses its record locks on a file when it closes any of its
// descriptors for it (and so when it exits); an OFD lock or a flock goes
// when the last descriptor for its description closes (lx_fd_close and
// unref_value in src/lxfd.bastio call lock_drop).
//
// F_SETLKW and a blocking flock wait by running the call again on later
// ticks, like a full pipe. A process about to wait for a record lock notes
// what it waits for (after the table, LK_WW words per process: file plus
// 1, type, first byte, byte after the last); if following "the holder of
// the lock in my way waits for a lock whose holder ..." leads back to the
// caller, F_SETLKW fails with EDEADLK instead, as on Linux. A note counts
// only while its process is still in that fcntl call.
//
// Not done: waits on OFD locks and flocks are not part of deadlock
// detection (Linux leaves them out too), and mandatory locking and leases
// are not supported.

import "lxfd.bastio";

const F_RDLCK: u64 = 0;
const F_WRLCK: u64 = 1;
const FLOCK_SIZE: u64 = 32;               // struct flock
const ENOLCK: u64 = 18446744073709551579;     // 2^64 - 37
const EDEADLK: u64 = 18446744073709551581;    // 2^64 - 35
const LK_SIGN: u64 = 9223372036854775808;     // 2^63: off_t values at or above it are negative

fn lk_get(t: &Buf, i: u64, f: u64) -> u64
  requires len(t) == LK_LEN && i < LK_N && f < LK_W
{
  return get(t, i * LK_W + f);
}

fn lk_set(t: &mut Buf, i: u64, f: u64, v: u64)
  requires len(t) == LK_LEN && i < LK_N && f < LK_W
  ensures len(t) == LK_LEN
{
  t = set(t, i * LK_W + f, v);
}

fn lk_wait_get(t: &Buf, p: u64, f: u64) -> u64
  requires len(t) == LK_LEN && p < NPROC && f < LK_WW
{
  return get(t, LK_WAITS + p * LK_WW + f);
}

fn lk_wait_set(t: &mut Buf, p: u64, f: u64, v: u64)
  requires len(t) == LK_LEN && p < NPROC && f < LK_WW
  ensures len(t) == LK_LEN
{
  t = set(t, LK_WAITS + p * LK_WW + f, v);
}

/// A thread of the process led by g that waits in F_SETLKW for a record
/// lock, or NPROC.
fn lk_waiter(k: &Kernel, g: u64) -> u64
  requires kok(k)
  ensures result <= NPROC
{
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC
  {
    let st = state(k.procs, p);
    if st != FREE && st != ZOMBIE && tgid(k.procs, p) == g && lk_wait_get(k.locks, p, 0) != 0
      && pget(k.procs, p, F_RESTART) != 0 && pget(k.procs, p, F_REGS + R_RAX) == LX_FCNTL {
      return p;
    }
    p = p + 1;
  }
  return NPROC;
}

/// Whether owner `me` waiting for a ty lock on [s, e) of file would close
/// a cycle of waits: the holder in its way waits for a lock held by one
/// that waits ..., back to me.
fn lk_deadlock(k: &Kernel, me: u64, file: u64, ty: u64, s: u64, e: u64) -> bool
  requires kok(k) && file < LK_EOF
{
  let mut owner = me;
  let mut f = file;
  let mut t = ty;
  let mut a = s;
  let mut b = e;
  let mut step = 0;
  while step < NPROC
    invariant step <= NPROC && f < LK_EOF
  {
    let i = lk_conflict(k.locks, f, LKC_FCNTL, owner, t, a, b);
    if i == LK_N {
      return false;
    }
    let holder = lk_get(k.locks, i, 1);
    if holder == me {
      return true;
    }
    if holder >= NPROC {
      return false;                         // a description's lock: not followed
    }
    let p = lk_waiter(k, holder);
    if p >= NPROC {
      return false;                         // the holder is not waiting
    }
    let wf = lk_wait_get(k.locks, p, 0);
    if wf == 0 || wf - 1 >= LK_EOF {
      return false;
    }
    owner = holder;
    f = wf - 1;
    t = lk_wait_get(k.locks, p, 1);
    a = lk_wait_get(k.locks, p, 2);
    b = lk_wait_get(k.locks, p, 3);
    step = step + 1;
  }
  return false;
}

/// Whether held lock i belongs to the same file and class as a request,
/// and its bytes overlap [s, e).
fn lk_touches(t: &Buf, i: u64, file: u64, class: u64, s: u64, e: u64) -> bool
  requires len(t) == LK_LEN && i < LK_N && file < LK_EOF
{
  return lk_get(t, i, 0) == file + 1 && lk_get(t, i, 5) == class
    && lk_get(t, i, 3) < e && s < lk_get(t, i, 4);
}

/// The first held lock that keeps owner from taking a lock of type ty on
/// [s, e) of file, or LK_N if none does.
fn lk_conflict(t: &Buf, file: u64, class: u64, owner: u64, ty: u64, s: u64, e: u64) -> u64
  requires len(t) == LK_LEN && file < LK_EOF
  ensures result <= LK_N
{
  // The one that starts first, as Linux's sorted list gives for F_GETLK.
  let mut best = LK_N;
  let mut i = 0;
  while i < LK_N
    invariant i <= LK_N && best <= LK_N
  {
    if lk_touches(t, i, file, class, s, e) && lk_get(t, i, 1) != owner
      && (ty == F_WRLCK || lk_get(t, i, 2) == F_WRLCK)
      && (best == LK_N || lk_get(t, i, 3) < lk_get(t, best, 3)) {
      best = i;
    }
    i = i + 1;
  }
  return best;
}

fn lk_free_count(t: &Buf) -> u64
  requires len(t) == LK_LEN
  ensures result <= LK_N
{
  let mut n = 0;
  let mut i = 0;
  while i < LK_N
    invariant i <= LK_N && n <= i
  {
    if lk_get(t, i, 0) == 0 {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

fn lk_free_slot(t: &Buf) -> u64
  requires len(t) == LK_LEN
  ensures result <= LK_N
{
  let mut i = 0;
  while i < LK_N
    invariant i <= LK_N
  {
    if lk_get(t, i, 0) == 0 {
      return i;
    }
    i = i + 1;
  }
  return LK_N;
}

fn lk_put(t: &mut Buf, file: u64, class: u64, owner: u64, ty: u64, s: u64, e: u64)
  requires len(t) == LK_LEN
  ensures len(t) == LK_LEN
{
  let i = lk_free_slot(t);
  if i < LK_N && file < LK_EOF {
    lk_set(&mut t, i, 0, file + 1);
    lk_set(&mut t, i, 1, owner);
    lk_set(&mut t, i, 2, ty);
    lk_set(&mut t, i, 3, s);
    lk_set(&mut t, i, 4, e);
    lk_set(&mut t, i, 5, class);
  }
}

/// Sets owner's lock on [s, e) of file to type ty, or removes it there
/// (F_UNLCK), splitting and trimming what owner held before. Returns 0,
/// or -ENOLCK when the table has no room (and then nothing changes).
/// The caller has checked that nobody else's lock is in the way.
fn lk_apply(t: &mut Buf, file: u64, class: u64, owner: u64, ty: u64, s: u64, e: u64) -> u64
  requires len(t) == LK_LEN && file < LK_EOF
  ensures len(t) == LK_LEN
{
  // Room first, so a request either happens whole or not at all: one
  // entry for the new lock, one more if it splits an old one in two.
  let mut need = 0;
  if ty != F_UNLCK {
    need = 1;
  }
  let mut i = 0;
  while i < LK_N
    invariant i <= LK_N && len(t) == LK_LEN && need <= 2
  {
    if lk_touches(t, i, file, class, s, e) && lk_get(t, i, 1) == owner
      && lk_get(t, i, 3) < s && e < lk_get(t, i, 4) {
      need = 2;
    }
    i = i + 1;
  }
  if need > lk_free_count(t) {
    return ENOLCK;
  }
  i = 0;
  while i < LK_N
    invariant i <= LK_N && len(t) == LK_LEN
  {
    if lk_touches(t, i, file, class, s, e) && lk_get(t, i, 1) == owner {
      let os = lk_get(t, i, 3);
      let oe = lk_get(t, i, 4);
      if os < s && e < oe {
        lk_set(&mut t, i, 4, s);
        lk_put(&mut t, file, class, owner, lk_get(t, i, 2), e, oe);
      } else if os < s {
        lk_set(&mut t, i, 4, s);
      } else if e < oe {
        lk_set(&mut t, i, 3, e);
      } else {
        lk_set(&mut t, i, 0, 0);
      }
    }
    i = i + 1;
  }
  if ty != F_UNLCK {
    lk_put(&mut t, file, class, owner, ty, s, e);
  }
  return 0;
}

/// Drops every lock owner holds: on file (or on any file, if file is
/// LK_EOF) and in class `class` (or in both, if class is 2).
fn lock_drop(t: &mut Buf, owner: u64, file: u64, class: u64)
  requires len(t) == LK_LEN
  ensures len(t) == LK_LEN
{
  let mut i = 0;
  while i < LK_N
    invariant i <= LK_N && len(t) == LK_LEN
  {
    let f = lk_get(t, i, 0);
    if f != 0 && lk_get(t, i, 1) == owner && (file == LK_EOF || f - 1 == file)
      && (class == 2 || lk_get(t, i, 5) == class) {
      lk_set(&mut t, i, 0, 0);
    }
    i = i + 1;
  }
}

/// The file a Linux descriptor's native row has open, or LK_EOF.
fn lk_file(k: &Kernel, row: u64) -> u64
  requires kok(k) && row < FD_ROWS
{
  let f = vfs_row_file(k.fs, row);
  if f == NO_FILE {
    return LK_EOF;
  }
  return f;
}

/// fcntl's lock commands on descriptor fd: F_GETLK, F_SETLK, F_SETLKW and
/// the F_OFD_ ones, with a struct flock at user address arg. Returns 0,
/// -errno, or LK_WAIT for a F_SETLKW that must wait.
fn lx_fcntl_lock(k: &mut Kernel, pid: u64, fd: u64, cmd: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  if d.kind != K_FILE {
    return EBADF;
  }
  let ofd = cmd == F_OFD_GETLK || cmd == F_OFD_SETLK || cmd == F_OFD_SETLKW;
  let h = fd_ofd(k, pid, fd);
  if ofd && h >= OFD_N {
    return EBADF;
  }
  if copy_from_user(&mut k.spaces, pid, arg, &mut k.fs.xfer, FLOCK_SIZE) != FLOCK_SIZE {
    return EFAULT;
  }
  let ty = cast[u64](bget(k.fs.xfer, 0)) + 256 * cast[u64](bget(k.fs.xfer, 1));
  let whence = cast[u64](bget(k.fs.xfer, 2)) + 256 * cast[u64](bget(k.fs.xfer, 3));
  let start = get_u64(k.fs.xfer, 8);
  let n = get_u64(k.fs.xfer, 16);
  if ty != F_RDLCK && ty != F_WRLCK && ty != F_UNLCK {
    return EINVAL;
  }
  if ofd && (bget(k.fs.xfer, 24) != 0 || bget(k.fs.xfer, 25) != 0 || bget(k.fs.xfer, 26) != 0 || bget(k.fs.xfer, 27) != 0) {
    return EINVAL;                          // an OFD request must say l_pid 0
  }
  let file = lk_file(k, d.x);
  if file == LK_EOF {
    return EBADF;
  }
  let getlk = cmd == F_GETLK || cmd == F_OFD_GETLK;
  let mode = fget(k.fs.ftab, d.x, FD_MODE);
  if !getlk && ((ty == F_RDLCK && mode / O_READ % 2 == 0) || (ty == F_WRLCK && mode / O_WRITE % 2 == 0)) {
    return EBADF;                           // a read lock needs reading, a write lock writing
  }
  // The range: l_start from SEEK_SET, SEEK_CUR or SEEK_END, then l_len
  // bytes on (to the end of the file when 0, before l_start when negative).
  let mut base = 0;
  if whence == 1 {
    base = vfs_offset(k.fs, d.x);
  } else if whence == 2 {
    base = vfs_size(&mut k.fs, file);
    if base == NO_FILE {
      return EBADF;
    }
  } else if whence != 0 {
    return EINVAL;
  }
  if base >= LK_SIGN {
    return EINVAL;
  }
  let mut s = 0;
  if start < LK_SIGN {
    if start >= LK_SIGN - base {
      return EINVAL;                        // past the largest off_t
    }
    s = base + start;
  } else {
    let back = LK_EOF - start + 1;          // -l_start
    if back > base {
      return EINVAL;
    }
    s = base - back;
  }
  let mut e = LK_EOF;
  if n != 0 && n < LK_SIGN {
    if n < LK_SIGN - s {
      e = s + n;
    }
  } else if n >= LK_SIGN {
    let back = LK_EOF - n + 1;              // -l_len
    if back > s {
      return EINVAL;
    }
    e = s;
    s = s - back;
  }
  let mut owner = tgid(k.procs, pid);
  if ofd {
    owner = LK_DESC + h;
  }
  if cmd == F_GETLK || cmd == F_OFD_GETLK {
    if ty == F_UNLCK {
      return EINVAL;
    }
    let i = lk_conflict(k.locks, file, LKC_FCNTL, owner, ty, s, e);
    if i == LK_N {
      bset(&mut k.fs.xfer, 0, cast[u8](F_UNLCK));
      bset(&mut k.fs.xfer, 1, 0);
    } else {
      let os = lk_get(k.locks, i, 3);
      let oe = lk_get(k.locks, i, 4);
      let who = lk_get(k.locks, i, 1);
      bset(&mut k.fs.xfer, 0, cast[u8](lk_get(k.locks, i, 2) % 256));
      bset(&mut k.fs.xfer, 1, 0);
      bset(&mut k.fs.xfer, 2, 0);           // SEEK_SET
      bset(&mut k.fs.xfer, 3, 0);
      xfer_u64(&mut k.fs.xfer, 8, os);
      if oe == LK_EOF || oe <= os {
        xfer_u64(&mut k.fs.xfer, 16, 0);
      } else {
        xfer_u64(&mut k.fs.xfer, 16, oe - os);
      }
      // l_pid: the holder's process, or -1 for a description's lock.
      let mut p = 0xFFFFFFFF;
      if who < LK_DESC {
        p = who;
      }
      bset(&mut k.fs.xfer, 24, cast[u8](p % 256));
      bset(&mut k.fs.xfer, 25, cast[u8](p / 256 % 256));
      bset(&mut k.fs.xfer, 26, cast[u8](p / 65536 % 256));
      bset(&mut k.fs.xfer, 27, cast[u8](p / 16777216 % 256));
    }
    if copy_to_user(&mut k.spaces, pid, arg, k.fs.xfer, FLOCK_SIZE) != FLOCK_SIZE {
      return EFAULT;
    }
    return 0;
  }
  if ty != F_UNLCK && lk_conflict(k.locks, file, LKC_FCNTL, owner, ty, s, e) < LK_N {
    if cmd == F_OFD_SETLKW {
      return LK_WAIT;
    }
    if cmd == F_SETLKW {
      if lk_deadlock(k, owner, file, ty, s, e) {
        lk_wait_set(&mut k.locks, pid, 0, 0);
        return EDEADLK;
      }
      lk_wait_set(&mut k.locks, pid, 0, file + 1);
      lk_wait_set(&mut k.locks, pid, 1, ty);
      lk_wait_set(&mut k.locks, pid, 2, s);
      lk_wait_set(&mut k.locks, pid, 3, e);
      return LK_WAIT;
    }
    return EAGAIN;
  }
  lk_wait_set(&mut k.locks, pid, 0, 0);
  return lk_apply(&mut k.locks, file, LKC_FCNTL, owner, ty, s, e);
}


/// How many open files of the file layer name file `file`, and of those,
/// how many are open for writing (count + writers * 2^32).
fn lk_opens(k: &Kernel, file: u64) -> u64
  requires kok(k)
{
  let mut n = 0;
  let mut w = 0;
  let mut row = 0;
  while row < FD_ROWS
    invariant row <= FD_ROWS && n <= row && w <= row && kok(k)
  {
    if fget(k.fs.ftab, row, FD_FS) != 0 && lk_file(k, row) == file {
      n = n + 1;
      if fget(k.fs.ftab, row, FD_MODE) / O_WRITE % 2 == 1 {
        w = w + 1;
      }
    }
    row = row + 1;
  }
  return n + w * 0x100000000;
}

/// fcntl F_SETLEASE and F_GETLEASE on descriptor fd. A lease is kept
/// (and reported back) but never broken: nothing tells its holder when
/// another process opens the file, so a lease is only what F_GETLEASE
/// says. As on Linux, a read lease needs the file open for reading only
/// and nobody writing it, a write lease nobody else having it open, and
/// either is for the file's owner or root.
fn lx_lease(k: &mut Kernel, pid: u64, fd: u64, cmd: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  let h = fd_ofd(k, pid, fd);
  if d.kind != K_FILE || h >= OFD_N || d.x >= FD_ROWS {
    return EBADF;
  }
  let file = lk_file(k, d.x);
  if file == LK_EOF {
    return EINVAL;
  }
  let owner = LK_DESC + h;
  if cmd == F_GETLEASE {
    let mut i = 0;
    while i < LK_N
      invariant i <= LK_N && kok(k)
    {
      if lk_get(k.locks, i, 0) == file + 1 && lk_get(k.locks, i, 1) == owner && lk_get(k.locks, i, 5) == LKC_LEASE {
        return lk_get(k.locks, i, 2);
      }
      i = i + 1;
    }
    return F_UNLCK;
  }
  let ty = arg % 0x100000000;
  if ty != F_RDLCK && ty != F_WRLCK && ty != F_UNLCK {
    return EINVAL;
  }
  let m = vfs_meta(&mut k.fs, file);
  if m.ok && !owns(k.procs, pid, m.own) {
    return EACCES;
  }
  lock_drop(&mut k.locks, owner, file, LKC_LEASE);
  if ty == F_UNLCK {
    return 0;
  }
  let o = lk_opens(k, file);
  let opens = o % 0x100000000;
  let writers = o / 0x100000000;
  if ty == F_RDLCK && (writers > 0 || fget(k.fs.ftab, d.x, FD_MODE) / O_WRITE % 2 == 1) {
    return EAGAIN;
  }
  if ty == F_WRLCK && opens > 1 {
    return EAGAIN;
  }
  if lk_free_slot(k.locks) >= LK_N {
    return ENOLCK;
  }
  lk_put(&mut k.locks, file, LKC_LEASE, owner, ty, 0, LK_EOF);
  return 0;
}

/// Whether the struct flock at user address arg is well formed: 0, or
/// EFAULT, or EINVAL for an unknown l_type or l_whence.
fn flock_check(k: &mut Kernel, pid: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if copy_from_user(&mut k.spaces, pid, arg, &mut k.fs.xfer, FLOCK_SIZE) != FLOCK_SIZE {
    return EFAULT;
  }
  let ty = cast[u64](bget(k.fs.xfer, 0)) + 256 * cast[u64](bget(k.fs.xfer, 1));
  let whence = cast[u64](bget(k.fs.xfer, 2)) + 256 * cast[u64](bget(k.fs.xfer, 3));
  if (ty != F_RDLCK && ty != F_WRLCK && ty != F_UNLCK) || whence > 2 {
    return EINVAL;
  }
  return 0;
}

/// flock(fd, op): LOCK_SH, LOCK_EX or LOCK_UN on the whole file, owned
/// by fd's open file description; LOCK_NB (4) fails with -EWOULDBLOCK
/// instead of waiting. Returns 0, -errno, or LK_WAIT.
fn lx_flock(k: &mut Kernel, pid: u64, fd: u64, op: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let d = fd_look(k, pid, fd);
  if d.kind == K_BAD {
    return EBADF;
  }
  let o = op & !4;
  if o != 1 && o != 2 && o != 8 {
    return EINVAL;                          // LOCK_SH, LOCK_EX, LOCK_UN
  }
  let h = fd_ofd(k, pid, fd);
  if d.kind != K_FILE || h >= OFD_N {
    return 0;                               // nothing to lock against on a pipe or the console
  }
  let file = lk_file(k, d.x);
  if file == LK_EOF {
    return EBADF;
  }
  let owner = LK_DESC + h;
  let mut ty = F_UNLCK;
  if o == 1 {
    ty = F_RDLCK;
  } else if o == 2 {
    ty = F_WRLCK;
  }
  if ty != F_UNLCK && lk_conflict(k.locks, file, LKC_FLOCK, owner, ty, 0, LK_EOF) < LK_N {
    if op & 4 != 0 {
      return EAGAIN;                        // EWOULDBLOCK
    }
    return LK_WAIT;
  }
  return lk_apply(&mut k.locks, file, LKC_FLOCK, owner, ty, 0, LK_EOF);
}
