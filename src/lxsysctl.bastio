    return 3;
  }
  if i == 12 {
    return 65536;
  }
  if i == 13 {
    return 1048576;
  }
  if i == 14 {
    return 0;
  }
  if i == 15 {
    return 1;
  }
  if i == 16 {
    return 1;
  }
  if i == 17 {
    return 40;
  }
  if i == 18 {
    return 2;
  }
  if i == 19 {
    return 0;
  }
  if i == 20 {
    return 31000;
  }
  if i == 21 {
    return 65536;
  }
  if i == 22 {
    return 176;
  }
  if i == 23 {
    return 0;
  }
  if i == 24 {
    return 0;
  }
  if i == 25 {
    return 2;
  }
  if i == 26 {
    return 0;
  }
  if i == 27 {
    return 1;
  }
  if i == 28 {
    return 60;
  }
  if i == 29 {
    return 7200;
  }
  if i == 30 {
    return 2;
  }
  if i == 31 {
    return 212992;
  }
  if i == 32 {
    return 212992;
  }
  if i == 33 {
    return 1000;
  }
  if i == 34 {
    return 0;
  }
  if i == 35 {
    return 65536;                       // fs/aio-max-nr
  }
  if i == 36 {
    return 0;
  }
  if i == 37 {
