  }
  return 0;
}

/// The text of entry i, for the entries after the numbers.
fn sct_text(i: u64) -> Str {
  if i == 47 {
    return "32768\t60999\n";
  }
  if i == 48 {
    return "0\t0\t1048576\n";
  }
  if i == 49 {
    return "256\n";
  }
  if i == 50 {
    return "256\n";
  }
  return "\n";
}

// The directories under /proc/sys, so that they open, stat and list: the
// path of directory j, and its children (a name and whether it is itself a
// directory). Every file the kernel serves under /proc/sys is a child of
// its parent; t_proc lists each directory and opens what it lists.

const SYSD_N: u64 = 16;

fn sysd_path(j: u64) -> Str {
  if j == 0 {
    return "sys";
  }
  if j == 1 {
    return "sys/fs";
  }
  if j == 2 {
    return "sys/fs/inotify";
  }
  if j == 3 {
    return "sys/kernel";
  }
  if j == 4 {
    return "sys/kernel/random";
  }
  if j == 5 {
    return "sys/net";
  }
  if j == 6 {
    return "sys/net/core";
  }
  if j == 7 {
    return "sys/net/ipv4";
  }
  if j == 8 {
    return "sys/net/ipv6";
  }
  if j == 9 {
    return "sys/net/ipv6/conf";
  }
  if j == 10 {
    return "sys/net/ipv6/conf/all";
  }
  if j == 11 {
    return "sys/vm";
  }
  if j == 12 {
    return "sys/net/ipv4/conf";
  }
  if j == 13 {
    return "sys/net/ipv4/conf/all";
  }
  if j == 14 {
    return "sys/net/ipv4/conf/default";
  }
  if j == 15 {
    return "sys/net/ipv6/conf/default";
  }
  return "sys";
}

fn sysd_count(j: u64) -> u64 {
  if j == 0 {
    return 4;
  }
  if j == 1 {
    return 9;
  }
  if j == 2 {
    return 3;
  }
  if j == 3 {
    return 30;
  }
  if j == 4 {
    return 2;
  }
  if j == 5 {
    return 3;
  }
  if j == 6 {
    return 4;
  }
  if j == 7 {
    return 8;
  }
  if j == 8 {
    return 1;
  }
  if j == 9 {
    return 2;
  }
  if j == 10 {
    return 4;
  }
  if j == 11 {
    return 13;
  }
  if j == 12 {
    return 2;
  }
  if j == 13 {
    return 4;
  }
  if j == 14 {
    return 1;
  }
  if j == 15 {
    return 1;
  }
  return 0;
}

