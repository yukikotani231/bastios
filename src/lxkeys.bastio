// Kernel key retention: add_key, request_key and keyctl.
//
// KEY_N keys in a table (SYS_KEY in src/proc.bastio). A key is a keyring or
// a "user" or "logon" key; every key has a serial number (never reused), an
// owner, a permission word (possessor, user, group and other bytes of
// view, read, write, search, link and setattr bits), a description and,
// for user and logon keys, a payload of up to 32767 bytes. A keyring holds
// up to KL_N links to other keys (serials: a link to a key that has gone
// is dead and ignored). Descriptions are kept in k.mstr from KDB, payloads
// in KP_N slots from KPB, so at most KP_N keys hold a payload at a time.
//
// Each thread has a thread keyring, each thread group a process keyring
// (kept in its leader's row), each thread a session keyring that fork and
// clone hand on, and each user a user and a user session keyring. They are
// made when first used. Keys are not counted or reference counted: when
// the table is full a mark and sweep (kgc) frees every key no live process
// and no user keyring reaches.
//
// Not done: the "asymmetric" and other key types (ENODEV), big_key, the
// callout to /sbin/request-key (request_key finds a key that exists or says
// ENOKEY), quotas (EDQUOT only when the table is full), keyctl's
// instantiate, DH, public key, persistent and restriction commands, the
// proc files; execve does not drop the thread and process keyrings; the
// set-user-ID calls do not switch the user keyrings.

import "lxtime.bastio";
import "lxmisc.bastio";

const KT_RING: u64 = 1;
const KT_USER: u64 = 2;
const KT_LOGON: u64 = 3;

const KP_VIEW: u64 = 1;
const KP_READ: u64 = 2;
const KP_WRITE: u64 = 4;
const KP_SEARCH: u64 = 8;
const KP_LINK: u64 = 16;
const KP_SETATTR: u64 = 32;

const KE_NOKEY: u64 = 18446744073709551490;      // 2^64 - 126
const KE_EXPIRED: u64 = 18446744073709551489;    // 2^64 - 127
const KE_REVOKED: u64 = 18446744073709551488;    // 2^64 - 128
const KE_DQUOT: u64 = 18446744073709551494;      // 2^64 - 122
const KE_NODEV: u64 = 18446744073709551597;      // 2^64 - 19
const KE_DEADLK: u64 = 18446744073709551581;     // 2^64 - 35

const KPM_POS: u64 = 1056964608;                  // 0x3f000000: the possessor may do everything
const KPM_THREAD: u64 = KPM_POS + 65536;          // and the owner view (thread and process keyrings)
const KPM_SES: u64 = KPM_POS + 196608;            // view and read (session keyrings)
const KPM_USER: u64 = KPM_POS + 720896;           // view, read and search (user keyrings)
const KPM_LOGON: u64 = 1023410176;                // 0x3d000000: as a user key but not read (logon keys cannot be)
const KPAY_MAX: u64 = 32767;
const KROUNDS: u64 = 6;                          // levels of keyrings a search looks into

// Where the words are: a key's row, the links of a keyring, a process's
// four keyring words (thread, process, session, default for request_key),
// a user's row.
fn krow(s: u64, f: u64) -> u64
  requires s < KEY_N && f < KEY_W
  ensures result < SYS_LEN
{
  return SYS_KROW + s * KEY_W + f;
}

fn klnk(s: u64, i: u64) -> u64
  requires s < KEY_N && i < KL_N
  ensures result < SYS_LEN
{
  return SYS_KLNK + s * KL_N + i;
}

fn kprc(p: u64, f: u64) -> u64
  requires p < NPROC && f < 4
  ensures result < SYS_LEN
{
  return SYS_KPRC + p * 4 + f;
}

fn kusr(u: u64, f: u64) -> u64
  requires u < KU_N && f < 3
  ensures result < SYS_LEN
{
  return SYS_KUSR + u * 3 + f;
}

fn kr(k: &Kernel, s: u64, f: u64) -> u64
  requires kok(k) && s < KEY_N && f < KEY_W
{
  return get(k.sys, krow(s, f));
}

fn kw(k: &mut Kernel, s: u64, f: u64, v: u64)
  requires kok(k) && s < KEY_N && f < KEY_W
  ensures kok(k)
{
  k.sys = set(k.sys, krow(s, f), v);
}

/// The slot of the key with serial id, or KEY_N.
fn kfind(k: &Kernel, id: u64) -> u64
  requires kok(k)
  ensures result <= KEY_N
{
  if id == 0 {
    return KEY_N;
  }
  let mut s = 0;
  while s < KEY_N
    invariant s <= KEY_N && kok(k)
  {
    if get(k.sys, krow(s, 0)) == id {
      return s;
    }
    s = s + 1;
  }
  return KEY_N;
}

/// The process whose row holds the process keyring of pid's thread group.
fn ktg(k: &Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures result < NPROC
{
  let g = pget(k.procs, pid, F_TGID);
  if g == 0 || g >= NPROC {
    return pid;
  }
  return g;
}

fn know(k: &Kernel) -> u64 {
  return sat_add(k.epoch, k.ns) / NS_PER_S;
}

/// 0 if the key in slot s can be used, else the error for a revoked or an
/// expired one.
fn kstate(k: &Kernel, s: u64) -> u64
  requires kok(k) && s < KEY_N
{
  let st = kr(k, s, 9);
  if st == 2 {
    return KE_NOKEY;                            // negatively instantiated by a request_key that found no key
  }
  if st != 0 {
    return KE_REVOKED;
  }
  let e = kr(k, s, 5);
  if e != 0 && know(k) >= e {
    return KE_EXPIRED;
  }
  return 0;
}

/// Frees slot s: its row, its links and its payload slot (which the row
/// alone owns).
fn kfree(k: &mut Kernel, s: u64)
  requires kok(k) && s < KEY_N
  ensures kok(k)
{
  let mut f = 0;
  while f < KEY_W
    invariant f <= KEY_W && kok(k)
  {
    kw(&mut k, s, f, 0);
    f = f + 1;
  }
  let mut i = 0;
  while i < KL_N
    invariant i <= KL_N && kok(k)
  {
    k.sys = set(k.sys, klnk(s, i), 0);
    i = i + 1;
  }
}

/// The permission bits (view, read, write, search, link, setattr as 1, 2,
/// 4, 8, 16, 32) process pid has on the key in slot s: its owner's, or its
/// group's, or everyone else's, and the possessor's if poss.
fn kperm(k: &Kernel, pid: u64, s: u64, poss: bool) -> u64
  requires kok(k) && pid < NPROC && s < KEY_N
{
  let perm = kr(k, s, 4) % 4294967296;
  let mut m = perm % 256;
  if kr(k, s, 2) == fs_id(k.procs, pid, false) {
    m = perm / 65536 % 256;
  } else if kr(k, s, 3) == fs_id(k.procs, pid, true) {
    m = perm / 256 % 256;
  }
  if poss {
    m = m | perm / 16777216 % 256;
  }
  return m;
}

/// Does the key in slot s count as possessed by the process kmark last
/// marked for: a keyring of its own, or one a marked keyring links.
fn kposs(k: &Kernel, s: u64) -> bool
  requires kok(k) && s < KEY_N
{
  if kr(k, s, 11) == 1 {
    return true;
  }
  let id = kr(k, s, 0);
  let mut r = 0;
  while r < KEY_N
    invariant r <= KEY_N && kok(k)
  {
    if kr(k, r, 0) != 0 && kr(k, r, 11) == 1 && kr(k, r, 1) == KT_RING {
      let mut i = 0;
      while i < KL_N
        invariant i <= KL_N && kok(k)
      {
        if get(k.sys, klnk(r, i)) == id {
          return true;
        }
        i = i + 1;
      }
    }
    r = r + 1;
  }
  return false;
}

fn kallow(k: &Kernel, pid: u64, s: u64, need: u64) -> bool
  requires kok(k) && pid < NPROC && s < KEY_N
{
  return kperm(k, pid, s, kposs(k, s)) & need == need;
}

/// Marks (word 11) the keyrings process pid possesses: its thread, process
/// and session keyrings, and the keyrings those link that it may search,
/// KROUNDS levels down.
fn kmark(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut s = 0;
  while s < KEY_N
    invariant s <= KEY_N && kok(k)
  {
    kw(&mut k, s, 11, 0);
    kw(&mut k, s, 12, 0);
    s = s + 1;
  }
  let tg = ktg(k, pid);
  let mut f = 0;
  while f < 3
    invariant f <= 3 && kok(k) && tg < NPROC
  {
    let mut h = pid;
    if f == 1 {
      h = tg;
    }
    let r = kfind(k, get(k.sys, kprc(h, f)));
    if r < KEY_N {
      kw(&mut k, r, 11, 1);
    }
    f = f + 1;
  }
  let mut round = 0;
  while round < KROUNDS
    invariant round <= KROUNDS && kok(k)
  {
    let mut r = 0;
    while r < KEY_N
      invariant r <= KEY_N && kok(k)
    {
      if kr(k, r, 0) != 0 && kr(k, r, 1) == KT_RING && kr(k, r, 11) == 1 && kr(k, r, 12) == 0 {
        kw(&mut k, r, 12, 1);
        let mut i = 0;
        while i < KL_N
          invariant i <= KL_N && kok(k)
        {
          let c = kfind(k, get(k.sys, klnk(r, i)));
          if c < KEY_N && kr(k, c, 1) == KT_RING && kr(k, c, 11) == 0 && kstate(k, c) == 0 && kperm(k, pid, c, true) & KP_SEARCH != 0 {
            kw(&mut k, c, 11, 1);
          }
          i = i + 1;
        }
      }
      r = r + 1;
    }
    round = round + 1;
  }
}

/// Marks (word 13) the keys a live process or a user keyring reaches, and
/// frees the rest, except the keys with serials keep and keep2.
fn kgc(k: &mut Kernel, keep: u64, keep2: u64)
  requires kok(k)
  ensures kok(k)
{
  let mut s = 0;
  while s < KEY_N
    invariant s <= KEY_N && kok(k)
  {
    kw(&mut k, s, 13, 0);
    s = s + 1;
  }
  let kp = kfind(k, keep);
  if kp < KEY_N {
    kw(&mut k, kp, 13, 1);
  }
  let kp2 = kfind(k, keep2);
  if kp2 < KEY_N {
    kw(&mut k, kp2, 13, 1);
  }
  let mut p = 0;
  while p < NPROC
    invariant p <= NPROC && kok(k)
  {
    if pget(k.procs, p, F_STATE) != FREE {
      let mut f = 0;
      while f < 3
        invariant f <= 3 && p < NPROC && kok(k)
      {
        let r = kfind(k, get(k.sys, kprc(p, f)));
        if r < KEY_N {
          kw(&mut k, r, 13, 1);
        }
        f = f + 1;
      }
    }
    p = p + 1;
  }
  let mut u = 0;
  while u < KU_N
    invariant u <= KU_N && kok(k)
  {
    let mut f = 1;
    while f < 3
      invariant f <= 3 && u < KU_N && kok(k)
    {
      let r = kfind(k, get(k.sys, kusr(u, f)));
      if r < KEY_N {
        kw(&mut k, r, 13, 1);
      }
      f = f + 1;
    }
    u = u + 1;
  }
  let mut round = 0;
  while round < 8
    invariant round <= 8 && kok(k)
  {
    let mut r = 0;
    while r < KEY_N
      invariant r <= KEY_N && kok(k)
    {
      if kr(k, r, 0) != 0 && kr(k, r, 1) == KT_RING && kr(k, r, 13) == 1 {
        let mut i = 0;
        while i < KL_N
          invariant i <= KL_N && kok(k)
        {
          let c = kfind(k, get(k.sys, klnk(r, i)));
          if c < KEY_N {
            kw(&mut k, c, 13, 1);
          }
          i = i + 1;
        }
      }
      r = r + 1;
    }
    round = round + 1;
  }
  let mut q = 0;
  while q < KEY_N
    invariant q <= KEY_N && kok(k)
  {
    if kr(k, q, 0) != 0 && kr(k, q, 13) == 0 {
      kfree(&mut k, q);
    }
    q = q + 1;
  }
}

fn kfree_slot(k: &Kernel) -> u64
  requires kok(k)
  ensures result <= KEY_N
{
  let mut s = 0;
  while s < KEY_N
    invariant s <= KEY_N && kok(k)
  {
    if kr(k, s, 0) == 0 {
      return s;
    }
    s = s + 1;
  }
  return KEY_N;
}

/// A new key of type ty: its slot (the description is empty until kdesc_put
/// gives it one), or KE_DQUOT if the table is full. The key with serial
/// keep is spared by the sweep that may make room.
fn knew(k: &mut Kernel, ty: u64, uid: u64, gid: u64, perm: u64, keep: u64) -> u64
  requires kok(k)
  ensures kok(k)
{
  let mut s = kfree_slot(k);
  if s >= KEY_N {
    kgc(&mut k, keep, 0);
    s = kfree_slot(k);
  }
  if s >= KEY_N {
    return KE_DQUOT;
  }
  let c = get(k.sys, SYS_KEY);
  if c >= 1000000000 {
    return KE_DQUOT;
  }
  k.sys = set(k.sys, SYS_KEY, c + 1);
  kw(&mut k, s, 0, 100000 + c);
  kw(&mut k, s, 1, ty);
  kw(&mut k, s, 2, uid);
  kw(&mut k, s, 3, gid);
  kw(&mut k, s, 4, perm);
  let mut f = 5;
  while f < KEY_W
    invariant f <= KEY_W && s < KEY_N && kok(k)
  {
    kw(&mut k, s, f, 0);
    f = f + 1;
  }
  let mut i = 0;
  while i < KL_N
    invariant i <= KL_N && s < KEY_N && kok(k)
  {
    k.sys = set(k.sys, klnk(s, i), 0);
    i = i + 1;
  }
  return s;
}

/// Sets the description of the key in slot s to the first dl bytes of d.
fn kdesc_put(k: &mut Kernel, s: u64, d: &Bytes, dl: u64)
  requires kok(k) && s < KEY_N && dl < KDESC && dl <= blen(d)
  ensures kok(k)
{
  let mut i = 0;
  while i < dl
    invariant i <= dl && dl < KDESC && dl <= blen(d) && s < KEY_N && kok(k)
  {
    bset(&mut k.mstr, KDB + s * KDESC + i, bget(d, i));
    i = i + 1;
  }
  kw(&mut k, s, 6, dl);
}

/// Does the key in slot s have type ty and the description d (dl bytes)?
fn kmatch(k: &Kernel, s: u64, ty: u64, d: &Bytes, dl: u64) -> bool
  requires kok(k) && s < KEY_N && dl < KDESC && dl <= blen(d)
{
  if kr(k, s, 0) == 0 || kr(k, s, 1) != ty || kr(k, s, 6) != dl {
    return false;
  }
  let mut i = 0;
  while i < dl
    invariant i <= dl && dl < KDESC && dl <= blen(d) && s < KEY_N && kok(k)
  {
    if bget(k.mstr, KDB + s * KDESC + i) != bget(d, i) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// The index of the link in keyring r to the key with serial id, or KL_N.
fn kl_find(k: &Kernel, r: u64, id: u64) -> u64
  requires kok(k) && r < KEY_N
  ensures result <= KL_N
{
  let mut i = 0;
  while i < KL_N
    invariant i <= KL_N && r < KEY_N && kok(k)
  {
    if id != 0 && get(k.sys, klnk(r, i)) == id {
      return i;
    }
    i = i + 1;
  }
  return KL_N;
}

/// Links the key in slot s into keyring r, replacing a key of the same
/// type and description that r holds. 0, or KE_DQUOT if r is full.
fn kl_add(k: &mut Kernel, r: u64, s: u64) -> u64
  requires kok(k) && r < KEY_N && s < KEY_N
  ensures kok(k)
{
  let id = kr(k, s, 0);
  if kr(k, r, 15) == 1 {
    return EPERM;                               // a keyring restricted to reject every link
  }
  if kl_find(k, r, id) < KL_N {
    return 0;
  }
  let mut free = KL_N;
  let mut i = 0;
  while i < KL_N
    invariant i <= KL_N && free <= KL_N && r < KEY_N && s < KEY_N && kok(k)
  {
    let c = kfind(k, get(k.sys, klnk(r, i)));
    if c >= KEY_N {
      if free == KL_N {
        free = i;                              // empty, or a link to a key that has gone
      }
    } else if c != s && kr(k, c, 1) == kr(k, s, 1) && kr(k, c, 6) == kr(k, s, 6) {
      let dl = smaller(kr(k, s, 6), KDESC - 1);
      let mut same = true;
      let mut j = 0;
      while j < dl
        invariant j <= dl && dl < KDESC && c < KEY_N && s < KEY_N && kok(k)
      {
        if bget(k.mstr, KDB + c * KDESC + j) != bget(k.mstr, KDB + s * KDESC + j) {
          same = false;
        }
        j = j + 1;
      }
      if same {
        k.sys = set(k.sys, klnk(r, i), 0);     // the old one is replaced
        if kstate(k, c) != 0 {
          kfree(&mut k, c);                    // and if it was dead (revoked, expired, negative) it goes
        }
        if free == KL_N {
          free = i;
        }
      }
    }
    i = i + 1;
  }
  if free >= KL_N {
    return KE_DQUOT;
  }
  k.sys = set(k.sys, klnk(r, free), id);
  return 0;
}

/// The slot of the key of type ty and description d that keyring r links,
/// or KEY_N.
fn kl_lookup(k: &Kernel, r: u64, ty: u64, d: &Bytes, dl: u64) -> u64
  requires kok(k) && r < KEY_N && dl < KDESC && dl <= blen(d)
  ensures result <= KEY_N
{
  let mut i = 0;
  while i < KL_N
    invariant i <= KL_N && r < KEY_N && dl < KDESC && dl <= blen(d) && kok(k)
  {
    let c = kfind(k, get(k.sys, klnk(r, i)));
    if c < KEY_N && kmatch(k, c, ty, d, dl) {
      return c;
    }
    i = i + 1;
  }
  return KEY_N;
}

/// Can the keyring in slot r reach the key in slot t through its links?
fn kreach(k: &mut Kernel, r: u64, t: u64) -> bool
  requires kok(k) && r < KEY_N && t < KEY_N
  ensures kok(k)
{
  if r == t {
    return true;
  }
  let mut s = 0;
  while s < KEY_N
    invariant s <= KEY_N && kok(k)
  {
    kw(&mut k, s, 12, 0);
    kw(&mut k, s, 14, 0);
    s = s + 1;
  }
  kw(&mut k, r, 14, 1);
  let mut round = 0;
  while round < 8
    invariant round <= 8 && kok(k)
  {
    let mut q = 0;
    while q < KEY_N
      invariant q <= KEY_N && kok(k)
    {
      if kr(k, q, 0) != 0 && kr(k, q, 1) == KT_RING && kr(k, q, 14) == 1 && kr(k, q, 12) == 0 {
        kw(&mut k, q, 12, 1);
        let mut i = 0;
        while i < KL_N
          invariant i <= KL_N && kok(k)
        {
          let c = kfind(k, get(k.sys, klnk(q, i)));
          if c < KEY_N {
            if c == t {
              return true;
            }
            kw(&mut k, c, 14, 1);
          }
          i = i + 1;
        }
      }
      q = q + 1;
    }
    round = round + 1;
  }
  return false;
}

/// The first key of type ty and description d (dl bytes) that a search from
/// the keyring in slot root finds, going KROUNDS levels into keyrings it may
/// search; keyrings match too. The caller has run kmark. The slot of the
/// key, or an error: ENOKEY if none, or that of a matching key that is
/// revoked, expired or negative.
fn ksearch(k: &mut Kernel, pid: u64, root: u64, ty: u64, d: &Bytes, dl: u64) -> u64
  requires kok(k) && pid < NPROC && root < KEY_N && dl < KDESC && dl <= blen(d)
  ensures kok(k)
{
  let mut s = 0;
  while s < KEY_N
    invariant s <= KEY_N && kok(k)
  {
    kw(&mut k, s, 12, 0);
    kw(&mut k, s, 14, 0);
    s = s + 1;
  }
  kw(&mut k, root, 14, 1);
  let mut round = 0;
  while round < KROUNDS
    invariant round <= KROUNDS && kok(k)
  {
    let mut q = 0;
    while q < KEY_N
      invariant q <= KEY_N && kok(k)
    {
      if kr(k, q, 0) != 0 && kr(k, q, 1) == KT_RING && kr(k, q, 14) == 1 && kr(k, q, 12) == 0 {
        kw(&mut k, q, 12, 1);
        let mut i = 0;
        while i < KL_N
          invariant i <= KL_N && kok(k)
        {
          let c = kfind(k, get(k.sys, klnk(q, i)));
          if c < KEY_N && kr(k, c, 1) == KT_RING && kr(k, c, 14) == 0 && kstate(k, c) == 0 && kperm(k, pid, c, kposs(k, c)) & KP_SEARCH != 0 {
            kw(&mut k, c, 14, 1);
          }
          i = i + 1;
        }
      }
      q = q + 1;
    }
    round = round + 1;
  }
  // The ring itself, then what the visited keyrings link.
  let mut bad = KE_NOKEY;
  if kmatch(k, root, ty, d, dl) {
    let st = kstate(k, root);
    if st == 0 {
      return root;
    }
    bad = st;
  }
  let mut q = 0;
  while q < KEY_N
    invariant q <= KEY_N && kok(k)
  {
    if kr(k, q, 0) != 0 && kr(k, q, 1) == KT_RING && kr(k, q, 14) == 1 {
      let mut i = 0;
      while i < KL_N
        invariant i <= KL_N && kok(k)
      {
        let c = kfind(k, get(k.sys, klnk(q, i)));
        if c < KEY_N && kmatch(k, c, ty, d, dl) && kperm(k, pid, c, kposs(k, c)) & KP_SEARCH != 0 {
          let st = kstate(k, c);
          if st == 0 {
            return c;
          }
          if bad == KE_NOKEY {
            bad = st;
          }
        }
        i = i + 1;
      }
    }
    q = q + 1;
  }
  return bad;
}

// ------------------------------------------------------------ keyrings made on use

/// The name of a special keyring, kind 1 thread, 2 process, 3 session,
/// 4 user, 5 user session; the two user ones carry uid.
fn kname(kind: u64, uid: u64, d: &mut Bytes) -> u64
  requires blen(d) >= KDESC
  ensures result < KDESC
{
  if kind == 1 {
    return smaller(bytes_put_str(&mut d, 0, "_tid"), KDESC - 1);
  }
  if kind == 2 {
    return smaller(bytes_put_str(&mut d, 0, "_pid"), KDESC - 1);
  }
  if kind == 3 {
    return smaller(bytes_put_str(&mut d, 0, "_ses"), KDESC - 1);
  }
  let a = bytes_put_str(&mut d, 0, "_uid");
  if kind == 5 {
    let b = bytes_put_str(&mut d, a, "_ses");
    return smaller(bytes_put_u64(&mut d, bytes_put_c(&mut d, b, 46), uid), KDESC - 1);
  }
  return smaller(bytes_put_u64(&mut d, bytes_put_c(&mut d, a, 46), uid), KDESC - 1);
}

fn bytes_put_c(d: &mut Bytes, at: u64, c: u8) -> u64
  requires at <= blen(d)
  ensures blen(d) == blen(old(d)) && at <= result && result <= blen(d)
{
  if at >= blen(d) {
    return at;
  }
  bset(&mut d, at, c);
  return at + 1;
}

/// A new keyring of kind (see kname) for process pid, linked nowhere: its
/// slot, or an error.
fn kring_make(k: &mut Kernel, pid: u64, kind: u64, perm: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let uid = fs_id(k.procs, pid, false);
  let s = knew(&mut k, KT_RING, uid, fs_id(k.procs, pid, true), perm, 0);
  if s >= KEY_N {
    return s;
  }
  let mut d = balloc(KDESC);
  let dl = kname(kind, uid, &mut d);
  kdesc_put(&mut k, s, d, dl);
  bfree(d);
  kw(&mut k, s, 11, 1);
  return s;
}

/// The serial of user uid's user keyring (which 1) or user session keyring
/// (which 2), made if create; or an error.
fn kuser_ring(k: &mut Kernel, pid: u64, uid: u64, which: u64, create: bool) -> u64
  requires kok(k) && pid < NPROC && (which == 1 || which == 2) && uid < 0x100000000
  ensures kok(k)
{
  let mut row = KU_N;
  let mut free = KU_N;
  let mut u = 0;
  while u < KU_N
    invariant u <= KU_N && row <= KU_N && free <= KU_N && kok(k)
  {
    let w = get(k.sys, kusr(u, 0));
    if w == uid + 1 && row == KU_N {
      row = u;
    }
    if w == 0 && free == KU_N {
      free = u;
    }
    u = u + 1;
  }
  if row == KU_N {
    if !create || free == KU_N {
      if !create {
        return KE_NOKEY;
      }
      return KE_DQUOT;
    }
    k.sys = set(k.sys, kusr(free, 0), uid + 1);
    k.sys = set(k.sys, kusr(free, 1), 0);
    k.sys = set(k.sys, kusr(free, 2), 0);
    row = free;
  }
  let cur = get(k.sys, kusr(row, which));
  if kfind(k, cur) < KEY_N {
    return cur;
  }
  if !create {
    return KE_NOKEY;
  }
  let s = kring_make(&mut k, pid, 3 + which, KPM_USER);
  if s >= KEY_N {
    return s;
  }
  let id = kr(k, s, 0);
  k.sys = set(k.sys, kusr(row, which), id);
  return id;
}

/// The serial of the special keyring sp (1 thread .. 8) of process pid,
/// made if create (the session keyring always is), or an error.
fn kspecial(k: &mut Kernel, pid: u64, sp: u64, create: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if sp >= 1 && sp <= 3 {
    let mut h = pid;
    if sp == 2 {
      h = ktg(k, pid);
    }
    let cur = get(k.sys, kprc(h, sp - 1));
    if kfind(k, cur) < KEY_N {
      return cur;
    }
    if !create {
      return KE_NOKEY;
    }
    let mut perm = KPM_THREAD;
    if sp == 3 {
      perm = KPM_SES;
    }
    let s = kring_make(&mut k, pid, sp, perm);
    if s >= KEY_N {
      return s;
    }
    let id = kr(k, s, 0);
    k.sys = set(k.sys, kprc(h, sp - 1), id);
    return id;
  }
  if sp == 4 || sp == 5 {
    return kuser_ring(&mut k, pid, fs_id(k.procs, pid, false), sp - 3, true);
  }
  if sp == 7 || sp == 8 {
    return KE_NOKEY;
  }
  return EINVAL;
}

/// The slot of the key a user names by id (a serial, or a negative
/// special id as a 32-bit number); create makes a special keyring that is
/// not there. Needs the permissions in need (0 for none) unless partial
/// also allows a key that is revoked or expired. An error if it cannot.
fn kres(k: &mut Kernel, pid: u64, a: u64, create: bool, need: u64, partial: bool) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let id = a % 4294967296;
  let mut ser = id;
  if id >= 2147483648 {
    let sp = 4294967296 - id;
    ser = kspecial(&mut k, pid, sp, create || sp == 3);
    if ser >= 2147483648 {
      return ser;
    }
  }
  let s = kfind(k, ser);
  if s >= KEY_N {
    return KE_NOKEY;
  }
  if !partial {
    let st = kstate(k, s);
    if st != 0 {
      return st;
    }
  }
  if need != 0 && !kallow(k, pid, s, need) {
    return EACCES;
  }
  return s;
}

/// The type number for the name nm (nl bytes): 1 keyring, 2 user, 3 logon,
/// 0 for none.
fn ktype(nm: &Bytes, nl: u64) -> u64
  requires nl < 32 && nl <= blen(nm)
  ensures result <= 3
{
  if nl == 7 && bget(nm, 0) == 107 && bget(nm, 1) == 101 && bget(nm, 2) == 121 && bget(nm, 3) == 114 && bget(nm, 4) == 105 && bget(nm, 5) == 110 && bget(nm, 6) == 103 {
    return KT_RING;
  }
  if nl == 4 && bget(nm, 0) == 117 && bget(nm, 1) == 115 && bget(nm, 2) == 101 && bget(nm, 3) == 114 {
    return KT_USER;
  }
  if nl == 5 && bget(nm, 0) == 108 && bget(nm, 1) == 111 && bget(nm, 2) == 103 && bget(nm, 3) == 111 && bget(nm, 4) == 110 {
    return KT_LOGON;
  }
  return 0;
}

/// The string at user address va into d (which holds at least max bytes):
/// its length (below max), NO_RESULT for a bad address, ERANGE if it is
/// too long. One byte at a time, so a string that ends just before an
/// unmapped page reads.
fn ks_in(k: &mut Kernel, pid: u64, va: u64, d: &mut Bytes, max: u64) -> u64
  requires kok(k) && pid < NPROC && blen(d) >= max && max <= KDESC
  ensures kok(k)
  ensures result < max || result == NO_RESULT || result == ERANGE
{
  if va >= 0x800000000000 {
    return NO_RESULT;
  }
  let mut i = 0;
  while i < max
    invariant i <= max && blen(d) >= max && max <= KDESC && va < 0x800000000000 && kok(k)
  {
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + i, &mut k.fs.xfer, 1) != 1 {
      return NO_RESULT;
    }
    let c = bget(k.fs.xfer, 0);
    if c == 0 {
      return i;
    }
    bset(&mut d, i, c);
    i = i + 1;
  }
  return ERANGE;
}

// ------------------------------------------------------------ payloads

/// A payload slot no key owns, or KP_N.
fn kpay_free(k: &Kernel) -> u64
  requires kok(k)
  ensures result <= KP_N
{
  let mut p = 0;
  while p < KP_N
    invariant p <= KP_N && kok(k)
  {
    let mut used = false;
    let mut s = 0;
    while s < KEY_N
      invariant s <= KEY_N && kok(k)
    {
      if kr(k, s, 0) != 0 && kr(k, s, 8) == p + 1 {
        used = true;
      }
      s = s + 1;
    }
    if !used {
      return p;
    }
    p = p + 1;
  }
  return KP_N;
}

/// Copies plen bytes from user address va into payload slot pi. 0, or EFAULT.
fn kpay_in(k: &mut Kernel, pid: u64, pi: u64, va: u64, plen: u64) -> u64
  requires kok(k) && pid < NPROC && pi < KP_N && plen <= KPAY
  ensures kok(k)
{
  if plen > 0 && va >= 0x800000000000 {
    return EFAULT;
  }
  let mut off = 0;
  while off < plen
    invariant off <= plen && plen <= KPAY && pi < KP_N && kok(k) && (plen == 0 || va < 0x800000000000)
  {
    let n = smaller(plen - off, XFER);
    if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + off, &mut k.fs.xfer, n) != n {
      return EFAULT;
    }
    let mut j = 0;
    while j < n
      invariant j <= n && n <= XFER && off + n <= plen && plen <= KPAY && pi < KP_N && kok(k)
    {
      bset(&mut k.mstr, KPB + pi * KPAY + off + j, bget(k.fs.xfer, j));
      j = j + 1;
    }
    off = off + n;
  }
  return 0;
}

/// Gives the key in slot s a payload of plen bytes from user address va
/// (the old payload stays if that fails). 0 or an error.
fn kpay_set(k: &mut Kernel, pid: u64, s: u64, va: u64, plen: u64, keep: u64) -> u64
  requires kok(k) && pid < NPROC && s < KEY_N && plen <= KPAY
  ensures kok(k)
{
  let prev = kr(k, s, 8);
  kw(&mut k, s, 8, 0);                          // frees its slot for the copy, if it had one
  let mut pi = kpay_free(k);
  if pi >= KP_N {
    kgc(&mut k, kr(k, s, 0), keep);             // keys no one reaches any more give theirs up
    pi = kpay_free(k);
  }
  if pi >= KP_N {
    kw(&mut k, s, 8, prev);
    return ENOMEM;
  }
  let e = kpay_in(&mut k, pid, pi, va, plen);
  if e != 0 {
    kw(&mut k, s, 8, prev);
    return e;
  }
  kw(&mut k, s, 7, plen);
  kw(&mut k, s, 8, pi + 1);
  return 0;
}

// ------------------------------------------------------------ the calls

/// add_key(type, description, payload, plen, ring).
fn key_add(k: &mut Kernel, pid: u64, tva: u64, dva: u64, pva: u64, plen: u64, ring: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut tb = balloc(32);
  let tl = ks_in(&mut k, pid, tva, &mut tb, 32);
  if tl == NO_RESULT || tl == ERANGE {
    bfree(tb);
    if tl == NO_RESULT {
      return EFAULT;
    }
    return EINVAL;
  }
  let mut db = balloc(KDESC);
  let dl = ks_in(&mut k, pid, dva, &mut db, KDESC);
  if dl == NO_RESULT || dl == ERANGE {
    bfree(tb);
    bfree(db);
    if dl == NO_RESULT {
      return EFAULT;
    }
    return EINVAL;
  }
  let r = key_add2(&mut k, pid, tb, tl, db, dl, pva, plen, ring);
  bfree(tb);
  bfree(db);
  return r;
}

fn key_add2(k: &mut Kernel, pid: u64, tb: &Bytes, tl: u64, db: &Bytes, dl: u64, pva: u64, plen: u64, ring: u64) -> u64
  requires kok(k) && pid < NPROC && tl < 32 && tl <= blen(tb) && dl < KDESC && dl <= blen(db)
  ensures kok(k)
{
  if tl > 0 && bget(tb, 0) == 46 {
    return EPERM;                               // types starting with a dot are the kernel's
  }
  if plen > 1048575 {
    return EINVAL;
  }
  if plen > 0 && pva == 0 {
    return EFAULT;
  }
  if plen > 0 && plen <= KPAY_MAX && copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, pva, &mut k.fs.xfer, 1) != 1 {
    return EFAULT;
  }
  let ty = ktype(tb, tl);
  if ty == 0 {
    return KE_NODEV;
  }
  if ty == KT_RING && plen != 0 {
    return EINVAL;
  }
  if ty != KT_RING && (plen == 0 || plen > KPAY_MAX) {
    return EINVAL;
  }
  if ty == KT_LOGON {
    let mut colon = false;
    let mut i = 0;
    while i < dl
      invariant i <= dl && dl < KDESC && dl <= blen(db)
    {
      if bget(db, i) == 58 {
        colon = true;
      }
      i = i + 1;
    }
    if !colon {
      return EINVAL;
    }
  }
  kmark(&mut k, pid);
  let r = kres(&mut k, pid, ring, true, KP_WRITE, false);
  if r >= KEY_N {
    return r;
  }
  if kr(k, r, 1) != KT_RING {
    return ENOTDIR;
  }
  // A key of the same type and description in the ring is updated, if the
  // type allows it; a keyring is replaced.
  let prev = kl_lookup(k, r, ty, db, dl);
  if prev < KEY_N && ty != KT_RING {
    if kstate(k, prev) != 0 {
      // a revoked or expired key is replaced like a keyring
    } else {
      if !kallow(k, pid, prev, KP_WRITE) {
        return EACCES;
      }
      let e = kpay_set(&mut k, pid, prev, pva, plen, kr(k, r, 0));
      if e != 0 {
        return e;
      }
      return kr(k, prev, 0);
    }
  }
  let uid = fs_id(k.procs, pid, false);
  let mut perm = KPM_LOGON;
  if ty == KT_USER || ty == KT_RING {
    perm = KPM_POS;
  }
  let s = knew(&mut k, ty, uid, fs_id(k.procs, pid, true), perm, kr(k, r, 0));
  if s >= KEY_N {
    return s;
  }
  kdesc_put(&mut k, s, db, dl);
  if ty != KT_RING {
    let e = kpay_set(&mut k, pid, s, pva, plen, kr(k, r, 0));
    if e != 0 {
      kfree(&mut k, s);
      return e;
    }
  }
  let e2 = kl_add(&mut k, r, s);
  if e2 != 0 {
    kfree(&mut k, s);
    return e2;
  }
  return kr(k, s, 0);
}

/// request_key(type, description, callout, dest): the key a search of the
/// thread, process and session keyrings finds. There is no helper program to
/// make one, so a key that is not there is ENOKEY.
fn key_request(k: &mut Kernel, pid: u64, tva: u64, dva: u64, cva: u64, dest: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut tb = balloc(32);
  let tl = ks_in(&mut k, pid, tva, &mut tb, 32);
  if tl == NO_RESULT || tl == ERANGE {
    bfree(tb);
    if tl == NO_RESULT {
      return EFAULT;
    }
    return EINVAL;
  }
  let mut db = balloc(KDESC);
  let dl = ks_in(&mut k, pid, dva, &mut db, KDESC);
  if dl == NO_RESULT || dl == ERANGE {
    bfree(tb);
    bfree(db);
    if dl == NO_RESULT {
      return EFAULT;
    }
    return EINVAL;
  }
  let r = key_request2(&mut k, pid, tb, tl, db, dl, cva, dest);
  bfree(tb);
  bfree(db);
  return r;
}

fn key_request2(k: &mut Kernel, pid: u64, tb: &Bytes, tl: u64, db: &Bytes, dl: u64, cva: u64, dest: u64) -> u64
  requires kok(k) && pid < NPROC && tl < 32 && tl <= blen(tb) && dl < KDESC && dl <= blen(db)
  ensures kok(k)
{
  if tl > 0 && bget(tb, 0) == 46 {
    return EPERM;
  }
  if cva != 0 {
    let mut cb = balloc(KDESC);
    let cl = ks_in(&mut k, pid, cva, &mut cb, KDESC);
    bfree(cb);
    if cl == NO_RESULT {
      return EFAULT;
    }
  }
  let ty = ktype(tb, tl);
  if ty == 0 {
    return KE_NODEV;
  }
  kmark(&mut k, pid);
  let mut dr = KEY_N;
  if dest != 0 {
    dr = kres(&mut k, pid, dest, true, KP_WRITE, false);
    if dr >= KEY_N {
      return dr;
    }
    if kr(k, dr, 1) != KT_RING {
      return ENOTDIR;
    }
  }
  let mut found = KE_NOKEY;
  let tg = ktg(k, pid);
  let mut f = 0;
  while f < 3
    invariant f <= 3 && tg < NPROC && kok(k)
  {
    let mut h = pid;
    if f == 1 {
      h = tg;
    }
    let root = kfind(k, get(k.sys, kprc(h, f)));
    if found >= KEY_N && root < KEY_N {
      let r = ksearch(&mut k, pid, root, ty, db, dl);
      if r < KEY_N || found == KE_NOKEY {
        found = r;
      }
    }
    f = f + 1;
  }
  if found < KEY_N {
    if dr < KEY_N {
      if !kallow(k, pid, found, KP_LINK) {
        return EACCES;
      }
      let e = kl_add(&mut k, dr, found);
      if e != 0 {
        return e;
      }
    }
    return kr(k, found, 0);
  }
  if cva == 0 || found != KE_NOKEY {
    return found;
  }
  // There is no helper to make the key: a negative key stands for the
  // failed attempt, in the ring the request would have used.
  if dr >= KEY_N {
    dr = kdefault(&mut k, pid);
    if dr >= KEY_N {
      return dr;
    }
  }
  if !kallow(k, pid, dr, KP_WRITE) {
    return EACCES;
  }
  let s = knew(&mut k, ty, fs_id(k.procs, pid, false), fs_id(k.procs, pid, true), KPM_THREAD, kr(k, dr, 0));
  if s >= KEY_N {
    return s;
  }
  kdesc_put(&mut k, s, db, dl);
  kw(&mut k, s, 9, 2);
  kw(&mut k, s, 5, sat_add(know(k), 60));
  let e2 = kl_add(&mut k, dr, s);
  if e2 != 0 {
    kfree(&mut k, s);
    return e2;
  }
  return KE_NOKEY;
}

/// The keyring request_key puts a key in when it is not told: the one the
/// process asked for (SET_REQKEY_KEYRING), or by default the thread keyring,
/// else the process keyring, else the session keyring. A slot, or an error.
fn kdefault(k: &mut Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let want = get(k.sys, kprc(pid, 3));
  let mut sp = 3;
  if want == 0 {
    let tg = ktg(k, pid);
    if kfind(k, get(k.sys, kprc(pid, 0))) < KEY_N {
      sp = 1;
    } else if kfind(k, get(k.sys, kprc(tg, 1))) < KEY_N {
      sp = 2;
    }
  } else if want >= 1 && want <= 5 {
    sp = want;
  }
  let id = kspecial(&mut k, pid, sp, true);
  if id >= 2147483648 {
    return id;
  }
  return kfind(k, id);
}

// keyctl commands
const KC_GET_KEYRING_ID: u64 = 0;
const KC_JOIN_SESSION: u64 = 1;
const KC_UPDATE: u64 = 2;
const KC_REVOKE: u64 = 3;
const KC_CHOWN: u64 = 4;
const KC_SETPERM: u64 = 5;
const KC_DESCRIBE: u64 = 6;
const KC_CLEAR: u64 = 7;
const KC_LINK: u64 = 8;
const KC_UNLINK: u64 = 9;
const KC_SEARCH: u64 = 10;
const KC_READ: u64 = 11;
const KC_SET_REQKEY: u64 = 14;
const KC_SET_TIMEOUT: u64 = 15;
const KC_GET_SECURITY: u64 = 17;
const KC_INVALIDATE: u64 = 21;
const KC_RESTRICT: u64 = 29;
const KC_MOVE: u64 = 30;

/// Writes n bytes (at most XFER) of the transfer buffer to user address va
/// and gives total: all of them if size has room for total, else nothing
/// (or as many as fit, if part).
fn kout(k: &mut Kernel, pid: u64, va: u64, size: u64, n: u64, total: u64, part: bool) -> u64
  requires kok(k) && pid < NPROC && n <= XFER
  ensures kok(k)
{
  if va != 0 && size != 0 && (part || size >= total) {
    let m = smaller(n, size);
    if m > 0 && copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, m) != m {
      return EFAULT;
    }
  }
  return total;
}

/// KEYCTL_DESCRIBE: "type;uid;gid;perm;description", with its NUL.
fn key_describe(k: &mut Kernel, pid: u64, s: u64, va: u64, size: u64) -> u64
  requires kok(k) && pid < NPROC && s < KEY_N
  ensures kok(k)
{
  let mut o = balloc(512);
  let ty = kr(k, s, 1);
  let mut a = 0;
  if ty == KT_RING {
    a = bytes_put_str(&mut o, a, "keyring");
  } else if ty == KT_USER {
    a = bytes_put_str(&mut o, a, "user");
  } else {
    a = bytes_put_str(&mut o, a, "logon");
  }
  a = bytes_put_c(&mut o, a, 59);
  a = bytes_put_u64(&mut o, a, kr(k, s, 2));
  a = bytes_put_c(&mut o, a, 59);
  a = bytes_put_u64(&mut o, a, kr(k, s, 3));
  a = bytes_put_c(&mut o, a, 59);
  let perm = kr(k, s, 4) % 4294967296;
  let mut sh = 8;
  while sh > 0
    invariant sh <= 8 && a <= blen(o) && blen(o) == 512
  {
    sh = sh - 1;
    let dg = (perm >> (4 * sh)) & 15;
    if dg < 10 {
      a = bytes_put_c(&mut o, a, cast[u8](48 + dg));
    } else {
      a = bytes_put_c(&mut o, a, cast[u8](87 + dg));
    }
  }
  a = bytes_put_c(&mut o, a, 59);
  let dl = smaller(kr(k, s, 6), KDESC - 1);
  let mut i = 0;
  while i < dl
    invariant i <= dl && dl < KDESC && a <= blen(o) && blen(o) == 512 && s < KEY_N && kok(k)
  {
    a = bytes_put_c(&mut o, a, bget(k.mstr, KDB + s * KDESC + i));
    i = i + 1;
  }
  a = bytes_put_c(&mut o, a, 0);
  let n = smaller(a, XFER);
  let mut j = 0;
  while j < n
    invariant j <= n && n <= XFER && n <= blen(o) && kok(k)
  {
    bset(&mut k.fs.xfer, j, bget(o, j));
    j = j + 1;
  }
  bfree(o);
  return kout(&mut k, pid, va, size, n, a, false);
}

/// KEYCTL_READ.
fn key_read(k: &mut Kernel, pid: u64, s: u64, va: u64, size: u64) -> u64
  requires kok(k) && pid < NPROC && s < KEY_N
  ensures kok(k)
{
  let ty = kr(k, s, 1);
  if ty == KT_LOGON {
    return EOPNOTSUPP;
  }
  if ty == KT_RING {
    let mut n = 0;
    let mut i = 0;
    while i < KL_N
      invariant i <= KL_N && n <= i * 4 && s < KEY_N && kok(k)
    {
      let c = kfind(k, get(k.sys, klnk(s, i)));
      if c < KEY_N {
        let id = kr(k, c, 0) % 4294967296;
        bset(&mut k.fs.xfer, n, cast[u8](id % 256));
        bset(&mut k.fs.xfer, n + 1, cast[u8](id / 256 % 256));
        bset(&mut k.fs.xfer, n + 2, cast[u8](id / 65536 % 256));
        bset(&mut k.fs.xfer, n + 3, cast[u8](id / 16777216 % 256));
        n = n + 4;
      }
      i = i + 1;
    }
    return kout(&mut k, pid, va, size - size % 4, n, n, true);
  }
  let plen = kr(k, s, 7);
  let pi = kr(k, s, 8);
  if pi == 0 || pi > KP_N || plen > KPAY {
    return 0;
  }
  if va == 0 || size == 0 {
    return plen;
  }
  let want = smaller(plen, size);
  let mut off = 0;
  while off < want
    invariant off <= want && want <= KPAY && pi >= 1 && pi <= KP_N && kok(k)
  {
    let n = smaller(want - off, XFER);
    let mut j = 0;
    while j < n
      invariant j <= n && n <= XFER && off + n <= want && want <= KPAY && pi >= 1 && pi <= KP_N && kok(k)
    {
      bset(&mut k.fs.xfer, j, bget(k.mstr, KPB + (pi - 1) * KPAY + off + j));
      j = j + 1;
    }
    if va >= 0x800000000000 || copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va + off, k.fs.xfer, n) != n {
      return EFAULT;
    }
    off = off + n;
  }
  return plen;
}

/// KEYCTL_JOIN_SESSION_KEYRING(name): makes (or finds, if named) a session
/// keyring for the calling thread.
fn key_join(k: &mut Kernel, pid: u64, nva: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut d = balloc(KDESC);
  let mut dl = 0;
  if nva != 0 {
    dl = ks_in(&mut k, pid, nva, &mut d, KDESC);
  }
  if dl == NO_RESULT || dl == ERANGE || (nva != 0 && dl == 0) {
    bfree(d);
    if dl == NO_RESULT {
      return EFAULT;
    }
    return EINVAL;
  }
  if nva != 0 && bget(d, 0) == 46 {
    bfree(d);
    return EPERM;                               // the kernel's own keyrings cannot be joined
  }
  kmark(&mut k, pid);
  let mut s = KEY_N;
  if nva != 0 {
    let mut q = 0;
    while q < KEY_N
      invariant q <= KEY_N && s <= KEY_N && dl < KDESC && dl <= blen(d) && kok(k)
    {
      if s == KEY_N && kr(k, q, 10) == 1 && kmatch(k, q, KT_RING, d, dl) && kstate(k, q) == 0
         && kperm(k, pid, q, kposs(k, q)) & KP_SEARCH != 0 {
        s = q;   // a ring the caller may not search does not exist for it, as on Linux
      }
      q = q + 1;
    }
  }
  if s >= KEY_N {
    s = knew(&mut k, KT_RING, fs_id(k.procs, pid, false), fs_id(k.procs, pid, true), KPM_SES, 0);
    if s >= KEY_N {
      bfree(d);
      return s;
    }
    if nva != 0 {
      kdesc_put(&mut k, s, d, dl);
      kw(&mut k, s, 10, 1);
    } else {
      let mut n = balloc(KDESC);
      let nl = kname(3, 0, &mut n);
      kdesc_put(&mut k, s, n, nl);
      bfree(n);
    }
  }
  bfree(d);
  let id = kr(k, s, 0);
  k.sys = set(k.sys, kprc(pid, 2), id);
  return id;
}

/// keyctl(cmd, a, b, c, d).
fn key_ctl(k: &mut Kernel, pid: u64, cmd: u64, a: u64, b: u64, c: u64, d: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if cmd == KC_JOIN_SESSION {
    return key_join(&mut k, pid, a);
  }
  if cmd == KC_SET_REQKEY {
    let v = a % 4294967296;
    let cur = get(k.sys, kprc(pid, 3));
    if v == 4294967295 {
      return cur;                               // KEY_REQKEY_DEFL_NO_CHANGE
    }
    if v == 6 || v > 7 {
      return EINVAL;
    }
    if v == 1 || v == 2 {
      let sp = kspecial(&mut k, pid, v, true);
      if sp >= 2147483648 {
        return sp;
      }
    }
    k.sys = set(k.sys, kprc(pid, 3), v);
    return cur;
  }
  kmark(&mut k, pid);
  if cmd == KC_GET_KEYRING_ID {
    let s = kres(&mut k, pid, a, b != 0, 0, false);
    if s >= KEY_N {
      return s;
    }
    return kr(k, s, 0);
  }
  if cmd == KC_UPDATE {
    let s = kres(&mut k, pid, a, false, KP_WRITE, false);
    if s >= KEY_N {
      return s;
    }
    if kr(k, s, 1) == KT_RING {
      return EOPNOTSUPP;
    }
    if c == 0 || c > KPAY_MAX {
      return EINVAL;
    }
    if b == 0 {
      return EFAULT;
    }
    let e = kpay_set(&mut k, pid, s, b, c, 0);
    return e;
  }
  if cmd == KC_REVOKE {
    let s = kres(&mut k, pid, a, false, 0, false);
    if s >= KEY_N {
      return s;
    }
    if !kallow(k, pid, s, KP_WRITE) && !kallow(k, pid, s, KP_SETATTR) {
      return EACCES;
    }
    kw(&mut k, s, 9, 1);
    return 0;
  }
  if cmd == KC_INVALIDATE {
    let s = kres(&mut k, pid, a, false, KP_SEARCH, true);
    if s >= KEY_N {
      return s;
    }
    kfree(&mut k, s);
    return 0;
  }
  if cmd == KC_CHOWN {
    let s = kres(&mut k, pid, a, false, KP_SETATTR, false);
    if s >= KEY_N {
      return s;
    }
    if fs_id(k.procs, pid, false) != 0 {
      return EACCES;
    }
    if b % 4294967296 != 4294967295 {
      kw(&mut k, s, 2, b % 4294967296);
    }
    if c % 4294967296 != 4294967295 {
      kw(&mut k, s, 3, c % 4294967296);
    }
    return 0;
  }
  if cmd == KC_SETPERM {
    let s = kres(&mut k, pid, a, false, KP_SETATTR, false);
    if s >= KEY_N {
      return s;
    }
    if b > 4294967295 {
      return EINVAL;
    }
    if fs_id(k.procs, pid, false) != 0 && kr(k, s, 2) != fs_id(k.procs, pid, false) {
      return EACCES;
    }
    kw(&mut k, s, 4, b);
    return 0;
  }
  if cmd == KC_DESCRIBE {
    let s = kres(&mut k, pid, a, false, KP_VIEW, false);
    if s >= KEY_N {
      return s;
    }
    return key_describe(&mut k, pid, s, b, c);
  }
  if cmd == KC_READ {
    let s = kres(&mut k, pid, a, false, 0, false);
    if s >= KEY_N {
      return s;
    }
    if !kallow(k, pid, s, KP_READ) && !(kr(k, s, 1) == KT_RING && kallow(k, pid, s, KP_VIEW)) {
      return EACCES;
    }
    return key_read(&mut k, pid, s, b, c);
  }
  if cmd == KC_CLEAR {
    let s = kres(&mut k, pid, a, false, KP_WRITE, false);
    if s >= KEY_N {
      return s;
    }
    if kr(k, s, 1) != KT_RING {
      return ENOTDIR;
    }
    let mut i = 0;
    while i < KL_N
      invariant i <= KL_N && s < KEY_N && kok(k)
    {
      k.sys = set(k.sys, klnk(s, i), 0);
      i = i + 1;
    }
    return 0;
  }
  if cmd == KC_LINK || cmd == KC_UNLINK {
    let r = kres(&mut k, pid, b, false, KP_WRITE, false);
    if r >= KEY_N {
      return r;
    }
    if kr(k, r, 1) != KT_RING {
      return ENOTDIR;
    }
    if cmd == KC_UNLINK {
      let t = kres(&mut k, pid, a, false, 0, true);
      if t >= KEY_N {
        return t;
      }
      let i = kl_find(k, r, kr(k, t, 0));
      if i >= KL_N {
        return ENOENT;
      }
      k.sys = set(k.sys, klnk(r, i), 0);
      return 0;
    }
    let t = kres(&mut k, pid, a, false, KP_LINK, false);
    if t >= KEY_N {
      return t;
    }
    if kr(k, t, 1) == KT_RING && kreach(&mut k, t, r) {
      return KE_DEADLK;
    }
    return kl_add(&mut k, r, t);
  }
  if cmd == KC_MOVE {
    return key_move(&mut k, pid, a, b, c, d);
  }
  if cmd == KC_RESTRICT {
    let s = kres(&mut k, pid, a, false, KP_SETATTR, false);
    if s >= KEY_N {
      return s;
    }
    if kr(k, s, 1) != KT_RING {
      return ENOTDIR;
    }
    if (b == 0) != (c == 0) {
      return EINVAL;
    }
    if b != 0 {
      let mut tb = balloc(32);
      let tl = ks_in(&mut k, pid, b, &mut tb, 32);
      let ty = ktype(tb, smaller(tl, 31));
      bfree(tb);
      if tl == NO_RESULT {
        return EFAULT;
      }
      if tl < 32 && ty != 0 {
        return ENOENT;                          // a key type that restricts nothing
      }
      return KE_NOKEY;                          // the restrictions that need key types this kernel lacks
    }
    if kr(k, s, 15) == 1 {
      return EEXIST;
    }
    kw(&mut k, s, 15, 1);
    return 0;
  }
  if cmd == KC_SEARCH {
    return key_search(&mut k, pid, a, b, c, d);
  }
  if cmd == KC_SET_TIMEOUT {
    let s = kres(&mut k, pid, a, false, KP_SETATTR, false);
    if s >= KEY_N {
      return s;
    }
    if b == 0 {
      kw(&mut k, s, 5, 0);
    } else if b < 1000000000 {
      kw(&mut k, s, 5, sat_add(know(k), b));
    } else {
      kw(&mut k, s, 5, 4000000000);
    }
    return 0;
  }
  if cmd == KC_GET_SECURITY {
    let s = kres(&mut k, pid, a, false, KP_VIEW, true);
    if s == EACCES {
      return KE_NOKEY;
    }
    if s >= KEY_N {
      return s;
    }
    bset(&mut k.fs.xfer, 0, 0);
    return kout(&mut k, pid, b, c, 1, 1, false);
  }
  return EOPNOTSUPP;
}

/// KEYCTL_MOVE(key, from, to, flags).
fn key_move(k: &mut Kernel, pid: u64, a: u64, b: u64, c: u64, d: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if d > 1 {
    return EINVAL;
  }
  let t = kres(&mut k, pid, a, false, KP_LINK, false);
  if t >= KEY_N {
    return t;
  }
  let from = kres(&mut k, pid, b, false, KP_WRITE, false);
  if from >= KEY_N {
    return from;
  }
  let to = kres(&mut k, pid, c, false, KP_WRITE, false);
  if to >= KEY_N {
    return to;
  }
  if kr(k, from, 1) != KT_RING || kr(k, to, 1) != KT_RING {
    return ENOTDIR;
  }
  let i = kl_find(k, from, kr(k, t, 0));
  if i >= KL_N {
    return ENOENT;
  }
  if kr(k, t, 1) == KT_RING && kreach(&mut k, t, to) {
    return KE_DEADLK;
  }
  if d == 1 {
    let dl = kr(k, t, 6);
    if dl < KDESC {
      let mut db = balloc(KDESC);
      let mut j = 0;
      while j < dl
        invariant j <= dl && dl < KDESC && blen(db) == KDESC && t < KEY_N && kok(k)
      {
        bset(&mut db, j, bget(k.mstr, KDB + t * KDESC + j));
        j = j + 1;
      }
      let ex = kl_lookup(k, to, kr(k, t, 1), db, dl);
      bfree(db);
      if ex < KEY_N && ex != t {
        return EEXIST;
      }
    }
  }
  let e = kl_add(&mut k, to, t);
  if e != 0 {
    return e;
  }
  let i2 = kl_find(k, from, kr(k, t, 0));
  if i2 < KL_N && from != to {
    k.sys = set(k.sys, klnk(from, i2), 0);
  }
  return 0;
}

/// KEYCTL_SEARCH(ring, type, description, dest).
fn key_search(k: &mut Kernel, pid: u64, a: u64, tva: u64, dva: u64, dest: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut tb = balloc(32);
  let tl = ks_in(&mut k, pid, tva, &mut tb, 32);
  if tl == NO_RESULT || tl == ERANGE {
    bfree(tb);
    if tl == NO_RESULT {
      return EFAULT;
    }
    return EINVAL;
  }
  let mut db = balloc(KDESC);
  let dl = ks_in(&mut k, pid, dva, &mut db, KDESC);
  if dl == NO_RESULT || dl == ERANGE {
    bfree(tb);
    bfree(db);
    if dl == NO_RESULT {
      return EFAULT;
    }
    return EINVAL;
  }
  let r = key_search2(&mut k, pid, a, tb, tl, db, dl, dest);
  bfree(tb);
  bfree(db);
  return r;
}

fn key_search2(k: &mut Kernel, pid: u64, a: u64, tb: &Bytes, tl: u64, db: &Bytes, dl: u64, dest: u64) -> u64
  requires kok(k) && pid < NPROC && tl < 32 && tl <= blen(tb) && dl < KDESC && dl <= blen(db)
  ensures kok(k)
{
  let root = kres(&mut k, pid, a, false, KP_SEARCH, false);
  if root >= KEY_N {
    return root;
  }
  if kr(k, root, 1) != KT_RING {
    return ENOTDIR;
  }
  let ty = ktype(tb, tl);
  if ty == 0 {
    return KE_NODEV;
  }
  let found = ksearch(&mut k, pid, root, ty, db, dl);
  if found >= KEY_N {
    return found;
  }
  if dest != 0 {
    let r = kres(&mut k, pid, dest, false, KP_WRITE, false);
    if r >= KEY_N {
      return r;
    }
    if kr(k, r, 1) != KT_RING {
      return ENOTDIR;
    }
    if !kallow(k, pid, found, KP_LINK) {
      return EACCES;
    }
    let e = kl_add(&mut k, r, found);
    if e != 0 {
      return e;
    }
  }
  return kr(k, found, 0);
}

/// fork, vfork and clone: the child shares the parent's session keyring and
/// default keyring; the thread and process keyrings are its own, made when
/// first used.
fn keys_fork(k: &mut Kernel, pid: u64, c: u64)
  requires kok(k) && pid < NPROC && c < NPROC
  ensures kok(k)
{
  k.sys = set(k.sys, kprc(c, 0), 0);
  k.sys = set(k.sys, kprc(c, 1), 0);
  k.sys = set(k.sys, kprc(c, 2), get(k.sys, kprc(pid, 2)));
  k.sys = set(k.sys, kprc(c, 3), get(k.sys, kprc(pid, 3)));
}

/// System call n (248 .. 250) of process pid, a..e the arguments (rdi, rsi,
/// rdx, r10, r8).
fn lx_keys_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64, d: u64, e: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut r = ENOSYS;
  if n == LX_ADD_KEY {
    r = key_add(&mut k, pid, a, b, c, d, e);
  } else if n == LX_REQUEST_KEY {
    r = key_request(&mut k, pid, a, b, c, d);
  } else {
    r = key_ctl(&mut k, pid, a % 4294967296, b, c, d, e);
  }
  ret(&mut k.procs, pid, r);
  return KEEP;
}
