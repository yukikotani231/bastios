// The CMOS real-time clock (the MC146818 behind ports 0x70 and 0x71), read
// once at boot to give CLOCK_REALTIME its starting point. After that the
// clock (src/tsc.bastio) keeps time. /dev/rtc0 (src/lxrtc.bastio) reads it
// again and, for a program that holds CAP_SYS_TIME, sets it (hwclock -w).

import "calendar.bastio";

const RTC: u64 = 0x70;

// Ports: register select at 0, data at 1.
struct Rtc { io: PortIo }

spec fn rtc_ok(r: &Rtc) -> bool { port_count(r.io) == 2 }

/// RTC register `reg`. Setting bit 7 of the select port would mask the NMI;
/// it stays clear.
fn rtc_reg(r: &mut Rtc, reg: u64) -> u64
  requires rtc_ok(r) && reg < 0x80
  ensures rtc_ok(r) && result < 256
{
  pio_out8(&mut r.io, 0, cast[u8](reg));
  return cast[u64](pio_in8(&mut r.io, 1));
}

/// A register value in the clock's format (BCD unless status B bit 2 says
/// binary) as a number.
fn rtc_num(v: u64, bcd: bool) -> u64
  requires v < 256
  ensures result < 256
{
  if bcd {
    return v / 16 * 10 + v % 16;
  }
  return v;
}

/// The time now, in seconds since 1970-01-01 00:00 UTC, as the clock says
/// (QEMU's clock runs in UTC). 0 if what it says makes no sense.
fn rtc_seconds(r: &mut Rtc) -> u64
  requires rtc_ok(r)
  ensures rtc_ok(r) && result < 5000000000
{
  // Wait out an update in progress (status A bit 7), so the fields below
  // belong to the same second. It lasts under 2 ms; give up after a while.
  let mut spins = 0;
  while spins < 100000 && rtc_reg(&mut r, 0x0A) / 128 % 2 == 1
    invariant rtc_ok(r)
  {
    spins = spins + 1;
  }
  let b = rtc_reg(&mut r, 0x0B);
  let bcd = b / 4 % 2 == 0;
  let sec = rtc_num(rtc_reg(&mut r, 0x00), bcd);
  let min = rtc_num(rtc_reg(&mut r, 0x02), bcd);
  let hraw = rtc_reg(&mut r, 0x04);
  let mut hour = rtc_num(hraw % 128, bcd);
  if b / 2 % 2 == 0 {
    // 12-hour mode: bit 7 of the hour is PM, and 12 means 0.
    hour = hour % 12;
    if hraw / 128 == 1 {
      hour = hour + 12;
    }
  }
  let day = rtc_num(rtc_reg(&mut r, 0x07), bcd);
  let month = rtc_num(rtc_reg(&mut r, 0x08), bcd);
  let year = 2000 + rtc_num(rtc_reg(&mut r, 0x09), bcd);   // the 21st century
  if sec > 59 || min > 59 || hour > 23 || day < 1 || day > 31 || month < 1 || month > 12 || year > 2099 {
    return 0;
  }
  return days_from_civil(year, month, day) * 86400 + hour * 3600 + min * 60 + sec;
}

/// Writes RTC register `reg`.
fn rtc_put(r: &mut Rtc, reg: u64, v: u64)
  requires rtc_ok(r) && reg < 0x80 && v < 256
  ensures rtc_ok(r)
{
  pio_out8(&mut r.io, 0, cast[u8](reg));
  pio_out8(&mut r.io, 1, cast[u8](v));
}

/// v (under 100) in the clock's format.
fn rtc_enc(v: u64, bcd: bool) -> u64
  requires v < 100
  ensures result < 256
{
  if bcd {
    return v / 10 * 16 + v % 10;
  }
  return v;
}

/// Sets the clock to `secs` seconds since 1970-01-01 00:00 UTC (2000 to
/// 2099), if it keeps 24-hour time. False if it cannot be set that way.
/// Its update cycle is held off while the fields are written (status B
/// bit 7), so they take effect together.
fn rtc_set_seconds(r: &mut Rtc, secs: u64) -> bool
  requires rtc_ok(r)
  ensures rtc_ok(r)
{
  if secs < 946684800 || secs >= 4102444800 {
    return false;
  }
  let b = rtc_reg(&mut r, 0x0B);
  if b / 2 % 2 == 0 {
    return false;                          // 12-hour mode: not written
  }
  let bcd = b / 4 % 2 == 0;
  let days = secs / 86400;
  let rest = secs % 86400;
  if days < 10957 || days > 47500 {
    return false;
  }
  let c = civil_from_days(days);
  if c.year < 2000 || c.year > 2099 {
    return false;
  }
  rtc_put(&mut r, 0x0B, b % 128 + 128);    // stop the update cycle
  rtc_put(&mut r, 0x00, rtc_enc(rest % 60, bcd));
  rtc_put(&mut r, 0x02, rtc_enc(rest / 60 % 60, bcd));
  rtc_put(&mut r, 0x04, rtc_enc(rest / 3600, bcd));
  rtc_put(&mut r, 0x06, (days + 4) % 7 + 1);   // 1970-01-01 was a Thursday; Sunday is 1
  rtc_put(&mut r, 0x07, rtc_enc(c.day, bcd));
  rtc_put(&mut r, 0x08, rtc_enc(c.month, bcd));
  rtc_put(&mut r, 0x09, rtc_enc(c.year - 2000, bcd));
  rtc_put(&mut r, 0x0B, b % 128);          // and start it again
  return true;
}
