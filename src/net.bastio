// A minimal IPv4 stack over the virtio network card: Ethernet, ARP, IPv4
// without options or fragments, ICMP echo (it answers pings and can send
// them) and UDP echo on port 7. The address is fixed for QEMU's user-mode
// network: 10.0.2.15, gateway 10.0.2.2. On top sits a small table of UDP
// sockets, which the native and the Linux system calls share.
//
// Every frame is parsed out of a byte buffer, and the proof shows that no
// read or write leaves the buffer and no length field read off the wire can
// make it do so: a header claiming more bytes than arrived is dropped, not
// trusted. Polled from the kernel loop and while a ping waits.

import "virtio_net.bastio";

const ETH_ARP: u64 = 0x0806;
const ETH_IP: u64 = 0x0800;
const ETH_MIN: u64 = 60;              // shorter frames are padded
const MAC_BCAST: u64 = 0xFFFFFFFFFFFF;
const MAC_LIMIT: u64 = 0x1000000000000;

const MY_IP: u64 = 0x0A00020F;        // 10.0.2.15
const GATEWAY: u64 = 0x0A000202;      // 10.0.2.2

const IP_ICMP: u64 = 1;
const IP_UDP: u64 = 17;
const ICMP_ECHO_REPLY: u64 = 0;
const ICMP_ECHO: u64 = 8;
const UDP_ECHO_PORT: u64 = 7;
const PING_ID: u64 = 0x4253;          // "BS"
const PING_DATA: u64 = 32;
const NET_SPINS: u64 = 2000000;

const SOCKS: u64 = 8;                 // UDP sockets in the table
const UDP_MAX: u64 = 1472;            // the largest payload one frame carries
const NO_SOCK: u64 = 18446744073709551615;
const EPH_LO: u64 = 49152;            // ephemeral ports: 49152 .. 65535
const EPH_N: u64 = 16384;
// A socket's words in the table.
const S_OPEN: u64 = 0;                // 1 while open
const S_PORT: u64 = 1;                // its local port, 0 until bound
const S_HAS: u64 = 2;                 // 1 while a datagram is queued
const S_LEN: u64 = 3;                 // its length
const S_PEER_IP: u64 = 4;             // who sent the last datagram
const S_PEER_PORT: u64 = 5;
const SOCK_FIELDS: u64 = 6;

struct Net {
  dev: VNet,
  pkt: Bytes,         // the frame being handled
  out: Bytes,         // the frame being built
  arp_ip: u64,        // a one-entry ARP cache: this address ...
  arp_mac: u64,       // ... is at this MAC (0 while unknown)
  seq: u64,           // the last ping's sequence number
  got: bool,          // its reply has arrived
  rx: u64,            // frames received and sent
  tx: u64,
  socks: Buf,         // the UDP sockets, SOCK_FIELDS words each
  dq: Bytes,          // each socket's queued datagram, UDP_MAX bytes each
  eph: u64,           // where the next ephemeral port search starts
}

spec fn net_ok(n: &Net) -> bool {
  vnet_ok(n.dev) && blen(n.pkt) == RX_BUF && blen(n.out) == RX_BUF
  && n.arp_mac < MAC_LIMIT && n.seq <= 65535
  && len(n.socks) == SOCKS * SOCK_FIELDS && blen(n.dq) == SOCKS * UDP_MAX
}

// ---------------------------------------------------------------- bytes
// Network byte order: most significant byte first.

fn be16(b: &Bytes, o: u64) -> u64
  requires o + 2 <= blen(b)
  ensures result <= 65535
{
  return bget(b, o) * 256 + bget(b, o + 1);
}

fn be32(b: &Bytes, o: u64) -> u64
  requires o + 4 <= blen(b)
  ensures result <= 4294967295
{
  return be16(b, o) * 65536 + be16(b, o + 2);
}

fn be48(b: &Bytes, o: u64) -> u64
  requires o + 6 <= blen(b)
  ensures result < MAC_LIMIT
{
  return be16(b, o) * 4294967296 + be32(b, o + 2);
}

fn put16(b: &mut Bytes, o: u64, v: u64)
  requires o + 2 <= blen(b) && v <= 65535
  ensures blen(b) == old(blen(b))
{
  bset(&mut b, o, v / 256);
  bset(&mut b, o + 1, v % 256);
}

fn put32(b: &mut Bytes, o: u64, v: u64)
  requires o + 4 <= blen(b) && v <= 4294967295
  ensures blen(b) == old(blen(b))
{
  put16(&mut b, o, v / 65536);
  put16(&mut b, o + 2, v % 65536);
}

fn put48(b: &mut Bytes, o: u64, v: u64)
  requires o + 6 <= blen(b) && v < MAC_LIMIT
  ensures blen(b) == old(blen(b))
{
  put16(&mut b, o, v / 4294967296);
  put32(&mut b, o + 2, v % 4294967296);
}

/// The Internet checksum (RFC 1071) of bytes off..off+n: the ones'
/// complement of their ones'-complement sum as 16-bit words. Over a header
/// that already holds its checksum, it is 0.
fn csum(b: &Bytes, off: u64, n: u64) -> u64
  requires off + n <= blen(b)
  ensures result <= 65535
{
  let mut s = 0;
  let mut i = 0;
  while i + 1 < n
    invariant i <= n && s <= 65535
  {
    s = s + be16(b, off + i);
    if s > 65535 {
      s = s - 65535;                  // end-around carry
    }
    i = i + 2;
  }
  if i < n {
    s = s + bget(b, off + i) * 256;
    if s > 65535 {
      s = s - 65535;
    }
  }
  return 65535 - s;
}

/// Copies the first n bytes of the received frame to the outgoing one.
fn net_copy(n: &mut Net, flen: u64)
  requires net_ok(n) && flen <= RX_BUF
  ensures net_ok(n)
{
  let mut i = 0;
  while i < flen
    invariant i <= flen && net_ok(n)
  {
    bset(&mut n.out, i, bget(n.pkt, i));
    i = i + 1;
  }
}

/// Sends the first `flen` bytes of the outgoing frame, padded to the
/// Ethernet minimum.
fn net_send(n: &mut Net, flen: u64) -> bool
  requires net_ok(n) && flen <= FRAME_MAX
  ensures net_ok(n)
{
  let mut l = flen;
  while l < ETH_MIN
    invariant flen <= l && l <= FRAME_MAX && net_ok(n)
  {
    bset(&mut n.out, l, 0);
    l = l + 1;
  }
  if n.tx < 18446744073709551615 {
    n.tx = n.tx + 1;
  }
  return vnet_send(&mut n.dev, n.out, l);
}

fn eth_header(n: &mut Net, dst: u64, kind: u64)
  requires net_ok(n) && dst < MAC_LIMIT && kind <= 65535
  ensures net_ok(n)
{
  put48(&mut n.out, 0, dst);
  put48(&mut n.out, 6, n.dev.mac);
  put16(&mut n.out, 12, kind);
}

// ---------------------------------------------------------------- ARP

/// An ARP packet: operation, and the target's MAC and address. We are
/// always the sender.
fn arp_send(n: &mut Net, op: u64, eth_dst: u64, tmac: u64, tip: u64) -> bool
  requires net_ok(n) && op <= 2 && eth_dst < MAC_LIMIT && tmac < MAC_LIMIT && tip <= 4294967295
  ensures net_ok(n)
{
  eth_header(&mut n, eth_dst, ETH_ARP);
  put16(&mut n.out, 14, 1);           // Ethernet
  put16(&mut n.out, 16, ETH_IP);
  bset(&mut n.out, 18, 6);
  bset(&mut n.out, 19, 4);
  put16(&mut n.out, 20, op);
  put48(&mut n.out, 22, n.dev.mac);
  put32(&mut n.out, 28, MY_IP);
  put48(&mut n.out, 32, tmac);
  put32(&mut n.out, 38, tip);
  return net_send(&mut n, 42);
}

fn arp_in(n: &mut Net, flen: u64)
  requires net_ok(n) && flen <= RX_BUF
  ensures net_ok(n)
{
  if flen < 42 || be16(n.pkt, 14) != 1 || be16(n.pkt, 16) != ETH_IP || bget(n.pkt, 18) != 6 || bget(n.pkt, 19) != 4 {
    return;
  }
  let op = be16(n.pkt, 20);
  let smac = be48(n.pkt, 22);
  let sip = be32(n.pkt, 28);
  let tip = be32(n.pkt, 38);
  if sip == n.arp_ip {
    n.arp_mac = smac;                 // the address we asked about (or a change)
  }
  if op == 1 && tip == MY_IP {
    arp_send(&mut n, 2, smac, smac, sip);
  }
}

// ---------------------------------------------------------------- UDP sockets

fn sk_get(n: &Net, s: u64, f: u64) -> u64
  requires net_ok(n) && s < SOCKS && f < SOCK_FIELDS
  ensures result == get(n.socks, s * SOCK_FIELDS + f)
{
  return get(n.socks, s * SOCK_FIELDS + f);
}

fn sk_set(n: &mut Net, s: u64, f: u64, v: u64)
  requires net_ok(n) && s < SOCKS && f < SOCK_FIELDS
  ensures net_ok(n)
{
  n.socks = set(n.socks, s * SOCK_FIELDS + f, v);
}

/// The open socket bound to `port`, or SOCKS if there is none.
fn sock_find(n: &Net, port: u64) -> u64
  requires net_ok(n)
  ensures result <= SOCKS
{
  if port == 0 {
    return SOCKS;
  }
  let mut s = 0;
  while s < SOCKS
    invariant s <= SOCKS
  {
    if sk_get(n, s, S_OPEN) == 1 && sk_get(n, s, S_PORT) == port {
      return s;
    }
    s = s + 1;
  }
  return SOCKS;
}

/// Queues the payload of the UDP datagram in the received frame on socket
/// s. A socket holds one datagram: another that arrives before it is read
/// is dropped, which UDP allows.
fn udp_deliver(n: &mut Net, s: u64, total: u64)
  requires net_ok(n) && s < SOCKS && 28 <= total && total <= FRAME_MAX - 14
  ensures net_ok(n)
{
  let ulen = be16(n.pkt, 38);
  if ulen < 8 || ulen > total - 20 || sk_get(n, s, S_HAS) == 1 {
    return;
  }
  let plen = ulen - 8;
  let at = s * UDP_MAX;
  let mut i = 0;
  while i < plen
    invariant i <= plen && net_ok(n)
  {
    bset(&mut n.dq, at + i, bget(n.pkt, 42 + i));
    i = i + 1;
  }
  sk_set(&mut n, s, S_LEN, plen);
  sk_set(&mut n, s, S_PEER_IP, be32(n.pkt, 26));
  sk_set(&mut n, s, S_PEER_PORT, be16(n.pkt, 34));
  sk_set(&mut n, s, S_HAS, 1);
}

/// Opens a socket: its index, or NO_SOCK if all are taken.
fn udp_open(n: &mut Net) -> u64
  requires net_ok(n)
  ensures net_ok(n) && (result < SOCKS || result == NO_SOCK)
{
  let mut s = 0;
  while s < SOCKS
    invariant s <= SOCKS && net_ok(n)
  {
    if sk_get(n, s, S_OPEN) != 1 {
      sk_set(&mut n, s, S_OPEN, 1);
      sk_set(&mut n, s, S_PORT, 0);
      sk_set(&mut n, s, S_HAS, 0);
      sk_set(&mut n, s, S_LEN, 0);
      sk_set(&mut n, s, S_PEER_IP, 0);
      sk_set(&mut n, s, S_PEER_PORT, 0);
      return s;
    }
    s = s + 1;
  }
  return NO_SOCK;
}

fn udp_is_open(n: &Net, s: u64) -> bool
  requires net_ok(n)
  ensures result ==> s < SOCKS
{
  return s < SOCKS && sk_get(n, s, S_OPEN) == 1;
}

/// Binds open, unbound socket s to a free ephemeral port. Returns the
/// port, or 0 if none was found. There are fewer sockets than tries, so
/// one of the ports tried is always free.
fn udp_bind_any(n: &mut Net, s: u64) -> u64
  requires net_ok(n) && s < SOCKS
  ensures net_ok(n) && result <= 65535
{
  let mut tries = 0;
  while tries <= SOCKS
    invariant net_ok(n)
  {
    let p = EPH_LO + n.eph % EPH_N;
    n.eph = (n.eph % EPH_N + 1) % EPH_N;
    if sock_find(n, p) == SOCKS {
      sk_set(&mut n, s, S_PORT, p);
      return p;
    }
    tries = tries + 1;
  }
  return 0;
}

/// Binds socket s to `port` (0: any free ephemeral port). False if s is not
/// open, is already bound, or another socket has the port.
fn udp_bind(n: &mut Net, s: u64, port: u64) -> bool
  requires net_ok(n)
  ensures net_ok(n)
{
  if !udp_is_open(n, s) || sk_get(n, s, S_PORT) != 0 || port > 65535 {
    return false;
  }
  if port == 0 {
    return udp_bind_any(&mut n, s) != 0;
  }
  if sock_find(n, port) != SOCKS {
    return false;
  }
  sk_set(&mut n, s, S_PORT, port);
  return true;
}

/// Sends bytes 0..size of buf as one datagram from socket s to ip:port,
/// binding s to an ephemeral port first if it has none. Returns size, or
/// NO_SOCK if it cannot be sent (bad socket or address, too big, or no
/// ARP answer for the next hop).
fn udp_sendto(n: &mut Net, s: u64, ip: u64, port: u64, buf: &Bytes, size: u64) -> u64
  requires net_ok(n)
  ensures net_ok(n)
{
  if !udp_is_open(n, s) || ip > 4294967295 || port == 0 || port > 65535
    || size > UDP_MAX || size > blen(buf) || !n.dev.live {
    return NO_SOCK;
  }
  if sk_get(n, s, S_PORT) == 0 && udp_bind_any(&mut n, s) == 0 {
    return NO_SOCK;
  }
  let sport = sk_get(n, s, S_PORT);
  if sport > 65535 {
    return NO_SOCK;
  }
  let mac = resolve(&mut n, ip);
  if mac == 0 {
    return NO_SOCK;
  }
  eth_header(&mut n, mac, ETH_IP);
  ip_header(&mut n, 28 + size, IP_UDP, ip);
  put16(&mut n.out, 34, sport);
  put16(&mut n.out, 36, port);
  put16(&mut n.out, 38, 8 + size);
  put16(&mut n.out, 40, 0);           // no checksum (allowed over IPv4)
  let mut i = 0;
  while i < size
    invariant i <= size && net_ok(n)
  {
    bset(&mut n.out, 42 + i, bget(buf, i));
    i = i + 1;
  }
  if !net_send(&mut n, 42 + size) {
    return NO_SOCK;
  }
  return size;
}

/// Takes the datagram queued on socket s, if any: copies up to `max` bytes
/// of it (and no more than buf holds) to the start of buf and returns that
/// count, dropping the rest as Linux does. NO_SOCK if nothing is queued;
/// it never waits.
fn udp_recvfrom(n: &mut Net, s: u64, buf: &mut Bytes, max: u64) -> u64
  requires net_ok(n)
  ensures net_ok(n) && blen(buf) == old(blen(buf))
  ensures result == NO_SOCK || (result <= blen(buf) && result <= max)
{
  net_poll(&mut n);
  if !udp_is_open(n, s) || sk_get(n, s, S_HAS) != 1 {
    return NO_SOCK;
  }
  let mut l = sk_get(n, s, S_LEN);
  if l > UDP_MAX {
    l = UDP_MAX;
  }
  if l > max {
    l = max;
  }
  if l > blen(buf) {
    l = blen(buf);
  }
  let at = s * UDP_MAX;
  let bl = blen(buf);
  let mut i = 0;
  while i < l
    invariant i <= l && net_ok(n) && blen(buf) == bl
  {
    bset(&mut buf, i, bget(n.dq, at + i));
    i = i + 1;
  }
  sk_set(&mut n, s, S_HAS, 0);
  return l;
}

// ---------------------------------------------------------------- IPv4

/// Fills in an IPv4 header (no options) at 14 and its checksum.
fn ip_header(n: &mut Net, total: u64, proto: u64, dst: u64)
  requires net_ok(n) && 20 <= total && total <= FRAME_MAX - 14 && proto <= 255 && dst <= 4294967295
  ensures net_ok(n)
{
  bset(&mut n.out, 14, 0x45);         // version 4, 5 words of header
  bset(&mut n.out, 15, 0);
  put16(&mut n.out, 16, total);
  put32(&mut n.out, 18, 0);           // id, no fragments
  bset(&mut n.out, 22, 64);           // time to live
  bset(&mut n.out, 23, proto);
  put16(&mut n.out, 24, 0);
  put32(&mut n.out, 26, MY_IP);
  put32(&mut n.out, 30, dst);
  put16(&mut n.out, 24, csum(n.out, 14, 20));
}

/// Answers an echo request: the same frame back, addresses swapped.
fn icmp_echo_reply(n: &mut Net, total: u64)
  requires net_ok(n) && 28 <= total && total <= FRAME_MAX - 14
  ensures net_ok(n)
{
  let src = be32(n.pkt, 26);
  let smac = be48(n.pkt, 6);
  net_copy(&mut n, 14 + total);
  eth_header(&mut n, smac, ETH_IP);
  ip_header(&mut n, total, IP_ICMP, src);
  bset(&mut n.out, 34, ICMP_ECHO_REPLY);
  put16(&mut n.out, 36, 0);
  put16(&mut n.out, 36, csum(n.out, 34, total - 20));
  net_send(&mut n, 14 + total);
}

/// Echoes a UDP datagram to port 7 back to where it came from.
fn udp_echo(n: &mut Net, total: u64)
  requires net_ok(n) && 28 <= total && total <= FRAME_MAX - 14
  ensures net_ok(n)
{
  let src = be32(n.pkt, 26);
  let smac = be48(n.pkt, 6);
  let sport = be16(n.pkt, 34);
  let ulen = be16(n.pkt, 38);
  if ulen < 8 || ulen > total - 20 {
    return;
  }
  net_copy(&mut n, 14 + 20 + ulen);
  eth_header(&mut n, smac, ETH_IP);
  ip_header(&mut n, 20 + ulen, IP_UDP, src);
  put16(&mut n.out, 34, UDP_ECHO_PORT);
  put16(&mut n.out, 36, sport);
  put16(&mut n.out, 40, 0);           // no checksum (allowed over IPv4)
  net_send(&mut n, 14 + 20 + ulen);
}

fn ip_in(n: &mut Net, flen: u64)
  requires net_ok(n) && flen <= RX_BUF
  ensures net_ok(n)
{
  if flen < 34 || bget(n.pkt, 14) != 0x45 || csum(n.pkt, 14, 20) != 0 || be32(n.pkt, 30) != MY_IP {
    return;
  }
  let total = be16(n.pkt, 16);
  // The header's length must fit in what arrived, and in what we can send.
  if total < 28 || 14 + total > flen || 14 + total > FRAME_MAX {
    return;
  }
  let proto = bget(n.pkt, 23);
  if proto == IP_ICMP {
    let kind = bget(n.pkt, 34);
    if kind == ICMP_ECHO && csum(n.pkt, 34, total - 20) == 0 {
      icmp_echo_reply(&mut n, total);
    } else if kind == ICMP_ECHO_REPLY && be16(n.pkt, 38) == PING_ID && be16(n.pkt, 40) == n.seq {
      n.got = true;
    }
  } else if proto == IP_UDP {
    // A socket bound to the port gets the datagram; failing that, port 7
    // echoes it.
    let dport = be16(n.pkt, 36);
    let s = sock_find(n, dport);
    if s < SOCKS {
      udp_deliver(&mut n, s, total);
    } else if dport == UDP_ECHO_PORT {
      udp_echo(&mut n, total);
    }
  }
}

// ---------------------------------------------------------------- the stack

/// Handles every frame that has arrived (a few at most per call).
fn net_poll(n: &mut Net)
  requires net_ok(n)
  ensures net_ok(n)
{
  let mut k = 0;
  while k < RX_BUFS
    invariant k <= RX_BUFS && net_ok(n)
  {
    let flen = vnet_recv(&mut n.dev, &mut n.pkt);
    if flen == 0 {
      return;
    }
    if n.rx < 18446744073709551615 {
      n.rx = n.rx + 1;
    }
    if flen >= 14 {
      let kind = be16(n.pkt, 12);
      if kind == ETH_ARP {
        arp_in(&mut n, flen);
      } else if kind == ETH_IP {
        ip_in(&mut n, flen);
      }
    }
    k = k + 1;
  }
}

/// The MAC address to send to for `ip`: itself on our /24, else the
/// gateway. Asks with ARP and waits for the answer; 0 if none comes.
fn resolve(n: &mut Net, ip: u64) -> u64
  requires net_ok(n) && ip <= 4294967295
  ensures net_ok(n) && result < MAC_LIMIT
{
  let mut hop = GATEWAY;
  if ip / 256 == MY_IP / 256 {
    hop = ip;
  }
  if n.arp_ip == hop && n.arp_mac != 0 {
    return n.arp_mac;
  }
  n.arp_ip = hop;
  n.arp_mac = 0;
  arp_send(&mut n, 1, MAC_BCAST, 0, hop);
  let mut spins = 0;
  while spins < NET_SPINS && n.arp_mac == 0
    invariant net_ok(n)
  {
    net_poll(&mut n);
    spins = spins + 1;
  }
  if n.arp_ip != hop {
    return 0;
  }
  return n.arp_mac;
}

/// Sends one echo request to `ip` and waits for the reply. 1 if it came,
/// 0 if it did not, 2 if nothing answered for the MAC address.
fn net_ping(n: &mut Net, ip: u64) -> u64
  requires net_ok(n) && ip <= 4294967295
  ensures net_ok(n)
{
  let mac = resolve(&mut n, ip);
  if mac == 0 {
    return 2;
  }
  n.seq = (n.seq + 1) % 65536;
  n.got = false;
  let total = 20 + 8 + PING_DATA;
  eth_header(&mut n, mac, ETH_IP);
  ip_header(&mut n, total, IP_ICMP, ip);
  bset(&mut n.out, 34, ICMP_ECHO);
  bset(&mut n.out, 35, 0);
  put16(&mut n.out, 36, 0);
  put16(&mut n.out, 38, PING_ID);
  put16(&mut n.out, 40, n.seq);
  let mut i = 0;
  while i < PING_DATA
    invariant i <= PING_DATA && net_ok(n)
  {
    bset(&mut n.out, 42 + i, 0x61 + i % 26);   // "abcd..."
    i = i + 1;
  }
  put16(&mut n.out, 36, csum(n.out, 34, total - 20));
  if !net_send(&mut n, 14 + total) {
    return 0;
  }
  let mut spins = 0;
  while spins < NET_SPINS && !n.got
    invariant net_ok(n)
  {
    net_poll(&mut n);
    spins = spins + 1;
  }
  if n.got {
    return 1;
  }
  return 0;
}

// ---------------------------------------------------------------- the card, or none

enum Nic { None, Up(Net) }

spec fn nic_ok(c: &Nic) -> bool {
  c is Nic::Up ==> net_ok(c.Up)
}

/// Are pages lo .. lo+k all free?
fn pages_free(m: &Mem, lo: u64, k: u64) -> bool
  requires mem_ok(m) && lo + k <= NPAGES
  ensures result ==> (forall i: u64 :: lo <= i && i < lo + k ==> get(m.bm, i) == 1)
{
  let mut i = 0;
  while i < k
    invariant i <= k && (forall j: u64 :: lo <= j && j < lo + i ==> get(m.bm, j) == 1)
  {
    if get(m.bm, lo + i) != 1 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// Starts the first virtio network card on PCI bus 0, if there is one and
/// its ports do not overlap avoid_lo .. avoid_hi (another driver's), with
/// nine pages from page `at` on.
fn nic_new(ports: &mut Ports, pci: &mut Pci, m: &mut Mem, at: u64, avoid_lo: u64, avoid_hi: u64) -> Nic
  requires pci_ok(pci) && mem_ok(m) && at + NET_PAGES <= NPAGES
  requires forall k: u64 :: 0x1000 <= k && k < 65536 && !(avoid_lo <= k && k < avoid_hi) ==> port_free(ports, k)
  ensures nic_ok(result) && mem_ok(m)
{
  let dev = pci_find(&mut pci, VIRTIO_VENDOR, VIRTIO_NET);
  if dev == 32 {
    return Nic::None;
  }
  let base = pci_io_bar(&mut pci, dev);
  if base < 0x1000 || base + VIO_PORTS > 65536 || !(base + VIO_PORTS <= avoid_lo || base >= avoid_hi)
    || !pages_free(m, at, NET_PAGES) {
    return Nic::None;
  }
  pci_enable(&mut pci, dev);
  let q0 = take_low_page(&mut m, at);
  let q1 = take_low_page(&mut m, at + 1);
  let q2 = take_low_page(&mut m, at + 2);
  let t0 = take_low_page(&mut m, at + 3);
  let t1 = take_low_page(&mut m, at + 4);
  let t2 = take_low_page(&mut m, at + 5);
  let b0 = take_low_page(&mut m, at + 6);
  let b1 = take_low_page(&mut m, at + 7);
  let b2 = take_low_page(&mut m, at + 8);
  let v = vnet_new(&mut ports, base, q0, q1, q2, t0, t1, t2, b0, b1, b2);
  return Nic::Up(Net { dev: v, pkt: balloc(RX_BUF), out: balloc(RX_BUF), arp_ip: 0, arp_mac: 0, seq: 0, got: false, rx: 0, tx: 0, socks: alloc(SOCKS * SOCK_FIELDS), dq: balloc(SOCKS * UDP_MAX), eph: 0 });
}

fn nic_poll(c: &mut Nic)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      net_poll(&mut n);
      c = Nic::Up(n);
    },
  }
}

/// Pings `ip`: 1 for a reply, 0 for none, 2 if nothing answered ARP, 3 if
/// there is no network card.
fn nic_ping(c: &mut Nic, ip: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return 3;
    },
    Nic::Up(mut n) => {
      let mut r = 3;
      if ip <= 4294967295 && n.dev.live {
        r = net_ping(&mut n, ip);
      }
      c = Nic::Up(n);
      return r;
    },
  }
}

fn nic_mac(c: &Nic) -> u64 {
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => { return n.dev.mac; },
  }
}

fn nic_live(c: &Nic) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return n.dev.live; },
  }
}

/// Resets the card and takes its pages back (at power off).
fn nic_free(ports: &mut Ports, c: Nic, m: &mut Mem)
  requires nic_ok(c) && mem_ok(m)
  ensures mem_ok(m)
{
  match c {
    Nic::None => {},
    Nic::Up(n) => {
      bfree(n.pkt);
      bfree(n.out);
      free(n.socks);
      bfree(n.dq);
      vnet_free(&mut ports, n.dev, &mut m);
    },
  }
}

// ---------------------------------------------------------------- sockets, for system calls
// Each takes the card or none; with none, every call fails.

/// Opens a UDP socket: its number, or NO_SOCK if there is no card or every
/// socket is taken.
fn sock_new(c: &mut Nic) -> u64
  requires nic_ok(c)
  ensures nic_ok(c) && (result < SOCKS || result == NO_SOCK)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      let s = udp_open(&mut n);
      c = Nic::Up(n);
      return s;
    },
  }
}

/// Binds socket s to a local port (0: any free ephemeral one).
fn sock_bind(c: &mut Nic, s: u64, port: u64) -> bool
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return false;
    },
    Nic::Up(mut n) => {
      let ok = udp_bind(&mut n, s, port);
      c = Nic::Up(n);
      return ok;
    },
  }
}

/// Sends bytes 0..size of buf to ip:port. Returns size, or NO_SOCK.
fn sock_sendto(c: &mut Nic, s: u64, ip: u64, port: u64, buf: &Bytes, size: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      let r = udp_sendto(&mut n, s, ip, port, buf, size);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// Takes the datagram queued on s into the start of buf (at most max
/// bytes). Returns its length, or NO_SOCK if none is queued. Never waits.
fn sock_recvfrom(c: &mut Nic, s: u64, buf: &mut Bytes, max: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c) && blen(buf) == old(blen(buf))
  ensures result == NO_SOCK || (result <= blen(buf) && result <= max)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      let r = udp_recvfrom(&mut n, s, &mut buf, max);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// Is a datagram queued on s (so sock_recvfrom would return one)?
fn sock_ready(c: &Nic, s: u64) -> bool
  requires nic_ok(c)
{
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return udp_is_open(n, s) && sk_get(n, s, S_HAS) == 1; },
  }
}

/// The address and port the last datagram on s came from (0 before any).
fn sock_peer_ip(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= 4294967295
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PEER_IP) <= 4294967295 {
        return sk_get(n, s, S_PEER_IP);
      }
      return 0;
    },
  }
}

fn sock_peer_port(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= 65535
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PEER_PORT) <= 65535 {
        return sk_get(n, s, S_PEER_PORT);
      }
      return 0;
    },
  }
}

/// The local port s is bound to (0 if none).
fn sock_port(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= 65535
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PORT) <= 65535 {
        return sk_get(n, s, S_PORT);
      }
      return 0;
    },
  }
}

/// Closes s, dropping any queued datagram. False if it was not open.
fn sock_close(c: &mut Nic, s: u64) -> bool
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return false;
    },
    Nic::Up(mut n) => {
      let ok = udp_is_open(n, s);
      if ok {
        sk_set(&mut n, s, S_OPEN, 0);
        sk_set(&mut n, s, S_PORT, 0);
        sk_set(&mut n, s, S_HAS, 0);
      }
      c = Nic::Up(n);
      return ok;
    },
  }
}
