// A minimal IPv4 stack over the virtio network card: Ethernet, ARP (a
// small cache), IPv4 without options or fragments, ICMP echo (it answers
// pings and sends them) and UDP, with a table of sockets that the native
// and the Linux system calls share, and an echo service on port 7 for any
// port no socket has. The address comes from DHCP; if no server answers,
// QEMU's user-mode default (10.0.2.15/24, gateway 10.0.2.2) is used.
//
// Every frame is parsed out of a byte buffer, and the proof shows that no
// read or write leaves the buffer and no length field read off the wire can
// make it do so: a header claiming more bytes than arrived is dropped, not
// trusted.
//
// Nothing here waits. The stack is polled (from the scheduler, under its
// lock); a frame that needs an ARP answer first is held and sent when the
// answer arrives, and a ping is a request whose result the caller collects
// later (see nic_ping_start / nic_ping_check).

import "card.bastio";
import "netconst.bastio";
import "nicdrv.bastio";
import "tcpbuf.bastio";
import "core/endian.bastio";
import "core/csum.bastio";

const ETH_ARP: u64 = 0x0806;
const ETH_IP: u64 = 0x0800;
const ETH_IP6: u64 = 0x86DD;          // src/net6.bastio
const ETH_MIN: u64 = 60;              // shorter frames are padded
const MAC_BCAST: u64 = 0xFFFFFFFFFFFF;
const MAC_LIMIT: u64 = 0x1000000000000;
const IP_MAX: u64 = 4294967295;

const MY_IP: u64 = 0x0A00020F;        // 10.0.2.15, if DHCP gets no answer
const GATEWAY: u64 = 0x0A000202;      // 10.0.2.2
const NETMASK: u64 = 0xFFFFFF00;      // /24
const DNS_SERVER: u64 = 0x0A000203;   // 10.0.2.3, QEMU's resolver, with the static address

const IP_ICMP: u64 = 1;
const IP_ICMP6: u64 = 58;               // ICMPv6, as the protocol of the IPv4 frame that stands for it
const IP_UDP: u64 = 17;
const IP_TCP: u64 = 6;
const ICMP_ECHO_REPLY: u64 = 0;
const ICMP_ECHO: u64 = 8;
const UDP_ECHO_PORT: u64 = 7;
const ICMP_RATE: u64 = 50;            // ICMP errors sent in a second, at most
const PING_ID: u64 = 0x4253;          // "BS"
const PING_DATA: u64 = 32;

const ARP_N: u64 = 64;
const ARP_TTL: u64 = 6000;            // ticks (60 s) an address's MAC is kept after it was last learned (RFC 1122 2.3.2.1)
const HELD_N: u64 = 8;                // frames held for ARP answers

// DHCP (RFC 2131), as a client.
const DHCP_OFF: u64 = 0;              // no lease being sought: static address
const DHCP_DISCOVER: u64 = 1;         // DISCOVER sent, waiting for an OFFER
const DHCP_REQUEST: u64 = 2;          // REQUEST sent, waiting for the ACK
const DHCP_BOUND: u64 = 3;            // the address is leased
const DHCP_RENEW: u64 = 4;            // past T1: asking the server to extend the lease
const DHCP_REBIND: u64 = 5;           // past T2: asking any server
const FOREVER_TICKS: u64 = 18446744073709551615;
const DHCP_TRIES: u64 = 4;            // then fall back to the static address
const DHCP_WAIT: u64 = 100;           // ticks before a retry
const BOOTP_LEN: u64 = 300;           // the message, options padded
const DHCP_MAGIC: u64 = 0x63825363;
const PORT_DHCP_CLIENT: u64 = 68;
const PORT_DHCP_SERVER: u64 = 67;                 // ARP cache entries: (address, MAC)

// A ping in flight.
const PING_IDLE: u64 = 0;
const PING_ARP: u64 = 1;              // waiting for the next hop's MAC
const PING_ECHO: u64 = 2;             // request sent, waiting for the reply
const PING_DONE: u64 = 3;             // the reply came
const PING_TICKS: u64 = 200;          // give up after 2 s
const NET_PENDING: u64 = 1000;        // nic_ping_start: started, check later
const NET_NONE: u64 = 18446744073709551615;
const PID_LIMIT: u64 = 65536;

const SOCKS: u64 = 256;               // UDP sockets in the table
const UDP_START: u64 = 2;             // sockets whose queues exist at first (dq, dm and cork double from here)
const RXQ: u64 = 64;                  // datagrams each socket can queue
const UDP_MAX: u64 = 1472;            // the largest payload one frame carries
const NO_SOCK: u64 = 18446744073709551615;
const V6N: u64 = 64;                  // IPv6 peers (src/net6.bastio)
const V6W: u64 = 4;                   // words per peer: address (2), MAC, in use
const V6_BASE: u64 = 0xF0000000;      // 240.0.0.0: the first peer's token
const V6_SELF: u64 = 0xF0000040;      // V6_BASE + V6N (keep in step): in a socket's name, our own IPv6 address
const LOQ: u64 = 64;                  // frames the loopback queue holds at most ...
const LO_BYTES: u64 = 98304;         // ... in this many bytes (a ring: a frame is as long as it is)
// The frame buffers (pkt, out, and the loopback queue's slots) are far larger
// than a card's frames (FRAME_MAX): a segment between two addresses of this
// machine never meets a wire, so it can be as long as the buffer. Anything
// that leaves by a card, a virtual interface or the held-frame queue stays
// within FRAME_MAX (send_via, ip_in).
const NET_BUF: u64 = 15000;
const LO_HEAD: u64 = 94;              // 14 + 20 + 60: the Ethernet, IP and longest TCP header, which net_poll copies of a long segment
const LO_NET: u64 = 127;              // 127.0.0.0/8: this machine
const LO_IP: u64 = 0x7F000001;        // 127.0.0.1
const EPH_LO: u64 = 49152;            // ephemeral ports: 49152 .. 65535
const EPH_N: u64 = 16384;
// A socket's words in the table.
const S_OPEN: u64 = 0;                // 1 while open
const S_PORT: u64 = 1;                // its local port, 0 until bound
const S_HEAD: u64 = 2;                // the oldest queued datagram's slot
const S_COUNT: u64 = 3;               // how many are queued
const S_PEER_IP: u64 = 4;             // who sent the last datagram taken
const S_PEER_PORT: u64 = 5;
const SLOT_W: u64 = 3;                // words per queued datagram, in dm: length, address, port
const S_CORK: u64 = 6;                // bytes held back by MSG_MORE, in cork
const S_NS: u64 = 7;                  // its network namespace (src/netns.bastio)
const RAW_ICMP: u64 = 65537;           // S_PORT of a raw ICMP socket (no port number is)
const RAW_ICMP6: u64 = 65538;          // S_PORT of a raw ICMPv6 socket (src/net6.bastio)
const S_FAM: u64 = 8;                 // FAM_*: which peers it takes datagrams from
const SOCK_FIELDS: u64 = 9;           // S_FAM + 1
// Which address family a socket (UDP here, TCP listeners in tcp.bastio)
// answers to. The IPv4 and IPv6 sides share one port space, as on Linux,
// except that an IPv6-only socket and an IPv4 one may hold the same port.
const FAM_BOTH: u64 = 0;               // an AF_INET6 socket that takes IPv4 peers too (the default)
const FAM_V4: u64 = 4;                 // an AF_INET socket
const FAM_V6: u64 = 6;                 // an AF_INET6 socket with IPV6_V6ONLY

// Network namespaces and interfaces (src/netns.bastio).
const NNET: u64 = 64;                  // network namespaces
const NS_W: u64 = 7;                   // words per namespace:
const NS_USED: u64 = 0;                //   1 while it exists
const NS_GW: u64 = 1;                  //   the default route's gateway (0: none; ns 0 uses n.gw)
const NS_FWD: u64 = 2;                 //   1: forwards packets between interfaces (ip_forward)
const NS_LO: u64 = 3;                  //   its loopback interface's slot
const NS_INO: u64 = 4;                 //   its inode number (/proc/PID/ns/net)
const NS_OWNER: u64 = 5;               //   the user namespace id that made it (0: the first)
const NS_DNS: u64 = 6;                 //   the ports of the sockets bound to 127.0.0.11 (0: none): UDP's, and 65536 times a stream listener's
const DNS_IP: u64 = 2130706443;        // 127.0.0.11: Docker's embedded DNS server in a container
const DNS_PORT: u64 = 53;

const IFN: u64 = 128;                  // interfaces, all namespaces together
const IF_W: u64 = 10;                  // words per interface:
const IF_KIND: u64 = 0;                //   IFK_*
const IF_NS: u64 = 1;                  //   its namespace
const IF_FLAGS: u64 = 2;               //   IFF_UP
const IF_PEER: u64 = 3;                //   a veth's other end
const IF_MASTER: u64 = 4;              //   the bridge it is a port of, + 1 (0: none)
const IF_IP: u64 = 5;                  //   its IPv4 address (0: none; slot 1 uses n.ip)
const IF_SPAN: u64 = 6;                //   2^(32 - prefix length) (0 with no address)
const IF_MAC: u64 = 7;
const IF_NAME: u64 = 8;                //   two words: the name's 16 bytes, low byte first

const IFK_FREE: u64 = 0;
const IFK_LO: u64 = 1;
const IFK_ETH: u64 = 2;                // the network card (slot 1)
const IFK_VETH: u64 = 3;
const IFK_BRIDGE: u64 = 4;

const IF_ETH: u64 = 1;                 // the card's slot
const IFF_UP: u64 = 1;                 // Linux's interface flags
const IFF_LOOPBACK: u64 = 8;
const IFF_RUNNING: u64 = 64;
const IFF_BROADCAST: u64 = 2;
const IFF_MULTICAST: u64 = 4096;
const NO_IF: u64 = 18446744073709551615;
const NAME_LO: u64 = 0x6F6C;           // "lo"
const NAME_ETH0: u64 = 0x30687465;     // "eth0"
const CAP_NET_ADMIN: u64 = 12;          // configuring interfaces, addresses, routes
const CAP_NET_RAW: u64 = 13;            // raw sockets (ping)
const NLS: u64 = 32;                   // netlink sockets (src/rtnl.bastio)
const NLQ: u64 = 8192;                 // the answers each can queue, in bytes
const NL_W: u64 = 5;                   // words per socket:
const NL_USED: u64 = 0;
const NL_LEN: u64 = 1;                 //   bytes queued
const NL_PORT: u64 = 2;                //   its port id
const NL_NS: u64 = 3;                  //   its namespace
const NL_RAW: u64 = 4;                 //   1: what is queued is one raw mq_notify cookie (32 bytes), not rtnetlink messages
const NATN: u64 = 256;                 // masqueraded flows (src/netns.bastio)
const NAT_W: u64 = 5;                  // words per flow:
const NAT_PROTO: u64 = 0;              //   IP_TCP, IP_UDP or IP_ICMP; 0: free
const NAT_IP: u64 = 1;                 //   the inside address ...
const NAT_PORT: u64 = 2;               //   ... and port (an echo's id)
const NAT_PEER: u64 = 3;               //   the outside address
const NAT_PEER_PORT: u64 = 4;          //   ... and port (0 for ICMP)
const NAT_BASE: u64 = 40000;           // flow f goes out from port NAT_BASE + f
const NAT_NONE: u64 = 18446744073709551615;

// The TCP table's size (src/tcp.bastio has the rest).
const TCBS: u64 = 1024;               // connections (listeners and TIME_WAIT hold some)
const TCB0: u64 = 64;                 // connections the table starts with (it doubles to TCBS)
const TCB_W: u64 = 37;                // words per connection (TCP_RING, the size of
                                      // its buffers, is in src/tcpbuf.bastio)

struct Net {
  dev: Card,
  pkt: Bytes,         // the frame being handled
  out: Bytes,         // the frame being built
  ip: u64,            // our address, the gateway, and the subnet's size
  gw: u64,            // (2^32 - netmask: addresses a and b share the
  span: u64,          // subnet when a / span == b / span)
  arp: Buf,           // ARP_N entries of (address, MAC, tick it was last learned at); MAC 0: empty
  arp_next: u64,      // the entry the next new address replaces
  icmp_sec: u64,      // the second ICMP errors are being counted in, and how many went out in it (icmp_error)
  icmp_n: u64,
  held: Bytes,        // frames waiting for their next hop's MAC, HELD_N slots
  held_len: Buf,      // of RX_BUF bytes, oldest first: their lengths ...
  held_hop: Buf,      // ... and the addresses they go to
  held_n: u64,        // how many are held
  dhcp_state: u64,
  dhcp_xid: u64,      // the transaction id our messages carry
  dhcp_offer: u64,    // the address offered ...
  dhcp_server: u64,   // ... by this server
  dhcp_tries: u64,
  dhcp_until: u64,    // the tick to retry at
  dhcp_t1: u64,       // the lease's renewal, rebinding and end times, in ticks
  dhcp_t2: u64,       //   (FOREVER_TICKS for an infinite lease)
  dhcp_end: u64,
  dns: u64,           // the name server DHCP named (0: none)
  dns_new: bool,      // ... not yet written to /etc/resolv.conf (nic_dns_take)
  now: u64,           // the tick count at the last nic_tick
  ping_state: u64,
  ping_pid: u64,      // who asked
  ping_ip: u64,       // the address pinged, through ...
  ping_hop: u64,      // ... this next hop
  ping_until: u64,    // the tick it gives up at
  seq: u64,           // the last ping's sequence number
  rx: u64,            // frames received and sent
  tx: u64,
  socks: Buf,         // the UDP sockets, SOCK_FIELDS words each
  ucap: u64,          // how many sockets dq, dm and cork have room for (grows by udp_room)
  dq: Bytes,          // their queued datagrams, RXQ slots of UDP_MAX bytes each
  dm: Buf,            // what is known of each slot: SLOT_W words (dm_get)
  cork: Bytes,        // the datagram each is putting together (MSG_MORE), UDP_MAX bytes each
  eph: u64,           // where the next ephemeral port search starts
  tcbs: Buf,          // TCP connections (src/tcp.bastio), TCB_W words each
  rb: Rings,          // their receive and send buffers (src/tcpbuf.bastio)
  iss: u64,           // the next initial sequence number
  sec: u64,           // a secret from the kernel's generator (nic_seed): keys the initial sequence numbers and the ephemeral ports
  lo: Bytes,          // frames sent to ourselves, packed in a ring of LO_BYTES,
  lo_len: Buf,        // their lengths,
  lo_at: Buf,         // where each starts,
  lo_tail: u64,       // where the oldest starts (or would),
  lo_used: u64,       // how many bytes the ring holds, padding at its end included,
  lo_head: u64,       // the oldest one's slot,
  lo_n: u64,          // and how many are queued
  lo_in: bool,        // the frame in pkt came round that queue: TCP sums are skipped, as on Linux's lo
  lo_split: bool,     // pkt holds only the first LO_HEAD bytes of that frame; the rest is still in lo, where lo_src says the frame starts
  lo_src: u64,
  seen_rx: u64,       // rx and the tick count when sock_wake last looked
  seen_tick: u64,
  irq_on: bool,       // received frames raise the card's interrupt (nic_listen)
  v6: Buf,            // IPv6 peers, V6W words each (src/net6.bastio)
  v6_next: u64,       // the slot the next new peer takes
  iid: u64,           // our interface id (low half of our IPv6 addresses)
  pfx: u64,           // the advertised prefix (high half of our global address), 0: none yet
  rtr_mac: u64,       // the IPv6 default router's MAC, 0: none
  rtr_lo: u64,        // and the low half of its link-local address (fe80::...)
  dns6_hi: u64,       // an IPv6 name server from a router advertisement (RDNSS), 0: none
  dns6_lo: u64,
  rs_n: u64,          // router solicitations sent
  rs_until: u64,      // the tick to send the next at
  ns: u64,            // the network namespace being handled (src/netns.bastio)
  ifs: Buf,           // interfaces, IF_W words each
  nss: Buf,           // namespaces, NS_W words each
  ns_seq: u64,        // numbers the namespaces' inodes
  lo_if: Buf,         // the interface each frame in the loopback queue arrives on
  in_if: u64,         // the interface the frame in pkt came in on
  nlq: Bytes,         // netlink sockets' queued answers, NLQ bytes each (src/rtnl.bastio)
  nls: Buf,           // netlink sockets, NL_W words each
  nl_at: u64,         // where the answer being written goes, ...
  nl_lim: u64,        // ... how far it may go, ...
  nl_msg: u64,        // ... where its message starts,
  nl_full: bool,      // ... and whether something did not fit
  nat: Buf,           // masqueraded flows, NAT_W words each
  nat_next: u64,      // the flow replaced when every one is in use
}

spec fn net_ok(n: &Net) -> bool {
  card_ok(n.dev) && blen(n.pkt) == NET_BUF && blen(n.out) == NET_BUF && blen(n.held) == HELD_N * RX_BUF
  && n.ip <= IP_MAX && n.gw <= IP_MAX && 1 <= n.span && n.span <= 4294967296
  && len(n.arp) == ARP_N * 3 && len(n.held_len) == HELD_N && len(n.held_hop) == HELD_N && n.held_n <= HELD_N && n.seq <= 65535 && n.ping_pid < PID_LIMIT && n.ping_ip <= IP_MAX
  && n.dhcp_xid <= IP_MAX && n.dhcp_offer <= IP_MAX && n.dhcp_server <= IP_MAX && n.dns <= IP_MAX
  && len(n.socks) == SOCKS * SOCK_FIELDS && n.ucap <= SOCKS && blen(n.dq) == n.ucap * RXQ * UDP_MAX && len(n.dm) == n.ucap * RXQ * SLOT_W && blen(n.cork) == n.ucap * UDP_MAX
  && len(n.tcbs) <= TCBS * TCB_W && rings_ok(n.rb)
  && blen(n.lo) == LO_BYTES && len(n.lo_len) == LOQ && len(n.lo_at) == LOQ && n.lo_tail < LO_BYTES && n.lo_used <= LO_BYTES && n.lo_head < LOQ && n.lo_n <= LOQ
  && len(n.v6) == V6N * V6W && n.rtr_mac < MAC_LIMIT
  && len(n.ifs) == IFN * IF_W && len(n.nss) == NNET * NS_W && n.ns < NNET && len(n.lo_if) == LOQ
  && blen(n.nlq) == NLS * NLQ && len(n.nls) == NLS * NL_W
  && len(n.nat) == NATN * NAT_W
}

// ---------------------------------------------------------------- bytes
// Network byte order: most significant byte first.

fn be16(b: &Bytes, o: u64) -> u64
  requires o + 2 <= blen(b)
  ensures result <= 65535
{
  return cast[u64](load_be16(b, o));
}

fn be32(b: &Bytes, o: u64) -> u64
  requires o + 4 <= blen(b)
  ensures result <= 4294967295
{
  return cast[u64](load_be32(b, o));
}

fn be48(b: &Bytes, o: u64) -> u64
  requires o + 6 <= blen(b)
  ensures result < MAC_LIMIT
{
  return be16(b, o) * 4294967296 + be32(b, o + 2);
}

fn put16(b: &mut Bytes, o: u64, v: u64)
  requires o + 2 <= blen(b) && v <= 65535
  ensures blen(b) == old(blen(b))
{
  store_be16(&mut b, o, cast[u16](v));
}

fn put32(b: &mut Bytes, o: u64, v: u64)
  requires o + 4 <= blen(b) && v <= 4294967295
  ensures blen(b) == old(blen(b))
{
  store_be32(&mut b, o, cast[u32](v));
}

fn put48(b: &mut Bytes, o: u64, v: u64)
  requires o + 6 <= blen(b) && v < MAC_LIMIT
  ensures blen(b) == old(blen(b))
{
  put16(&mut b, o, v / 4294967296);
  put32(&mut b, o + 2, v % 4294967296);
}

/// The Internet checksum of bytes off..off+n. Over a header that already
/// holds its checksum, it is 0.
fn csum(b: &Bytes, off: u64, n: u64) -> u64
  requires off + n <= blen(b)
  ensures result <= 65535
{
  return csum_inet(b, off, n);
}

/// The sum over a UDP datagram or TCP segment at 34..34+size of b and its
/// pseudo-header (addresses, protocol, length). 65535 when its checksum is
/// right.
fn l4_sum(b: &Bytes, src: u64, dst: u64, proto: u64, size: u64) -> u64
  requires 34 + size <= blen(b) && src <= IP_MAX && dst <= IP_MAX && proto <= 255 && size <= 65535
  ensures result <= 65535
{
  return csum_sum16(b, 34, size, csum_pseudo4(src, dst, proto, size));
}

/// Copies the first n bytes of the received frame to the outgoing one.
fn net_copy(n: &mut Net, flen: u64)
  requires net_ok(n) && flen <= RX_BUF
  ensures net_ok(n)
{
  bcopy(&mut n.out, 0, n.pkt, 0, flen);
}

/// Sends the first `flen` bytes of the outgoing frame, padded to the
/// Ethernet minimum.
fn net_send(n: &mut Net, flen: u64) -> bool
  requires net_ok(n) && flen <= FRAME_MAX
  ensures net_ok(n)
{
  let mut l = flen;
  while l < ETH_MIN
    invariant flen <= l && l <= FRAME_MAX && net_ok(n)
  {
    bset(&mut n.out, l, 0);
    l = l + 1;
  }
  if n.tx < 18446744073709551615 {
    n.tx = n.tx + 1;
  }
  return card_send(&mut n.dev, n.out, l);
}

fn eth_header(n: &mut Net, dst: u64, kind: u64)
  requires net_ok(n) && dst < MAC_LIMIT && kind <= 65535
  ensures net_ok(n)
{
  put48(&mut n.out, 0, dst);
  put48(&mut n.out, 6, card_mac(n.dev));
  put16(&mut n.out, 12, kind);
}

// ---------------------------------------------------------------- ARP

/// The MAC address cached for `ip`, or 0.
fn arp_find(n: &Net, ip: u64) -> u64
  requires net_ok(n)
  ensures result < MAC_LIMIT
{
  let mut i = 0;
  while i < ARP_N
    invariant i <= ARP_N
  {
    let mac = get(n.arp, 3 * i + 1);
    if get(n.arp, 3 * i) == ip && mac < MAC_LIMIT {
      return mac;
    }
    i = i + 1;
  }
  return 0;
}

/// ARP cache entry e as /proc/net/arp shows it: field 0 is its address (0
/// if the entry is empty), field 1 its MAC address.
fn nic_arp(c: &Nic, e: u64, f: u64) -> u64
  requires nic_ok(c)
  ensures result < MAC_LIMIT || result <= IP_MAX
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if e >= ARP_N || get(n.arp, 3 * e + 1) >= MAC_LIMIT || get(n.arp, 3 * e) > IP_MAX || get(n.arp, 3 * e + 1) == 0 {
        return 0;
      }
      if f == 0 {
        return get(n.arp, 3 * e);
      }
      return get(n.arp, 3 * e + 1);
    },
  }
}

/// Caches ip -> mac, over the old entry for ip if there is one, else over
/// the oldest.
fn arp_learn(n: &mut Net, ip: u64, mac: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  let mut i = 0;
  while i < ARP_N
    invariant i <= ARP_N && net_ok(n)
  {
    if get(n.arp, 3 * i) == ip {
      n.arp = set(n.arp, 3 * i + 1, mac);
      n.arp = set(n.arp, 3 * i + 2, n.now);
      return;
    }
    i = i + 1;
  }
  let e = n.arp_next % ARP_N;
  n.arp = set(n.arp, 3 * e, ip);
  n.arp = set(n.arp, 3 * e + 1, mac);
  n.arp = set(n.arp, 3 * e + 2, n.now);
  n.arp_next = (e + 1) % ARP_N;
}

/// Forgets the MAC address of every neighbour not heard from (by an ARP
/// request or answer) for ARP_TTL ticks, so that one whose address moved (a
/// router replaced behind the same IP) is asked for again.
fn arp_age(n: &mut Net, now: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  let mut i = 0;
  while i < ARP_N
    invariant i <= ARP_N && net_ok(n)
  {
    let at = get(n.arp, 3 * i + 2);
    if now >= at && now - at >= ARP_TTL {
      n.arp = set(n.arp, 3 * i + 1, 0);
    }
    i = i + 1;
  }
}

/// Is `ip` this machine, in namespace n.ns: 127.0.0.0/8, or one of its
/// interfaces' addresses (in namespace 0, the card's too)?
fn is_local(n: &Net, ip: u64) -> bool
  requires net_ok(n)
{
  return is_local_in(n, n.ns, ip);
}

fn is_local_in(n: &Net, ns: u64, ip: u64) -> bool
  requires net_ok(n)
{
  return ip / 16777216 == LO_NET || (ns == 0 && ip == n.ip && n.ip != 0) || ns_owns(n, ns, ip);
}

/// The source address for a packet to `dst`: a loopback address answers
/// from itself; else the address of the interface it goes out of.
fn src_ip(n: &Net, dst: u64) -> u64
  requires net_ok(n)
  ensures result <= IP_MAX || result == dst
{
  if dst / 16777216 == LO_NET {
    return dst;
  }
  let i = route_if(n, dst);
  if i < IFN {
    return if_ip(n, i);
  }
  if n.ns == 0 {
    return n.ip;
  }
  let g = route_if(n, nsw(n, n.ns, NS_GW));
  if g < IFN {
    return if_ip(n, g);
  }
  return 0;
}

/// Where a packet addressed to `ip` goes: to 0.0.0.0 means this machine,
/// as on Linux, so it goes to 127.0.0.1.
fn dst_ip(ip: u64) -> u64
  ensures (ip <= IP_MAX ==> result <= IP_MAX) && result != 0
{
  if ip == 0 {
    return LO_IP;
  }
  return ip;
}

/// The address a frame for `ip` goes to: ip itself on one of our subnets,
/// else the gateway.
fn next_hop(n: &Net, ip: u64) -> u64
  requires net_ok(n)
  ensures result <= IP_MAX || result == ip
{
  if is_local(n, ip) || route_if(n, ip) < IFN {
    return ip;
  }
  if n.ns != 0 {
    let g = nsw(n, n.ns, NS_GW);
    if g <= IP_MAX {
      return g;
    }
    return 0;
  }
  if ip / n.span == n.ip / n.span || is_v6tok(ip) {
    return ip;                        // an IPv6 peer's token: src/net6.bastio
  }
  return n.gw;
}

/// Is there a way to send to ip from namespace n.ns?
fn can_reach(n: &Net, ip: u64) -> bool
  requires net_ok(n)
{
  if is_local(n, ip) || route_if(n, ip) < IFN {
    return true;
  }
  if n.ns != 0 {
    return route_if(n, nsw(n, n.ns, NS_GW)) < IFN;
  }
  if is_v6tok(ip) {
    return card_live(n.dev);          // IPv6 needs no IPv4 address to send
  }
  return card_live(n.dev) && n.ip != 0;
}

/// An ARP packet: operation, and the target's MAC and address. We are
/// always the sender.
fn arp_send(n: &mut Net, op: u64, eth_dst: u64, tmac: u64, tip: u64) -> bool
  requires net_ok(n) && op <= 2 && eth_dst < MAC_LIMIT && tmac < MAC_LIMIT && tip <= IP_MAX
  ensures net_ok(n)
{
  eth_header(&mut n, eth_dst, ETH_ARP);
  put16(&mut n.out, 14, 1);           // Ethernet
  put16(&mut n.out, 16, ETH_IP);
  bset(&mut n.out, 18, 6);
  bset(&mut n.out, 19, 4);
  put16(&mut n.out, 20, op);
  put48(&mut n.out, 22, card_mac(n.dev));
  put32(&mut n.out, 28, n.ip);
  put48(&mut n.out, 32, tmac);
  put32(&mut n.out, 38, tip);
  return net_send(&mut n, 42);
}

/// Would a frame to ip wait for room in the loopback queue?
fn lo_full(n: &Net, ip: u64) -> bool
  requires net_ok(n)
{
  return (n.lo_n >= LOQ || LO_BYTES - n.lo_used < 2 * NET_BUF) && (is_local(n, ip) || route_if(n, ip) < IFN || n.ns != 0);
}

/// Queues the outgoing frame for net_poll to take in as if it had arrived
/// on loopback.
fn lo_send(n: &mut Net, flen: u64) -> bool
  requires net_ok(n) && flen <= NET_BUF
  ensures net_ok(n)
{
  return q_send(&mut n, ns_lo(n), flen);
}

/// Where q_put would put a frame of flen bytes in lo, or NO_SOCK if the
/// queue has no room for it.
fn lo_room(n: &Net, flen: u64) -> u64
  requires net_ok(n) && flen <= NET_BUF
  ensures result == NO_SOCK || result + flen <= LO_BYTES
{
  if n.lo_n >= LOQ {
    return NO_SOCK;
  }
  // A frame does not wrap round the end of the ring: it starts over at 0
  // and the bytes left at the end count as used.
  let mut at = (n.lo_tail + n.lo_used) % LO_BYTES;
  let mut pad = 0;
  if at + flen > LO_BYTES {
    pad = LO_BYTES - at;
    at = 0;
  }
  if n.lo_used + pad + flen > LO_BYTES {
    return NO_SOCK;
  }
  return at;
}

/// Queues the outgoing frame for net_poll to take in as if it had arrived
/// on interface `to` (loopback, or a virtual one: src/netns.bastio). A
/// full queue drops it, as a busy card would; TCP sends it again.
fn q_send(n: &mut Net, to: u64, flen: u64) -> bool
  requires net_ok(n) && flen <= NET_BUF
  ensures net_ok(n)
{
  return q_put(&mut n, to, flen, flen, NO_SOCK);
}

/// q_send for a frame whose bytes from `hlen` on a caller has put in lo
/// already, at `pre` (what lo_room said): only the first hlen bytes of the
/// outgoing frame are copied. With hlen == flen nothing is in lo yet, and
/// `pre` is ignored.
fn q_put(n: &mut Net, to: u64, flen: u64, hlen: u64, pre: u64) -> bool
  requires net_ok(n) && flen <= NET_BUF && hlen <= flen
  ensures net_ok(n)
{
  if n.lo_n >= LOQ {
    return false;
  }
  let mut at = (n.lo_tail + n.lo_used) % LO_BYTES;
  let mut pad = 0;
  if at + flen > LO_BYTES {
    pad = LO_BYTES - at;
    at = 0;
  }
  if n.lo_used + pad + flen > LO_BYTES {
    return false;
  }
  if hlen < flen && at != pre {
    return false;
  }
  let slot = (n.lo_head + n.lo_n) % LOQ;
  bcopy(&mut n.lo, at, n.out, 0, hlen);
  n.lo_used = n.lo_used + pad + flen;
  n.lo_at = set(n.lo_at, slot, at);
  n.lo_len = set(n.lo_len, slot, flen);
  n.lo_if = set(n.lo_if, slot, to);
  n.lo_n = n.lo_n + 1;
  if n.tx < 18446744073709551615 {
    n.tx = n.tx + 1;
  }
  return true;
}

/// Sends an answer straight back to where a frame came from: to the MAC
/// already in the outgoing frame, or round the loopback queue if it came
/// from this machine (`ip`: the address it came from).
fn reply_send(n: &mut Net, ip: u64, flen: u64) -> bool
  requires net_ok(n) && flen <= FRAME_MAX
  ensures net_ok(n)
{
  if is_local(n, ip) {
    return lo_send(&mut n, flen);
  }
  if n.ns != 0 || route_if(n, ip) < IFN {
    let hop = next_hop(n, ip);
    if hop > IP_MAX || flen < 14 {
      return false;
    }
    return send_via(&mut n, hop, flen);
  }
  if is_v6tok(ip) {
    return v6_out(&mut n, flen);
  }
  return net_send(&mut n, flen);
}

/// Sends the outgoing frame (its first flen bytes, Ethernet header aside)
/// to `hop`: now if its MAC is cached, else once ARP answers. Up to HELD_N
/// frames wait for answers at once (two connections opened together each
/// send one); past that the frame is dropped, as a busy card would, and
/// TCP sends it again. A frame for this machine goes round the loopback
/// queue instead.
fn send_via(n: &mut Net, hop: u64, flen: u64) -> bool
  requires net_ok(n) && hop <= IP_MAX && 14 <= flen && flen <= NET_BUF
  ensures net_ok(n)
{
  if is_local(n, hop) {
    return lo_send(&mut n, flen);
  }
  if flen > FRAME_MAX {
    return false;                     // only the loopback queue takes these
  }
  let o = route_if(n, hop);
  if o < IFN {
    return virt_send(&mut n, o, hop, flen);
  }
  if n.ns != 0 {
    return false;                     // no route out of this namespace
  }
  if is_v6tok(hop) {
    return v6_out(&mut n, flen);
  }
  let mac = arp_find(n, hop);
  if mac != 0 {
    put48(&mut n.out, 0, mac);
    return net_send(&mut n, flen);
  }
  let mut asked = false;
  let mut i = 0;
  while i < n.held_n
    invariant i <= n.held_n && net_ok(n)
  {
    if get(n.held_hop, i) == hop {
      asked = true;
    }
    i = i + 1;
  }
  if n.held_n < HELD_N {
    bcopy(&mut n.held, n.held_n * RX_BUF, n.out, 0, flen);
    n.held_len = set(n.held_len, n.held_n, flen);
    n.held_hop = set(n.held_hop, n.held_n, hop);
    n.held_n = n.held_n + 1;
  }
  if asked {
    return true;                      // its ARP request is already out
  }
  return arp_send(&mut n, 1, MAC_BCAST, 0, hop);
}

/// ARP answered for `ip` (at `mac`): the frames held for it go out, oldest
/// first, and the others move down to stay in order.
fn held_release(n: &mut Net, ip: u64, mac: u64)
  requires net_ok(n) && mac < MAC_LIMIT
  ensures net_ok(n)
{
  let mut kept = 0;
  let mut i = 0;
  while i < n.held_n
    invariant kept <= i && i <= n.held_n && net_ok(n)
  {
    let l = get(n.held_len, i);
    let hop = get(n.held_hop, i);
    if l <= FRAME_MAX {
      bcopy(&mut n.out, 0, n.held, i * RX_BUF, l);
      if hop == ip {
        if l >= 14 {
          put48(&mut n.out, 0, mac);
          net_send(&mut n, l);
        }
      } else {
        bcopy(&mut n.held, kept * RX_BUF, n.out, 0, l);
        n.held_len = set(n.held_len, kept, l);
        n.held_hop = set(n.held_hop, kept, hop);
        kept = kept + 1;
      }
    }
    i = i + 1;
  }
  n.held_n = kept;
}

fn arp_in(n: &mut Net, flen: u64)
  requires net_ok(n) && flen <= RX_BUF
  ensures net_ok(n)
{
  if flen < 42 || be16(n.pkt, 14) != 1 || be16(n.pkt, 16) != ETH_IP || bget(n.pkt, 18) != 6 || bget(n.pkt, 19) != 4 {
    return;
  }
  let op = be16(n.pkt, 20);
  let smac = be48(n.pkt, 22);
  let sip = be32(n.pkt, 28);
  let tip = be32(n.pkt, 38);
  if smac == 0 || smac == MAC_BCAST {
    return;
  }
  // Learn who asked us, or answered: an entry already cached is refreshed.
  if tip == n.ip || arp_find(n, sip) != 0 {
    arp_learn(&mut n, sip, smac);
  }
  if op == 1 && tip == n.ip {
    arp_send(&mut n, 2, smac, smac, sip);
  }
  held_release(&mut n, sip, smac);
  if n.ping_state == PING_ARP && n.ping_hop == sip {
    ping_send(&mut n, smac);
  }
}

// ---------------------------------------------------------------- IPv4

/// Fills in an IPv4 header (no options) at 14 and its checksum.
fn ip_header(n: &mut Net, total: u64, proto: u64, dst: u64)
  requires net_ok(n) && 20 <= total && total <= NET_BUF - 14 && proto <= 255 && dst <= IP_MAX
  ensures net_ok(n)
{
  bset(&mut n.out, 14, 0x45);         // version 4, 5 words of header
  bset(&mut n.out, 15, 0);
  put16(&mut n.out, 16, total);
  if proto == IP_TCP {
    put32(&mut n.out, 18, 0x00004000);  // id 0 with DF set (RFC 6864): TCP keeps to the MSS
  } else {
    put16(&mut n.out, 18, n.tx % 65536);  // a datagram that may be fragmented on the way needs its own id
    put16(&mut n.out, 20, 0);
  }
  bset(&mut n.out, 22, 64);           // time to live
  bset(&mut n.out, 23, cast[u8](proto));
  put16(&mut n.out, 24, 0);
  put32(&mut n.out, 26, src_ip(n, dst));
  put32(&mut n.out, 30, dst);
  put16(&mut n.out, 24, csum(n.out, 14, 20));
}

/// Fills in the UDP checksum of the datagram being built (ulen bytes at 34).
fn udp_seal(n: &mut Net, dst: u64, ulen: u64)
  requires net_ok(n) && dst <= IP_MAX && 8 <= ulen && ulen <= FRAME_MAX - 34
  ensures net_ok(n)
{
  put16(&mut n.out, 40, 0);
  let mut c = 65535 - l4_sum(n.out, src_ip(n, dst), dst, IP_UDP, ulen);
  if c == 0 {
    c = 65535;                        // 0 would mean "no checksum"
  }
  put16(&mut n.out, 40, c);
}

/// Answers an echo request: the same frame back, addresses swapped.
fn icmp_echo_reply(n: &mut Net, total: u64)
  requires net_ok(n) && 28 <= total && total <= FRAME_MAX - 14
  ensures net_ok(n)
{
  let src = be32(n.pkt, 26);
  let smac = be48(n.pkt, 6);
  net_copy(&mut n, 14 + total);
  eth_header(&mut n, smac, ETH_IP);
  ip_header(&mut n, total, IP_ICMP, src);
  bset(&mut n.out, 34, cast[u8](ICMP_ECHO_REPLY));
  put16(&mut n.out, 36, 0);
  put16(&mut n.out, 36, csum(n.out, 34, total - 20));
  reply_send(&mut n, src, 14 + total);
}

/// Echoes a UDP datagram (already checked: ulen fits in total) back to
/// where it came from.
fn udp_echo(n: &mut Net, ulen: u64)
  requires net_ok(n) && 8 <= ulen && ulen <= FRAME_MAX - 34
  ensures net_ok(n)
{
  let src = be32(n.pkt, 26);
  let smac = be48(n.pkt, 6);
  let sport = be16(n.pkt, 34);
  let dport = be16(n.pkt, 36);
  net_copy(&mut n, 34 + ulen);
  eth_header(&mut n, smac, ETH_IP);
  ip_header(&mut n, 20 + ulen, IP_UDP, src);
  put16(&mut n.out, 34, dport);
  put16(&mut n.out, 36, sport);
  udp_seal(&mut n, src, ulen);
  reply_send(&mut n, src, 34 + ulen);
}

/// ICMP destination unreachable, port unreachable (RFC 1122 4.1.3.4) for
/// the datagram in pkt: the start of it (its IP header and 8 bytes) goes
/// back to its sender. At most ICMP_RATE a second are sent (RFC 1122
/// 3.2.2), and none to an IPv6 peer's token (src/net6.bastio answers those).
fn icmp_unreach(n: &mut Net)
  requires net_ok(n)
  ensures net_ok(n)
{
  let src = be32(n.pkt, 26);
  if is_v6tok(src) || src == 0 {
    return;
  }
  if n.now / 100 != n.icmp_sec {
    n.icmp_sec = n.now / 100;
    n.icmp_n = 0;
  }
  if n.icmp_n >= ICMP_RATE {
    return;
  }
  n.icmp_n = n.icmp_n + 1;
  let smac = be48(n.pkt, 6);
  eth_header(&mut n, smac, ETH_IP);
  ip_header(&mut n, 56, IP_ICMP, src);
  bset(&mut n.out, 34, 3);            // destination unreachable ...
  bset(&mut n.out, 35, 3);            // ... port
  put16(&mut n.out, 36, 0);
  put32(&mut n.out, 38, 0);
  bcopy(&mut n.out, 42, n.pkt, 14, 28);
  put16(&mut n.out, 36, csum(n.out, 34, 36));
  reply_send(&mut n, src, 70);
}

/// A UDP datagram for us (total: the IP length, checked against the
/// frame): its checksum is checked when it has one, then it goes to the
/// socket bound to its port, or to the echo on port 7.
fn udp_in(n: &mut Net, total: u64)
  requires net_ok(n) && 28 <= total && total <= FRAME_MAX - 14
  ensures net_ok(n)
{
  let ulen = be16(n.pkt, 38);
  if ulen < 8 || ulen > total - 20 {
    return;
  }
  if be16(n.pkt, 40) != 0 && l4_sum(n.pkt, be32(n.pkt, 26), be32(n.pkt, 30), IP_UDP, ulen) != 65535 {
    return;
  }
  let dport = be16(n.pkt, 36);
  if dport == PORT_DHCP_CLIENT && n.ns == 0 {
    dhcp_in(&mut n, ulen);
    return;
  }
  if be32(n.pkt, 30) == IP_MAX {
    return;                           // other broadcasts: nobody listens
  }
  let s = sock_find_in(n, dport, is_v6tok(be32(n.pkt, 26)));
  if s < SOCKS {
    udp_deliver(&mut n, s, ulen);
  } else if dport == UDP_ECHO_PORT {
    udp_echo(&mut n, ulen);
  } else {
    icmp_unreach(&mut n);
  }
}

fn ip_in(n: &mut Net, frame_len: u64)
  requires net_ok(n) && frame_len <= NET_BUF
  ensures net_ok(n)
{
  let mut flen = frame_len;
  if flen < 34 {
    return;
  }
  let vihl = cast[u64](bget(n.pkt, 14));
  let ihl = vihl % 16 * 4;
  if vihl / 16 != 4 || ihl < 20 || 14 + ihl > flen || csum(n.pkt, 14, ihl) != 0 {
    return;
  }
  if ihl > 20 {
    // RFC 1122 3.2.1.8: options are accepted, and none of them is acted on:
    // the packet is closed up over them, so that everything below sees the
    // plain header.
    let tot = be16(n.pkt, 16);
    if n.lo_split || tot < ihl || 14 + tot > flen {
      return;
    }
    let cut = ihl - 20;
    let mut i = 34;
    while i < 14 + tot - cut
      invariant 34 <= i && i <= 14 + tot - cut && 14 + tot <= flen && flen <= NET_BUF && net_ok(n)
    {
      bset(&mut n.pkt, i, bget(n.pkt, i + cut));
      i = i + 1;
    }
    bset(&mut n.pkt, 14, 0x45);
    put16(&mut n.pkt, 16, tot - cut);
    put16(&mut n.pkt, 24, 0);
    put16(&mut n.pkt, 24, csum(n.pkt, 14, 20));
    flen = flen - cut;
  }
  // RFC 1122 3.2.1.3: a source that is a broadcast, multicast or class E
  // address, or a loopback address that came in from the wire, is silently
  // dropped (an IPv6 peer's token stands in for a source, net6.bastio). The
  // unspecified address is only a DHCP client's.
  let src = be32(n.pkt, 26);
  if !n.lo_in && !is_v6tok(src) && (src / 16777216 == LO_NET || src >= 3758096384) {
    return;
  }
  if src == 0 && cast[u64](bget(n.pkt, 23)) != IP_UDP {
    return;
  }
  // For us: our address, or (UDP only) the broadcast address, or while a
  // lease is being sought the address offered.
  let dst = be32(n.pkt, 30);
  let seeking = n.ns == 0 && (n.dhcp_state == DHCP_DISCOVER || n.dhcp_state == DHCP_REQUEST);
  let mine = is_local(n, dst) || (seeking && dst == n.dhcp_offer && dst != 0);
  // A frame longer than a card's is a TCP segment this machine sent to
  // itself (tcp_emit); nothing else takes it in, forwards it or answers it.
  if flen > FRAME_MAX && !(mine && n.lo_in && cast[u64](bget(n.pkt, 23)) == IP_TCP) {
    return;
  }
  // A namespace that forwards passes on what comes in on a virtual
  // interface for elsewhere; namespace 0 masquerades what goes out of the
  // card, and turns the answers back (src/netns.bastio).
  if !mine && n.lo_in && 2 <= n.in_if && n.in_if < IFN && dst != IP_MAX && nsw(n, n.ns, NS_FWD) == 1 {
    fwd(&mut n, flen);
    return;
  }
  if n.ns == 0 && !n.lo_in && dst == n.ip && dst != 0 && nat_back(&mut n, flen) {
    return;
  }
  if !mine && !(dst == IP_MAX && cast[u64](bget(n.pkt, 23)) == IP_UDP) {
    return;
  }
  // No reassembly: a fragment (more-fragments set, or an offset) is not a
  // whole datagram, and must not be taken for one.
  if be16(n.pkt, 20) % 16384 != 0 {
    return;
  }
  let total = be16(n.pkt, 16);
  // The header's length must fit in what arrived, and in what we can send.
  if total < 28 || 14 + total > flen || 14 + total > NET_BUF {
    return;
  }
  let proto = cast[u64](bget(n.pkt, 23));
  if 14 + total > FRAME_MAX && proto != IP_TCP {
    return;
  }
  if proto == IP_ICMP {
    let kind = cast[u64](bget(n.pkt, 34));
    if kind == ICMP_ECHO && csum(n.pkt, 34, total - 20) == 0 {
      icmp_echo_reply(&mut n, total);
    } else if kind == ICMP_ECHO_REPLY && n.ping_state == PING_ECHO
      && be16(n.pkt, 38) == PING_ID && be16(n.pkt, 40) == n.seq {
      n.ping_state = PING_DONE;
    }
    if mine {
      raw_deliver(&mut n, total);
    }
  } else if proto == IP_UDP {
    udp_in(&mut n, total);
  } else if proto == IP_TCP && mine {
    tcp_in(&mut n, total);
  }
}

// ---------------------------------------------------------------- DHCP

/// Broadcasts a DHCP message of type `kind` (1 DISCOVER, 3 REQUEST for the
/// address offered, or, while renewing or rebinding, for the address we
/// hold, named in ciaddr as RFC 2131 4.3.2 says).
fn dhcp_send(n: &mut Net, kind: u64)
  requires net_ok(n) && kind <= 255
  ensures net_ok(n)
{
  let ulen = 8 + BOOTP_LEN;
  eth_header(&mut n, MAC_BCAST, ETH_IP);
  ip_header(&mut n, 20 + ulen, IP_UDP, IP_MAX);
  put16(&mut n.out, 34, PORT_DHCP_CLIENT);
  put16(&mut n.out, 36, PORT_DHCP_SERVER);
  put16(&mut n.out, 38, ulen);
  let mut i = 0;
  while i < BOOTP_LEN
    invariant i <= BOOTP_LEN && net_ok(n)
  {
    bset(&mut n.out, 42 + i, 0);
    i = i + 1;
  }
  bset(&mut n.out, 42, 1);            // a request
  bset(&mut n.out, 43, 1);            // Ethernet addresses ...
  bset(&mut n.out, 44, 6);            // ... six bytes long
  put32(&mut n.out, 46, n.dhcp_xid);
  let extend = n.dhcp_state == DHCP_RENEW || n.dhcp_state == DHCP_REBIND;
  if extend {
    put32(&mut n.out, 54, n.ip);      // ciaddr: the address to extend; the answer comes to it
  } else {
    put16(&mut n.out, 52, 0x8000);    // answer by broadcast: we have no address
  }
  put48(&mut n.out, 70, card_mac(n.dev));   // chaddr
  put32(&mut n.out, 278, DHCP_MAGIC);
  bset(&mut n.out, 282, 53);          // option: message type
  bset(&mut n.out, 283, 1);
  bset(&mut n.out, 284, cast[u8](kind));
  bset(&mut n.out, 285, 55);          // option: we want the mask, router and name server
  bset(&mut n.out, 286, 3);
  bset(&mut n.out, 287, 1);
  bset(&mut n.out, 288, 3);
  bset(&mut n.out, 289, 6);
  let mut o = 290;
  if kind == 3 && !extend {
    bset(&mut n.out, 290, 50);        // option: the address we want
    bset(&mut n.out, 291, 4);
    put32(&mut n.out, 292, n.dhcp_offer);
    bset(&mut n.out, 296, 54);        // option: the server we accept
    bset(&mut n.out, 297, 4);
    put32(&mut n.out, 298, n.dhcp_server);
    o = 302;
  }
  bset(&mut n.out, o, 255);           // end
  udp_seal(&mut n, IP_MAX, ulen);
  net_send(&mut n, 34 + ulen);
}

/// Starts (or restarts) looking for a lease: a DISCOVER now, retried from
/// dhcp_tick until an answer comes or the tries run out.
fn dhcp_start(n: &mut Net)
  requires net_ok(n)
  ensures net_ok(n)
{
  n.dhcp_state = DHCP_DISCOVER;
  n.dhcp_offer = 0;
  n.dhcp_until = n.now;
  if n.now <= 18446744073709551615 - DHCP_WAIT {
    n.dhcp_until = n.now + DHCP_WAIT;
  }
  dhcp_send(&mut n, 1);
}

/// Gives up on DHCP: the static address.
fn dhcp_static(n: &mut Net)
  requires net_ok(n)
  ensures net_ok(n)
{
  n.dhcp_state = DHCP_OFF;
  n.ip = MY_IP;
  n.gw = GATEWAY;
  n.span = 4294967296 - NETMASK;
  n.dns = DNS_SERVER;
  n.dns_new = true;
}

/// A DHCP message to our port (ulen bytes of UDP at 34, checked to fit the
/// frame): an OFFER gets a REQUEST, an ACK for the address offered sets our
/// address, mask, gateway, name server and the lease's times (dhcp_bind),
/// an ACK while renewing or rebinding extends the lease, and a NAK starts
/// over.
fn dhcp_in(n: &mut Net, ulen: u64)
  requires net_ok(n) && 8 <= ulen && ulen <= FRAME_MAX - 34
  ensures net_ok(n)
{
  let end = 34 + ulen;                // the end of the datagram in the frame
  let extend = n.dhcp_state == DHCP_RENEW || n.dhcp_state == DHCP_REBIND;
  if (n.dhcp_state != DHCP_DISCOVER && n.dhcp_state != DHCP_REQUEST && !extend) || end < 282
    || bget(n.pkt, 42) != 2 || be32(n.pkt, 46) != n.dhcp_xid || be32(n.pkt, 278) != DHCP_MAGIC {
    return;
  }
  let yiaddr = be32(n.pkt, 58);
  let mut kind = 0;
  let mut mask = NETMASK;
  let mut router = 0;
  let mut server = 0;
  let mut dns = 0;
  let mut lease = IP_MAX;             // seconds; no option 51: as good as forever
  let mut t1 = IP_MAX + 1;            // none given yet
  let mut t2 = IP_MAX + 1;
  let mut o = 282;
  while o < end
    invariant 282 <= o && mask <= IP_MAX && router <= IP_MAX && server <= IP_MAX && dns <= IP_MAX
      && lease <= IP_MAX && t1 <= IP_MAX + 1 && t2 <= IP_MAX + 1
  {
    let code = cast[u64](bget(n.pkt, o));
    if code == 255 || o + 1 >= end {
      o = end;
    } else if code == 0 {
      o = o + 1;                      // padding
    } else {
      let l = cast[u64](bget(n.pkt, o + 1));
      if o + 2 + l > end {
        o = end;                      // runs past the datagram: ignore the rest
      } else {
        if code == 53 && l >= 1 {
          kind = cast[u64](bget(n.pkt, o + 2));
        } else if code == 1 && l >= 4 {
          mask = be32(n.pkt, o + 2);
        } else if code == 3 && l >= 4 {
          router = be32(n.pkt, o + 2);
        } else if code == 54 && l >= 4 {
          server = be32(n.pkt, o + 2);
        } else if code == 6 && l >= 4 {
          dns = be32(n.pkt, o + 2);   // the first of the servers listed
        } else if code == 51 && l >= 4 {
          lease = be32(n.pkt, o + 2);
        } else if code == 58 && l >= 4 {
          t1 = be32(n.pkt, o + 2);
        } else if code == 59 && l >= 4 {
          t2 = be32(n.pkt, o + 2);
        }
        o = o + 2 + l;
      }
    }
  }
  if n.dhcp_state == DHCP_DISCOVER && kind == 2 && yiaddr != 0 && yiaddr != IP_MAX {
    n.dhcp_offer = yiaddr;
    n.dhcp_server = server;
    n.dhcp_state = DHCP_REQUEST;
    dhcp_send(&mut n, 3);
  } else if ((n.dhcp_state == DHCP_REQUEST && yiaddr == n.dhcp_offer) || (extend && yiaddr != 0 && yiaddr != IP_MAX)) && kind == 5 {
    n.ip = yiaddr;
    n.gw = router;
    n.span = 4294967296 - mask;
    n.dhcp_state = DHCP_BOUND;
    n.dhcp_tries = 0;
    if server != 0 {
      n.dhcp_server = server;
    }
    if dns != n.dns {
      n.dns = dns;
      n.dns_new = true;
    }
    if !extend {
      n.dns_new = true;
    }
    dhcp_bind(&mut n, lease, t1, t2);
  } else if (n.dhcp_state == DHCP_REQUEST || extend) && kind == 6 {
    n.ip = 0;                         // the server says the address is not ours
    dhcp_start(&mut n);
  }
}

/// Seconds from now as a tick, saturating (100 ticks a second).
fn dhcp_at(now: u64, secs: u64) -> u64
  requires secs <= IP_MAX
{
  if secs == IP_MAX || now > FOREVER_TICKS - 100 * IP_MAX {
    return FOREVER_TICKS;             // an infinite lease, or a clock past any use
  }
  return now + 100 * secs;
}

/// The lease's times after an ACK: renew at T1 (half the lease unless the
/// server says), rebind at T2 (seven eighths), give the address up at the
/// end. A T1 or T2 out of order is replaced by the default.
fn dhcp_bind(n: &mut Net, lease: u64, t1: u64, t2: u64)
  requires net_ok(n) && lease <= IP_MAX && t1 <= IP_MAX + 1 && t2 <= IP_MAX + 1
  ensures net_ok(n)
{
  let mut a = lease / 2;
  if t1 < lease {
    a = t1;
  }
  let mut b = lease / 8 * 7;
  if t2 < lease && t2 > a {
    b = t2;
  }
  if b < a {
    b = a;
  }
  n.dhcp_t1 = dhcp_at(n.now, a);
  n.dhcp_t2 = dhcp_at(n.now, b);
  n.dhcp_end = dhcp_at(n.now, lease);
}

/// When to ask again while renewing or rebinding: half the time left
/// until `limit` (RFC 2131 4.4.5 says the same, at least a minute; here at
/// least DHCP_WAIT, so a short lease is not lost), or at `limit`.
fn dhcp_retry_at(now: u64, limit: u64) -> u64 {
  if limit <= now {
    return now;
  }
  let half = (limit - now) / 2;
  if half < DHCP_WAIT {
    if limit - now < DHCP_WAIT {
      return limit;
    }
    return now + DHCP_WAIT;
  }
  return now + half;
}

/// The timer side of DHCP: retries a message that got no answer, and after
/// DHCP_TRIES of them falls back to the static address. A lease is renewed
/// from T1 with its server, rebound from T2 with any, and given up at its
/// end, when the search starts again.
fn dhcp_tick(n: &mut Net, now: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  n.now = now;
  let st = n.dhcp_state;
  if (st == DHCP_BOUND || st == DHCP_RENEW || st == DHCP_REBIND) && now >= n.dhcp_end {
    n.ip = 0;                         // the lease ran out
    n.dhcp_tries = 0;
    dhcp_start(&mut n);
    return;
  }
  if st == DHCP_BOUND && now >= n.dhcp_t1 {
    n.dhcp_state = DHCP_RENEW;
    n.dhcp_until = 0;
  }
  if n.dhcp_state == DHCP_RENEW && now >= n.dhcp_t2 {
    n.dhcp_state = DHCP_REBIND;
    n.dhcp_until = 0;
  }
  if n.dhcp_state == DHCP_RENEW || n.dhcp_state == DHCP_REBIND {
    if now >= n.dhcp_until {
      let mut limit = n.dhcp_end;
      if n.dhcp_state == DHCP_RENEW {
        limit = n.dhcp_t2;
      }
      n.dhcp_until = dhcp_retry_at(now, limit);
      dhcp_send(&mut n, 3);
    }
    return;
  }
  if (n.dhcp_state != DHCP_DISCOVER && n.dhcp_state != DHCP_REQUEST) || now < n.dhcp_until {
    return;
  }
  if n.dhcp_tries >= DHCP_TRIES - 1 {
    dhcp_static(&mut n);
    return;
  }
  n.dhcp_tries = n.dhcp_tries + 1;
  dhcp_start(&mut n);
}

// ---------------------------------------------------------------- ping

/// Sends the echo request of the ping in flight to MAC `mac`.
fn ping_send(n: &mut Net, mac: u64)
  requires net_ok(n) && mac < MAC_LIMIT
  ensures net_ok(n)
{
  let total = 20 + 8 + PING_DATA;
  eth_header(&mut n, mac, ETH_IP);
  ip_header(&mut n, total, IP_ICMP, n.ping_ip);
  bset(&mut n.out, 34, cast[u8](ICMP_ECHO));
  bset(&mut n.out, 35, 0);
  put16(&mut n.out, 36, 0);
  put16(&mut n.out, 38, PING_ID);
  put16(&mut n.out, 40, n.seq);
  let mut i = 0;
  while i < PING_DATA
    invariant i <= PING_DATA && net_ok(n)
  {
    bset(&mut n.out, 42 + i, cast[u8](0x61 + i % 26));   // "abcd..."
    i = i + 1;
  }
  put16(&mut n.out, 36, csum(n.out, 34, total - 20));
  net_send(&mut n, 14 + total);
  n.ping_state = PING_ECHO;
}

/// Starts a ping of `ip` for process `pid`; the result is collected with
/// ping_check. NET_PENDING if started, 4 if another ping is in flight.
fn ping_start(n: &mut Net, ip: u64, pid: u64, now: u64) -> u64
  requires net_ok(n) && ip <= IP_MAX && pid < PID_LIMIT
  ensures net_ok(n)
{
  if n.ip == 0 {
    return 3;                         // no address yet
  }
  if n.ping_state != PING_IDLE || now > 18446744073709551615 - PING_TICKS {
    return 4;
  }
  let hop = next_hop(n, ip);
  if hop > IP_MAX {
    return 4;
  }
  n.seq = (n.seq + 1) % 65536;
  n.ping_ip = ip;
  n.ping_hop = hop;
  n.ping_pid = pid;
  n.ping_until = now + PING_TICKS;
  let mac = arp_find(n, hop);
  if mac != 0 {
    ping_send(&mut n, mac);
  } else {
    n.ping_state = PING_ARP;
    arp_send(&mut n, 1, MAC_BCAST, 0, hop);
  }
  return NET_PENDING;
}

/// The ping's outcome once it has one: 8 * pid + result, where result is
/// 1 for a reply, 0 for none in time, 2 if ARP got no answer. NET_NONE
/// while it is still waiting, or if there is none.
fn ping_check(n: &mut Net, now: u64) -> u64
  requires net_ok(n)
  ensures net_ok(n)
  ensures result == NET_NONE || (result / 8 < PID_LIMIT && result % 8 <= 2)
{
  let mut r = NET_NONE;
  if n.ping_state == PING_DONE {
    r = 1;
  } else if n.ping_state != PING_IDLE && now >= n.ping_until {
    r = 0;
    if n.ping_state == PING_ARP {
      r = 2;
    }
  }
  if r == NET_NONE {
    return NET_NONE;
  }
  n.ping_state = PING_IDLE;
  return n.ping_pid * 8 + r;
}

// ---------------------------------------------------------------- UDP sockets

fn sk_get(n: &Net, s: u64, f: u64) -> u64
  requires net_ok(n) && s < SOCKS && f < SOCK_FIELDS
  ensures result == get(n.socks, s * SOCK_FIELDS + f)
{
  return get(n.socks, s * SOCK_FIELDS + f);
}

fn sk_set(n: &mut Net, s: u64, f: u64, v: u64)
  requires net_ok(n) && s < SOCKS && f < SOCK_FIELDS
  ensures net_ok(n)
{
  n.socks = set(n.socks, s * SOCK_FIELDS + f, v);
}

/// Word k of the entry for queue slot `slot` of socket s (an open socket has
/// its entries: udp_slot_ok).
fn dm_get(n: &Net, s: u64, slot: u64, k: u64) -> u64
  requires net_ok(n) && s < n.ucap && slot < RXQ && k < SLOT_W
{
  return get(n.dm, (s * RXQ + slot) * SLOT_W + k);
}

fn dm_set(n: &mut Net, s: u64, slot: u64, k: u64, v: u64)
  requires net_ok(n) && s < n.ucap && slot < RXQ && k < SLOT_W
  ensures net_ok(n)
{
  n.dm = set(n.dm, (s * RXQ + slot) * SLOT_W + k, v);
}

/// The open socket bound to `port`, or SOCKS if there is none.
fn sock_find(n: &Net, port: u64) -> u64
  requires net_ok(n)
  ensures result <= SOCKS
{
  if port == 0 {
    return SOCKS;
  }
  let mut s = 0;
  while s < SOCKS
    invariant s <= SOCKS
  {
    if sk_get(n, s, S_OPEN) == 1 && sk_get(n, s, S_PORT) == port && sk_get(n, s, S_NS) == n.ns {
      return s;
    }
    s = s + 1;
  }
  return SOCKS;
}

/// Can a socket of family a and one of family b hold the same port? Only
/// an IPv4 socket and an IPv6-only one can.
fn fam_apart(a: u64, b: u64) -> bool
{
  return (a == FAM_V4 && b == FAM_V6) || (a == FAM_V6 && b == FAM_V4);
}

/// Does a socket of family fam take what comes from an IPv6 peer (v6) or
/// an IPv4 one?
fn fam_takes(fam: u64, v6: bool) -> bool
{
  if v6 {
    return fam != FAM_V4;
  }
  return fam != FAM_V6;
}

/// The socket a datagram from an IPv6 (v6) or IPv4 peer to `port` goes
/// to; SOCKS if none.
fn sock_find_in(n: &Net, port: u64, v6: bool) -> u64
  requires net_ok(n)
  ensures result <= SOCKS
{
  if port == 0 {
    return SOCKS;
  }
  let mut s = 0;
  while s < SOCKS
    invariant s <= SOCKS
  {
    if sk_get(n, s, S_OPEN) == 1 && sk_get(n, s, S_PORT) == port && sk_get(n, s, S_NS) == n.ns
      && fam_takes(sk_get(n, s, S_FAM), v6) {
      return s;
    }
    s = s + 1;
  }
  return SOCKS;
}

/// Does a socket of family fam keep another from `port`?
fn port_busy(n: &Net, port: u64, fam: u64) -> bool
  requires net_ok(n)
{
  if port == 0 {
    return false;
  }
  let mut s = 0;
  while s < SOCKS
    invariant s <= SOCKS
  {
    if sk_get(n, s, S_OPEN) == 1 && sk_get(n, s, S_PORT) == port && sk_get(n, s, S_NS) == n.ns
      && !fam_apart(sk_get(n, s, S_FAM), fam) {
      return true;
    }
    s = s + 1;
  }
  return false;
}

/// Whether socket s has its datagram queue and cork buffer (udp_room makes
/// them when the socket is opened, so an open socket always does).
fn udp_slot_ok(n: &Net, s: u64) -> bool
  requires net_ok(n)
  ensures result ==> s < SOCKS && (s + 1) * RXQ * UDP_MAX <= blen(n.dq) && (s + 1) * RXQ * SLOT_W <= len(n.dm) && (s + 1) * UDP_MAX <= blen(n.cork)
{
  return s < n.ucap;
}

/// Makes the queues and cork buffers of the first `count` sockets, doubling
/// from UDP_START (the allocator reuses a freed block only for a buffer of
/// exactly the same size, so a step of one socket would leave every old copy
/// unused), with their bytes kept. False, with n as it was, when memory
/// runs out.
fn udp_room(n: &mut Net, count: u64) -> bool
  requires net_ok(n) && count <= SOCKS
  ensures net_ok(n) && (result ==> count <= n.ucap)
{
  if count <= n.ucap {
    return true;
  }
  let mut c = UDP_START;
  while c < count
    invariant c >= UDP_START && c <= SOCKS && net_ok(n)
  {
    c = c * 2;
    if c > SOCKS {
      c = SOCKS;
    }
  }
  let mut nq = try_balloc(c * RXQ * UDP_MAX);
  let mut nc = try_balloc(c * UDP_MAX);
  let mut nm = try_alloc(c * RXQ * SLOT_W);
  if blen(nq) != c * RXQ * UDP_MAX || blen(nc) != c * UDP_MAX || len(nm) != c * RXQ * SLOT_W {
    bfree(nq);
    bfree(nc);
    free(nm);
    return false;
  }
  let mut i = 0;
  while i < n.ucap * RXQ * SLOT_W
    invariant i <= n.ucap * RXQ * SLOT_W && len(n.dm) == n.ucap * RXQ * SLOT_W && len(nm) == c * RXQ * SLOT_W && n.ucap <= c
  {
    nm = set(nm, i, get(n.dm, i));
    i = i + 1;
  }
  bcopy(&mut nq, 0, n.dq, 0, n.ucap * RXQ * UDP_MAX);
  bcopy(&mut nc, 0, n.cork, 0, n.ucap * UDP_MAX);
  let pq = n.dq;
  let pc = n.cork;
  let pm = n.dm;
  n.dq = nq;
  n.cork = nc;
  n.dm = nm;
  n.ucap = c;
  bfree(pq);
  bfree(pc);
  free(pm);
  return true;
}

/// Queues the payload of the received UDP datagram (ulen bytes with its
/// header, at 34) on socket s. A datagram arriving at a full queue is
/// dropped, which UDP allows.
fn udp_deliver(n: &mut Net, s: u64, ulen: u64)
  requires net_ok(n) && s < SOCKS && 8 <= ulen && ulen <= FRAME_MAX - 34
  ensures net_ok(n)
{
  let count = sk_get(n, s, S_COUNT);
  if count >= RXQ || !udp_slot_ok(n, s) {
    return;
  }
  let slot = (sk_get(n, s, S_HEAD) % RXQ + count) % RXQ;
  let plen = ulen - 8;
  let at = (s * RXQ + slot) * UDP_MAX;
  bcopy(&mut n.dq, at, n.pkt, 42, plen);
  dm_set(&mut n, s, slot, 0, plen);
  let sport = be16(n.pkt, 34);
  if n.ns != 0 && sport != 0 && sport == nsw(n, n.ns, NS_DNS) % 65536 && be32(n.pkt, 26) / 16777216 == LO_NET {
    // An answer from the resolver bound to 127.0.0.11 reads as from its port 53.
    dm_set(&mut n, s, slot, 1, DNS_IP);
    dm_set(&mut n, s, slot, 2, DNS_PORT);
  } else {
    dm_set(&mut n, s, slot, 1, be32(n.pkt, 26));
    dm_set(&mut n, s, slot, 2, sport);
  }
  sk_set(&mut n, s, S_COUNT, count + 1);
}

/// Docker's embedded DNS server listens on 127.0.0.11 in each container's
/// namespace, at a port of its own, and an iptables rule sends port 53 there.
/// BastiOS has no netfilter: the port that a socket of namespace n.ns bound
/// with that address is where traffic for 127.0.0.11:53 goes in that
/// namespace. This is the port for ip:port (a stream listener's if tcp).
fn dns_redirect(n: &Net, ns: u64, ip: u64, port: u64, tcp: bool) -> u64
  requires net_ok(n)
{
  if ip != DNS_IP || port != DNS_PORT || ns == 0 || ns >= NNET {
    return port;
  }
  let w = nsw(n, ns, NS_DNS);
  let mut p = w % 65536;
  if tcp {
    p = w / 65536 % 65536;
  }
  if p == 0 {
    return port;
  }
  return p;
}

/// Notes that a socket of namespace ns bound ip:port: a bind to 127.0.0.11
/// at a port other than 53 makes it the namespace's resolver.
fn dns_note(n: &mut Net, ns: u64, tcp: bool, ip: u64, port: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  if ns == 0 || ns >= NNET || ip != DNS_IP || port == DNS_PORT || port == 0 || port > 65535 {
    return;
  }
  let w = nsw(n, ns, NS_DNS);
  if tcp {
    nsset(&mut n, ns, NS_DNS, w % 65536 + port * 65536);
  } else {
    nsset(&mut n, ns, NS_DNS, w / 65536 % 65536 * 65536 + port);
  }
}

/// Queues the ICMP packet that came in (total bytes from its IP header,
/// at 14) on every raw ICMP socket of namespace n.ns, header and all, as
/// Linux does; what is past UDP_MAX is dropped. A full queue drops it.
fn raw_deliver(n: &mut Net, total: u64)
  requires net_ok(n) && 28 <= total && total <= FRAME_MAX - 14
  ensures net_ok(n)
{
  let plen = smaller(total, UDP_MAX);
  let src = be32(n.pkt, 26);
  let mut s = 0;
  while s < SOCKS
    invariant s <= SOCKS && net_ok(n) && plen <= UDP_MAX
  {
    let count = sk_get(n, s, S_COUNT);
    if sk_get(n, s, S_OPEN) == 1 && sk_get(n, s, S_PORT) == RAW_ICMP && sk_get(n, s, S_NS) == n.ns && count < RXQ && udp_slot_ok(n, s) {
      let slot = (sk_get(n, s, S_HEAD) % RXQ + count) % RXQ;
      let at = (s * RXQ + slot) * UDP_MAX;
      bcopy(&mut n.dq, at, n.pkt, 14, plen);
      dm_set(&mut n, s, slot, 0, plen);
      dm_set(&mut n, s, slot, 1, src);
      dm_set(&mut n, s, slot, 2, 0);
      sk_set(&mut n, s, S_COUNT, count + 1);
    }
    s = s + 1;
  }
}

/// Sends the ICMP message in bytes 0..size of buf (its checksum the
/// caller's, as on Linux) from raw socket s to ip, in an IP header the
/// stack writes. Returns size, or NO_SOCK.
fn raw_sendto(n: &mut Net, s: u64, to: u64, buf: &Bytes, size: u64) -> u64
  requires net_ok(n)
  ensures net_ok(n)
{
  let ip = dst_ip(to);
  if !udp_is_open(n, s) {
    return NO_SOCK;
  }
  let kind = sk_get(n, s, S_PORT);
  if (kind != RAW_ICMP && kind != RAW_ICMP6) || ip > IP_MAX || ip == 0
    || size < 8 || size > UDP_MAX + 8 || size > blen(buf) {
    return NO_SOCK;
  }
  sk_enter(&mut n, s);
  let mut proto = IP_ICMP;
  if kind == RAW_ICMP6 {
    proto = IP_ICMP6;
    if !is_v6tok(ip) {
      return raw6_local(&mut n, ip, buf, size);   // ::1 or our own address
    }
  } else if is_v6tok(ip) {
    return NO_SOCK;                   // an ICMPv4 message cannot go to an IPv6 peer
  }
  if !can_reach(n, ip) {
    return NO_SOCK;
  }
  let hop = next_hop(n, ip);
  if hop > IP_MAX {
    return NO_SOCK;
  }
  eth_header(&mut n, 0, ETH_IP);
  ip_header(&mut n, 20 + size, proto, ip);
  bcopy(&mut n.out, 34, buf, 0, size);
  if !send_via(&mut n, hop, 34 + size) {
    return NO_SOCK;
  }
  return size;
}

/// Opens a socket: its index, or NO_SOCK if all are taken.
fn udp_open(n: &mut Net) -> u64
  requires net_ok(n)
  ensures net_ok(n) && (result < SOCKS || result == NO_SOCK)
{
  let mut s = 0;
  while s < SOCKS
    invariant s <= SOCKS && net_ok(n)
  {
    if sk_get(n, s, S_OPEN) != 1 {
      if !udp_room(&mut n, s + 1) {
        return NO_SOCK;
      }
      sk_set(&mut n, s, S_OPEN, 1);
      sk_set(&mut n, s, S_PORT, 0);
      sk_set(&mut n, s, S_HEAD, 0);
      sk_set(&mut n, s, S_COUNT, 0);
      sk_set(&mut n, s, S_PEER_IP, 0);
      sk_set(&mut n, s, S_PEER_PORT, 0);
      sk_set(&mut n, s, S_CORK, 0);
      sk_set(&mut n, s, S_NS, n.ns);
      sk_set(&mut n, s, S_FAM, FAM_V4);
      return s;
    }
    s = s + 1;
  }
  return NO_SOCK;
}

/// Makes socket s's namespace the one being handled.
fn sk_enter(n: &mut Net, s: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  if s < SOCKS && sk_get(n, s, S_NS) < NNET {
    n.ns = sk_get(n, s, S_NS);
  }
}

fn udp_is_open(n: &Net, s: u64) -> bool
  requires net_ok(n)
  ensures result ==> s < SOCKS
{
  return s < SOCKS && sk_get(n, s, S_OPEN) == 1;
}

/// How many datagrams are queued on s (0 if it is not open).
fn udp_queued(n: &Net, s: u64) -> u64
  requires net_ok(n)
  ensures result <= RXQ && (result > 0 ==> s < SOCKS)
{
  if !udp_is_open(n, s) || sk_get(n, s, S_COUNT) > RXQ {
    return 0;
  }
  return sk_get(n, s, S_COUNT);
}

/// The length the oldest datagram queued on socket s came with (0 if none),
/// before a receive takes the part that fits.
fn udp_head_len(n: &mut Net, s: u64) -> u64
  requires net_ok(n)
  ensures net_ok(n) && result <= UDP_MAX
{
  net_poll(&mut n);
  if udp_queued(n, s) == 0 || !udp_slot_ok(n, s) {
    return 0;
  }
  let l = dm_get(n, s, sk_get(n, s, S_HEAD) % RXQ, 0);
  if l > UDP_MAX {
    return UDP_MAX;
  }
  return l;
}

/// One keyed mixing step (the multiply-xorshift finalizer the generator in
/// src/lxdev.bastio uses).
fn net_mix(z: u64) -> u64 {
  let a = wrap_mul(z ^ (z >> 30), 0xBF58476D1CE4E5B9);
  let b = wrap_mul(a ^ (a >> 27), 0x94D049BB133111EB);
  return b ^ (b >> 31);
}

/// A word that depends on the secret and on a, b and c: what RFC 6528 asks
/// of the offset of an initial sequence number, and unguessable without the
/// secret. It is a mixing function, not a MAC; an attacker who cannot see
/// our traffic has the secret's 64 bits to guess.
fn net_keyed(n: &Net, a: u64, b: u64, c: u64) -> u64
  requires net_ok(n)
{
  return net_mix(net_mix(net_mix(n.sec ^ a) ^ b) ^ c);
}

/// Where the next ephemeral port search starts: the counter, which began at
/// an unguessable place (nic_seed) and moves on by a keyed 1 to 16 each time.
/// Ports still come round slowly, so a port just closed is not handed out
/// again at once (a peer, or a NAT, may still hold the old connection).
fn net_start(n: &mut Net) -> u64
  requires net_ok(n)
  ensures net_ok(n) && result < EPH_N
{
  let c = n.eph % EPH_N;
  n.eph = (c + 1 + net_keyed(n, c, n.now, 7) % 16) % EPH_N;
  return c;
}

/// Gives the stack its secret (once: a later word is ignored).
fn nic_seed(c: &mut Nic, x: u64)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      if n.sec == 0 {
        n.sec = x | 1;
        n.eph = net_keyed(n, 0, 0, 0) % EPH_N;
      }
      c = Nic::Up(n);
    },
  }
}

/// Binds open, unbound socket s to a free ephemeral port. Returns the
/// port, or 0 if none was found. There are fewer sockets than tries, so
/// one of the ports tried is always free.
fn udp_bind_any(n: &mut Net, s: u64) -> u64
  requires net_ok(n) && s < SOCKS
  ensures net_ok(n) && result <= 65535
{
  let mut tries = 0;
  let start = net_start(&mut n);
  while tries <= SOCKS
    invariant net_ok(n)
  {
    let p = EPH_LO + (start + tries) % EPH_N;
    if sock_find(n, p) == SOCKS {
      sk_set(&mut n, s, S_PORT, p);
      return p;
    }
    tries = tries + 1;
  }
  return 0;
}

/// Binds socket s to `port` (0: any free ephemeral port). False if s is not
/// open, is already bound, or another socket has the port.
fn udp_bind(n: &mut Net, s: u64, port: u64) -> bool
  requires net_ok(n)
  ensures net_ok(n)
{
  if !udp_is_open(n, s) || sk_get(n, s, S_PORT) != 0 || port > 65535 {
    return false;
  }
  sk_enter(&mut n, s);
  if port == 0 {
    return udp_bind_any(&mut n, s) != 0;
  }
  if port_busy(n, port, sk_get(n, s, S_FAM)) {
    return false;
  }
  sk_set(&mut n, s, S_PORT, port);
  return true;
}

/// Sends bytes 0..size of buf as one datagram from socket s to ip:port,
/// binding s to an ephemeral port first if it has none. Returns size, or
/// NO_SOCK if it cannot be sent (bad socket or address, or too big). It
/// does not wait: if the next hop's MAC is not known yet, the datagram is
/// held and goes out when ARP answers.
fn udp_sendto(n: &mut Net, s: u64, to: u64, port: u64, buf: &Bytes, size: u64) -> u64
  requires net_ok(n)
  ensures net_ok(n)
{
  let ip = dst_ip(to);
  if !udp_is_open(n, s) || ip > IP_MAX || port == 0 || port > 65535
    || size > UDP_MAX || size > blen(buf) {
    return NO_SOCK;
  }
  sk_enter(&mut n, s);
  // A datagram to this machine waits for room in the loopback queue, as TCP
  // does, instead of being dropped: the queue may still hold the frames of
  // connections that were just closed. Each poll takes in what was queued
  // before it, but the answers it causes queue again (FINs, ACKs, resends
  // that a slow host lets pile up), so it may take several polls to drain.
  let mut spin = 0;
  while spin < 256 && lo_full(n, ip)
    invariant spin <= 256 && net_ok(n)
  {
    net_poll(&mut n);
    spin = spin + 1;
  }
  if !can_reach(n, ip) {
    return NO_SOCK;
  }
  if sk_get(n, s, S_PORT) == 0 && udp_bind_any(&mut n, s) == 0 {
    return NO_SOCK;
  }
  let sport = sk_get(n, s, S_PORT);
  let hop = next_hop(n, ip);
  if sport > 65535 || hop > IP_MAX {
    return NO_SOCK;
  }
  eth_header(&mut n, 0, ETH_IP);
  ip_header(&mut n, 28 + size, IP_UDP, ip);
  put16(&mut n.out, 34, sport);
  let mut dport = port;
  let via = dns_redirect(n, n.ns, ip, port, false);
  if via <= 65535 {
    dport = via;
  }
  put16(&mut n.out, 36, dport);
  put16(&mut n.out, 38, 8 + size);
  bcopy(&mut n.out, 42, buf, 0, size);
  udp_seal(&mut n, ip, 8 + size);
  if !send_via(&mut n, hop, 42 + size) {
    return NO_SOCK;
  }
  return size;
}

/// Sends bytes 0..size of buf to ip:port after what MSG_MORE held back on
/// s; with more, holds them back too. Returns size, or NO_SOCK (also when
/// the datagram would outgrow UDP_MAX: see sock_corked).
fn udp_send_more(n: &mut Net, s: u64, to: u64, port: u64, buf: &Bytes, size: u64, more: bool) -> u64
  requires net_ok(n)
  ensures net_ok(n)
{
  if !udp_is_open(n, s) || !udp_slot_ok(n, s) || size > blen(buf) {
    return NO_SOCK;
  }
  let have = sk_get(n, s, S_CORK);
  if have == 0 && !more {
    return udp_sendto(&mut n, s, to, port, buf, size);
  }
  if have > UDP_MAX || size > UDP_MAX - have {
    return NO_SOCK;
  }
  bcopy(&mut n.cork, s * UDP_MAX + have, buf, 0, size);
  if more {
    sk_set(&mut n, s, S_CORK, have + size);
    return size;
  }
  sk_set(&mut n, s, S_CORK, 0);
  let mut g = balloc(UDP_MAX);
  bcopy(&mut g, 0, n.cork, s * UDP_MAX, have + size);
  let r = udp_sendto(&mut n, s, to, port, g, have + size);
  bfree(g);
  if r == NO_SOCK {
    return NO_SOCK;
  }
  return size;
}

/// Takes the oldest datagram queued on socket s, if any: copies up to
/// `max` bytes of it (and no more than buf holds) to the start of buf and
/// returns that count, dropping the rest as Linux does; its sender becomes
/// the socket's peer. With peek the datagram stays queued. NO_SOCK if
/// nothing is queued; it never waits.
fn udp_recvfrom(n: &mut Net, s: u64, buf: &mut Bytes, max: u64, peek: bool) -> u64
  requires net_ok(n)
  ensures net_ok(n) && blen(buf) == old(blen(buf))
  ensures result == NO_SOCK || (result <= blen(buf) && result <= max)
{
  net_poll(&mut n);
  let count = udp_queued(n, s);
  if count == 0 || !udp_slot_ok(n, s) {
    return NO_SOCK;
  }
  let slot = sk_get(n, s, S_HEAD) % RXQ;
  let mut l = dm_get(n, s, slot, 0);
  if l > UDP_MAX {
    l = UDP_MAX;
  }
  if l > max {
    l = max;
  }
  if l > blen(buf) {
    l = blen(buf);
  }
  let at = (s * RXQ + slot) * UDP_MAX;
  let bl = blen(buf);
  bcopy(&mut buf, 0, n.dq, at, l);
  sk_set(&mut n, s, S_PEER_IP, dm_get(n, s, slot, 1));
  sk_set(&mut n, s, S_PEER_PORT, dm_get(n, s, slot, 2));
  if !peek {
    sk_set(&mut n, s, S_HEAD, (slot + 1) % RXQ);
    sk_set(&mut n, s, S_COUNT, count - 1);
  }
  return l;
}

// ---------------------------------------------------------------- the stack

/// Handles every frame that has arrived (a few at most per call).
fn net_poll(n: &mut Net)
  requires net_ok(n)
  ensures net_ok(n)
{
  let was = n.ns;
  // Frames we sent ourselves first: those queued now, not the answers
  // they cause, which wait for the next poll. Each is taken in by the
  // namespace of the interface it arrives on.
  let mut q = n.lo_n;
  while q > 0
    invariant net_ok(n)
  {
    let slot = n.lo_head;
    let flen = get(n.lo_len, slot);
    let to = get(n.lo_if, slot);
    let mut ns = NNET;
    if to < IFN && iw(n, to, IF_KIND) != IFK_FREE {
      ns = iw(n, to, IF_NS);
    }
    let at = get(n.lo_at, slot);
    n.lo_head = (slot + 1) % LOQ;
    if n.lo_n > 0 {
      n.lo_n = n.lo_n - 1;
    }
    // A segment longer than a card's frame (TCP to ourselves) is not copied
    // into pkt: only its headers are, and tcp_in reads its data from lo. Its
    // bytes stay in the ring's count until ip_in is done, so that a frame
    // that ip_in sends in answer is not put over them.
    let split = flen > FRAME_MAX;
    let mut keep = false;
    let mut ktail = 0;
    let mut kfreed = 0;
    let mut fits = false;
    if flen <= NET_BUF && at <= LO_BYTES && at + flen <= LO_BYTES {
      fits = true;
      // Its bytes, and any padding before it, are free again.
      let tail = (at + flen) % LO_BYTES;
      let freed = (tail + LO_BYTES - n.lo_tail) % LO_BYTES;
      if split && ns < NNET {
        keep = true;
        ktail = tail;
        kfreed = freed;
      } else if n.lo_n == 0 || freed > n.lo_used {
        n.lo_used = 0;
        n.lo_tail = 0;
      } else {
        n.lo_used = n.lo_used - freed;
        n.lo_tail = tail;
      }
    } else {
      n.lo_used = 0;                  // not a frame we queued: start the ring afresh
      n.lo_tail = 0;
    }
    if fits && ns < NNET {
      if split {
        bcopy(&mut n.pkt, 0, n.lo, at, LO_HEAD);
        n.lo_split = true;
        n.lo_src = at;
      } else {
        bcopy(&mut n.pkt, 0, n.lo, at, flen);
      }
      if n.rx < 18446744073709551615 {
        n.rx = n.rx + 1;
      }
      n.ns = ns;
      n.in_if = to;
      n.lo_in = true;
      ip_in(&mut n, flen);
      n.lo_in = false;
      n.lo_split = false;
    }
    if keep {
      if n.lo_n == 0 || kfreed > n.lo_used {
        n.lo_used = 0;
        n.lo_tail = 0;
      } else {
        n.lo_used = n.lo_used - kfreed;
        n.lo_tail = ktail;
      }
    }
    q = q - 1;
  }
  n.ns = 0;                           // the card is namespace 0's
  n.in_if = IF_ETH;
  let mut k = 0;
  let mut more = true;
  while more && k < RX_BURST
    invariant k <= RX_BURST && net_ok(n)
  {
    let flen = card_recv(&mut n.dev, &mut n.pkt);
    if flen == 0 {
      more = false;
    } else {
      if n.rx < 18446744073709551615 {
        n.rx = n.rx + 1;
      }
      if flen >= 14 {
        let kind = be16(n.pkt, 12);
        if kind == ETH_ARP {
          arp_in(&mut n, flen);
        } else if kind == ETH_IP {
          ip_in(&mut n, flen);
        } else if kind == ETH_IP6 {
          v6_in(&mut n, flen);
        }
      }
      n.ns = 0;
      k = k + 1;
    }
  }
  card_rx_flush(&mut n.dev);
  n.ns = was;
}

// ---------------------------------------------------------------- the card, or none

enum Nic { None, Up(Net) }

spec fn nic_ok(c: &Nic) -> bool {
  c is Nic::Up ==> net_ok(c.Up)
}

/// Are pages lo .. lo+k all free?
fn pages_free(m: &Mem, lo: u64, k: u64) -> bool
  requires mem_ok(m) && lo + k <= NPAGES
  ensures result ==> lo + k <= len(m.bm) && (forall i: u64 :: lo <= i && i < lo + k ==> get(m.bm, i) == 1)
{
  if lo + k > len(m.bm) {
    return false;              // a pool too small to have them
  }
  let mut i = 0;
  while i < k
    invariant i <= k && (forall j: u64 :: lo <= j && j < lo + i ==> get(m.bm, j) == 1)
  {
    if get(m.bm, lo + i) != 1 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// The stack on a started card, seeking its address by DHCP (or with the
/// static one if the card is dead).
fn net_up(d: Card) -> Nic
  requires card_ok(d)
  ensures nic_ok(result)
{
  let mut n = Net { dev: d, pkt: balloc(NET_BUF), out: balloc(NET_BUF), ip: 0, gw: 0, span: 1,
    arp: alloc(ARP_N * 3), arp_next: 0, icmp_sec: 0, icmp_n: 0, held: balloc(HELD_N * RX_BUF), held_len: alloc(HELD_N), held_hop: alloc(HELD_N), held_n: 0,
    dhcp_state: DHCP_OFF, dhcp_xid: 0, dhcp_offer: 0, dhcp_server: 0, dhcp_tries: 0, dhcp_until: 0, dhcp_t1: 0, dhcp_t2: 0, dhcp_end: 0, dns: 0, dns_new: false, now: 0,
    ping_state: PING_IDLE, ping_pid: 0, ping_ip: 0, ping_hop: 0, ping_until: 0, seq: 0, rx: 0, tx: 0,
    socks: alloc(SOCKS * SOCK_FIELDS), ucap: 0, dq: balloc(0), dm: alloc(0), cork: balloc(0), eph: 0,
    tcbs: alloc(TCB0 * TCB_W), rb: rings_new(), iss: 0, sec: 0,
    lo: balloc(LO_BYTES), lo_len: alloc(LOQ), lo_at: alloc(LOQ), lo_tail: 0, lo_used: 0, lo_head: 0, lo_n: 0, lo_in: false, lo_split: false, lo_src: 0, seen_rx: 0, seen_tick: 0, irq_on: false,
    v6: alloc(V6N * V6W), v6_next: 0, iid: 0, pfx: 0, rtr_mac: 0, rtr_lo: 0, dns6_hi: 0, dns6_lo: 0, rs_n: 0, rs_until: 0,
    ns: 0, ifs: alloc(IFN * IF_W), nss: alloc(NNET * NS_W), ns_seq: 0, lo_if: alloc(LOQ), in_if: IF_ETH,
    nlq: balloc(NLS * NLQ), nls: alloc(NLS * NL_W), nl_at: 0, nl_lim: 0, nl_msg: 0, nl_full: false,
    nat: alloc(NATN * NAT_W), nat_next: 0 };
  netns_init(&mut n);
  n.iid = v6_iid(card_mac(n.dev));
  // The address comes from DHCP, sought from now on.
  if card_live(n.dev) {
    n.dhcp_xid = card_mac(n.dev) % 4294967296;
    dhcp_start(&mut n);
  } else {
    dhcp_static(&mut n);
  }
  return Nic::Up(n);
}

/// Tops up the spare pages TCP buffers take from (rings_feed): before the
/// card is polled and in TCP system calls, where the allocator is at hand.
fn nic_feed(c: &mut Nic, m: &mut Mem)
  requires nic_ok(c) && mem_ok(m)
  ensures nic_ok(c) && mem_ok(m)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      rings_feed(&mut n.rb, &mut m);
      c = Nic::Up(n);
    },
  }
}

/// After an interrupt or an idle wait: lets an e1000 lower its interrupt
/// line, then polls the card.
fn nic_poll(c: &mut Nic)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      if n.irq_on {
        card_ack(&mut n.dev);
      }
      net_poll(&mut n);
      c = Nic::Up(n);
    },
  }
}

/// Starts a ping of `ip` for process `pid`: NET_PENDING if it is on its
/// way (collect the result with nic_ping_check), 3 if there is no network
/// card, 4 if another ping is in flight or the address is not one.
fn nic_ping_start(c: &mut Nic, ip: u64, pid: u64, now: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return 3;
    },
    Nic::Up(mut n) => {
      n.ns = 0;                       // the shell's ping
      let mut r = 3;
      let mut to = ip;
      if ip == 0 {
        to = n.gw;                    // 0: the gateway
      }
      if to > IP_MAX || pid >= PID_LIMIT {
        r = 4;
      } else if card_live(n.dev) {
        r = ping_start(&mut n, to, pid, now);
      }
      c = Nic::Up(n);
      return r;
    },
  }
}

/// The finished ping, if any, as 8 * pid + result (see ping_check);
/// NET_NONE if none has finished. `now` is the tick count.
fn nic_ping_check(c: &mut Nic, now: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
  ensures result == NET_NONE || (result / 8 < PID_LIMIT && result % 8 <= 2)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NET_NONE;
    },
    Nic::Up(mut n) => {
      n.ns = 0;
      let r = ping_check(&mut n, now);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// Has a frame come in, or the clock ticked, since the last call? Each
/// can change what a socket call waiting in SOCKWAIT would find.
///
/// Most calls find nothing new, and the card's state is several hundred
/// bytes: matching it by value to update the marks copied it out and back
/// on every system call (a tenth of a getppid). So the test only reads,
/// and the marks are written only when it says yes.
fn nic_moved(c: &mut Nic, now: u64) -> bool
  requires nic_ok(c)
  ensures nic_ok(c)
{
  if !nic_changed(c, now) {
    return false;
  }
  match c {
    Nic::None => { c = Nic::None; return false; },
    Nic::Up(mut n) => {
      n.seen_rx = n.rx;
      n.seen_tick = now;
      c = Nic::Up(n);
      return true;
    },
  }
}

/// True if frames were received since the marks were last set, or the tick
/// count is not the marked one (read only; see nic_moved).
fn nic_changed(c: &Nic, now: u64) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return n.rx != n.seen_rx || now != n.seen_tick; },
  }
}

/// A process is about to sleep until a frame comes in: received frames
/// raise the card's interrupt from now on (if it has one), and the card is
/// polled once more, for a frame that came in before (a virtio card does
/// not signal those). Frames waited for this way cost an interrupt each,
/// so they are only asked for while someone sleeps on them (nic_quiet):
/// a process that keeps calling polls the card itself.
fn nic_listen(c: &mut Nic)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      if !n.irq_on {
        card_irq_set(&mut n.dev, true);
        n.irq_on = true;
      }
      net_poll(&mut n);
      c = Nic::Up(n);
    },
  }
}

/// No one sleeps on a frame any more: received frames raise nothing.
fn nic_quiet(c: &mut Nic)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      if n.irq_on {
        card_irq_set(&mut n.dev, false);
        card_ack(&mut n.dev);                 // a cause left pending would fire the moment it is unmasked again
        n.irq_on = false;
      }
      c = Nic::Up(n);
    },
  }
}

/// Frames received and sent so far (0 without a card).
fn nic_rx(c: &Nic) -> u64 {
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => { return n.rx; },
  }
}

/// The timer side of the stack (DHCP retries); `now` is the tick count.
fn nic_tick(c: &mut Nic, now: u64)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      n.ns = 0;                       // DHCP and IPv6 are the card's: namespace 0
      arp_age(&mut n, now);
      dhcp_tick(&mut n, now);
      v6_tick(&mut n, now);
      tcp_tick(&mut n, now);
      c = Nic::Up(n);
    },
  }
}

/// How many ticks from `now` until the lease needs the timer (the renewal
/// at T1, or its end), or a very long time: static addresses and no card.
fn nic_dhcp_due(c: &Nic, now: u64) -> u64 {
  match c {
    Nic::None => { return 1099511627776; },
    Nic::Up(n) => {
      if n.dhcp_state != DHCP_BOUND {
        return 1099511627776;
      }
      let due = smaller(n.dhcp_t1, n.dhcp_end);
      if due <= now {
        return 0;
      }
      return due - now;
    },
  }
}

/// What the stack is configured with: 0 our address, 1 the gateway, 2 the
/// netmask, 3 how (0 not yet, 1 DHCP, 2 static), 4 the name server. 0
/// without a card.
fn nic_info(c: &Nic, what: u64) -> u64
  requires nic_ok(c)
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if what == 0 {
        return n.ip;
      } else if what == 1 {
        return n.gw;
      } else if what == 2 {
        return 4294967296 - n.span;
      } else if what == 4 {
        return n.dns;
      } else if what == 3 {
        if n.dhcp_state == DHCP_BOUND || n.dhcp_state == DHCP_RENEW || n.dhcp_state == DHCP_REBIND {
          return 1;
        } else if n.dhcp_state == DHCP_OFF && n.ip != 0 {
          return 2;
        }
      }
      return 0;
    },
  }
}

/// Whether the name server changed since the last call (a lease, or the
/// static fallback): /etc/resolv.conf is due to be written.
fn nic_dns_take(c: &mut Nic) -> bool
  requires nic_ok(c)
  ensures nic_ok(c)
{
  let mut r = false;
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      r = n.dns_new;
      n.dns_new = false;
      c = Nic::Up(n);
    },
  }
  return r;
}

fn nic_mac(c: &Nic) -> u64 {
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => { return card_mac(n.dev); },
  }
}

fn nic_ena(c: &Nic) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return card_is_ena(n.dev); },
  }
}

/// Why an ENA that could not be started was given up on (ENA_ERR_*), else 0.
fn nic_why(c: &Nic) -> u64 {
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => { return card_why(n.dev); },
  }
}

fn nic_e1000(c: &Nic) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return card_is_e1000(n.dev); },
  }
}

fn nic_rtl(c: &Nic) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return card_is_rtl(n.dev); },
  }
}

fn nic_irq(c: &Nic) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return card_irq(n.dev); },
  }
}

fn nic_irq_on(c: &mut Nic)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      card_irq_on(&mut n.dev);
      c = Nic::Up(n);
    },
  }
}

/// Is there a card?
fn nic_up(c: &Nic) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return true; },
  }
}

fn nic_live(c: &Nic) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return card_live(n.dev); },
  }
}

/// Takes the stack's own buffers back and hands the card over, to be reset
/// and have its pages and registers released by the architecture's driver
/// (`nic_free`, src/<arch>/arch/nicdrv.bastio).
fn net_dismantle(n: Net, m: &mut Mem) -> Card
  requires net_ok(n) && mem_ok(m)
  ensures mem_ok(m) && card_ok(result)
{
  bfree(n.pkt);
  bfree(n.out);
  bfree(n.held);
  free(n.held_len);
  free(n.held_hop);
  free(n.tcbs);
  rings_free(n.rb, &mut m);
  bfree(n.cork);
  free(n.arp);
  free(n.socks);
  bfree(n.dq);
  free(n.dm);
  bfree(n.lo);
  free(n.lo_len);
  free(n.lo_at);
  free(n.ifs);
  free(n.nss);
  free(n.lo_if);
  bfree(n.nlq);
  free(n.nls);
  free(n.nat);
  free(n.v6);
  return n.dev;
}

// ---------------------------------------------------------------- sockets, for system calls
// Each takes the card or none; with none, every call fails.

/// Opens a UDP socket: its number, or NO_SOCK if there is no card or every
/// socket is taken.
fn sock_new(c: &mut Nic, ns: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c) && (result < SOCKS || result == NO_SOCK)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      if !ns_live(n, ns) {
        c = Nic::Up(n);
        return NO_SOCK;
      }
      n.ns = ns;                      // the socket's namespace
      let s = udp_open(&mut n);
      c = Nic::Up(n);
      return s;
    },
  }
}

/// Makes socket s (just opened) a raw ICMP socket.
fn sock_make_raw(c: &mut Nic, s: u64)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      if udp_is_open(n, s) {
        sk_set(&mut n, s, S_PORT, RAW_ICMP);
      }
      c = Nic::Up(n);
    },
  }
}

/// Sets the address family socket s answers to (FAM_*).
fn sock_set_fam(c: &mut Nic, s: u64, fam: u64)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PORT) == 0 {
        sk_set(&mut n, s, S_FAM, fam);
      }
      c = Nic::Up(n);
    },
  }
}

/// Makes socket s (just opened) a raw ICMPv6 socket.
fn sock_make_raw6(c: &mut Nic, s: u64)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      if udp_is_open(n, s) {
        sk_set(&mut n, s, S_PORT, RAW_ICMP6);
      }
      c = Nic::Up(n);
    },
  }
}

fn sock_is_raw(c: &Nic, s: u64) -> bool
  requires nic_ok(c)
{
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return udp_is_open(n, s) && (sk_get(n, s, S_PORT) == RAW_ICMP || sk_get(n, s, S_PORT) == RAW_ICMP6); },
  }
}

fn sock_raw_send(c: &mut Nic, s: u64, ip: u64, buf: &Bytes, size: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; return NO_SOCK; },
    Nic::Up(mut n) => {
      let r = raw_sendto(&mut n, s, ip, buf, size);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// Binds socket s to a local port (0: any free ephemeral one).
fn sock_bind(c: &mut Nic, s: u64, port: u64) -> bool
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return false;
    },
    Nic::Up(mut n) => {
      let ok = udp_bind(&mut n, s, port);
      c = Nic::Up(n);
      return ok;
    },
  }
}

/// Notes that a stream socket of namespace ns bound ip:port (see dns_note).
fn nic_dns_note(c: &mut Nic, ns: u64, ip: u64, port: u64)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
    },
    Nic::Up(mut n) => {
      dns_note(&mut n, ns, true, ip, port);
      c = Nic::Up(n);
    },
  }
}

/// The port a stream connection of namespace ns to ip:port goes to (see
/// dns_redirect).
fn nic_dns_port(c: &Nic, ns: u64, ip: u64, port: u64) -> u64
  requires nic_ok(c)
{
  match c {
    Nic::None => {
      return port;
    },
    Nic::Up(n) => {
      return dns_redirect(n, ns, ip, port, true);
    },
  }
}

/// Notes that UDP socket s was bound to ip:port (see dns_note).
fn sock_dns_note(c: &mut Nic, s: u64, ip: u64, port: u64)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
    },
    Nic::Up(mut n) => {
      if udp_is_open(n, s) {
        dns_note(&mut n, sk_get(n, s, S_NS), false, ip, port);
      }
      c = Nic::Up(n);
    },
  }
}

/// Sends bytes 0..size of buf to ip:port. Returns size, or NO_SOCK.
fn sock_sendto(c: &mut Nic, s: u64, ip: u64, port: u64, buf: &Bytes, size: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      let r = udp_sendto(&mut n, s, ip, port, buf, size);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// sock_sendto, but after what MSG_MORE held back on s, and with more,
/// held back too.
fn sock_send_more(c: &mut Nic, s: u64, ip: u64, port: u64, buf: &Bytes, size: u64, more: bool) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      let r = udp_send_more(&mut n, s, ip, port, buf, size, more);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// The bytes MSG_MORE holds back on s.
fn sock_corked(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= UDP_MAX
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && s < SOCKS {
        return smaller(sk_get(n, s, S_CORK), UDP_MAX);
      }
      return 0;
    },
  }
}

/// Takes the oldest datagram queued on s into the start of buf (at most max
/// bytes), and leaves it queued if peek. Returns its length, or NO_SOCK if
/// none is queued. Never waits.
fn sock_recvfrom(c: &mut Nic, s: u64, buf: &mut Bytes, max: u64, peek: bool) -> u64
  requires nic_ok(c)
  ensures nic_ok(c) && blen(buf) == old(blen(buf))
  ensures result == NO_SOCK || (result <= blen(buf) && result <= max)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      let r = udp_recvfrom(&mut n, s, &mut buf, max, peek);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// The whole length of the oldest datagram queued on s (0 if none).
fn sock_head_len(c: &mut Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c) && result <= UDP_MAX
{
  match c {
    Nic::None => {
      c = Nic::None;
      return 0;
    },
    Nic::Up(mut n) => {
      let r = udp_head_len(&mut n, s);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// Is a datagram queued on s (so sock_recvfrom would return one)? It does
/// not poll the card: the scheduler does that on every pass.
fn sock_ready(c: &Nic, s: u64) -> bool
  requires nic_ok(c)
{
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return udp_queued(n, s) > 0; },
  }
}

/// The address and port the last datagram taken from s came from (0
/// before any).
fn sock_peer_ip(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= 4294967295
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PEER_IP) <= 4294967295 {
        return sk_get(n, s, S_PEER_IP);
      }
      return 0;
    },
  }
}

fn sock_peer_port(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= 65535
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PEER_PORT) <= 65535 {
        return sk_get(n, s, S_PEER_PORT);
      }
      return 0;
    },
  }
}

/// The local port s is bound to (0 if none).
fn sock_port(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= 65535
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PORT) <= 65535 {
        return sk_get(n, s, S_PORT);
      }
      return 0;
    },
  }
}

/// What /proc/net/udp shows of socket s in network namespace ns: field 0 is
/// 1 if it is shown (open, not a raw socket, in ns), 0 if not; field 1 is
/// its local port and field 2 the datagrams queued to read.
fn sock_row(c: &Nic, s: u64, ns: u64, f: u64) -> u64
  requires nic_ok(c)
  ensures result <= 4294967295
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if s >= SOCKS || !udp_is_open(n, s) || sk_get(n, s, S_NS) != ns || sk_get(n, s, S_PORT) == RAW_ICMP || sk_get(n, s, S_PORT) == RAW_ICMP6 {
        return 0;
      }
      if f == 0 {
        return 1;
      }
      if f == 1 && sk_get(n, s, S_PORT) <= 65535 {
        return sk_get(n, s, S_PORT);
      }
      if f == 2 && sk_get(n, s, S_COUNT) <= 4294967295 {
        return sk_get(n, s, S_COUNT);
      }
      return 0;
    },
  }
}

/// What /proc/net/raw shows of socket s in network namespace ns: field 0
/// is 1 if it is a raw ICMP socket of ns, field 1 the datagrams queued to
/// read.
fn raw_row(c: &Nic, s: u64, ns: u64, f: u64) -> u64
  requires nic_ok(c)
  ensures result <= 4294967295
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if s >= SOCKS || !udp_is_open(n, s) || sk_get(n, s, S_NS) != ns || sk_get(n, s, S_PORT) != RAW_ICMP {
        return 0;
      }
      if f == 0 {
        return 1;
      }
      if f == 1 && sk_get(n, s, S_COUNT) <= 4294967295 {
        return sk_get(n, s, S_COUNT);
      }
      return 0;
    },
  }
}

/// Closes s, dropping any queued datagram. False if it was not open.
fn sock_close(c: &mut Nic, s: u64) -> bool
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return false;
    },
    Nic::Up(mut n) => {
      let ok = udp_is_open(n, s);
      if ok {
        sk_set(&mut n, s, S_OPEN, 0);
        sk_set(&mut n, s, S_PORT, 0);
        sk_set(&mut n, s, S_COUNT, 0);
        sk_set(&mut n, s, S_CORK, 0);
      }
      c = Nic::Up(n);
      return ok;
    },
  }
}
