// A minimal IPv4 stack over the virtio network card: Ethernet, ARP (a
// small cache), IPv4 without options or fragments, ICMP echo (it answers
// pings and sends them) and UDP, with a table of sockets that the native
// and the Linux system calls share, and an echo service on port 7 for any
// port no socket has. The address comes from DHCP; if no server answers,
// QEMU's user-mode default (10.0.2.15/24, gateway 10.0.2.2) is used.
//
// Every frame is parsed out of a byte buffer, and the proof shows that no
// read or write leaves the buffer and no length field read off the wire can
// make it do so: a header claiming more bytes than arrived is dropped, not
// trusted.
//
// Nothing here waits. The stack is polled (from the scheduler, under its
// lock); a frame that needs an ARP answer first is held and sent when the
// answer arrives, and a ping is a request whose result the caller collects
// later (see nic_ping_start / nic_ping_check).

import "card.bastio";

const ETH_ARP: u64 = 0x0806;
const ETH_IP: u64 = 0x0800;
const ETH_MIN: u64 = 60;              // shorter frames are padded
const MAC_BCAST: u64 = 0xFFFFFFFFFFFF;
const MAC_LIMIT: u64 = 0x1000000000000;
const IP_MAX: u64 = 4294967295;

const MY_IP: u64 = 0x0A00020F;        // 10.0.2.15, if DHCP gets no answer
const GATEWAY: u64 = 0x0A000202;      // 10.0.2.2
const NETMASK: u64 = 0xFFFFFF00;      // /24

const IP_ICMP: u64 = 1;
const IP_UDP: u64 = 17;
const IP_TCP: u64 = 6;
const ICMP_ECHO_REPLY: u64 = 0;
const ICMP_ECHO: u64 = 8;
const UDP_ECHO_PORT: u64 = 7;
const PING_ID: u64 = 0x4253;          // "BS"
const PING_DATA: u64 = 32;

const ARP_N: u64 = 4;

// DHCP (RFC 2131), as a client.
const DHCP_OFF: u64 = 0;              // no lease being sought: static address
const DHCP_DISCOVER: u64 = 1;         // DISCOVER sent, waiting for an OFFER
const DHCP_REQUEST: u64 = 2;          // REQUEST sent, waiting for the ACK
const DHCP_BOUND: u64 = 3;            // the address is leased
const DHCP_TRIES: u64 = 4;            // then fall back to the static address
const DHCP_WAIT: u64 = 100;           // ticks before a retry
const BOOTP_LEN: u64 = 300;           // the message, options padded
const DHCP_MAGIC: u64 = 0x63825363;
const PORT_DHCP_CLIENT: u64 = 68;
const PORT_DHCP_SERVER: u64 = 67;                 // ARP cache entries: (address, MAC)

// A ping in flight.
const PING_IDLE: u64 = 0;
const PING_ARP: u64 = 1;              // waiting for the next hop's MAC
const PING_ECHO: u64 = 2;             // request sent, waiting for the reply
const PING_DONE: u64 = 3;             // the reply came
const PING_TICKS: u64 = 200;          // give up after 2 s
const NET_PENDING: u64 = 1000;        // nic_ping_start: started, check later
const NET_NONE: u64 = 18446744073709551615;
const PID_LIMIT: u64 = 65536;

const SOCKS: u64 = 8;                 // UDP sockets in the table
const RXQ: u64 = 4;                   // datagrams each socket can queue
const UDP_MAX: u64 = 1472;            // the largest payload one frame carries
const NO_SOCK: u64 = 18446744073709551615;
const EPH_LO: u64 = 49152;            // ephemeral ports: 49152 .. 65535
const EPH_N: u64 = 16384;
// A socket's words in the table.
const S_OPEN: u64 = 0;                // 1 while open
const S_PORT: u64 = 1;                // its local port, 0 until bound
const S_HEAD: u64 = 2;                // the oldest queued datagram's slot
const S_COUNT: u64 = 3;               // how many are queued
const S_PEER_IP: u64 = 4;             // who sent the last datagram taken
const S_PEER_PORT: u64 = 5;
const S_SLOTS: u64 = 6;               // then per slot: length, address, port
const SLOT_W: u64 = 3;
const SOCK_FIELDS: u64 = 18;          // S_SLOTS + RXQ * SLOT_W

// The TCP table's size (src/tcp.bastio has the rest).
const TCBS: u64 = 8;                  // connections
const TCP_BUF: u64 = 4096;            // bytes in each receive and send buffer
const TCB_W: u64 = 22;                // words per connection

struct Net {
  dev: Card,
  pkt: Bytes,         // the frame being handled
  out: Bytes,         // the frame being built
  ip: u64,            // our address, the gateway, and the subnet's size
  gw: u64,            // (2^32 - netmask: addresses a and b share the
  span: u64,          // subnet when a / span == b / span)
  arp: Buf,           // ARP_N entries of (address, MAC); MAC 0: empty
  arp_next: u64,      // the entry the next new address replaces
  held: Bytes,        // a frame waiting for its next hop's MAC ...
  held_len: u64,      // ... this long (0: none) ...
  held_hop: u64,      // ... to this address
  dhcp_state: u64,
  dhcp_xid: u64,      // the transaction id our messages carry
  dhcp_offer: u64,    // the address offered ...
  dhcp_server: u64,   // ... by this server
  dhcp_tries: u64,
  dhcp_until: u64,    // the tick to retry at
  now: u64,           // the tick count at the last nic_tick
  ping_state: u64,
  ping_pid: u64,      // who asked
  ping_ip: u64,       // the address pinged, through ...
  ping_hop: u64,      // ... this next hop
  ping_until: u64,    // the tick it gives up at
  seq: u64,           // the last ping's sequence number
  rx: u64,            // frames received and sent
  tx: u64,
  socks: Buf,         // the UDP sockets, SOCK_FIELDS words each
  dq: Bytes,          // their queued datagrams, RXQ slots of UDP_MAX bytes each
  eph: u64,           // where the next ephemeral port search starts
  tcbs: Buf,          // TCP connections (src/tcp.bastio), TCB_W words each
  trx: Bytes,         // their receive buffers, TCP_BUF bytes each
  ttx: Bytes,         // their send buffers (unacknowledged, then unsent)
  iss: u64,           // the next initial sequence number
}

spec fn net_ok(n: &Net) -> bool {
  card_ok(n.dev) && blen(n.pkt) == RX_BUF && blen(n.out) == RX_BUF && blen(n.held) == RX_BUF
  && n.ip <= IP_MAX && n.gw <= IP_MAX && 1 <= n.span && n.span <= 4294967296
  && len(n.arp) == ARP_N * 2 && n.held_len <= FRAME_MAX && n.seq <= 65535 && n.ping_pid < PID_LIMIT && n.ping_ip <= IP_MAX
  && n.dhcp_xid <= IP_MAX && n.dhcp_offer <= IP_MAX && n.dhcp_server <= IP_MAX
  && len(n.socks) == SOCKS * SOCK_FIELDS && blen(n.dq) == SOCKS * RXQ * UDP_MAX
  && len(n.tcbs) == TCBS * TCB_W && blen(n.trx) == TCBS * TCP_BUF && blen(n.ttx) == TCBS * TCP_BUF
}

// ---------------------------------------------------------------- bytes
// Network byte order: most significant byte first.

fn be16(b: &Bytes, o: u64) -> u64
  requires o + 2 <= blen(b)
  ensures result <= 65535
{
  return cast[u64](bget(b, o)) * 256 + cast[u64](bget(b, o + 1));
}

fn be32(b: &Bytes, o: u64) -> u64
  requires o + 4 <= blen(b)
  ensures result <= 4294967295
{
  return be16(b, o) * 65536 + be16(b, o + 2);
}

fn be48(b: &Bytes, o: u64) -> u64
  requires o + 6 <= blen(b)
  ensures result < MAC_LIMIT
{
  return be16(b, o) * 4294967296 + be32(b, o + 2);
}

fn put16(b: &mut Bytes, o: u64, v: u64)
  requires o + 2 <= blen(b) && v <= 65535
  ensures blen(b) == old(blen(b))
{
  bset(&mut b, o, cast[u8](v / 256));
  bset(&mut b, o + 1, cast[u8](v % 256));
}

fn put32(b: &mut Bytes, o: u64, v: u64)
  requires o + 4 <= blen(b) && v <= 4294967295
  ensures blen(b) == old(blen(b))
{
  put16(&mut b, o, v / 65536);
  put16(&mut b, o + 2, v % 65536);
}

fn put48(b: &mut Bytes, o: u64, v: u64)
  requires o + 6 <= blen(b) && v < MAC_LIMIT
  ensures blen(b) == old(blen(b))
{
  put16(&mut b, o, v / 4294967296);
  put32(&mut b, o + 2, v % 4294967296);
}

/// Adds the 16-bit word v to a ones'-complement sum.
fn cadd(s: u64, v: u64) -> u64
  requires s <= 65535 && v <= 65535
  ensures result <= 65535
{
  let t = s + v;
  if t > 65535 {
    return t - 65535;                 // end-around carry
  }
  return t;
}

/// The ones'-complement sum (RFC 1071) of bytes off..off+n as 16-bit words,
/// added to s0 (an odd last byte is padded with a zero).
fn sum16(b: &Bytes, off: u64, n: u64, s0: u64) -> u64
  requires off + n <= blen(b) && s0 <= 65535
  ensures result <= 65535
{
  let mut s = s0;
  let mut i = 0;
  while i + 1 < n
    invariant i <= n && s <= 65535
  {
    s = cadd(s, be16(b, off + i));
    i = i + 2;
  }
  if i < n {
    s = cadd(s, cast[u64](bget(b, off + i)) * 256);
  }
  return s;
}

/// The Internet checksum of bytes off..off+n. Over a header that already
/// holds its checksum, it is 0.
fn csum(b: &Bytes, off: u64, n: u64) -> u64
  requires off + n <= blen(b)
  ensures result <= 65535
{
  return 65535 - sum16(b, off, n, 0);
}

/// The sum over a UDP datagram or TCP segment at 34..34+size of b and its
/// pseudo-header (addresses, protocol, length). 65535 when its checksum is
/// right.
fn l4_sum(b: &Bytes, src: u64, dst: u64, proto: u64, size: u64) -> u64
  requires 34 + size <= blen(b) && src <= IP_MAX && dst <= IP_MAX && proto <= 255 && size <= 65535
  ensures result <= 65535
{
  let mut s = cadd(0, src / 65536);
  s = cadd(s, src % 65536);
  s = cadd(s, dst / 65536);
  s = cadd(s, dst % 65536);
  s = cadd(s, proto);
  s = cadd(s, size);
  return sum16(b, 34, size, s);
}

/// Copies the first n bytes of the received frame to the outgoing one.
fn net_copy(n: &mut Net, flen: u64)
  requires net_ok(n) && flen <= RX_BUF
  ensures net_ok(n)
{
  let mut i = 0;
  while i < flen
    invariant i <= flen && net_ok(n)
  {
    bset(&mut n.out, i, bget(n.pkt, i));
    i = i + 1;
  }
}

/// Sends the first `flen` bytes of the outgoing frame, padded to the
/// Ethernet minimum.
fn net_send(n: &mut Net, flen: u64) -> bool
  requires net_ok(n) && flen <= FRAME_MAX
  ensures net_ok(n)
{
  let mut l = flen;
  while l < ETH_MIN
    invariant flen <= l && l <= FRAME_MAX && net_ok(n)
  {
    bset(&mut n.out, l, 0);
    l = l + 1;
  }
  if n.tx < 18446744073709551615 {
    n.tx = n.tx + 1;
  }
  return card_send(&mut n.dev, n.out, l);
}

fn eth_header(n: &mut Net, dst: u64, kind: u64)
  requires net_ok(n) && dst < MAC_LIMIT && kind <= 65535
  ensures net_ok(n)
{
  put48(&mut n.out, 0, dst);
  put48(&mut n.out, 6, card_mac(n.dev));
  put16(&mut n.out, 12, kind);
}

// ---------------------------------------------------------------- ARP

/// The MAC address cached for `ip`, or 0.
fn arp_find(n: &Net, ip: u64) -> u64
  requires net_ok(n)
  ensures result < MAC_LIMIT
{
  let mut i = 0;
  while i < ARP_N
    invariant i <= ARP_N
  {
    let mac = get(n.arp, 2 * i + 1);
    if get(n.arp, 2 * i) == ip && mac < MAC_LIMIT {
      return mac;
    }
    i = i + 1;
  }
  return 0;
}

/// Caches ip -> mac, over the old entry for ip if there is one, else over
/// the oldest.
fn arp_learn(n: &mut Net, ip: u64, mac: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  let mut i = 0;
  while i < ARP_N
    invariant i <= ARP_N && net_ok(n)
  {
    if get(n.arp, 2 * i) == ip {
      n.arp = set(n.arp, 2 * i + 1, mac);
      return;
    }
    i = i + 1;
  }
  let e = n.arp_next % ARP_N;
  n.arp = set(n.arp, 2 * e, ip);
  n.arp = set(n.arp, 2 * e + 1, mac);
  n.arp_next = (e + 1) % ARP_N;
}

/// The address a frame for `ip` goes to: ip itself on our subnet, else the
/// gateway.
fn next_hop(n: &Net, ip: u64) -> u64
  requires net_ok(n)
  ensures result <= IP_MAX || result == ip
{
  if ip / n.span == n.ip / n.span {
    return ip;
  }
  return n.gw;
}

/// An ARP packet: operation, and the target's MAC and address. We are
/// always the sender.
fn arp_send(n: &mut Net, op: u64, eth_dst: u64, tmac: u64, tip: u64) -> bool
  requires net_ok(n) && op <= 2 && eth_dst < MAC_LIMIT && tmac < MAC_LIMIT && tip <= IP_MAX
  ensures net_ok(n)
{
  eth_header(&mut n, eth_dst, ETH_ARP);
  put16(&mut n.out, 14, 1);           // Ethernet
  put16(&mut n.out, 16, ETH_IP);
  bset(&mut n.out, 18, 6);
  bset(&mut n.out, 19, 4);
  put16(&mut n.out, 20, op);
  put48(&mut n.out, 22, card_mac(n.dev));
  put32(&mut n.out, 28, n.ip);
  put48(&mut n.out, 32, tmac);
  put32(&mut n.out, 38, tip);
  return net_send(&mut n, 42);
}

/// Sends the outgoing frame (its first flen bytes, Ethernet header aside)
/// to `hop`: now if its MAC is cached, else once ARP answers. A frame
/// already held for an answer is replaced.
fn send_via(n: &mut Net, hop: u64, flen: u64) -> bool
  requires net_ok(n) && hop <= IP_MAX && 14 <= flen && flen <= FRAME_MAX
  ensures net_ok(n)
{
  let mac = arp_find(n, hop);
  if mac != 0 {
    put48(&mut n.out, 0, mac);
    return net_send(&mut n, flen);
  }
  let mut i = 0;
  while i < flen
    invariant i <= flen && net_ok(n)
  {
    bset(&mut n.held, i, bget(n.out, i));
    i = i + 1;
  }
  n.held_len = flen;
  n.held_hop = hop;
  return arp_send(&mut n, 1, MAC_BCAST, 0, hop);
}

fn arp_in(n: &mut Net, flen: u64)
  requires net_ok(n) && flen <= RX_BUF
  ensures net_ok(n)
{
  if flen < 42 || be16(n.pkt, 14) != 1 || be16(n.pkt, 16) != ETH_IP || bget(n.pkt, 18) != 6 || bget(n.pkt, 19) != 4 {
    return;
  }
  let op = be16(n.pkt, 20);
  let smac = be48(n.pkt, 22);
  let sip = be32(n.pkt, 28);
  let tip = be32(n.pkt, 38);
  if smac == 0 || smac == MAC_BCAST {
    return;
  }
  // Learn who asked us, or answered: an entry already cached is refreshed.
  if tip == n.ip || arp_find(n, sip) != 0 {
    arp_learn(&mut n, sip, smac);
  }
  if op == 1 && tip == n.ip {
    arp_send(&mut n, 2, smac, smac, sip);
  }
  if n.held_len >= 14 && n.held_hop == sip {
    // The frame waiting for this answer goes out now.
    let l = n.held_len;
    let mut i = 0;
    while i < l
      invariant i <= l && l <= FRAME_MAX && net_ok(n)
    {
      bset(&mut n.out, i, bget(n.held, i));
      i = i + 1;
    }
    n.held_len = 0;
    put48(&mut n.out, 0, smac);
    net_send(&mut n, l);
  }
  if n.ping_state == PING_ARP && n.ping_hop == sip {
    ping_send(&mut n, smac);
  }
}

// ---------------------------------------------------------------- IPv4

/// Fills in an IPv4 header (no options) at 14 and its checksum.
fn ip_header(n: &mut Net, total: u64, proto: u64, dst: u64)
  requires net_ok(n) && 20 <= total && total <= FRAME_MAX - 14 && proto <= 255 && dst <= IP_MAX
  ensures net_ok(n)
{
  bset(&mut n.out, 14, 0x45);         // version 4, 5 words of header
  bset(&mut n.out, 15, 0);
  put16(&mut n.out, 16, total);
  put32(&mut n.out, 18, 0);           // id, no fragments
  bset(&mut n.out, 22, 64);           // time to live
  bset(&mut n.out, 23, cast[u8](proto));
  put16(&mut n.out, 24, 0);
  put32(&mut n.out, 26, n.ip);
  put32(&mut n.out, 30, dst);
  put16(&mut n.out, 24, csum(n.out, 14, 20));
}

/// Fills in the UDP checksum of the datagram being built (ulen bytes at 34).
fn udp_seal(n: &mut Net, dst: u64, ulen: u64)
  requires net_ok(n) && dst <= IP_MAX && 8 <= ulen && ulen <= FRAME_MAX - 34
  ensures net_ok(n)
{
  put16(&mut n.out, 40, 0);
  let mut c = 65535 - l4_sum(n.out, n.ip, dst, IP_UDP, ulen);
  if c == 0 {
    c = 65535;                        // 0 would mean "no checksum"
  }
  put16(&mut n.out, 40, c);
}

/// Answers an echo request: the same frame back, addresses swapped.
fn icmp_echo_reply(n: &mut Net, total: u64)
  requires net_ok(n) && 28 <= total && total <= FRAME_MAX - 14
  ensures net_ok(n)
{
  let src = be32(n.pkt, 26);
  let smac = be48(n.pkt, 6);
  net_copy(&mut n, 14 + total);
  eth_header(&mut n, smac, ETH_IP);
  ip_header(&mut n, total, IP_ICMP, src);
  bset(&mut n.out, 34, cast[u8](ICMP_ECHO_REPLY));
  put16(&mut n.out, 36, 0);
  put16(&mut n.out, 36, csum(n.out, 34, total - 20));
  net_send(&mut n, 14 + total);
}

/// Echoes a UDP datagram (already checked: ulen fits in total) back to
/// where it came from.
fn udp_echo(n: &mut Net, ulen: u64)
  requires net_ok(n) && 8 <= ulen && ulen <= FRAME_MAX - 34
  ensures net_ok(n)
{
  let src = be32(n.pkt, 26);
  let smac = be48(n.pkt, 6);
  let sport = be16(n.pkt, 34);
  let dport = be16(n.pkt, 36);
  net_copy(&mut n, 34 + ulen);
  eth_header(&mut n, smac, ETH_IP);
  ip_header(&mut n, 20 + ulen, IP_UDP, src);
  put16(&mut n.out, 34, dport);
  put16(&mut n.out, 36, sport);
  udp_seal(&mut n, src, ulen);
  net_send(&mut n, 34 + ulen);
}

/// A UDP datagram for us (total: the IP length, checked against the
/// frame): its checksum is checked when it has one, then it goes to the
/// socket bound to its port, or to the echo on port 7.
fn udp_in(n: &mut Net, total: u64)
  requires net_ok(n) && 28 <= total && total <= FRAME_MAX - 14
  ensures net_ok(n)
{
  let ulen = be16(n.pkt, 38);
  if ulen < 8 || ulen > total - 20 {
    return;
  }
  if be16(n.pkt, 40) != 0 && l4_sum(n.pkt, be32(n.pkt, 26), be32(n.pkt, 30), IP_UDP, ulen) != 65535 {
    return;
  }
  let dport = be16(n.pkt, 36);
  if dport == PORT_DHCP_CLIENT {
    dhcp_in(&mut n, ulen);
    return;
  }
  if be32(n.pkt, 30) == IP_MAX {
    return;                           // other broadcasts: nobody listens
  }
  let s = sock_find(n, dport);
  if s < SOCKS {
    udp_deliver(&mut n, s, ulen);
  } else if dport == UDP_ECHO_PORT {
    udp_echo(&mut n, ulen);
  }
}

fn ip_in(n: &mut Net, flen: u64)
  requires net_ok(n) && flen <= RX_BUF
  ensures net_ok(n)
{
  if flen < 34 || bget(n.pkt, 14) != 0x45 || csum(n.pkt, 14, 20) != 0 {
    return;
  }
  // For us: our address, or (UDP only) the broadcast address, or while a
  // lease is being sought the address offered.
  let dst = be32(n.pkt, 30);
  let seeking = n.dhcp_state == DHCP_DISCOVER || n.dhcp_state == DHCP_REQUEST;
  let mine = (dst == n.ip && n.ip != 0) || (seeking && dst == n.dhcp_offer && dst != 0);
  if !mine && !(dst == IP_MAX && cast[u64](bget(n.pkt, 23)) == IP_UDP) {
    return;
  }
  let total = be16(n.pkt, 16);
  // The header's length must fit in what arrived, and in what we can send.
  if total < 28 || 14 + total > flen || 14 + total > FRAME_MAX {
    return;
  }
  let proto = cast[u64](bget(n.pkt, 23));
  if proto == IP_ICMP {
    let kind = cast[u64](bget(n.pkt, 34));
    if kind == ICMP_ECHO && csum(n.pkt, 34, total - 20) == 0 {
      icmp_echo_reply(&mut n, total);
    } else if kind == ICMP_ECHO_REPLY && n.ping_state == PING_ECHO
      && be16(n.pkt, 38) == PING_ID && be16(n.pkt, 40) == n.seq {
      n.ping_state = PING_DONE;
    }
  } else if proto == IP_UDP {
    udp_in(&mut n, total);
  } else if proto == IP_TCP && mine {
    tcp_in(&mut n, total);
  }
}

// ---------------------------------------------------------------- DHCP

/// Broadcasts a DHCP message of type `kind` (1 DISCOVER, 3 REQUEST for the
/// address offered).
fn dhcp_send(n: &mut Net, kind: u64)
  requires net_ok(n) && kind <= 255
  ensures net_ok(n)
{
  let ulen = 8 + BOOTP_LEN;
  eth_header(&mut n, MAC_BCAST, ETH_IP);
  ip_header(&mut n, 20 + ulen, IP_UDP, IP_MAX);
  put16(&mut n.out, 34, PORT_DHCP_CLIENT);
  put16(&mut n.out, 36, PORT_DHCP_SERVER);
  put16(&mut n.out, 38, ulen);
  let mut i = 0;
  while i < BOOTP_LEN
    invariant i <= BOOTP_LEN && net_ok(n)
  {
    bset(&mut n.out, 42 + i, 0);
    i = i + 1;
  }
  bset(&mut n.out, 42, 1);            // a request
  bset(&mut n.out, 43, 1);            // Ethernet addresses ...
  bset(&mut n.out, 44, 6);            // ... six bytes long
  put32(&mut n.out, 46, n.dhcp_xid);
  put16(&mut n.out, 52, 0x8000);      // answer by broadcast: we have no address
  put48(&mut n.out, 70, card_mac(n.dev));   // chaddr
  put32(&mut n.out, 278, DHCP_MAGIC);
  bset(&mut n.out, 282, 53);          // option: message type
  bset(&mut n.out, 283, 1);
  bset(&mut n.out, 284, cast[u8](kind));
  bset(&mut n.out, 285, 55);          // option: we want the mask and router
  bset(&mut n.out, 286, 2);
  bset(&mut n.out, 287, 1);
  bset(&mut n.out, 288, 3);
  let mut o = 289;
  if kind == 3 {
    bset(&mut n.out, 289, 50);        // option: the address we want
    bset(&mut n.out, 290, 4);
    put32(&mut n.out, 291, n.dhcp_offer);
    bset(&mut n.out, 295, 54);        // option: the server we accept
    bset(&mut n.out, 296, 4);
    put32(&mut n.out, 297, n.dhcp_server);
    o = 301;
  }
  bset(&mut n.out, o, 255);           // end
  udp_seal(&mut n, IP_MAX, ulen);
  net_send(&mut n, 34 + ulen);
}

/// Starts (or restarts) looking for a lease: a DISCOVER now, retried from
/// dhcp_tick until an answer comes or the tries run out.
fn dhcp_start(n: &mut Net)
  requires net_ok(n)
  ensures net_ok(n)
{
  n.dhcp_state = DHCP_DISCOVER;
  n.dhcp_offer = 0;
  n.dhcp_until = n.now;
  if n.now <= 18446744073709551615 - DHCP_WAIT {
    n.dhcp_until = n.now + DHCP_WAIT;
  }
  dhcp_send(&mut n, 1);
}

/// Gives up on DHCP: the static address.
fn dhcp_static(n: &mut Net)
  requires net_ok(n)
  ensures net_ok(n)
{
  n.dhcp_state = DHCP_OFF;
  n.ip = MY_IP;
  n.gw = GATEWAY;
  n.span = 4294967296 - NETMASK;
}

/// A DHCP message to our port (ulen bytes of UDP at 34, checked to fit the
/// frame): an OFFER gets a REQUEST, an ACK for the address offered sets our
/// address, mask and gateway, and a NAK starts over. The lease is not
/// renewed (QEMU's lasts a day).
fn dhcp_in(n: &mut Net, ulen: u64)
  requires net_ok(n) && 8 <= ulen && ulen <= FRAME_MAX - 34
  ensures net_ok(n)
{
  let end = 34 + ulen;                // the end of the datagram in the frame
  if (n.dhcp_state != DHCP_DISCOVER && n.dhcp_state != DHCP_REQUEST) || end < 282
    || bget(n.pkt, 42) != 2 || be32(n.pkt, 46) != n.dhcp_xid || be32(n.pkt, 278) != DHCP_MAGIC {
    return;
  }
  let yiaddr = be32(n.pkt, 58);
  let mut kind = 0;
  let mut mask = NETMASK;
  let mut router = 0;
  let mut server = 0;
  let mut o = 282;
  while o < end
    invariant 282 <= o && mask <= IP_MAX && router <= IP_MAX && server <= IP_MAX
  {
    let code = cast[u64](bget(n.pkt, o));
    if code == 255 || o + 1 >= end {
      o = end;
    } else if code == 0 {
      o = o + 1;                      // padding
    } else {
      let l = cast[u64](bget(n.pkt, o + 1));
      if o + 2 + l > end {
        o = end;                      // runs past the datagram: ignore the rest
      } else {
        if code == 53 && l >= 1 {
          kind = cast[u64](bget(n.pkt, o + 2));
        } else if code == 1 && l >= 4 {
          mask = be32(n.pkt, o + 2);
        } else if code == 3 && l >= 4 {
          router = be32(n.pkt, o + 2);
        } else if code == 54 && l >= 4 {
          server = be32(n.pkt, o + 2);
        }
        o = o + 2 + l;
      }
    }
  }
  if n.dhcp_state == DHCP_DISCOVER && kind == 2 && yiaddr != 0 && yiaddr != IP_MAX {
    n.dhcp_offer = yiaddr;
    n.dhcp_server = server;
    n.dhcp_state = DHCP_REQUEST;
    dhcp_send(&mut n, 3);
  } else if n.dhcp_state == DHCP_REQUEST && kind == 5 && yiaddr == n.dhcp_offer {
    n.ip = yiaddr;
    n.gw = router;
    n.span = 4294967296 - mask;
    n.dhcp_state = DHCP_BOUND;
  } else if n.dhcp_state == DHCP_REQUEST && kind == 6 {
    dhcp_start(&mut n);
  }
}

/// The timer side of DHCP: retries a message that got no answer, and after
/// DHCP_TRIES of them falls back to the static address.
fn dhcp_tick(n: &mut Net, now: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  n.now = now;
  if (n.dhcp_state != DHCP_DISCOVER && n.dhcp_state != DHCP_REQUEST) || now < n.dhcp_until {
    return;
  }
  if n.dhcp_tries >= DHCP_TRIES - 1 {
    dhcp_static(&mut n);
    return;
  }
  n.dhcp_tries = n.dhcp_tries + 1;
  dhcp_start(&mut n);
}

// ---------------------------------------------------------------- ping

/// Sends the echo request of the ping in flight to MAC `mac`.
fn ping_send(n: &mut Net, mac: u64)
  requires net_ok(n) && mac < MAC_LIMIT
  ensures net_ok(n)
{
  let total = 20 + 8 + PING_DATA;
  eth_header(&mut n, mac, ETH_IP);
  ip_header(&mut n, total, IP_ICMP, n.ping_ip);
  bset(&mut n.out, 34, cast[u8](ICMP_ECHO));
  bset(&mut n.out, 35, 0);
  put16(&mut n.out, 36, 0);
  put16(&mut n.out, 38, PING_ID);
  put16(&mut n.out, 40, n.seq);
  let mut i = 0;
  while i < PING_DATA
    invariant i <= PING_DATA && net_ok(n)
  {
    bset(&mut n.out, 42 + i, cast[u8](0x61 + i % 26));   // "abcd..."
    i = i + 1;
  }
  put16(&mut n.out, 36, csum(n.out, 34, total - 20));
  net_send(&mut n, 14 + total);
  n.ping_state = PING_ECHO;
}

/// Starts a ping of `ip` for process `pid`; the result is collected with
/// ping_check. NET_PENDING if started, 4 if another ping is in flight.
fn ping_start(n: &mut Net, ip: u64, pid: u64, now: u64) -> u64
  requires net_ok(n) && ip <= IP_MAX && pid < PID_LIMIT
  ensures net_ok(n)
{
  if n.ip == 0 {
    return 3;                         // no address yet
  }
  if n.ping_state != PING_IDLE || now > 18446744073709551615 - PING_TICKS {
    return 4;
  }
  let hop = next_hop(n, ip);
  if hop > IP_MAX {
    return 4;
  }
  n.seq = (n.seq + 1) % 65536;
  n.ping_ip = ip;
  n.ping_hop = hop;
  n.ping_pid = pid;
  n.ping_until = now + PING_TICKS;
  let mac = arp_find(n, hop);
  if mac != 0 {
    ping_send(&mut n, mac);
  } else {
    n.ping_state = PING_ARP;
    arp_send(&mut n, 1, MAC_BCAST, 0, hop);
  }
  return NET_PENDING;
}

/// The ping's outcome once it has one: 8 * pid + result, where result is
/// 1 for a reply, 0 for none in time, 2 if ARP got no answer. NET_NONE
/// while it is still waiting, or if there is none.
fn ping_check(n: &mut Net, now: u64) -> u64
  requires net_ok(n)
  ensures net_ok(n)
  ensures result == NET_NONE || (result / 8 < PID_LIMIT && result % 8 <= 2)
{
  let mut r = NET_NONE;
  if n.ping_state == PING_DONE {
    r = 1;
  } else if n.ping_state != PING_IDLE && now >= n.ping_until {
    r = 0;
    if n.ping_state == PING_ARP {
      r = 2;
    }
  }
  if r == NET_NONE {
    return NET_NONE;
  }
  n.ping_state = PING_IDLE;
  return n.ping_pid * 8 + r;
}

// ---------------------------------------------------------------- UDP sockets

fn sk_get(n: &Net, s: u64, f: u64) -> u64
  requires net_ok(n) && s < SOCKS && f < SOCK_FIELDS
  ensures result == get(n.socks, s * SOCK_FIELDS + f)
{
  return get(n.socks, s * SOCK_FIELDS + f);
}

fn sk_set(n: &mut Net, s: u64, f: u64, v: u64)
  requires net_ok(n) && s < SOCKS && f < SOCK_FIELDS
  ensures net_ok(n)
{
  n.socks = set(n.socks, s * SOCK_FIELDS + f, v);
}

/// The open socket bound to `port`, or SOCKS if there is none.
fn sock_find(n: &Net, port: u64) -> u64
  requires net_ok(n)
  ensures result <= SOCKS
{
  if port == 0 {
    return SOCKS;
  }
  let mut s = 0;
  while s < SOCKS
    invariant s <= SOCKS
  {
    if sk_get(n, s, S_OPEN) == 1 && sk_get(n, s, S_PORT) == port {
      return s;
    }
    s = s + 1;
  }
  return SOCKS;
}

/// Queues the payload of the received UDP datagram (ulen bytes with its
/// header, at 34) on socket s. A datagram arriving at a full queue is
/// dropped, which UDP allows.
fn udp_deliver(n: &mut Net, s: u64, ulen: u64)
  requires net_ok(n) && s < SOCKS && 8 <= ulen && ulen <= FRAME_MAX - 34
  ensures net_ok(n)
{
  let count = sk_get(n, s, S_COUNT);
  if count >= RXQ {
    return;
  }
  let slot = (sk_get(n, s, S_HEAD) % RXQ + count) % RXQ;
  let plen = ulen - 8;
  let at = (s * RXQ + slot) * UDP_MAX;
  let mut i = 0;
  while i < plen
    invariant i <= plen && net_ok(n)
  {
    bset(&mut n.dq, at + i, bget(n.pkt, 42 + i));
    i = i + 1;
  }
  sk_set(&mut n, s, S_SLOTS + slot * SLOT_W, plen);
  sk_set(&mut n, s, S_SLOTS + slot * SLOT_W + 1, be32(n.pkt, 26));
  sk_set(&mut n, s, S_SLOTS + slot * SLOT_W + 2, be16(n.pkt, 34));
  sk_set(&mut n, s, S_COUNT, count + 1);
}

/// Opens a socket: its index, or NO_SOCK if all are taken.
fn udp_open(n: &mut Net) -> u64
  requires net_ok(n)
  ensures net_ok(n) && (result < SOCKS || result == NO_SOCK)
{
  let mut s = 0;
  while s < SOCKS
    invariant s <= SOCKS && net_ok(n)
  {
    if sk_get(n, s, S_OPEN) != 1 {
      sk_set(&mut n, s, S_OPEN, 1);
      sk_set(&mut n, s, S_PORT, 0);
      sk_set(&mut n, s, S_HEAD, 0);
      sk_set(&mut n, s, S_COUNT, 0);
      sk_set(&mut n, s, S_PEER_IP, 0);
      sk_set(&mut n, s, S_PEER_PORT, 0);
      return s;
    }
    s = s + 1;
  }
  return NO_SOCK;
}

fn udp_is_open(n: &Net, s: u64) -> bool
  requires net_ok(n)
  ensures result ==> s < SOCKS
{
  return s < SOCKS && sk_get(n, s, S_OPEN) == 1;
}

/// How many datagrams are queued on s (0 if it is not open).
fn udp_queued(n: &Net, s: u64) -> u64
  requires net_ok(n)
  ensures result <= RXQ && (result > 0 ==> s < SOCKS)
{
  if !udp_is_open(n, s) || sk_get(n, s, S_COUNT) > RXQ {
    return 0;
  }
  return sk_get(n, s, S_COUNT);
}

/// Binds open, unbound socket s to a free ephemeral port. Returns the
/// port, or 0 if none was found. There are fewer sockets than tries, so
/// one of the ports tried is always free.
fn udp_bind_any(n: &mut Net, s: u64) -> u64
  requires net_ok(n) && s < SOCKS
  ensures net_ok(n) && result <= 65535
{
  let mut tries = 0;
  while tries <= SOCKS
    invariant net_ok(n)
  {
    let p = EPH_LO + n.eph % EPH_N;
    n.eph = (n.eph % EPH_N + 1) % EPH_N;
    if sock_find(n, p) == SOCKS {
      sk_set(&mut n, s, S_PORT, p);
      return p;
    }
    tries = tries + 1;
  }
  return 0;
}

/// Binds socket s to `port` (0: any free ephemeral port). False if s is not
/// open, is already bound, or another socket has the port.
fn udp_bind(n: &mut Net, s: u64, port: u64) -> bool
  requires net_ok(n)
  ensures net_ok(n)
{
  if !udp_is_open(n, s) || sk_get(n, s, S_PORT) != 0 || port > 65535 {
    return false;
  }
  if port == 0 {
    return udp_bind_any(&mut n, s) != 0;
  }
  if sock_find(n, port) != SOCKS {
    return false;
  }
  sk_set(&mut n, s, S_PORT, port);
  return true;
}

/// Sends bytes 0..size of buf as one datagram from socket s to ip:port,
/// binding s to an ephemeral port first if it has none. Returns size, or
/// NO_SOCK if it cannot be sent (bad socket or address, or too big). It
/// does not wait: if the next hop's MAC is not known yet, the datagram is
/// held and goes out when ARP answers.
fn udp_sendto(n: &mut Net, s: u64, ip: u64, port: u64, buf: &Bytes, size: u64) -> u64
  requires net_ok(n)
  ensures net_ok(n)
{
  if !udp_is_open(n, s) || ip > IP_MAX || port == 0 || port > 65535
    || size > UDP_MAX || size > blen(buf) || !card_live(n.dev) || n.ip == 0 {
    return NO_SOCK;
  }
  if sk_get(n, s, S_PORT) == 0 && udp_bind_any(&mut n, s) == 0 {
    return NO_SOCK;
  }
  let sport = sk_get(n, s, S_PORT);
  let hop = next_hop(n, ip);
  if sport > 65535 || hop > IP_MAX {
    return NO_SOCK;
  }
  eth_header(&mut n, 0, ETH_IP);
  ip_header(&mut n, 28 + size, IP_UDP, ip);
  put16(&mut n.out, 34, sport);
  put16(&mut n.out, 36, port);
  put16(&mut n.out, 38, 8 + size);
  let mut i = 0;
  while i < size
    invariant i <= size && net_ok(n)
  {
    bset(&mut n.out, 42 + i, bget(buf, i));
    i = i + 1;
  }
  udp_seal(&mut n, ip, 8 + size);
  if !send_via(&mut n, hop, 42 + size) {
    return NO_SOCK;
  }
  return size;
}

/// Takes the oldest datagram queued on socket s, if any: copies up to
/// `max` bytes of it (and no more than buf holds) to the start of buf and
/// returns that count, dropping the rest as Linux does; its sender becomes
/// the socket's peer. NO_SOCK if nothing is queued; it never waits.
fn udp_recvfrom(n: &mut Net, s: u64, buf: &mut Bytes, max: u64) -> u64
  requires net_ok(n)
  ensures net_ok(n) && blen(buf) == old(blen(buf))
  ensures result == NO_SOCK || (result <= blen(buf) && result <= max)
{
  net_poll(&mut n);
  let count = udp_queued(n, s);
  if count == 0 {
    return NO_SOCK;
  }
  let slot = sk_get(n, s, S_HEAD) % RXQ;
  let mut l = sk_get(n, s, S_SLOTS + slot * SLOT_W);
  if l > UDP_MAX {
    l = UDP_MAX;
  }
  if l > max {
    l = max;
  }
  if l > blen(buf) {
    l = blen(buf);
  }
  let at = (s * RXQ + slot) * UDP_MAX;
  let bl = blen(buf);
  let mut i = 0;
  while i < l
    invariant i <= l && net_ok(n) && blen(buf) == bl
  {
    bset(&mut buf, i, bget(n.dq, at + i));
    i = i + 1;
  }
  sk_set(&mut n, s, S_PEER_IP, sk_get(n, s, S_SLOTS + slot * SLOT_W + 1));
  sk_set(&mut n, s, S_PEER_PORT, sk_get(n, s, S_SLOTS + slot * SLOT_W + 2));
  sk_set(&mut n, s, S_HEAD, (slot + 1) % RXQ);
  sk_set(&mut n, s, S_COUNT, count - 1);
  return l;
}

// ---------------------------------------------------------------- the stack

/// Handles every frame that has arrived (a few at most per call).
fn net_poll(n: &mut Net)
  requires net_ok(n)
  ensures net_ok(n)
{
  let mut k = 0;
  while k < RX_BUFS
    invariant k <= RX_BUFS && net_ok(n)
  {
    let flen = card_recv(&mut n.dev, &mut n.pkt);
    if flen == 0 {
      return;
    }
    if n.rx < 18446744073709551615 {
      n.rx = n.rx + 1;
    }
    if flen >= 14 {
      let kind = be16(n.pkt, 12);
      if kind == ETH_ARP {
        arp_in(&mut n, flen);
      } else if kind == ETH_IP {
        ip_in(&mut n, flen);
      }
    }
    k = k + 1;
  }
}

// ---------------------------------------------------------------- the card, or none

enum Nic { None, Up(Net) }

spec fn nic_ok(c: &Nic) -> bool {
  c is Nic::Up ==> net_ok(c.Up)
}

/// Are pages lo .. lo+k all free?
fn pages_free(m: &Mem, lo: u64, k: u64) -> bool
  requires mem_ok(m) && lo + k <= NPAGES
  ensures result ==> (forall i: u64 :: lo <= i && i < lo + k ==> get(m.bm, i) == 1)
{
  let mut i = 0;
  while i < k
    invariant i <= k && (forall j: u64 :: lo <= j && j < lo + i ==> get(m.bm, j) == 1)
  {
    if get(m.bm, lo + i) != 1 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// Starts the network card: the first virtio card on PCI bus 0 if its
/// ports do not overlap avoid_lo .. avoid_hi (another driver's), else the
/// first e1000 whose registers lie in the part of the device window below
/// E1K_TOP, with pages from page `at` on.
fn nic_new(ports: &mut Ports, pci: &mut Pci, m: &mut Mem, win: &mut MmioSpace, at: u64, avoid_lo: u64, avoid_hi: u64, fb_lo: u64, fb_hi: u64, usb_lo: u64, usb_hi: u64) -> Nic
  requires pci_ok(pci) && mem_ok(m) && at + NET_PAGES <= NPAGES && E1K_PAGES <= NET_PAGES
  requires forall k: u64 :: 0x1000 <= k && k < 65536 && !(avoid_lo <= k && k < avoid_hi) ==> port_free(ports, k)
  requires forall a: u64 :: 0xC0000000 <= a && a < E1K_TOP && !(fb_lo <= a && a < fb_hi) && !(usb_lo <= a && a < usb_hi) ==> mmio_free(win, a)
  ensures nic_ok(result) && mem_ok(m)
{
  let dev = pci_find(&mut pci, VIRTIO_VENDOR, VIRTIO_NET);
  if dev < 32 {
    let base = pci_io_bar(&mut pci, dev);
    if base < 0x1000 || base + VIO_PORTS > 65536 || !(base + VIO_PORTS <= avoid_lo || base >= avoid_hi)
      || !pages_free(m, at, NET_PAGES) {
      return Nic::None;
    }
    pci_enable(&mut pci, dev);
    let q0 = take_low_page(&mut m, at);
    let q1 = take_low_page(&mut m, at + 1);
    let q2 = take_low_page(&mut m, at + 2);
    let t0 = take_low_page(&mut m, at + 3);
    let t1 = take_low_page(&mut m, at + 4);
    let t2 = take_low_page(&mut m, at + 5);
    let b0 = take_low_page(&mut m, at + 6);
    let b1 = take_low_page(&mut m, at + 7);
    let b2 = take_low_page(&mut m, at + 8);
    return net_up(Card::Virtio(vnet_new(&mut ports, base, q0, q1, q2, t0, t1, t2, b0, b1, b2)));
  }
  let e = pci_find(&mut pci, E1K_VENDOR, E1K_DEVICE);
  if e == 32 {
    return Nic::None;
  }
  let bar = pci_mem_bar(&mut pci, e);
  if bar < 0xC0000000 || bar + E1K_LEN > E1K_TOP || bar % 4096 != 0 || !pages_free(m, at, E1K_PAGES)
    || !(bar + E1K_LEN <= fb_lo || bar >= fb_hi) || !(bar + E1K_LEN <= usb_lo || bar >= usb_hi) {
    return Nic::None;
  }
  pci_enable(&mut pci, e);
  let r = take_low_page(&mut m, at);
  let b0 = take_low_page(&mut m, at + 1);
  let b1 = take_low_page(&mut m, at + 2);
  let b2 = take_low_page(&mut m, at + 3);
  let b3 = take_low_page(&mut m, at + 4);
  let t = take_low_page(&mut m, at + 5);
  let regs = mmio_claim(&mut win, bar, E1K_LEN);
  return net_up(Card::E1000(e1k_new(regs, r, b0, b1, b2, b3, t)));
}

/// The stack on a started card, seeking its address by DHCP (or with the
/// static one if the card is dead).
fn net_up(d: Card) -> Nic
  requires card_ok(d)
  ensures nic_ok(result)
{
  let mut n = Net { dev: d, pkt: balloc(RX_BUF), out: balloc(RX_BUF), ip: 0, gw: 0, span: 1,
    arp: alloc(ARP_N * 2), arp_next: 0, held: balloc(RX_BUF), held_len: 0, held_hop: 0,
    dhcp_state: DHCP_OFF, dhcp_xid: 0, dhcp_offer: 0, dhcp_server: 0, dhcp_tries: 0, dhcp_until: 0, now: 0,
    ping_state: PING_IDLE, ping_pid: 0, ping_ip: 0, ping_hop: 0, ping_until: 0, seq: 0, rx: 0, tx: 0,
    socks: alloc(SOCKS * SOCK_FIELDS), dq: balloc(SOCKS * RXQ * UDP_MAX), eph: 0,
    tcbs: alloc(TCBS * TCB_W), trx: balloc(TCBS * TCP_BUF), ttx: balloc(TCBS * TCP_BUF), iss: 0 };
  // The address comes from DHCP, sought from now on.
  if card_live(n.dev) {
    n.dhcp_xid = card_mac(n.dev) % 4294967296;
    dhcp_start(&mut n);
  } else {
    dhcp_static(&mut n);
  }
  return Nic::Up(n);
}

fn nic_poll(c: &mut Nic)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      net_poll(&mut n);
      c = Nic::Up(n);
    },
  }
}

/// Starts a ping of `ip` for process `pid`: NET_PENDING if it is on its
/// way (collect the result with nic_ping_check), 3 if there is no network
/// card, 4 if another ping is in flight or the address is not one.
fn nic_ping_start(c: &mut Nic, ip: u64, pid: u64, now: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return 3;
    },
    Nic::Up(mut n) => {
      let mut r = 3;
      let mut to = ip;
      if ip == 0 {
        to = n.gw;                    // 0: the gateway
      }
      if to > IP_MAX || pid >= PID_LIMIT {
        r = 4;
      } else if card_live(n.dev) {
        r = ping_start(&mut n, to, pid, now);
      }
      c = Nic::Up(n);
      return r;
    },
  }
}

/// The finished ping, if any, as 8 * pid + result (see ping_check);
/// NET_NONE if none has finished. `now` is the tick count.
fn nic_ping_check(c: &mut Nic, now: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
  ensures result == NET_NONE || (result / 8 < PID_LIMIT && result % 8 <= 2)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NET_NONE;
    },
    Nic::Up(mut n) => {
      let r = ping_check(&mut n, now);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// The timer side of the stack (DHCP retries); `now` is the tick count.
fn nic_tick(c: &mut Nic, now: u64)
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => { c = Nic::None; },
    Nic::Up(mut n) => {
      dhcp_tick(&mut n, now);
      tcp_tick(&mut n, now);
      c = Nic::Up(n);
    },
  }
}

/// What the stack is configured with: 0 our address, 1 the gateway, 2 the
/// netmask, 3 how (0 not yet, 1 DHCP, 2 static). 0 without a card.
fn nic_info(c: &Nic, what: u64) -> u64
  requires nic_ok(c)
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if what == 0 {
        return n.ip;
      } else if what == 1 {
        return n.gw;
      } else if what == 2 {
        return 4294967296 - n.span;
      } else if what == 3 {
        if n.dhcp_state == DHCP_BOUND {
          return 1;
        } else if n.dhcp_state == DHCP_OFF && n.ip != 0 {
          return 2;
        }
      }
      return 0;
    },
  }
}

fn nic_mac(c: &Nic) -> u64 {
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => { return card_mac(n.dev); },
  }
}

fn nic_e1000(c: &Nic) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return card_is_e1000(n.dev); },
  }
}

fn nic_live(c: &Nic) -> bool {
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return card_live(n.dev); },
  }
}

/// Resets the card and takes its pages back (at power off).
fn nic_free(ports: &mut Ports, win: &mut MmioSpace, c: Nic, m: &mut Mem)
  requires nic_ok(c) && mem_ok(m)
  ensures mem_ok(m)
{
  match c {
    Nic::None => {},
    Nic::Up(n) => {
      bfree(n.pkt);
      bfree(n.out);
      bfree(n.held);
      free(n.tcbs);
      bfree(n.trx);
      bfree(n.ttx);
      free(n.arp);
      free(n.socks);
      bfree(n.dq);
      card_free(&mut ports, &mut win, n.dev, &mut m);
    },
  }
}

// ---------------------------------------------------------------- sockets, for system calls
// Each takes the card or none; with none, every call fails.

/// Opens a UDP socket: its number, or NO_SOCK if there is no card or every
/// socket is taken.
fn sock_new(c: &mut Nic) -> u64
  requires nic_ok(c)
  ensures nic_ok(c) && (result < SOCKS || result == NO_SOCK)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      let s = udp_open(&mut n);
      c = Nic::Up(n);
      return s;
    },
  }
}

/// Binds socket s to a local port (0: any free ephemeral one).
fn sock_bind(c: &mut Nic, s: u64, port: u64) -> bool
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return false;
    },
    Nic::Up(mut n) => {
      let ok = udp_bind(&mut n, s, port);
      c = Nic::Up(n);
      return ok;
    },
  }
}

/// Sends bytes 0..size of buf to ip:port. Returns size, or NO_SOCK.
fn sock_sendto(c: &mut Nic, s: u64, ip: u64, port: u64, buf: &Bytes, size: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      let r = udp_sendto(&mut n, s, ip, port, buf, size);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// Takes the oldest datagram queued on s into the start of buf (at most max
/// bytes). Returns its length, or NO_SOCK if none is queued. Never waits.
fn sock_recvfrom(c: &mut Nic, s: u64, buf: &mut Bytes, max: u64) -> u64
  requires nic_ok(c)
  ensures nic_ok(c) && blen(buf) == old(blen(buf))
  ensures result == NO_SOCK || (result <= blen(buf) && result <= max)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return NO_SOCK;
    },
    Nic::Up(mut n) => {
      let r = udp_recvfrom(&mut n, s, &mut buf, max);
      c = Nic::Up(n);
      return r;
    },
  }
}

/// Is a datagram queued on s (so sock_recvfrom would return one)? It does
/// not poll the card: the scheduler does that on every pass.
fn sock_ready(c: &Nic, s: u64) -> bool
  requires nic_ok(c)
{
  match c {
    Nic::None => { return false; },
    Nic::Up(n) => { return udp_queued(n, s) > 0; },
  }
}

/// The address and port the last datagram taken from s came from (0
/// before any).
fn sock_peer_ip(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= 4294967295
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PEER_IP) <= 4294967295 {
        return sk_get(n, s, S_PEER_IP);
      }
      return 0;
    },
  }
}

fn sock_peer_port(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= 65535
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PEER_PORT) <= 65535 {
        return sk_get(n, s, S_PEER_PORT);
      }
      return 0;
    },
  }
}

/// The local port s is bound to (0 if none).
fn sock_port(c: &Nic, s: u64) -> u64
  requires nic_ok(c)
  ensures result <= 65535
{
  match c {
    Nic::None => { return 0; },
    Nic::Up(n) => {
      if udp_is_open(n, s) && sk_get(n, s, S_PORT) <= 65535 {
        return sk_get(n, s, S_PORT);
      }
      return 0;
    },
  }
}

/// Closes s, dropping any queued datagram. False if it was not open.
fn sock_close(c: &mut Nic, s: u64) -> bool
  requires nic_ok(c)
  ensures nic_ok(c)
{
  match c {
    Nic::None => {
      c = Nic::None;
      return false;
    },
    Nic::Up(mut n) => {
      let ok = udp_is_open(n, s);
      if ok {
        sk_set(&mut n, s, S_OPEN, 0);
        sk_set(&mut n, s, S_PORT, 0);
        sk_set(&mut n, s, S_COUNT, 0);
      }
      c = Nic::Up(n);
      return ok;
    },
  }
}
