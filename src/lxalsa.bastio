// ALSA playback for Linux programs: /dev/snd/controlC0 and
// /dev/snd/pcmC0D0p on the sound card (src/hda.bastio), with the ioctls
// alsa-lib's "hw" plugin uses (aplay, SDL, mpv, PulseAudio's ALSA sink).
// The card plays 48 kHz 16-bit stereo; this layer accepts unsigned 8-bit
// or signed 16-bit samples, one or two channels, 4 to 96 kHz, and hands
// the frames to the converter of /dev/dsp (src/lxsnd.bastio).
//
// Only read/write transfers are offered (SNDRV_PCM_ACCESS_RW_INTERLEAVED,
// snd_pcm_writei): there is no mmap of the status, control or data pages,
// so alsa-lib falls back to SNDRV_PCM_IOCTL_SYNC_PTR for the pointers.
// A blocking write that cannot finish sleeps and runs again, as other
// blocking calls do. Recording is not offered. Without a sound card the
// devices do not open (ENODEV). There is one stream, and its state lives in
// k.sys from SYS_ALSA.

import "linux.bastio";

// struct snd_pcm_hw_params (608 bytes): flags, masks (access, format,
// subformat), five reserved masks, twelve intervals, nine reserved ones,
// then rmask, cmask, info, msbits, rate_num, rate_den and fifo_size.
const HP_SIZE: u64 = 608;
const HP_ACCESS: u64 = 4;
const HP_FORMAT: u64 = 36;
const HP_SUBFMT: u64 = 68;
const HP_IV: u64 = 260;                 // interval i (param - 8) at HP_IV + 12 * i
const HP_CMASK: u64 = 516;
const HP_INFO: u64 = 520;
const HP_MSBITS: u64 = 524;
const HP_RATE_NUM: u64 = 528;
const HP_RATE_DEN: u64 = 532;
const IV_SBITS: u64 = 0;                // sample_bits
const IV_FBITS: u64 = 1;                // frame_bits
const IV_CH: u64 = 2;
const IV_RATE: u64 = 3;
const IV_PTIME: u64 = 4;
const IV_PSIZE: u64 = 5;
const IV_PBYTES: u64 = 6;
const IV_PERIODS: u64 = 7;
const IV_BTIME: u64 = 8;
const IV_BSIZE: u64 = 9;
const IV_BBYTES: u64 = 10;
const IV_TICK: u64 = 11;
const IVF_INTEGER: u64 = 4;
const IVF_EMPTY: u64 = 8;
const FMT_U8: u64 = 2;                  // bit 1 of the format mask
const FMT_S16: u64 = 4;                 // bit 2
const ACC_RW_IL: u64 = 8;               // bit 3: SNDRV_PCM_ACCESS_RW_INTERLEAVED
const PCM_MIN_PERIOD: u64 = 32;
const PCM_MAX_PERIOD: u64 = 2048;
const PCM_MAX_BUFFER: u64 = 4096;

// ioctl requests.
const PCM_PVERSION: u64 = 0x80044100;
const PCM_INFO: u64 = 0x81204101;
const PCM_TSTAMP: u64 = 0x40044102;
const PCM_TTSTAMP: u64 = 0x40044103;
const PCM_USER_PVERSION: u64 = 0x40044104;
const PCM_HW_REFINE: u64 = 0xC2604110;
const PCM_HW_PARAMS: u64 = 0xC2604111;
const PCM_HW_FREE: u64 = 0x4112;
const PCM_SW_PARAMS: u64 = 0xC0884113;
const PCM_STATUS: u64 = 0x80984120;
const PCM_DELAY: u64 = 0x80084121;
const PCM_HWSYNC: u64 = 0x4122;
const PCM_SYNC_PTR: u64 = 0xC0884123;
const PCM_STATUS_EXT: u64 = 0xC0984124;
const PCM_PREPARE: u64 = 0x4140;
const PCM_RESET: u64 = 0x4141;
const PCM_START: u64 = 0x4142;
const PCM_DROP: u64 = 0x4143;
const PCM_DRAIN: u64 = 0x4144;
const PCM_PAUSE: u64 = 0x40044145;
const PCM_RESUME: u64 = 0x4147;
const PCM_XRUN: u64 = 0x4148;
const PCM_WRITEI: u64 = 0x40184150;
const CTL_PVERSION: u64 = 0x80045500;
const CTL_CARD_INFO: u64 = 0x81785501;
const CTL_ELEM_LIST: u64 = 0xC0505510;
const CTL_PCM_NEXT: u64 = 0x80045530;
const CTL_PCM_INFO: u64 = 0xC1205531;
const CTL_PCM_PREFER: u64 = 0x40045532;
const CTL_SUBSCRIBE: u64 = 0xC0045540;

// PCM states.
const ST_OPEN: u64 = 0;
const ST_SETUP: u64 = 1;
const ST_PREPARED: u64 = 2;
const ST_RUNNING: u64 = 3;

/// A stream word: 0 state, 1 rate, 2 channels, 3 bits per sample, 4 period
/// frames, 5 buffer frames, 6 frames written, 7 frames of the write in
/// progress already taken.
fn pcm_w(k: &Kernel, i: u64) -> u64
  requires kok(k) && i < 8
  ensures result <= 0x4000000000000 && (i != 6 ==> result <= 0x40000000)
{
  if i == 6 {
    return smaller(get(k.sys, SYS_ALSA + i), 0x4000000000000);   // frames written: 2^50 at most
  }
  return smaller(get(k.sys, SYS_ALSA + i), 0x40000000);
}

fn pcm_set(k: &mut Kernel, i: u64, v: u64)
  requires kok(k) && i < 8
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_ALSA + i, v);
}

fn c20(x: u64) -> u64
  ensures result <= 1048576
{
  return smaller(x, 1048576);
}

fn cdiv(a: u64, b: u64) -> u64
  requires b > 0
{
  if a % b == 0 {
    return a / b;
  }
  return a / b + 1;
}

fn iv_min(k: &Kernel, i: u64) -> u64
  requires kok(k) && i < 12
  ensures result < 4294967296
{
  return rd32(k.fs.xfer, HP_IV + 12 * i);
}

fn iv_max(k: &Kernel, i: u64) -> u64
  requires kok(k) && i < 12
  ensures result < 4294967296
{
  return rd32(k.fs.xfer, HP_IV + 12 * i + 4);
}

/// Narrows interval i to lo..hi; false if nothing is left.
fn iv_narrow(k: &mut Kernel, i: u64, lo: u64, hi: u64) -> bool
  requires kok(k) && i < 12
  ensures kok(k)
{
  let at = HP_IV + 12 * i;
  let mn = larger(iv_min(k, i), smaller(lo, 4294967295));
  let mx = smaller(iv_max(k, i), smaller(hi, 4294967295));
  store_le32(&mut k.fs.xfer, at, cast[u32](mn));
  store_le32(&mut k.fs.xfer, at + 4, cast[u32](mx));
  return mn <= mx && rd32(k.fs.xfer, at + 8) % 16 < IVF_EMPTY;
}

fn iv_fix(k: &mut Kernel, i: u64, v: u64)
  requires kok(k) && i < 12
  ensures kok(k)
{
  let at = HP_IV + 12 * i;
  store_le32(&mut k.fs.xfer, at, cast[u32](smaller(v, 4294967295)));
  store_le32(&mut k.fs.xfer, at + 4, cast[u32](smaller(v, 4294967295)));
}

/// One round of the constraints that tie the parameters together: the
/// format to the sample size, frame size to samples and channels, the
/// period and buffer to each other, to bytes and to time.
fn pcm_pass(k: &mut Kernel) -> bool
  requires kok(k)
  ensures kok(k)
{
  // sample bits and the format mask
  let fm = rd32(k.fs.xfer, HP_FORMAT);
  let mut sl = 8;
  let mut sh = 16;
  if fm == FMT_S16 {
    sl = 16;
  } else if fm == FMT_U8 {
    sh = 8;
  }
  if !iv_narrow(&mut k, IV_SBITS, sl, sh) {
    return false;
  }
  let mut nf = fm;
  if iv_min(k, IV_SBITS) > 8 {
    nf = nf - nf / 2 % 2 * 2;
  }
  if iv_max(k, IV_SBITS) < 16 {
    nf = nf - nf / 4 % 2 * 4;
  }
  if nf == 0 {
    return false;
  }
  store_le32(&mut k.fs.xfer, HP_FORMAT, cast[u32](nf));
  // frame bits = sample bits * channels
  let sbl = larger(c20(iv_min(k, IV_SBITS)), 1);
  let sbh = larger(c20(iv_max(k, IV_SBITS)), 1);
  let chl = larger(c20(iv_min(k, IV_CH)), 1);
  let chh = larger(c20(iv_max(k, IV_CH)), 1);
  if !iv_narrow(&mut k, IV_FBITS, sbl * chl, sbh * chh) {
    return false;
  }
  let fbl = c20(iv_min(k, IV_FBITS));
  let fbh = larger(c20(iv_max(k, IV_FBITS)), 1);
  if !iv_narrow(&mut k, IV_CH, cdiv(fbl, sbh), fbh / sbl) {
    return false;
  }
  if !iv_narrow(&mut k, IV_SBITS, cdiv(fbl, chh), fbh / chl) {
    return false;
  }
  // period * periods = buffer
  let pl = larger(c20(iv_min(k, IV_PSIZE)), 1);
  let ph = larger(c20(iv_max(k, IV_PSIZE)), 1);
  let nl = larger(c20(iv_min(k, IV_PERIODS)), 1);
  let nh = larger(c20(iv_max(k, IV_PERIODS)), 1);
  if !iv_narrow(&mut k, IV_BSIZE, pl * nl, ph * nh) {
    return false;
  }
  let bl = c20(iv_min(k, IV_BSIZE));
  let bh = c20(iv_max(k, IV_BSIZE));
  if !iv_narrow(&mut k, IV_PSIZE, cdiv(bl, nh), bh / nl) {
    return false;
  }
  if !iv_narrow(&mut k, IV_PERIODS, cdiv(bl, ph), bh / pl) {
    return false;
  }
  // bytes
  let pl2 = larger(c20(iv_min(k, IV_PSIZE)), 1);
  let ph2 = larger(c20(iv_max(k, IV_PSIZE)), 1);
  let bl2 = larger(c20(iv_min(k, IV_BSIZE)), 1);
  let bh2 = larger(c20(iv_max(k, IV_BSIZE)), 1);
  let fbl2 = larger(c20(iv_min(k, IV_FBITS)), 8);
  let fbh2 = larger(c20(iv_max(k, IV_FBITS)), 8);
  if !iv_narrow(&mut k, IV_PBYTES, pl2 * fbl2 / 8, ph2 * fbh2 / 8) {
    return false;
  }
  if !iv_narrow(&mut k, IV_BBYTES, bl2 * fbl2 / 8, bh2 * fbh2 / 8) {
    return false;
  }
  let pbl = c20(iv_min(k, IV_PBYTES));
  let pbh = c20(iv_max(k, IV_PBYTES));
  let bbl = c20(iv_min(k, IV_BBYTES));
  let bbh = c20(iv_max(k, IV_BBYTES));
  if !iv_narrow(&mut k, IV_PSIZE, cdiv(pbl * 8, fbh2), pbh * 8 / fbl2) {
    return false;
  }
  if !iv_narrow(&mut k, IV_BSIZE, cdiv(bbl * 8, fbh2), bbh * 8 / fbl2) {
    return false;
  }
  // time = frames * 1000000 / rate
  let rl = larger(c20(iv_min(k, IV_RATE)), 1);
  let rh = larger(c20(iv_max(k, IV_RATE)), 1);
  let pl3 = c20(iv_min(k, IV_PSIZE));
  let ph3 = c20(iv_max(k, IV_PSIZE));
  let bl3 = c20(iv_min(k, IV_BSIZE));
  let bh3 = c20(iv_max(k, IV_BSIZE));
  if !iv_narrow(&mut k, IV_PTIME, cdiv(pl3 * 1000000, rh), ph3 * 1000000 / rl) {
    return false;
  }
  if !iv_narrow(&mut k, IV_BTIME, cdiv(bl3 * 1000000, rh), bh3 * 1000000 / rl) {
    return false;
  }
  let ptl = iv_min(k, IV_PTIME);
  let pth = iv_max(k, IV_PTIME);
  let btl = iv_min(k, IV_BTIME);
  let bth = iv_max(k, IV_BTIME);
  if !iv_narrow(&mut k, IV_PSIZE, cdiv(ptl * rl, 1000000), pth * rh / 1000000) {
    return false;
  }
  if !iv_narrow(&mut k, IV_BSIZE, cdiv(btl * rl, 1000000), bth * rh / 1000000) {
    return false;
  }
  let mut rhi = 4294967295;
  if ptl > 0 {
    rhi = smaller(rhi, ph3 * 1000000 / ptl);
  }
  if btl > 0 {
    rhi = smaller(rhi, bh3 * 1000000 / btl);
  }
  if !iv_narrow(&mut k, IV_RATE, cdiv(pl3 * 1000000, larger(pth, 1)), rhi) {
    return false;
  }
  return true;
}

/// Narrows the parameters in the transfer buffer to what the card can do
/// and makes them agree with each other. False: nothing is left.
fn pcm_refine(k: &mut Kernel) -> bool
  requires kok(k)
  ensures kok(k)
{
  store_le32(&mut k.fs.xfer, HP_ACCESS, cast[u32](rd32(k.fs.xfer, HP_ACCESS) / 8 % 2 * ACC_RW_IL));
  store_le32(&mut k.fs.xfer, HP_ACCESS + 4, 0);
  let fm = rd32(k.fs.xfer, HP_FORMAT);
  store_le32(&mut k.fs.xfer, HP_FORMAT, cast[u32](fm / 2 % 2 * FMT_U8 + fm / 4 % 2 * FMT_S16));
  store_le32(&mut k.fs.xfer, HP_FORMAT + 4, 0);
  let sf = rd32(k.fs.xfer, HP_SUBFMT);
  store_le32(&mut k.fs.xfer, HP_SUBFMT, cast[u32](sf % 2));
  store_le32(&mut k.fs.xfer, HP_SUBFMT + 4, 0);
  if rd32(k.fs.xfer, HP_ACCESS) == 0 || rd32(k.fs.xfer, HP_FORMAT) == 0 || rd32(k.fs.xfer, HP_SUBFMT) == 0 {
    return false;
  }
  if !iv_narrow(&mut k, IV_CH, 1, 2) || !iv_narrow(&mut k, IV_RATE, DSP_MIN_RATE, DSP_MAX_RATE)
    || !iv_narrow(&mut k, IV_PSIZE, PCM_MIN_PERIOD, PCM_MAX_PERIOD) || !iv_narrow(&mut k, IV_PERIODS, 2, 8)
    || !iv_narrow(&mut k, IV_BSIZE, 2 * PCM_MIN_PERIOD, PCM_MAX_BUFFER) {
    return false;
  }
  let mut round = 0;
  while round < 3
    invariant round <= 3 && kok(k)
  {
    if !pcm_pass(&mut k) {
      return false;
    }
    round = round + 1;
  }
  // The outputs: whole numbers except the times; nothing open.
  let mut i = 0;
  while i < 12
    invariant i <= 12 && kok(k)
  {
    let mut fl = IVF_INTEGER;
    if i == IV_PTIME || i == IV_BTIME || i == IV_TICK {
      fl = 0;
    }
    store_le32(&mut k.fs.xfer, HP_IV + 12 * i + 8, cast[u32](fl));
    i = i + 1;
  }
  store_le32(&mut k.fs.xfer, HP_INFO, 0x10100);          // BLOCK_TRANSFER | INTERLEAVED
  if iv_min(k, IV_SBITS) == iv_max(k, IV_SBITS) {
    store_le32(&mut k.fs.xfer, HP_MSBITS, cast[u32](iv_min(k, IV_SBITS)));
  }
  if iv_min(k, IV_RATE) == iv_max(k, IV_RATE) {
    store_le32(&mut k.fs.xfer, HP_RATE_NUM, cast[u32](iv_min(k, IV_RATE)));
    store_le32(&mut k.fs.xfer, HP_RATE_DEN, 1);
  }
  return true;
}

/// Picks one value for everything still open (HW_PARAMS): S16_LE, the
/// smallest channel count and rate, then the smallest period and count.
fn pcm_choose(k: &mut Kernel) -> bool
  requires kok(k)
  ensures kok(k)
{
  let fm = rd32(k.fs.xfer, HP_FORMAT);
  if fm / 4 % 2 == 1 {
    store_le32(&mut k.fs.xfer, HP_FORMAT, cast[u32](FMT_S16));
  } else {
    store_le32(&mut k.fs.xfer, HP_FORMAT, cast[u32](FMT_U8));
  }
  if !pcm_refine(&mut k) {
    return false;
  }
  iv_fix(&mut k, IV_CH, iv_min(k, IV_CH));
  if !pcm_refine(&mut k) {
    return false;
  }
  iv_fix(&mut k, IV_RATE, iv_min(k, IV_RATE));
  if !pcm_refine(&mut k) {
    return false;
  }
  iv_fix(&mut k, IV_PSIZE, iv_min(k, IV_PSIZE));
  if !pcm_refine(&mut k) {
    return false;
  }
  iv_fix(&mut k, IV_PERIODS, iv_min(k, IV_PERIODS));
  if !pcm_refine(&mut k) {
    return false;
  }
  return iv_min(k, IV_BSIZE) == iv_max(k, IV_BSIZE) && iv_min(k, IV_RATE) == iv_max(k, IV_RATE);
}

/// Frames of the stream the card still holds, counted in the program's
/// frames (the card plays 48 kHz).
fn pcm_queued(k: &Kernel) -> u64
  requires kok(k)
{
  let rate = larger(smaller(pcm_w(k, 1), DSP_MAX_RATE), 1);
  return smaller(smaller(snd_queued(k.snd), 1048576) / 4 * rate / DSP_RATE, smaller(pcm_w(k, 6), 1048576));
}

/// Fills the transfer buffer from byte 0 with the struct snd_pcm_status
/// fields the programs read, starting at `at`: state, appl_ptr, hw_ptr,
/// delay, avail, avail_max (status, 152 bytes: at 0 and at 40..72).
fn pcm_put_status(k: &mut Kernel, at: u64)
  requires kok(k) && at + 80 <= XFER
  ensures kok(k)
{
  let q = pcm_queued(k);
  let appl = smaller(pcm_w(k, 6), 1048576 * 1048576);
  store_le32(&mut k.fs.xfer, at, cast[u32](pcm_w(k, 0) % 256));
  xfer_u64(&mut k.fs.xfer, at + 40, appl);
  xfer_u64(&mut k.fs.xfer, at + 48, appl - smaller(q, appl));
  xfer_u64(&mut k.fs.xfer, at + 56, q);
  let bs = pcm_w(k, 5);
  xfer_u64(&mut k.fs.xfer, at + 64, bs - smaller(q, bs));
  xfer_u64(&mut k.fs.xfer, at + 72, bs);
}

/// Writes str into the transfer buffer at `at`, at most `room` - 1 bytes.
fn pcm_str(k: &mut Kernel, at: u64, room: u64, s: Str)
  requires kok(k) && at + room <= XFER && room > 0
  ensures kok(k)
{
  let n = smaller(slen(s), room - 1);
  let mut i = 0;
  while i < n
    invariant i <= n && n < room && at + room <= XFER && kok(k)
  {
    bset(&mut k.fs.xfer, at + i, sget(s, i));
    i = i + 1;
  }
}

fn pcm_out(k: &mut Kernel, pid: u64, arg: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= XFER
  ensures kok(k)
{
  if copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, k.fs.xfer, n) != n {
    return EFAULT;
  }
  return 0;
}

fn pcm_in(k: &mut Kernel, pid: u64, arg: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC && n <= XFER
  ensures kok(k)
{
  xfer_zero(&mut k, n);
  if copy_from_user(&mut k.spaces, &mut k.mem, k.anon, pid, arg, &mut k.fs.xfer, n) != n {
    return EFAULT;
  }
  return 0;
}

/// A new open of /dev/snd/pcmC0D0p.
fn pcm_open_reset(k: &mut Kernel)
  requires kok(k)
  ensures kok(k)
{
  let mut i = 0;
  while i < 8
    invariant i <= 8 && kok(k)
  {
    pcm_set(&mut k, i, 0);
    i = i + 1;
  }
}

/// Moves the stream's format into /dev/dsp's converter.
fn pcm_to_dsp(k: &mut Kernel)
  requires kok(k)
  ensures kok(k)
{
  k.sys = set(k.sys, SYS_DSP, pcm_w(k, 1));
  k.sys = set(k.sys, SYS_DSP + 1, pcm_w(k, 2));
  if pcm_w(k, 3) == 8 {
    k.sys = set(k.sys, SYS_DSP + 2, AFMT_U8);
  } else {
    k.sys = set(k.sys, SYS_DSP + 2, AFMT_S16_LE);
  }
}

/// snd_pcm_writei: struct snd_xferi { long result; void *buf; unsigned
/// long frames; }. Takes what the card has room for and waits for the rest
/// (or reports what it took on a non-blocking descriptor).
fn pcm_writei(k: &mut Kernel, pid: u64, fd: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let st = pcm_w(k, 0);
  if st != ST_PREPARED && st != ST_RUNNING {
    return EBADFD;
  }
  let e = pcm_in(&mut k, pid, arg, 24);
  if e != 0 {
    return e;
  }
  let buf = smaller(load_le64(k.fs.xfer, 8), 0x7FFFFFFFFFFF);
  let frames = smaller(load_le64(k.fs.xfer, 16), 1048576);
  let fb = larger(smaller(pcm_w(k, 2) * pcm_w(k, 3) / 8, 4), 1);
  pcm_to_dsp(&mut k);
  let mut done = smaller(pcm_w(k, 7), frames);
  let mut rounds = 0;
  let mut blocked = false;
  while done < frames && rounds < 8 && !blocked
    invariant done <= frames && frames <= 1048576 && rounds <= 8 && fb >= 1 && fb <= 4 && kok(k)
  {
    let r = dsp_write(&mut k, pid, buf + done * fb, (frames - done) * fb);
    if r == EAGAIN {
      blocked = true;
    } else if r >= 0x100000000 {
      pcm_set(&mut k, 7, 0);
      return r;                         // EFAULT, ENODEV
    } else {
      done = done + smaller(r / fb, frames - done);
    }
    rounds = rounds + 1;
  }
  let took = done - smaller(pcm_w(k, 7), done);
  pcm_set(&mut k, 6, pcm_w(k, 6) + took);
  pcm_set(&mut k, 0, ST_RUNNING);
  if done < frames {
    let h = fd_ofd(k, pid, fd);
    if h < OFD_N && of_get(k.ofd, h, 3) % 2 == 1 {
      pcm_set(&mut k, 7, 0);
      if done == 0 {
        return EAGAIN;                  // a non-blocking write with no room
      }
      xfer_u64(&mut k.fs.xfer, 0, done);
      return pcm_out(&mut k, pid, arg, 8);
    }
    pcm_set(&mut k, 7, done);
    return SC_WAIT;
  }
  pcm_set(&mut k, 7, 0);
  xfer_u64(&mut k.fs.xfer, 0, frames);
  return pcm_out(&mut k, pid, arg, 8);
}

/// ioctl(2) on /dev/snd/pcmC0D0p.
fn pcm_ioctl(k: &mut Kernel, pid: u64, fd: u64, req: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if req == PCM_PVERSION {
    xfer_u64(&mut k.fs.xfer, 0, 0x2000F);
    return lx_put_out(&mut k, pid, arg, 4);
  }
  if req == PCM_USER_PVERSION || req == PCM_TSTAMP || req == PCM_TTSTAMP || req == PCM_HWSYNC || req == PCM_RESUME
    || req == PCM_PAUSE || req == PCM_XRUN {
    return 0;
  }
  if req == PCM_INFO {
    xfer_zero(&mut k, 288);
    pcm_str(&mut k, 16, 64, "HDA");
    pcm_str(&mut k, 80, 80, "BastiOS HD Audio");
    pcm_str(&mut k, 160, 32, "subdevice #0");
    store_le32(&mut k.fs.xfer, 200, 1);       // subdevices_count
    store_le32(&mut k.fs.xfer, 204, 1);       // subdevices_avail
    return pcm_out(&mut k, pid, arg, 288);
  }
  if req == PCM_HW_REFINE || req == PCM_HW_PARAMS {
    let e = pcm_in(&mut k, pid, arg, HP_SIZE);
    if e != 0 {
      return e;
    }
    if req == PCM_HW_REFINE {
      if !pcm_refine(&mut k) {
        return EINVAL;
      }
      return pcm_out(&mut k, pid, arg, HP_SIZE);
    }
    if !pcm_choose(&mut k) {
      return EINVAL;
    }
    pcm_set(&mut k, 1, iv_min(k, IV_RATE));
    pcm_set(&mut k, 2, iv_min(k, IV_CH));
    pcm_set(&mut k, 3, iv_min(k, IV_SBITS));
    pcm_set(&mut k, 4, iv_min(k, IV_PSIZE));
    pcm_set(&mut k, 5, iv_min(k, IV_BSIZE));
    pcm_set(&mut k, 0, ST_SETUP);
    pcm_set(&mut k, 6, 0);
    pcm_set(&mut k, 7, 0);
    return pcm_out(&mut k, pid, arg, HP_SIZE);
  }
  if req == PCM_HW_FREE {
    pcm_set(&mut k, 0, ST_OPEN);
    return 0;
  }
  if req == PCM_SW_PARAMS {
    // Accepted as given, with the boundary alsa-lib wraps its pointers at.
    let e = pcm_in(&mut k, pid, arg, 136);
    if e != 0 {
      return e;
    }
    let mut b = larger(pcm_w(k, 5), 1);
    let mut i = 0;
    while i < 40 && b < 0x1000000000000000
      invariant i <= 40 && b >= 1 && b <= 0x2000000000000000 && kok(k)
    {
      b = b * 2;
      i = i + 1;
    }
    xfer_u64(&mut k.fs.xfer, 64, b);
    store_le32(&mut k.fs.xfer, 72, 0x2000F);
    return pcm_out(&mut k, pid, arg, 136);
  }
  if req == PCM_PREPARE || req == PCM_RESET {
    if pcm_w(k, 0) == ST_OPEN {
      return EBADFD;
    }
    pcm_set(&mut k, 0, ST_PREPARED);
    pcm_set(&mut k, 6, 0);
    pcm_set(&mut k, 7, 0);
    pcm_to_dsp(&mut k);
    return 0;
  }
  if req == PCM_START {
    if pcm_w(k, 0) != ST_PREPARED {
      return EBADFD;
    }
    pcm_set(&mut k, 0, ST_RUNNING);
    return 0;
  }
  if req == PCM_DROP {
    if pcm_w(k, 0) != ST_OPEN {
      pcm_set(&mut k, 0, ST_SETUP);
    }
    return 0;
  }
  if req == PCM_DRAIN {
    if pcm_w(k, 0) == ST_OPEN {
      return EBADFD;
    }
    if snd_queued(k.snd) != 0 && snd_live(k.snd) {
      return SC_WAIT;                   // until the card has played it all
    }
    pcm_set(&mut k, 0, ST_SETUP);
    return 0;
  }
  if req == PCM_WRITEI {
    return pcm_writei(&mut k, pid, fd, arg);
  }
  if req == PCM_STATUS || req == PCM_STATUS_EXT {
    xfer_zero(&mut k, 152);
    pcm_put_status(&mut k, 0);
    return pcm_out(&mut k, pid, arg, 152);
  }
  if req == PCM_DELAY {
    xfer_u64(&mut k.fs.xfer, 0, pcm_queued(k));
    return pcm_out(&mut k, pid, arg, 8);
  }
  if req == PCM_SYNC_PTR {
    // struct snd_pcm_sync_ptr { flags; status at 8: state, hw_ptr at 16; control at 72: appl_ptr, avail_min }
    xfer_zero(&mut k, 136);
    let q = pcm_queued(k);
    let appl = smaller(pcm_w(k, 6), 1048576 * 1048576);
    store_le32(&mut k.fs.xfer, 8, cast[u32](pcm_w(k, 0) % 256));
    xfer_u64(&mut k.fs.xfer, 16, appl - smaller(q, appl));
    xfer_u64(&mut k.fs.xfer, 72, appl);
    xfer_u64(&mut k.fs.xfer, 80, 1);
    return pcm_out(&mut k, pid, arg, 136);
  }
  return ENOTTY;
}

/// ioctl(2) on /dev/snd/controlC0: the card and its one PCM device.
fn snd_ctl_ioctl(k: &mut Kernel, pid: u64, req: u64, arg: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if req == CTL_PVERSION {
    xfer_u64(&mut k.fs.xfer, 0, 0x20009);
    return lx_put_out(&mut k, pid, arg, 4);
  }
  if req == CTL_CARD_INFO {
    xfer_zero(&mut k, 376);
    pcm_str(&mut k, 8, 16, "HDA");
    pcm_str(&mut k, 24, 16, "HDA-Intel");
    pcm_str(&mut k, 40, 32, "BastiOS HD Audio");
    pcm_str(&mut k, 72, 80, "BastiOS HD Audio at the PCI bus");
    pcm_str(&mut k, 168, 80, "");
    pcm_str(&mut k, 248, 128, "");
    return pcm_out(&mut k, pid, arg, 376);
  }
  if req == CTL_PCM_NEXT {
    let e = pcm_in(&mut k, pid, arg, 4);
    if e != 0 {
      return e;
    }
    let cur = rd32(k.fs.xfer, 0);
    if cur == 0xFFFFFFFF {
      store_le32(&mut k.fs.xfer, 0, 0);         // the first device is 0
    } else {
      store_le32(&mut k.fs.xfer, 0, 0xFFFFFFFF);   // and there is no other
    }
    return pcm_out(&mut k, pid, arg, 4);
  }
  if req == CTL_PCM_INFO {
    let e = pcm_in(&mut k, pid, arg, 288);
    if e != 0 {
      return e;
    }
    if rd32(k.fs.xfer, 0) != 0 || rd32(k.fs.xfer, 4) != 0 || rd32(k.fs.xfer, 8) != 0 {
      return ENOENT;                    // device 0, subdevice 0, playback only
    }
    return pcm_ioctl(&mut k, pid, 0, PCM_INFO, arg);
  }
  if req == CTL_ELEM_LIST {
    // No mixer controls: used = count = 0.
    let e = pcm_in(&mut k, pid, arg, 80);
    if e != 0 {
      return e;
    }
    store_le32(&mut k.fs.xfer, 8, 0);
    store_le32(&mut k.fs.xfer, 12, 0);
    return pcm_out(&mut k, pid, arg, 80);
  }
  if req == CTL_PCM_PREFER || req == CTL_SUBSCRIBE {
    return 0;
  }
  return ENOTTY;
}

/// poll(2) bits of the PCM device: writable once a period fits.
fn pcm_bits(k: &Kernel) -> u64
  requires kok(k)
{
  if !snd_live(k.snd) {
    return POLLERR;
  }
  let rate = larger(smaller(pcm_w(k, 1), DSP_MAX_RATE), 1);
  let room = smaller(snd_room(k.snd), 1048576) / 4 * rate / DSP_RATE;
  if room >= larger(smaller(pcm_w(k, 4), PCM_MAX_PERIOD), 1) || pcm_w(k, 0) < ST_PREPARED {
    return POLLOUT;
  }
  return 0;
}
