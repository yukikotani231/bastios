// The keyboard's key events for Linux programs: /dev/input/event0, as
// Linux's evdev gives it. A read gets struct input_event records of 24
// bytes (seconds and microseconds as two 64-bit numbers, a 16-bit type, a
// 16-bit code and a 32-bit value). A key press is an EV_KEY record (type 1)
// with the key's code from input-event-codes.h (KEY_A is 30) and value 1,
// its release the same with value 0, each followed by an EV_SYN record
// (all zeros). There is no auto-repeat (value 2). The time is the clock when
// the event is read, not when the key was pressed.
//
// The events come from the PS/2 keyboard (src/kbd.bastio) as 4-byte
// packets whose first byte is 1 (a mouse packet's has bit 3 set), through
// the console pump into the same buffer as the mouse's (k.mice): after the
// mouse's header and ring there is a header (KEY_HDR bytes: where the oldest
// event is and how many bytes there are) and a ring of KEY_CAP bytes holding
// events of 4 bytes (1, the code, the value, 0). When the ring is full, new
// events are dropped. Every open file reads the same queue, and opening the
// device empties it, so a program sees only the keys pressed after it opened it.
//
// A read gives as many whole events as fit (a read shorter than one event,
// 48 bytes with its SYN, fails with EINVAL); with nothing there it fails with
// EAGAIN if the file was opened O_NONBLOCK, else it sleeps until the next
// tick and looks again (`wait_asleep`). poll says POLLIN when something is
// there. The ioctls that describe the device (EVIOCG*) are not answered yet.

import "linux.bastio";

const KEY_BASE: u64 = 824;                // MICE_HDR + MICE_CAP: where the key events start in k.mice
const KEY_HDR: u64 = 16;
const KEY_CAP: u64 = 512;                 // 128 events
const KEY_HEAD: u64 = KEY_BASE;
const KEY_COUNT: u64 = KEY_BASE + 8;

/// Bytes queued (4 an event).
fn key_count(k: &Kernel) -> u64
  requires kok(k)
  ensures result <= KEY_CAP
{
  return smaller(get_u64(k.mice, KEY_COUNT), KEY_CAP);
}

/// Queues event e (its four bytes, first in the high byte) unless the
/// ring is full.
fn key_put(k: &mut Kernel, e: u64)
  requires kok(k)
  ensures kok(k)
{
  let head = get_u64(k.mice, KEY_HEAD) % KEY_CAP;
  let cnt = key_count(k);
  if cnt + 4 > KEY_CAP {
    return;
  }
  let at = KEY_BASE + KEY_HDR;
  bset(&mut k.mice, at + (head + cnt) % KEY_CAP, cast[u8](e / 16777216 % 256));
  bset(&mut k.mice, at + (head + cnt + 1) % KEY_CAP, cast[u8](e / 65536 % 256));
  bset(&mut k.mice, at + (head + cnt + 2) % KEY_CAP, cast[u8](e / 256 % 256));
  bset(&mut k.mice, at + (head + cnt + 3) % KEY_CAP, cast[u8](e % 256));
  put_u64(&mut k.mice, KEY_COUNT, cnt + 4);
}

/// open(2) of the key events with these flags: a descriptor, or -ENFILE.
fn keyev_open(k: &mut Kernel, pid: u64, flags: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let h = ofd_new(&mut k, OF_DEV, DEV_KEYEV);
  if h >= OFD_N {
    return ENFILE;
  }
  of_set(&mut k.ofd, h, 3, flags / LO_NONBLOCK % 2);   // O_NONBLOCK, for keyev_read
  put_u64(&mut k.mice, KEY_COUNT, 0);       // keys pressed before the open are not reported
  return fd_install(&mut k, pid, h);
}

/// What poll finds on the key events.
fn keyev_bits(k: &Kernel) -> u64
  requires kok(k)
{
  if key_count(k) > 0 {
    return POLLIN;
  }
  return 0;
}

/// Writes the 24-byte input_event at put into the transfer buffer.
fn keyev_record(k: &mut Kernel, put: u64, ty: u64, code: u64, value: u64)
  requires kok(k) && put + 24 <= XFER && ty < 256 && code < 256 && value < 256
  ensures kok(k)
{
  let mut i = 0;
  while i < 24
    invariant kok(k) && i <= 24 && put + 24 <= XFER
  {
    bset(&mut k.fs.xfer, put + i, 0);
    i = i + 1;
  }
  put_u64(&mut k.fs.xfer, put, k.ns / 1000000000);
  put_u64(&mut k.fs.xfer, put + 8, k.ns / 1000 % 1000000);
  bset(&mut k.fs.xfer, put + 16, cast[u8](ty));
  bset(&mut k.fs.xfer, put + 18, cast[u8](code));
  bset(&mut k.fs.xfer, put + 20, cast[u8](value));
}

/// read(2) (system call n) of up to len bytes into va on descriptor fd,
/// the key events. Returns KEEP or SWITCH, as linux_syscall does.
fn keyev_read(k: &mut Kernel, pid: u64, n: u64, fd: u64, va: u64, len: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let cnt = key_count(k);
  if len < 48 {
    ret(&mut k.procs, pid, EINVAL);
    return KEEP;
  }
  if cnt < 4 {
    let h = fd_ofd(k, pid, fd);
    if h < OFD_N && of_get(k.ofd, h, 3) % 2 == 1 {
      ret(&mut k.procs, pid, EAGAIN);       // O_NONBLOCK
      return KEEP;
    }
    return wait_asleep(&mut k, pid, n, FOREVER);   // looks again on the next tick
  }
  let room = smaller(len, XFER);
  let at = KEY_BASE + KEY_HDR;
  let mut head = get_u64(k.mice, KEY_HEAD) % KEY_CAP;
  let mut left = cnt - cnt % 4;
  let mut put = 0;
  while left >= 4 && put + 48 <= room
    invariant put + 48 <= XFER + 48 && put <= room && room <= XFER && left <= KEY_CAP && head < KEY_CAP && kok(k)
  {
    let code = cast[u64](bget(k.mice, at + (head + 1) % KEY_CAP));
    let value = cast[u64](bget(k.mice, at + (head + 2) % KEY_CAP));
    keyev_record(&mut k, put, 1, code, value);       // EV_KEY
    keyev_record(&mut k, put + 24, 0, 0, 0);         // EV_SYN
    put = put + 48;
    head = (head + 4) % KEY_CAP;
    left = left - 4;
  }
  put_u64(&mut k.mice, KEY_HEAD, head);
  put_u64(&mut k.mice, KEY_COUNT, left);
  let done = copy_to_user(&mut k.spaces, &mut k.mem, k.anon, pid, va, k.fs.xfer, put);
  if done == NO_RESULT || done < put {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  ret(&mut k.procs, pid, put);
  return KEEP;
}
