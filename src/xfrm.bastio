// IPsec: NETLINK_XFRM, the interface `ip xfrm` and the key daemons use, for
// the security associations of ESP.
//
//   XFRM_MSG_NEWSA     add (NLM_F_CREATE | NLM_F_EXCL) or replace (NLM_F_REPLACE) one
//   XFRM_MSG_DELSA     delete the one a struct xfrm_usersa_id names
//   XFRM_MSG_GETSA     read one, or all of them as a dump
//   XFRM_MSG_FLUSHSA   delete all (of a protocol)
//
// An association is ESP (protocol 50) over IPv4, in transport or tunnel mode,
// keyed by its destination address, its SPI and the namespace it was made in.
// The only algorithm is AEAD rfc4106(gcm(aes)), XFRMA_ALG_AEAD, with a
// 128-bit tag and a 128- or 256-bit key followed by the 4-byte salt that
// RFC 4106 puts in the key material. Linux's other algorithms (the separate
// cipher and authenticator pairs) are refused with EOPNOTSUPP: the kernel has
// the ciphers for AEADs only, and an unauthenticated mode is not offered.
//
// All of it needs CAP_NET_ADMIN in the namespace, reading too: a key is
// secret.
//
// Policies say which traffic uses them:
//
//   XFRM_MSG_NEWPOLICY / UPDPOLICY   add (an existing one is EEXIST) or replace
//   XFRM_MSG_DELPOLICY               delete, by selector and direction or by index
//   XFRM_MSG_GETPOLICY               read one, or all of them as a dump
//   XFRM_MSG_FLUSHPOLICY             delete all
//
// A policy has a selector (IPv4 networks of source and destination, and a
// protocol: ports and an interface are refused with EOPNOTSUPP, as is the
// forward direction, which nothing enforces), a direction (in or out), an
// action (allow or block) and, for allow, at most one ESP template (reqid,
// mode, tunnel ends). The lower the priority number the earlier it applies.
//
// Not done yet: the packet path (what is sent through an association and
// what comes in), lifetimes and the replay state's notifications.

const NETLINK_XFRM: u64 = 6;
const XFRM_MSG_NEWSA: u64 = 16;
const XFRM_MSG_DELSA: u64 = 17;
const XFRM_MSG_GETSA: u64 = 18;
const XFRM_MSG_FLUSHSA: u64 = 28;
const XFRM_MSG_NEWPOLICY: u64 = 19;
const XFRM_MSG_DELPOLICY: u64 = 20;
const XFRM_MSG_GETPOLICY: u64 = 21;
const XFRM_MSG_UPDPOLICY: u64 = 25;
const XFRM_MSG_FLUSHPOLICY: u64 = 29;
const XFRMA_TMPL: u64 = 5;
const XFRMA_ALG_AUTH: u64 = 1;
const XFRMA_ALG_CRYPT: u64 = 2;
const XFRMA_ALG_COMP: u64 = 3;
const XFRMA_ALG_AUTH_TRUNC: u64 = 20;
const XFRMA_ALG_AEAD: u64 = 18;
const XFRM_USERSA: u64 = 224;             // struct xfrm_usersa_info
const XFRM_USERSA_ID: u64 = 24;           // struct xfrm_usersa_id
const XFRM_USERPOLICY: u64 = 168;         // struct xfrm_userpolicy_info
const XFRM_POLICY_ID: u64 = 64;           // struct xfrm_userpolicy_id
const XFRM_USER_TMPL: u64 = 64;           // struct xfrm_user_tmpl
const XFRM_ALGO_AEAD_HEAD: u64 = 72;      // alg_name[64], alg_key_len, alg_icv_len
const NE_PROTONOSUPPORT: u64 = 93;

const XS_USED: u64 = 0;
const XS_NS: u64 = 1;
const XS_DST: u64 = 2;                    // the destination address (host order)
const XS_SPI: u64 = 3;
const XS_SRC: u64 = 4;
const XS_MODE: u64 = 5;                   // 0 transport, 1 tunnel
const XS_REQID: u64 = 6;
const XS_RWIN: u64 = 7;                   // replay_window, in packets (0: no replay check)
const XS_SEQ: u64 = 8;                    // the last sequence number sent
const XS_KLEN: u64 = 9;                   // bytes of AES key: 16 or 32
const XS_SALT: u64 = 10;
const XS_KEY: u64 = 11;                   // the key, four words (32 bytes)
const XS_FLAGS: u64 = 15;
const XS_RTOP: u64 = 16;                  // the highest sequence number received
const XS_RMAP: u64 = 17;                  // the replay bitmap, four words
const XS_PKTS: u64 = 21;
const XS_BYTES: u64 = 22;

// A policy row (XP_W words at XP_BASE in Net.wgp, after the associations).
const XP_USED: u64 = 0;
const XP_NS: u64 = 1;
const XP_DIR: u64 = 2;                    // 0 in, 1 out
const XP_ACT: u64 = 3;                    // 0 allow, 1 block
const XP_PRIO: u64 = 4;                   // the lower, the earlier
const XP_DADDR: u64 = 5;                  // the selector's destination network (host bits clear)
const XP_DPLEN: u64 = 6;
const XP_SADDR: u64 = 7;
const XP_SPLEN: u64 = 8;
const XP_PROTO: u64 = 9;                  // 0: any
const XP_IDX: u64 = 10;
const XP_NT: u64 = 11;                    // 1 if there is a template (ESP), else 0
const XP_TREQID: u64 = 12;
const XP_TMODE: u64 = 13;
const XP_TDST: u64 = 14;                  // the tunnel's far end (tunnel mode) or the SA's destination
const XP_TSRC: u64 = 15;

fn xs_get(n: &Net, i: u64, f: u64) -> u64
  requires net_ok(n) && i < XSA_N && f < XSA_W
{
  return get(n.wgp, XSA_BASE + i * XSA_W + f);
}

fn xs_set(n: &mut Net, i: u64, f: u64, v: u64)
  requires net_ok(n) && i < XSA_N && f < XSA_W
  ensures net_ok(n)
{
  n.wgp = set(n.wgp, XSA_BASE + i * XSA_W + f, v);
}

/// Empties row i, its key too.
fn xs_clear(n: &mut Net, i: u64)
  requires net_ok(n) && i < XSA_N
  ensures net_ok(n)
{
  let mut f = 0;
  while f < XSA_W
    invariant f <= XSA_W && net_ok(n)
  {
    xs_set(&mut n, i, f, 0);
    f = f + 1;
  }
}

/// The association with destination dst and SPI spi in namespace ns, or XSA_N.
fn xs_find(n: &Net, ns: u64, dst: u64, spi: u64) -> u64
  requires net_ok(n)
  ensures result <= XSA_N
{
  let mut i = 0;
  while i < XSA_N
    invariant i <= XSA_N
  {
    if xs_get(n, i, XS_USED) == 1 && xs_get(n, i, XS_NS) == ns && xs_get(n, i, XS_DST) == dst && xs_get(n, i, XS_SPI) == spi {
      return i;
    }
    i = i + 1;
  }
  return XSA_N;
}

/// A free row, or XSA_N.
fn xs_free_row(n: &Net) -> u64
  requires net_ok(n)
  ensures result <= XSA_N
{
  let mut i = 0;
  while i < XSA_N
    invariant i <= XSA_N
  {
    if xs_get(n, i, XS_USED) == 0 {
      return i;
    }
    i = i + 1;
  }
  return XSA_N;
}

/// A namespace ended: its associations go, keys erased.
fn xs_ns_end(n: &mut Net, s: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  assert XSA_BASE == WGPN * WGP_W && XP_BASE == XSA_BASE + XSA_N * XSA_W && WGC_PBASE == XP_BASE + XP_N * XP_W
    && WGC_DBASE == WGC_PBASE + WGPN * WGC_PW && WGPX_LEN == WGC_DBASE + IFN * WGC_DW;   // the tables sit one after the other
  let mut i = 0;
  while i < XSA_N
    invariant i <= XSA_N && net_ok(n)
  {
    if xs_get(n, i, XS_USED) == 1 && xs_get(n, i, XS_NS) == s {
      xs_clear(&mut n, i);
    }
    i = i + 1;
  }
  let mut j = 0;
  while j < XP_N
    invariant j <= XP_N && net_ok(n)
  {
    if xp_get(n, j, XP_USED) == 1 && xp_get(n, j, XP_NS) == s {
      xp_clear(&mut n, j);
    }
    j = j + 1;
  }
}

/// The IPv4 address in the 16-byte address field at b[a..a + 16] (the
/// first four bytes, network order); 0 if the other twelve are not zero.
fn xs_addr(b: &Bytes, a: u64) -> u64
  requires a + 16 <= blen(b)
{
  return be32(b, a);
}

/// Writes a 16-byte address field for an IPv4 address.
fn xs_put_addr(n: &mut Net, ip: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  nl_b(&mut n, ip / 16777216 % 256);
  nl_b(&mut n, ip / 65536 % 256);
  nl_b(&mut n, ip / 256 % 256);
  nl_b(&mut n, ip % 256);
  let mut i = 0;
  while i < 12
    invariant i <= 12 && net_ok(n)
  {
    nl_b(&mut n, 0);
    i = i + 1;
  }
}

fn xs_zeros(n: &mut Net, k: u64)
  requires net_ok(n)
  ensures net_ok(n)
{
  let mut i = 0;
  while i < k
    invariant i <= k && net_ok(n)
  {
    nl_b(&mut n, 0);
    i = i + 1;
  }
}

/// Whether the bytes of name b[a..a + 64) are exactly "rfc4106(gcm(aes))".
fn xs_is_gcm_name(b: &Bytes, a: u64) -> bool
  requires a + 64 <= blen(b)
{
  let want = "rfc4106(gcm(aes))";
  let l = slen(want);
  let mut i = 0;
  while i < 64
    invariant i <= 64 && a + 64 <= blen(b)
  {
    let mut c = 0;
    if i < l {
      c = cast[u64](sget(want, i));
    }
    if cast[u64](bget(b, a + i)) != c {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// XFRM_MSG_NEWSA: the message at b[at..end) (header, xfrm_usersa_info,
/// attributes). Returns an errno, 0 for success.
fn xs_new(n: &mut Net, b: &Bytes, at: u64, end: u64, fl: u64, admin: bool) -> u64
  requires net_ok(n) && at + 16 <= end && end <= blen(b)
  ensures net_ok(n)
{
  if !admin {
    return NE_PERM;
  }
  if end - at < 16 + XFRM_USERSA {
    return NE_INVAL;
  }
  let sa = at + 16;
  let attrs = sa + XFRM_USERSA;
  let family = rd16(b, sa + 212);
  let mode = rd8(b, sa + 214);
  let window = rd8(b, sa + 215);
  if family != 2 {
    return NE_AFNOSUPPORT;                // IPv4 only
  }
  if rd8(b, sa + 56 + 20) != IPPROTO_ESP {
    return NE_PROTONOSUPPORT;             // xfrm_id.proto: ESP only
  }
  if mode > 1 {
    return NE_INVAL;
  }
  if nla_find(b, attrs, end, XFRMA_ALG_AUTH) != 0 || nla_find(b, attrs, end, XFRMA_ALG_CRYPT) != 0
      || nla_find(b, attrs, end, XFRMA_ALG_AUTH_TRUNC) != 0 || nla_find(b, attrs, end, XFRMA_ALG_COMP) != 0 {
    return NE_OPNOTSUPP;                  // only the AEAD
  }
  let ak = nla_find(b, attrs, end, XFRMA_ALG_AEAD);
  if ak == 0 {
    return NE_INVAL;
  }
  let al = nla_len(b, ak);
  if al < XFRM_ALGO_AEAD_HEAD || !xs_is_gcm_name(b, ak) {
    return NE_NOENT;                      // no such algorithm
  }
  let kbits = rd32(b, ak + 64);
  let icv = rd32(b, ak + 68);
  if icv != 128 {
    return NE_INVAL;
  }
  if kbits != 160 && kbits != 288 {
    return NE_INVAL;                      // an AES-128 or AES-256 key and the 4-byte salt
  }
  if al - XFRM_ALGO_AEAD_HEAD < kbits / 8 {
    return NE_INVAL;
  }
  let dst = xs_addr(b, sa + 56);
  let spi = be32(b, sa + 56 + 16);
  let src = xs_addr(b, sa + 80);
  let ns = n.ns;
  let had = xs_find(n, ns, dst, spi);
  let mut row = had;
  if had < XSA_N {
    if fl / NLM_F_REPLACE % 2 == 0 {
      return NE_EXIST;                    // NLM_F_EXCL, or just not asked to replace
    }
  } else {
    if fl / NLM_F_CREATE % 2 == 0 {
      return NE_SRCH;
    }
    row = xs_free_row(n);
    if row >= XSA_N {
      return NE_NOSPC;
    }
  }
  xs_clear(&mut n, row);
  xs_set(&mut n, row, XS_USED, 1);
  xs_set(&mut n, row, XS_NS, ns);
  xs_set(&mut n, row, XS_DST, dst);
  xs_set(&mut n, row, XS_SPI, spi);
  xs_set(&mut n, row, XS_SRC, src);
  xs_set(&mut n, row, XS_MODE, mode);
  xs_set(&mut n, row, XS_REQID, rd32(b, sa + 208));
  xs_set(&mut n, row, XS_RWIN, smaller(window, 255));
  xs_set(&mut n, row, XS_SEQ, 0);
  let klen = kbits / 8 - 4;
  xs_set(&mut n, row, XS_KLEN, klen);
  xs_set(&mut n, row, XS_SALT, rd32(b, ak + XFRM_ALGO_AEAD_HEAD + klen));
  let mut w = 0;
  while w < 4
    invariant w <= 4 && net_ok(n)
  {
    if w * 8 + 8 <= klen {
      xs_set(&mut n, row, XS_KEY + w, rd64(b, ak + XFRM_ALGO_AEAD_HEAD + w * 8));
    }
    w = w + 1;
  }
  xs_set(&mut n, row, XS_FLAGS, rd8(b, sa + 216));
  return 0;
}

/// Writes association i as an XFRM_MSG_NEWSA message (for a read or a dump).
fn xs_put(n: &mut Net, i: u64, seq: u64, port: u64, flags: u64)
  requires net_ok(n) && i < XSA_N
  ensures net_ok(n)
{
  nl_begin(&mut n, XFRM_MSG_NEWSA, flags, seq, port);
  // xfrm_selector: any address
  xs_put_addr(&mut n, 0);
  xs_put_addr(&mut n, 0);
  xs_zeros(&mut n, 8);                    // the ports and their masks
  nl_16(&mut n, 2);                       // family
  xs_zeros(&mut n, 2);                    // prefix lengths: any address
  xs_zeros(&mut n, 1);                    // proto
  xs_zeros(&mut n, 3);
  xs_zeros(&mut n, 4);                    // ifindex
  xs_zeros(&mut n, 4);                    // user
  // xfrm_id
  xs_put_addr(&mut n, xs_get(n, i, XS_DST));
  nl_b(&mut n, xs_get(n, i, XS_SPI) / 16777216 % 256);
  nl_b(&mut n, xs_get(n, i, XS_SPI) / 65536 % 256);
  nl_b(&mut n, xs_get(n, i, XS_SPI) / 256 % 256);
  nl_b(&mut n, xs_get(n, i, XS_SPI) % 256);
  nl_b(&mut n, IPPROTO_ESP);
  xs_zeros(&mut n, 3);
  xs_put_addr(&mut n, xs_get(n, i, XS_SRC));
  // xfrm_lifetime_cfg: no limits (~0 bytes and packets)
  let mut k = 0;
  while k < 8
    invariant k <= 8 && net_ok(n)
  {
    nl_32(&mut n, 4294967295);
    nl_32(&mut n, 4294967295);
    k = k + 1;
  }
  xs_zeros(&mut n, 32);                   // xfrm_lifetime_cur
  xs_zeros(&mut n, 12);                   // xfrm_stats
  nl_32(&mut n, 0);                       // seq
  nl_32(&mut n, xs_get(n, i, XS_REQID));
  nl_16(&mut n, 2);                       // family
  nl_b(&mut n, xs_get(n, i, XS_MODE) % 256);
  nl_b(&mut n, xs_get(n, i, XS_RWIN) % 256);
  nl_b(&mut n, xs_get(n, i, XS_FLAGS) % 256);
  xs_zeros(&mut n, 7);
  // XFRMA_ALG_AEAD: the name, the key length and tag length in bits, the key and salt
  let klen = xs_get(n, i, XS_KLEN);
  if klen == 16 || klen == 32 {
    nla_head(&mut n, XFRMA_ALG_AEAD, 72 + klen + 4);
    let name = "rfc4106(gcm(aes))";
    let l = slen(name);
    let mut c = 0;
    while c < 64
      invariant c <= 64 && net_ok(n)
    {
      if c < l {
        nl_b(&mut n, cast[u64](sget(name, c)));
      } else {
        nl_b(&mut n, 0);
      }
      c = c + 1;
    }
    nl_32(&mut n, (klen + 4) * 8);
    nl_32(&mut n, 128);
    let mut j = 0;
    while j < klen
      invariant j <= klen && klen <= 32 && net_ok(n)
    {
      nl_b(&mut n, xs_get(n, i, XS_KEY + j / 8) / (1 << (8 * (j % 8))) % 256);
      j = j + 1;
    }
    nl_32(&mut n, xs_get(n, i, XS_SALT));
  }
  nl_end(&mut n);
}

/// The association a struct xfrm_usersa_id at b[a..) names, or XSA_N.
fn xs_by_id(n: &Net, b: &Bytes, a: u64, end: u64) -> u64
  requires net_ok(n) && a <= end && end <= blen(b)
  ensures result <= XSA_N
{
  if end - a < XFRM_USERSA_ID || rd8(b, a + 22) != IPPROTO_ESP {
    return XSA_N;
  }
  return xs_find(n, n.ns, xs_addr(b, a), be32(b, a + 16));
}

// ---------------------------------------------------------------- policies

fn xp_get(n: &Net, i: u64, f: u64) -> u64
  requires net_ok(n) && i < XP_N && f < XP_W
{
  return get(n.wgp, XP_BASE + i * XP_W + f);
}

fn xp_set(n: &mut Net, i: u64, f: u64, v: u64)
  requires net_ok(n) && i < XP_N && f < XP_W
  ensures net_ok(n)
{
  n.wgp = set(n.wgp, XP_BASE + i * XP_W + f, v);
}

fn xp_clear(n: &mut Net, i: u64)
  requires net_ok(n) && i < XP_N
  ensures net_ok(n)
{
  let mut f = 0;
  while f < XP_W
    invariant f <= XP_W && net_ok(n)
  {
    xp_set(&mut n, i, f, 0);
    f = f + 1;
  }
}

/// Whether policy i (in namespace ns, direction dir) covers a packet from
/// src to dst of protocol proto.
fn xp_match(n: &Net, i: u64, ns: u64, dir: u64, src: u64, dst: u64, proto: u64) -> bool
  requires net_ok(n) && i < XP_N && src <= IP_MAX && dst <= IP_MAX
{
  if xp_get(n, i, XP_USED) != 1 || xp_get(n, i, XP_NS) != ns || xp_get(n, i, XP_DIR) != dir {
    return false;
  }
  let dp = xp_get(n, i, XP_DPLEN);
  let sp = xp_get(n, i, XP_SPLEN);
  if dp > 32 || sp > 32 {
    return false;
  }
  let pr = xp_get(n, i, XP_PROTO);
  if pr != 0 && pr != proto {
    return false;
  }
  return wg_mask(dst, dp) == xp_get(n, i, XP_DADDR) && wg_mask(src, sp) == xp_get(n, i, XP_SADDR);
}

/// The policy that applies to a packet: the one of the lowest priority
/// number (the first made of equals), or XP_N.
fn xp_lookup(n: &Net, ns: u64, dir: u64, src: u64, dst: u64, proto: u64) -> u64
  requires net_ok(n) && src <= IP_MAX && dst <= IP_MAX
  ensures result <= XP_N
{
  let mut best = XP_N;
  let mut i = 0;
  while i < XP_N
    invariant i <= XP_N && best <= XP_N
  {
    if xp_match(n, i, ns, dir, src, dst, proto) {
      if best >= XP_N || xp_get(n, i, XP_PRIO) < xp_get(n, best, XP_PRIO) {
        best = i;
      }
    }
    i = i + 1;
  }
  return best;
}

/// The policy of namespace ns with exactly this selector and direction, or XP_N.
fn xp_find(n: &Net, ns: u64, dir: u64, da: u64, dp: u64, sa: u64, sp: u64, pr: u64) -> u64
  requires net_ok(n)
  ensures result <= XP_N
{
  let mut i = 0;
  while i < XP_N
    invariant i <= XP_N
  {
    if xp_get(n, i, XP_USED) == 1 && xp_get(n, i, XP_NS) == ns && xp_get(n, i, XP_DIR) == dir
        && xp_get(n, i, XP_DADDR) == da && xp_get(n, i, XP_DPLEN) == dp
        && xp_get(n, i, XP_SADDR) == sa && xp_get(n, i, XP_SPLEN) == sp && xp_get(n, i, XP_PROTO) == pr {
      return i;
    }
    i = i + 1;
  }
  return XP_N;
}

fn xp_free_row(n: &Net) -> u64
  requires net_ok(n)
  ensures result <= XP_N
{
  let mut i = 0;
  while i < XP_N
    invariant i <= XP_N
  {
    if xp_get(n, i, XP_USED) == 0 {
      return i;
    }
    i = i + 1;
  }
  return XP_N;
}

/// Whether the selector (struct xfrm_selector) at b[s..s + 56) is one that
/// can be kept: an errno if not, else 0. It must be IPv4, on addresses and
/// protocol only: ports and an interface are not supported, and a selector
/// that quietly ignored them would match more than it was asked to.
fn xp_sel_err(b: &Bytes, s: u64) -> u64
  requires s + 56 <= blen(b)
{
  if rd16(b, s + 40) != 2 {
    return NE_AFNOSUPPORT;
  }
  if rd8(b, s + 42) > 32 || rd8(b, s + 43) > 32 {
    return NE_INVAL;
  }
  if rd16(b, s + 34) != 0 || rd16(b, s + 38) != 0 || rd16(b, s + 32) != 0 || rd16(b, s + 36) != 0 || rd32(b, s + 48) != 0 {
    return NE_OPNOTSUPP;
  }
  return 0;
}

/// The selector's destination prefix length, and its network (host bits clear).
fn xp_sel_dp(b: &Bytes, s: u64) -> u64
  requires s + 56 <= blen(b)
  ensures result <= 32
{
  return smaller(rd8(b, s + 42), 32);
}

fn xp_sel_da(b: &Bytes, s: u64) -> u64
  requires s + 56 <= blen(b)
  ensures result <= IP_MAX
{
  return wg_mask(be32(b, s), xp_sel_dp(b, s));
}

fn xp_sel_sp(b: &Bytes, s: u64) -> u64
  requires s + 56 <= blen(b)
  ensures result <= 32
{
  return smaller(rd8(b, s + 43), 32);
}

fn xp_sel_sa(b: &Bytes, s: u64) -> u64
  requires s + 56 <= blen(b)
  ensures result <= IP_MAX
{
  return wg_mask(be32(b, s + 16), xp_sel_sp(b, s));
}

/// XFRM_MSG_NEWPOLICY (excl: an existing one is an error) or UPDPOLICY.
fn xp_new(n: &mut Net, b: &Bytes, at: u64, end: u64, excl: bool, admin: bool) -> u64
  requires net_ok(n) && at + 16 <= end && end <= blen(b)
  ensures net_ok(n)
{
  if !admin {
    return NE_PERM;
  }
  if end - at < 16 + XFRM_USERPOLICY {
    return NE_INVAL;
  }
  let pi = at + 16;
  let attrs = pi + XFRM_USERPOLICY;
  let serr = xp_sel_err(b, pi);
  if serr != 0 {
    return serr;
  }
  let dir = rd8(b, pi + 160);
  let act = rd8(b, pi + 161);
  if dir == 2 {
    return NE_OPNOTSUPP;                  // forward policies are not enforced
  }
  if dir > 2 || act > 1 {
    return NE_INVAL;
  }
  let mut nt = 0;
  let mut treq = 0;
  let mut tmode = 0;
  let mut tdst = 0;
  let mut tsrc = 0;
  let tm = nla_find(b, attrs, end, XFRMA_TMPL);
  if tm != 0 {
    let tl = nla_len(b, tm);
    if tl < XFRM_USER_TMPL || tl % XFRM_USER_TMPL != 0 || act != 0 {
      return NE_INVAL;
    }
    if tl != XFRM_USER_TMPL {
      return NE_OPNOTSUPP;                // one template: no chains of transforms
    }
    if rd8(b, tm + 20) != IPPROTO_ESP {
      return NE_PROTONOSUPPORT;
    }
    if rd8(b, tm + 48) > 1 {
      return NE_INVAL;
    }
    nt = 1;
    tdst = xs_addr(b, tm);
    tsrc = xs_addr(b, tm + 28);
    treq = rd32(b, tm + 44);
    tmode = rd8(b, tm + 48);
  }
  let ns = n.ns;
  let had = xp_find(n, ns, dir, xp_sel_da(b, pi), xp_sel_dp(b, pi), xp_sel_sa(b, pi), xp_sel_sp(b, pi), rd8(b, pi + 44));
  let mut row = had;
  if had < XP_N {
    if excl {
      return NE_EXIST;
    }
  } else {
    row = xp_free_row(n);
    if row >= XP_N {
      return NE_NOSPC;
    }
  }
  xp_clear(&mut n, row);
  xp_set(&mut n, row, XP_USED, 1);
  xp_set(&mut n, row, XP_NS, ns);
  xp_set(&mut n, row, XP_DIR, dir);
  xp_set(&mut n, row, XP_ACT, act);
  xp_set(&mut n, row, XP_PRIO, rd32(b, pi + 152));
  xp_set(&mut n, row, XP_DADDR, xp_sel_da(b, pi));
  xp_set(&mut n, row, XP_DPLEN, xp_sel_dp(b, pi));
  xp_set(&mut n, row, XP_SADDR, xp_sel_sa(b, pi));
  xp_set(&mut n, row, XP_SPLEN, xp_sel_sp(b, pi));
  xp_set(&mut n, row, XP_PROTO, rd8(b, pi + 44));
  xp_set(&mut n, row, XP_IDX, (row + 1) * 8 + dir);
  xp_set(&mut n, row, XP_NT, nt);
  xp_set(&mut n, row, XP_TREQID, treq);
  xp_set(&mut n, row, XP_TMODE, tmode);
  xp_set(&mut n, row, XP_TDST, tdst);
  xp_set(&mut n, row, XP_TSRC, tsrc);
  return 0;
}

/// Writes policy i as an XFRM_MSG_NEWPOLICY message (for a read or a dump).
fn xp_put(n: &mut Net, i: u64, seq: u64, port: u64, flags: u64)
  requires net_ok(n) && i < XP_N
  ensures net_ok(n)
{
  nl_begin(&mut n, XFRM_MSG_NEWPOLICY, flags, seq, port);
  xs_put_addr(&mut n, xp_get(n, i, XP_DADDR));
  xs_put_addr(&mut n, xp_get(n, i, XP_SADDR));
  xs_zeros(&mut n, 8);                    // the ports and their masks
  nl_16(&mut n, 2);                       // family
  nl_b(&mut n, xp_get(n, i, XP_DPLEN) % 256);
  nl_b(&mut n, xp_get(n, i, XP_SPLEN) % 256);
  nl_b(&mut n, xp_get(n, i, XP_PROTO) % 256);
  xs_zeros(&mut n, 3);
  xs_zeros(&mut n, 8);                    // ifindex, user
  let mut k = 0;
  while k < 8
    invariant k <= 8 && net_ok(n)
  {
    nl_32(&mut n, 4294967295);
    nl_32(&mut n, 4294967295);
    k = k + 1;
  }
  xs_zeros(&mut n, 32);                   // xfrm_lifetime_cur
  nl_32(&mut n, xp_get(n, i, XP_PRIO) % 4294967296);
  nl_32(&mut n, xp_get(n, i, XP_IDX) % 4294967296);
  nl_b(&mut n, xp_get(n, i, XP_DIR) % 256);
  nl_b(&mut n, xp_get(n, i, XP_ACT) % 256);
  xs_zeros(&mut n, 2);                    // flags, share
  xs_zeros(&mut n, 4);                    // to 8-byte alignment
  if xp_get(n, i, XP_NT) == 1 {
    nla_head(&mut n, XFRMA_TMPL, XFRM_USER_TMPL);
    xs_put_addr(&mut n, xp_get(n, i, XP_TDST));
    xs_zeros(&mut n, 4);                  // spi: any
    nl_b(&mut n, IPPROTO_ESP);
    xs_zeros(&mut n, 3);
    nl_16(&mut n, 2);                     // family
    xs_zeros(&mut n, 2);
    xs_put_addr(&mut n, xp_get(n, i, XP_TSRC));
    nl_32(&mut n, xp_get(n, i, XP_TREQID) % 4294967296);
    nl_b(&mut n, xp_get(n, i, XP_TMODE) % 256);
    xs_zeros(&mut n, 3);                  // share, optional, pad
    nl_32(&mut n, 4294967295);            // any algorithm
    nl_32(&mut n, 4294967295);
    nl_32(&mut n, 4294967295);
  }
  nl_end(&mut n);
}

/// The policy a struct xfrm_userpolicy_id at b[a..) names (by index, else
/// by selector and direction), or XP_N.
fn xp_by_id(n: &Net, b: &Bytes, a: u64, end: u64) -> u64
  requires net_ok(n) && a <= end && end <= blen(b)
  ensures result <= XP_N
{
  if end - a < XFRM_POLICY_ID {
    return XP_N;
  }
  let idx = rd32(b, a + 56);
  let dir = rd8(b, a + 60);
  if idx != 0 {
    let mut i = 0;
    while i < XP_N
      invariant i <= XP_N
    {
      if xp_get(n, i, XP_USED) == 1 && xp_get(n, i, XP_NS) == n.ns && xp_get(n, i, XP_IDX) == idx {
        return i;
      }
      i = i + 1;
    }
    return XP_N;
  }
  if xp_sel_err(b, a) != 0 || dir > 1 {
    return XP_N;
  }
  return xp_find(n, n.ns, dir, xp_sel_da(b, a), xp_sel_dp(b, a), xp_sel_sa(b, a), xp_sel_sp(b, a), rd8(b, a + 44));
}

/// One request on a NETLINK_XFRM socket: the message at b[at..end). Returns
/// an errno (0: none; the answer, if any, is queued).
fn xfrm_message(n: &mut Net, b: &Bytes, at: u64, end: u64, kind: u64, fl: u64, seq: u64, port: u64, admin: bool) -> u64
  requires net_ok(n) && at + 16 <= end && end <= blen(b)
  ensures net_ok(n)
{
  if kind == XFRM_MSG_NEWSA {
    return xs_new(&mut n, b, at, end, fl, admin);
  }
  if kind == XFRM_MSG_NEWPOLICY || kind == XFRM_MSG_UPDPOLICY {
    return xp_new(&mut n, b, at, end, kind == XFRM_MSG_NEWPOLICY, admin);
  }
  if !admin {
    return NE_PERM;
  }
  if kind == XFRM_MSG_FLUSHPOLICY {
    let mut j = 0;
    while j < XP_N
      invariant j <= XP_N && net_ok(n)
    {
      if xp_get(n, j, XP_USED) == 1 && xp_get(n, j, XP_NS) == n.ns {
        xp_clear(&mut n, j);
      }
      j = j + 1;
    }
    return 0;
  }
  if kind == XFRM_MSG_DELPOLICY {
    let j = xp_by_id(n, b, at + 16, end);
    if j >= XP_N {
      return NE_SRCH;
    }
    xp_clear(&mut n, j);
    return 0;
  }
  if kind == XFRM_MSG_GETPOLICY {
    if fl / 256 % 4 == 3 {
      let mut j = 0;
      while j < XP_N
        invariant j <= XP_N && net_ok(n)
      {
        if xp_get(n, j, XP_USED) == 1 && xp_get(n, j, XP_NS) == n.ns {
          xp_put(&mut n, j, seq, port, NLM_F_MULTI);
        }
        j = j + 1;
      }
      nl_done(&mut n, seq, port);
      return 0;
    }
    let j = xp_by_id(n, b, at + 16, end);
    if j >= XP_N {
      return NE_SRCH;
    }
    xp_put(&mut n, j, seq, port, 0);
    return 0;
  }
  if kind == XFRM_MSG_FLUSHSA {
    let mut i = 0;
    while i < XSA_N
      invariant i <= XSA_N && net_ok(n)
    {
      if xs_get(n, i, XS_USED) == 1 && xs_get(n, i, XS_NS) == n.ns {
        xs_clear(&mut n, i);
      }
      i = i + 1;
    }
    return 0;
  }
  if kind == XFRM_MSG_DELSA {
    let i = xs_by_id(n, b, at + 16, end);
    if i >= XSA_N {
      return NE_SRCH;
    }
    xs_clear(&mut n, i);
    return 0;
  }
  if kind == XFRM_MSG_GETSA {
    if fl / 256 % 4 == 3 {
      let mut i = 0;
      while i < XSA_N
        invariant i <= XSA_N && net_ok(n)
      {
        if xs_get(n, i, XS_USED) == 1 && xs_get(n, i, XS_NS) == n.ns {
          xs_put(&mut n, i, seq, port, NLM_F_MULTI);
        }
        i = i + 1;
      }
      nl_done(&mut n, seq, port);
      return 0;
    }
    let i = xs_by_id(n, b, at + 16, end);
    if i >= XSA_N {
      return NE_SRCH;
    }
    xs_put(&mut n, i, seq, port, 0);
    return 0;
  }
  return NE_OPNOTSUPP;
}

/// The NETLINK_XFRM messages in b[0..len) sent on socket q: how many bytes
/// were taken (whole messages).
fn xfrm_request(n: &mut Net, q: u64, b: &Bytes, len: u64, admin: bool) -> u64
  requires net_ok(n) && q < NLS && len <= blen(b)
  ensures net_ok(n)
{
  let was = n.ns;
  let ns = get(n.nls, q * NL_W + NL_NS);
  let port = get(n.nls, q * NL_W + NL_PORT);
  if ns >= NNET || !ns_live(n, ns) {
    return len;
  }
  n.ns = ns;
  nlw_open(&mut n, q);
  let mut at = 0;
  let mut go = true;
  while go && at < len && len - at >= 16
    invariant at <= len && len <= blen(b) && net_ok(n) && ns < NNET
  {
    let ml = rd32(b, at);
    if ml < 16 {
      go = false;
      at = len;
    } else if ml > len - at {
      go = false;
    } else {
      let kind = rd16(b, at + 4);
      let fl = rd16(b, at + 6);
      let seq = rd32(b, at + 8);
      let end = at + ml;
      let mut e = 0;
      let mut quiet = false;
      if kind < 16 {
        quiet = true;                     // NLMSG_NOOP, _ERROR, _DONE
      } else {
        e = xfrm_message(&mut n, b, at, end, kind, fl, seq, port, admin);
        quiet = e == 0 && (kind == XFRM_MSG_GETSA || kind == XFRM_MSG_GETPOLICY);
      }
      if e != 0 || (!quiet && fl / NLM_F_ACK % 2 == 1) {
        nl_error(&mut n, b, at, e, port);
      }
      let step = (ml + 3) / 4 * 4;
      if step > len - at {
        at = end;
        go = false;
      } else {
        at = at + step;
      }
    }
  }
  nlw_close(&mut n, q);
  n.ns = was;
  return len;
}

// ---------------------------------------------------------------- the packet path
//
// Out: a packet the stack sends (send_via_raw) that an out policy covers
// with an ESP template is wrapped in ESP and sent to the association's far
// end; a block policy drops it. In: an ESP packet for us is looked up by
// (destination, SPI, namespace), checked against the replay window, opened
// into a buffer of its own (the packet that arrived is never written to),
// and the packet inside goes round the loopback queue as if it had come in
// from the wire again; a packet that comes in plain is dropped when an in
// policy asks for ESP.

const ESP_OVER: u64 = 52;                 // outer IPv4 header, ESP header, IV and ICV: 20 + 8 + 8 + 16
const ESP_WIN: u64 = 256;                 // the replay bitmap's bits

/// The AES key of association sa as bytes (16 or 32).
fn esp_key(n: &Net, sa: u64) -> Bytes
  requires net_ok(n) && sa < XSA_N
  ensures blen(result) == 16 || blen(result) == 32
{
  let mut len = 16;
  if xs_get(n, sa, XS_KLEN) == 32 {
    len = 32;
  }
  let mut b = balloc(len);
  let mut j = 0;
  while j < len
    invariant j <= len && (len == 16 || len == 32) && blen(b) == len && net_ok(n) && sa < XSA_N
  {
    bset(&mut b, j, cast[u8](xs_get(n, sa, XS_KEY + j / 8) / (1 << (8 * (j % 8))) % 256));
    j = j + 1;
  }
  return b;
}

/// The 12-byte GCM nonce of association sa: its salt, then an 8-byte IV left zero.
fn esp_nonce(n: &Net, sa: u64) -> Bytes
  requires net_ok(n) && sa < XSA_N
  ensures blen(result) == 12
{
  let mut b = balloc(12);
  store_le32(&mut b, 0, cast[u32](xs_get(n, sa, XS_SALT) % 4294967296));
  return b;
}

/// The additional data of a packet: its SPI and sequence number.
fn esp_aad(spi: u64, seq: u64) -> Bytes
  requires spi <= 4294967295 && seq <= 4294967295
  ensures blen(result) == 8
{
  let mut b = balloc(8);
  store_be32(&mut b, 0, cast[u32](spi));
  store_be32(&mut b, 4, cast[u32](seq));
  return b;
}

/// The association an out policy p's template uses for a packet to dst, or XSA_N.
fn esp_sa_out(n: &Net, p: u64, dst: u64) -> u64
  requires net_ok(n) && p < XP_N
  ensures result <= XSA_N
{
  let ns = n.ns;
  let mode = xp_get(n, p, XP_TMODE);
  let treq = xp_get(n, p, XP_TREQID);
  let mut want = dst;
  if mode == 1 {
    want = xp_get(n, p, XP_TDST);
  }
  let mut i = 0;
  while i < XSA_N
    invariant i <= XSA_N
  {
    if xs_get(n, i, XS_USED) == 1 && xs_get(n, i, XS_NS) == ns && xs_get(n, i, XS_MODE) == mode
        && (treq == 0 || xs_get(n, i, XS_REQID) == treq) && (want == 0 || xs_get(n, i, XS_DST) == want) {
      return i;
    }
    i = i + 1;
  }
  return XSA_N;
}

fn esp_bit_clear(n: &mut Net, sa: u64, b: u64)
  requires net_ok(n) && sa < XSA_N && b < ESP_WIN
  ensures net_ok(n)
{
  let w = xs_get(n, sa, XS_RMAP + b / 64);
  let bit = 1 << (b % 64);
  if w / bit % 2 == 1 {
    xs_set(&mut n, sa, XS_RMAP + b / 64, w - bit);
  }
}

/// Whether sequence number seq is new to association sa: above everything
/// received, or inside the window and not yet taken. A window of 0 is
/// treated as 1 (each packet newer than the last): the replay check is
/// never off.
fn esp_seq_ok(n: &Net, sa: u64, seq: u64) -> bool
  requires net_ok(n) && sa < XSA_N
{
  if seq == 0 || seq > 4294967295 {
    return false;
  }
  let top = xs_get(n, sa, XS_RTOP) % 4294967296;
  if seq > top {
    return true;
  }
  let d = top - seq;
  let mut win = smaller(xs_get(n, sa, XS_RWIN), 255);
  if win == 0 {
    win = 1;
  }
  if d >= win {
    return false;
  }
  let b = seq % ESP_WIN;
  return xs_get(n, sa, XS_RMAP + b / 64) / (1 << (b % 64)) % 2 == 0;
}

/// Records seq (which esp_seq_ok took and a packet then authenticated) as
/// received; the window moves up if seq is above it.
fn esp_seq_set(n: &mut Net, sa: u64, seq: u64)
  requires net_ok(n) && sa < XSA_N && seq <= 4294967295
  ensures net_ok(n)
{
  let top = xs_get(n, sa, XS_RTOP) % 4294967296;
  if seq > top {
    let d = seq - top;
    if d >= ESP_WIN {
      let mut k = 0;
      while k < 4
        invariant k <= 4 && net_ok(n) && sa < XSA_N
      {
        xs_set(&mut n, sa, XS_RMAP + k, 0);
        k = k + 1;
      }
    } else {
      let mut j = 0;
      while j < d
        invariant j <= d && d < ESP_WIN && top + d <= 4294967295 && net_ok(n) && sa < XSA_N
      {
        esp_bit_clear(&mut n, sa, (top + j + 1) % ESP_WIN);
        j = j + 1;
      }
    }
    xs_set(&mut n, sa, XS_RTOP, seq);
  }
  let b = seq % ESP_WIN;
  let w = xs_get(n, sa, XS_RMAP + b / 64);
  let bit = 1 << (b % 64);
  if w / bit % 2 == 0 {
    xs_set(&mut n, sa, XS_RMAP + b / 64, w + bit);
  }
}

fn esp_count(n: &mut Net, sa: u64, bytes: u64)
  requires net_ok(n) && sa < XSA_N && bytes <= 65535
  ensures net_ok(n)
{
  let pk = xs_get(n, sa, XS_PKTS);
  if pk < 4294967295 {
    xs_set(&mut n, sa, XS_PKTS, pk + 1);
  }
  let by = xs_get(n, sa, XS_BYTES);
  if by < 4294967295 * 65536 {
    xs_set(&mut n, sa, XS_BYTES, by + bytes);
  }
}

/// The outgoing frame (flen bytes, Ethernet header included): 0 if no
/// policy takes it, else 1 once it has been wrapped and sent, or dropped
/// (a block policy, no association, no room: as if lost on the way).
fn esp_out(n: &mut Net, flen: u64) -> u64
  requires net_ok(n) && 14 <= flen && flen <= NET_BUF
  ensures net_ok(n)
{
  if flen < 34 || flen > FRAME_MAX || be16(n.out, 12) != ETH_IP {
    return 0;
  }
  let proto = cast[u64](bget(n.out, 23));
  if proto == IPPROTO_ESP {
    return 0;
  }
  let src = be32(n.out, 26);
  let dst = be32(n.out, 30);
  let ns = n.ns;
  let p = xp_lookup(n, ns, 1, src, dst, proto);
  if p >= XP_N {
    return 0;
  }
  if xp_get(n, p, XP_ACT) == 1 {
    return 1;
  }
  if xp_get(n, p, XP_NT) != 1 {
    return 0;
  }
  let sa = esp_sa_out(n, p, dst);
  if sa >= XSA_N {
    return 1;
  }
  let tot = be16(n.out, 16);
  if cast[u64](bget(n.out, 14)) != 0x45 || tot < 20 || 14 + tot > flen {
    return 1;
  }
  let tunnel = xs_get(n, sa, XS_MODE) == 1;
  let mut start = 34;
  let mut body = tot - 20;
  let mut nh = proto;
  if tunnel {
    start = 14;
    body = tot;
    nh = 4;
  }
  let pad = (4 - (body + 2) % 4) % 4;
  let plen = body + pad + 2;
  if 14 + ESP_OVER + plen > FRAME_MAX {
    return 1;                         // would not fit a frame: no fragmenting
  }
  let cur = xs_get(n, sa, XS_SEQ);
  if cur >= 4294967295 {
    return 1;                         // the sequence numbers are used up
  }
  let seq = cur + 1;
  xs_set(&mut n, sa, XS_SEQ, seq);
  let spi = xs_get(n, sa, XS_SPI) % 4294967296;
  let mut plain = balloc(plen);
  bcopy(&mut plain, 0, n.out, start, body);
  let mut i = 0;
  while i < pad
    invariant i <= pad && pad <= 3 && plen == body + pad + 2 && blen(plain) == plen
  {
    bset(&mut plain, body + i, cast[u8](i + 1));
    i = i + 1;
  }
  bset(&mut plain, body + pad, cast[u8](pad));
  bset(&mut plain, body + pad + 1, cast[u8](nh));
  let key = esp_key(n, sa);
  let mut nonce = esp_nonce(n, sa);
  store_be32(&mut nonce, 8, cast[u32](seq));
  let aad = esp_aad(spi, seq);
  let sealed = gcm_seal(key, nonce, aad, plain);
  let total = ESP_OVER + plen;
  let mut src2 = src;
  let mut dst2 = dst;
  if tunnel {
    dst2 = xs_get(n, sa, XS_DST) % 4294967296;
    src2 = xs_get(n, sa, XS_SRC) % 4294967296;
    if src2 == 0 {
      src2 = src_ip(n, dst2);
    }
  }
  bset(&mut n.out, 14, 0x45);
  bset(&mut n.out, 15, 0);
  put16(&mut n.out, 16, total);
  put16(&mut n.out, 18, n.tx % 65536);
  put16(&mut n.out, 20, 0);
  bset(&mut n.out, 22, 64);
  bset(&mut n.out, 23, cast[u8](IPPROTO_ESP));
  put16(&mut n.out, 24, 0);
  put32(&mut n.out, 26, src2);
  put32(&mut n.out, 30, dst2);
  put16(&mut n.out, 24, csum(n.out, 14, 20));
  put32(&mut n.out, 34, spi);
  put32(&mut n.out, 38, seq);
  bcopy(&mut n.out, 42, nonce, 4, 8);
  bcopy(&mut n.out, 50, sealed, 0, plen + 16);
  bfree(sealed);
  bfree(aad);
  bfree(nonce);
  bfree(key);
  bfree(plain);
  esp_count(&mut n, sa, plen);
  let hop = next_hop(n, dst2);
  if hop == 0 || hop > IP_MAX {
    return 1;
  }
  send_nowg(&mut n, hop, 14 + total);
  return 1;
}

/// Whether a packet that came out of association sa (from src to dst,
/// protocol proto) is allowed by the in policy that covers it: one that
/// allows it and, if it has a template, one that names sa's reqid and mode.
/// With none, a transport-mode packet is let in (as Linux does), a
/// tunnel-mode one is not: the addresses inside a tunnel are not authenticated
/// by anything but a policy.
fn esp_in_ok(n: &Net, sa: u64, src: u64, dst: u64, proto: u64) -> bool
  requires net_ok(n) && sa < XSA_N && src <= IP_MAX && dst <= IP_MAX
{
  let p = xp_lookup(n, n.ns, 0, src, dst, proto);
  if p >= XP_N {
    return xs_get(n, sa, XS_MODE) != 1;   // a tunnel's inner packet needs a policy that names its addresses
  }
  if xp_get(n, p, XP_ACT) == 1 {
    return false;
  }
  if xp_get(n, p, XP_NT) != 1 {
    return true;
  }
  let treq = xp_get(n, p, XP_TREQID);
  return xs_get(n, sa, XS_MODE) == xp_get(n, p, XP_TMODE) && (treq == 0 || xs_get(n, sa, XS_REQID) == treq);
}

/// Whether a packet that came in plain (src to dst, protocol proto) is
/// allowed: no in policy covers it, or one allows it without asking for ESP.
fn esp_plain_ok(n: &Net, src: u64, dst: u64, proto: u64) -> bool
  requires net_ok(n) && src <= IP_MAX && dst <= IP_MAX
{
  if proto == IPPROTO_ESP {
    return true;
  }
  let p = xp_lookup(n, n.ns, 0, src, dst, proto);
  if p >= XP_N {
    return true;
  }
  return xp_get(n, p, XP_ACT) == 0 && xp_get(n, p, XP_NT) == 0;
}

/// The packet inside an authenticated ESP packet (plain: its payload,
/// padding, pad length and next header) of association sa goes round the
/// loopback queue, if it is whole and a policy lets it in.
fn esp_accept(n: &mut Net, sa: u64, seq: u64, plain: &Bytes)
  requires net_ok(n) && sa < XSA_N && seq <= 4294967295 && blen(plain) <= FRAME_MAX - 34
  ensures net_ok(n)
{
  esp_seq_set(&mut n, sa, seq);
  let pl = blen(plain);
  if pl < 4 {
    return;
  }
  let padlen = cast[u64](bget(plain, pl - 2));
  let nh = cast[u64](bget(plain, pl - 1));
  if padlen + 2 > pl {
    return;
  }
  let inner = pl - 2 - padlen;
  let mut k = 0;
  while k < padlen
    invariant k <= padlen && padlen + 2 <= pl && pl == blen(plain) && inner == pl - 2 - padlen
  {
    if cast[u64](bget(plain, inner + k)) != k + 1 {
      return;                         // the padding is 1, 2, 3 ...
    }
    k = k + 1;
  }
  esp_count(&mut n, sa, pl);
  put48(&mut n.out, 0, 0);
  put48(&mut n.out, 6, 0);
  put16(&mut n.out, 12, ETH_IP);
  if xs_get(n, sa, XS_MODE) == 1 {
    // tunnel: the packet inside is a whole IPv4 packet with a plain header
    if nh != 4 || inner < 20 || cast[u64](bget(plain, 0)) != 0x45 || csum(plain, 0, 20) != 0 {
      return;
    }
    let itot = be16(plain, 2);
    if itot < 20 || itot > inner {
      return;
    }
    let src = be32(plain, 12);
    let dst = be32(plain, 16);
    if src == 0 || src / 16777216 == LO_NET || src >= 3758096384 || !esp_in_ok(n, sa, src, dst, cast[u64](bget(plain, 9))) {
      return;                         // a source no peer may have, or a policy says no
    }
    bcopy(&mut n.out, 14, plain, 0, itot);
    lo_send(&mut n, 14 + itot);
  } else {
    // transport: the outer header stays, with the protocol the trailer names
    if nh == IPPROTO_ESP {
      return;                         // no ESP inside ESP
    }
    let src = be32(n.pkt, 26);
    let dst = be32(n.pkt, 30);
    if src == 0 || src / 16777216 == LO_NET || src >= 3758096384 || !esp_in_ok(n, sa, src, dst, nh) {
      return;
    }
    bset(&mut n.out, 14, 0x45);
    bset(&mut n.out, 15, 0);
    put16(&mut n.out, 16, 20 + inner);
    put16(&mut n.out, 18, be16(n.pkt, 18));
    put16(&mut n.out, 20, 0);
    bset(&mut n.out, 22, bget(n.pkt, 22));
    bset(&mut n.out, 23, cast[u8](nh));
    put16(&mut n.out, 24, 0);
    put32(&mut n.out, 26, src);
    put32(&mut n.out, 30, dst);
    put16(&mut n.out, 24, csum(n.out, 14, 20));
    bcopy(&mut n.out, 34, plain, 0, inner);
    lo_send(&mut n, 34 + inner);
  }
}

/// An ESP packet (total bytes of IPv4 packet at 14 in n.pkt) for this machine.
fn esp_in(n: &mut Net, total: u64)
  requires net_ok(n) && 20 <= total && 14 + total <= FRAME_MAX
  ensures net_ok(n)
{
  if total < 56 || (total - 52) % 4 != 0 || n.lo_split {
    return;                           // not a whole ESP packet (ICV 16, IV 8, at least 4 of payload)
  }
  let dst = be32(n.pkt, 30);
  let spi = be32(n.pkt, 34);
  let seq = be32(n.pkt, 38);
  let sa = xs_find(n, n.ns, dst, spi);
  if sa >= XSA_N || !esp_seq_ok(n, sa, seq) {
    return;
  }
  let key = esp_key(n, sa);
  let mut nonce = esp_nonce(n, sa);
  bcopy(&mut nonce, 4, n.pkt, 42, 8);
  let aad = bytes_slice(n.pkt, 34, 42);
  let sealed = bytes_slice(n.pkt, 50, 14 + total);
  match gcm_open(key, nonce, aad, sealed) {
    Option::None => {},
    Option::Some(plain) => {
      esp_accept(&mut n, sa, seq, plain);
      bfree(plain);
    },
  }
  bfree(sealed);
  bfree(aad);
  bfree(nonce);
  bfree(key);
}
