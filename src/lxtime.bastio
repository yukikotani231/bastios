// Time and waiting for Linux programs: clocks off the clock of
// src/tsc.bastio (k.ns, read as
// each system call comes in), sleeps, and poll over the console, pipes and
// sockets. A call that has to wait runs again later (the restart in
// lx_retry); a timed wait keeps its deadline in the restart word, as 2 +
// the time it ends at, so the later runs wait for the first run's
// deadline rather than starting the clock again.
//
// alarm and setitimer(ITIMER_REAL) keep a deadline per process in
// k.alarms, which every timer tick checks (lx_alarms) against k.ns.
//
// CLOCK_REALTIME (and gettimeofday, time) is k.epoch, read from the CMOS
// clock at boot (src/rtc.bastio), plus k.ns. Programs linked against musl
// read the monotonic and real-time clocks through the vDSO (user/vdso.c)
// instead, from the same counter with the same arithmetic.

import "linux.bastio";

const LX_NANOSLEEP: u64 = 35;
const LX_GETTIMEOFDAY: u64 = 96;
const LX_TIME: u64 = 201;
const LX_CLOCK_GETTIME: u64 = 228;
const LX_CLOCK_GETRES: u64 = 229;
const LX_CLOCK_NANOSLEEP: u64 = 230;

const NS_PER_S: u64 = 1000000000;
const NS_PER_TICK: u64 = 10000000;    // the timer runs at 100 Hz
const FOREVER: u64 = 18446744073709551613;   // 2^64 - 3: a deadline never reached
const TIMER_ABSTIME: u64 = 1;
const CLOCK_PROCESS_CPUTIME_ID: u64 = 2;
const CLOCK_THREAD_CPUTIME_ID: u64 = 3;
const CLOCK_BOOTTIME: u64 = 7;
const LX_SELECT: u64 = 23;
const FD_SETSIZE: u64 = 1024;
const SET_BYTES: u64 = 128;             // FD_SETSIZE / 8
const SEL_IN: u64 = 1024;              // where in xfer select keeps the three sets it was given
const SEL_OUT: u64 = 2048;             // and where it builds the three it gives back
const LX_GETITIMER: u64 = 36;
const LX_ALARM: u64 = 37;
const LX_SETITIMER: u64 = 38;
const ITIMER_REAL: u64 = 0;
const ITIMER_VIRTUAL: u64 = 1;
const ITIMER_PROF: u64 = 2;
const SIGALRM: u64 = 14;
const LX_RT_SIGTIMEDWAIT: u64 = 128;
const CLOCK_REALTIME: u64 = 0;
const CLOCK_REALTIME_COARSE: u64 = 5;
const CLOCK_MONOTONIC_COARSE: u64 = 6;

/// The wall clock, in ns since 1970-01-01 00:00 UTC.
fn wall_ns(k: &Kernel) -> u64
  ensures result <= FOREVER
{
  return sat_add(k.epoch, k.ns);
}


/// a + b, or FOREVER if that is as far or further.
fn sat_add(a: u64, b: u64) -> u64
  ensures result <= FOREVER
{
  if a >= FOREVER || b >= FOREVER - a {
    return FOREVER;
  }
  return a + b;
}

/// The deadline of a wait for `wait` ns that started now, or, when this is
/// a run again of a timed wait (`was`, the restart word the call found),
/// the deadline the first run set.
fn deadline(k: &Kernel, was: u64, wait: u64) -> u64
  ensures result <= FOREVER
{
  if was >= 2 && was - 2 <= FOREVER {
    return was - 2;
  }
  return sat_add(k.ns, wait);
}

/// Makes process `pid` run system call `n` again until deadline `dl`.
fn wait_until(k: &mut Kernel, pid: u64, n: u64, dl: u64) -> u64
  requires kok(k) && pid < NPROC && dl <= FOREVER
  ensures kok(k)
{
  let r = lx_retry(&mut k, pid, n);
  if r == SWITCH {
    pset(&mut k.procs, pid, F_RESTART, 2 + dl);
  }
  return r;
}

/// As wait_until, but asleep (nap) until a frame comes in, the clock ticks
/// or a signal is posted, rather than run again on every pass of the
/// scheduler: for poll, select, epoll_wait and pause, which servers sit in
/// (nginx's master and workers kept two processors busy). Readiness
/// that comes from elsewhere, such as a pipe written, is seen at the next
/// tick, up to 10 ms late, and so is the deadline.
fn wait_asleep(k: &mut Kernel, pid: u64, n: u64, dl: u64) -> u64
  requires kok(k) && pid < NPROC && dl <= FOREVER
  ensures kok(k)
{
  let r = wait_until(&mut k, pid, n, dl);
  if r == SWITCH {
    nap(&mut k, pid, n != LX_PAUSE);        // pause waits only for a signal
  }
  return r;
}

/// A struct timespec read from user memory, in ns (FOREVER at most); err
/// is -EFAULT or -EINVAL when it cannot be read or is out of range.
struct Ts { err: u64, ns: u64 }

fn ts_in(k: &mut Kernel, pid: u64, va: u64) -> Ts
  requires kok(k) && pid < NPROC
  ensures kok(k) && result.ns <= FOREVER
{
  if copy_from_user(&mut k.spaces, pid, va, &mut k.fs.xfer, 16) != 16 {
    return Ts { err: EFAULT, ns: 0 };
  }
  let sec = get_u64(k.fs.xfer, 0);
  let nsec = get_u64(k.fs.xfer, 8);
  if sec >= 0x8000000000000000 || nsec >= NS_PER_S {
    return Ts { err: EINVAL, ns: 0 };
  }
  if sec >= FOREVER / NS_PER_S {
    return Ts { err: 0, ns: FOREVER };
  }
  return Ts { err: 0, ns: sat_add(sec * NS_PER_S, nsec) };
}

/// Writes t ns to user address va as two words: seconds, and the rest in
/// units of `unit` ns (1 for a timespec, 1000 for a timeval).
fn time_out(k: &mut Kernel, pid: u64, va: u64, t: u64, unit: u64) -> u64
  requires kok(k) && pid < NPROC && 1 <= unit
  ensures kok(k)
{
  xfer_u64(&mut k.fs.xfer, 0, t / NS_PER_S);
  xfer_u64(&mut k.fs.xfer, 8, t % NS_PER_S / unit);
  if copy_to_user(&mut k.spaces, pid, va, k.fs.xfer, 16) != 16 {
    return EFAULT;
  }
  return 0;
}

/// The CPU time process (or thread) p has used, in ns.
fn cpu_ns(k: &Kernel, p: u64) -> u64
  requires kok(k) && p < NPROC
{
  let t = pget(k.procs, p, F_TICKS);
  if t >= FOREVER / NS_PER_TICK {
    return FOREVER - 1;
  }
  return t * NS_PER_TICK;
}

/// What clock `clk` reads now, or FOREVER for a clock there is not. A
/// negative clock is another process's or thread's CPU-time clock
/// (clock_getcpuclockid, pthread_getcpuclockid): the bitwise not of its
/// id (0: the caller) times 8, plus 4 for a thread, plus the kind (0
/// prof, 1 virt, 2 sched; all three count the same ticks here).
fn clock_now(k: &Kernel, pid: u64, clk: u64) -> u64
  requires kok(k) && pid < NPROC
{
  if clk == CLOCK_PROCESS_CPUTIME_ID || clk == CLOCK_THREAD_CPUTIME_ID {
    return cpu_ns(k, pid);
  }
  if clk >= 0x8000000000000000 {
    if clk % 4 == 3 {
      return FOREVER;
    }
    let mut t = (!clk) >> 3;
    if t == 0 {
      t = pid;
    }
    if t >= NPROC || state(k.procs, t) == FREE {
      return FOREVER;
    }
    if clk % 8 >= 4 && tgid(k.procs, t) != tgid(k.procs, pid) {
      return FOREVER;                       // a thread of another process
    }
    return cpu_ns(k, t);
  }
  // The coarse clocks move a tick at a time, as Linux's do (they read
  // the time of the last tick), and clock_getres says so.
  if clk == CLOCK_REALTIME_COARSE {
    let w = smaller(wall_ns(k), FOREVER - 1);
    return w / NS_PER_TICK * NS_PER_TICK;
  }
  if clk == CLOCK_MONOTONIC_COARSE {
    let m = smaller(k.ns, FOREVER - 1);
    return m / NS_PER_TICK * NS_PER_TICK;
  }
  if clk == CLOCK_REALTIME {
    return smaller(wall_ns(k), FOREVER - 1);
  }
  // MONOTONIC, MONOTONIC_RAW, MONOTONIC_COARSE and BOOTTIME count from boot.
  if clk <= CLOCK_BOOTTIME {
    return smaller(k.ns, FOREVER - 1);
  }
  return FOREVER;
}

/// nanosleep and clock_nanosleep: waits until the time asked for has
/// passed. A signal handler ends the sleep early with -EINTR, and the
/// time left goes back through rem (sleep_left).
fn lx_sleep(k: &mut Kernel, pid: u64, n: u64, was: u64, clk: u64, flags: u64, req: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let now = clock_now(k, pid, clk);
  if now == FOREVER {
    ret(&mut k.procs, pid, EINVAL);
    return KEEP;
  }
  if clk == 3 {
    ret(&mut k.procs, pid, EOPNOTSUPP);     // CLOCK_THREAD_CPUTIME_ID: Linux cannot sleep on it either
    return KEEP;
  }
  if clk >= 0x8000000000000000 && clk % 8 >= 4 {
    ret(&mut k.procs, pid, EINVAL);         // another thread's CPU time: nor on this
    return KEEP;
  }
  let ts = ts_in(&mut k, pid, req);
  if ts.err != 0 {
    ret(&mut k.procs, pid, ts.err);
    return KEEP;
  }
  // Every clock runs at the same pace (the CPU-time ones too, here).
  let mut wait = ts.ns;
  if flags & TIMER_ABSTIME != 0 {
    if ts.ns <= now {
      ret(&mut k.procs, pid, 0);
      return KEEP;
    }
    wait = ts.ns - now;
  }
  let dl = deadline(k, was, wait);
  if k.ns >= dl {
    ret(&mut k.procs, pid, 0);
    return KEEP;
  }
  return wait_until(&mut k, pid, n, dl);
}

/// A nanosleep or relative clock_nanosleep of process p that a signal
/// handler interrupts: the time it had left goes to its rem argument (if
/// not NULL). False if rem cannot be written: the call then fails with
/// EFAULT instead of EINTR, as on Linux.
fn sleep_left(k: &mut Kernel, p: u64, call: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let was = pget(k.procs, p, F_RESTART);
  let mut rem = 0;
  if call == LX_NANOSLEEP {
    rem = pget(k.procs, p, F_REGS + R_RSI);
  } else if call == LX_CLOCK_NANOSLEEP && pget(k.procs, p, F_REGS + R_RSI) & TIMER_ABSTIME == 0 {
    rem = pget(k.procs, p, F_REGS + R_R10);
  }
  if rem == 0 || was < 2 {
    return true;
  }
  let dl = was - 2;
  let mut left = 0;
  if dl > k.ns {
    left = dl - k.ns;
  }
  return time_out(&mut k, p, rem, left, 1) == 0;
}

// ---------------------------------------------------------------- poll

/// What a poll on descriptor fd of process pid finds now (POLLIN, POLLOUT,
/// POLLERR, POLLHUP, POLLNVAL).
fn poll_bits(k: &Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
{
  let f = fd_look(k, pid, fd);
  if f.kind == K_EPOLL {
    return ep_poll_bits(k, pid, f.x);       // POLLIN if something it watches is ready
  }
  return leaf_bits(k, pid, fd);
}

/// poll_bits for anything but an epoll instance, which finds 0 here (an
/// epoll instance inside another one is handled by ep_ready, in
/// src/lxevent.bastio).
fn leaf_bits(k: &Kernel, pid: u64, fd: u64) -> u64
  requires kok(k) && pid < NPROC
{
  let f = fd_look(k, pid, fd);
  if f.kind == K_BAD {
    return POLLNVAL;
  }
  if f.kind == K_EVENT || f.kind == K_TIMER || f.kind == K_EPOLL {
    return ev_bits(k, f.kind, f.x);
  }
  if f.kind == K_SIGFD {
    return sfd_bits(k, pid, f.x);
  }
  if f.kind == K_DEV && is_pty_dev(f.x) {
    return pty_bits(k, f.x);                // src/lxpty.bastio
  }
  if f.kind == K_INOTIFY {
    return ino_bits(k, f.x);                // src/lxinotify.bastio
  }
  if f.kind == K_PIDFD {
    if f.x >= NPROC || state(k.procs, f.x) == FREE || state(k.procs, f.x) == ZOMBIE {
      return POLLIN;                        // the process has ended (src/lxpidfd.bastio)
    }
    return 0;
  }
  if f.kind == K_CONSOLE {
    if get(k.line, 1) != 0 {
      return POLLIN | POLLOUT;              // a line is waiting
    }
    return POLLOUT;
  }
  if f.kind == K_PIPE_R {
    let mut b = 0;
    if pi_get(k.pipes, f.x, 1) > 0 {
      b = POLLIN;
    }
    if pi_get(k.pipes, f.x, 3) == 0 && pi_get(k.pipes, f.x, 5) != 0 {
      b = b | POLLHUP;                      // no writer left: end of file
    }
    if pipe_both(k, pid, fd) && pipe_room(k.pipes, f.x, smaller(pi_get(k.pipes, f.x, 1), PIPE_CAP)) >= PIPE_ATOM {
      b = b | POLLOUT;                      // a FIFO opened O_RDWR writes too
    }
    return b;
  }
  if f.kind == K_PIPE_W {
    if pi_get(k.pipes, f.x, 2) == 0 {
      return POLLERR;                       // no reader left
    }
    if pipe_room(k.pipes, f.x, smaller(pi_get(k.pipes, f.x, 1), PIPE_CAP)) >= PIPE_ATOM {
      return POLLOUT;                       // room for a whole PIPE_BUF write
    }
    return 0;
  }
  if f.kind == K_SOCK {
    if is_tcp(k, pid, fd) {
      return tcp_poll_bits(k, pid, fd);
    }
    if is_unix(k, pid, fd) {
      return ux_poll_bits(k, pid, fd);
    }
    if sock_ready(k.nic, f.x) {
      return POLLIN | POLLOUT;
    }
    return POLLOUT;
  }
  return POLLIN | POLLOUT;                  // files and directories never wait
}

/// poll and ppoll: fills in revents for each of the nfds struct pollfd at
/// fds and returns how many have something, waiting (a run again) until
/// one does or `wait` ns have passed (FOREVER: no timeout). ppoll's signal
/// mask is applied by lx_time_call (mask_swap).
fn lx_poll(k: &mut Kernel, pid: u64, n: u64, was: u64, fds: u64, nfds: u64, wait: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if nfds > POLL_MAX {
    ret(&mut k.procs, pid, EINVAL);
    return KEEP;
  }
  let size = 8 * nfds;
  // No descriptors (a plain wait, often with fds NULL): nothing to copy.
  if size > 0 && copy_from_user(&mut k.spaces, pid, fds, &mut k.fs.xfer, size) != size {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  let mut ready = 0;
  let mut i = 0;
  while i < nfds
    invariant i <= nfds && nfds <= POLL_MAX && ready <= i && kok(k)
  {
    // struct pollfd: int fd, short events, short revents. A negative fd
    // is skipped.
    let at = 8 * i;
    let fd = cast[u64](bget(k.fs.xfer, at)) | cast[u64](bget(k.fs.xfer, at + 1)) << 8 | cast[u64](bget(k.fs.xfer, at + 2)) << 16 | cast[u64](bget(k.fs.xfer, at + 3)) << 24;
    let ev = cast[u64](bget(k.fs.xfer, at + 4)) | cast[u64](bget(k.fs.xfer, at + 5)) << 8;
    let mut rv = 0;
    if fd < 0x80000000 {
      rv = poll_bits(k, pid, fd) & (ev | POLLERR | POLLHUP | POLLNVAL);
    }
    bset(&mut k.fs.xfer, at + 6, cast[u8](rv % 256));
    bset(&mut k.fs.xfer, at + 7, cast[u8](rv / 256 % 256));   // POLLRDHUP is 0x2000
    if rv != 0 {
      ready = ready + 1;
    }
    i = i + 1;
  }
  if ready == 0 {
    let dl = deadline(k, was, wait);
    if k.ns < dl {
      return wait_asleep(&mut k, pid, n, dl);
    }
  }
  if size > 0 && copy_to_user(&mut k.spaces, pid, fds, k.fs.xfer, size) != size {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  ret(&mut k.procs, pid, ready);
  return KEEP;
}

// ---------------------------------------------------------------- select

/// Whether bit i is set in the fd_set kept in xfer at `at`.
fn set_has(k: &Kernel, at: u64, i: u64) -> bool
  requires kok(k) && at <= SEL_OUT + 2 * SET_BYTES && i < FD_SETSIZE
{
  let byte = cast[u64](bget(k.fs.xfer, at + i / 8));
  return (byte >> (i % 8)) % 2 == 1;
}

/// Sets bit i in the fd_set kept in xfer at `at`.
fn set_put(k: &mut Kernel, at: u64, i: u64)
  requires kok(k) && at <= SEL_OUT + 2 * SET_BYTES && i < FD_SETSIZE
  ensures kok(k)
{
  let byte = cast[u64](bget(k.fs.xfer, at + i / 8));
  bset(&mut k.fs.xfer, at + i / 8, cast[u8]((byte | 1 << (i % 8)) % 256));
}

/// Copies the first nb bytes of the fd_set at user address va (none when
/// va is 0) into set `slot` of SEL_IN, and clears set `slot` of SEL_OUT.
/// False when va cannot be read.
fn set_load(k: &mut Kernel, pid: u64, va: u64, slot: u64, nb: u64) -> bool
  requires kok(k) && pid < NPROC && slot < 3 && nb <= SET_BYTES
  ensures kok(k)
{
  if va != 0 {
    if copy_from_user(&mut k.spaces, pid, va, &mut k.fs.xfer, nb) != nb {
      return false;
    }
  }
  let mut i = 0;
  while i < SET_BYTES
    invariant i <= SET_BYTES && kok(k)
  {
    let mut v = 0;
    if va != 0 && i < nb {
      v = cast[u64](bget(k.fs.xfer, i));
    }
    bset(&mut k.fs.xfer, SEL_IN + SET_BYTES * slot + i, cast[u8](v % 256));
    bset(&mut k.fs.xfer, SEL_OUT + SET_BYTES * slot + i, 0);
    i = i + 1;
  }
  return true;
}

/// Writes the first nb bytes of set `slot` of SEL_OUT back to user address
/// va (nothing when va is 0). False when va cannot be written.
fn set_store(k: &mut Kernel, pid: u64, va: u64, slot: u64, nb: u64) -> bool
  requires kok(k) && pid < NPROC && slot < 3 && nb <= SET_BYTES
  ensures kok(k)
{
  if va == 0 {
    return true;
  }
  let mut i = 0;
  while i < nb
    invariant i <= nb && kok(k)
  {
    let v = cast[u64](bget(k.fs.xfer, SEL_OUT + SET_BYTES * slot + i));
    bset(&mut k.fs.xfer, i, cast[u8](v % 256));
    i = i + 1;
  }
  return copy_to_user(&mut k.spaces, pid, va, k.fs.xfer, nb) == nb;
}

/// select and pselect6 over the first nfds descriptors: rd, wr and ex are
/// the user's fd_sets (0 for none). Waits like poll. Nothing is ever
/// exceptional, the time left is not written back to select's timeout,
/// and pselect6's signal mask is applied by lx_time_call (mask_swap).
fn lx_select(k: &mut Kernel, pid: u64, n: u64, was: u64, nfds: u64, rd: u64, wr: u64, ex: u64, wait: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if nfds > FD_SETSIZE {
    ret(&mut k.procs, pid, EINVAL);
    return KEEP;
  }
  let nb = (nfds + 7) / 8;
  let ok_r = set_load(&mut k, pid, rd, 0, nb);
  let ok_w = set_load(&mut k, pid, wr, 1, nb);
  let ok_e = set_load(&mut k, pid, ex, 2, nb);
  if !ok_r || !ok_w || !ok_e {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  let mut ready = 0;
  let mut i = 0;
  while i < nfds
    invariant i <= nfds && nfds <= FD_SETSIZE && ready <= 2 * i && kok(k)
  {
    let want_r = set_has(k, SEL_IN, i);
    let want_w = set_has(k, SEL_IN + SET_BYTES, i);
    let want_e = set_has(k, SEL_IN + 2 * SET_BYTES, i);
    if want_r || want_w || want_e {
      let bits = poll_bits(k, pid, i);
      if bits & POLLNVAL != 0 {
        ret(&mut k.procs, pid, EBADF);
        return KEEP;
      }
      if want_r && bits & (POLLIN | POLLHUP | POLLERR) != 0 {
        set_put(&mut k, SEL_OUT, i);
        ready = ready + 1;
      }
      if want_w && bits & (POLLOUT | POLLERR) != 0 {
        set_put(&mut k, SEL_OUT + SET_BYTES, i);
        ready = ready + 1;
      }
    }
    i = i + 1;
  }
  if ready == 0 {
    let dl = deadline(k, was, wait);
    if k.ns < dl {
      return wait_asleep(&mut k, pid, n, dl);
    }
  }
  let st_r = set_store(&mut k, pid, rd, 0, nb);
  let st_w = set_store(&mut k, pid, wr, 1, nb);
  let st_e = set_store(&mut k, pid, ex, 2, nb);
  if !st_r || !st_w || !st_e {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  ret(&mut k.procs, pid, ready);
  return KEEP;
}

/// A struct timeval read from user memory, in ns, as ts_in does a timespec.
fn tv_in(k: &mut Kernel, pid: u64, va: u64) -> Ts
  requires kok(k) && pid < NPROC
  ensures kok(k) && result.ns <= FOREVER
{
  if copy_from_user(&mut k.spaces, pid, va, &mut k.fs.xfer, 16) != 16 {
    return Ts { err: EFAULT, ns: 0 };
  }
  let sec = get_u64(k.fs.xfer, 0);
  let usec = get_u64(k.fs.xfer, 8);
  if sec >= 0x8000000000000000 || usec >= 1000000 {
    return Ts { err: EINVAL, ns: 0 };
  }
  if sec >= FOREVER / NS_PER_S {
    return Ts { err: 0, ns: FOREVER };
  }
  return Ts { err: 0, ns: sat_add(sec * NS_PER_S, usec * 1000) };
}

// ---------------------------------------------------------------- alarms

/// On a timer tick, with k.ns just read: sends SIGALRM to each process
/// whose real-time timer has run out, and sets the timer going again if it
/// has an interval; then the same for the POSIX timers.
fn lx_alarms(k: &mut Kernel)
  requires kok(k)
  ensures kok(k)
{
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && kok(k)
  {
    let dl = get(k.alarms, 2 * p);
    if dl != 0 && k.ns >= dl {
      post_sig(&mut k, p, SIGALRM);
      let iv = get(k.alarms, 2 * p + 1);
      let mut next = 0;
      if iv != 0 {
        next = sat_add(dl, iv);
        if next <= k.ns {
          next = sat_add(k.ns, iv);         // ticks were missed: skip the lost rounds
        }
      }
      k.alarms = set(k.alarms, 2 * p, next);
    }
    p = p + 1;
  }
  ptimer_tick(&mut k);                    // and the POSIX timers (src/lxptimer.bastio)
}

/// The time left on process pid's real-time timer, in ns (0 when off).
fn alarm_left(k: &Kernel, pid: u64) -> u64
  requires kok(k) && pid < NPROC
{
  let dl = get(k.alarms, 2 * pid);
  if dl == 0 || dl <= k.ns {
    return 0;
  }
  return dl - k.ns;
}

/// Starts process pid's real-time timer: `value` ns from now (0 stops it),
/// then every `interval` ns.
fn alarm_set(k: &mut Kernel, pid: u64, value: u64, interval: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if value == 0 {
    k.alarms = set(k.alarms, 2 * pid, 0);
    k.alarms = set(k.alarms, 2 * pid + 1, 0);
    return;
  }
  k.alarms = set(k.alarms, 2 * pid, smaller(sat_add(k.ns, value), FOREVER));
  k.alarms = set(k.alarms, 2 * pid + 1, interval);
}

/// Writes process pid's real-time timer to user address va as a struct
/// itimerval (the interval, then the value, each a timeval).
fn itimer_out(k: &mut Kernel, pid: u64, va: u64, which: u64) -> u64
  requires kok(k) && pid < NPROC && which <= ITIMER_PROF
  ensures kok(k)
{
  let mut iv = get(k.alarms, 2 * pid + 1);
  let mut left = alarm_left(k, pid);
  if which != ITIMER_REAL {
    let w = cpu_timer(which);
    left = pget(k.procs, pid, w);
    iv = pget(k.procs, pid, w + 1);
  }
  xfer_u64(&mut k.fs.xfer, 0, iv / NS_PER_S);
  xfer_u64(&mut k.fs.xfer, 8, iv % NS_PER_S / 1000);
  xfer_u64(&mut k.fs.xfer, 16, left / NS_PER_S);
  xfer_u64(&mut k.fs.xfer, 24, left % NS_PER_S / 1000);
  if copy_to_user(&mut k.spaces, pid, va, k.fs.xfer, 32) != 32 {
    return EFAULT;
  }
  return 0;
}

/// The row word of CPU-time timer `which` (its interval is the next one).
fn cpu_timer(which: u64) -> u64
  ensures result + 1 < STRIDE
{
  if which == ITIMER_VIRTUAL {
    return F_VTIMER;
  }
  return F_PTIMER;
}

/// On a timer tick that found process p running: its CPU-time timers run
/// down by the tick, and one that runs out sends its signal (SIGVTALRM or
/// SIGPROF) and starts again from its interval. Time in the kernel counts
/// as the process's own: ITIMER_VIRTUAL and ITIMER_PROF run alike.
fn cpu_timers_tick(k: &mut Kernel, p: u64)
  requires kok(k) && 1 <= p && p < NPROC
  ensures kok(k)
{
  let mut which = ITIMER_VIRTUAL;
  while which <= ITIMER_PROF
    invariant ITIMER_VIRTUAL <= which && which <= ITIMER_PROF + 1 && kok(k)
  {
    let w = cpu_timer(which);
    let left = pget(k.procs, p, w);
    if left > NS_PER_TICK {
      pset(&mut k.procs, p, w, left - NS_PER_TICK);
    } else if left != 0 {
      pset(&mut k.procs, p, w, pget(k.procs, p, w + 1));
      post_sig(&mut k, p, 25 + which);      // SIGVTALRM (26), SIGPROF (27)
    }
    which = which + 1;
  }
  rl_cpu_tick(&mut k, p);                 // RLIMIT_CPU
}

/// alarm, getitimer and setitimer: ITIMER_REAL, and the CPU-time timers
/// ITIMER_VIRTUAL and ITIMER_PROF (counted in timer ticks).
fn lx_itimer(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_ALARM {
    // The seconds that were left, rounded to the nearest, but at least 1
    // while the old alarm was still going.
    let left = alarm_left(k, pid);
    let mut secs = left / NS_PER_S;
    if left % NS_PER_S >= NS_PER_S / 2 {
      secs = secs + 1;
    }
    if secs == 0 && left != 0 {
      secs = 1;
    }
    alarm_set(&mut k, pid, (a % 0x100000000) * NS_PER_S, 0);
    ret(&mut k.procs, pid, secs);
    return KEEP;
  }
  if a > ITIMER_PROF {
    ret(&mut k.procs, pid, EINVAL);
    return KEEP;
  }
  if n == LX_GETITIMER {
    ret(&mut k.procs, pid, itimer_out(&mut k, pid, b, a));
    return KEEP;
  }
  // setitimer(which, new, old): read new before writing old, which may be
  // the same struct.
  let mut value = 0;
  let mut interval = 0;
  if b != 0 {
    if b > 0xFFFFFFFFFFFFFF00 {
      ret(&mut k.procs, pid, EFAULT);
      return KEEP;
    }
    let ti = tv_in(&mut k, pid, b);
    let tv = tv_in(&mut k, pid, b + 16);
    if ti.err != 0 {
      ret(&mut k.procs, pid, ti.err);
      return KEEP;
    }
    if tv.err != 0 {
      ret(&mut k.procs, pid, tv.err);
      return KEEP;
    }
    value = tv.ns;
    interval = ti.ns;
  }
  if c != 0 {
    let r = itimer_out(&mut k, pid, c, a);
    if r != 0 {
      ret(&mut k.procs, pid, r);
      return KEEP;
    }
  }
  if a != ITIMER_REAL {
    let w = cpu_timer(a);
    pset(&mut k.procs, pid, w, value);
    pset(&mut k.procs, pid, w + 1, interval);
    ret(&mut k.procs, pid, 0);
    return KEEP;
  }
  alarm_set(&mut k, pid, value, interval);
  ret(&mut k.procs, pid, 0);
  return KEEP;
}

/// rt_sigtimedwait(set, info, timeout): takes the lowest pending signal in
/// set and returns it, filling in the siginfo's number; waits (a run
/// again) until one is pending or the timeout passes (-EAGAIN). The
/// siginfo carries the signal's number and sender.
fn lx_sigtimedwait(k: &mut Kernel, pid: u64, n: u64, was: u64, setp: u64, info: u64, tsp: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if copy_from_user(&mut k.spaces, pid, setp, &mut k.fs.xfer, 8) != 8 {
    ret(&mut k.procs, pid, EFAULT);
    return KEEP;
  }
  let want = rd64(k.fs.xfer, 0);
  let mut wait = FOREVER;
  if tsp != 0 {
    let ts = ts_in(&mut k, pid, tsp);
    if ts.err != 0 {
      ret(&mut k.procs, pid, ts.err);
      return KEEP;
    }
    wait = ts.ns;
  }
  let pend = pget(k.procs, pid, F_SIGPEND);
  let mut s = 1;
  while s <= NSIG
    invariant 1 <= s && s <= NSIG + 1 && kok(k)
  {
    if has_sig(pend & want, s) {
      pset(&mut k.procs, pid, F_SIGPEND, pend & !sbit(s));
      if info != 0 {
        let mut i = 0;
        while i < 128
          invariant i <= 128 && kok(k)
        {
          bset(&mut k.fs.xfer, i, 0);
          i = i + 1;
        }
        bset(&mut k.fs.xfer, 0, cast[u8](s));
        info_from(&mut k.fs.xfer, 0, wget(k.sigsave, sender_at(pid, s)));   // si_pid, si_value
        if lx_put_out(&mut k, pid, info, 128) != 0 {
          ret(&mut k.procs, pid, EFAULT);
          return KEEP;
        }
      }
      ret(&mut k.procs, pid, s);
      return KEEP;
    }
    s = s + 1;
  }
  let dl = deadline(k, was, wait);
  if k.ns < dl {
    return wait_until(&mut k, pid, n, dl);
  }
  ret(&mut k.procs, pid, EAGAIN);
  return KEEP;
}

// ---------------------------------------------------------------- calls

fn is_time_call(n: u64) -> bool {
  return n == LX_POLL || n == LX_PPOLL || n == LX_NANOSLEEP || n == LX_CLOCK_NANOSLEEP
    || n == LX_CLOCK_GETTIME || n == LX_CLOCK_GETRES || n == LX_GETTIMEOFDAY || n == LX_TIME
    || n == LX_SELECT || n == LX_PSELECT6 || n == LX_PAUSE || n == LX_ALARM || n == LX_GETITIMER
    || n == LX_SETITIMER || n == LX_RT_SIGTIMEDWAIT;
}

/// System call n of process pid with arguments a, b, c, and `was`, the
/// restart word it came in with.
fn lx_time_call(k: &mut Kernel, pid: u64, n: u64, was: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_POLL {
    // timeout: an int of milliseconds, negative for none.
    let ms = c % 0x100000000;
    let mut wait = FOREVER;
    if ms < 0x80000000 {
      wait = ms * 1000000;
    }
    return lx_poll(&mut k, pid, n, was, a, b, wait);
  }
  if n == LX_PPOLL {
    // ppoll(fds, nfds, tsp, sigmask, size): waits with sigmask blocked.
    let r10 = pget(k.procs, pid, F_REGS + R_R10);
    if was == 0 && r10 != 0 && !mask_swap(&mut k, pid, r10) {
      ret(&mut k.procs, pid, EFAULT);
      return KEEP;
    }
    let pr = lx_ppoll(&mut k, pid, n, was, a, b, c);
    if pr == KEEP {
      mask_back(&mut k, pid);
    }
    return pr;
  }
  if n == LX_PSELECT6 {
    // The sixth argument points at { const sigset_t *ss; size_t len }.
    let r9 = pget(k.procs, pid, F_REGS + R_R9);
    if was == 0 && r9 != 0 {
      if copy_from_user(&mut k.spaces, pid, r9, &mut k.fs.xfer, 8) != 8 {
        ret(&mut k.procs, pid, EFAULT);
        return KEEP;
      }
      let ss = get_u64(k.fs.xfer, 0);
      if ss != 0 && !mask_swap(&mut k, pid, ss) {
        ret(&mut k.procs, pid, EFAULT);
        return KEEP;
      }
    }
    let sr = lx_time_rest(&mut k, pid, n, was, a, b, c);
    if sr == KEEP {
      mask_back(&mut k, pid);
    }
    return sr;
  }
  return lx_time_rest(&mut k, pid, n, was, a, b, c);
}

/// ppoll and pselect6 with a signal mask: like rt_sigsuspend, the call
/// waits with the mask at user address va blocked. The old one is kept in
/// k.sigsave, flagged MASK_SWAPPED, until the call returns (mask_back) or
/// a handler interrupts it (enter_handler puts it in the frame). False if
/// va cannot be read.
fn mask_swap(k: &mut Kernel, pid: u64, va: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if copy_from_user(&mut k.spaces, pid, va, &mut k.fs.xfer, 8) != 8 {
    return false;
  }
  wset(&mut k.sigsave, pid * SIGSAVE_ROW, pget(k.procs, pid, F_SIGMASK) | MASK_SWAPPED);
  pset(&mut k.procs, pid, F_SIGMASK, blockable(get_u64(k.fs.xfer, 0)));
  return true;
}

/// Puts back the mask mask_swap replaced, if it did.
fn mask_back(k: &mut Kernel, pid: u64)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let w = wget(k.sigsave, pid * SIGSAVE_ROW);
  if w & MASK_SWAPPED != 0 {
    pset(&mut k.procs, pid, F_SIGMASK, w & !MASK_SWAPPED);
    wset(&mut k.sigsave, pid * SIGSAVE_ROW, w & !MASK_SWAPPED);
  }
}

/// ppoll's timeout, then lx_poll.
fn lx_ppoll(k: &mut Kernel, pid: u64, n: u64, was: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let mut wait = FOREVER;
  if c != 0 {
    let ts = ts_in(&mut k, pid, c);
    if ts.err != 0 {
      ret(&mut k.procs, pid, ts.err);
      return KEEP;
    }
    wait = ts.ns;
  }
  return lx_poll(&mut k, pid, n, was, a, b, wait);
}

/// The rest of lx_time_call.
fn lx_time_rest(k: &mut Kernel, pid: u64, n: u64, was: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == LX_RT_SIGTIMEDWAIT {
    if pget(k.procs, pid, F_REGS + R_R10) != 8 {
      ret(&mut k.procs, pid, EINVAL);       // the sigset size
      return KEEP;
    }
    return lx_sigtimedwait(&mut k, pid, n, was, a, b, c);
  }
  if n == LX_PAUSE {
    return wait_asleep(&mut k, pid, n, FOREVER);   // until a signal handler runs
  }
  if n == LX_ALARM || n == LX_GETITIMER || n == LX_SETITIMER {
    return lx_itimer(&mut k, pid, n, a, b, c);
  }
  if n == LX_SELECT || n == LX_PSELECT6 {
    // select(nfds, rd, wr, ex, struct timeval *); pselect6 takes a
    // struct timespec * there, and a signal mask after it.
    let ex = pget(k.procs, pid, F_REGS + R_R10);
    let tva = pget(k.procs, pid, F_REGS + R_R8);
    let mut wait = FOREVER;
    if tva != 0 {
      let mut t = Ts { err: 0, ns: 0 };
      if n == LX_SELECT {
        t = tv_in(&mut k, pid, tva);
      } else {
        t = ts_in(&mut k, pid, tva);
      }
      if t.err != 0 {
        ret(&mut k.procs, pid, t.err);
        return KEEP;
      }
      wait = t.ns;
    }
    return lx_select(&mut k, pid, n, was, a % 0x100000000, b, c, ex, wait);
  }
  if n == LX_NANOSLEEP {
    return lx_sleep(&mut k, pid, n, was, 1, 0, a);
  }
  if n == LX_CLOCK_NANOSLEEP {
    return lx_sleep(&mut k, pid, n, was, a, b, c);
  }
  if n == LX_CLOCK_GETTIME || n == LX_CLOCK_GETRES {
    let t = clock_now(k, pid, a);
    if t == FOREVER {
      ret(&mut k.procs, pid, EINVAL);
      return KEEP;
    }
    if b == 0 {
      ret(&mut k.procs, pid, 0);
      return KEEP;
    }
    if n == LX_CLOCK_GETRES {
      let mut res = 1;                      // the clock is kept in ns
      if a == CLOCK_REALTIME_COARSE || a == CLOCK_MONOTONIC_COARSE {
        res = NS_PER_TICK;
      }
      ret(&mut k.procs, pid, time_out(&mut k, pid, b, res, 1));
      return KEEP;
    }
    ret(&mut k.procs, pid, time_out(&mut k, pid, b, t, 1));
    return KEEP;
  }
  if n == LX_GETTIMEOFDAY {
    if a != 0 {
      let r = time_out(&mut k, pid, a, wall_ns(k), 1000);
      if r != 0 {
        ret(&mut k.procs, pid, r);
        return KEEP;
      }
    }
    if b != 0 {
      xfer_u64(&mut k.fs.xfer, 0, 0);       // the time zone: UTC, no daylight saving
      if copy_to_user(&mut k.spaces, pid, b, k.fs.xfer, 8) != 8 {
        ret(&mut k.procs, pid, EFAULT);
        return KEEP;
      }
    }
    ret(&mut k.procs, pid, 0);
    return KEEP;
  }
  // time(tloc)
  let sec = wall_ns(k) / NS_PER_S;
  if a != 0 {
    xfer_u64(&mut k.fs.xfer, 0, sec);
    if copy_to_user(&mut k.spaces, pid, a, k.fs.xfer, 8) != 8 {
      ret(&mut k.procs, pid, EFAULT);
      return KEEP;
    }
  }
  ret(&mut k.procs, pid, sec);
  return KEEP;
}
