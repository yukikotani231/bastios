// An in-memory file system. Files live in physical pages taken from the
// page allocator, one page per 4096 bytes, so a file's pages are owned by
// the file the same way a process's pages are owned by its page tables:
// the proof shows each page is taken from the allocator once and given back
// once, when the file is truncated or removed (or at power off).
//
// The table is a fixed set of NFILES nodes, each free or one file. A node
// can also be a directory: it holds no data, and the files in it are the
// nodes whose names start with its name and a "/" (`fs.bastio` keeps the
// tree well formed). A page a file has never written is a hole and reads
// as zeros, so a write past the end leaves a gap that costs nothing.
//
// Nothing here knows about processes or system calls; `fs.bastio` sits on
// top and moves bytes between files and user memory through a kernel buffer.

import "pages.bastio";
import "core/bytes.bastio";

const NFILES: u64 = 32768;          // more than every descriptor of a process, or a build tree
const FNAME_MAX: u64 = 255;
const FILE_PAGES: u64 = 262144;
const FILE_MAX: u64 = 1073741824;     // FILE_PAGES * 4096 (1 GiB)

enum Slot { Hole, Page(Frame) }

struct RamFile {
  name: Bytes,          // the whole path, such as "notes" or "src/main"
  dir: bool,            // a directory: size 0 and no pages, always
  size: u64,
  pages: Vec[Slot],     // page i holds bytes 4096 * i .. 4096 * (i + 1)
  mode: u64,            // permission bits, such as 0644
  mtime: u64,           // last change, in seconds
  link: u64,            // a hard link: the node it names (and nothing else here is used); NFILES if not
  own: u64,             // the owner: user id + group id * 2^32
}

enum Node { Free, File(RamFile) }

spec fn file_ok(f: &RamFile) -> bool {
  blen(f.name) <= FNAME_MAX && f.size <= FILE_MAX && vlen(f.pages) <= FILE_PAGES
}

/// The table holds up to NFILES slots and grows as nodes are made; a slot
/// past its end is free. Every file in it is well formed.
spec fn nodes_ok(v: &Vec[Node]) -> bool {
  vlen(v) <= NFILES && forall i: u64 :: i < vlen(v) ==> (vget(v, i) is Node::File ==> file_ok(vget(v, i).File))
}

spec fn slot_free(v: &Vec[Node], i: u64) -> bool {
  i >= vlen(v) || vget(v, i) is Node::Free
}

// The name index: an open-addressing hash table over the names of the
// nodes, so ram_find does not walk the table. A slot holds node + 1, 0
// (empty) or TOMB (a removed entry); word RIX counts the TOMBs. It is a
// hint kept by ram_create, ram_reprefix, ram_orphan and ram_remove, the
// only functions that change a node's name; ram_find still compares the
// name of whatever the index offers, so a stale entry costs a wrong
// answer only if one of those four forgets to update it.
const RIX: u64 = 65536;                // twice NFILES: never more than half full
// Word RIX holds the number of TOMBs; word RIX + 1 a hint for ram_create:
// every node below it is in use (ram_remove lowers it, ram_create raises it).
// Words KBASE.. count, per hash of a directory name, the nodes whose names
// lie under such a directory (see kid_add): a count of 0 means the walk for
// children can be skipped.
// Word RIX + 2 counts the nodes that are hard links, so the walks that look
// for them (ram_link_to, ram_links) can be skipped while there are none.
const TOMB: u64 = 18446744073709551615;
const KBASE: u64 = RIX + 3;
const KB: u64 = 32768;                 // buckets of the ancestor counts

spec fn rix_ok(r: &Buf) -> bool {
  len(r) == KBASE + KB
}

/// The hash of name[from .. from + n].
fn name_hash(b: &Bytes, from: u64, n: u64) -> u64
  requires from + n <= blen(b)
  ensures result < 4294967296
{
  let mut h = 5381;
  let mut j = 0;
  while j < n
    invariant j <= n && h < 4294967296
  {
    h = (h * 33 + cast[u64](bget(b, from + j))) % 4294967296;
    j = j + 1;
  }
  return h;
}

/// Adds d (up) or takes it from (down) the count of every directory
/// that the name of n bytes lies under: for each "/" at j > 0, the bucket
/// of the hash of name[0 .. j]. A hint for ram_has_under, never read by
/// anything that decides on its own.
fn kid_adj(r: &mut Buf, name: &Bytes, n: u64, up: bool)
  requires rix_ok(r) && n <= blen(name)
  ensures rix_ok(r)
{
  let mut h = 5381;
  let mut j = 0;
  while j < n
    invariant j <= n && h < 4294967296 && rix_ok(r)
  {
    let c = cast[u64](bget(name, j));
    if c == 47 && j > 0 {
      let at = KBASE + h % KB;
      let cnt = get(r, at);
      if up {
        if cnt < NFILES {
          r = set(r, at, cnt + 1);
        }
      } else if cnt > 0 {
        r = set(r, at, cnt - 1);
      }
    }
    h = (h * 33 + c) % 4294967296;
    j = j + 1;
  }
}

/// Could a node lie under the directory named by the first n bytes of
/// `name`? False means certainly not.
fn ram_has_under(r: &Buf, name: &Bytes, n: u64) -> bool
  requires rix_ok(r) && n <= blen(name)
{
  return get(r, KBASE + name_hash(name, 0, n) % KB) > 0;
}

/// Enters node `node` under hash h.
fn rix_put(r: &mut Buf, h: u64, node: u64)
  requires rix_ok(r) && node < NFILES
  ensures rix_ok(r)
{
  let mut s = h % RIX;
  let mut i = 0;
  while i < RIX
    invariant i <= RIX && s < RIX && rix_ok(r)
  {
    let e = get(r, s);
    if e == 0 || e == TOMB {
      if e == TOMB && get(r, RIX) > 0 {
        r = set(r, RIX, get(r, RIX) - 1);
      }
      r = set(r, s, node + 1);
      return;
    }
    s = (s + 1) % RIX;
    i = i + 1;
  }
}

/// Removes node `node`, entered under hash h.
fn rix_del(r: &mut Buf, h: u64, node: u64)
  requires rix_ok(r) && node < NFILES
  ensures rix_ok(r)
{
  let mut s = h % RIX;
  let mut i = 0;
  while i < RIX
    invariant i <= RIX && s < RIX && rix_ok(r)
  {
    let e = get(r, s);
    if e == 0 {
      return;
    }
    if e == node + 1 {
      r = set(r, s, TOMB);
      if get(r, RIX) < RIX {
        r = set(r, RIX, get(r, RIX) + 1);
      }
      return;
    }
    s = (s + 1) % RIX;
    i = i + 1;
  }
}

/// Builds the index again from the names: when TOMBs have taken too many
/// of the slots.
fn rix_rebuild(v: &mut Vec[Node], r: &mut Buf)
  requires nodes_ok(v) && rix_ok(r)
  ensures nodes_ok(v) && rix_ok(r)
{
  let mut z = 0;
  while z <= RIX
    invariant z <= RIX + 1 && rix_ok(r)
  {
    r = set(r, z, 0);
    z = z + 1;
  }
  let mut i = 0;
  while i < NFILES
    invariant i <= NFILES && nodes_ok(v) && rix_ok(r)
  {
    match take_node(&mut v, i) {
      Node::Free => {},
      Node::File(f) => {
        let n = blen(f.name);
        if n > 0 {
          rix_put(&mut r, name_hash(f.name, 0, n), i);
        }
        put_node(&mut v, i, Node::File(f));
      },
    }
    i = i + 1;
  }
}

/// Rebuilds the index if TOMBs fill more than a quarter of it.
fn rix_tidy(v: &mut Vec[Node], r: &mut Buf)
  requires nodes_ok(v) && rix_ok(r)
  ensures nodes_ok(v) && rix_ok(r)
{
  if get(r, RIX) > RIX / 4 {
    rix_rebuild(&mut v, &mut r);
  }
}

fn ram_new() -> Vec[Node]
  ensures nodes_ok(result)
{
  return vec_new[Node]();
}

/// Takes node `i` out, leaving its slot free.
fn take_node(v: &mut Vec[Node], i: u64) -> Node
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v) && slot_free(v, i)
  ensures result is Node::File ==> file_ok(result.File)
{
  if i >= vec_len(v) {
    return Node::Free;
  }
  return vec_swap(&mut v, i, Node::Free);
}

/// Puts a node into a free slot.
fn put_node(v: &mut Vec[Node], i: u64, x: Node)
  requires nodes_ok(v) && i < NFILES && slot_free(v, i)
  requires x is Node::File ==> file_ok(x.File)
  ensures nodes_ok(v)
{
  while vec_len(v) <= i
    invariant nodes_ok(v) && i < NFILES && slot_free(v, i)
  {
    vec_push(&mut v, Node::Free);
  }
  assert vget(v, i) is Node::Free;
  match vec_swap(&mut v, i, x) {
    Node::Free => {},
    Node::File(_f) => { unreachable; },     // the slot was free
  }
}

// ---------------------------------------------------------------- one file

/// Do the first n bytes of `name` spell the file's name?
fn name_is(f: &RamFile, name: &Bytes, n: u64) -> bool
  requires n <= blen(name)
{
  if blen(f.name) != n {
    return false;
  }
  return bytes_span_eq(f.name, 0, name, 0, n);
}

/// Writes m zeros into buf from `at`.
fn zero_fill(buf: &mut Bytes, at: u64, m: u64)
  requires at + m <= blen(buf)
  ensures blen(buf) == old(blen(buf))
{
  let l = blen(buf);
  let mut j = 0;
  while j < m
    invariant j <= m && blen(buf) == l
  {
    bset(&mut buf, at + j, 0);
    j = j + 1;
  }
}

/// Copies m bytes of page p of the file, starting at byte `from` of the
/// page, into buf at `at`. A hole reads as zeros.
fn read_chunk(f: &mut RamFile, p: u64, from: u64, buf: &mut Bytes, at: u64, m: u64)
  requires file_ok(f) && from + m <= 4096 && at + m <= blen(buf)
  ensures file_ok(f) && blen(buf) == old(blen(buf))
{
  if p >= vec_len(f.pages) {
    zero_fill(&mut buf, at, m);
    return;
  }
  match vec_swap(&mut f.pages, p, Slot::Hole) {
    Slot::Hole => { zero_fill(&mut buf, at, m); },
    Slot::Page(fr) => {
      frame_to_bytes(&mut buf, at, fr, from, m);
      match vec_swap(&mut f.pages, p, Slot::Page(fr)) {
        Slot::Hole => {},
        Slot::Page(_x) => { unreachable; },
      }
    },
  }
}

/// How many of the `left` bytes wanted from offset `a` lie on a's page.
fn page_chunk(a: u64, left: u64) -> u64
  ensures result <= left && a % 4096 + result <= 4096
  ensures left > 0 ==> result > 0
{
  let room = 4096 - a % 4096;
  if room < left {
    return room;
  }
  return left;
}

/// Reads up to n bytes from offset `off` into the start of buf. Returns the
/// count, which is short at the end of the file.
fn file_read(f: &mut RamFile, off: u64, buf: &mut Bytes, n: u64) -> u64
  requires file_ok(f) && n <= blen(buf)
  ensures file_ok(f) && blen(buf) == old(blen(buf))
  ensures result <= n
{
  if off >= f.size {
    return 0;
  }
  let mut want = f.size - off;
  if want > n {
    want = n;
  }
  let l = blen(buf);
  let mut k = 0;
  while k < want
    invariant k <= want && want <= n && n <= blen(buf) && file_ok(f) && blen(buf) == l
  {
    let a = off + k;
    let m = page_chunk(a, want - k);
    read_chunk(&mut f, a / 4096, a % 4096, &mut buf, k, m);
    k = k + m;
  }
  return want;
}

/// Copies m bytes of buf from `at` into fr at byte `from`.
fn frame_fill(fr: &mut Frame, from: u64, buf: &Bytes, at: u64, m: u64)
  requires from + m <= 4096 && at + m <= blen(buf)
{
  bytes_to_frame(&mut fr, from, buf, at, m);
}

/// Puts a frame back as page p, whose slot is a hole.
fn put_page(pages: &mut Vec[Slot], p: u64, fr: Frame)
  requires p < vlen(pages) && vget(pages, p) is Slot::Hole
  ensures vlen(pages) == old(vlen(pages))
{
  match vec_swap(&mut pages, p, Slot::Page(fr)) {
    Slot::Hole => {},
    Slot::Page(_x) => { unreachable; },
  }
}

/// Copies m bytes of buf from `at` into page p of the file at byte `from`,
/// giving the page a frame first if it is a hole. Returns false, changing
/// nothing, when no page is free.
fn write_chunk(f: &mut RamFile, mem: &mut Mem, p: u64, from: u64, buf: &Bytes, at: u64, m: u64) -> bool
  requires file_ok(f) && mem_ok(mem) && p < vlen(f.pages) && from + m <= 4096 && at + m <= blen(buf)
  ensures file_ok(f) && mem_ok(mem) && vlen(f.pages) == old(vlen(f.pages))
{
  match vec_swap(&mut f.pages, p, Slot::Hole) {
    Slot::Hole => {
      let i = find_free(&mut mem);
      if i >= NPAGES {
        return false;
      }
      let mut fr = take_page(&mut mem, i);
      frame_fill(&mut fr, from, buf, at, m);
      put_page(&mut f.pages, p, fr);
    },
    Slot::Page(x) => {
      let mut fr = x;
      frame_fill(&mut fr, from, buf, at, m);
      put_page(&mut f.pages, p, fr);
    },
  }
  return true;
}

/// Writes the first n bytes of buf at offset `off`, growing the file as
/// needed. Returns the count, which is short when the file reaches
/// FILE_MAX or memory runs out.
fn file_write(f: &mut RamFile, mem: &mut Mem, off: u64, buf: &Bytes, n: u64) -> u64
  requires file_ok(f) && mem_ok(mem) && n <= blen(buf)
  ensures file_ok(f) && mem_ok(mem)
  ensures result <= n
{
  if off >= FILE_MAX {
    return 0;
  }
  let mut want = FILE_MAX - off;
  if want > n {
    want = n;
  }
  let mut k = 0;
  let mut ok = true;
  while ok && k < want
    invariant k <= want && want <= n && off + want <= FILE_MAX && file_ok(f) && mem_ok(mem)
  {
    let a = off + k;
    let p = a / 4096;
    while vec_len(f.pages) <= p
      invariant file_ok(f) && p < FILE_PAGES
    {
      vec_push(&mut f.pages, Slot::Hole);
    }
    let m = page_chunk(a, want - k);
    if write_chunk(&mut f, &mut mem, p, a % 4096, buf, k, m) {
      k = k + m;
      if a + m > f.size {
        f.size = a + m;
      }
    } else {
      ok = false;
    }
  }
  return k;
}

/// Gives every page of the file back and makes it empty.
fn file_truncate(f: &mut RamFile, mem: &mut Mem)
  requires file_ok(f) && mem_ok(mem)
  ensures file_ok(f) && mem_ok(mem) && vlen(f.pages) == 0 && f.size == 0
{
  while vec_len(f.pages) > 0
    invariant file_ok(f) && mem_ok(mem)
  {
    match vec_pop(&mut f.pages) {
      Slot::Hole => {},
      Slot::Page(fr) => { give_page(&mut mem, fr); },
    }
  }
  f.size = 0;
}

/// Sets the file's size to size_to bytes: growing reads as zeros, shrinking
/// gives back the pages past the end and zeroes the tail of the last one
/// kept (bytes past the end are always zeros, which growing relies on).
/// False, changing nothing, for a directory or past FILE_MAX.
fn file_resize(f: &mut RamFile, mem: &mut Mem, size_to: u64) -> bool
  requires file_ok(f) && mem_ok(mem)
  ensures file_ok(f) && mem_ok(mem)
{
  if f.dir || size_to > FILE_MAX {
    return false;
  }
  if size_to < f.size {
    let keep = (size_to + 4095) / 4096;
    while vec_len(f.pages) > keep
      invariant file_ok(f) && mem_ok(mem)
    {
      match vec_pop(&mut f.pages) {
        Slot::Hole => {},
        Slot::Page(fr) => { give_page(&mut mem, fr); },
      }
    }
    let p = size_to / 4096;
    if size_to % 4096 != 0 && p < vec_len(f.pages) {
      match vec_swap(&mut f.pages, p, Slot::Hole) {
        Slot::Hole => {},
        Slot::Page(x) => {
          let mut fr = x;
          let mut j = size_to % 4096;
          while j < 4096 {
            frame_write8(&mut fr, j, 0);
            j = j + 1;
          }
          put_page(&mut f.pages, p, fr);
        },
      }
    }
  }
  f.size = size_to;
  return true;
}

/// Frees a file: its pages go back to the allocator.
fn file_free(f: RamFile, mem: &mut Mem)
  requires file_ok(f) && mem_ok(mem)
  ensures mem_ok(mem)
{
  let mut g = f;
  file_truncate(&mut g, &mut mem);
  vec_free(g.pages);
  bfree(g.name);
}

/// Gives every page in `pages` back.
fn slots_free(pages: Vec[Slot], mem: &mut Mem)
  requires mem_ok(mem)
  ensures mem_ok(mem)
{
  let mut g = pages;
  while vec_len(g) > 0
    invariant mem_ok(mem)
  {
    match vec_pop(&mut g) {
      Slot::Hole => {},
      Slot::Page(fr) => { give_page(&mut mem, fr); },
    }
  }
  vec_free(g);
}

/// Takes node i's pages out (for a loop mount, src/fs.bastio), leaving it
/// none: nothing for a free node or a directory.
fn ram_take_pages(v: &mut Vec[Node], i: u64) -> Vec[Slot]
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v) && vlen(result) <= FILE_PAGES
{
  let mut pages = vec_new[Slot]();
  match take_node(&mut v, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      let p = g.pages;
      g.pages = pages;
      pages = p;
      put_node(&mut v, i, Node::File(g));
    },
  }
  return pages;
}

/// Puts `pages` back as node i's (any it has now go back to the
/// allocator); they go to the allocator instead if node i is free, a
/// directory, or the pages are too many for a file.
fn ram_put_pages(v: &mut Vec[Node], mem: &mut Mem, i: u64, pages: Vec[Slot])
  requires nodes_ok(v) && mem_ok(mem) && i < NFILES
  ensures nodes_ok(v) && mem_ok(mem)
{
  match take_node(&mut v, i) {
    Node::Free => {
      slots_free(pages, &mut mem);
    },
    Node::File(f) => {
      let mut g = f;
      if g.dir || vec_len(pages) > FILE_PAGES {
        slots_free(pages, &mut mem);
      } else {
        let p = g.pages;
        g.pages = pages;
        slots_free(p, &mut mem);
      }
      put_node(&mut v, i, Node::File(g));
    },
  }
}

// ---------------------------------------------------------------- the table

/// What a free node's size reads as.
const NO_FILE: u64 = 18446744073709551615;

struct FMeta { ok: bool, mode: u64, mtime: u64, own: u64 }

// The functions below read a node where it lies in the table (`vec_with`),
// rather than taking it out and putting it back.

/// Is the node a file named by the first n bytes of `name`?
fn node_named(nd: &Node, name: &Bytes, n: u64) -> bool
  requires n <= blen(name)
{
  match nd {
    Node::Free => { return false; },
    Node::File(f) => { return name_is(f, name, n); },
  }
}

/// The size of the file in the node, or NO_FILE if it is free.
fn node_size(nd: &Node) -> u64 {
  match nd {
    Node::Free => { return NO_FILE; },
    Node::File(f) => { return f.size; },
  }
}

fn node_is_dir(nd: &Node) -> bool {
  match nd {
    Node::Free => { return false; },
    Node::File(f) => { return f.dir; },
  }
}

/// The length of the node's name, or NO_FILE if it is free.
fn node_len(nd: &Node) -> u64 {
  match nd {
    Node::Free => { return NO_FILE; },
    Node::File(f) => { return blen(f.name); },
  }
}

/// Is the node inside the directory named by the first n bytes of `name`?
fn node_under(nd: &Node, name: &Bytes, n: u64) -> bool
  requires n <= blen(name)
{
  match nd {
    Node::Free => { return false; },
    Node::File(f) => {
      let mut hit = false;
      if blen(f.name) > n + 1 && bget(f.name, n) == 47 {
        hit = true;
        let mut j = 0;
        while j < n
          invariant j <= n && n < blen(f.name)
        {
          if bget(f.name, j) != bget(name, j) {
            hit = false;
          }
          j = j + 1;
        }
      }
      return hit;
    },
  }
}

/// Copies the node's name into the start of buf and returns its length, or
/// NO_FILE if the node is free or buf is too short.
fn node_name_into(nd: &Node, buf: &mut Bytes) -> u64
  ensures blen(buf) == old(blen(buf))
  ensures result <= blen(buf) || result == NO_FILE
{
  match nd {
    Node::Free => { return NO_FILE; },
    Node::File(f) => {
      let n = blen(f.name);
      if n > blen(buf) {
        return NO_FILE;
      }
      let l = blen(buf);
      let mut j = 0;
      while j < n
        invariant j <= n && n <= blen(buf) && blen(buf) == l
      {
        bset(&mut buf, j, bget(f.name, j));
        j = j + 1;
      }
      return n;
    },
  }
}

/// The node that this node is a hard link to, or NFILES.
fn node_link_of(nd: &Node) -> u64
  ensures result <= NFILES
{
  match nd {
    Node::Free => { return NFILES; },
    Node::File(f) => {
      if f.link < NFILES {
        return f.link;
      }
      return NFILES;
    },
  }
}

fn node_meta(nd: &Node) -> FMeta {
  match nd {
    Node::Free => { return FMeta { ok: false, mode: 0, mtime: 0, own: 0 }; },
    Node::File(f) => { return FMeta { ok: true, mode: f.mode, mtime: f.mtime, own: f.own }; },
  }
}

/// The node holding the file named by the first n bytes of `name`, or
/// NFILES if there is none. Only nodes below `hi` are looked at: the
/// caller's high-water mark of the nodes ever created (Vfs.rhi).
fn ram_find(v: &mut Vec[Node], r: &Buf, hi: u64, name: &Bytes, n: u64) -> u64
  requires nodes_ok(v) && rix_ok(r) && hi <= NFILES && n <= blen(name)
  ensures nodes_ok(v) && result <= NFILES
{
  if n == 0 {
    return NFILES;              // no file is named "" (orphans are, see ram_orphan)
  }
  let mut s = name_hash(name, 0, n) % RIX;
  let mut k = 0;
  while k < RIX
    invariant k <= RIX && s < RIX && nodes_ok(v) && rix_ok(r)
  {
    let e = get(r, s);
    if e == 0 {
      return NFILES;
    }
    if e != TOMB && e - 1 < hi {
      let i = e - 1;
      if i < vec_len(v) && vec_with(v, i, node_named, name, n) {
        return i;
      }
    }
    s = (s + 1) % RIX;
    k = k + 1;
  }
  return NFILES;
}

/// Creates an empty file (or directory) named by the first n bytes of
/// `name` (1 to FNAME_MAX of them) in a free node. Returns the node, or
/// NFILES if the name is too long or the table is full.
fn ram_create(v: &mut Vec[Node], r: &mut Buf, name: &Bytes, n: u64, dir: bool, now: u64) -> u64
  requires nodes_ok(v) && rix_ok(r) && n <= blen(name)
  ensures nodes_ok(v) && rix_ok(r) && result <= NFILES
{
  if n == 0 || n > FNAME_MAX {
    return NFILES;
  }
  let mut mode = 420;                   // 0644
  if dir {
    mode = 493;                         // 0755
  }
  let mut i = get(r, RIX + 1);
  if i > NFILES {
    i = 0;
  }
  while i < NFILES
    invariant i <= NFILES && nodes_ok(v) && rix_ok(r)
  {
    match take_node(&mut v, i) {
      Node::Free => {
        // The table grows by doubling; if the kernel's heap has no room
        // for that, the table counts as full instead of halting the kernel.
        if i >= vec_len(v) && !vec_try_reserve(&mut v, i + 1 - vec_len(v)) {
          return NFILES;
        }
        let mut nm = balloc(n);
        let mut j = 0;
        while j < n
          invariant j <= n && blen(nm) == n
        {
          bset(&mut nm, j, bget(name, j));
          j = j + 1;
        }
        put_node(&mut v, i, Node::File(RamFile { name: nm, dir: dir, size: 0, pages: vec_new[Slot](), mode: mode, mtime: now, link: NFILES, own: 0 }));
        rix_put(&mut r, name_hash(name, 0, n), i);
        kid_adj(&mut r, name, n, true);
        r = set(r, RIX + 1, i + 1);
        return i;
      },
      Node::File(f) => { put_node(&mut v, i, Node::File(f)); },
    }
    i = i + 1;
  }
  return NFILES;
}

/// The size of the file in node i, or NO_FILE if the node is free.
fn ram_size(v: &mut Vec[Node], i: u64) -> u64
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v)
{
  if i >= vec_len(v) {
    return NO_FILE;
  }
  return vec_with(v, i, node_size);
}

/// Is node i a directory?
fn ram_is_dir(v: &mut Vec[Node], i: u64) -> bool
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v)
{
  if i >= vec_len(v) {
    return false;
  }
  return vec_with(v, i, node_is_dir);
}

/// Is node i inside the directory named by the first n bytes of `name`
/// (its name is that, a "/", and at least one more byte)?
fn ram_under(v: &mut Vec[Node], i: u64, name: &Bytes, n: u64) -> bool
  requires nodes_ok(v) && i < NFILES && n <= blen(name)
  ensures nodes_ok(v)
{
  if i >= vec_len(v) {
    return false;
  }
  return vec_with(v, i, node_under, name, n);
}

/// Copies the name of the file in node i into the start of buf. Returns its
/// length, or NO_FILE if the node is free or buf is too short.
fn ram_name(v: &mut Vec[Node], i: u64, buf: &mut Bytes) -> u64
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v) && blen(buf) == old(blen(buf))
  ensures result <= blen(buf) || result == NO_FILE
{
  if i >= vec_len(v) {
    return NO_FILE;
  }
  return vec_with(v, i, node_name_into, &mut buf);
}

/// The length of node i's name, or NO_FILE if the node is free.
fn ram_len(v: &mut Vec[Node], i: u64) -> u64
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v)
{
  if i >= vec_len(v) {
    return NO_FILE;
  }
  return vec_with(v, i, node_len);
}

/// Renames node i: its name becomes the first nl bytes of `new` followed
/// by what came after the first `cut` bytes of its old name. Returns false,
/// changing nothing, if the node is free, its name is shorter than `cut`,
/// or the new name would be empty or longer than FNAME_MAX.
fn ram_reprefix(v: &mut Vec[Node], r: &mut Buf, i: u64, cut: u64, new: &Bytes, nl: u64) -> bool
  requires nodes_ok(v) && rix_ok(r) && i < NFILES && nl <= blen(new)
  ensures nodes_ok(v) && rix_ok(r)
{
  let mut ok = false;
  match take_node(&mut v, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      let ol = blen(g.name);
      if cut <= ol && nl <= FNAME_MAX && ol - cut <= FNAME_MAX - nl && nl + (ol - cut) > 0 {
        let total = nl + (ol - cut);
        let mut nm = balloc(total);
        let mut j = 0;
        while j < nl
          invariant j <= nl && blen(nm) == total
        {
          bset(&mut nm, j, bget(new, j));
          j = j + 1;
        }
        let mut k = 0;
        while k < ol - cut
          invariant k <= ol - cut && blen(nm) == total && cut <= ol && ol == blen(g.name)
        {
          bset(&mut nm, nl + k, bget(g.name, cut + k));
          k = k + 1;
        }
        let old_name = g.name;
        if ol > 0 {
          rix_del(&mut r, name_hash(old_name, 0, ol), i);
          kid_adj(&mut r, old_name, ol, false);
        }
        rix_put(&mut r, name_hash(nm, 0, total), i);
        kid_adj(&mut r, nm, total, true);
        g.name = nm;
        bfree(old_name);
        ok = true;
      }
      put_node(&mut v, i, Node::File(g));
    },
  }
  rix_tidy(&mut v, &mut r);
  return ok;
}

/// A node's permission bits, modification time (seconds) and owner (user
/// id + group id * 2^32).

/// Node i's mode and modification time; ok is false if the node is free.
fn ram_meta(v: &mut Vec[Node], i: u64) -> FMeta
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v)
{
  if i >= vec_len(v) {
    return FMeta { ok: false, mode: 0, mtime: 0, own: 0 };
  }
  return vec_with(v, i, node_meta);
}

/// Sets node i's mode (when `mode` is below 65536) and its modification
/// time (when `mtime` is not NO_FILE). False if the node is free.
fn ram_set_meta(v: &mut Vec[Node], i: u64, mode: u64, mtime: u64) -> bool
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v)
{
  let mut ok = false;
  match take_node(&mut v, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      if mode < 65536 {
        g.mode = mode;
      }
      if mtime != NO_FILE {
        g.mtime = mtime;
      }
      put_node(&mut v, i, Node::File(g));
      ok = true;
    },
  }
  return ok;
}

/// Sets node i's owner (user id + group id * 2^32). False if the node is
/// free.
fn ram_set_owner(v: &mut Vec[Node], i: u64, own: u64) -> bool
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v)
{
  let mut ok = false;
  match take_node(&mut v, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      g.own = own;
      put_node(&mut v, i, Node::File(g));
      ok = true;
    },
  }
  return ok;
}

/// Takes node i's name away but keeps its data: a file removed while it
/// is open, which fs.bastio frees at the last close. No name matches it,
/// lists show it as unused, and no directory holds it.
fn ram_orphan(v: &mut Vec[Node], r: &mut Buf, i: u64)
  requires nodes_ok(v) && rix_ok(r) && i < NFILES
  ensures nodes_ok(v) && rix_ok(r)
{
  match take_node(&mut v, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      let old_name = g.name;
      let ol = blen(old_name);
      if ol > 0 {
        rix_del(&mut r, name_hash(old_name, 0, ol), i);
        kid_adj(&mut r, old_name, ol, false);
      }
      g.name = balloc(0);
      bfree(old_name);
      put_node(&mut v, i, Node::File(g));
    },
  }
  rix_tidy(&mut v, &mut r);
}

/// Removes the file in node i, if there is one.
fn ram_remove(v: &mut Vec[Node], r: &mut Buf, mem: &mut Mem, i: u64)
  requires nodes_ok(v) && rix_ok(r) && mem_ok(mem) && i < NFILES
  ensures nodes_ok(v) && rix_ok(r) && mem_ok(mem)
{
  match take_node(&mut v, i) {
    Node::Free => {},
    Node::File(f) => {
      let ol = blen(f.name);
      if ol > 0 {
        rix_del(&mut r, name_hash(f.name, 0, ol), i);
        kid_adj(&mut r, f.name, ol, false);
      }
      if f.link < NFILES && get(r, RIX + 2) > 0 {
        r = set(r, RIX + 2, get(r, RIX + 2) - 1);
      }
      file_free(f, &mut mem);
      if i < get(r, RIX + 1) {
        r = set(r, RIX + 1, i);
      }
    },
  }
  rix_tidy(&mut v, &mut r);
}

/// Frees the whole table (at power off).
fn ram_free(v: Vec[Node], mem: &mut Mem)
  requires nodes_ok(v) && mem_ok(mem)
  ensures mem_ok(mem)
{
  let mut t = v;
  while vec_len(t) > 0
    invariant mem_ok(mem)
    invariant forall j: u64 :: j < vlen(t) ==> (vget(t, j) is Node::File ==> file_ok(vget(t, j).File))
  {
    match vec_pop(&mut t) {
      Node::Free => {},
      Node::File(f) => { file_free(f, &mut mem); },
    }
  }
  vec_free(t);
}

// ---------------------------------------------------------------- hard links

/// The node that node i is a hard link to, or NFILES if it is not one
/// (or is free).
fn ram_link_of(v: &mut Vec[Node], i: u64) -> u64
  requires nodes_ok(v) && i < NFILES
  ensures nodes_ok(v) && result <= NFILES
{
  if i >= vec_len(v) {
    return NFILES;
  }
  return vec_with(v, i, node_link_of);
}

/// Creates a hard link named by the first n bytes of `name` to node t (a
/// file, not a link: the caller checks). Returns the new node or NFILES.
fn ram_link(v: &mut Vec[Node], r: &mut Buf, name: &Bytes, n: u64, t: u64, now: u64) -> u64
  requires nodes_ok(v) && rix_ok(r) && n <= blen(name) && t < NFILES
  ensures nodes_ok(v) && rix_ok(r) && result <= NFILES
{
  let i = ram_create(&mut v, &mut r, name, n, false, now);
  if i >= NFILES {
    return NFILES;
  }
  match take_node(&mut v, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      g.link = t;
      put_node(&mut v, i, Node::File(g));
      if get(r, RIX + 2) < NFILES {
        r = set(r, RIX + 2, get(r, RIX + 2) + 1);
      }
    },
  }
  return i;
}

/// A node that is a hard link to node t, or NFILES if there is none.
fn ram_link_to(v: &mut Vec[Node], t: u64) -> u64
  requires nodes_ok(v)
  ensures nodes_ok(v) && result <= NFILES
{
  let mut i = 0;
  while i < NFILES
    invariant i <= NFILES && nodes_ok(v)
  {
    if ram_link_of(&mut v, i) == t {
      return i;
    }
    i = i + 1;
  }
  return NFILES;
}

/// How many hard links name node t, besides its own name.
fn ram_links(v: &mut Vec[Node], t: u64) -> u64
  requires nodes_ok(v)
  ensures nodes_ok(v) && result <= NFILES
{
  let mut c = 0;
  let mut i = 0;
  while i < NFILES
    invariant i <= NFILES && c <= i && nodes_ok(v)
  {
    if ram_link_of(&mut v, i) == t {
      c = c + 1;
    }
    i = i + 1;
  }
  return c;
}

/// Does any node name another as a hard link?
fn ram_has_links(r: &Buf) -> bool
  requires rix_ok(r)
{
  return get(r, RIX + 2) > 0;
}
