// The file layer between system calls and file systems. It owns the table
// of open files and a kernel buffer that every transfer goes through:
// system calls copy user memory into the buffer or out of it
// (`usermem.bastio`), and the file systems below only ever see the buffer.
//
// There are two file systems: the in-memory one (`ramfs.bastio`) and the
// one on the ATA disk (`diskfs.bastio`). Names that start with "disk/" are
// on the disk; every other name is in memory. A second disk file system,
// on a disk image in a loop device (src/lxloop.bastio), can be mounted on
// an in-memory directory: names below that directory are in it (v.lo).
//
// Directories: a name is a path, and both file systems can hold directory
// nodes. A file "a/b" can only be created while the directory "a" exists,
// and a directory can only be removed while nothing is in it, so every
// parent of a file exists. "disk" itself is the disk's top directory; it
// is not a node, and no file in memory may take its name. Each open file records which
// file system it is on (FD_FS), and the few functions below dispatch on it;
// nothing above this file knows there are two.
//
// The table has NFD rows per process; a process names its files by row
// number (its file descriptor), so one process can never reach another's.

import "pages.bastio";
import "ramfs.bastio";
import "diskfs.bastio";
import "pcache.bastio";

const NFD: u64 = 16;                  // open files per process
const FD_ROWS: u64 = 512;             // NPROC * NFD
const FD_STRIDE: u64 = 4;
const FTAB_LEN: u64 = 2048;           // FD_ROWS * FD_STRIDE
const XFER: u64 = 4096;               // the most bytes one call moves

// Row fields.
const FD_FS: u64 = 0;                 // 0: row unused; otherwise the file system
const FD_NODE: u64 = 1;               // the file within its file system
const FD_OFF: u64 = 2;                // the offset the next read or write uses
const FD_MODE: u64 = 3;               // O_READ | O_WRITE | O_APPEND

const FS_RAM: u64 = 1;
const FS_DISK: u64 = 2;
const FS_LO: u64 = 3;                 // the disk image mounted on a loop device
const DISK_PREFIX: u64 = 5;           // "disk/"

// Open flags (the system call ABI).
const O_READ: u64 = 1;
const O_WRITE: u64 = 2;
const O_CREATE: u64 = 4;
const O_TRUNC: u64 = 8;
const O_APPEND: u64 = 16;

const NO_FD: u64 = 18446744073709551615;
const VFS_MISS: u64 = 18446744073709551614;     // the disk has not caught up: sleep, then try again

// File handles: in-memory nodes, then the disk's entries, then those of
// the loop mount. Directory handles besides the nodes (vfs_dir_lookup,
// vfs_readdir) come after them.
const LO0: u64 = NFILES + DSLOTS;     // the loop mount's entry e is LO0 + e
const HFILES: u64 = NFILES + 2 * DSLOTS;   // every file handle is below this
const VDIR_ROOT: u64 = NFILES + 2 * DSLOTS;  // the top directory
const VDIR_DISK: u64 = NFILES + 2 * DSLOTS + 1;  // "disk"
const VDIR_LO: u64 = NFILES + 2 * DSLOTS + 2;    // the loop mount's top directory
const NAMEBUF: u64 = 256;             // holds any in-memory node's name
const MNT_N: u64 = 8;                 // tmpfs mounts at once
const MNT_LEN: u64 = 16;              // MNT_N * 2: per mount, its directory node + 1 (0: free) and 1 if read-only

struct Vfs {
  ram: Vec[Node],       // the in-memory file system
  ftab: Buf,            // open files: FD_ROWS rows of FD_STRIDE words
  xfer: Bytes,          // the transfer buffer
  disk: DiskFs,         // the file system on the disk
  name: Bytes,          // a directory's name, while vfs_readdir lists it
  mnt: Buf,             // tmpfs mounts on in-memory directories (src/lxmount.bastio)
  now: u64,             // the time, in seconds, for modification times
  lo: DiskFs,           // the file system on a loop device's image (no blocks: none mounted)
  lname: Bytes,         // the loop mount's directory name, while a call routes a path
  lo_at: u64,           // the in-memory directory the loop mount is on, + 1 (0: none)
  lo_file: u64,         // the in-memory file whose pages the loop mount holds
  lo_size: u64,         // that file's size at the mount
  lo_dev: u64,          // the loop device's number
  lo_ro: bool,          // mounted read-only
  pc: PCache,           // file pages that MAP_SHARED mappings share (src/pcache.bastio)
}

spec fn vfs_ok(v: &Vfs) -> bool {
  nodes_ok(v.ram) && len(v.ftab) == FTAB_LEN && blen(v.xfer) == XFER && disk_ok(v.disk) && blen(v.name) == NAMEBUF && len(v.mnt) == MNT_LEN
    && disk_ok(v.lo) && blen(v.lname) == NAMEBUF && pc_ok(v.pc)
}

fn vfs_new(disk: DiskFs) -> Vfs
  requires disk_ok(disk)
  ensures vfs_ok(result)
{
  return Vfs { ram: ram_new(), ftab: alloc(FTAB_LEN), xfer: balloc(XFER), disk: disk, name: balloc(NAMEBUF), mnt: alloc(MNT_LEN), now: 0,
    lo: disk_mount(Blk::Loop(loopdev_new(vec_new[Slot](), 0))), lname: balloc(NAMEBUF), lo_at: 0, lo_file: NFILES, lo_size: 0, lo_dev: 0, lo_ro: false, pc: pc_new() };
}

/// The next byte typed on a USB keyboard that sits on the disk's xHCI
/// controller (see blk_find), or 256.
fn vfs_kbd_poll(v: &mut Vfs) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v) && result <= 256
{
  return blk_kbd_poll(&mut v.disk.dev);
}

/// Frees everything (at power off): every in-memory file's pages go back
/// (a loop mount's too), and the disk driver is handed back so its ports
/// can be released.
fn vfs_free(v: Vfs, mem: &mut Mem, ports: &mut Ports, win: &mut MmioSpace) -> Blk
  requires vfs_ok(v) && mem_ok(mem)
  ensures mem_ok(mem) && blk_ok(result)
{
  ram_free(v.ram, &mut mem);
  free(v.ftab);
  bfree(v.xfer);
  bfree(v.name);
  bfree(v.lname);
  free(v.mnt);
  blk_free(&mut ports, &mut win, disk_unmount(v.lo), &mut mem);
  pc_free(v.pc, &mut mem);
  return disk_unmount(v.disk);
}

/// Puts a loop driver over `pages` (an image of size bytes) in as the
/// loop mount's and returns the pages of the one it replaces, setting
/// v.lo_size to size. Only loop drivers are ever put there; were it any
/// other, it would stay, and `pages` would come back with v.lo_size as it
/// was.
fn lo_swap(v: &mut Vfs, pages: Vec[Slot], size: u64) -> Vec[Slot]
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  match disk_unmount(v.lo) {
    Blk::Loop(l) => {
      v.lo = disk_mount(Blk::Loop(loopdev_new(pages, size)));
      v.lo_size = size;
      return l.pages;
    },
    Blk::Ata(a) => { v.lo = disk_mount(Blk::Ata(a)); },
    Blk::Virtio(x) => { v.lo = disk_mount(Blk::Virtio(x)); },
    Blk::Nvme(x) => { v.lo = disk_mount(Blk::Nvme(x)); },
    Blk::Ahci(x) => { v.lo = disk_mount(Blk::Ahci(x)); },
    Blk::Usb(x) => { v.lo = disk_mount(Blk::Usb(x)); },
  }
  return pages;
}

/// Is the name in the first n bytes of the transfer buffer on the disk
/// ("disk/" and at least one more byte)?
fn on_disk(v: &Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures result ==> DISK_PREFIX < n
{
  if n <= DISK_PREFIX {
    return false;
  }
  return bget(v.xfer, 0) == 100 && bget(v.xfer, 1) == 105 && bget(v.xfer, 2) == 115
    && bget(v.xfer, 3) == 107 && bget(v.xfer, 4) == 47;
}

/// When a disk image is mounted on a loop device and the name in the first
/// n bytes of the transfer buffer lies below its directory, the length of
/// that directory's name and the "/" after it (less than n); else 0.
fn lo_pfx(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v) && (result == 0 || result < n)
{
  if v.lo_at == 0 || v.lo_at > NFILES {
    return 0;
  }
  let l = ram_name(&mut v.ram, v.lo_at - 1, &mut v.lname);
  if l == NO_FILE || l + 1 >= n || bget(v.xfer, l) != 47 || !same_start(v.xfer, v.lname, l) {
    return 0;
  }
  return l + 1;
}

/// Is the name in the first n bytes of the transfer buffer the directory
/// the loop mount is on?
fn lo_root(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if v.lo_at == 0 || v.lo_at > NFILES {
    return false;
  }
  let l = ram_name(&mut v.ram, v.lo_at - 1, &mut v.lname);
  return l == n && same_start(v.xfer, v.lname, l);
}

/// Lets the loop mount's queued commands run (they finish at once).
fn lo_settle(v: &mut Vfs)
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  disk_drain(&mut v.lo);
  v.lo.txn = 0;
}

fn fget(t: &Buf, row: u64, f: u64) -> u64
  requires len(t) == FTAB_LEN && row < FD_ROWS && f < FD_STRIDE
{
  return get(t, row * FD_STRIDE + f);
}

fn fset(t: &mut Buf, row: u64, f: u64, x: u64)
  requires len(t) == FTAB_LEN && row < FD_ROWS && f < FD_STRIDE
  ensures len(t) == FTAB_LEN
{
  t = set(t, row * FD_STRIDE + f, x);
}

/// Is any row open on node i of file system fs?
fn node_open(t: &Buf, fs: u64, i: u64) -> bool
  requires len(t) == FTAB_LEN
{
  let mut r = 0;
  while r < FD_ROWS
    invariant r <= FD_ROWS
  {
    if fget(t, r, FD_FS) == fs && fget(t, r, FD_NODE) == i {
      return true;
    }
    r = r + 1;
  }
  return false;
}

/// Opens the file named by the first n bytes of the transfer buffer for
/// process row block `base` (pid * NFD). Returns the descriptor (0 to
/// NFD - 1) or NO_FD: no such file without O_CREATE, no room, or a name
/// that is empty or too long.
fn vfs_open(v: &mut Vfs, mem: &mut Mem, base: u64, flags: u64, n: u64) -> u64
  requires vfs_ok(v) && mem_ok(mem) && base + NFD <= FD_ROWS && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
  ensures result < NFD || result == NO_FD
{
  let fd = open_row(&mut v, &mut mem, base, flags, n);
  if fd < NFD && flags / O_TRUNC % 2 == 1 && flags / O_WRITE % 2 == 1 {
    pc_resize(&mut v.pc, &mut mem, vfs_row_file(v, base + fd), 0);
  }
  return fd;
}

/// vfs_open without the page cache's upkeep.
fn open_row(v: &mut Vfs, mem: &mut Mem, base: u64, flags: u64, n: u64) -> u64
  requires vfs_ok(v) && mem_ok(mem) && base + NFD <= FD_ROWS && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
  ensures result < NFD || result == NO_FD
{
  let mut fd = 0;
  while fd < NFD && fget(v.ftab, base + fd, FD_FS) != 0
    invariant fd <= NFD
  {
    fd = fd + 1;
  }
  if fd >= NFD {
    return NO_FD;
  }
  if on_disk(v, n) {
    let mk = path_ok(v, n) && parent_ok(&mut v, n);
    return dk_open(&mut v.disk, &mut v.ftab, v.xfer, base + fd, flags, DISK_PREFIX, n, FS_DISK, mk, v.now);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let mk = path_ok(v, n) && parent_ok(&mut v, n);
    let r = dk_open(&mut v.lo, &mut v.ftab, v.xfer, base + fd, flags, lp, n, FS_LO, mk && !v.lo_ro, v.now);
    lo_settle(&mut v);
    return r;
  }
  let mut i = ram_find(&mut v.ram, v.xfer, n);
  if i < NFILES && ram_link_of(&mut v.ram, i) < NFILES {
    i = ram_link_of(&mut v.ram, i);
  }
  if i >= NFILES {
    if flags / O_CREATE % 2 == 0 || !path_ok(v, n) || !parent_ok(&mut v, n) {
      return NO_FD;
    }
    i = ram_create(&mut v.ram, v.xfer, n, false, v.now);
    if i >= NFILES {
      return NO_FD;
    }
  } else if ram_is_dir(&mut v.ram, i) {
    return NO_FD;
  }
  if flags / O_WRITE % 2 == 1 && i == v.lo_file {
    return NO_FD;                       // a mounted disk image is not written through its file
  }
  if flags / O_TRUNC % 2 == 1 && flags / O_WRITE % 2 == 1 {
    match take_node(&mut v.ram, i) {
      Node::Free => {},
      Node::File(f) => {
        let mut g = f;
        file_truncate(&mut g, &mut mem);
        g.mtime = v.now;
        put_node(&mut v.ram, i, Node::File(g));
      },
    }
  }
  fset(&mut v.ftab, base + fd, FD_FS, FS_RAM);
  fset(&mut v.ftab, base + fd, FD_NODE, i);
  fset(&mut v.ftab, base + fd, FD_OFF, 0);
  fset(&mut v.ftab, base + fd, FD_MODE, flags % (2 * O_APPEND));
  return fd;
}

/// vfs_open for a name on disk file system d (file system fs in the
/// table), whose names start p bytes in, into the free row `row`. It may
/// create the file only if `mk` (a good name whose directory exists).
fn dk_open(d: &mut DiskFs, ftab: &mut Buf, x: &Bytes, row: u64, flags: u64, p: u64, n: u64, fs: u64, mk: bool, now: u64) -> u64
  requires disk_ok(d) && len(ftab) == FTAB_LEN && row < FD_ROWS && p < n && n <= blen(x)
  ensures disk_ok(d) && len(ftab) == FTAB_LEN
  ensures result < NFD || result == NO_FD
{
  let mut i = disk_find(d, x, p, n - p);
  if i < DSLOTS && disk_link_of(d, i) < DSLOTS {
    i = disk_link_of(d, i);
  }
  if i >= DSLOTS {
    if flags / O_CREATE % 2 == 0 || !mk {
      return NO_FD;
    }
    i = disk_create(&mut d, x, p, n - p, false, now);
    if i >= DSLOTS {
      return NO_FD;
    }
  } else if dent_dir(d, i) {
    return NO_FD;
  }
  if flags / O_TRUNC % 2 == 1 && flags / O_WRITE % 2 == 1 {
    if !disk_truncate(&mut d, i, now) {
      return NO_FD;
    }
  }
  fset(&mut ftab, row, FD_FS, fs);
  fset(&mut ftab, row, FD_NODE, i);
  fset(&mut ftab, row, FD_OFF, 0);
  fset(&mut ftab, row, FD_MODE, flags % (2 * O_APPEND));
  return row % NFD;
}

/// Closes a row. Returns false if it was not open.
fn vfs_close(v: &mut Vfs, mem: &mut Mem, row: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS
  ensures vfs_ok(v) && mem_ok(mem)
{
  let fs = fget(v.ftab, row, FD_FS);
  let node = fget(v.ftab, row, FD_NODE);
  if fs == 0 {
    return false;
  }
  let h = vfs_row_file(v, row);
  let mut f = 0;
  while f < FD_STRIDE
    invariant f <= FD_STRIDE && len(v.ftab) == FTAB_LEN
  {
    fset(&mut v.ftab, row, f, 0);
    f = f + 1;
  }
  // The last close of a file removed while open frees it. The page cache
  // keeps only open files' pages (a mapping holds its file open), so a
  // handle is never freed, and named again, with pages still cached.
  if !node_open(v.ftab, fs, node) {
    pc_forget(&mut v.pc, &mut mem, h);
    if fs == FS_RAM && node < NFILES && ram_len(&mut v.ram, node) == 0 && node != v.lo_file {
      ram_remove(&mut v.ram, &mut mem, node);
    } else if fs == FS_DISK && node < DSLOTS && dent_orphan(v.disk, node) {
      disk_remove(&mut v.disk, node);
    } else if fs == FS_LO && node < DSLOTS && dent_orphan(v.lo, node) {
      disk_remove(&mut v.lo, node);
      lo_settle(&mut v);
    }
  }
  return true;
}

/// Closes every row of process row block `base` (when the process ends).
fn vfs_close_all(v: &mut Vfs, mem: &mut Mem, base: u64)
  requires vfs_ok(v) && mem_ok(mem) && base + NFD <= FD_ROWS
  ensures vfs_ok(v) && mem_ok(mem)
{
  let mut fd = 0;
  while fd < NFD
    invariant fd <= NFD && vfs_ok(v) && mem_ok(mem)
  {
    vfs_close(&mut v, &mut mem, base + fd);
    fd = fd + 1;
  }
}

/// Reads up to n bytes from the file open in `row`, at its offset, into the
/// start of the transfer buffer. Returns the count (0 at the end of the
/// file) or NO_FD if the row is not open for reading. The offset does not
/// move: the caller advances it by what reached the user (vfs_advance).
/// On the disk, VFS_MISS if what it needs is not in the cache yet: reads
/// are queued, and the caller sleeps and tries again (disk_read).
fn vfs_read(v: &mut Vfs, row: u64, n: u64) -> u64
  requires vfs_ok(v) && row < FD_ROWS && n <= XFER
  ensures vfs_ok(v)
  ensures result <= n || result == NO_FD || result == VFS_MISS
{
  let r = read_row(&mut v, row, n);
  if r <= n {
    pc_overlay(&mut v.pc, vfs_row_file(v, row), fget(v.ftab, row, FD_OFF), &mut v.xfer, r);
  }
  return r;
}

/// vfs_read without the page cache's bytes over the file's.
fn read_row(v: &mut Vfs, row: u64, n: u64) -> u64
  requires vfs_ok(v) && row < FD_ROWS && n <= XFER
  ensures vfs_ok(v)
  ensures result <= n || result == NO_FD || result == VFS_MISS
{
  if fget(v.ftab, row, FD_MODE) / O_READ % 2 == 0 {
    return NO_FD;
  }
  let i = fget(v.ftab, row, FD_NODE);
  let fs = fget(v.ftab, row, FD_FS);
  if fs == FS_DISK && i < DSLOTS {
    let r = disk_read(&mut v.disk, i, fget(v.ftab, row, FD_OFF), &mut v.xfer, n);
    if r == NO_DISK_FILE {
      return NO_FD;
    }
    if r == DISK_MISS {
      return VFS_MISS;
    }
    return r;
  }
  if fs == FS_LO && i < DSLOTS {
    let r = disk_read_wait(&mut v.lo, i, fget(v.ftab, row, FD_OFF), &mut v.xfer, n);
    if r == NO_DISK_FILE {
      return NO_FD;
    }
    return r;
  }
  if fs != FS_RAM || i >= NFILES {
    return NO_FD;
  }
  return read_at(&mut v, i, fget(v.ftab, row, FD_OFF), n);
}

/// Writes the first n bytes of the transfer buffer to the file open in
/// `row`, at its offset (at the end with O_APPEND), and moves the offset
/// past them. Returns the count, short if memory or the file size limit
/// runs out, or NO_FD if the row is not open for writing. On the disk the
/// write is queued (the caller waits for v.disk.txn before returning to
/// the user), or VFS_MISS if old blocks it needs are not cached yet: the
/// caller sleeps and tries again (disk_write).
fn vfs_write(v: &mut Vfs, mem: &mut Mem, row: u64, n: u64) -> u64
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
  ensures result <= n || result == NO_FD || result == VFS_MISS
{
  let w = write_row(&mut v, &mut mem, row, n);
  let end = fget(v.ftab, row, FD_OFF);
  if w <= n && w <= end {
    pc_wrote(&mut v.pc, vfs_row_file(v, row), end - w, v.xfer, w);
  }
  return w;
}

/// vfs_write without copying the bytes into the page cache.
fn write_row(v: &mut Vfs, mem: &mut Mem, row: u64, n: u64) -> u64
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
  ensures result <= n || result == NO_FD || result == VFS_MISS
{
  if fget(v.ftab, row, FD_MODE) / O_WRITE % 2 == 0 {
    return NO_FD;
  }
  let i = fget(v.ftab, row, FD_NODE);
  if fget(v.ftab, row, FD_FS) == FS_DISK && i < DSLOTS {
    let mut off = fget(v.ftab, row, FD_OFF);
    if fget(v.ftab, row, FD_MODE) / O_APPEND % 2 == 1 {
      off = disk_size(v.disk, i);
    }
    let w = disk_write(&mut v.disk, i, off, v.xfer, n, v.now);
    if w == NO_DISK_FILE {
      return NO_FD;
    }
    if w == DISK_MISS {
      return VFS_MISS;
    }
    vfs_advance(&mut v, row, off, w);
    return w;
  }
  if fget(v.ftab, row, FD_FS) == FS_LO && i < DSLOTS {
    let mut off = fget(v.ftab, row, FD_OFF);
    if fget(v.ftab, row, FD_MODE) / O_APPEND % 2 == 1 {
      off = disk_size(v.lo, i);
    }
    let w = disk_write_at_wait(&mut v.lo, i, off, v.xfer, n, v.now);
    lo_settle(&mut v);
    if w == NO_DISK_FILE {
      return NO_FD;
    }
    vfs_advance(&mut v, row, off, w);
    return w;
  }
  if fget(v.ftab, row, FD_FS) != FS_RAM || i >= NFILES || i == v.lo_file {
    return NO_FD;
  }
  let mut put = NO_FD;
  match take_node(&mut v.ram, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      let mut off = fget(v.ftab, row, FD_OFF);
      if fget(v.ftab, row, FD_MODE) / O_APPEND % 2 == 1 {
        off = g.size;
      }
      put = file_write(&mut g, &mut mem, off, v.xfer, n);
      if put > 0 {
        g.mtime = v.now;
      }
      put_node(&mut v.ram, i, Node::File(g));
      vfs_advance(&mut v, row, off, put);
    },
  }
  return put;
}

/// Sets the size of the file open in `row` to size_to bytes (ftruncate):
/// growing reads as zeros. The row must be open for writing; its offset
/// stays where it is. False otherwise, or if the disk fails or is full.
fn vfs_truncate(v: &mut Vfs, mem: &mut Mem, row: u64, size_to: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS
  ensures vfs_ok(v) && mem_ok(mem)
{
  let ok = truncate_row(&mut v, &mut mem, row, size_to);
  if ok {
    pc_resize(&mut v.pc, &mut mem, vfs_row_file(v, row), size_to);
  }
  return ok;
}

/// vfs_truncate without the page cache's upkeep.
fn truncate_row(v: &mut Vfs, mem: &mut Mem, row: u64, size_to: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS
  ensures vfs_ok(v) && mem_ok(mem)
{
  if fget(v.ftab, row, FD_MODE) / O_WRITE % 2 == 0 {
    return false;
  }
  let i = fget(v.ftab, row, FD_NODE);
  if fget(v.ftab, row, FD_FS) == FS_DISK && i < DSLOTS {
    return disk_resize(&mut v.disk, i, size_to, v.now);
  }
  if fget(v.ftab, row, FD_FS) == FS_LO && i < DSLOTS {
    let ok = disk_resize(&mut v.lo, i, size_to, v.now);
    lo_settle(&mut v);
    return ok;
  }
  if fget(v.ftab, row, FD_FS) != FS_RAM || i >= NFILES || i == v.lo_file {
    return false;
  }
  let mut ok = false;
  match take_node(&mut v.ram, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      ok = file_resize(&mut g, &mut mem, size_to);
      if ok {
        g.mtime = v.now;
      }
      put_node(&mut v.ram, i, Node::File(g));
    },
  }
  return ok;
}

/// Sets a row's offset to off + k, saturating.
fn vfs_advance(v: &mut Vfs, row: u64, off: u64, k: u64)
  requires vfs_ok(v) && row < FD_ROWS
  ensures vfs_ok(v)
{
  let mut o = 18446744073709551615;
  if k <= o - off {
    o = off + k;
  }
  fset(&mut v.ftab, row, FD_OFF, o);
}

/// The offset of an open row.
fn vfs_offset(v: &Vfs, row: u64) -> u64
  requires vfs_ok(v) && row < FD_ROWS
{
  return fget(v.ftab, row, FD_OFF);
}

/// Moves an open row's offset to `off`. Returns false if it is not open.
fn vfs_seek(v: &mut Vfs, row: u64, off: u64) -> bool
  requires vfs_ok(v) && row < FD_ROWS
  ensures vfs_ok(v)
{
  if fget(v.ftab, row, FD_FS) == 0 {
    return false;
  }
  fset(&mut v.ftab, row, FD_OFF, off);
  return true;
}

/// Removes the file named by the first n bytes of the transfer buffer.
/// Returns false if there is none (or it is a directory). A file that is
/// open loses its name now and its data at the last close, as on Linux.
fn vfs_unlink(v: &mut Vfs, mem: &mut Mem, n: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
{
  if on_disk(v, n) {
    return dk_unlink(&mut v.disk, v.ftab, v.xfer, DISK_PREFIX, n, FS_DISK);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let ok = dk_unlink(&mut v.lo, v.ftab, v.xfer, lp, n, FS_LO);
    lo_settle(&mut v);
    return ok;
  }
  let i = ram_find(&mut v.ram, v.xfer, n);
  if i >= NFILES || ram_is_dir(&mut v.ram, i) {
    return false;
  }
  let l = ram_link_to(&mut v.ram, i);
  if l < NFILES {
    // The file keeps its node (descriptors and other links name it) and
    // takes the link's name instead.
    let ll = ram_name(&mut v.ram, l, &mut v.name);
    let il = ram_len(&mut v.ram, i);
    if ll > NAMEBUF || il == NO_FILE {
      return false;
    }
    ram_remove(&mut v.ram, &mut mem, l);
    return ram_reprefix(&mut v.ram, i, il, v.name, ll);
  }
  if node_open(v.ftab, FS_RAM, i) || i == v.lo_file {
    ram_orphan(&mut v.ram, i);          // a mounted image goes at its unmount
  } else {
    ram_remove(&mut v.ram, &mut mem, i);
  }
  return true;
}

/// vfs_unlink of x[0..n] on disk file system d (fs in the table), whose
/// names start p bytes in.
fn dk_unlink(d: &mut DiskFs, ftab: &Buf, x: &Bytes, p: u64, n: u64, fs: u64) -> bool
  requires disk_ok(d) && len(ftab) == FTAB_LEN && p < n && n <= blen(x)
  ensures disk_ok(d)
{
  let e = disk_find(d, x, p, n - p);
  if e >= DSLOTS || dent_dir(d, e) {
    return false;
  }
  let l = disk_link_to(d, e);
  if l < DSLOTS {
    return disk_take_name(&mut d, e, l);
  }
  if node_open(ftab, fs, e) {
    return disk_orphan(&mut d, e);
  }
  return disk_remove(&mut d, e);
}

/// The file named by the first n bytes of the transfer buffer, as a
/// handle for vfs_read_at and vfs_size, or NO_FILE. Handles number files
/// like vfs_dirent: 0 to NFILES - 1 in memory, then DSLOTS on the disk. A
/// handle names the same file until that file is removed.
fn vfs_lookup(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
  ensures result < HFILES || result == NO_FILE
{
  if on_disk(v, n) {
    let d = disk_find(v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX);
    if d >= DSLOTS {
      return NO_FILE;
    }
    return vfs_target(&mut v, NFILES + d);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let d = disk_find(v.lo, v.xfer, lp, n - lp);
    if d >= DSLOTS {
      return NO_FILE;
    }
    return vfs_target(&mut v, LO0 + d);
  }
  let i = ram_find(&mut v.ram, v.xfer, n);
  if i >= NFILES {
    return NO_FILE;
  }
  return vfs_target(&mut v, i);
}

/// The file that handle f names: f itself, or what f is a hard link to.
fn vfs_target(v: &mut Vfs, f: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
  ensures f < NFILES + DSLOTS ==> result < NFILES + DSLOTS
  ensures f >= LO0 && f < HFILES ==> result >= LO0 && result < HFILES
  ensures f >= HFILES ==> result == f
{
  if f < NFILES {
    let t = ram_link_of(&mut v.ram, f);
    if t < NFILES {
      return t;
    }
    return f;
  }
  if f < NFILES + DSLOTS {
    let t = disk_link_of(v.disk, f - NFILES);
    if t < DSLOTS {
      return NFILES + t;
    }
  } else if f < HFILES {
    let t = disk_link_of(v.lo, f - LO0);
    if t < DSLOTS {
      return LO0 + t;
    }
  }
  return f;
}

/// How many names file f (a vfs_lookup handle) has: 1 and its hard links.
fn vfs_nlink(v: &mut Vfs, f: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let t = vfs_target(&mut v, f);
  if t < NFILES {
    return 1 + ram_links(&mut v.ram, t);
  }
  if t < NFILES + DSLOTS {
    return 1 + disk_links(v.disk, t - NFILES);
  }
  if t < HFILES {
    return 1 + disk_links(v.lo, t - LO0);
  }
  return 1;
}

/// The size of file f (a vfs_lookup handle), or NO_FILE.
fn vfs_size(v: &mut Vfs, f0: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  if f < NFILES {
    return ram_size(&mut v.ram, f);
  }
  if f < NFILES + DSLOTS {
    let s = disk_size(v.disk, f - NFILES);
    if s == NO_DISK_FILE {
      return NO_FILE;
    }
    return s;
  }
  if f < HFILES {
    let s = disk_size(v.lo, f - LO0);
    if s == NO_DISK_FILE {
      return NO_FILE;
    }
    return s;
  }
  return NO_FILE;
}

/// Copies up to n bytes of file f (a vfs_lookup handle) from offset off
/// into the start of the transfer buffer, without a descriptor. Returns
/// the count, short at the end of the file, or NO_FD if f names no file.
fn vfs_read_at(v: &mut Vfs, f0: u64, off: u64, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
  ensures result <= n || result == NO_FD
{
  let r = read_at(&mut v, f0, off, n);
  if r <= n && pc_on(v.pc) {
    let f = vfs_target(&mut v, f0);
    pc_overlay(&mut v.pc, f, off, &mut v.xfer, r);
  }
  return r;
}

/// vfs_read_at without the page cache's bytes over the file's.
fn read_at(v: &mut Vfs, f0: u64, off: u64, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
  ensures result <= n || result == NO_FD
{
  let f = vfs_target(&mut v, f0);
  if f >= HFILES {
    return NO_FD;
  }
  if f >= LO0 {
    let r = disk_read_wait(&mut v.lo, f - LO0, off, &mut v.xfer, n);
    if r == NO_DISK_FILE {
      return NO_FD;
    }
    return r;
  }
  if f >= NFILES {
    let r = disk_read_wait(&mut v.disk, f - NFILES, off, &mut v.xfer, n);
    if r == NO_DISK_FILE {
      return NO_FD;
    }
    return r;
  }
  let mut got = NO_FD;
  match take_node(&mut v.ram, f) {
    Node::Free => {},
    Node::File(g0) => {
      let mut g = g0;
      got = file_read(&mut g, off, &mut v.xfer, n);
      put_node(&mut v.ram, f, Node::File(g));
    },
  }
  return got;
}

/// The size of the file named by the first n bytes of the transfer
/// buffer, or NO_FILE.
fn vfs_stat(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  let f = vfs_lookup(&mut v, n);
  return vfs_size(&mut v, f);
}

/// Copies the name of directory entry i into the start of the transfer
/// buffer. Returns its length, 0 for an unused entry, or NO_FILE past the
/// last entry. Entries 0 to NFILES - 1 are in memory, the next DSLOTS on
/// the disk (their names start with "disk/").
fn vfs_dirent(v: &mut Vfs, i: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
  ensures result <= XFER || result == NO_FILE
{
  if i >= HFILES {
    return NO_FILE;
  }
  if i >= LO0 {
    return lo_dirent(&mut v, i - LO0);
  }
  if i >= NFILES {
    let d = disk_name(v.disk, i - NFILES, &mut v.xfer, DISK_PREFIX);
    if d == NO_DISK_FILE {
      return 0;
    }
    bset(&mut v.xfer, 0, 100);
    bset(&mut v.xfer, 1, 105);
    bset(&mut v.xfer, 2, 115);
    bset(&mut v.xfer, 3, 107);
    bset(&mut v.xfer, 4, 47);
    return DISK_PREFIX + d;
  }
  let n = ram_name(&mut v.ram, i, &mut v.xfer);
  if n == NO_FILE {
    return 0;
  }
  if n > XFER {
    return 0;     // cannot happen: names are at most FNAME_MAX bytes
  }
  return n;
}

/// vfs_dirent for entry e of the loop mount: its directory's name, "/",
/// then the entry's path.
fn lo_dirent(v: &mut Vfs, e: u64) -> u64
  requires vfs_ok(v) && e < DSLOTS
  ensures vfs_ok(v)
  ensures result <= XFER || result == NO_FILE
{
  if v.lo_at == 0 || v.lo_at > NFILES {
    return 0;
  }
  let l = ram_name(&mut v.ram, v.lo_at - 1, &mut v.lname);
  if l == NO_FILE || l + 1 > NAMEBUF {
    return 0;
  }
  let d = disk_name(v.lo, e, &mut v.xfer, l + 1);
  if d == NO_DISK_FILE || l + 1 + d > XFER {
    return 0;
  }
  let mut j = 0;
  while j < l
    invariant j <= l && l + 1 <= NAMEBUF && vfs_ok(v)
  {
    bset(&mut v.xfer, j, bget(v.lname, j));
    j = j + 1;
  }
  bset(&mut v.xfer, l, 47);
  return l + 1 + d;
}

/// Creates (or replaces) the file `name` holding the bytes of `data`. Used
/// at boot to fill the file system from images built into the kernel.
fn vfs_install(v: &mut Vfs, mem: &mut Mem, name: Str, data: Str) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  let nm = bfrom(name);
  let n = blen(nm);
  let mut i = ram_find(&mut v.ram, nm, n);
  if i >= NFILES {
    i = ram_create(&mut v.ram, nm, n, false, v.now);
  }
  bfree(nm);
  if i >= NFILES {
    return false;
  }
  let mut ok = false;
  match take_node(&mut v.ram, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      file_truncate(&mut g, &mut mem);
      let d = bfrom(data);
      let m = blen(d);
      ok = file_write(&mut g, &mut mem, 0, d, m) == m;
      bfree(d);
      put_node(&mut v.ram, i, Node::File(g));
    },
  }
  return ok;
}

// ---------------------------------------------------------------- directories

/// Is the name in the first n bytes of the transfer buffer fit for a new
/// file or directory: not empty, no "/" at either end or twice in a row,
/// and not "disk"?
fn path_ok(v: &Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
{
  if n == 0 || bget(v.xfer, 0) == 47 || bget(v.xfer, n - 1) == 47 {
    return false;
  }
  if n == 4 && bget(v.xfer, 0) == 100 && bget(v.xfer, 1) == 105 && bget(v.xfer, 2) == 115
    && bget(v.xfer, 3) == 107 {
    return false;
  }
  let mut j = 1;
  while j < n
    invariant 1 <= j && j <= n
  {
    if bget(v.xfer, j) == 47 && bget(v.xfer, j - 1) == 47 {
      return false;
    }
    j = j + 1;
  }
  return true;
}

/// The position of the last "/" in the first n bytes of the transfer
/// buffer, or n if there is none.
fn last_slash(v: &Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures result <= n
{
  let mut k = n;
  while k > 0
    invariant k <= n
  {
    if bget(v.xfer, k - 1) == 47 {
      return k - 1;
    }
    k = k - 1;
  }
  return n;
}

/// Does the directory that a new file named by the first n bytes of the
/// transfer buffer would go in exist?
fn parent_ok(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  let k = last_slash(v, n);
  if k == n {
    return true;                        // at the top
  }
  if on_disk(v, n) {
    if k < DISK_PREFIX {
      return k == DISK_PREFIX - 1;      // directly in "disk"
    }
    let d = disk_find(v.disk, v.xfer, DISK_PREFIX, k - DISK_PREFIX);
    return d < DSLOTS && dent_dir(v.disk, d);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    if k < lp {
      return k == lp - 1;               // directly in the mount's directory
    }
    let d = disk_find(v.lo, v.xfer, lp, k - lp);
    return d < DSLOTS && dent_dir(v.lo, d);
  }
  let i = ram_find(&mut v.ram, v.xfer, k);
  return i < NFILES && ram_is_dir(&mut v.ram, i);
}

/// Makes the directory named by the first n bytes of the transfer buffer.
/// Fails if the name is taken, its parent is missing, or there is no room.
fn vfs_mkdir(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if !path_ok(v, n) || !parent_ok(&mut v, n) {
    return false;
  }
  if on_disk(v, n) {
    if disk_find(v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX) < DSLOTS {
      return false;
    }
    return disk_create(&mut v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX, true, v.now) < DSLOTS;
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    if v.lo_ro || disk_find(v.lo, v.xfer, lp, n - lp) < DSLOTS {
      return false;
    }
    let ok = disk_create(&mut v.lo, v.xfer, lp, n - lp, true, v.now) < DSLOTS;
    lo_settle(&mut v);
    return ok;
  }
  if ram_find(&mut v.ram, v.xfer, n) < NFILES {
    return false;
  }
  return ram_create(&mut v.ram, v.xfer, n, true, v.now) < NFILES;
}

/// Removes the directory named by the first n bytes of the transfer buffer
/// if nothing is in it.
fn vfs_rmdir(v: &mut Vfs, mem: &mut Mem, n: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
{
  if on_disk(v, n) {
    let d = disk_find(v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX);
    if d >= DSLOTS || !dent_dir(v.disk, d) || disk_has_children(v.disk, d) {
      return false;
    }
    return disk_remove(&mut v.disk, d);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let d = disk_find(v.lo, v.xfer, lp, n - lp);
    if d >= DSLOTS || !dent_dir(v.lo, d) || disk_has_children(v.lo, d) {
      return false;
    }
    let ok = disk_remove(&mut v.lo, d);
    lo_settle(&mut v);
    return ok;
  }
  let i = ram_find(&mut v.ram, v.xfer, n);
  if i >= NFILES || !ram_is_dir(&mut v.ram, i) {
    return false;
  }
  let mut j = 0;
  while j < NFILES
    invariant j <= NFILES && vfs_ok(v) && n <= XFER
  {
    if ram_under(&mut v.ram, j, v.xfer, n) {
      return false;
    }
    j = j + 1;
  }
  ram_remove(&mut v.ram, &mut mem, i);
  return true;
}

/// Is handle f (from vfs_lookup or vfs_dir_lookup) a directory?
fn vfs_is_dir(v: &mut Vfs, f0: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  if f < NFILES {
    return ram_is_dir(&mut v.ram, f);
  }
  if f < NFILES + DSLOTS {
    return dent_dir(v.disk, f - NFILES);
  }
  if f < HFILES {
    return dent_dir(v.lo, f - LO0);
  }
  return f == VDIR_ROOT || f == VDIR_DISK || f == VDIR_LO;
}

/// The directory named by the first n bytes of the transfer buffer, as a
/// handle for vfs_readdir: VDIR_ROOT for the empty name, VDIR_DISK for
/// "disk", VDIR_LO for the loop mount's directory, or a directory node.
/// NO_FILE if there is no such directory.
fn vfs_dir_lookup(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
  ensures result <= VDIR_LO || result == NO_FILE
{
  if n == 0 {
    return VDIR_ROOT;
  }
  if lo_root(&mut v, n) {
    return VDIR_LO;
  }
  if n == 4 && bget(v.xfer, 0) == 100 && bget(v.xfer, 1) == 105 && bget(v.xfer, 2) == 115
    && bget(v.xfer, 3) == 107 {
    return VDIR_DISK;
  }
  let f = vfs_lookup(&mut v, n);
  if f != NO_FILE && vfs_is_dir(&mut v, f) {
    return f;
  }
  return NO_FILE;
}

/// If x[0..n] names something directly in the directory named p[0..l]
/// (in the top directory when `top`), moves its last part to the start of
/// x and returns that part's length; otherwise returns 0.
fn child_at(x: &mut Bytes, n: u64, p: &Bytes, l: u64, top: bool) -> u64
  requires n <= blen(x) && l <= blen(p)
  ensures blen(x) == old(blen(x)) && result <= n
{
  let mut start = 0;
  if !top {
    if n <= l + 1 || bget(x, l) != 47 {
      return 0;
    }
    let mut j = 0;
    while j < l
      invariant j <= l && l < n
    {
      if bget(x, j) != bget(p, j) {
        return 0;
      }
      j = j + 1;
    }
    start = l + 1;
  }
  let mut j = start;
  while j < n
    invariant start <= j && j <= n
  {
    if bget(x, j) == 47 {
      return 0;
    }
    j = j + 1;
  }
  let bl = blen(x);
  let mut k = 0;
  while k < n - start
    invariant k <= n - start && start <= n && n <= bl && blen(x) == bl
  {
    bset(&mut x, k, bget(x, start + k));
    k = k + 1;
  }
  return n - start;
}

/// Copies the name (the last part only) of entry i of directory d (a
/// vfs_dir_lookup handle) into the start of the transfer buffer. Returns
/// its length, 0 if entry i is not in d, or NO_FILE past the last entry or
/// if d is not a directory. Entries are numbered like the nodes of d's
/// file system; the top directory has one more, "disk", when there is a
/// disk. vfs_child gives the handle of an entry.
fn vfs_readdir(v: &mut Vfs, d: u64, i: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
  ensures result <= XFER || result == NO_FILE
{
  if d == VDIR_ROOT || d < NFILES {
    let mut l = 0;
    if d < NFILES {
      if !ram_is_dir(&mut v.ram, d) {
        return NO_FILE;
      }
      l = ram_name(&mut v.ram, d, &mut v.name);
      if l > NAMEBUF {
        return NO_FILE;
      }
    }
    if d == VDIR_ROOT && i == NFILES {
      if v.disk.slots == 0 {
        return 0;
      }
      bset(&mut v.xfer, 0, 100);
      bset(&mut v.xfer, 1, 105);
      bset(&mut v.xfer, 2, 115);
      bset(&mut v.xfer, 3, 107);
      return 4;
    }
    if i >= NFILES {
      return NO_FILE;
    }
    let n = ram_name(&mut v.ram, i, &mut v.xfer);
    if n > XFER {
      return 0;
    }
    return child_at(&mut v.xfer, n, v.name, l, d == VDIR_ROOT);
  }
  if d == VDIR_DISK || d < NFILES + DSLOTS {
    let mut p = DTOP;
    if d < NFILES + DSLOTS {
      if !dent_dir(v.disk, d - NFILES) {
        return NO_FILE;
      }
      p = d - NFILES;
    }
    return dk_readdir(v.disk, &mut v.xfer, p, i);
  }
  if d == VDIR_LO || d < HFILES {
    let mut p = DTOP;
    if d < HFILES {
      if !dent_dir(v.lo, d - LO0) {
        return NO_FILE;
      }
      p = d - LO0;
    }
    return dk_readdir(v.lo, &mut v.xfer, p, i);
  }
  return NO_FILE;
}

/// vfs_readdir of entry i of directory entry p (DTOP: the top) of disk
/// file system d.
fn dk_readdir(d: &DiskFs, x: &mut Bytes, p: u64, i: u64) -> u64
  requires disk_ok(d) && blen(x) == XFER
  ensures blen(x) == XFER
  ensures result <= XFER || result == NO_FILE
{
  if i >= DSLOTS {
    return NO_FILE;
  }
  if !dent_used(d, i) || dent_parent(d, i) != p {
    return 0;
  }
  let n = disk_comp(d, i, &mut x, 0);
  if n == NO_DISK_FILE || n > XFER {
    return 0;
  }
  return n;
}

/// The handle of entry i of directory d, when vfs_readdir(v, d, i) found
/// one (returned more than 0).
fn vfs_child(d: u64, i: u64) -> u64 {
  if d == VDIR_ROOT && i == NFILES {
    return VDIR_DISK;
  }
  if d == VDIR_ROOT || d < NFILES {
    if i >= NFILES {
      return NO_FILE;
    }
    return i;
  }
  if i >= DSLOTS {
    return NO_FILE;
  }
  if d == VDIR_LO || (d >= LO0 && d < HFILES) {
    return LO0 + i;
  }
  return NFILES + i;
}

/// Renames the file or directory named by the first n bytes of the
/// transfer buffer to the next m bytes. Both names must be on the same
/// file system, the new one free and its directory existing, and a
/// directory cannot move into itself. Descriptors stay open on the file.
/// On the disk this is one sector write, so a power cut leaves either
/// name; in memory a directory's contents are renamed with it.
fn vfs_rename(v: &mut Vfs, n: u64, m: u64) -> bool
  requires vfs_ok(v) && n <= XFER && m <= XFER - n
  ensures vfs_ok(v)
{
  if n == 0 || m == 0 || n > FNAME_MAX || m > FNAME_MAX {
    return false;
  }
  let src_disk = on_disk(v, n);
  let src_lo = lo_pfx(&mut v, n) != 0;
  let mut node = NO_FILE;
  if src_disk {
    let d = disk_find(v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX);
    if d >= DSLOTS {
      return false;
    }
    node = d;
  } else if src_lo {
    let lp = lo_pfx(&mut v, n);
    if lp == 0 || v.lo_ro {
      return false;
    }
    let d = disk_find(v.lo, v.xfer, lp, n - lp);
    if d >= DSLOTS {
      return false;
    }
    node = d;
  } else {
    let i = ram_find(&mut v.ram, v.xfer, n);
    if i >= NFILES {
      return false;
    }
    node = i;
  }
  // Keep the old name in v.name and move the new one to the front.
  let mut k = 0;
  while k < n
    invariant k <= n && n <= FNAME_MAX && vfs_ok(v)
  {
    bset(&mut v.name, k, bget(v.xfer, k));
    k = k + 1;
  }
  k = 0;
  while k < m
    invariant k <= m && vfs_ok(v) && n <= XFER && m <= XFER - n
  {
    bset(&mut v.xfer, k, bget(v.xfer, n + k));
    k = k + 1;
  }
  let mp = lo_pfx(&mut v, m);
  if on_disk(v, m) != src_disk || (mp != 0) != src_lo || !path_ok(v, m) || !parent_ok(&mut v, m) {
    return false;
  }
  if vfs_lookup(&mut v, m) != NO_FILE {
    return false;
  }
  // Not into itself: the new name is not the old one and a "/" and more.
  if m > n && bget(v.xfer, n) == 47 {
    let mut same = true;
    let mut j = 0;
    while j < n
      invariant j <= n && n < m && m <= XFER && vfs_ok(v)
    {
      if bget(v.xfer, j) != bget(v.name, j) {
        same = false;
      }
      j = j + 1;
    }
    if same {
      return false;
    }
  }
  if src_disk {
    return node < DSLOTS && disk_move(&mut v.disk, node, v.xfer, DISK_PREFIX, m - DISK_PREFIX);
  }
  if src_lo {
    let lp = lo_pfx(&mut v, m);
    if lp == 0 || node >= DSLOTS {
      return false;
    }
    let ok = disk_move(&mut v.lo, node, v.xfer, lp, m - lp);
    lo_settle(&mut v);
    return ok;
  }
  if node >= NFILES {
    return false;
  }
  // In memory: every node inside a directory moves with it. Check that
  // every new name fits before changing any.
  if ram_is_dir(&mut v.ram, node) {
    let mut j = 0;
    while j < NFILES
      invariant j <= NFILES && vfs_ok(v) && n <= FNAME_MAX && m <= FNAME_MAX
    {
      if ram_under(&mut v.ram, j, v.name, n) {
        let l = ram_len(&mut v.ram, j);
        if l == NO_FILE || l < n || l - n > FNAME_MAX - m {
          return false;
        }
      }
      j = j + 1;
    }
    j = 0;
    while j < NFILES
      invariant j <= NFILES && vfs_ok(v) && n <= FNAME_MAX && m <= FNAME_MAX
    {
      if ram_under(&mut v.ram, j, v.name, n) {
        ram_reprefix(&mut v.ram, j, n, v.xfer, m);
      }
      j = j + 1;
    }
  }
  return ram_reprefix(&mut v.ram, node, n, v.xfer, m);
}

// ---------------------------------------------------------------- metadata

/// The handle of the file open in `row` (as vfs_lookup gives), or NO_FILE.
fn vfs_row_file(v: &Vfs, row: u64) -> u64
  requires vfs_ok(v) && row < FD_ROWS
  ensures result < HFILES || result == NO_FILE
{
  let fs = fget(v.ftab, row, FD_FS);
  let node = fget(v.ftab, row, FD_NODE);
  if fs == FS_RAM && node < NFILES {
    return node;
  }
  if fs == FS_DISK && node < DSLOTS {
    return NFILES + node;
  }
  if fs == FS_LO && node < DSLOTS {
    return LO0 + node;
  }
  return NO_FILE;
}

/// The permission bits (such as 0644) and modification time (seconds) of
/// handle f, from vfs_lookup or vfs_dir_lookup. ok is false if it names
/// nothing. The top directory and "disk" are 0755 from time 0.
fn vfs_meta(v: &mut Vfs, f0: u64) -> FMeta
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  if f < NFILES {
    return ram_meta(&mut v.ram, f);
  }
  if f < NFILES + DSLOTS {
    if !dent_used(v.disk, f - NFILES) {
      return FMeta { ok: false, mode: 0, mtime: 0, own: 0 };
    }
    return FMeta { ok: true, mode: disk_mode(v.disk, f - NFILES), mtime: disk_mtime(v.disk, f - NFILES), own: disk_owner(v.disk, f - NFILES) };
  }
  if f < HFILES {
    if !dent_used(v.lo, f - LO0) {
      return FMeta { ok: false, mode: 0, mtime: 0, own: 0 };
    }
    return FMeta { ok: true, mode: disk_mode(v.lo, f - LO0), mtime: disk_mtime(v.lo, f - LO0), own: disk_owner(v.lo, f - LO0) };
  }
  if f == VDIR_ROOT || f == VDIR_DISK || f == VDIR_LO {
    return FMeta { ok: true, mode: 493, mtime: 0, own: 0 };
  }
  return FMeta { ok: false, mode: 0, mtime: 0, own: 0 };
}

/// Sets handle f's owner to user id uid and group id gid. False if f
/// names nothing that keeps one, the disk cannot keep ids that large, or
/// the disk fails.
fn vfs_set_owner(v: &mut Vfs, f0: u64, uid: u64, gid: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  if f < NFILES {
    return uid < 0x100000000 && gid < 0x100000000 && ram_set_owner(&mut v.ram, f, uid + gid * 0x100000000);
  }
  if uid >= OWN_ID_MAX || gid >= OWN_ID_MAX {
    return false;
  }
  if f < NFILES + DSLOTS {
    return disk_set_owner(&mut v.disk, f - NFILES, uid, gid);
  }
  if f < HFILES && !v.lo_ro {
    let ok = disk_set_owner(&mut v.lo, f - LO0, uid, gid);
    lo_settle(&mut v);
    return ok;
  }
  return false;
}

/// Sets handle f's permission bits (when `mode` is below 4096) and its
/// modification time (when `mtime` is not NO_FILE). False if f names
/// nothing that keeps them, or the disk fails.
fn vfs_set_meta(v: &mut Vfs, f0: u64, mode: u64, mtime: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  let mut m = 65536;
  if mode < 4096 {
    let cur = vfs_meta(&mut v, f);
    m = cur.mode % 65536 / 4096 * 4096 + mode;   // the type bits stay (a link stays a link)
  }
  if f < NFILES {
    return ram_set_meta(&mut v.ram, f, m, mtime);
  }
  if f < NFILES + DSLOTS {
    let mut t = NO_DISK_FILE;
    if mtime != NO_FILE {
      t = mtime;
    }
    return disk_set_meta(&mut v.disk, f - NFILES, m, t);
  }
  if f < HFILES && !v.lo_ro {
    let mut t = NO_DISK_FILE;
    if mtime != NO_FILE {
      t = mtime;
    }
    let ok = disk_set_meta(&mut v.lo, f - LO0, m, t);
    lo_settle(&mut v);
    return ok;
  }
  return false;
}

// ---------------------------------------------------------------- symbolic links

const T_LINK: u64 = 0xA000;           // mode type bits of a symbolic link
const LINK_MODE: u64 = 0xA1FF;        // a link: rwxrwxrwx, as Linux shows them

const T_FIFO: u64 = 0x1000;           // mode type bits of a named pipe

/// Is handle f a named pipe? The Linux layer opens it as a pipe
/// (src/lxevent.bastio); its data never lives in the file.
fn vfs_is_fifo(v: &mut Vfs, f: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let m = vfs_meta(&mut v, f);
  return m.ok && m.mode % 65536 / 4096 * 4096 == T_FIFO;
}

/// Creates a named pipe called xfer[0..n] with permission bits `perm`: an
/// empty file whose mode has the FIFO type bits. False if the name is
/// taken, its parent does not exist, or there is no room. Two steps on the
/// disk (the file, then its mode): a power cut between them leaves an empty
/// file under the name.
fn vfs_mkfifo(v: &mut Vfs, mem: &mut Mem, n: u64, perm: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  return vfs_mknode(&mut v, &mut mem, n, T_FIFO + perm % 4096);
}

/// vfs_mkfifo for any mode: type bits (none for a regular file) and
/// permission bits.
fn vfs_mknode(v: &mut Vfs, mem: &mut Mem, n: u64, mode: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  if mode >= 65536 || n > FNAME_MAX || !path_ok(v, n) || !parent_ok(&mut v, n) || vfs_lookup(&mut v, n) != NO_FILE || vfs_dir_lookup(&mut v, n) != NO_FILE {
    return false;
  }
  if on_disk(v, n) {
    return dk_mknode(&mut v.disk, v.xfer, DISK_PREFIX, n, mode, v.now);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let ok = !v.lo_ro && dk_mknode(&mut v.lo, v.xfer, lp, n, mode, v.now);
    lo_settle(&mut v);
    return ok;
  }
  let i = ram_create(&mut v.ram, v.xfer, n, false, v.now);
  if i >= NFILES {
    return false;
  }
  if !ram_set_meta(&mut v.ram, i, mode, NO_FILE) {
    ram_remove(&mut v.ram, &mut mem, i);
    return false;
  }
  return true;
}

/// vfs_mknode of x[0..n] on disk file system d, whose names start p bytes in.
fn dk_mknode(d: &mut DiskFs, x: &Bytes, p: u64, n: u64, mode: u64, now: u64) -> bool
  requires disk_ok(d) && p < n && n <= blen(x)
  ensures disk_ok(d)
{
  let e = disk_create(&mut d, x, p, n - p, false, now);
  if e >= DSLOTS {
    return false;
  }
  if !disk_set_meta(&mut d, e, mode, NO_DISK_FILE) {
    disk_remove(&mut d, e);
    return false;
  }
  return true;
}

/// Is handle f a symbolic link? Its contents are the target.
fn vfs_is_link(v: &mut Vfs, f: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let m = vfs_meta(&mut v, f);
  return m.ok && m.mode % 65536 / 4096 * 4096 == T_LINK;
}

/// Creates a symbolic link: its name is xfer[0..n], its target the m bytes
/// after. False if the name is taken, its parent does not exist, the
/// target is empty or too long, or there is no room. The link is made in
/// steps (an empty node, then its type, then the target); a power cut in
/// between can leave an empty file or an empty link under the name.
fn vfs_symlink(v: &mut Vfs, mem: &mut Mem, n: u64, m: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  if n > FNAME_MAX || m == 0 || m > FNAME_MAX || !path_ok(v, n) || !parent_ok(&mut v, n) || vfs_lookup(&mut v, n) != NO_FILE {
    return false;
  }
  if on_disk(v, n) {
    return dk_symlink(&mut v.disk, &mut v.xfer, DISK_PREFIX, n, m, v.now);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let ok = !v.lo_ro && dk_symlink(&mut v.lo, &mut v.xfer, lp, n, m, v.now);
    lo_settle(&mut v);
    return ok;
  }
  let i = ram_create(&mut v.ram, v.xfer, n, false, v.now);
  if i >= NFILES {
    return false;
  }
  xfer_shift(&mut v.xfer, n, m);
  let mut w = 0;
  match take_node(&mut v.ram, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      g.mode = LINK_MODE;
      w = file_write(&mut g, &mut mem, 0, v.xfer, m);
      put_node(&mut v.ram, i, Node::File(g));
    },
  }
  if w != m {
    ram_remove(&mut v.ram, &mut mem, i);
    return false;
  }
  return true;
}

/// vfs_symlink on disk file system d, whose names start p bytes in.
fn dk_symlink(d: &mut DiskFs, x: &mut Bytes, p: u64, n: u64, m: u64, now: u64) -> bool
  requires disk_ok(d) && blen(x) == XFER && p < n && n <= XFER && m <= FNAME_MAX
  ensures disk_ok(d) && blen(x) == XFER
{
  let e = disk_create(&mut d, x, p, n - p, false, now);
  if e >= DSLOTS {
    return false;
  }
  xfer_shift(&mut x, n, m);
  if !disk_set_meta(&mut d, e, LINK_MODE, NO_DISK_FILE) || disk_write_wait(&mut d, e, x, m, now) != m {
    disk_remove(&mut d, e);
    return false;
  }
  return true;
}

/// Moves x[from .. from + m] to the front of x.
fn xfer_shift(x: &mut Bytes, from: u64, m: u64)
  requires blen(x) == XFER
  ensures blen(x) == XFER
{
  if from > XFER || m > XFER - from {
    return;
  }
  let mut i = 0;
  while i < m
    invariant i <= m && from + m <= XFER && blen(x) == XFER
  {
    bset(&mut x, i, bget(x, from + i));
    i = i + 1;
  }
}

// ---------------------------------------------------------------- hard links

const LINKED: u64 = 0;
const LINK_NONE: u64 = 1;             // no such file, or the new name's directory is missing
const LINK_EXISTS: u64 = 2;
const LINK_XDEV: u64 = 3;             // the names are on different file systems
const LINK_DIR: u64 = 4;              // the old name is a directory
const LINK_FULL: u64 = 5;             // no free node or entry

/// Gives the file named xfer[0..n] another name, the m bytes after (a hard
/// link). The new name is a node of its own that names the file; opening
/// it opens the file, and the file lives until its last name goes. A link
/// to a link names the file the first one names.
fn vfs_link(v: &mut Vfs, n: u64, m: u64) -> u64
  requires vfs_ok(v) && n <= XFER && m <= XFER - n
  ensures vfs_ok(v)
{
  if n == 0 || m == 0 || n > FNAME_MAX || m > FNAME_MAX {
    return LINK_NONE;
  }
  let src_disk = on_disk(v, n);
  let src_lo = lo_pfx(&mut v, n) != 0;
  let f = vfs_lookup(&mut v, n);
  if f == NO_FILE {
    return LINK_NONE;
  }
  if vfs_is_dir(&mut v, f) {
    return LINK_DIR;
  }
  xfer_shift(&mut v.xfer, n, m);
  let new_disk = on_disk(v, m);
  let lp = lo_pfx(&mut v, m);
  if new_disk != src_disk || (lp != 0) != src_lo {
    return LINK_XDEV;
  }
  if !path_ok(v, m) || !parent_ok(&mut v, m) {
    return LINK_NONE;
  }
  if vfs_lookup(&mut v, m) != NO_FILE || vfs_dir_lookup(&mut v, m) != NO_FILE {
    return LINK_EXISTS;
  }
  if new_disk {
    if f < NFILES || f - NFILES >= DSLOTS || disk_link(&mut v.disk, v.xfer, DISK_PREFIX, m - DISK_PREFIX, f - NFILES, v.now) >= DSLOTS {
      return LINK_FULL;
    }
    return LINKED;
  }
  if lp != 0 {
    if v.lo_ro || f < LO0 || f >= HFILES {
      return LINK_FULL;
    }
    let e = disk_link(&mut v.lo, v.xfer, lp, m - lp, f - LO0, v.now);
    lo_settle(&mut v);
    if e >= DSLOTS {
      return LINK_FULL;
    }
    return LINKED;
  }
  if f >= NFILES || ram_link(&mut v.ram, v.xfer, m, f, v.now) >= NFILES {
    return LINK_FULL;
  }
  return LINKED;
}

/// vfs_unlink of disk file entry d, which hard link l also names: the
/// file takes the link's name and the link goes, committed by one sector
/// write (disk_take_name).
fn disk_unlink_named(v: &mut Vfs, d: u64, l: u64) -> bool
  requires vfs_ok(v) && d < DSLOTS && l < DSLOTS
  ensures vfs_ok(v)
{
  return disk_take_name(&mut v.disk, d, l);
}

// ---------------------------------------------------------------- exchange

const XCHG_TMP: u64 = 16;             // ".rename-exchange", a name at the disk's top

/// Swaps the files named xfer[0..n] and the m bytes after (neither a
/// directory, both on one file system: the caller checks). Descriptors
/// stay on their files. In memory the two nodes swap names at once. On
/// the disk it is three entry writes: the first file moves to a spare
/// name at the disk's top (".rename-exchange"), the second takes the
/// first's name, then the first takes the second's; a power cut in between
/// can leave the first file under the spare name. False, changing nothing,
/// if the spare name is taken or a name is not there.
fn vfs_exchange(v: &mut Vfs, n: u64, m: u64) -> bool
  requires vfs_ok(v) && n <= XFER && m <= XFER - n
  ensures vfs_ok(v)
{
  if n == 0 || m == 0 || n > FNAME_MAX || m > FNAME_MAX {
    return false;
  }
  if on_disk(v, n) {
    return dk_exchange(&mut v.disk, v.xfer, DISK_PREFIX, n, m);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let ok = !v.lo_ro && dk_exchange(&mut v.lo, v.xfer, lp, n, m);
    lo_settle(&mut v);
    return ok;
  }
  let i = ram_find(&mut v.ram, v.xfer, n);
  if i >= NFILES || n > NAMEBUF {
    return false;
  }
  // Keep the first name in v.name, and bring the second to the front.
  let mut c = 0;
  while c < n
    invariant c <= n && n <= FNAME_MAX && vfs_ok(v)
  {
    bset(&mut v.name, c, bget(v.xfer, c));
    c = c + 1;
  }
  xfer_shift(&mut v.xfer, n, m);
  let j = ram_find(&mut v.ram, v.xfer, m);
  let il = ram_len(&mut v.ram, i);
  let jl = ram_len(&mut v.ram, j % NFILES);
  if j >= NFILES || i == j || il == NO_FILE || jl == NO_FILE {
    return false;
  }
  return ram_reprefix(&mut v.ram, i, il, v.xfer, m) && ram_reprefix(&mut v.ram, j, jl, v.name, n);
}

/// vfs_exchange on disk file system d, where both names start p bytes in.
fn dk_exchange(d: &mut DiskFs, x: &Bytes, p: u64, n: u64, m: u64) -> bool
  requires disk_ok(d) && blen(x) == XFER && n <= XFER && m <= XFER - n && p < n
  ensures disk_ok(d)
{
  let i = disk_find(d, x, p, n - p);
  if i >= DSLOTS || n + p > XFER || m <= p {
    return false;
  }
  let j = disk_find(d, x, n + p, m - p);
  if j >= DSLOTS || i == j {
    return false;
  }
  let tmp = bfrom(".rename-exchange");
  if blen(tmp) != XCHG_TMP || disk_find(d, tmp, 0, XCHG_TMP) < DSLOTS
    || !disk_move(&mut d, i, tmp, 0, XCHG_TMP) {
    bfree(tmp);
    return false;
  }
  if !disk_move(&mut d, j, x, p, n - p) {
    disk_move(&mut d, i, x, p, n - p);     // back, as it was
    bfree(tmp);
    return false;
  }
  bfree(tmp);
  return disk_move(&mut d, i, x, n + p, m - p);
}

// ---------------------------------------------------------------- mounts

// A tmpfs mount is an in-memory directory marked in v.mnt: the files in
// it are ordinary in-memory nodes (the in-memory file system already is
// a tmpfs), so mounting only marks the directory, and unmounting removes
// everything under it. src/lxmount.bastio has the system calls.

/// The mount slot on in-memory node i, or MNT_N if none.
fn vfs_mount_slot(v: &Vfs, i: u64) -> u64
  requires vfs_ok(v) && i < NFILES
  ensures result <= MNT_N
{
  let mut s = 0;
  while s < MNT_N
    invariant s <= MNT_N
  {
    if get(v.mnt, 2 * s) == i + 1 {
      return s;
    }
    s = s + 1;
  }
  return MNT_N;
}

/// The in-memory node mount slot s is on, or NFILES if s is free.
fn vfs_mount_node(v: &Vfs, s: u64) -> u64
  requires vfs_ok(v) && s < MNT_N
  ensures result <= NFILES
{
  let i1 = get(v.mnt, 2 * s);
  if i1 == 0 || i1 > NFILES {
    return NFILES;
  }
  return i1 - 1;
}

/// Is mount slot s read-only?
fn vfs_mount_ro(v: &Vfs, s: u64) -> bool
  requires vfs_ok(v) && s < MNT_N
{
  return get(v.mnt, 2 * s + 1) == 1;
}

/// Mounts on in-memory directory node i. False if every slot is taken.
fn vfs_mount(v: &mut Vfs, i: u64, ro: bool) -> bool
  requires vfs_ok(v) && i < NFILES
  ensures vfs_ok(v)
{
  let mut s = 0;
  while s < MNT_N && get(v.mnt, 2 * s) != 0
    invariant s <= MNT_N && vfs_ok(v)
  {
    s = s + 1;
  }
  if s >= MNT_N {
    return false;
  }
  v.mnt = set(v.mnt, 2 * s, i + 1);
  vfs_set_ro(&mut v, s, ro);
  return true;
}

/// Makes mount slot s read-only or writable.
fn vfs_set_ro(v: &mut Vfs, s: u64, ro: bool)
  requires vfs_ok(v) && s < MNT_N
  ensures vfs_ok(v)
{
  let mut r = 0;
  if ro {
    r = 1;
  }
  v.mnt = set(v.mnt, 2 * s + 1, r);
}

/// Is a[..l] the same as b[..l]?
fn same_start(a: &Bytes, b: &Bytes, l: u64) -> bool
  requires l <= blen(a) && l <= blen(b)
{
  let mut j = 0;
  while j < l
    invariant j <= l
  {
    if bget(a, j) != bget(b, j) {
      return false;
    }
    j = j + 1;
  }
  return true;
}

/// Does the path in the first n bytes of the transfer buffer lie in a
/// read-only mount (or name its directory)?
fn vfs_ro(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  return vfs_in_mount(&mut v, n, true) || (v.lo_ro && vfs_in_lo(&mut v, n));
}

/// Does the path in the first n bytes of the transfer buffer lie in a
/// mount (a read-only one, if ro_only), or name its directory?
fn vfs_in_mount(v: &mut Vfs, n: u64, ro_only: bool) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if on_disk(v, n) {
    return false;
  }
  let mut s = 0;
  while s < MNT_N
    invariant s <= MNT_N && vfs_ok(v) && n <= XFER
  {
    let i = vfs_mount_node(v, s);
    if i < NFILES && (vfs_mount_ro(v, s) || !ro_only) {
      let l = ram_name(&mut v.ram, i, &mut v.name);
      if l != NO_FILE && l <= n && (l == n || bget(v.xfer, l) == 47) && same_start(v.xfer, v.name, l) {
        return true;
      }
    }
    s = s + 1;
  }
  return false;
}

/// Does file f (a vfs_lookup handle) lie in a mount? Uses the transfer
/// buffer.
fn vfs_file_in_mount(v: &mut Vfs, f: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  if f >= NFILES {
    return false;                           // on the disk
  }
  let l = ram_name(&mut v.ram, f, &mut v.xfer);
  if l == NO_FILE {
    return false;
  }
  return vfs_in_mount(&mut v, l, false);
}

/// Is anything under the in-memory directory named by the first n bytes
/// of the transfer buffer?
fn vfs_ram_has_children(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  let mut j = 0;
  while j < NFILES
    invariant j <= NFILES && vfs_ok(v) && n <= XFER
  {
    if ram_under(&mut v.ram, j, v.xfer, n) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// Does the first n bytes of the transfer buffer name a mount's directory?
fn vfs_is_mount(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if on_disk(v, n) {
    return false;
  }
  let i = ram_find(&mut v.ram, v.xfer, n);
  return i < NFILES && (vfs_mount_slot(v, i) < MNT_N || i + 1 == v.lo_at);
}

/// Unmounts slot s: removes every node under its directory (which stays,
/// as on Linux, where it shows again once uncovered). False, changing
/// nothing, if a file under it is open.
fn vfs_umount(v: &mut Vfs, mem: &mut Mem, s: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && s < MNT_N
  ensures vfs_ok(v) && mem_ok(mem)
{
  let i = vfs_mount_node(v, s);
  if i < NFILES {
    let l = ram_name(&mut v.ram, i, &mut v.name);
    if l != NO_FILE {
      let mut j = 0;
      while j < NFILES
        invariant j <= NFILES && vfs_ok(v) && mem_ok(mem) && l <= NAMEBUF
      {
        if ram_under(&mut v.ram, j, v.name, l) && (node_open(v.ftab, FS_RAM, j) || j == v.lo_file || j + 1 == v.lo_at) {
          return false;
        }
        j = j + 1;
      }
      j = 0;
      while j < NFILES
        invariant j <= NFILES && vfs_ok(v) && mem_ok(mem) && l <= NAMEBUF
      {
        if ram_under(&mut v.ram, j, v.name, l) {
          ram_remove(&mut v.ram, &mut mem, j);
        }
        j = j + 1;
      }
    }
  }
  v.mnt = set(v.mnt, 2 * s, 0);
  v.mnt = set(v.mnt, 2 * s + 1, 0);
  return true;
}

// ---------------------------------------------------------------- the loop mount

// A disk image in an in-memory file, attached to a loop device, mounted
// on an in-memory directory. The file's pages move into the mount's disk
// driver (src/loopblk.bastio) and come back at unmount; meanwhile the
// file cannot be written or truncated, and reading it gives zeros. One
// image at a time.

const LO_OK: u64 = 0;
const LO_BUSY: u64 = 1;               // already mounted, or the file is busy
const LO_NOFS: u64 = 2;               // no BastiOS file system on the image
const LO_NOMEM: u64 = 3;
const LO_NODEV: u64 = 255;            // lo_dev of an image mounted straight from its file

/// Mounts the disk image in in-memory file f on in-memory directory node
/// `at`, read-only if `ro`; dev is the loop device's number. The image
/// must already be formatted (mkfs.bstdisk3): an image with no file system
/// is refused rather than formatted.
fn vfs_lo_mount(v: &mut Vfs, mem: &mut Mem, f: u64, at: u64, dev: u64, ro: bool) -> u64
  requires vfs_ok(v) && mem_ok(mem) && f < NFILES && at < NFILES
  ensures vfs_ok(v) && mem_ok(mem)
{
  if v.lo_at != 0 || f == at || ram_is_dir(&mut v.ram, f) {
    return LO_BUSY;
  }
  let size = ram_size(&mut v.ram, f);
  if size == NO_FILE || size > FILE_MAX || size < 4096 * (DATA_B0 + 16) {
    return LO_NOFS;
  }
  // Is there a file system? The magic is in the first 8 bytes.
  if vfs_read_at(&mut v, f, 0, 8) != 8 {
    return LO_NOFS;
  }
  let magic = get_u64(v.xfer, 0);
  if magic != DISK_MAGIC && magic != DISK_MAGIC2 {
    return LO_NOFS;
  }
  pc_forget(&mut v.pc, &mut mem, f);                 // the loop driver owns its pages now
  let mut pages = ram_take_pages(&mut v.ram, f);
  let ok = loopdev_fill(&mut pages, &mut mem, (size + 4095) / 4096);
  v.lo_size = 0;
  let prev = lo_swap(&mut v, pages, size);
  if v.lo_size == 0 {
    ram_put_pages(&mut v.ram, &mut mem, f, prev);  // never: see lo_swap
    return LO_BUSY;
  }
  slots_free(prev, &mut mem);
  if !ok || v.lo.slots == 0 {
    lo_give_back(&mut v, &mut mem, f);
    if !ok {
      return LO_NOMEM;
    }
    return LO_NOFS;
  }
  v.lo_at = at + 1;
  v.lo_file = f;
  v.lo_dev = dev;
  v.lo_ro = ro;
  return LO_OK;
}

/// Unmounts the loop mount: the pages go back to the file. False if
/// nothing is mounted or a file in it is open.
fn vfs_lo_umount(v: &mut Vfs, mem: &mut Mem) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  if v.lo_at == 0 || v.lo_file >= NFILES {
    return false;
  }
  let mut r = 0;
  while r < FD_ROWS
    invariant r <= FD_ROWS && vfs_ok(v)
  {
    if fget(v.ftab, r, FD_FS) == FS_LO {
      return false;
    }
    r = r + 1;
  }
  let f = v.lo_file;
  lo_give_back(&mut v, &mut mem, f);
  v.lo_at = 0;
  v.lo_file = NFILES;
  if ram_len(&mut v.ram, f) == 0 && !node_open(v.ftab, FS_RAM, f) {
    ram_remove(&mut v.ram, &mut mem, f);  // its name was removed while it was mounted
  }
  return true;
}

/// Swaps an empty driver in for the loop mount's and puts its pages back
/// into in-memory file f (or frees them if f is gone).
fn lo_give_back(v: &mut Vfs, mem: &mut Mem, f: u64)
  requires vfs_ok(v) && mem_ok(mem) && f < NFILES
  ensures vfs_ok(v) && mem_ok(mem)
{
  ram_put_pages(&mut v.ram, &mut mem, f, lo_swap(&mut v, vec_new[Slot](), 0));
}

/// The file system the name in the first n bytes of the transfer buffer is
/// on: FS_DISK, FS_LO (below the loop mount's directory) or FS_RAM.
fn vfs_fs_of(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if on_disk(v, n) {
    return FS_DISK;
  }
  if lo_pfx(&mut v, n) != 0 {
    return FS_LO;
  }
  return FS_RAM;
}

/// Is a disk image mounted, and does the path in the first n bytes of the
/// transfer buffer lie in it (or name its directory)?
fn vfs_in_lo(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  return lo_pfx(&mut v, n) != 0 || lo_root(&mut v, n);
}
