// The file layer between system calls and file systems. It owns the table
// of open files and a kernel buffer that every transfer goes through:
// system calls copy user memory into the buffer or out of it
// (`usermem.bastio`), and the file systems below only ever see the buffer.
//
// There are two file systems: the in-memory one (`ramfs.bastio`) and the
// one on the ATA disk (`diskfs.bastio`). Names that start with "disk/" are
// on the disk; every other name is in memory. A second disk file system,
// on a disk image in a loop device (src/lxloop.bastio), can be mounted on
// an in-memory directory: names below that directory are in it (v.lo).
//
// Directories: a name is a path, and both file systems can hold directory
// nodes. A file "a/b" can only be created while the directory "a" exists,
// and a directory can only be removed while nothing is in it, so every
// parent of a file exists. "disk" itself is the disk's top directory; it
// is not a node, and no file in memory may take its name. Each open file records which
// file system it is on (FD_FS), and the few functions below dispatch on it;
// nothing above this file knows there are two.
//
// The table starts with FD_POOL rows that any Linux process takes a file's
// from (a description names its row), then NFD rows per process for the
// native calls: a process names those by row number, so one process can
// never reach another's.

import "pages.bastio";
import "ramfs.bastio";
import "diskfs.bastio";
import "pcache.bastio";

const NFD: u64 = 64;                  // rows a process's native calls and the kernel's own opens use
const FD_POOL: u64 = 4096;            // rows first in the table, for the files Linux descriptors name: any process may take any (OFD_N)
const FD_ROWS: u64 = 69632;           // FD_POOL + NPROC * NFD
const FD_STRIDE: u64 = 4;
const HOLD_N: u64 = 512;              // holds (vfs_hold), in their own table
const HOLD_LEN: u64 = 2048;           // HOLD_N * FD_STRIDE
const FTAB_LEN: u64 = FD_ROWS * FD_STRIDE;   // the most the table grows to (new_pid, src/proc.bastio)
const FTAB_START: u64 = 24576;        // what it starts with: the pool and 32 processes' rows ((FD_POOL + PGROW * NFD) * FD_STRIDE)
const ZEROS: u64 = 160;                // the longest lx_fill
const XFER: u64 = 4096;               // the most bytes one call moves

/// The first row of process pid's native block.
fn nbase(pid: u64) -> u64
  requires pid < 1024                 // NPROC (src/proc.bastio)
  ensures result + NFD <= FD_ROWS && result == FD_POOL + pid * NFD
{
  return FD_POOL + pid * NFD;
}

// Row fields.
const FD_FS: u64 = 0;                 // 0: row unused; otherwise the file system
const FD_NODE: u64 = 1;               // the file within its file system
const FD_OFF: u64 = 2;                // the offset the next read or write uses
const FD_MODE: u64 = 3;               // O_READ | O_WRITE | O_APPEND

const FS_RAM: u64 = 1;
const FS_DISK: u64 = 2;
const FS_LO: u64 = 3;                 // the disk image mounted on a loop device
const DISK_PREFIX: u64 = 5;           // "disk/"

// Open flags (the system call ABI).
const O_READ: u64 = 1;
const O_WRITE: u64 = 2;
const O_CREATE: u64 = 4;
const O_TRUNC: u64 = 8;
const O_APPEND: u64 = 16;

const NO_FD: u64 = 18446744073709551615;
const VFS_MISS: u64 = 18446744073709551614;     // the disk has not caught up: sleep, then try again

// File handles: in-memory nodes, then the disk's entries, then those of
// the loop mount. Directory handles besides the nodes (vfs_dir_lookup,
// vfs_readdir) come after them.
const LO0: u64 = NFILES + DSLOTS;     // the loop mount's entry e is LO0 + e
const HFILES: u64 = NFILES + 2 * DSLOTS;   // every file handle is below this
const NOPEN: u64 = HFILES;           // the files nopen counts (slot NOPEN, past them, is where any other (fs, node) would go: never stored)
const NOPEN_START: u64 = NFILES;      // what nopen starts with (NFILES: the in-memory nodes); it doubles as disk entries are opened

spec fn nopen_ok(n: &Buf) -> bool {
  len(n) >= NFILES && len(n) <= NOPEN
}

const VDIR_ROOT: u64 = NFILES + 2 * DSLOTS;  // the top directory
const VDIR_DISK: u64 = NFILES + 2 * DSLOTS + 1;  // "disk"
const VDIR_LO: u64 = NFILES + 2 * DSLOTS + 2;    // the loop mount's top directory
const NAMEBUF: u64 = 256;             // holds any in-memory node's name
const MNT_N: u64 = 64;                // tmpfs mounts at once
const MNT_LEN: u64 = 128;             // MNT_N * 2: per mount, its directory node + 1 (0: free) and 1 if read-only

struct Vfs {
  ram: Vec[Node],       // the in-memory file system
  ftab: Buf,            // open files: NFD rows of FD_STRIDE words per process, as many processes as the process table has rows
  holds: Buf,           // HOLD_N holds of FD_STRIDE words
  xfer: Bytes,          // the transfer buffer
  zeros: Bytes,         // ZEROS zero bytes, never written: lx_fill copies from it
  disk: DiskFs,         // the file system on the disk
  name: Bytes,          // a directory's name, while vfs_readdir lists it
  mnt_hi: u64,          // one past the highest mount slot ever used (vfs_mount): the slots from here on are free
  mnt: Buf,             // tmpfs mounts on in-memory directories (src/lxmount.bastio)
  now: u64,             // the time, in seconds, for modification times
  lo: DiskFs,           // the file system on a loop device's image (no blocks: none mounted)
  lname: Bytes,         // the loop mount's directory name, while a call routes a path
  lo_at: u64,           // the in-memory directory the loop mount is on, + 1 (0: none)
  lo_file: u64,         // the in-memory file whose pages the loop mount holds
  lo_size: u64,         // that file's size at the mount
  lo_dev: u64,          // the loop device's number
  lo_ro: bool,          // mounted read-only
  pc: PCache,           // file pages that MAP_SHARED mappings share (src/pcache.bastio)
  rix: Buf,             // the name index of ram (src/ramfs.bastio)
  rhi: u64,             // every in-memory file is in a node below this (ram_find looks no further); only grows
  nopen: Buf,           // per file (nslot): how many rows and holds are open on it; node_open reads this instead of scanning ftab
  pool_hi: u64,         // every open row in the pool is below this (file_writing scans no further); only grows
  nat_hi: u64,          // one past the highest row past the pool (a native process's) ever opened, 0 if none: every open one is below it (file_writing scans no further)
}

spec fn vfs_ok(v: &Vfs) -> bool {
  nodes_ok(v.ram) && rix_ok(v.rix) && v.rhi <= NFILES && v.pool_hi <= FD_POOL && len(v.ftab) <= FTAB_LEN && len(v.holds) == HOLD_LEN && blen(v.xfer) == XFER && blen(v.zeros) == ZEROS && disk_ok(v.disk) && blen(v.name) == NAMEBUF && len(v.mnt) == MNT_LEN && v.mnt_hi <= MNT_N && nopen_ok(v.nopen)
    && disk_ok(v.lo) && blen(v.lname) == NAMEBUF && pc_ok(v.pc) && v.nat_hi <= FD_ROWS
}

fn vfs_new(disk: DiskFs) -> Vfs
  requires disk_ok(disk)
  ensures vfs_ok(result)
{
  return Vfs { ram: ram_new(), ftab: alloc(FTAB_START), holds: alloc(HOLD_LEN), xfer: balloc(XFER), zeros: balloc(ZEROS), disk: disk, name: balloc(NAMEBUF), mnt: alloc(MNT_LEN), mnt_hi: 0, now: 0,
    lo: disk_mount(Blk::Loop(loopdev_new(vec_new[Slot](), 0)), DM_WHOLE, NC_STD), lname: balloc(NAMEBUF), lo_at: 0, lo_file: NFILES, lo_size: 0, lo_dev: 0, lo_ro: false, pc: pc_new(), nopen: alloc(NOPEN_START), rix: alloc(KBASE + KB), rhi: 0, pool_hi: 0, nat_hi: 0 };
}

/// ram_create of the name in the transfer buffer, noting the node in `rhi`
/// so ram_find reaches it. Every creation in memory goes through this, or
/// through vfs_ram_link, or notes `rhi` itself (vfs_install_bytes, which creates from its own buffer).
fn vfs_ram_create(v: &mut Vfs, n: u64, dir: bool) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v) && result <= NFILES
{
  let i = ram_create(&mut v.ram, &mut v.rix, v.xfer, n, dir, v.now);
  if i < NFILES && i >= v.rhi {
    v.rhi = i + 1;
  }
  return i;
}

/// ram_link, noting the new node in `rhi`.
fn vfs_ram_link(v: &mut Vfs, n: u64, t: u64) -> u64
  requires vfs_ok(v) && n <= XFER && t < NFILES
  ensures vfs_ok(v) && result <= NFILES
{
  let i = ram_link(&mut v.ram, &mut v.rix, v.xfer, n, t, v.now);
  if i < NFILES && i >= v.rhi {
    v.rhi = i + 1;
  }
  return i;
}

/// The next byte typed on a USB keyboard that sits on the disk's xHCI
/// controller (see blk_find), a packet from a USB mouse there (MOUSE_PKT
/// plus its bytes), or 256.
fn vfs_kbd_poll(v: &mut Vfs) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v) && (result <= 256 || (result >= MOUSE_PKT && result < 2 * MOUSE_PKT) || (result >= SER_PKT && result < SER_PKT + 256))
{
  return blk_kbd_poll(&mut v.disk.dev);
}

/// SER_NONE, SER_FTDI or SER_ACM: is there a USB serial port on the disk's
/// xHCI controller?
fn vfs_ser(v: &Vfs) -> u64
  requires vfs_ok(v)
  ensures result <= SER_ACM
{
  return blk_ser(v.disk.dev);
}

/// Sends the first n bytes of src to that port: how many it took.
fn vfs_ser_send(v: &mut Vfs, src: &Bytes, n: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v) && result <= n && result <= blen(src)
{
  return blk_ser_send(&mut v.disk.dev, src, n);
}

/// The disk drivers a file system hands back at power off: the disk's and
/// the loop mount's. Their ports and registers are the architecture's to
/// release (`blk_free`).
struct VfsDevs { disk: Blk, lo: Blk }

/// Frees everything (at power off): every in-memory file's pages go back
/// (a loop mount's too), and the disk drivers are handed back so their ports
/// can be released.
fn vfs_free(v: Vfs, mem: &mut Mem) -> VfsDevs
  requires vfs_ok(v) && mem_ok(mem)
  ensures mem_ok(mem) && blk_ok(result.disk) && blk_ok(result.lo)
{
  ram_free(v.ram, &mut mem);
  free(v.ftab);
  free(v.holds);
  free(v.rix);
  free(v.nopen);
  bfree(v.xfer);
  bfree(v.zeros);
  bfree(v.name);
  bfree(v.lname);
  free(v.mnt);
  pc_free(v.pc, &mut mem);
  return VfsDevs { disk: disk_unmount(v.disk), lo: disk_unmount(v.lo) };
}

/// Puts a loop driver over `pages` (an image of size bytes) in as the
/// loop mount's and returns the pages of the one it replaces, setting
/// v.lo_size to size. Only loop drivers are ever put there; were it any
/// other, it would stay, and `pages` would come back with v.lo_size as it
/// was.
fn lo_swap(v: &mut Vfs, pages: Vec[Slot], size: u64) -> Vec[Slot]
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let s = blk_loop_swap(disk_unmount(v.lo), pages, size);
  v.lo = disk_mount(s.dev, DM_WHOLE, NC_STD);
  if s.swapped {
    v.lo_size = size;
  }
  return s.pages;
}

/// Mounts the disk afresh as the BastiOS partition of its GPT (what boot
/// does without the option `install`): the installer, which has just made
/// the partition, then fills it through the file system.
fn vfs_mount_target(v: &mut Vfs)
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  v.disk = disk_mount(disk_unmount(v.disk), DM_GPT, NC_STD);
}

/// Is the name in the first n bytes of the transfer buffer on the disk
/// ("disk/" and at least one more byte)?
fn on_disk(v: &Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures result ==> DISK_PREFIX < n
{
  if n <= DISK_PREFIX {
    return false;
  }
  return bget(v.xfer, 0) == 100 && bget(v.xfer, 1) == 105 && bget(v.xfer, 2) == 115
    && bget(v.xfer, 3) == 107 && bget(v.xfer, 4) == 47;
}

/// When a disk image is mounted on a loop device and the name in the first
/// n bytes of the transfer buffer lies below its directory, the length of
/// that directory's name and the "/" after it (less than n); else 0.
fn lo_pfx(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v) && (result == 0 || result < n)
{
  if v.lo_at == 0 || v.lo_at > NFILES {
    return 0;
  }
  let l = ram_name(&mut v.ram, v.lo_at - 1, &mut v.lname);
  if l == NO_FILE || l + 1 >= n || bget(v.xfer, l) != 47 || !same_start(v.xfer, v.lname, l) {
    return 0;
  }
  return l + 1;
}

/// Is the name in the first n bytes of the transfer buffer the directory
/// the loop mount is on?
fn lo_root(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if v.lo_at == 0 || v.lo_at > NFILES {
    return false;
  }
  let l = ram_name(&mut v.ram, v.lo_at - 1, &mut v.lname);
  return l == n && same_start(v.xfer, v.lname, l);
}

/// Lets the loop mount's queued commands run (they finish at once).
fn lo_settle(v: &mut Vfs)
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  disk_drain(&mut v.lo);
  v.lo.txn = 0;
}

// A row past the table's end (a process the table has not grown to yet)
// reads as closed, and writing it does nothing: open_row only opens rows
// the table has.
fn fget(t: &Buf, row: u64, f: u64) -> u64
  requires len(t) <= FTAB_LEN && row < FD_ROWS && f < FD_STRIDE
{
  if row * FD_STRIDE + f >= len(t) {
    return 0;
  }
  return get(t, row * FD_STRIDE + f);
}

fn fset(t: &mut Buf, row: u64, f: u64, x: u64)
  requires len(t) <= FTAB_LEN && row < FD_ROWS && f < FD_STRIDE
  ensures len(t) == old(len(t))
{
  if row * FD_STRIDE + f < len(t) {
    t = set(t, row * FD_STRIDE + f, x);
  }
}

/// Where nopen counts node i of file system fs (NOPEN for an unknown one).
/// The disk's entries and the loop mount's alternate, so the table grows
/// in step with whichever is open.
fn nslot(fs: u64, i: u64) -> u64
  ensures result <= NOPEN
{
  if fs == FS_RAM && i < NFILES {
    return i;
  }
  if fs == FS_DISK && i < DSLOTS {
    return NFILES + 2 * i;
  }
  if fs == FS_LO && i < DSLOTS {
    return NFILES + 2 * i + 1;
  }
  return NOPEN;
}

/// Makes room in nopen for slot `at` (below NOPEN): the table doubles,
/// the counts stay, and the new ones are 0 (the kernel's allocator reuses a
/// freed block only for a buffer of the same size). False, with n as it was,
/// when memory runs out.
fn nopen_room(n: &mut Buf, at: u64) -> bool
  requires nopen_ok(n) && at < NOPEN
  ensures nopen_ok(n) && (result ==> at < len(n))
{
  if at < len(n) {
    return true;
  }
  let mut want = len(n) * 2;
  if want <= at {
    want = at + 1;
  }
  if want > NOPEN {
    want = NOPEN;
  }
  let mut nt = try_alloc(want);
  if len(nt) != want {
    free(nt);
    return false;
  }
  let mut j = 0;
  while j < len(n)
    invariant j <= len(n) && len(n) <= want && len(nt) == want
  {
    nt = set(nt, j, get(n, j));
    j = j + 1;
  }
  let prev = n;
  n = nt;
  free(prev);
  return true;
}

/// One more row or hold open on node i of file system fs.
fn nopen_add(n: &mut Buf, fs: u64, i: u64)
  requires nopen_ok(n)
  ensures nopen_ok(n)
{
  let at = nslot(fs, i);
  if at >= NOPEN || !nopen_room(&mut n, at) {
    return;
  }
  let c = get(n, at);
  if c < 0x100000000 {
    n = set(n, at, c + 1);
  }
}

/// One fewer.
fn nopen_sub(n: &mut Buf, fs: u64, i: u64)
  requires nopen_ok(n)
  ensures nopen_ok(n)
{
  let at = nslot(fs, i);
  if at >= len(n) {
    return;
  }
  let c = get(n, at);
  if c > 0 {
    n = set(n, at, c - 1);
  }
}

/// Is any row open on node i of file system fs, or any hold on it? Each
/// open and hold counts itself in `nopen` (open_row, ram_open, vfs_hold)
/// and each close takes itself out (vfs_close, vfs_unhold), so this is one
/// read, not a pass over every process's rows (which close, unlink and
/// rename did each time: a third of an open/close pair). A slot past the
/// end of the table has never been counted: nothing is open on it.
fn node_open(n: &Buf, fs: u64, i: u64) -> bool
  requires nopen_ok(n)
{
  let at = nslot(fs, i);
  if at >= len(n) {
    return false;
  }
  return get(n, at) > 0;
}

/// Opens the file named by the first n bytes of the transfer buffer in a
/// free row of base to base + rows - 1: a process's block (nbase) or the
/// pool (FD_POOL rows from 0). Returns the row less `base` (0 to
/// rows - 1) or NO_FD: no such file without O_CREATE, no room, or a name
/// that is empty or too long.
fn vfs_open(v: &mut Vfs, mem: &mut Mem, base: u64, rows: u64, flags: u64, n: u64) -> u64
  requires vfs_ok(v) && mem_ok(mem) && base + rows <= FD_ROWS && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
  ensures result < rows || result == NO_FD
{
  let fd = open_row(&mut v, &mut mem, base, rows, flags, n);
  if fd < rows && flags / O_TRUNC % 2 == 1 && flags / O_WRITE % 2 == 1 {
    pc_resize(&mut v.pc, &mut mem, vfs_row_file(v, base + fd), 0);
  }
  return fd;
}

/// vfs_open without the page cache's upkeep.
fn open_row(v: &mut Vfs, mem: &mut Mem, base: u64, rows: u64, flags: u64, n: u64) -> u64
  requires vfs_ok(v) && mem_ok(mem) && base + rows <= FD_ROWS && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
  ensures result < rows || result == NO_FD
{
  if (base + rows) * FD_STRIDE > len(v.ftab) {
    return NO_FD;                           // the table has not grown to this process
  }
  let mut fd = 0;
  while fd < rows && fget(v.ftab, base + fd, FD_FS) != 0
    invariant fd <= rows
  {
    fd = fd + 1;
  }
  if fd >= rows {
    return NO_FD;
  }
  if base + fd < FD_POOL {
    if base + fd >= v.pool_hi {
      v.pool_hi = base + fd + 1;
    }
  } else if base + fd >= v.nat_hi {
    v.nat_hi = base + fd + 1;
  }
  if on_disk(v, n) {
    let mk = path_ok(v, n) && parent_ok(&mut v, n);
    if !dk_open(&mut v.disk, &mut v.ftab, &mut v.nopen, &mut v.pc, &mut mem, v.xfer, base + fd, flags, DISK_PREFIX, n, FS_DISK, mk, v.now) {
      return NO_FD;
    }
    return fd;
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let mk = path_ok(v, n) && parent_ok(&mut v, n);
    let r = dk_open(&mut v.lo, &mut v.ftab, &mut v.nopen, &mut v.pc, &mut mem, v.xfer, base + fd, flags, lp, n, FS_LO, mk && !v.lo_ro, v.now);
    lo_settle(&mut v);
    if !r {
      return NO_FD;
    }
    return fd;
  }
  let mut i = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, n);
  if i < NFILES && ram_has_links(v.rix) {
    let t = ram_link_of(&mut v.ram, i);
    if t < NFILES {
      i = t;
    }
  }
  if i >= NFILES {
    if flags / O_CREATE % 2 == 0 || !path_ok(v, n) || !parent_ok(&mut v, n) {
      return NO_FD;
    }
    i = vfs_ram_create(&mut v, n, false);
    if i >= NFILES {
      return NO_FD;
    }
    pc_forget(&mut v.pc, &mut mem, i);
  } else if ram_is_dir(&mut v.ram, i) {
    return NO_FD;
  }
  if flags / O_WRITE % 2 == 1 && i == v.lo_file {
    return NO_FD;                       // a mounted disk image is not written through its file
  }
  if flags / O_TRUNC % 2 == 1 && flags / O_WRITE % 2 == 1 {
    match take_node(&mut v.ram, i) {
      Node::Free => {},
      Node::File(f) => {
        let mut g = f;
        file_truncate(&mut g, &mut mem);
        g.mtime = v.now;
        put_node(&mut v.ram, i, Node::File(g));
      },
    }
  }
  nopen_add(&mut v.nopen, FS_RAM, i);
  fset(&mut v.ftab, base + fd, FD_FS, FS_RAM);
  fset(&mut v.ftab, base + fd, FD_NODE, i);
  fset(&mut v.ftab, base + fd, FD_OFF, 0);
  fset(&mut v.ftab, base + fd, FD_MODE, flags % (2 * O_APPEND));
  return fd;
}

/// Opens RAM file node i, which may have no name left (a file unlinked while
/// it was open), in a free row of base to base + rows - 1: the row less
/// `base`, or NO_FD if there is none free or i is no file.
fn vfs_open_node(v: &mut Vfs, base: u64, rows: u64, flags: u64, i: u64) -> u64
  requires vfs_ok(v) && base + rows <= FD_ROWS && i < NFILES
  ensures vfs_ok(v)
  ensures result < rows || result == NO_FD
{
  if (base + rows) * FD_STRIDE > len(v.ftab) {
    return NO_FD;                           // the table has not grown to this process
  }
  if ram_len(&mut v.ram, i) == NO_FILE || ram_is_dir(&mut v.ram, i) {
    return NO_FD;
  }
  let mut fd = 0;
  while fd < rows && fget(v.ftab, base + fd, FD_FS) != 0
    invariant fd <= rows
  {
    fd = fd + 1;
  }
  if fd >= rows {
    return NO_FD;
  }
  if base + fd < FD_POOL {
    if base + fd >= v.pool_hi {
      v.pool_hi = base + fd + 1;
    }
  } else if base + fd >= v.nat_hi {
    v.nat_hi = base + fd + 1;
  }
  nopen_add(&mut v.nopen, FS_RAM, i);
  fset(&mut v.ftab, base + fd, FD_FS, FS_RAM);
  fset(&mut v.ftab, base + fd, FD_NODE, i);
  fset(&mut v.ftab, base + fd, FD_OFF, 0);
  fset(&mut v.ftab, base + fd, FD_MODE, flags % (2 * O_APPEND));
  return fd;
}

/// vfs_open for a name on disk file system d (file system fs in the
/// table), whose names start p bytes in, into the free row `row`. It may
/// create the file only if `mk` (a good name whose directory exists).
/// False if it cannot be opened.
fn dk_open(d: &mut DiskFs, ftab: &mut Buf, nopen: &mut Buf, pc: &mut PCache, mem: &mut Mem, x: &Bytes, row: u64, flags: u64, p: u64, n: u64, fs: u64, mk: bool, now: u64) -> bool
  requires disk_ok(d) && len(ftab) <= FTAB_LEN && nopen_ok(nopen) && row < FD_ROWS && p < n && n <= blen(x) && pc_ok(pc) && mem_ok(mem)
  ensures disk_ok(d) && len(ftab) <= FTAB_LEN && nopen_ok(nopen) && pc_ok(pc) && mem_ok(mem)
{
  let mut i = disk_find(d, x, p, n - p);
  if i < DSLOTS && disk_link_of(d, i) < DSLOTS {
    i = disk_link_of(d, i);
  }
  if i >= DSLOTS {
    if flags / O_CREATE % 2 == 0 || !mk {
      return false;
    }
    i = disk_create(&mut d, x, p, n - p, false, now);
    if i >= DSLOTS {
      return false;
    }
    pc_forget(&mut pc, &mut mem, fs_handle(fs, i));
  } else if dent_dir(d, i) {
    return false;
  }
  if flags / O_TRUNC % 2 == 1 && flags / O_WRITE % 2 == 1 {
    if !disk_truncate(&mut d, i, now) {
      return false;
    }
  }
  nopen_add(&mut nopen, fs, i);
  fset(&mut ftab, row, FD_FS, fs);
  fset(&mut ftab, row, FD_NODE, i);
  fset(&mut ftab, row, FD_OFF, 0);
  fset(&mut ftab, row, FD_MODE, flags % (2 * O_APPEND));
  return true;
}

/// Closes a row. Returns false if it was not open.
fn vfs_close(v: &mut Vfs, mem: &mut Mem, row: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS
  ensures vfs_ok(v) && mem_ok(mem)
{
  let fs = fget(v.ftab, row, FD_FS);
  let node = fget(v.ftab, row, FD_NODE);
  if fs == 0 {
    return false;
  }
  let h = vfs_row_file(v, row);
  let mut f = 0;
  while f < FD_STRIDE
    invariant f <= FD_STRIDE && len(v.ftab) <= FTAB_LEN
  {
    fset(&mut v.ftab, row, f, 0);
    f = f + 1;
  }
  nopen_sub(&mut v.nopen, fs, node);
  node_settle(&mut v, &mut mem, fs, node, h);
  return true;
}

/// Node `node` of file system `fs` (handle h) lost a row or a hold. The
/// last close of a file removed while open frees it, and its cached pages.
/// A closed file that still exists keeps its pages in the page cache, so
/// the next run of a program finds its code there, and the next mmap of a
/// MAP_SHARED page the page that other processes may still map. A handle can be freed
/// with pages cached (a file removed while closed); whatever makes a new
/// file under it drops them first (pc_forget at each create), so a handle
/// never names another file's pages.
fn node_settle(v: &mut Vfs, mem: &mut Mem, fs: u64, node: u64, h: u64)
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  if !node_open(v.nopen, fs, node) {
    if fs == FS_RAM && node < NFILES && ram_len(&mut v.ram, node) == 0 && node != v.lo_file {
      pc_forget(&mut v.pc, &mut mem, h);
      ram_remove(&mut v.ram, &mut v.rix, &mut mem, node);
    } else if fs == FS_DISK && node < DSLOTS && dent_orphan(v.disk, node) {
      pc_forget(&mut v.pc, &mut mem, h);
      disk_remove(&mut v.disk, node);
    } else if fs == FS_LO && node < DSLOTS && dent_orphan(v.lo, node) {
      pc_forget(&mut v.pc, &mut mem, h);
      disk_remove(&mut v.lo, node);
      lo_settle(&mut v);
    }
  }
}

/// The handle of entry i of disk file system fs (FS_DISK or FS_LO).
fn fs_handle(fs: u64, i: u64) -> u64
  requires i < DSLOTS
  ensures result < HFILES
{
  if fs == FS_LO {
    return LO0 + i;
  }
  return NFILES + i;
}

/// Holds file handle h (in memory or on the disk, not the loop mount)
/// open without a descriptor, as a running program holds the file it was
/// started from (src/lazy.bastio): removing its name leaves it in place
/// until vfs_unhold, so the handle never names another file meanwhile.
/// Returns the hold, with one reference (vfs_hold_dup adds more), or
/// HOLD_N if h is no such file or every hold is taken.
fn vfs_hold(v: &mut Vfs, h: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v) && result <= HOLD_N
{
  let mut fs = 0;
  let mut node = 0;
  if h < NFILES {
    fs = FS_RAM;
    node = h;
  } else if h < NFILES + DSLOTS {
    fs = FS_DISK;
    node = h - NFILES;
  } else {
    return HOLD_N;
  }
  if vfs_size(&mut v, h) == NO_FILE {
    return HOLD_N;
  }
  let mut i = 0;
  while i < HOLD_N && get(v.holds, i * FD_STRIDE + FD_FS) != 0
    invariant i <= HOLD_N && vfs_ok(v)
  {
    i = i + 1;
  }
  if i < HOLD_N {
    v.holds = set(v.holds, i * FD_STRIDE + FD_FS, fs);
    v.holds = set(v.holds, i * FD_STRIDE + FD_NODE, node);
    v.holds = set(v.holds, i * FD_STRIDE + FD_OFF, 1);   // its references
    nopen_add(&mut v.nopen, fs, node);
  }
  return i;
}

/// One more reference to hold i (a forked process's).
fn vfs_hold_dup(v: &mut Vfs, i: u64)
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  if i < HOLD_N && get(v.holds, i * FD_STRIDE + FD_FS) != 0 {
    let at = i * FD_STRIDE + FD_OFF;
    if get(v.holds, at) < 4294967296 {
      v.holds = set(v.holds, at, get(v.holds, at) + 1);
    }
  }
}

/// The file handle hold i is on, or NO_FILE.
fn vfs_held(v: &Vfs, i: u64) -> u64
  requires vfs_ok(v)
  ensures result < HFILES || result == NO_FILE
{
  if i >= HOLD_N {
    return NO_FILE;
  }
  let fs = get(v.holds, i * FD_STRIDE + FD_FS);
  let node = get(v.holds, i * FD_STRIDE + FD_NODE);
  if fs == FS_RAM && node < NFILES {
    return node;
  }
  if fs == FS_DISK && node < DSLOTS {
    return NFILES + node;
  }
  return NO_FILE;
}

/// Drops a reference to hold i; with the last, lets go of the file (a
/// file whose names are all gone goes with it).
fn vfs_unhold(v: &mut Vfs, mem: &mut Mem, i: u64)
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  let h = vfs_held(v, i);
  if i >= HOLD_N || h == NO_FILE {
    return;
  }
  let at = i * FD_STRIDE + FD_OFF;
  if get(v.holds, at) > 1 {
    v.holds = set(v.holds, at, get(v.holds, at) - 1);
    return;
  }
  v.holds = set(v.holds, at, 0);
  let fs = get(v.holds, i * FD_STRIDE + FD_FS);
  let node = get(v.holds, i * FD_STRIDE + FD_NODE);
  v.holds = set(v.holds, i * FD_STRIDE + FD_FS, 0);
  v.holds = set(v.holds, i * FD_STRIDE + FD_NODE, 0);
  nopen_sub(&mut v.nopen, fs, node);
  node_settle(&mut v, &mut mem, fs, node, h);
}

/// Closes every row of process row block `base` (when the process ends).
fn vfs_close_all(v: &mut Vfs, mem: &mut Mem, base: u64)
  requires vfs_ok(v) && mem_ok(mem) && base + NFD <= FD_ROWS
  ensures vfs_ok(v) && mem_ok(mem)
{
  let mut fd = 0;
  while fd < NFD
    invariant fd <= NFD && vfs_ok(v) && mem_ok(mem)
  {
    vfs_close(&mut v, &mut mem, base + fd);
    fd = fd + 1;
  }
}

/// Reads up to n bytes from the file open in `row`, at its offset, into the
/// start of the transfer buffer. Returns the count (0 at the end of the
/// file) or NO_FD if the row is not open for reading. The offset does not
/// move: the caller advances it by what reached the user (vfs_advance).
/// On the disk, VFS_MISS if what it needs is not in the cache yet: reads
/// are queued, and the caller sleeps and tries again (disk_read).
fn vfs_read(v: &mut Vfs, mem: &mut Mem, row: u64, n: u64) -> u64
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
  ensures result <= n || result == NO_FD || result == VFS_MISS
{
  let off = fget(v.ftab, row, FD_OFF);
  let node = fget(v.ftab, row, FD_NODE);
  let mut on_disk = false;
  if fget(v.ftab, row, FD_FS) == FS_DISK && node < DSLOTS && fget(v.ftab, row, FD_MODE) / O_READ % 2 == 1 {
    on_disk = true;
    if pc_on(v.pc) {
      // Pages cached by earlier reads (pc_fill) or mappings answer without
      // the disk.
      let size = disk_size(v.disk, node);
      if size != NO_DISK_FILE && off < size {
        let mut want = size - off;
        if want > n {
          want = n;
        }
        let f = vfs_row_file(v, row);
        if pc_have(&mut v.pc, f, off, want) {
          pc_overlay(&mut v.pc, f, off, &mut v.xfer, want);
          return want;
        }
      }
    }
  }
  let r = read_row(&mut v, row, n);
  if r <= n {
    let f = vfs_row_file(v, row);
    pc_overlay(&mut v.pc, f, off, &mut v.xfer, r);
    if on_disk {
      pc_fill(&mut v.pc, &mut mem, f, off, v.xfer, r, r < n);
    }
  }
  return r;
}

/// vfs_read without the page cache's bytes over the file's.
fn read_row(v: &mut Vfs, row: u64, n: u64) -> u64
  requires vfs_ok(v) && row < FD_ROWS && n <= XFER
  ensures vfs_ok(v)
  ensures result <= n || result == NO_FD || result == VFS_MISS
{
  if fget(v.ftab, row, FD_MODE) / O_READ % 2 == 0 {
    return NO_FD;
  }
  let i = fget(v.ftab, row, FD_NODE);
  let fs = fget(v.ftab, row, FD_FS);
  if fs == FS_DISK && i < DSLOTS {
    let r = disk_read(&mut v.disk, i, fget(v.ftab, row, FD_OFF), &mut v.xfer, n);
    if r == NO_DISK_FILE {
      return NO_FD;
    }
    if r == DISK_MISS {
      return VFS_MISS;
    }
    return r;
  }
  if fs == FS_LO && i < DSLOTS {
    let r = disk_read_wait(&mut v.lo, i, fget(v.ftab, row, FD_OFF), &mut v.xfer, n);
    if r == NO_DISK_FILE {
      return NO_FD;
    }
    return r;
  }
  if fs != FS_RAM || i >= NFILES {
    return NO_FD;
  }
  return read_at(&mut v, i, fget(v.ftab, row, FD_OFF), n);
}

/// Writes the first n bytes of the transfer buffer to the file open in
/// `row`, at its offset (at the end with O_APPEND), and moves the offset
/// past them. Returns the count, short if memory or the file size limit
/// runs out, or NO_FD if the row is not open for writing. On the disk the
/// write is queued (the caller waits for v.disk.txn before returning to
/// the user), or VFS_MISS if old blocks it needs are not cached yet: the
/// caller sleeps and tries again (disk_write).
fn vfs_write(v: &mut Vfs, mem: &mut Mem, row: u64, n: u64) -> u64
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
  ensures result <= n || result == NO_FD || result == VFS_MISS
{
  let f = vfs_row_file(v, row);
  let mut was = NO_FILE;
  if pc_any(v.pc, f) {
    was = vfs_size(&mut v, f);
  }
  let w = write_row(&mut v, &mut mem, row, n);
  let end = fget(v.ftab, row, FD_OFF);
  if w <= n && w <= end {
    if was != NO_FILE && end > was {
      pc_zero_tail(&mut v.pc, f, was);
    }
    pc_wrote(&mut v.pc, f, end - w, v.xfer, w);
    if fget(v.ftab, row, FD_FS) == FS_DISK {
      // The pages this write filled whole are what a reader of the file, or
      // a mapping of it, wants next: cache them (as a read does) instead of
      // reading them back from the disk.
      pc_fill(&mut v.pc, &mut mem, f, end - w, v.xfer, w, false);
    }
  }
  return w;
}

/// vfs_write without copying the bytes into the page cache.
fn write_row(v: &mut Vfs, mem: &mut Mem, row: u64, n: u64) -> u64
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
  ensures result <= n || result == NO_FD || result == VFS_MISS
{
  if fget(v.ftab, row, FD_MODE) / O_WRITE % 2 == 0 {
    return NO_FD;
  }
  let i = fget(v.ftab, row, FD_NODE);
  if fget(v.ftab, row, FD_FS) == FS_DISK && i < DSLOTS {
    let mut off = fget(v.ftab, row, FD_OFF);
    if fget(v.ftab, row, FD_MODE) / O_APPEND % 2 == 1 {
      off = disk_size(v.disk, i);
    }
    let w = disk_write(&mut v.disk, i, off, v.xfer, n, v.now);
    if w == NO_DISK_FILE {
      return NO_FD;
    }
    if w == DISK_MISS {
      return VFS_MISS;
    }
    vfs_advance(&mut v, row, off, w);
    return w;
  }
  if fget(v.ftab, row, FD_FS) == FS_LO && i < DSLOTS {
    let mut off = fget(v.ftab, row, FD_OFF);
    if fget(v.ftab, row, FD_MODE) / O_APPEND % 2 == 1 {
      off = disk_size(v.lo, i);
    }
    let w = disk_write_at_wait(&mut v.lo, i, off, v.xfer, n, v.now);
    lo_settle(&mut v);
    if w == NO_DISK_FILE {
      return NO_FD;
    }
    vfs_advance(&mut v, row, off, w);
    return w;
  }
  if fget(v.ftab, row, FD_FS) != FS_RAM || i >= NFILES || i == v.lo_file {
    return NO_FD;
  }
  let mut put = NO_FD;
  match take_node(&mut v.ram, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      let mut off = fget(v.ftab, row, FD_OFF);
      if fget(v.ftab, row, FD_MODE) / O_APPEND % 2 == 1 {
        off = g.size;
      }
      put = file_write(&mut g, &mut mem, off, v.xfer, n);
      if put > 0 {
        g.mtime = v.now;
      }
      put_node(&mut v.ram, i, Node::File(g));
      vfs_advance(&mut v, row, off, put);
    },
  }
  return put;
}

/// Sets the size of the file open in `row` to size_to bytes (ftruncate):
/// growing reads as zeros. The row must be open for writing; its offset
/// stays where it is. False otherwise, or if the disk fails or is full.
fn vfs_truncate(v: &mut Vfs, mem: &mut Mem, row: u64, size_to: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS
  ensures vfs_ok(v) && mem_ok(mem)
{
  let f = vfs_row_file(v, row);
  let mut was = NO_FILE;
  if pc_any(v.pc, f) {
    was = vfs_size(&mut v, f);
  }
  let ok = truncate_row(&mut v, &mut mem, row, size_to);
  if ok {
    if was != NO_FILE && size_to > was {
      pc_zero_tail(&mut v.pc, f, was);
    }
    pc_resize(&mut v.pc, &mut mem, f, size_to);
  }
  return ok;
}

/// vfs_truncate without the page cache's upkeep.
fn truncate_row(v: &mut Vfs, mem: &mut Mem, row: u64, size_to: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && row < FD_ROWS
  ensures vfs_ok(v) && mem_ok(mem)
{
  if fget(v.ftab, row, FD_MODE) / O_WRITE % 2 == 0 {
    return false;
  }
  let i = fget(v.ftab, row, FD_NODE);
  if fget(v.ftab, row, FD_FS) == FS_DISK && i < DSLOTS {
    return disk_resize(&mut v.disk, i, size_to, v.now);
  }
  if fget(v.ftab, row, FD_FS) == FS_LO && i < DSLOTS {
    let ok = disk_resize(&mut v.lo, i, size_to, v.now);
    lo_settle(&mut v);
    return ok;
  }
  if fget(v.ftab, row, FD_FS) != FS_RAM || i >= NFILES || i == v.lo_file {
    return false;
  }
  let mut ok = false;
  match take_node(&mut v.ram, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      ok = file_resize(&mut g, &mut mem, size_to);
      if ok {
        g.mtime = v.now;
      }
      put_node(&mut v.ram, i, Node::File(g));
    },
  }
  return ok;
}

/// Sets a row's offset to off + k, saturating.
fn vfs_advance(v: &mut Vfs, row: u64, off: u64, k: u64)
  requires vfs_ok(v) && row < FD_ROWS
  ensures vfs_ok(v)
{
  let mut o = 18446744073709551615;
  if k <= o - off {
    o = off + k;
  }
  fset(&mut v.ftab, row, FD_OFF, o);
}

/// The offset of an open row.
fn vfs_offset(v: &Vfs, row: u64) -> u64
  requires vfs_ok(v) && row < FD_ROWS
{
  return fget(v.ftab, row, FD_OFF);
}

/// Moves an open row's offset to `off`. Returns false if it is not open.
fn vfs_seek(v: &mut Vfs, row: u64, off: u64) -> bool
  requires vfs_ok(v) && row < FD_ROWS
  ensures vfs_ok(v)
{
  if fget(v.ftab, row, FD_FS) == 0 {
    return false;
  }
  fset(&mut v.ftab, row, FD_OFF, off);
  return true;
}

/// Removes the file named by the first n bytes of the transfer buffer.
/// Returns false if there is none (or it is a directory). A file that is
/// open loses its name now and its data at the last close, as on Linux.
fn vfs_unlink(v: &mut Vfs, mem: &mut Mem, n: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
{
  if on_disk(v, n) {
    return dk_unlink(&mut v.disk, v.nopen, v.xfer, DISK_PREFIX, n, FS_DISK);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let ok = dk_unlink(&mut v.lo, v.nopen, v.xfer, lp, n, FS_LO);
    lo_settle(&mut v);
    return ok;
  }
  let i = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, n);
  if i >= NFILES || ram_is_dir(&mut v.ram, i) {
    return false;
  }
  let mut l = NFILES;
  if ram_has_links(v.rix) {
    l = ram_link_to(&mut v.ram, i);    // a walk of the whole table: only while a link exists
  }
  if l < NFILES {
    // The file keeps its node (descriptors and other links name it) and
    // takes the link's name instead.
    let ll = ram_name(&mut v.ram, l, &mut v.name);
    let il = ram_len(&mut v.ram, i);
    if ll > NAMEBUF || il == NO_FILE {
      return false;
    }
    ram_remove(&mut v.ram, &mut v.rix, &mut mem, l);
    return ram_reprefix(&mut v.ram, &mut v.rix, i, il, v.name, ll);
  }
  if node_open(v.nopen, FS_RAM, i) || i == v.lo_file {
    ram_orphan(&mut v.ram, &mut v.rix, i);          // a mounted image goes at its unmount
  } else {
    ram_remove(&mut v.ram, &mut v.rix, &mut mem, i);
  }
  return true;
}

/// vfs_unlink of x[0..n] on disk file system d (fs in the table), whose
/// names start p bytes in.
fn dk_unlink(d: &mut DiskFs, nopen: &Buf, x: &Bytes, p: u64, n: u64, fs: u64) -> bool
  requires disk_ok(d) && nopen_ok(nopen) && p < n && n <= blen(x)
  ensures disk_ok(d)
{
  let e = disk_find(d, x, p, n - p);
  if e >= DSLOTS || dent_dir(d, e) {
    return false;
  }
  let l = disk_link_to(d, e);
  if l < DSLOTS {
    return disk_take_name(&mut d, e, l);
  }
  if node_open(nopen, fs, e) {
    return disk_orphan(&mut d, e);
  }
  return disk_remove(&mut d, e);
}

/// The file named by the first n bytes of the transfer buffer, as a
/// handle for vfs_read_at and vfs_size, or NO_FILE. Handles number files
/// like vfs_dirent: 0 to NFILES - 1 in memory, then DSLOTS on the disk. A
/// handle names the same file until that file is removed.
fn vfs_lookup(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
  ensures result < HFILES || result == NO_FILE
{
  if on_disk(v, n) {
    let d = disk_find(v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX);
    if d >= DSLOTS {
      return NO_FILE;
    }
    return vfs_target(&mut v, NFILES + d);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let d = disk_find(v.lo, v.xfer, lp, n - lp);
    if d >= DSLOTS {
      return NO_FILE;
    }
    return vfs_target(&mut v, LO0 + d);
  }
  let i = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, n);
  if i >= NFILES {
    return NO_FILE;
  }
  return vfs_target(&mut v, i);
}

/// The file that handle f names: f itself, or what f is a hard link to.
fn vfs_target(v: &mut Vfs, f: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
  ensures f < NFILES + DSLOTS ==> result < NFILES + DSLOTS
  ensures f >= LO0 && f < HFILES ==> result >= LO0 && result < HFILES
  ensures f >= HFILES ==> result == f
{
  if f < NFILES {
    if !ram_has_links(v.rix) {
      return f;                             // no link node exists: skip taking the node out to look
    }
    let t = ram_link_of(&mut v.ram, f);
    if t < NFILES {
      return t;
    }
    return f;
  }
  if f < NFILES + DSLOTS {
    let t = disk_link_of(v.disk, f - NFILES);
    if t < DSLOTS {
      return NFILES + t;
    }
  } else if f < HFILES {
    let t = disk_link_of(v.lo, f - LO0);
    if t < DSLOTS {
      return LO0 + t;
    }
  }
  return f;
}

/// How many names file f (a vfs_lookup handle) has: 1 and its hard links.
fn vfs_nlink(v: &mut Vfs, f: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let t = vfs_target(&mut v, f);
  if t < NFILES {
    if !ram_has_links(v.rix) {
      return 1;                             // no link node exists, so the count would be 0 (and costs a pass over every node)
    }
    return 1 + ram_links(&mut v.ram, t);
  }
  if t < NFILES + DSLOTS {
    return 1 + disk_links(v.disk, t - NFILES);
  }
  if t < HFILES {
    return 1 + disk_links(v.lo, t - LO0);
  }
  return 1;
}

/// The size of file f (a vfs_lookup handle), or NO_FILE.
fn vfs_size(v: &mut Vfs, f0: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  if f < NFILES {
    return ram_size(&mut v.ram, f);
  }
  if f < NFILES + DSLOTS {
    let s = disk_size(v.disk, f - NFILES);
    if s == NO_DISK_FILE {
      return NO_FILE;
    }
    return s;
  }
  if f < HFILES {
    let s = disk_size(v.lo, f - LO0);
    if s == NO_DISK_FILE {
      return NO_FILE;
    }
    return s;
  }
  return NO_FILE;
}

/// Copies up to n bytes of file f (a vfs_lookup handle) from offset off
/// into the start of the transfer buffer, without a descriptor. Returns
/// the count, short at the end of the file, or NO_FD if f names no file.
fn vfs_read_at(v: &mut Vfs, f0: u64, off: u64, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
  ensures result <= n || result == NO_FD
{
  if pc_on(v.pc) {
    // Pages cached by earlier reads and writes answer without the disk.
    let f = vfs_target(&mut v, f0);
    if f >= NFILES && f - NFILES < DSLOTS {
      let size = disk_size(v.disk, f - NFILES);
      if size != NO_DISK_FILE && off < size {
        let mut want = size - off;
        if want > n {
          want = n;
        }
        if pc_have(&mut v.pc, f, off, want) {
          pc_overlay(&mut v.pc, f, off, &mut v.xfer, want);
          return want;
        }
      }
    }
  }
  let r = read_at(&mut v, f0, off, n);
  if r <= n && pc_on(v.pc) {
    let f = vfs_target(&mut v, f0);
    pc_overlay(&mut v.pc, f, off, &mut v.xfer, r);
  }
  return r;
}

/// vfs_read_at for a caller that can sleep: VFS_MISS, with the reads of
/// what is missing queued, where vfs_read_at would wait for the disk file
/// system's queue. The other file systems answer as vfs_read_at does.
fn vfs_read_try(v: &mut Vfs, f0: u64, off: u64, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
  ensures result <= n || result == NO_FD || result == VFS_MISS
{
  let f = vfs_target(&mut v, f0);
  if f < NFILES || f >= LO0 {
    return vfs_read_at(&mut v, f0, off, n);
  }
  let r = disk_read(&mut v.disk, f - NFILES, off, &mut v.xfer, n);
  if r == DISK_MISS {
    return VFS_MISS;
  }
  if r == NO_DISK_FILE || r > n {
    return NO_FD;
  }
  if pc_on(v.pc) {
    pc_overlay(&mut v.pc, f, off, &mut v.xfer, r);
  }
  return r;
}

/// vfs_read_at without the page cache's bytes over the file's.
fn read_at(v: &mut Vfs, f0: u64, off: u64, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
  ensures result <= n || result == NO_FD
{
  let f = vfs_target(&mut v, f0);
  if f >= HFILES {
    return NO_FD;
  }
  if f >= LO0 {
    let r = disk_read_wait(&mut v.lo, f - LO0, off, &mut v.xfer, n);
    if r == NO_DISK_FILE {
      return NO_FD;
    }
    return r;
  }
  if f >= NFILES {
    let r = disk_read_wait(&mut v.disk, f - NFILES, off, &mut v.xfer, n);
    if r == NO_DISK_FILE {
      return NO_FD;
    }
    return r;
  }
  let mut got = NO_FD;
  match take_node(&mut v.ram, f) {
    Node::Free => {},
    Node::File(g0) => {
      let mut g = g0;
      got = file_read(&mut g, off, &mut v.xfer, n);
      put_node(&mut v.ram, f, Node::File(g));
    },
  }
  return got;
}

/// The size of the file named by the first n bytes of the transfer
/// buffer, or NO_FILE.
fn vfs_stat(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  let f = vfs_lookup(&mut v, n);
  return vfs_size(&mut v, f);
}

/// Whether RAM file f has no name: a memfd, or a file removed while open.
fn vfs_orphan(v: &mut Vfs, f: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  if f >= NFILES {
    return false;
  }
  return ram_len(&mut v.ram, f) == 0;
}

/// Copies the name of directory entry i into the start of the transfer
/// buffer. Returns its length, 0 for an unused entry, or NO_FILE past the
/// last entry. Entries 0 to NFILES - 1 are in memory, the next DSLOTS on
/// the disk (their names start with "disk/").
fn vfs_dirent(v: &mut Vfs, i: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
  ensures result <= XFER || result == NO_FILE
{
  if i >= HFILES {
    return NO_FILE;
  }
  if i >= LO0 {
    return lo_dirent(&mut v, i - LO0);
  }
  if i >= NFILES {
    let d = disk_name(v.disk, i - NFILES, &mut v.xfer, DISK_PREFIX);
    if d == NO_DISK_FILE {
      return 0;
    }
    bset(&mut v.xfer, 0, 100);
    bset(&mut v.xfer, 1, 105);
    bset(&mut v.xfer, 2, 115);
    bset(&mut v.xfer, 3, 107);
    bset(&mut v.xfer, 4, 47);
    return DISK_PREFIX + d;
  }
  let n = ram_name(&mut v.ram, i, &mut v.xfer);
  if n == NO_FILE {
    return 0;
  }
  if n > XFER {
    return 0;     // cannot happen: names are at most FNAME_MAX bytes
  }
  return n;
}

/// vfs_dirent for entry e of the loop mount: its directory's name, "/",
/// then the entry's path.
fn lo_dirent(v: &mut Vfs, e: u64) -> u64
  requires vfs_ok(v) && e < DSLOTS
  ensures vfs_ok(v)
  ensures result <= XFER || result == NO_FILE
{
  if v.lo_at == 0 || v.lo_at > NFILES {
    return 0;
  }
  let l = ram_name(&mut v.ram, v.lo_at - 1, &mut v.lname);
  if l == NO_FILE || l + 1 > NAMEBUF {
    return 0;
  }
  let d = disk_name(v.lo, e, &mut v.xfer, l + 1);
  if d == NO_DISK_FILE || l + 1 + d > XFER {
    return 0;
  }
  let mut j = 0;
  while j < l
    invariant j <= l && l + 1 <= NAMEBUF && vfs_ok(v)
  {
    bset(&mut v.xfer, j, bget(v.lname, j));
    j = j + 1;
  }
  bset(&mut v.xfer, l, 47);
  return l + 1 + d;
}

/// Creates (or replaces) the file `name` holding the bytes of `data`. Used
/// at boot to fill the file system from images built into the kernel.
fn vfs_install(v: &mut Vfs, mem: &mut Mem, name: Str, data: Str) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  let d = bfrom(data);
  let ok = vfs_install_bytes(&mut v, &mut mem, name, d, blen(d));
  bfree(d);
  return ok;
}

/// vfs_install, with the first m bytes of d as the contents.
fn vfs_install_bytes(v: &mut Vfs, mem: &mut Mem, name: Str, d: &Bytes, m: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && m <= blen(d)
  ensures vfs_ok(v) && mem_ok(mem)
{
  let nm = bfrom(name);
  let n = blen(nm);
  let mut i = ram_find(&mut v.ram, v.rix, v.rhi, nm, n);
  if i >= NFILES {
    i = ram_create(&mut v.ram, &mut v.rix, nm, n, false, v.now);
    if i < NFILES && i >= v.rhi {
      v.rhi = i + 1;
    }
  }
  bfree(nm);
  if i >= NFILES {
    return false;
  }
  pc_forget(&mut v.pc, &mut mem, i);
  let mut ok = false;
  match take_node(&mut v.ram, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      file_truncate(&mut g, &mut mem);
      ok = file_write(&mut g, &mut mem, 0, d, m) == m;
      put_node(&mut v.ram, i, Node::File(g));
    },
  }
  return ok;
}

/// Writes d[0..m] to the file `name` (a path from the top, such as
/// "disk/etc/resolv.conf"), made or emptied first, for the kernel itself:
/// through descriptor rows of pid 0, which is never a process, and waiting
/// for the disk. False if it could not, such as when the write needs a
/// block the cache does not have.
fn vfs_put(v: &mut Vfs, mem: &mut Mem, name: Str, d: &Bytes, m: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && m <= blen(d) && m <= XFER && slen(name) <= FNAME_MAX
  ensures vfs_ok(v) && mem_ok(mem)
{
  let mut i = 0;
  while i < slen(name)
    invariant i <= slen(name) && slen(name) <= FNAME_MAX && vfs_ok(v)
  {
    bset(&mut v.xfer, i, sget(name, i));
    i = i + 1;
  }
  let nf = vfs_open(&mut v, &mut mem, nbase(0), NFD, O_WRITE + O_CREATE + O_TRUNC, slen(name));
  if nf >= NFD {
    return false;
  }
  let fd = nbase(0) + nf;
  let mut j = 0;
  while j < m
    invariant j <= m && m <= blen(d) && m <= XFER && vfs_ok(v)
  {
    bset(&mut v.xfer, j, bget(d, j));
    j = j + 1;
  }
  let w = vfs_write(&mut v, &mut mem, fd, m);
  vfs_close(&mut v, &mut mem, fd);
  disk_drain(&mut v.disk);
  return w == m;
}

/// fsync and friends: commits the batch of disk writes, if any, and leaves
/// in v.disk.txn the transaction the caller waits for.
fn vfs_sync(v: &mut Vfs)
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  disk_sync(&mut v.disk);
}

// ---------------------------------------------------------------- directories

/// Is the name in the first n bytes of the transfer buffer fit for a new
/// file or directory: not empty, no "/" at either end or twice in a row,
/// and not "disk"?
fn path_ok(v: &Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
{
  if n == 0 || bget(v.xfer, 0) == 47 || bget(v.xfer, n - 1) == 47 {
    return false;
  }
  if n == 4 && bget(v.xfer, 0) == 100 && bget(v.xfer, 1) == 105 && bget(v.xfer, 2) == 115
    && bget(v.xfer, 3) == 107 {
    return false;
  }
  let mut j = 1;
  while j < n
    invariant 1 <= j && j <= n
  {
    if bget(v.xfer, j) == 47 && bget(v.xfer, j - 1) == 47 {
      return false;
    }
    j = j + 1;
  }
  return true;
}

/// The position of the last "/" in the first n bytes of the transfer
/// buffer, or n if there is none.
fn last_slash(v: &Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures result <= n
{
  let mut k = n;
  while k > 0
    invariant k <= n
  {
    if bget(v.xfer, k - 1) == 47 {
      return k - 1;
    }
    k = k - 1;
  }
  return n;
}

/// Does the directory that a new file named by the first n bytes of the
/// transfer buffer would go in exist?
fn parent_ok(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  let k = last_slash(v, n);
  if k == n {
    return true;                        // at the top
  }
  if on_disk(v, n) {
    if k < DISK_PREFIX {
      return k == DISK_PREFIX - 1;      // directly in "disk"
    }
    let d = disk_find(v.disk, v.xfer, DISK_PREFIX, k - DISK_PREFIX);
    return d < DSLOTS && dent_dir(v.disk, d);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    if k < lp {
      return k == lp - 1;               // directly in the mount's directory
    }
    let d = disk_find(v.lo, v.xfer, lp, k - lp);
    return d < DSLOTS && dent_dir(v.lo, d);
  }
  let i = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, k);
  return i < NFILES && ram_is_dir(&mut v.ram, i);
}

/// Makes the directory named by the first n bytes of the transfer buffer.
/// Fails if the name is taken, its parent is missing, or there is no room.
fn vfs_mkdir(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if !path_ok(v, n) || !parent_ok(&mut v, n) {
    return false;
  }
  if on_disk(v, n) {
    if disk_find(v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX) < DSLOTS {
      return false;
    }
    return disk_create(&mut v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX, true, v.now) < DSLOTS;
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    if v.lo_ro || disk_find(v.lo, v.xfer, lp, n - lp) < DSLOTS {
      return false;
    }
    let ok = disk_create(&mut v.lo, v.xfer, lp, n - lp, true, v.now) < DSLOTS;
    lo_settle(&mut v);
    return ok;
  }
  if ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, n) < NFILES {
    return false;
  }
  return vfs_ram_create(&mut v, n, true) < NFILES;
}

/// Removes the directory named by the first n bytes of the transfer buffer
/// if nothing is in it.
fn vfs_rmdir(v: &mut Vfs, mem: &mut Mem, n: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
{
  if on_disk(v, n) {
    let d = disk_find(v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX);
    if d >= DSLOTS || !dent_dir(v.disk, d) || disk_has_children(v.disk, d) {
      return false;
    }
    return disk_remove(&mut v.disk, d);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let d = disk_find(v.lo, v.xfer, lp, n - lp);
    if d >= DSLOTS || !dent_dir(v.lo, d) || disk_has_children(v.lo, d) {
      return false;
    }
    let ok = disk_remove(&mut v.lo, d);
    lo_settle(&mut v);
    return ok;
  }
  let i = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, n);
  if i >= NFILES || !ram_is_dir(&mut v.ram, i) {
    return false;
  }
  if vfs_ram_has_children(&mut v, n) {
    return false;
  }
  ram_remove(&mut v.ram, &mut v.rix, &mut mem, i);
  return true;
}

/// Is handle f (from vfs_lookup or vfs_dir_lookup) a directory?
fn vfs_is_dir(v: &mut Vfs, f0: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  if f < NFILES {
    return ram_is_dir(&mut v.ram, f);
  }
  if f < NFILES + DSLOTS {
    return dent_dir(v.disk, f - NFILES);
  }
  if f < HFILES {
    return dent_dir(v.lo, f - LO0);
  }
  return f == VDIR_ROOT || f == VDIR_DISK || f == VDIR_LO;
}

/// The directory named by the first n bytes of the transfer buffer, as a
/// handle for vfs_readdir: VDIR_ROOT for the empty name, VDIR_DISK for
/// "disk", VDIR_LO for the loop mount's directory, or a directory node.
/// NO_FILE if there is no such directory.
fn vfs_dir_lookup(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
  ensures result <= VDIR_LO || result == NO_FILE
{
  if n == 0 {
    return VDIR_ROOT;
  }
  if lo_root(&mut v, n) {
    return VDIR_LO;
  }
  if n == 4 && bget(v.xfer, 0) == 100 && bget(v.xfer, 1) == 105 && bget(v.xfer, 2) == 115
    && bget(v.xfer, 3) == 107 {
    return VDIR_DISK;
  }
  let f = vfs_lookup(&mut v, n);
  if f != NO_FILE && vfs_is_dir(&mut v, f) {
    return f;
  }
  return NO_FILE;
}

/// If x[0..n] names something directly in the directory named p[0..l]
/// (in the top directory when `top`), moves its last part to the start of
/// x and returns that part's length; otherwise returns 0.
fn child_at(x: &mut Bytes, n: u64, p: &Bytes, l: u64, top: bool) -> u64
  requires n <= blen(x) && l <= blen(p)
  ensures blen(x) == old(blen(x)) && result <= n
{
  let mut start = 0;
  if !top {
    if n <= l + 1 || bget(x, l) != 47 {
      return 0;
    }
    let mut j = 0;
    while j < l
      invariant j <= l && l < n
    {
      if bget(x, j) != bget(p, j) {
        return 0;
      }
      j = j + 1;
    }
    start = l + 1;
  }
  let mut j = start;
  while j < n
    invariant start <= j && j <= n
  {
    if bget(x, j) == 47 {
      return 0;
    }
    j = j + 1;
  }
  let bl = blen(x);
  let mut k = 0;
  while k < n - start
    invariant k <= n - start && start <= n && n <= bl && blen(x) == bl
  {
    bset(&mut x, k, bget(x, start + k));
    k = k + 1;
  }
  return n - start;
}

/// Copies the name (the last part only) of entry i of directory d (a
/// vfs_dir_lookup handle) into the start of the transfer buffer. Returns
/// its length, 0 if entry i is not in d, or NO_FILE past the last entry or
/// if d is not a directory. Entries are numbered like the nodes of d's
/// file system; the top directory has one more, "disk", when there is a
/// disk. vfs_child gives the handle of an entry.
fn vfs_readdir(v: &mut Vfs, d: u64, i: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
  ensures result <= XFER || result == NO_FILE
{
  if d == VDIR_ROOT || d < NFILES {
    let mut l = 0;
    if d < NFILES {
      if !ram_is_dir(&mut v.ram, d) {
        return NO_FILE;
      }
      l = ram_name(&mut v.ram, d, &mut v.name);
      if l > NAMEBUF {
        return NO_FILE;
      }
    }
    if d == VDIR_ROOT && i == NFILES {
      if v.disk.slots == 0 {
        return 0;
      }
      bset(&mut v.xfer, 0, 100);
      bset(&mut v.xfer, 1, 105);
      bset(&mut v.xfer, 2, 115);
      bset(&mut v.xfer, 3, 107);
      return 4;
    }
    if i >= NFILES || (i >= v.rhi && d != VDIR_ROOT) {
      return NO_FILE;                     // no node lives at or past rhi (the top directory goes on to "disk")
    }
    let n = ram_name(&mut v.ram, i, &mut v.xfer);
    if n > XFER {
      return 0;
    }
    return child_at(&mut v.xfer, n, v.name, l, d == VDIR_ROOT);
  }
  if d == VDIR_DISK || d < NFILES + DSLOTS {
    let mut p = DTOP;
    if d < NFILES + DSLOTS {
      if !dent_dir(v.disk, d - NFILES) {
        return NO_FILE;
      }
      p = d - NFILES;
    }
    return dk_readdir(v.disk, &mut v.xfer, p, i);
  }
  if d == VDIR_LO || d < HFILES {
    let mut p = DTOP;
    if d < HFILES {
      if !dent_dir(v.lo, d - LO0) {
        return NO_FILE;
      }
      p = d - LO0;
    }
    return dk_readdir(v.lo, &mut v.xfer, p, i);
  }
  return NO_FILE;
}

/// The first index at or after i that can be an entry of disk directory p
/// (DTOP: the top) of file system d: vfs_readdir finds nothing, and no
/// entry of p lives, below it. The end of the directory's slots (or i, if
/// it is past them) if there is none.
fn dk_skip(d: &DiskFs, p: u64, i: u64) -> u64
  requires disk_ok(d)
  ensures result >= i && (result <= DSLOTS || i > DSLOTS)
{
  let mut j = i;
  while j < DSLOTS && j < d.slots && !(dent_used(d, j) && dent_parent(d, j) == p)
    invariant j >= i && disk_ok(d) && (j <= DSLOTS || j == i)
  {
    j = j + 1;
  }
  return j;
}

/// Where a walk over directory d's entries, which has just found nothing at
/// index i, can go on: vfs_readdir finds nothing at any index between i
/// and the result (at least i, at most i + DSLOTS). The disk's directories
/// hold only the entries whose parent they are, among all of its slots, so
/// listing one would otherwise ask about every slot in turn.
fn vfs_skip(v: &mut Vfs, d: u64, i: u64) -> u64
  requires vfs_ok(v) && i < 0x100000000
  ensures vfs_ok(v) && result >= i && result <= i + DSLOTS
{
  let mut dk = d;
  let mut lo = false;
  if d == VDIR_DISK || (d >= NFILES && d < NFILES + DSLOTS) {
    dk = DTOP;
    if d != VDIR_DISK {
      if !dent_dir(v.disk, d - NFILES) {
        return i;
      }
      dk = d - NFILES;
    }
  } else if d == VDIR_LO || (d >= LO0 && d < HFILES) {
    lo = true;
    dk = DTOP;
    if d != VDIR_LO {
      if !dent_dir(v.lo, d - LO0) {
        return i;
      }
      dk = d - LO0;
    }
  } else {
    return i;
  }
  let mut j = 0;
  if lo {
    j = dk_skip(v.lo, dk, i);
  } else {
    j = dk_skip(v.disk, dk, i);
  }
  if j > i + DSLOTS {
    return i;
  }
  return j;
}

/// vfs_readdir of entry i of directory entry p (DTOP: the top) of disk
/// file system d.
fn dk_readdir(d: &DiskFs, x: &mut Bytes, p: u64, i: u64) -> u64
  requires disk_ok(d) && blen(x) == XFER
  ensures blen(x) == XFER
  ensures result <= XFER || result == NO_FILE
{
  if i >= DSLOTS || i >= d.slots {
    return NO_FILE;                       // past the directory's last block: no entry lives there
  }
  if !dent_used(d, i) || dent_parent(d, i) != p {
    return 0;
  }
  let n = disk_comp(d, i, &mut x, 0);
  if n == NO_DISK_FILE || n > XFER {
    return 0;
  }
  return n;
}

/// The handle of entry i of directory d, when vfs_readdir(v, d, i) found
/// one (returned more than 0).
fn vfs_child(d: u64, i: u64) -> u64
  ensures result < HFILES || result == NO_FILE || result == VDIR_DISK
{
  if d == VDIR_ROOT && i == NFILES {
    return VDIR_DISK;
  }
  if d == VDIR_ROOT || d < NFILES {
    if i >= NFILES {
      return NO_FILE;
    }
    return i;
  }
  if i >= DSLOTS {
    return NO_FILE;
  }
  if d == VDIR_LO || (d >= LO0 && d < HFILES) {
    return LO0 + i;
  }
  return NFILES + i;
}

/// Renames the file or directory named by the first n bytes of the
/// transfer buffer to the next m bytes. Both names must be on the same
/// file system, the new one free and its directory existing, and a
/// directory cannot move into itself. Descriptors stay open on the file.
/// On the disk this is one sector write, so a power cut leaves either
/// name; in memory a directory's contents are renamed with it.
fn vfs_rename(v: &mut Vfs, n: u64, m: u64) -> bool
  requires vfs_ok(v) && n <= XFER && m <= XFER - n
  ensures vfs_ok(v)
{
  if n == 0 || m == 0 || n > FNAME_MAX || m > FNAME_MAX {
    return false;
  }
  let src_disk = on_disk(v, n);
  let src_lo = lo_pfx(&mut v, n) != 0;
  let mut node = NO_FILE;
  if src_disk {
    let d = disk_find(v.disk, v.xfer, DISK_PREFIX, n - DISK_PREFIX);
    if d >= DSLOTS {
      return false;
    }
    node = d;
  } else if src_lo {
    let lp = lo_pfx(&mut v, n);
    if lp == 0 || v.lo_ro {
      return false;
    }
    let d = disk_find(v.lo, v.xfer, lp, n - lp);
    if d >= DSLOTS {
      return false;
    }
    node = d;
  } else {
    let i = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, n);
    if i >= NFILES {
      return false;
    }
    node = i;
  }
  // Keep the old name in v.name and move the new one to the front.
  let mut k = 0;
  while k < n
    invariant k <= n && n <= FNAME_MAX && vfs_ok(v)
  {
    bset(&mut v.name, k, bget(v.xfer, k));
    k = k + 1;
  }
  k = 0;
  while k < m
    invariant k <= m && vfs_ok(v) && n <= XFER && m <= XFER - n
  {
    bset(&mut v.xfer, k, bget(v.xfer, n + k));
    k = k + 1;
  }
  let mp = lo_pfx(&mut v, m);
  if on_disk(v, m) != src_disk || (mp != 0) != src_lo || !path_ok(v, m) || !parent_ok(&mut v, m) {
    return false;
  }
  if vfs_lookup(&mut v, m) != NO_FILE {
    return false;
  }
  // Not into itself: the new name is not the old one and a "/" and more.
  if m > n && bget(v.xfer, n) == 47 {
    let mut same = true;
    let mut j = 0;
    while j < n
      invariant j <= n && n < m && m <= XFER && vfs_ok(v)
    {
      if bget(v.xfer, j) != bget(v.name, j) {
        same = false;
      }
      j = j + 1;
    }
    if same {
      return false;
    }
  }
  if src_disk {
    return node < DSLOTS && disk_move(&mut v.disk, node, v.xfer, DISK_PREFIX, m - DISK_PREFIX);
  }
  if src_lo {
    let lp = lo_pfx(&mut v, m);
    if lp == 0 || node >= DSLOTS {
      return false;
    }
    let ok = disk_move(&mut v.lo, node, v.xfer, lp, m - lp);
    lo_settle(&mut v);
    return ok;
  }
  if node >= NFILES {
    return false;
  }
  // In memory: every node inside a directory moves with it. Check that
  // every new name fits before changing any.
  if ram_is_dir(&mut v.ram, node) && ram_has_under(v.rix, v.name, n) {
    let mut j = 0;
    while j < NFILES
      invariant j <= NFILES && vfs_ok(v) && n <= FNAME_MAX && m <= FNAME_MAX
    {
      if ram_under(&mut v.ram, j, v.name, n) {
        let l = ram_len(&mut v.ram, j);
        if l == NO_FILE || l < n || l - n > FNAME_MAX - m {
          return false;
        }
      }
      j = j + 1;
    }
    j = 0;
    while j < NFILES
      invariant j <= NFILES && vfs_ok(v) && n <= FNAME_MAX && m <= FNAME_MAX
    {
      if ram_under(&mut v.ram, j, v.name, n) {
        ram_reprefix(&mut v.ram, &mut v.rix, j, n, v.xfer, m);
      }
      j = j + 1;
    }
  }
  return ram_reprefix(&mut v.ram, &mut v.rix, node, n, v.xfer, m);
}

// ---------------------------------------------------------------- metadata

/// The handle of the file open in `row` (as vfs_lookup gives), or NO_FILE.
fn vfs_row_file(v: &Vfs, row: u64) -> u64
  requires vfs_ok(v) && row < FD_ROWS
  ensures result < HFILES || result == NO_FILE
{
  let fs = fget(v.ftab, row, FD_FS);
  let node = fget(v.ftab, row, FD_NODE);
  if fs == FS_RAM && node < NFILES {
    return node;
  }
  if fs == FS_DISK && node < DSLOTS {
    return NFILES + node;
  }
  if fs == FS_LO && node < DSLOTS {
    return LO0 + node;
  }
  return NO_FILE;
}

/// The permission bits (such as 0644) and modification time (seconds) of
/// handle f, from vfs_lookup or vfs_dir_lookup. ok is false if it names
/// nothing. The top directory and "disk" are 0755 from time 0.
fn vfs_meta(v: &mut Vfs, f0: u64) -> FMeta
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  if f < NFILES {
    return ram_meta(&mut v.ram, f);
  }
  if f < NFILES + DSLOTS {
    if !dent_used(v.disk, f - NFILES) {
      return FMeta { ok: false, mode: 0, mtime: 0, own: 0 };
    }
    return FMeta { ok: true, mode: disk_mode(v.disk, f - NFILES), mtime: disk_mtime(v.disk, f - NFILES), own: disk_owner(v.disk, f - NFILES) };
  }
  if f < HFILES {
    if !dent_used(v.lo, f - LO0) {
      return FMeta { ok: false, mode: 0, mtime: 0, own: 0 };
    }
    return FMeta { ok: true, mode: disk_mode(v.lo, f - LO0), mtime: disk_mtime(v.lo, f - LO0), own: disk_owner(v.lo, f - LO0) };
  }
  if f == VDIR_ROOT || f == VDIR_DISK || f == VDIR_LO {
    return FMeta { ok: true, mode: 493, mtime: 0, own: 0 };
  }
  return FMeta { ok: false, mode: 0, mtime: 0, own: 0 };
}

/// Sets handle f's owner to user id uid and group id gid. False if f
/// names nothing that keeps one, the disk cannot keep ids that large, or
/// the disk fails.
fn vfs_set_owner(v: &mut Vfs, f0: u64, uid: u64, gid: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  if f < NFILES {
    return uid < 0x100000000 && gid < 0x100000000 && ram_set_owner(&mut v.ram, f, uid + gid * 0x100000000);
  }
  if uid >= OWN_ID_MAX || gid >= OWN_ID_MAX {
    return false;
  }
  if f < NFILES + DSLOTS {
    return disk_set_owner(&mut v.disk, f - NFILES, uid, gid);
  }
  if f < HFILES && !v.lo_ro {
    let ok = disk_set_owner(&mut v.lo, f - LO0, uid, gid);
    lo_settle(&mut v);
    return ok;
  }
  return false;
}

/// Sets handle f's permission bits (when `mode` is below 4096) and its
/// modification time (when `mtime` is not NO_FILE). False if f names
/// nothing that keeps them, or the disk fails.
fn vfs_set_meta(v: &mut Vfs, f0: u64, mode: u64, mtime: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let f = vfs_target(&mut v, f0);
  let mut m = 65536;
  if mode < 4096 {
    let cur = vfs_meta(&mut v, f);
    m = cur.mode % 65536 / 4096 * 4096 + mode;   // the type bits stay (a link stays a link)
  }
  if f < NFILES {
    return ram_set_meta(&mut v.ram, f, m, mtime);
  }
  if f < NFILES + DSLOTS {
    let mut t = NO_DISK_FILE;
    if mtime != NO_FILE {
      t = mtime;
    }
    return disk_set_meta(&mut v.disk, f - NFILES, m, t);
  }
  if f < HFILES && !v.lo_ro {
    let mut t = NO_DISK_FILE;
    if mtime != NO_FILE {
      t = mtime;
    }
    let ok = disk_set_meta(&mut v.lo, f - LO0, m, t);
    lo_settle(&mut v);
    return ok;
  }
  return false;
}

// ---------------------------------------------------------------- symbolic links

const T_LINK: u64 = 0xA000;           // mode type bits of a symbolic link
const LINK_MODE: u64 = 0xA1FF;        // a link: rwxrwxrwx, as Linux shows them

const T_FIFO: u64 = 0x1000;           // mode type bits of a named pipe
const T_CHR: u64 = 0x2000;            // a character device node: its contents are its device number
const T_BLK: u64 = 0x6000;            // a block device node, the same
const T_SOCK: u64 = 0xC000;           // a socket node, empty

/// The type bits of file f's mode (0 for a regular file or no file).
fn vfs_node_type(v: &mut Vfs, f: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let m = vfs_meta(&mut v, f);
  if !m.ok {
    return 0;
  }
  return m.mode % 65536 / 4096 * 4096;
}

/// The device number a device node keeps (Linux's 32-bit encoding, as
/// mknod got it), 0 if it has none. The transfer buffer is left as it was.
fn vfs_node_dev(v: &mut Vfs, f: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let keep = load_le32(v.xfer, 0);
  let got = vfs_read_at(&mut v, f, 0, 4);
  let mut dev = 0;
  if got == 4 {
    dev = cast[u64](load_le32(v.xfer, 0));
  }
  store_le32(&mut v.xfer, 0, keep);
  return dev;
}

/// Is handle f a named pipe? The Linux layer opens it as a pipe
/// (src/lxevent.bastio); its data never lives in the file.
fn vfs_is_fifo(v: &mut Vfs, f: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let m = vfs_meta(&mut v, f);
  return m.ok && m.mode % 65536 / 4096 * 4096 == T_FIFO;
}

/// Creates a named pipe called xfer[0..n] with permission bits `perm`: an
/// empty file whose mode has the FIFO type bits. False if the name is
/// taken, its parent does not exist, or there is no room. Two steps on the
/// disk (the file, then its mode): a power cut between them leaves an empty
/// file under the name.
fn vfs_mkfifo(v: &mut Vfs, mem: &mut Mem, n: u64, perm: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  return vfs_mknode(&mut v, &mut mem, n, T_FIFO + perm % 4096);
}

/// vfs_mkfifo for any mode: type bits (none for a regular file) and
/// permission bits.
fn vfs_mknode(v: &mut Vfs, mem: &mut Mem, n: u64, mode: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  if mode >= 65536 || n > FNAME_MAX || !path_ok(v, n) || !parent_ok(&mut v, n) || vfs_lookup(&mut v, n) != NO_FILE || vfs_dir_lookup(&mut v, n) != NO_FILE {
    return false;
  }
  if on_disk(v, n) {
    return dk_mknode(&mut v.disk, &mut v.pc, &mut mem, NFILES, v.xfer, DISK_PREFIX, n, mode, v.now);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let ok = !v.lo_ro && dk_mknode(&mut v.lo, &mut v.pc, &mut mem, LO0, v.xfer, lp, n, mode, v.now);
    lo_settle(&mut v);
    return ok;
  }
  let i = vfs_ram_create(&mut v, n, false);
  if i >= NFILES {
    return false;
  }
  pc_forget(&mut v.pc, &mut mem, i);
  if !ram_set_meta(&mut v.ram, i, mode, NO_FILE) {
    ram_remove(&mut v.ram, &mut v.rix, &mut mem, i);
    return false;
  }
  return true;
}

/// vfs_mknode of x[0..n] on disk file system d, whose names start p bytes in.
fn dk_mknode(d: &mut DiskFs, pc: &mut PCache, mem: &mut Mem, h0: u64, x: &Bytes, p: u64, n: u64, mode: u64, now: u64) -> bool
  requires disk_ok(d) && p < n && n <= blen(x) && pc_ok(pc) && mem_ok(mem) && h0 <= LO0
  ensures disk_ok(d) && pc_ok(pc) && mem_ok(mem)
{
  let e = disk_create(&mut d, x, p, n - p, false, now);
  if e >= DSLOTS {
    return false;
  }
  pc_forget(&mut pc, &mut mem, h0 + e);
  if !disk_set_meta(&mut d, e, mode, NO_DISK_FILE) {
    disk_remove(&mut d, e);
    return false;
  }
  return true;
}

/// Is handle f a symbolic link? Its contents are the target.
fn vfs_is_link(v: &mut Vfs, f: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  let m = vfs_meta(&mut v, f);
  return m.ok && m.mode % 65536 / 4096 * 4096 == T_LINK;
}

/// Creates a symbolic link: its name is xfer[0..n], its target the m bytes
/// after. False if the name is taken, its parent does not exist, the
/// target is empty or too long, or there is no room. The link is made in
/// steps (an empty node, then its type, then the target); a power cut in
/// between can leave an empty file or an empty link under the name.
fn vfs_symlink(v: &mut Vfs, mem: &mut Mem, n: u64, m: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  return vfs_mkdata(&mut v, &mut mem, n, m, LINK_MODE);
}

/// vfs_symlink for any mode: a node called xfer[0..n] holding the m bytes
/// after the name (a link's target, a device node's number). The name is
/// still in xfer[0..n] afterwards, so the caller can look the node up to
/// give it an owner.
fn vfs_mkdata(v: &mut Vfs, mem: &mut Mem, n: u64, m: u64, mode: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  if n > FNAME_MAX {
    return false;
  }
  let mut keep = balloc(FNAME_MAX);
  let mut i = 0;
  while i < n
    invariant i <= n && n <= FNAME_MAX && blen(keep) == FNAME_MAX && vfs_ok(v)
  {
    bset(&mut keep, i, bget(v.xfer, i));
    i = i + 1;
  }
  let ok = vfs_mkdata_at(&mut v, &mut mem, n, m, mode);
  i = 0;
  while i < n
    invariant i <= n && n <= FNAME_MAX && blen(keep) == FNAME_MAX && vfs_ok(v)
  {
    bset(&mut v.xfer, i, bget(keep, i));
    i = i + 1;
  }
  bfree(keep);
  return ok;
}

/// vfs_mkdata, which leaves the target (or number) over the name in xfer.
fn vfs_mkdata_at(v: &mut Vfs, mem: &mut Mem, n: u64, m: u64, mode: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  if mode >= 65536 || n > FNAME_MAX || m == 0 || m > FNAME_MAX || !path_ok(v, n) || !parent_ok(&mut v, n) || vfs_lookup(&mut v, n) != NO_FILE {
    return false;
  }
  if on_disk(v, n) {
    return dk_symlink(&mut v.disk, &mut v.pc, &mut mem, NFILES, &mut v.xfer, DISK_PREFIX, n, m, mode, v.now);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let ok = !v.lo_ro && dk_symlink(&mut v.lo, &mut v.pc, &mut mem, LO0, &mut v.xfer, lp, n, m, mode, v.now);
    lo_settle(&mut v);
    return ok;
  }
  let i = vfs_ram_create(&mut v, n, false);
  if i >= NFILES {
    return false;
  }
  pc_forget(&mut v.pc, &mut mem, i);
  xfer_shift(&mut v.xfer, n, m);
  let mut w = 0;
  match take_node(&mut v.ram, i) {
    Node::Free => {},
    Node::File(f) => {
      let mut g = f;
      g.mode = mode;
      w = file_write(&mut g, &mut mem, 0, v.xfer, m);
      put_node(&mut v.ram, i, Node::File(g));
    },
  }
  if w != m {
    ram_remove(&mut v.ram, &mut v.rix, &mut mem, i);
    return false;
  }
  return true;
}

/// vfs_mkdata on disk file system d, whose names start p bytes in.
fn dk_symlink(d: &mut DiskFs, pc: &mut PCache, mem: &mut Mem, h0: u64, x: &mut Bytes, p: u64, n: u64, m: u64, mode: u64, now: u64) -> bool
  requires disk_ok(d) && blen(x) == XFER && p < n && n <= XFER && m <= FNAME_MAX && mode < 65536 && pc_ok(pc) && mem_ok(mem) && h0 <= LO0
  ensures disk_ok(d) && blen(x) == XFER && pc_ok(pc) && mem_ok(mem)
{
  let e = disk_create(&mut d, x, p, n - p, false, now);
  if e >= DSLOTS {
    return false;
  }
  pc_forget(&mut pc, &mut mem, h0 + e);
  xfer_shift(&mut x, n, m);
  if !disk_set_meta(&mut d, e, mode, NO_DISK_FILE) || disk_write_soon(&mut d, e, x, m, now) != m {
    disk_remove(&mut d, e);
    return false;
  }
  return true;
}

/// Moves x[from .. from + m] to the front of x.
fn xfer_shift(x: &mut Bytes, from: u64, m: u64)
  requires blen(x) == XFER
  ensures blen(x) == XFER
{
  if from > XFER || m > XFER - from {
    return;
  }
  let mut i = 0;
  while i < m
    invariant i <= m && from + m <= XFER && blen(x) == XFER
  {
    bset(&mut x, i, bget(x, from + i));
    i = i + 1;
  }
}

// ---------------------------------------------------------------- hard links

const LINKED: u64 = 0;
const LINK_NONE: u64 = 1;             // no such file, or the new name's directory is missing
const LINK_EXISTS: u64 = 2;
const LINK_XDEV: u64 = 3;             // the names are on different file systems
const LINK_DIR: u64 = 4;              // the old name is a directory
const LINK_FULL: u64 = 5;             // no free node or entry

/// Gives the file named xfer[0..n] another name, the m bytes after (a hard
/// link). The new name is a node of its own that names the file; opening
/// it opens the file, and the file lives until its last name goes. A link
/// to a link names the file the first one names.
fn vfs_link(v: &mut Vfs, n: u64, m: u64) -> u64
  requires vfs_ok(v) && n <= XFER && m <= XFER - n
  ensures vfs_ok(v)
{
  if n == 0 || m == 0 || n > FNAME_MAX || m > FNAME_MAX {
    return LINK_NONE;
  }
  let src_disk = on_disk(v, n);
  let src_lo = lo_pfx(&mut v, n) != 0;
  let f = vfs_lookup(&mut v, n);
  if f == NO_FILE {
    return LINK_NONE;
  }
  if vfs_is_dir(&mut v, f) {
    return LINK_DIR;
  }
  xfer_shift(&mut v.xfer, n, m);
  let new_disk = on_disk(v, m);
  let lp = lo_pfx(&mut v, m);
  if new_disk != src_disk || (lp != 0) != src_lo {
    return LINK_XDEV;
  }
  if !path_ok(v, m) || !parent_ok(&mut v, m) {
    return LINK_NONE;
  }
  if vfs_lookup(&mut v, m) != NO_FILE || vfs_dir_lookup(&mut v, m) != NO_FILE {
    return LINK_EXISTS;
  }
  if new_disk {
    if f < NFILES || f - NFILES >= DSLOTS || disk_link(&mut v.disk, v.xfer, DISK_PREFIX, m - DISK_PREFIX, f - NFILES, v.now) >= DSLOTS {
      return LINK_FULL;
    }
    return LINKED;
  }
  if lp != 0 {
    if v.lo_ro || f < LO0 || f >= HFILES {
      return LINK_FULL;
    }
    let e = disk_link(&mut v.lo, v.xfer, lp, m - lp, f - LO0, v.now);
    lo_settle(&mut v);
    if e >= DSLOTS {
      return LINK_FULL;
    }
    return LINKED;
  }
  if f >= NFILES || vfs_ram_link(&mut v, m, f) >= NFILES {
    return LINK_FULL;
  }
  return LINKED;
}

/// vfs_unlink of disk file entry d, which hard link l also names: the
/// file takes the link's name and the link goes, committed by one sector
/// write (disk_take_name).
fn disk_unlink_named(v: &mut Vfs, d: u64, l: u64) -> bool
  requires vfs_ok(v) && d < DSLOTS && l < DSLOTS
  ensures vfs_ok(v)
{
  return disk_take_name(&mut v.disk, d, l);
}

// ---------------------------------------------------------------- exchange

const XCHG_TMP: u64 = 16;             // ".rename-exchange", a name at the disk's top

/// Swaps the files named xfer[0..n] and the m bytes after (neither a
/// directory, both on one file system: the caller checks). Descriptors
/// stay on their files. In memory the two nodes swap names at once. On
/// the disk it is three entry writes: the first file moves to a spare
/// name at the disk's top (".rename-exchange"), the second takes the
/// first's name, then the first takes the second's; a power cut in between
/// can leave the first file under the spare name. False, changing nothing,
/// if the spare name is taken or a name is not there.
fn vfs_exchange(v: &mut Vfs, n: u64, m: u64) -> bool
  requires vfs_ok(v) && n <= XFER && m <= XFER - n
  ensures vfs_ok(v)
{
  if n == 0 || m == 0 || n > FNAME_MAX || m > FNAME_MAX {
    return false;
  }
  if on_disk(v, n) {
    return dk_exchange(&mut v.disk, v.xfer, DISK_PREFIX, n, m);
  }
  let lp = lo_pfx(&mut v, n);
  if lp != 0 {
    let ok = !v.lo_ro && dk_exchange(&mut v.lo, v.xfer, lp, n, m);
    lo_settle(&mut v);
    return ok;
  }
  let i = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, n);
  if i >= NFILES || n > NAMEBUF {
    return false;
  }
  // Keep the first name in v.name, and bring the second to the front.
  let mut c = 0;
  while c < n
    invariant c <= n && n <= FNAME_MAX && vfs_ok(v)
  {
    bset(&mut v.name, c, bget(v.xfer, c));
    c = c + 1;
  }
  xfer_shift(&mut v.xfer, n, m);
  let j = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, m);
  let il = ram_len(&mut v.ram, i);
  let jl = ram_len(&mut v.ram, j % NFILES);
  if j >= NFILES || i == j || il == NO_FILE || jl == NO_FILE {
    return false;
  }
  return ram_reprefix(&mut v.ram, &mut v.rix, i, il, v.xfer, m) && ram_reprefix(&mut v.ram, &mut v.rix, j, jl, v.name, n);
}

/// vfs_exchange on disk file system d, where both names start p bytes in.
fn dk_exchange(d: &mut DiskFs, x: &Bytes, p: u64, n: u64, m: u64) -> bool
  requires disk_ok(d) && blen(x) == XFER && n <= XFER && m <= XFER - n && p < n
  ensures disk_ok(d)
{
  let i = disk_find(d, x, p, n - p);
  if i >= DSLOTS || n + p > XFER || m <= p {
    return false;
  }
  let j = disk_find(d, x, n + p, m - p);
  if j >= DSLOTS || i == j {
    return false;
  }
  let tmp = bfrom(".rename-exchange");
  if blen(tmp) != XCHG_TMP || disk_find(d, tmp, 0, XCHG_TMP) < DSLOTS
    || !disk_move(&mut d, i, tmp, 0, XCHG_TMP) {
    bfree(tmp);
    return false;
  }
  if !disk_move(&mut d, j, x, p, n - p) {
    disk_move(&mut d, i, x, p, n - p);     // back, as it was
    bfree(tmp);
    return false;
  }
  bfree(tmp);
  return disk_move(&mut d, i, x, n + p, m - p);
}

// ---------------------------------------------------------------- mounts

// A tmpfs mount is an in-memory directory marked in v.mnt: the files in
// it are ordinary in-memory nodes (the in-memory file system already is
// a tmpfs), so mounting only marks the directory, and unmounting removes
// everything under it. src/lxmount.bastio has the system calls.

/// The mount slot on in-memory node i, or MNT_N if none.
fn vfs_mount_slot(v: &Vfs, i: u64) -> u64
  requires vfs_ok(v) && i < NFILES
  ensures result <= MNT_N
{
  let mut s = 0;
  while s < v.mnt_hi
    invariant s <= v.mnt_hi && v.mnt_hi <= MNT_N
  {
    if get(v.mnt, 2 * s) == i + 1 {
      return s;
    }
    s = s + 1;
  }
  return MNT_N;
}

/// The in-memory node mount slot s is on, or NFILES if s is free.
fn vfs_mount_node(v: &Vfs, s: u64) -> u64
  requires vfs_ok(v) && s < MNT_N
  ensures result <= NFILES
{
  let i1 = get(v.mnt, 2 * s);
  if i1 == 0 || i1 > NFILES {
    return NFILES;
  }
  return i1 - 1;
}

/// Is mount slot s read-only?
fn vfs_mount_ro(v: &Vfs, s: u64) -> bool
  requires vfs_ok(v) && s < MNT_N
{
  return get(v.mnt, 2 * s + 1) % 4 != 0;
}

/// Is mount slot s an ext4 image (src/ext4.bastio)? Such a mount stays
/// read-only.
fn vfs_mount_ext(v: &Vfs, s: u64) -> bool
  requires vfs_ok(v) && s < MNT_N
{
  return get(v.mnt, 2 * s + 1) % 4 == 2;
}

/// Marks mount slot s as a read-only ext4 image.
fn vfs_set_ext(v: &mut Vfs, s: u64)
  requires vfs_ok(v) && s < MNT_N
  ensures vfs_ok(v)
{
  let w = get(v.mnt, 2 * s + 1);
  v.mnt = set(v.mnt, 2 * s + 1, w - w % 4 + 2);
}

/// The mount flags kept for slot s (MS_NOSUID, MS_NODEV, MS_NOEXEC,
/// MS_NOATIME, MS_NODIRATIME): the upper bits of its second word.
fn vfs_mount_flags(v: &Vfs, s: u64) -> u64
  requires vfs_ok(v) && s < MNT_N
{
  return get(v.mnt, 2 * s + 1) / 4;
}

/// Sets the mount flags of slot s, keeping its read-only state.
fn vfs_set_mflags(v: &mut Vfs, s: u64, fl: u64)
  requires vfs_ok(v) && s < MNT_N && fl < 65536
  ensures vfs_ok(v)
{
  let w = get(v.mnt, 2 * s + 1);
  v.mnt = set(v.mnt, 2 * s + 1, w % 4 + fl * 4);
}

/// Mounts on in-memory directory node i. False if every slot is taken.
fn vfs_mount(v: &mut Vfs, i: u64, ro: bool) -> bool
  requires vfs_ok(v) && i < NFILES
  ensures vfs_ok(v)
{
  let mut s = 0;
  while s < MNT_N && get(v.mnt, 2 * s) != 0
    invariant s <= MNT_N && vfs_ok(v)
  {
    s = s + 1;
  }
  if s >= MNT_N {
    return false;
  }
  v.mnt = set(v.mnt, 2 * s, i + 1);
  if s >= v.mnt_hi {
    v.mnt_hi = s + 1;
  }
  vfs_set_ro(&mut v, s, ro);
  return true;
}

/// Makes mount slot s read-only or writable.
fn vfs_set_ro(v: &mut Vfs, s: u64, ro: bool)
  requires vfs_ok(v) && s < MNT_N
  ensures vfs_ok(v)
{
  let w = get(v.mnt, 2 * s + 1);
  let mut r = 0;
  if ro {
    r = 1;
  }
  v.mnt = set(v.mnt, 2 * s + 1, w - w % 4 + r);
}

/// Is a[..l] the same as b[..l]?
fn same_start(a: &Bytes, b: &Bytes, l: u64) -> bool
  requires l <= blen(a) && l <= blen(b)
{
  return bytes_span_eq(a, 0, b, 0, l);
}

/// Does the path in the first n bytes of the transfer buffer lie in a
/// read-only mount (or name its directory)?
fn vfs_ro(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  return vfs_in_mount(&mut v, n, true) || (v.lo_ro && vfs_in_lo(&mut v, n));
}

/// Does the path in the first n bytes of the transfer buffer lie in a
/// mount (a read-only one, if ro_only), or name its directory?
fn vfs_in_mount(v: &mut Vfs, n: u64, ro_only: bool) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if on_disk(v, n) {
    return false;
  }
  let mut s = 0;
  while s < v.mnt_hi
    invariant s <= v.mnt_hi && v.mnt_hi <= MNT_N && vfs_ok(v) && n <= XFER
  {
    let i = vfs_mount_node(v, s);
    if i < NFILES && (vfs_mount_ro(v, s) || !ro_only) {
      let l = ram_name(&mut v.ram, i, &mut v.name);
      if l != NO_FILE && l <= n && (l == n || bget(v.xfer, l) == 47) && same_start(v.xfer, v.name, l) {
        return true;
      }
    }
    s = s + 1;
  }
  return false;
}

/// Which file system the name in the first n bytes of the transfer buffer
/// is on, as a number to compare: FS_DISK, FS_LO, 4 + s for tmpfs mount
/// slot s (the innermost one holding the name, or whose directory it
/// names), or FS_RAM. Names on different ones cannot be linked or renamed
/// into each other (EXDEV).
fn vfs_dev_of(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  let k = vfs_fs_of(&mut v, n);
  if k != FS_RAM {
    return k;
  }
  let mut best = FS_RAM;
  let mut best_l = 0;
  let mut s = 0;
  while s < v.mnt_hi
    invariant s <= v.mnt_hi && v.mnt_hi <= MNT_N && vfs_ok(v) && n <= XFER
  {
    let i = vfs_mount_node(v, s);
    if i < NFILES {
      let l = ram_name(&mut v.ram, i, &mut v.name);
      if l != NO_FILE && l <= n && (l == n || bget(v.xfer, l) == 47) && same_start(v.xfer, v.name, l) && (best == FS_RAM || l > best_l) {
        best = 4 + s;
        best_l = l;
      }
    }
    s = s + 1;
  }
  return best;
}

/// The mount flags (the statfs f_flags: ST_RDONLY 1, ST_NOSUID 2, ST_NODEV 4,
/// ST_NOEXEC 8, ST_NOATIME 1024, ST_NODIRATIME 2048) of the innermost tmpfs
/// mount that holds the name in the first n bytes of the transfer buffer,
/// or 0.
fn vfs_path_mflags(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if on_disk(v, n) {
    return 0;
  }
  let mut best = 0;
  let mut best_l = 0;
  let mut found = false;
  let mut s = 0;
  while s < v.mnt_hi
    invariant s <= v.mnt_hi && v.mnt_hi <= MNT_N && vfs_ok(v) && n <= XFER
  {
    let i = vfs_mount_node(v, s);
    if i < NFILES {
      let l = ram_name(&mut v.ram, i, &mut v.name);
      if l != NO_FILE && l <= n && (l == n || bget(v.xfer, l) == 47) && same_start(v.xfer, v.name, l) && (!found || l > best_l) {
        found = true;
        best_l = l;
        best = smaller(vfs_mount_flags(v, s), 65535);
        if vfs_mount_ro(v, s) {
          best = best + 1;
        }
      }
    }
    s = s + 1;
  }
  return best;
}

/// vfs_path_mflags of file f (a vfs_lookup handle). Uses the transfer buffer.
fn vfs_file_mflags(v: &mut Vfs, f: u64) -> u64
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  if f >= NFILES {
    return 0;
  }
  let l = ram_name(&mut v.ram, f, &mut v.xfer);
  if l == NO_FILE {
    return 0;
  }
  return vfs_path_mflags(&mut v, l);
}

/// Does file f (a vfs_lookup handle) lie in a mount? Uses the transfer
/// buffer.
fn vfs_file_in_mount(v: &mut Vfs, f: u64) -> bool
  requires vfs_ok(v)
  ensures vfs_ok(v)
{
  if f >= NFILES {
    return false;                           // on the disk
  }
  let l = ram_name(&mut v.ram, f, &mut v.xfer);
  if l == NO_FILE {
    return false;
  }
  return vfs_in_mount(&mut v, l, false);
}

/// Is anything under the in-memory directory named by the first n bytes
/// of the transfer buffer?
fn vfs_ram_has_children(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if !ram_has_under(v.rix, v.xfer, n) {
    return false;               // the count of names under it is 0
  }
  let mut j = 0;
  while j < NFILES
    invariant j <= NFILES && vfs_ok(v) && n <= XFER
  {
    if ram_under(&mut v.ram, j, v.xfer, n) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// Does the first n bytes of the transfer buffer name a mount's directory?
fn vfs_is_mount(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if on_disk(v, n) {
    return false;
  }
  let i = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, n);
  return i < NFILES && (vfs_mount_slot(v, i) < MNT_N || i + 1 == v.lo_at);
}

/// Unmounts slot s: removes every node under its directory (which stays,
/// as on Linux, where it shows again once uncovered). False, changing
/// nothing, if a file under it is open.
fn vfs_umount(v: &mut Vfs, mem: &mut Mem, s: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && s < MNT_N
  ensures vfs_ok(v) && mem_ok(mem)
{
  let i = vfs_mount_node(v, s);
  if i < NFILES {
    let l = ram_name(&mut v.ram, i, &mut v.name);
    if l != NO_FILE {
      let mut j = 0;
      while j < NFILES
        invariant j <= NFILES && vfs_ok(v) && mem_ok(mem) && l <= NAMEBUF
      {
        if ram_under(&mut v.ram, j, v.name, l) && (node_open(v.nopen, FS_RAM, j) || j == v.lo_file || j + 1 == v.lo_at) {
          return false;
        }
        j = j + 1;
      }
      j = 0;
      while j < NFILES
        invariant j <= NFILES && vfs_ok(v) && mem_ok(mem) && l <= NAMEBUF
      {
        if ram_under(&mut v.ram, j, v.name, l) {
          ram_remove(&mut v.ram, &mut v.rix, &mut mem, j);
        }
        j = j + 1;
      }
    }
  }
  v.mnt = set(v.mnt, 2 * s, 0);
  v.mnt = set(v.mnt, 2 * s + 1, 0);
  return true;
}

/// Removes the in-memory directory named by the first n bytes of the
/// transfer buffer and every node under it. True if it was removed or was
/// not there; false, changing nothing, if a file under it is open.
fn vfs_drop_tree(v: &mut Vfs, mem: &mut Mem, n: u64) -> bool
  requires vfs_ok(v) && mem_ok(mem) && n <= XFER
  ensures vfs_ok(v) && mem_ok(mem)
{
  if on_disk(v, n) {
    return false;
  }
  let d = ram_find(&mut v.ram, v.rix, v.rhi, v.xfer, n);
  if d >= NFILES {
    return true;
  }
  let l = ram_name(&mut v.ram, d, &mut v.name);
  if l == NO_FILE {
    return false;
  }
  let mut j = 0;
  while j < NFILES
    invariant j <= NFILES && vfs_ok(v) && mem_ok(mem) && l <= NAMEBUF
  {
    if ram_under(&mut v.ram, j, v.name, l) && (node_open(v.nopen, FS_RAM, j) || j == v.lo_file || j + 1 == v.lo_at) {
      return false;
    }
    j = j + 1;
  }
  // Mounts on directories under it go with it.
  let mut s = 0;
  while s < v.mnt_hi
    invariant s <= v.mnt_hi && v.mnt_hi <= MNT_N && vfs_ok(v) && mem_ok(mem) && l <= NAMEBUF
  {
    let mj = vfs_mount_node(v, s);
    if mj < NFILES && ram_under(&mut v.ram, mj, v.name, l) {
      v.mnt = set(v.mnt, 2 * s, 0);
      v.mnt = set(v.mnt, 2 * s + 1, 0);
    }
    s = s + 1;
  }
  j = 0;
  while j < NFILES
    invariant j <= NFILES && vfs_ok(v) && mem_ok(mem) && l <= NAMEBUF
  {
    if ram_under(&mut v.ram, j, v.name, l) {
      ram_remove(&mut v.ram, &mut v.rix, &mut mem, j);
    }
    j = j + 1;
  }
  ram_remove(&mut v.ram, &mut v.rix, &mut mem, d);
  return true;
}

// ---------------------------------------------------------------- the loop mount

// A disk image in an in-memory file, attached to a loop device, mounted
// on an in-memory directory. The file's pages move into the mount's disk
// driver (src/loopblk.bastio) and come back at unmount; meanwhile the
// file cannot be written or truncated, and reading it gives zeros. One
// image at a time.

const LO_OK: u64 = 0;
const LO_BUSY: u64 = 1;               // already mounted, or the file is busy
const LO_NOFS: u64 = 2;               // no BastiOS file system on the image
const LO_NOMEM: u64 = 3;
const LO_NODEV: u64 = 255;            // lo_dev of an image mounted straight from its file

/// Mounts the disk image in in-memory file f on in-memory directory node
/// `at`, read-only if `ro`; dev is the loop device's number. The image
/// must already be formatted (mkfs.bstdisk3): an image with no file system
/// is refused rather than formatted.
fn vfs_lo_mount(v: &mut Vfs, mem: &mut Mem, f: u64, at: u64, dev: u64, ro: bool) -> u64
  requires vfs_ok(v) && mem_ok(mem) && f < NFILES && at < NFILES
  ensures vfs_ok(v) && mem_ok(mem)
{
  if v.lo_at != 0 || f == at || ram_is_dir(&mut v.ram, f) {
    return LO_BUSY;
  }
  let size = ram_size(&mut v.ram, f);
  if size == NO_FILE || size > FILE_MAX || size < 4096 * (DATA_B0 + 16) {
    return LO_NOFS;
  }
  // Is there a file system? The magic is in the first 8 bytes.
  if vfs_read_at(&mut v, f, 0, 8) != 8 {
    return LO_NOFS;
  }
  let magic = get_u64(v.xfer, 0);
  if magic != DISK_MAGIC && magic != DISK_MAGIC2 && magic != DISK_MAGIC4 && magic != DISK_MAGIC5 && magic != DISK_MAGIC6 {
    return LO_NOFS;
  }
  pc_forget(&mut v.pc, &mut mem, f);                 // the loop driver owns its pages now
  let mut pages = ram_take_pages(&mut v.ram, f);
  let ok = loopdev_fill(&mut pages, &mut mem, (size + 4095) / 4096);
  v.lo_size = 0;
  let prev = lo_swap(&mut v, pages, size);
  if v.lo_size == 0 {
    ram_put_pages(&mut v.ram, &mut mem, f, prev);  // never: see lo_swap
    return LO_BUSY;
  }
  slots_free(prev, &mut mem);
  if !ok || v.lo.slots == 0 {
    lo_give_back(&mut v, &mut mem, f);
    if !ok {
      return LO_NOMEM;
    }
    return LO_NOFS;
  }
  pc_forget_range(&mut v.pc, &mut mem, LO0, HFILES);   // the handles name this image's files now
  v.lo_at = at + 1;
  v.lo_file = f;
  v.lo_dev = dev;
  v.lo_ro = ro;
  return LO_OK;
}

/// Unmounts the loop mount: the pages go back to the file. False if
/// nothing is mounted or a file in it is open.
fn vfs_lo_umount(v: &mut Vfs, mem: &mut Mem) -> bool
  requires vfs_ok(v) && mem_ok(mem)
  ensures vfs_ok(v) && mem_ok(mem)
{
  if v.lo_at == 0 || v.lo_file >= NFILES {
    return false;
  }
  let mut r = 0;
  let rows = len(v.ftab) / FD_STRIDE;       // the rows the table has grown to
  while r < rows && r < FD_ROWS
    invariant r <= FD_ROWS && vfs_ok(v)
  {
    if fget(v.ftab, r, FD_FS) == FS_LO {
      return false;
    }
    r = r + 1;
  }
  pc_forget_range(&mut v.pc, &mut mem, LO0, HFILES);
  let f = v.lo_file;
  pc_forget(&mut v.pc, &mut mem, f);
  lo_give_back(&mut v, &mut mem, f);
  v.lo_at = 0;
  v.lo_file = NFILES;
  if ram_len(&mut v.ram, f) == 0 && !node_open(v.nopen, FS_RAM, f) {
    ram_remove(&mut v.ram, &mut v.rix, &mut mem, f);  // its name was removed while it was mounted
  }
  return true;
}

/// Swaps an empty driver in for the loop mount's and puts its pages back
/// into in-memory file f (or frees them if f is gone).
fn lo_give_back(v: &mut Vfs, mem: &mut Mem, f: u64)
  requires vfs_ok(v) && mem_ok(mem) && f < NFILES
  ensures vfs_ok(v) && mem_ok(mem)
{
  ram_put_pages(&mut v.ram, &mut mem, f, lo_swap(&mut v, vec_new[Slot](), 0));
}

/// The file system the name in the first n bytes of the transfer buffer is
/// on: FS_DISK, FS_LO (below the loop mount's directory) or FS_RAM.
fn vfs_fs_of(v: &mut Vfs, n: u64) -> u64
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  if on_disk(v, n) {
    return FS_DISK;
  }
  if lo_pfx(&mut v, n) != 0 {
    return FS_LO;
  }
  return FS_RAM;
}

/// Is a disk image mounted, and does the path in the first n bytes of the
/// transfer buffer lie in it (or name its directory)?
fn vfs_in_lo(v: &mut Vfs, n: u64) -> bool
  requires vfs_ok(v) && n <= XFER
  ensures vfs_ok(v)
{
  return lo_pfx(&mut v, n) != 0 || lo_root(&mut v, n);
}
