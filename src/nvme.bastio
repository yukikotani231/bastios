// An NVMe drive (the SSDs of modern PCs; QEMU's -device nvme), driven by
// polling: the controller runs, but never interrupts.
//
// The driver resets the controller, sets up the admin queue pair, asks
// namespace 1 for its size, and creates one I/O queue pair. Each read or
// write is one command for one 512-byte sector, whose data goes through a
// page lent to the controller; the driver waits for its completion before
// doing anything else, so there is never more than one command in flight.
// A write is followed by a flush, so the sector is on the medium (not just
// in the drive's cache) when the write returns.
//
// The registers are a block of the device window claimed as an `Mmio`.
// The controller reads and writes only the five pages lent to it at start
// (`Dma`), which come back after the controller is shut down and disabled
// at power off:
//
//   asq, acq   the admin submission and completion queues
//   sq, cq     the I/O submission and completion queues
//   buf        identify data, then each sector's data
//
// Queues have Q_N entries: 64-byte commands, 16-byte completions. The
// submission tails are plain indexes; the completion heads are kept as
// index * 2 + the phase bit the next completion will carry.

import "pci.bastio";
import "pages.bastio";

const NVME_CLASS: u64 = 0x010802;      // mass storage, non-volatile memory, NVMe
const NVME_PAGES: u64 = 5;
const NVME_MAX_LEN: u64 = 0x100000;    // registers claimed: the BAR, up to 1 MiB
const NVME_SPINS: u64 = 20000000;
const NVME_SECTOR: u64 = 512;
const Q_N: u64 = 64;

// Controller registers.
const NV_CAP: u64 = 0x00;
const NV_CC: u64 = 0x14;
const NV_CSTS: u64 = 0x1C;
const NV_AQA: u64 = 0x24;
const NV_ASQ: u64 = 0x28;
const NV_ACQ: u64 = 0x30;
const NV_DB: u64 = 0x1000;             // doorbells: SQ0 tail, CQ0 head, SQ1 tail, CQ1 head

const CC_EN: u64 = 1;
const CC_QUEUES: u64 = 0x460000;       // 16-byte completions, 64-byte commands
const CC_SHUTDOWN: u64 = 0x4000;       // normal shutdown notification
const CSTS_RDY: u64 = 1;
const CSTS_FATAL: u64 = 2;

// Commands.
const OP_CREATE_SQ: u64 = 0x01;
const OP_CREATE_CQ: u64 = 0x05;
const OP_IDENTIFY: u64 = 0x06;
const OP_FLUSH: u64 = 0x00;
const OP_WRITE: u64 = 0x01;
const OP_READ: u64 = 0x02;

struct Nvme {
  regs: Mmio,
  asq: Dma, acq: Dma, sq: Dma, cq: Dma, buf: Dma,
  stride: u64,        // bytes between doorbells
  asq_at: u64,        // submission tails
  sq_at: u64,
  acq_at: u64,        // completion heads: index * 2 + phase
  cq_at: u64,
  sectors: u64,       // 0 when the drive could not be started
}

spec fn nvme_ok(n: &Nvme) -> bool {
  mmio_base(n.regs) % 4096 == 0 && mmio_len(n.regs) <= NVME_MAX_LEN
  && n.stride % 4 == 0 && 4 <= n.stride && NV_DB + 4 * n.stride <= mmio_len(n.regs)
  && n.asq_at < Q_N && n.sq_at < Q_N && n.acq_at < Q_N * 2 && n.cq_at < Q_N * 2
}

fn nr32(n: &mut Nvme, off: u64) -> u64
  requires mmio_base(n.regs) % 4096 == 0 && off % 4 == 0 && off + 4 <= mmio_len(n.regs)
  ensures result <= 4294967295
{
  return cast[u64](mmio_read32(&mut n.regs, off));
}

fn nw32(n: &mut Nvme, off: u64, v: u64)
  requires mmio_base(n.regs) % 4096 == 0 && off % 4 == 0 && off + 4 <= mmio_len(n.regs) && v <= 4294967295
{
  mmio_write32(&mut n.regs, off, cast[u32](v));
}

fn nw64(n: &mut Nvme, off: u64, v: u64)
  requires mmio_base(n.regs) % 4096 == 0 && off % 8 == 0 && off + 8 <= mmio_len(n.regs)
{
  mmio_write64(&mut n.regs, off, v);
}

/// Rings doorbell i (0: admin tail, 1: admin head, 2: I/O tail, 3: I/O head).
fn ring(n: &mut Nvme, i: u64, v: u64)
  requires nvme_ok(n) && i < 4 && v <= 4294967295
  ensures nvme_ok(n) && n.sectors == old(n.sectors)
{
  nw32(&mut n, NV_DB + i * n.stride, v);
}

/// Waits until CSTS.RDY is `rdy`; false on a timeout or a fatal error.
fn wait_ready(n: &mut Nvme, rdy: u64) -> bool
  requires nvme_ok(n)
  ensures nvme_ok(n) && n.sectors == old(n.sectors)
{
  let mut i = 0;
  let sec0 = n.sectors;
  while i < NVME_SPINS
    invariant nvme_ok(n) && n.sectors == sec0
  {
    let s = nr32(&mut n, NV_CSTS);
    if s & CSTS_FATAL != 0 {
      return false;
    }
    if s & CSTS_RDY == rdy {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Fills command slot `slot` of a submission queue page: opcode, command
/// id, namespace, the data page and command dwords 10 to 12.
fn sqe(d: &mut Dma, slot: u64, op: u64, nsid: u64, prp: u64, c10: u64, c11: u64, c12: u64)
  requires slot < Q_N && op < 256 && nsid <= 4294967295 && c10 <= 4294967295 && c11 <= 4294967295 && c12 <= 4294967295
{
  let at = slot * 64;
  let mut i = 0;
  while i < 64
    invariant i <= 64 && i % 8 == 0 && at + 64 <= 4096 && at % 64 == 0
  {
    dma_write64(&mut d, at + i, 0);
    i = i + 8;
  }
  dma_write32(&mut d, at, cast[u32](op + slot * 65536));
  dma_write32(&mut d, at + 4, cast[u32](nsid));
  dma_write64(&mut d, at + 24, prp);
  dma_write32(&mut d, at + 40, cast[u32](c10));
  dma_write32(&mut d, at + 44, cast[u32](c11));
  dma_write32(&mut d, at + 48, cast[u32](c12));
}

/// The completion head after `at`.
fn cq_next(at: u64) -> u64
  requires at < Q_N * 2
  ensures result < Q_N * 2
{
  if at / 2 + 1 < Q_N {
    return at + 2;
  }
  return 1 - at % 2;                  // back to entry 0, with the phase flipped
}

/// The completion status in dword 3 of the entry the head `at` points
/// at, or 65536 if the controller has not written it yet.
fn cqe_status(d: &mut Dma, at: u64) -> u64
  requires at < Q_N * 2
  ensures result <= 65536
{
  let w = cast[u64](dma_read32(&mut d, at / 2 * 16 + 12));
  if (w >> 16) % 2 != at % 2 {
    return 65536;
  }
  return (w >> 17) % 32768;
}

/// Submits a command on the admin queue (`io` false) or the I/O queue and
/// waits for its completion; true if it succeeded.
fn nvme_cmd(n: &mut Nvme, io: bool, op: u64, nsid: u64, prp: u64, c10: u64, c11: u64, c12: u64) -> bool
  requires nvme_ok(n) && op < 256 && nsid <= 4294967295 && c10 <= 4294967295 && c11 <= 4294967295 && c12 <= 4294967295
  ensures nvme_ok(n) && n.sectors == old(n.sectors)
{
  if io {
    sqe(&mut n.sq, n.sq_at, op, nsid, prp, c10, c11, c12);
    n.sq_at = (n.sq_at + 1) % Q_N;
    ring(&mut n, 2, n.sq_at);
  } else {
    sqe(&mut n.asq, n.asq_at, op, nsid, prp, c10, c11, c12);
    n.asq_at = (n.asq_at + 1) % Q_N;
    ring(&mut n, 0, n.asq_at);
  }
  let mut i = 0;
  let sec0 = n.sectors;
  while i < NVME_SPINS
    invariant nvme_ok(n) && n.sectors == sec0
  {
    if io {
      let s = cqe_status(&mut n.cq, n.cq_at);
      if s < 65536 {
        n.cq_at = cq_next(n.cq_at);
        ring(&mut n, 3, n.cq_at / 2);
        return s == 0;
      }
    } else {
      let s = cqe_status(&mut n.acq, n.acq_at);
      if s < 65536 {
        n.acq_at = cq_next(n.acq_at);
        ring(&mut n, 1, n.acq_at / 2);
        return s == 0;
      }
    }
    i = i + 1;
  }
  return false;
}

/// Clears CC.EN and waits for the controller to stop: afterwards it does
/// not touch the queues or any page they named.
fn nvme_disable(n: &mut Nvme) -> bool
  requires nvme_ok(n)
  ensures nvme_ok(n) && n.sectors == old(n.sectors)
{
  let cc = nr32(&mut n, NV_CC);
  nw32(&mut n, NV_CC, cc - cc % 2);
  return wait_ready(&mut n, 0);
}

/// Starts the controller whose registers are `regs`, lending it five
/// pages. A drive that cannot be started is left with `sectors` 0.
fn nvme_new(regs: Mmio, f0: Frame, f1: Frame, f2: Frame, f3: Frame, f4: Frame) -> Nvme
  requires mmio_base(regs) % 4096 == 0 && mmio_len(regs) <= NVME_MAX_LEN && mmio_len(regs) >= 0x2000
  ensures nvme_ok(result) && mmio_base(result.regs) == mmio_base(regs) && mmio_len(result.regs) == mmio_len(regs)
{
  let mut n = Nvme { regs: regs, asq: dma_lend(f0), acq: dma_lend(f1), sq: dma_lend(f2), cq: dma_lend(f3),
    buf: dma_lend(f4), stride: 4, asq_at: 0, sq_at: 0, acq_at: 1, cq_at: 1, sectors: 0 };
  let cap_lo = nr32(&mut n, NV_CAP);
  let cap_hi = nr32(&mut n, NV_CAP + 4);
  let mut stride = 4;
  let mut k = 0;
  while k < cap_hi % 16 && stride <= 65536
    invariant stride % 4 == 0 && 4 <= stride && stride <= 131072 && nvme_ok(n)
  {
    stride = stride * 2;
    k = k + 1;
  }
  // Needs 4 KiB pages (MPSMIN 0), the NVM command set, room for 64 entries
  // per queue and the four doorbells inside the claimed block.
  if (cap_hi >> 16) % 16 != 0 || (cap_hi >> 5) % 2 == 0 || cap_lo % 65536 < Q_N - 1
    || NV_DB + 4 * stride > mmio_len(n.regs) {
    return n;
  }
  n.stride = stride;
  if !nvme_disable(&mut n) {
    return n;
  }
  let mut i = 0;
  while i < 4096
    invariant i <= 4096 && i % 8 == 0 && nvme_ok(n)
  {
    dma_write64(&mut n.asq, i, 0);
    dma_write64(&mut n.acq, i, 0);
    dma_write64(&mut n.sq, i, 0);
    dma_write64(&mut n.cq, i, 0);
    i = i + 8;
  }
  nw32(&mut n, NV_AQA, (Q_N - 1) * 65536 + Q_N - 1);
  nw64(&mut n, NV_ASQ, dma_phys(n.asq));
  nw64(&mut n, NV_ACQ, dma_phys(n.acq));
  nw32(&mut n, NV_CC, CC_QUEUES + CC_EN);
  if !wait_ready(&mut n, 1) {
    return n;
  }
  // Namespace 1: its size in blocks (bytes 0-7), and the size of a block
  // from the LBA format in use (byte 26 picks one of the formats from
  // byte 128, 4 bytes each; byte 2 of a format is log2 of the block size).
  if !nvme_cmd(&mut n, false, OP_IDENTIFY, 1, dma_phys(n.buf), 0, 0, 0) {
    return n;
  }
  let size = dma_read64(&mut n.buf, 0);
  let fmt = cast[u64](dma_read8(&mut n.buf, 26)) % 16;
  let lbads = cast[u64](dma_read8(&mut n.buf, 128 + fmt * 4 + 2));
  if lbads != 9 {
    return n;                         // only 512-byte blocks for now
  }
  // The I/O queues: completion queue 1, then submission queue 1 feeding it
  // (physically contiguous, no interrupts).
  if !nvme_cmd(&mut n, false, OP_CREATE_CQ, 0, dma_phys(n.cq), (Q_N - 1) * 65536 + 1, 1, 0)
    || !nvme_cmd(&mut n, false, OP_CREATE_SQ, 0, dma_phys(n.sq), (Q_N - 1) * 65536 + 1, 65536 + 1, 0) {
    return n;
  }
  n.sectors = size;
  return n;
}

/// Shuts the controller down (so it writes back its cache), disables it,
/// and takes its pages back (at power off). Returns its registers.
fn nvme_free(n: Nvme, m: &mut Mem) -> Mmio
  requires nvme_ok(n) && mem_ok(m)
  ensures mem_ok(m) && mmio_base(result) == mmio_base(n.regs) && mmio_len(result) == mmio_len(n.regs)
{
  let mut d = n;
  let cc = nr32(&mut d, NV_CC);
  if cc % 2 == 1 {
    nw32(&mut d, NV_CC, (cc - cc % 65536) + cc % 16384 + CC_SHUTDOWN);
    let mut i = 0;
    while i < NVME_SPINS
      invariant nvme_ok(d)
    {
      if (nr32(&mut d, NV_CSTS) >> 2) % 4 == 2 {
        i = NVME_SPINS;
      } else {
        i = i + 1;
      }
    }
  }
  nvme_disable(&mut d);
  give_page(&mut m, dma_take(d.asq));
  give_page(&mut m, dma_take(d.acq));
  give_page(&mut m, dma_take(d.sq));
  give_page(&mut m, dma_take(d.cq));
  give_page(&mut m, dma_take(d.buf));
  return d.regs;
}

/// Reads sector `lba` into buf[0..512]. Returns false if the drive fails
/// or the sector is past its end.
fn nvme_read(n: &mut Nvme, lba: u64, buf: &mut Bytes) -> bool
  requires nvme_ok(n) && blen(buf) >= NVME_SECTOR
  ensures nvme_ok(n) && n.sectors == old(n.sectors) && blen(buf) == old(blen(buf))
{
  if lba >= n.sectors {
    return false;
  }
  if !nvme_cmd(&mut n, true, OP_READ, 1, dma_phys(n.buf), lba % 4294967296, lba / 4294967296 % 4294967296, 0) {
    return false;
  }
  let l = blen(buf);
  let mut i = 0;
  let sec0 = n.sectors;
  while i < NVME_SECTOR
    invariant i <= NVME_SECTOR && nvme_ok(n) && n.sectors == sec0 && blen(buf) == l && l >= NVME_SECTOR
  {
    bset(&mut buf, i, dma_read8(&mut n.buf, i));
    i = i + 1;
  }
  return true;
}

/// Writes buf[0..512] to sector `lba`, then flushes the drive's cache.
fn nvme_write(n: &mut Nvme, lba: u64, buf: &Bytes) -> bool
  requires nvme_ok(n) && blen(buf) >= NVME_SECTOR
  ensures nvme_ok(n) && n.sectors == old(n.sectors)
{
  if lba >= n.sectors {
    return false;
  }
  let mut i = 0;
  let sec0 = n.sectors;
  while i < NVME_SECTOR
    invariant i <= NVME_SECTOR && nvme_ok(n) && n.sectors == sec0
  {
    dma_write8(&mut n.buf, i, bget(buf, i));
    i = i + 1;
  }
  return nvme_cmd(&mut n, true, OP_WRITE, 1, dma_phys(n.buf), lba % 4294967296, lba / 4294967296 % 4294967296, 0)
    && nvme_cmd(&mut n, true, OP_FLUSH, 1, 0, 0, 0, 0);
}
