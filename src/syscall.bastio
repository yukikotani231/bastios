// System calls. A user program raises `int 0x80` with the call number in
// rax and arguments in rdi, rsi, rdx; the result goes back in rax. The
// numbers are the ones in bastiolang's user prelude.

import "pages.bastio";
import "space.bastio";
import "proc.bastio";
import "fs.bastio";
import "usermem.bastio";

const SYS_EXIT: u64 = 0;
const SYS_WRITE: u64 = 1;
const SYS_READ: u64 = 2;
const SYS_SPAWN: u64 = 3;
const SYS_WAIT: u64 = 4;
const SYS_YIELD: u64 = 5;
const SYS_GETPID: u64 = 6;
const SYS_INFO: u64 = 7;
const SYS_PS: u64 = 8;
const SYS_KILL: u64 = 9;
const SYS_POWEROFF: u64 = 10;
// Files. User programs make these with sys_call / sys_send / sys_recv.
const SYS_OPEN: u64 = 11;             // (flags, name, name length) -> fd
const SYS_CLOSE: u64 = 12;            // (fd) -> 0
const SYS_FREAD: u64 = 13;            // (fd, buffer, length) -> bytes read
const SYS_FWRITE: u64 = 14;           // (fd, buffer, length) -> bytes written
const SYS_UNLINK: u64 = 15;           // (_, name, name length) -> 0
const SYS_DIRENT: u64 = 16;           // (entry, buffer, length) -> name length, 0 if unused
const SYS_SEEK: u64 = 17;             // (fd, offset) -> 0
// The network (src/net.bastio). Socket calls return NO_RESULT on failure.
const SYS_PING: u64 = 40;             // (address) -> 1 reply, 0 none, 2 no ARP answer, 3 no network card
const SYS_SOCKET: u64 = 41;           // () -> a UDP socket
const SYS_BIND: u64 = 42;             // (socket, port; 0: any) -> 0
const SYS_SENDTO: u64 = 43;           // (socket + 256 * port + 2^24 * address, buffer, length) -> length
const SYS_RECVFROM: u64 = 44;         // (socket, buffer, length) -> length; NO_RESULT if none waits
const SYS_PEER: u64 = 45;             // (socket) -> 65536 * address + port of the last sender
const SYS_SCLOSE: u64 = 46;           // (socket) -> 0
const SYS_STAT: u64 = 18;             // (_, name, name length) -> size

// What the scheduler does after a system call.
const KEEP: u64 = 0;
const SWITCH: u64 = 1;
const POWEROFF: u64 = 2;

// ---------------------------------------------------------------- user memory

/// Writes the n bytes at user address va to the console. Returns the count
/// written, which stops short at an unmapped page.
fn do_write(con: &mut Uart, spaces: &mut Vec[Space], pid: u64, va: u64, n: u64) -> u64
  requires uart_ok(con) && spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces)
{
  if !user_range(va, n) {
    return NO_RESULT;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NO_RESULT; },
    Space::Mapped(mut root) => {
      let k = write_from(&mut con, &mut root, off, n);
      put_space(&mut spaces, pid, Space::Mapped(root));
      return k;
    },
  }
}

/// Writes the n bytes at offset off of the user window to the console,
/// stopping short at an unmapped page. Returns the count written.
fn write_from(con: &mut Uart, root: &mut PageTable, off: u64, n: u64) -> u64
  requires uart_ok(con) && pt_level(root) == 4 && off + n <= USER_SIZE
{
  // The window is one level-1 table: walk down to it once, not per byte.
  if !pt_has(root, 1) {
    return 0;
  }
  let mut k = 0;
  let mut l3 = pt_take(&mut root, 1);
  if pt_has(l3, 0) {
    let mut l2 = pt_take(&mut l3, 0);
    if pt_has(l2, 0) {
      let mut l1 = pt_take(&mut l2, 0);
      k = write_l1(&mut con, &mut l1, off, n);
      pt_put(&mut l2, 0, l1);
    }
    pt_put(&mut l3, 0, l2);
  }
  pt_put(&mut root, 1, l3);
  return k;
}

/// write_from below the level-1 table: takes each page out once and
/// writes every wanted byte on it.
fn write_l1(con: &mut Uart, l1: &mut PageTable, off: u64, n: u64) -> u64
  requires uart_ok(con) && pt_level(l1) == 1 && off + n <= USER_SIZE
{
  let mut k = 0;
  let mut ok = true;
  while ok && k < n
    invariant k <= n && pt_level(l1) == 1
  {
    let a = off + k;
    let p = a / 4096;
    if pt_has(l1, p) {
      let m = chunk(a, n - k);
      let f = pt_take_frame(&mut l1, p);
      let mut j = 0;
      while j < m
        invariant j <= m
      {
        uart_write(&mut con, frame_read8(f, a % 4096 + j));
        j = j + 1;
      }
      pt_put_frame(&mut l1, p, f, true);
      k = k + m;
    } else {
      ok = false;
    }
  }
  return k;
}

/// The program whose name is the n bytes at user address va, or NPROGS.
fn lookup(spaces: &mut Vec[Space], pid: u64, va: u64, n: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces)
  ensures result <= NPROGS
{
  if !user_range(va, n) {
    return NPROGS;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NPROGS; },
    Space::Mapped(mut root) => {
      let found = find_prog(&mut root, off, n);
      put_space(&mut spaces, pid, Space::Mapped(root));
      return found;
    },
  }
}

/// The program whose name is the n bytes at offset off of the user
/// window, or NPROGS.
fn find_prog(root: &mut PageTable, off: u64, n: u64) -> u64
  requires pt_level(root) == 4 && off + n <= USER_SIZE
  ensures pt_level(root) == 4
  ensures result <= NPROGS
{
  if !pt_has(root, 1) {
    return NPROGS;
  }
  let mut found = NPROGS;
  let mut l3 = pt_take(&mut root, 1);
  if pt_has(l3, 0) {
    let mut l2 = pt_take(&mut l3, 0);
    if pt_has(l2, 0) {
      let mut l1 = pt_take(&mut l2, 0);
      let mut i = 0;
      while i < NPROGS
        invariant i <= NPROGS && found <= NPROGS && pt_level(l1) == 1
      {
        if found == NPROGS && l1_matches(&mut l1, off, n, prog_name(i)) {
          found = i;
        }
        i = i + 1;
      }
      pt_put(&mut l2, 0, l1);
    }
    pt_put(&mut l3, 0, l2);
  }
  pt_put(&mut root, 1, l3);
  return found;
}

/// Do the n bytes at offset off of the window `l1` maps spell `name`?
fn l1_matches(l1: &mut PageTable, off: u64, n: u64, name: Str) -> bool
  requires pt_level(l1) == 1 && off + n <= USER_SIZE
  ensures pt_level(l1) == 1
{
  if n != slen(name) {
    return false;
  }
  let mut k = 0;
  let mut same = true;
  while same && k < n
    invariant k <= n && pt_level(l1) == 1
  {
    let a = off + k;
    let p = a / 4096;
    if pt_has(l1, p) {
      let m = chunk(a, n - k);
      let f = pt_take_frame(&mut l1, p);
      let mut j = 0;
      while same && j < m
        invariant j <= m
      {
        if frame_read8(f, a % 4096 + j) != sget(name, k + j) {
          same = false;
        } else {
          j = j + 1;
        }
      }
      pt_put_frame(&mut l1, p, f, true);
      k = k + m;
    } else {
      same = false;
    }
  }
  return same;
}

// ---------------------------------------------------------------- files

// Each of these returns NO_RESULT on failure. A transfer moves at most XFER
// bytes per call, through the kernel buffer k.fs.xfer.

fn smaller(a: u64, b: u64) -> u64
  ensures result <= a && result <= b
{
  if a < b {
    return a;
  }
  return b;
}

/// Copies the name at user address va (n bytes) into the transfer buffer.
fn name_in(k: &mut Kernel, pid: u64, va: u64, n: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result ==> n <= FNAME_MAX
{
  if n > FNAME_MAX {
    return false;
  }
  return copy_from_user(&mut k.spaces, pid, va, &mut k.fs.xfer, n) == n;
}

fn do_open(k: &mut Kernel, pid: u64, flags: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if !name_in(&mut k, pid, va, n) {
    return NO_RESULT;
  }
  return vfs_open(&mut k.fs, &mut k.mem, pid * NFD, flags, n);
}

fn do_fread(k: &mut Kernel, pid: u64, fd: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if fd >= NFD {
    return NO_RESULT;
  }
  let row = pid * NFD + fd;
  let got = vfs_read(&mut k.fs, row, smaller(n, XFER));
  if got == NO_FD {
    return NO_RESULT;
  }
  let put = copy_to_user(&mut k.spaces, pid, va, k.fs.xfer, got);
  if put == NO_RESULT {
    return NO_RESULT;
  }
  vfs_advance(&mut k.fs, row, vfs_offset(k.fs, row), put);
  return put;
}

fn do_fwrite(k: &mut Kernel, pid: u64, fd: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if fd >= NFD {
    return NO_RESULT;
  }
  let got = copy_from_user(&mut k.spaces, pid, va, &mut k.fs.xfer, smaller(n, XFER));
  if got == NO_RESULT {
    return NO_RESULT;
  }
  return vfs_write(&mut k.fs, &mut k.mem, pid * NFD + fd, got);
}

fn do_dirent(k: &mut Kernel, pid: u64, i: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let nl = vfs_dirent(&mut k.fs, i);
  if nl == NO_FILE {
    return NO_RESULT;
  }
  if copy_to_user(&mut k.spaces, pid, va, k.fs.xfer, smaller(nl, n)) == NO_RESULT {
    return NO_RESULT;
  }
  return nl;
}

/// The file system calls; NO_RESULT for a number that is not one.
fn file_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == SYS_OPEN {
    return do_open(&mut k, pid, a, b, c);
  }
  if n == SYS_CLOSE {
    if a < NFD && vfs_close(&mut k.fs, pid * NFD + a) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_FREAD {
    return do_fread(&mut k, pid, a, b, c);
  }
  if n == SYS_FWRITE {
    return do_fwrite(&mut k, pid, a, b, c);
  }
  if n == SYS_UNLINK {
    if name_in(&mut k, pid, b, c) && vfs_unlink(&mut k.fs, &mut k.mem, c) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_DIRENT {
    return do_dirent(&mut k, pid, a, b, c);
  }
  if n == SYS_SEEK {
    if a < NFD && vfs_seek(&mut k.fs, pid * NFD + a, b) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_STAT {
    if name_in(&mut k, pid, b, c) {
      return vfs_stat(&mut k.fs, c);
    }
    return NO_RESULT;
  }
  return NO_RESULT;
}

/// The network calls; NO_RESULT for a number that is not one.
fn net_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == SYS_PING {
    return nic_ping(&mut k.nic, a);
  }
  if n == SYS_SOCKET {
    return sock_new(&mut k.nic);
  }
  if n == SYS_BIND {
    if sock_bind(&mut k.nic, a, b) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_SENDTO {
    let got = copy_from_user(&mut k.spaces, pid, b, &mut k.fs.xfer, smaller(c, XFER));
    if got == NO_RESULT {
      return NO_RESULT;
    }
    return sock_sendto(&mut k.nic, a % 256, a / 16777216, a / 256 % 65536, k.fs.xfer, got);
  }
  if n == SYS_RECVFROM {
    let got = sock_recvfrom(&mut k.nic, a, &mut k.fs.xfer, smaller(c, XFER));
    if got == NO_SOCK || copy_to_user(&mut k.spaces, pid, b, k.fs.xfer, got) == NO_RESULT {
      return NO_RESULT;
    }
    return got;
  }
  if n == SYS_PEER {
    return sock_peer_ip(k.nic, a) * 65536 + sock_peer_port(k.nic, a);
  }
  if n == SYS_SCLOSE {
    if sock_close(&mut k.nic, a) {
      return 0;
    }
    return NO_RESULT;
  }
  return NO_RESULT;
}

// ---------------------------------------------------------------- dispatch

fn ret(procs: &mut Buf, pid: u64, v: u64)
  requires len(procs) == PTAB_LEN && pid < NPROC
  ensures len(procs) == PTAB_LEN
{
  pset(&mut procs, pid, F_REGS + R_RAX, v);
}

fn do_wait(procs: &mut Buf, pid: u64, c: u64) -> u64
  requires len(procs) == PTAB_LEN && 1 <= pid && pid < NPROC
  ensures len(procs) == PTAB_LEN
{
  if c == 0 || c >= NPROC || state(procs, c) == FREE || pget(procs, c, F_PARENT) != pid {
    ret(&mut procs, pid, NO_RESULT);
    return KEEP;
  }
  if state(procs, c) == ZOMBIE {
    ret(&mut procs, pid, pget(procs, c, F_CODE));
    pset(&mut procs, c, F_STATE, FREE);
    return KEEP;
  }
  pset(&mut procs, pid, F_WAIT, c);
  pset(&mut procs, pid, F_STATE, WAITING);
  return SWITCH;
}

/// Handles the system call process `pid` just made.
fn syscall(con: &mut Uart, k: &mut Kernel, mmu: &Mmu, pid: u64) -> u64
  requires uart_ok(con) && kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k)
{
  let n = pget(k.procs, pid, F_REGS + R_RAX);
  let a = pget(k.procs, pid, F_REGS + R_RDI);
  let b = pget(k.procs, pid, F_REGS + R_RSI);
  let c = pget(k.procs, pid, F_REGS + R_RDX);
  if n == SYS_EXIT {
    terminate(&mut k, mmu, pid, a);
    return SWITCH;
  }
  if n == SYS_WRITE {
    ret(&mut k.procs, pid, do_write(&mut con, &mut k.spaces, pid, a, b));
    return KEEP;
  }
  if n == SYS_READ {
    let ch = q_pop(&mut k.q);
    if ch < 256 {
      ret(&mut k.procs, pid, ch);
      return KEEP;
    }
    pset(&mut k.procs, pid, F_STATE, READING);
    return SWITCH;
  }
  if n == SYS_SPAWN {
    let prog = lookup(&mut k.spaces, pid, a, b);
    let mut child = 0;
    if prog < NPROGS {
      child = spawn(&mut k, prog, pid);
    }
    ret(&mut k.procs, pid, child);
    return KEEP;
  }
  if n == SYS_WAIT {
    return do_wait(&mut k.procs, pid, a);
  }
  if n == SYS_YIELD {
    return SWITCH;
  }
  if n == SYS_GETPID {
    ret(&mut k.procs, pid, pid);
    return KEEP;
  }
  if n == SYS_INFO {
    if a == 0 {
      ret(&mut k.procs, pid, count_free(k.mem.bm));
    } else if a == 1 {
      ret(&mut k.procs, pid, k.ticks);
    } else if a == 2 {
      ret(&mut k.procs, pid, k.cpus);
    } else if a == 3 {
      ret(&mut k.procs, pid, k.ns);
    } else {
      ret(&mut k.procs, pid, NO_RESULT);
    }
    return KEEP;
  }
  if n == SYS_PS {
    print_ps(&mut con, k.procs);
    return KEEP;
  }
  if n == SYS_KILL {
    if a == 0 || a >= NPROC || state(k.procs, a) == FREE || state(k.procs, a) == ZOMBIE || state(k.procs, a) == KILLED {
      ret(&mut k.procs, pid, 1);
      return KEEP;
    }
    ret(&mut k.procs, pid, 0);
    if state(k.procs, a) == RUNNING {
      // Running on another processor, which holds its address space: it
      // ends when it comes back (see `finish` in main.bastio).
      pset(&mut k.procs, a, F_STATE, KILLED);
      return KEEP;
    }
    terminate(&mut k, mmu, a, 137);
    if a == pid {
      return SWITCH;
    }
    return KEEP;
  }
  if n == SYS_POWEROFF {
    return POWEROFF;
  }
  if SYS_PING <= n && n <= SYS_SCLOSE {
    ret(&mut k.procs, pid, net_call(&mut k, pid, n, a, b, c));
    return KEEP;
  }
  ret(&mut k.procs, pid, file_call(&mut k, pid, n, a, b, c));
  return KEEP;
}
