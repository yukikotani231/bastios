// System calls. A user program raises `int 0x80` with the call number in
// rax and arguments in rdi, rsi, rdx; the result goes back in rax. The
// numbers are the ones in bastiolang's user prelude.

import "pages.bastio";
import "space.bastio";
import "proc.bastio";
import "fs.bastio";
import "usermem.bastio";

const SYS_EXIT: u64 = 0;
const SYS_WRITE: u64 = 1;
const SYS_READ: u64 = 2;
const SYS_SPAWN: u64 = 3;
const SYS_WAIT: u64 = 4;
const SYS_YIELD: u64 = 5;
const SYS_GETPID: u64 = 6;
const SYS_INFO: u64 = 7;
const SYS_PS: u64 = 8;
const SYS_KILL: u64 = 9;
const SYS_POWEROFF: u64 = 10;
// Files. User programs make these with sys_call / sys_send / sys_recv.
const SYS_OPEN: u64 = 11;             // (flags, name, name length) -> fd
const SYS_CLOSE: u64 = 12;            // (fd) -> 0
const SYS_FREAD: u64 = 13;            // (fd, buffer, length) -> bytes read
const SYS_FWRITE: u64 = 14;           // (fd, buffer, length) -> bytes written
const SYS_UNLINK: u64 = 15;           // (_, name, name length) -> 0
const SYS_DIRENT: u64 = 16;           // (entry, buffer, length) -> name length, 0 if unused
const SYS_SEEK: u64 = 17;             // (fd, offset) -> 0
// The network (src/net.bastio). Socket calls return NO_RESULT on failure.
const SYS_PING: u64 = 40;             // (address, 0: the gateway) -> 1 reply, 0 none, 2 no ARP answer, 3 no network card, 4 busy
const SYS_SOCKET: u64 = 41;           // () -> a UDP socket
const SYS_BIND: u64 = 42;             // (socket, port; 0: any) -> 0
const SYS_SENDTO: u64 = 43;           // (socket + 256 * port + 2^24 * address, buffer, length) -> length
const SYS_RECVFROM: u64 = 44;         // (socket, buffer, length) -> length; NO_RESULT if none waits
const SYS_PEER: u64 = 45;             // (socket) -> 65536 * address + port of the last sender
const SYS_SCLOSE: u64 = 46;           // (socket) -> 0
const SYS_TCP_LISTEN: u64 = 48;       // (port) -> a listener
const SYS_TCP_ACCEPT: u64 = 49;       // (listener) -> a connection; NO_RESULT if none is ready
const SYS_TCP_CONNECT: u64 = 50;      // (65536 * address + port) -> a connection (poll SYS_TCP_STATUS)
const SYS_TCP_SEND: u64 = 51;         // (connection, buffer, length) -> bytes taken (0: full, try again)
const SYS_TCP_RECV: u64 = 52;         // (connection, buffer, length) -> bytes; 0 at the end; TCP_AGAIN if none yet
const SYS_TCP_CLOSE: u64 = 53;        // (connection or listener) -> 0
const SYS_TCP_STATUS: u64 = 54;       // (connection) -> 0 connecting, 1 open, 2 closed or reset
const SYS_TCP_PEER: u64 = 55;         // (connection) -> 65536 * address + port
const SYS_NETINFO: u64 = 47;          // (what) -> 0 address, 1 gateway, 2 netmask, 3 how (0 not yet, 1 DHCP, 2 static)
const SYS_STAT: u64 = 18;             // (_, name, name length) -> size; DIR_BIT for a directory
const SYS_MKDIR: u64 = 19;            // (_, name, name length) -> 0
const SYS_RMDIR: u64 = 20;            // (_, name, name length) -> 0
const SYS_READDIR: u64 = 21;          // (256 * entry + name length, buffer, length) -> length (+ DIR_BIT)
const SYS_RENAME: u64 = 22;           // (old name length, buffer, length) -> 0: the buffer holds both names
const SYS_FTRUNCATE: u64 = 23;        // (fd, length) -> 0: zeros past the old end
const SYS_LINK: u64 = 24;             // (old name length, buffer, length) -> 0: a hard link, the buffer holding both names
const SYS_REBOOT: u64 = 25;           // () -> does not return: the machine restarts
const DIR_BIT: u64 = 4294967296;      // marks a directory in SYS_STAT and SYS_READDIR

// What the scheduler does after a system call.
const KEEP: u64 = 0;
const SWITCH: u64 = 1;
const POWEROFF: u64 = 2;
const REBOOT: u64 = 3;

// ---------------------------------------------------------------- user memory

/// Writes the n bytes at user address va to the console. Returns the count
/// written, which stops short at an unmapped page.
fn do_write(con: &mut Con, spaces: &mut Vec[Space], pid: u64, va: u64, n: u64) -> u64
  requires con_ok(con) && spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces) && con_ok(con)
{
  if !user_range(va, n) {
    return NO_RESULT;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NO_RESULT; },
    Space::Mapped(mut root) => {
      let k = write_from(&mut con, &mut root, off, n);
      put_space(&mut spaces, pid, Space::Mapped(root));
      return k;
    },
  }
}

/// Writes the n bytes at offset off of the user window to the console,
/// stopping short at an unmapped page or when the console's ring is full.
/// Returns the count written.
fn write_from(con: &mut Con, root: &mut PageTable, off: u64, n0: u64) -> u64
  requires con_ok(con) && pt_level(root) == 4 && off + n0 <= USER_SIZE
  ensures con_ok(con) && pt_level(root) == 4
{
  let mut n = n0;
  let room = con_room(con);
  if room < n {
    n = room;
  }
  if !pt_has(root, 1) {
    return 0;
  }
  return pt_borrow(&mut root, 1, write_l3, &mut con, off, n);
}

/// write_from below the top-level table, in place.
fn write_l3(l3: &mut PageTable, con: &mut Con, off: u64, n: u64) -> u64
  requires con_ok(con) && pt_level(l3) == 3 && off + n <= USER_SIZE
  ensures con_ok(con)
{
  if !pt_has(l3, 0) {
    return 0;
  }
  return pt_borrow(&mut l3, 0, write_l2, &mut con, off, n);
}

fn write_l2(l2: &mut PageTable, con: &mut Con, off: u64, n: u64) -> u64
  requires con_ok(con) && pt_level(l2) == 2 && off + n <= USER_SIZE
  ensures con_ok(con)
{
  let mut k = 0;
  let mut ok = true;
  while ok && k < n
    invariant k <= n && pt_level(l2) == 2 && con_ok(con)
  {
    let ch = w_byte(&mut l2, off + k);
    if ch == 256 {
      ok = false;
    } else {
      con_write(&mut con, cast[u8](ch));
      k = k + 1;
    }
  }
  return k;
}

/// The program whose name is the n bytes at user address va, or NPROGS.
fn lookup(spaces: &mut Vec[Space], pid: u64, va: u64, n: u64) -> u64
  requires spaces_ok(spaces) && pid < NPROC
  ensures spaces_ok(spaces)
  ensures result <= NPROGS
{
  if !user_range(va, n) {
    return NPROGS;
  }
  let off = va - USER_BASE;
  match take_space(&mut spaces, pid) {
    Space::Empty => { return NPROGS; },
    Space::Mapped(mut root) => {
      let found = find_prog(&mut root, off, n);
      put_space(&mut spaces, pid, Space::Mapped(root));
      return found;
    },
  }
}

/// The program whose name is the n bytes at offset off of the user
/// window, or NPROGS.
fn find_prog(root: &mut PageTable, off: u64, n: u64) -> u64
  requires pt_level(root) == 4 && off + n <= USER_SIZE
  ensures pt_level(root) == 4
  ensures result <= NPROGS
{
  if !pt_has(root, 1) {
    return NPROGS;
  }
  return pt_borrow(&mut root, 1, find_l3, off, n);
}

/// find_prog below the top-level table, in place.
fn find_l3(l3: &mut PageTable, off: u64, n: u64) -> u64
  requires pt_level(l3) == 3 && off + n <= USER_SIZE
  ensures result <= NPROGS
{
  if !pt_has(l3, 0) {
    return NPROGS;
  }
  return pt_borrow(&mut l3, 0, find_l2, off, n);
}

fn find_l2(l2: &mut PageTable, off: u64, n: u64) -> u64
  requires pt_level(l2) == 2 && off + n <= USER_SIZE
  ensures result <= NPROGS
{
  let mut found = NPROGS;
  let mut i = 0;
  while i < NPROGS
    invariant i <= NPROGS && found <= NPROGS && pt_level(l2) == 2
  {
    if found == NPROGS && w_matches(&mut l2, off, n, prog_name(i)) {
      found = i;
    }
    i = i + 1;
  }
  return found;
}

/// Do the n bytes at offset off of the window `l2` maps spell `name`?
fn w_matches(l2: &mut PageTable, off: u64, n: u64, name: Str) -> bool
  requires pt_level(l2) == 2 && off + n <= USER_SIZE
  ensures pt_level(l2) == 2
{
  if n != slen(name) {
    return false;
  }
  let mut k = 0;
  while k < n
    invariant k <= n && pt_level(l2) == 2
  {
    if w_byte(&mut l2, off + k) != cast[u64](sget(name, k)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// ---------------------------------------------------------------- files

// Each of these returns NO_RESULT on failure. A transfer moves at most XFER
// bytes per call, through the kernel buffer k.fs.xfer.

fn smaller(a: u64, b: u64) -> u64
  ensures result <= a && result <= b
{
  if a < b {
    return a;
  }
  return b;
}

/// Copies the name at user address va (n bytes) into the transfer buffer.
fn name_in(k: &mut Kernel, pid: u64, va: u64, n: u64) -> bool
  requires kok(k) && pid < NPROC
  ensures kok(k)
  ensures result ==> n <= FNAME_MAX
{
  if n > FNAME_MAX {
    return false;
  }
  return copy_from_user(&mut k.spaces, pid, va, &mut k.fs.xfer, n) == n;
}

fn do_open(k: &mut Kernel, pid: u64, flags: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if !name_in(&mut k, pid, va, n) {
    return NO_RESULT;
  }
  return vfs_open(&mut k.fs, &mut k.mem, pid * NFD, flags, n);
}

fn do_fread(k: &mut Kernel, pid: u64, fd: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if fd >= NFD {
    return NO_RESULT;
  }
  let row = pid * NFD + fd;
  let got = vfs_read(&mut k.fs, row, smaller(n, XFER));
  if got == NO_FD {
    return NO_RESULT;
  }
  if got == VFS_MISS {
    return DISK_RETRY;
  }
  let put = copy_to_user(&mut k.spaces, pid, va, k.fs.xfer, got);
  if put == NO_RESULT {
    return NO_RESULT;
  }
  vfs_advance(&mut k.fs, row, vfs_offset(k.fs, row), put);
  return put;
}

fn do_fwrite(k: &mut Kernel, pid: u64, fd: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if fd >= NFD {
    return NO_RESULT;
  }
  let got = copy_from_user(&mut k.spaces, pid, va, &mut k.fs.xfer, smaller(n, XFER));
  if got == NO_RESULT {
    return NO_RESULT;
  }
  let w = vfs_write(&mut k.fs, &mut k.mem, pid * NFD + fd, got);
  if w == VFS_MISS {
    return DISK_RETRY;
  }
  return w;
}

// ---------------------------------------------------------------- waiting for the disk

const RETRY_BIT: u64 = 0x4000000000000000;   // in F_WAIT: restart once the queue has moved

/// Moves the disk's queue along and wakes the processes waiting for it:
/// one whose call restarts (F_WAIT is RETRY_BIT + the queue's `moved` when
/// it slept) once anything finished, one whose write was queued (F_WAIT is
/// its transaction) once that transaction has ended. All of them if the
/// disk died. True if it woke any.
fn disk_wake(k: &mut Kernel) -> bool
  requires kok(k)
  ensures kok(k)
{
  let mut woke = false;
  disk_pump(&mut k.fs.disk, k.ticks);
  let moved = k.fs.disk.q.moved;
  let done = k.fs.disk.q.done;
  let dead = k.fs.disk.q.dead;
  let good = k.fs.disk.q.good;
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && kok(k)
  {
    if state(k.procs, p) == DISKWAIT {
      let w = pget(k.procs, p, F_WAIT);
      if dead || (w >= RETRY_BIT && w - RETRY_BIT != moved) || (w < RETRY_BIT && done >= w) {
        if dead && w < RETRY_BIT && w > good {
          // Its write never reached the disk: it fails after all.
          pset(&mut k.procs, p, F_REGS + R_RAX, pget(k.procs, p, F_CODE));
        }
        pset(&mut k.procs, p, F_STATE, READY);
        woke = true;
      }
    }
    p = p + 1;
  }
  return woke;
}

/// Process pid's Linux call n on a network socket has nothing to do yet:
/// no data, no connection, or no room to send. It sleeps until a frame
/// comes in or the clock ticks, then its call restarts (as lx_retry
/// does). Before, it was restarted on every pass of the scheduler, so a
/// process blocked in accept kept a processor busy.
fn sock_retry(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r = lx_retry(&mut k, pid, n);
  if r == SWITCH {
    nap(&mut k, pid, true);
  }
  return r;
}

/// Puts process pid, whose call is to run again, to sleep in SOCKWAIT:
/// until the clock ticks or a signal is posted (sock_wake, post_sig), or,
/// with `frames`, a frame comes in. F_WAIT holds the frame count to wait
/// past, or NO_RESULT for none.
fn nap(k: &mut Kernel, pid: u64, frames: bool)
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  pset(&mut k.procs, pid, F_STATE, SOCKWAIT);
  pset(&mut k.procs, pid, F_CODE, k.ticks);
  pset(&mut k.procs, pid, F_WAIT, NO_RESULT);
  if frames {
    // A frame nic_listen finds changes the count, so the sock_wake after
    // this call wakes it straight away.
    pset(&mut k.procs, pid, F_WAIT, nic_rx(k.nic));
    nic_listen(&mut k.nic);
  }
}

/// Wakes the processes in SOCKWAIT once a frame has come in or the clock
/// has ticked since they went to sleep. True if it woke any. With none
/// left asleep, the card stops interrupting (nic_quiet).
fn sock_wake(k: &mut Kernel) -> bool
  requires kok(k)
  ensures kok(k)
{
  // Without a card nothing moves but the clock: every call looks.
  if !nic_moved(&mut k.nic, k.ticks) && nic_up(k.nic) {
    return false;
  }
  let rx = nic_rx(k.nic);
  let mut woke = false;
  let mut left = false;
  let mut p = 1;
  while p < NPROC
    invariant 1 <= p && p <= NPROC && kok(k)
  {
    if state(k.procs, p) == SOCKWAIT {
      let w = pget(k.procs, p, F_WAIT);
      if (w != NO_RESULT && w != rx) || pget(k.procs, p, F_CODE) != k.ticks {
        pset(&mut k.procs, p, F_STATE, READY);
        woke = true;
      } else if w != NO_RESULT {
        left = true;                        // still waiting on a frame
      }
    }
    p = p + 1;
  }
  if !left {
    nic_quiet(&mut k.nic);
  }
  return woke;
}

/// Is a disk command queued or running on a disk that raises no
/// interrupt when it ends, so that it has to be polled?
fn disk_polled(k: &Kernel) -> bool
  requires kok(k)
{
  return !dq_idle(k.fs.disk.q) && !blk_irq(k.fs.disk.dev);
}

/// Process pid's system call n needs blocks that are not cached: their
/// reads are queued. It sleeps until the queue has moved, then its call
/// restarts (as lx_retry does).
fn disk_retry(k: &mut Kernel, pid: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let r = lx_retry(&mut k, pid, n);
  if r == SWITCH {
    pset(&mut k.procs, pid, F_STATE, DISKWAIT);
    pset(&mut k.procs, pid, F_WAIT, RETRY_BIT + k.fs.disk.q.moved % RETRY_BIT);
    disk_wake(&mut k);
  }
  return r;
}

/// After process p's system call: if it queued a write, it sleeps until
/// that transaction ends (its result is already in rax). Should the disk
/// die first, rax becomes `fail` (kept meanwhile in F_CODE, unused until
/// the process exits). True if it sleeps.
fn disk_hold(k: &mut Kernel, p: u64, fail: u64) -> bool
  requires kok(k) && p < NPROC
  ensures kok(k)
{
  let t = k.fs.disk.txn;
  if t == 0 {
    return false;
  }
  k.fs.disk.txn = 0;
  if state(k.procs, p) != READY || t >= RETRY_BIT {
    disk_wake(&mut k);
    return false;
  }
  pset(&mut k.procs, p, F_STATE, DISKWAIT);
  pset(&mut k.procs, p, F_WAIT, t);
  pset(&mut k.procs, p, F_CODE, fail);
  disk_wake(&mut k);
  return state(k.procs, p) == DISKWAIT;
}

fn do_dirent(k: &mut Kernel, pid: u64, i: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  let nl = vfs_dirent(&mut k.fs, i);
  if nl == NO_FILE {
    return NO_RESULT;
  }
  if copy_to_user(&mut k.spaces, pid, va, k.fs.xfer, smaller(nl, n)) == NO_RESULT {
    return NO_RESULT;
  }
  return nl;
}

/// Entry i of the directory whose name (nl bytes) the user buffer at va
/// starts with: its name replaces the start of the buffer (n bytes long).
/// Returns the name's length, plus DIR_BIT if it is a directory; 0 for an
/// entry not in the directory; NO_RESULT past the last entry or for a name
/// that is not a directory.
fn do_readdir(k: &mut Kernel, pid: u64, i: u64, nl: u64, va: u64, n: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if nl > n || !name_in(&mut k, pid, va, nl) {
    return NO_RESULT;
  }
  let d = vfs_dir_lookup(&mut k.fs, nl);
  if d == NO_FILE {
    return NO_RESULT;
  }
  let r = vfs_readdir(&mut k.fs, d, i);
  if r == NO_FILE {
    return NO_RESULT;
  }
  if r == 0 {
    return 0;
  }
  if copy_to_user(&mut k.spaces, pid, va, k.fs.xfer, smaller(r, n)) == NO_RESULT {
    return NO_RESULT;
  }
  if vfs_is_dir(&mut k.fs, vfs_child(d, i)) {
    return r + DIR_BIT;
  }
  return r;
}

/// The file system calls; NO_RESULT for a number that is not one.
fn file_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == SYS_OPEN {
    return do_open(&mut k, pid, a, b, c);
  }
  if n == SYS_CLOSE {
    if a < NFD && vfs_close(&mut k.fs, &mut k.mem, pid * NFD + a) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_FREAD {
    return do_fread(&mut k, pid, a, b, c);
  }
  if n == SYS_FWRITE {
    return do_fwrite(&mut k, pid, a, b, c);
  }
  if n == SYS_UNLINK {
    if name_in(&mut k, pid, b, c) && vfs_unlink(&mut k.fs, &mut k.mem, c) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_DIRENT {
    return do_dirent(&mut k, pid, a, b, c);
  }
  if n == SYS_SEEK {
    if a < NFD && vfs_seek(&mut k.fs, pid * NFD + a, b) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_STAT {
    if name_in(&mut k, pid, b, c) {
      let f = vfs_lookup(&mut k.fs, c);
      if f != NO_FILE && vfs_is_dir(&mut k.fs, f) {
        return DIR_BIT;
      }
      return vfs_size(&mut k.fs, f);
    }
    return NO_RESULT;
  }
  if n == SYS_MKDIR {
    if name_in(&mut k, pid, b, c) && vfs_mkdir(&mut k.fs, c) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_RMDIR {
    if name_in(&mut k, pid, b, c) && vfs_rmdir(&mut k.fs, &mut k.mem, c) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_READDIR {
    return do_readdir(&mut k, pid, a / 256, a % 256, b, c);
  }
  if n == SYS_RENAME {
    if a <= c && c <= XFER && copy_from_user(&mut k.spaces, pid, b, &mut k.fs.xfer, c) == c
      && vfs_rename(&mut k.fs, a, c - a) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_LINK {
    if a <= c && c <= XFER && copy_from_user(&mut k.spaces, pid, b, &mut k.fs.xfer, c) == c
      && vfs_link(&mut k.fs, a, c - a) == LINKED {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_FTRUNCATE {
    if a < NFD && vfs_truncate(&mut k.fs, &mut k.mem, pid * NFD + a, b) {
      return 0;
    }
    return NO_RESULT;
  }
  return NO_RESULT;
}

/// The network calls; NO_RESULT for a number that is not one.
fn net_call(k: &mut Kernel, pid: u64, n: u64, a: u64, b: u64, c: u64) -> u64
  requires kok(k) && pid < NPROC
  ensures kok(k)
{
  if n == SYS_SOCKET {
    return sock_new(&mut k.nic, 0);
  }
  if n == SYS_BIND {
    if sock_bind(&mut k.nic, a, b) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_SENDTO {
    let got = copy_from_user(&mut k.spaces, pid, b, &mut k.fs.xfer, smaller(c, XFER));
    if got == NO_RESULT {
      return NO_RESULT;
    }
    return sock_sendto(&mut k.nic, a % 256, a / 16777216, a / 256 % 65536, k.fs.xfer, got);
  }
  if n == SYS_RECVFROM {
    let got = sock_recvfrom(&mut k.nic, a, &mut k.fs.xfer, smaller(c, XFER));
    if got == NO_SOCK || copy_to_user(&mut k.spaces, pid, b, k.fs.xfer, got) == NO_RESULT {
      return NO_RESULT;
    }
    return got;
  }
  if n == SYS_PEER {
    return sock_peer_ip(k.nic, a) * 65536 + sock_peer_port(k.nic, a);
  }
  if n == SYS_SCLOSE {
    if sock_close(&mut k.nic, a) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_TCP_LISTEN {
    if a == 0 {
      return NO_SOCK;                 // a listener nobody could find
    }
    return tcp_listen(&mut k.nic, 0, a);
  }
  if n == SYS_TCP_ACCEPT {
    return tcp_accept(&mut k.nic, a);
  }
  if n == SYS_TCP_CONNECT {
    return tcp_connect(&mut k.nic, 0, a / 65536, a % 65536);
  }
  if n == SYS_TCP_SEND {
    let got = copy_from_user(&mut k.spaces, pid, b, &mut k.fs.xfer, smaller(c, XFER));
    if got == NO_RESULT {
      return NO_RESULT;
    }
    return tcp_send(&mut k.nic, a, k.fs.xfer, got);
  }
  if n == SYS_TCP_RECV {
    let got = tcp_recv(&mut k.nic, a, &mut k.fs.xfer, smaller(c, XFER), false);
    if got == NO_SOCK || got == TCP_AGAIN {
      return got;
    }
    if copy_to_user(&mut k.spaces, pid, b, k.fs.xfer, got) == NO_RESULT {
      return NO_RESULT;
    }
    return got;
  }
  if n == SYS_TCP_CLOSE {
    if tcp_close(&mut k.nic, a) {
      return 0;
    }
    return NO_RESULT;
  }
  if n == SYS_TCP_STATUS {
    return tcp_status(k.nic, a);
  }
  if n == SYS_TCP_PEER {
    return tcp_peer_ip(k.nic, a) * 65536 + tcp_peer_port(k.nic, a);
  }
  return NO_RESULT;
}

/// Writes /etc/resolv.conf naming name server ns (a.b.c.d), which the C
/// library's resolver reads; nothing is written for no server (0). A file
/// a program wrote there is replaced when a lease names a new server.
fn write_resolv(k: &mut Kernel, ns: u64)
  requires kok(k)
  ensures kok(k)
{
  if ns == 0 || ns > 4294967295 {
    return;
  }
  let mut b = balloc(32);
  let head = "nameserver ";
  let mut o = 0;
  while o < slen(head)
    invariant o <= slen(head) && slen(head) == 11 && blen(b) == 32
  {
    bset(&mut b, o, sget(head, o));
    o = o + 1;
  }
  let mut i = 0;
  while i < 4
    invariant i <= 4 && o <= 11 + 4 * i && blen(b) == 32
  {
    let part = ns / pow256(3 - i) % 256;
    if part >= 100 {
      bset(&mut b, o, cast[u8](48 + part / 100));
      o = o + 1;
    }
    if part >= 10 {
      bset(&mut b, o, cast[u8](48 + part / 10 % 10));
      o = o + 1;
    }
    bset(&mut b, o, cast[u8](48 + part % 10));
    o = o + 1;
    if i < 3 {
      bset(&mut b, o, 46);              // .
    } else {
      bset(&mut b, o, 10);              // newline
    }
    o = o + 1;
    i = i + 1;
  }
  vfs_install_bytes(&mut k.fs, &mut k.mem, "etc/resolv.conf", b, o);
  bfree(b);
}

/// Runs the network's timers (DHCP retries) and wakes the process whose
/// ping has finished, if one has, with its result. Called on every
/// scheduler pass, after the card is polled.
fn net_wake(k: &mut Kernel)
  requires kok(k)
  ensures kok(k)
{
  nic_tick(&mut k.nic, k.ticks);
  if nic_dns_take(&mut k.nic) {
    write_resolv(&mut k, nic_info(k.nic, 4));
  }
  let w = nic_ping_check(&mut k.nic, k.ticks);
  if w == NET_NONE {
    return;
  }
  let p = w / 8;
  // A process killed while it waited is gone; its slot may hold another.
  if 1 <= p && p < NPROC && state(k.procs, p) == NETWAIT {
    ret(&mut k.procs, p, w % 8);
    pset(&mut k.procs, p, F_STATE, READY);
  }
}

// ---------------------------------------------------------------- dispatch

fn ret(procs: &mut Buf, pid: u64, v: u64)
  requires len(procs) == PTAB_LEN && pid < NPROC
  ensures len(procs) == PTAB_LEN
{
  pset(&mut procs, pid, F_REGS + R_RAX, v);
}

fn do_wait(procs: &mut Buf, pid: u64, c: u64) -> u64
  requires len(procs) == PTAB_LEN && 1 <= pid && pid < NPROC
  ensures len(procs) == PTAB_LEN
{
  if c == 0 || c >= NPROC || state(procs, c) == FREE || pget(procs, c, F_PARENT) != pid {
    ret(&mut procs, pid, NO_RESULT);
    return KEEP;
  }
  if state(procs, c) == ZOMBIE {
    ret(&mut procs, pid, shown_code(pget(procs, c, F_CODE)));
    pset(&mut procs, c, F_STATE, FREE);
    return KEEP;
  }
  pset(&mut procs, pid, F_WAIT, c);
  pset(&mut procs, pid, F_STATE, WAITING);
  return SWITCH;
}

/// Whether process pid may make native call n. The native ABI predates
/// users: its file, network, power and reboot calls check no permissions,
/// so they are root's (effective user 0) alone. Everyone may write to and
/// read from the console, start and wait for its own children (which keep
/// its ids, see spawn), yield, ask for its pid, the counters of SYS_INFO
/// and the process list, and kill a process it may signal (may_signal,
/// src/lxsig.bastio). Any program can raise int 0x80, a Linux one too, so
/// this is what keeps an unprivileged Linux process from going around the
/// Linux layer's checks.
fn native_allowed(procs: &Buf, pid: u64, n: u64) -> bool
  requires len(procs) == PTAB_LEN && pid < NPROC
  ensures !is_root(procs, pid) && n > SYS_KILL ==> !result
{
  return cred_root(procs, pid) || n <= SYS_KILL;
}

/// Handles the system call process `pid` just made.
fn syscall(con: &mut Con, k: &mut Kernel, mmu: &Mmu, pid: u64) -> u64
  requires con_ok(con) && kok(k) && 1 <= pid && pid < NPROC && mmu_root(mmu) == KERNEL_ROOT
  ensures kok(k) && con_ok(con)
{
  let n = pget(k.procs, pid, F_REGS + R_RAX);
  let a = pget(k.procs, pid, F_REGS + R_RDI);
  let b = pget(k.procs, pid, F_REGS + R_RSI);
  let c = pget(k.procs, pid, F_REGS + R_RDX);
  if n == SYS_EXIT {
    terminate(&mut k, mmu, pid, a);
    return SWITCH;
  }
  if !native_allowed(k.procs, pid, n) {
    ret(&mut k.procs, pid, NO_RESULT);      // root's: see native_allowed
    return KEEP;
  }
  if n == SYS_WRITE {
    let room = con_room(con);
    if b > room && room < OUTCAP {
      // The console's ring is too full: wait for the scheduler to pump
      // some of it out, then retry, rather than drop bytes.
      return con_block(&mut k, pid, SYS_WRITE);
    }
    ret(&mut k.procs, pid, do_write(&mut con, &mut k.spaces, pid, a, b));
    return KEEP;
  }
  if n == SYS_READ {
    let ch = q_pop(&mut k.q);
    if ch < 256 {
      ret(&mut k.procs, pid, ch);
      return KEEP;
    }
    pset(&mut k.procs, pid, F_STATE, READING);
    return SWITCH;
  }
  if n == SYS_SPAWN {
    let prog = lookup(&mut k.spaces, pid, a, b);
    let mut child = 0;
    if prog < NPROGS {
      child = spawn(&mut k, prog, pid);
    }
    ret(&mut k.procs, pid, child);
    return KEEP;
  }
  if n == SYS_WAIT {
    return do_wait(&mut k.procs, pid, a);
  }
  if n == SYS_YIELD {
    return SWITCH;
  }
  if n == SYS_GETPID {
    ret(&mut k.procs, pid, pid);
    return KEEP;
  }
  if n == SYS_INFO {
    if a == 0 {
      ret(&mut k.procs, pid, count_avail(k.mem.bm));   // cached program pages count: they are reclaimable
    } else if a == 1 {
      ret(&mut k.procs, pid, k.ticks);
    } else if a == 2 {
      ret(&mut k.procs, pid, k.cpus);
    } else if a == 3 {
      ret(&mut k.procs, pid, k.ns);
    } else {
      ret(&mut k.procs, pid, NO_RESULT);
    }
    return KEEP;
  }
  if n == SYS_PS {
    print_ps(&mut con, k.procs);
    return KEEP;
  }
  if n == SYS_KILL {
    if a == 0 || a >= NPROC || state(k.procs, a) == FREE || state(k.procs, a) == ZOMBIE || state(k.procs, a) == KILLED || !may_signal(k, pid, a, 9) {   // 9: SIGKILL
      ret(&mut k.procs, pid, 1);
      return KEEP;
    }
    ret(&mut k.procs, pid, 0);
    if state(k.procs, a) == RUNNING || state(k.procs, a) == EXITING {
      // Running on another processor, which holds its address space: it
      // ends when it comes back (see `finish` in main.bastio).
      pset(&mut k.procs, a, F_STATE, KILLED);
      return KEEP;
    }
    terminate(&mut k, mmu, a, 137);
    if a == pid {
      return SWITCH;
    }
    return KEEP;
  }
  if n == SYS_POWEROFF {
    return POWEROFF;
  }
  if n == SYS_REBOOT {
    return REBOOT;
  }
  if n == SYS_PING {
    // The reply is collected by net_wake; the process waits off the lock.
    let r = nic_ping_start(&mut k.nic, a, pid, k.ticks);
    if r != NET_PENDING {
      ret(&mut k.procs, pid, r);
      return KEEP;
    }
    pset(&mut k.procs, pid, F_STATE, NETWAIT);
    return SWITCH;
  }
  if n == SYS_NETINFO {
    ret(&mut k.procs, pid, nic_info(k.nic, a));
    return KEEP;
  }
  if (SYS_SOCKET <= n && n <= SYS_SCLOSE) || (SYS_TCP_LISTEN <= n && n <= SYS_TCP_PEER) {
    ret(&mut k.procs, pid, net_call(&mut k, pid, n, a, b, c));
    return KEEP;
  }
  let r = file_call(&mut k, pid, n, a, b, c);
  if r == DISK_RETRY {
    return disk_retry(&mut k, pid, n);
  }
  ret(&mut k.procs, pid, r);
  return KEEP;
}
