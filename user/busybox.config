# BusyBox options turned on over `make allnoconfig` (see the Makefile).
# A small shell, ash, with its built-in echo, test and printf and
# arithmetic, and a few applets the kernel shows as /bin/NAME (applet_name
# in src/lxproc.bastio).
CONFIG_ASH
CONFIG_SH_IS_ASH
CONFIG_ASH_ECHO
CONFIG_ASH_TEST
CONFIG_ASH_PRINTF
CONFIG_ASH_INTERNAL_GLOB
CONFIG_FEATURE_SH_MATH
CONFIG_FEATURE_SH_MATH_64
CONFIG_LS
CONFIG_CAT
CONFIG_WC
CONFIG_HEAD
CONFIG_RM
CONFIG_CP
CONFIG_KILL
CONFIG_SLEEP
CONFIG_MKDIR
CONFIG_RMDIR
CONFIG_MV
CONFIG_PWD
CONFIG_CHMOD
CONFIG_CHOWN
CONFIG_TOUCH
CONFIG_FEATURE_TOUCH_SUSV3
CONFIG_STAT
CONFIG_FEATURE_STAT_FORMAT
CONFIG_FEATURE_STAT_FILESYSTEM
CONFIG_LN
CONFIG_READLINK
CONFIG_MKFIFO
CONFIG_MOUNT
CONFIG_FEATURE_MOUNT_FLAGS
CONFIG_UMOUNT
# Namespaces (src/lxns.bastio, src/lxnsk.bastio).
CONFIG_UNSHARE
CONFIG_PIVOT_ROOT
CONFIG_CHROOT
CONFIG_HOSTNAME
CONFIG_NSENTER
CONFIG_TRUNCATE
CONFIG_POWEROFF
CONFIG_REBOOT
# Users: su and passwd are set-user-ID root (bin_suid in
# src/lxproc.bastio), and FEATURE_SUID makes BusyBox drop root at once for
# every other applet. Passwords are hashed by BusyBox's own crypt
# (SHA-512) and kept in /etc/shadow.
CONFIG_FEATURE_SUID
CONFIG_SU
CONFIG_FEATURE_SU_SYSLOG
CONFIG_PASSWD
CONFIG_LOGIN
CONFIG_ID
CONFIG_WHOAMI
CONFIG_ADDUSER
CONFIG_ADDGROUP
CONFIG_DELUSER
CONFIG_DELGROUP
CONFIG_CHPASSWD
CONFIG_FEATURE_SHADOWPASSWDS
CONFIG_USE_BB_PWD_GRP
CONFIG_USE_BB_SHADOW
CONFIG_USE_BB_CRYPT
CONFIG_USE_BB_CRYPT_SHA
