// The BastiOS shell, a user program. It runs in ring 3 in its own address
// space and talks to the kernel only through system calls: it reads and
// writes the console, starts programs and waits for them, lists and stops
// processes, and powers the machine off.
//
// Everything here is checked by the Bastio prover before it is compiled:
// every buffer index is in bounds, every byte written fits in a byte, every
// number parsed from input is checked for overflow, and the line buffer is
// freed exactly once.

import "lib/file.bastio";
import "core/print.bastio";

// ---------------------------------------------------------------- output

// Line buffers hold the line length in slot 0 and the bytes in 1..=length.
// Every slot from 1 up holds a byte; the prover carries that fact around.

fn put_range(con: &Serial, line: &Buf, from: u64, to: u64)
  requires from >= 1
  requires to < len(line)
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let mut i = from;
  while i <= to
    invariant from <= i
  {
    serial_write(con, cast[u8](get(line, i)));
    i = i + 1;
  }
}

// ---------------------------------------------------------------- input

fn read_line(con: &Serial, mut line: Buf) -> Buf
  requires len(line) >= 2
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
  ensures len(result) == len(line)
  ensures get(result, 0) <= len(result)
  ensures forall j: u64 :: 1 <= j && j < len(result) ==> get(result, j) <= 255
{
  let mut n = 0;
  let mut done = false;
  let mut eof = false;
  while !done
    invariant n + 1 <= len(line)
    invariant forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
  {
    let c = serial_read(con);
    if c == 13 || c == 10 {
      print_str(con, "\r\n");
      done = true;
    } else if c == 4 {
      // Ctrl-D on an empty line ends the session.
      if n == 0 {
        eof = true;
        done = true;
      }
    } else if c == 127 || c == 8 {
      if n > 0 {
        n = n - 1;
        serial_write(con, 8);
        serial_write(con, 32);
        serial_write(con, 8);
      }
    } else if c >= 32 && n + 2 <= len(line) {
      line = set(line, n + 1, c);
      n = n + 1;
      serial_write(con, c);
    }
  }
  if eof {
    line = set(line, 0, len(line));
  } else {
    line = set(line, 0, n);
  }
  return line;
}

// ---------------------------------------------------------------- parsing

// Is the line `w`, or `w` followed by a space?
fn is_cmd(line: &Buf, n: u64, w: Str) -> bool
  requires n < len(line)
  ensures result ==> slen(w) <= n
{
  if slen(w) > n {
    return false;
  }
  if slen(w) < n {
    if get(line, slen(w) + 1) != 32 {
      return false;
    }
  }
  let mut k = 0;
  while k < slen(w)
    invariant k <= slen(w)
  {
    if get(line, k + 1) != cast[u64](sget(w, k)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn skip_spaces(line: &Buf, n: u64, i: u64) -> u64
  requires n < len(line)
  requires i <= n + 1
  ensures i <= result && result <= n + 1
{
  let mut j = i;
  while j <= n && get(line, j) == 32
    invariant i <= j && j <= n + 1
  {
    j = j + 1;
  }
  return j;
}

fn digits_end(line: &Buf, n: u64, i: u64) -> u64
  requires n < len(line)
  requires i <= n + 1
  ensures i <= result && result <= n + 1
{
  let mut j = i;
  while j <= n && get(line, j) >= 48 && get(line, j) <= 57
    invariant i <= j && j <= n + 1
  {
    j = j + 1;
  }
  return j;
}

// Parses the decimal digits in [from, to). Numbers above 10^18 are refused
// (the result is then u64::MAX) instead of silently wrapping: the prover
// rejects `v * 10 + d` until the size check below is in place.
fn parse_num(line: &Buf, from: u64, to: u64) -> u64
  requires from <= to
  requires to <= len(line)
  ensures result <= 1000000000000000000 || result == 18446744073709551615
{
  let mut v = 0;
  let mut i = from;
  while i < to
    invariant from <= i && i <= to
    invariant v <= 1000000000000000000
  {
    let c = get(line, i);
    if c < 48 || c > 57 {
      return 18446744073709551615;
    }
    if v > 99999999999999999 {
      return 18446744073709551615;
    }
    v = v * 10 + (c - 48);
    i = i + 1;
  }
  return v;
}

// ---------------------------------------------------------------- files

/// The first n bytes of b, with each newline written as CR LF.
fn put_bytes(con: &Serial, b: &Bytes, n: u64)
  requires n <= blen(b)
{
  let mut i = 0;
  while i < n
    invariant i <= n
  {
    let c = bget(b, i);
    if c == 10 {
      serial_write(con, 13);
    }
    serial_write(con, c);
    i = i + 1;
  }
}

/// Bytes from..to (not including to) of the line, as a byte buffer.
fn line_bytes(line: &Buf, from: u64, to: u64) -> Bytes
  requires 1 <= from && from <= to && to <= len(line)
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
  ensures blen(result) == to - from
{
  let mut b = balloc(to - from);
  let mut i = 0;
  while i < to - from
    invariant i <= to - from && blen(b) == to - from
  {
    bset(&mut b, i, cast[u8](get(line, from + i)));
    i = i + 1;
  }
  return b;
}

/// The argument of a one-argument command: from the first non-space after
/// the command word `w` to the end of the line. Returns 0 if there is none.
fn arg_start(line: &Buf, n: u64, w: u64) -> u64
  requires n < len(line) && w <= n
  ensures result == 0 || (1 <= result && result <= n)
{
  let a = skip_spaces(line, n, w + 1);
  if a > n || a == 0 {
    return 0;
  }
  return a;
}

/// `ls`: every file and directory, with its size and whole name
/// (directories end in "/"). `ls DIR`: just what is in DIR ("/" is the
/// top), by last name.
fn cmd_ls(con: &Serial, line: &Buf, n: u64)
  requires n < len(line) && n >= 2
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let a = arg_start(line, n, 2);
  if a != 0 {
    ls_dir(con, line, a, n);
    return;
  }
  let mut name = balloc(256);
  let mut i = 0;
  let mut more = true;
  while more && i < 32768
    invariant blen(name) == 256
  {
    let r = f_dirent(i, &mut name);
    if r == NOT_OK {
      more = false;
    } else if r > 0 && r <= 256 {
      let size = f_stat(name, r);
      if size == DIR_BIT {
        print_str(con, "         ");
        put_bytes(con, name, r);
        print_str(con, "/\r\n");
      } else {
        print_u64_pad(con, size, 8);
        print_str(con, " ");
        put_bytes(con, name, r);
        print_str(con, "\r\n");
      }
    }
    i = i + 1;
  }
  bfree(name);
}

/// `ls DIR`: the directory named by line[a..n + 1].
fn ls_dir(con: &Serial, line: &Buf, a: u64, n: u64)
  requires n < len(line) && 1 <= a && a <= n
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let dir = line_bytes(line, a, n + 1);
  let mut dl = blen(dir);
  if dl == 1 && bget(dir, 0) == 47 {
    dl = 0;                             // "/": the top
  }
  if dl > 255 {
    print_str(con, "not a directory\r\n");
    bfree(dir);
    return;
  }
  let mut buf = balloc(256);
  let mut i = 0;
  let mut more = true;
  while more && i < 32768
    invariant blen(buf) == 256 && dl <= 255 && dl <= blen(dir)
  {
    let mut j = 0;
    while j < dl
      invariant j <= dl && blen(buf) == 256 && dl <= 255 && dl <= blen(dir)
    {
      bset(&mut buf, j, bget(dir, j));
      j = j + 1;
    }
    let r = f_readdir(i, dl, &mut buf);
    if r == NOT_OK {
      if i == 0 {
        print_str(con, "not a directory: ");
        put_bytes(con, dir, blen(dir));
        print_str(con, "\r\n");
      }
      more = false;
    } else if r > 0 {
      let m = r % DIR_BIT;
      if m <= 256 {
        put_bytes(con, buf, m);
        if r >= DIR_BIT {
          print_str(con, "/");
        }
        print_str(con, "\r\n");
      }
    }
    i = i + 1;
  }
  bfree(buf);
  bfree(dir);
}

/// `mkdir DIR` (make = true) or `rmdir DIR`.
fn cmd_dir(con: &Serial, line: &Buf, n: u64, make: bool)
  requires n < len(line) && n >= 5
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let a = arg_start(line, n, 5);
  if a == 0 {
    print_str(con, "usage: mkdir DIR, rmdir DIR\r\n");
    return;
  }
  let name = line_bytes(line, a, n + 1);
  if make {
    if f_mkdir(name, blen(name)) == NOT_OK {
      print_str(con, "cannot make ");
      put_bytes(con, name, blen(name));
      print_str(con, ": it exists, or its parent does not\r\n");
    }
  } else if f_rmdir(name, blen(name)) == NOT_OK {
    print_str(con, "cannot remove ");
    put_bytes(con, name, blen(name));
    print_str(con, ": not an empty directory\r\n");
  }
  bfree(name);
}

/// `mv OLD NEW`: rename a file or directory.
fn cmd_mv(con: &Serial, line: &Buf, n: u64)
  requires n < len(line) && n >= 2
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let a = arg_start(line, n, 2);
  if a == 0 {
    print_str(con, "usage: mv OLD NEW\r\n");
    return;
  }
  let args = line_bytes(line, a, n + 1);
  let l = blen(args);
  let mut sp = 0;
  while sp < l && bget(args, sp) != 32
    invariant sp <= l
  {
    sp = sp + 1;
  }
  let mut t = sp;
  while t < l && bget(args, t) == 32
    invariant sp <= t && t <= l
  {
    t = t + 1;
  }
  if sp == 0 || t >= l {
    print_str(con, "usage: mv OLD NEW\r\n");
    bfree(args);
    return;
  }
  let mut names = balloc(sp + (l - t));
  let mut j = 0;
  while j < sp
    invariant j <= sp && sp <= l && blen(names) == sp + (l - t)
  {
    bset(&mut names, j, bget(args, j));
    j = j + 1;
  }
  j = 0;
  while j < l - t
    invariant j <= l - t && t <= l && blen(names) == sp + (l - t)
  {
    bset(&mut names, sp + j, bget(args, t + j));
    j = j + 1;
  }
  if f_rename(names, sp, l - t) == NOT_OK {
    print_str(con, "cannot move ");
    put_bytes(con, names, sp);
    print_str(con, "\r\n");
  }
  bfree(names);
  bfree(args);
}

fn cmd_cat(con: &Serial, line: &Buf, n: u64)
  requires n < len(line) && n >= 3
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let a = arg_start(line, n, 3);
  if a == 0 {
    print_str(con, "usage: cat FILE\r\n");
    return;
  }
  let name = line_bytes(line, a, n + 1);
  let fd = f_open(name, blen(name), O_READ);
  if fd == NOT_OK {
    print_str(con, "no such file: ");
    put_bytes(con, name, blen(name));
    print_str(con, "\r\n");
    bfree(name);
    return;
  }
  bfree(name);
  let mut buf = balloc(256);
  let mut more = true;
  while more
    invariant blen(buf) == 256
  {
    let r = f_read(fd, &mut buf);
    if r == 0 || r > 256 {
      more = false;
    } else {
      put_bytes(con, buf, r);
    }
  }
  bfree(buf);
  f_close(fd);
}

fn cmd_rm(con: &Serial, line: &Buf, n: u64)
  requires n < len(line) && n >= 2
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let a = arg_start(line, n, 2);
  if a == 0 {
    print_str(con, "usage: rm FILE\r\n");
    return;
  }
  let name = line_bytes(line, a, n + 1);
  if f_unlink(name, blen(name)) == NOT_OK {
    print_str(con, "cannot remove ");
    put_bytes(con, name, blen(name));
    print_str(con, ": no such file, or it is open\r\n");
  }
  bfree(name);
}

/// `echo TEXT > FILE` (replace) or `echo TEXT >> FILE` (append): `g` is the
/// position of the first `>`.
fn echo_to(con: &Serial, line: &Buf, n: u64, g: u64)
  requires n < len(line) && 6 <= g && g <= n
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let mut flags = O_WRITE + O_CREATE + O_TRUNC;
  let mut op = g + 1;
  if op <= n && get(line, op) == 62 {
    flags = O_WRITE + O_CREATE + O_APPEND;
    op = op + 1;
  }
  let a = skip_spaces(line, n, op);
  if a > n {
    print_str(con, "usage: echo TEXT > FILE\r\n");
    return;
  }
  // The text ends before the spaces in front of `>`.
  let mut e = g;
  while e > 6 && get(line, e - 1) == 32
    invariant 6 <= e && e <= g
  {
    e = e - 1;
  }
  let name = line_bytes(line, a, n + 1);
  let fd = f_open(name, blen(name), flags);
  bfree(name);
  if fd == NOT_OK {
    print_str(con, "cannot open the file\r\n");
    return;
  }
  let mut text = balloc(e - 6 + 1);
  let mut i = 0;
  while i < e - 6
    invariant i <= e - 6 && blen(text) == e - 6 + 1
  {
    bset(&mut text, i, cast[u8](get(line, 6 + i)));
    i = i + 1;
  }
  bset(&mut text, e - 6, 10);
  if f_write(fd, text, blen(text)) != blen(text) {
    print_str(con, "write failed\r\n");
  }
  bfree(text);
  f_close(fd);
}

/// The position of the first `>` in 6..=n, or 0.
fn find_gt(line: &Buf, n: u64) -> u64
  requires n < len(line)
  ensures result == 0 || (6 <= result && result <= n)
{
  let mut i = 6;
  while i <= n
    invariant 6 <= i
  {
    if get(line, i) == 62 {
      return i;
    }
    i = i + 1;
  }
  return 0;
}

// ---------------------------------------------------------------- commands

fn cmd_help(con: &Serial) {
  print_str(con, "commands:\r\n");
  print_str(con, "  help             this list\r\n");
  print_str(con, "  echo TEXT        print TEXT\r\n");
  print_str(con, "  echo TEXT > FILE write TEXT to FILE (`>>`: append)\r\n");
  print_str(con, "  ls [DIR]         list files with their sizes (or what is in DIR)\r\n");
  print_str(con, "  mkdir DIR        make a directory (rmdir: remove an empty one)\r\n");
  print_str(con, "  cat FILE         print FILE\r\n");
  print_str(con, "  rm FILE          remove FILE\r\n");
  print_str(con, "  mv OLD NEW       rename a file or directory\r\n");
  print_str(con, "  add A B          add two numbers (overflow is checked)\r\n");
  print_str(con, "  mul A B          multiply two numbers (overflow is checked)\r\n");
  print_str(con, "  ps               list processes\r\n");
  print_str(con, "  mem              free physical pages\r\n");
  print_str(con, "  uptime           timer ticks since boot (100 a second)\r\n");
  print_str(con, "  cpus             processors running\r\n");
  print_str(con, "  clock            nanoseconds since boot (time-stamp counter)\r\n");
  print_str(con, "  kill PID         stop a process\r\n");
  print_str(con, "  ping [A.B.C.D]   ICMP echo (default: the gateway)\r\n");
  print_str(con, "  ifconfig         the network address (from DHCP)\r\n");
  print_str(con, "  tcpecho PORT     accept a TCP connection, echo it until closed\r\n");
  print_str(con, "  tcpget A.B.C.D PORT TEXT  connect, send TEXT, print the reply\r\n");
  print_str(con, "  udpecho PORT [N] wait for N UDP datagrams, send each back\r\n");
  print_str(con, "  udpsend A.B.C.D PORT TEXT  send TEXT as a UDP datagram\r\n");
  print_str(con, "  NAME [&]         run a program and wait for it (`&`: don't wait)\r\n");
  print_str(con, "  about            what this is\r\n");
  print_str(con, "  halt             power off\r\n");
  print_str(con, "  reboot           restart the machine\r\n");
  print_str(con, "programs: hello, spin, fault, straddle, true, bench, fstest, sh\r\n");
}

fn cmd_about(con: &Serial) {
  print_str(con, "BastiOS 0.2: a kernel written in Bastio.\r\n");
  print_str(con, "This shell is a user program. Every memory access, byte write and\r\n");
  print_str(con, "arithmetic step in it, and in the kernel under it, was proved safe\r\n");
  print_str(con, "at compile time; the binaries have no runtime checks.\r\n");
}

// `add A B` / `mul A B`. `op` is 0 for add, 1 for mul.
fn cmd_arith(con: &Serial, line: &Buf, n: u64, op: u64)
  requires n < len(line)
  requires n >= 3
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let a0 = skip_spaces(line, n, 4);
  let a1 = digits_end(line, n, a0);
  let b0 = skip_spaces(line, n, a1);
  let b1 = digits_end(line, n, b0);
  if a0 == a1 || b0 == b1 || b1 != n + 1 || a1 == b0 {
    print_str(con, "usage: add A B / mul A B\r\n");
    return;
  }
  let a = parse_num(line, a0, a1);
  let b = parse_num(line, b0, b1);
  if a == 18446744073709551615 || b == 18446744073709551615 {
    print_str(con, "number too large (limit 10^18)\r\n");
    return;
  }
  if op == 0 {
    print_u64(con, a + b);
    print_str(con, "\r\n");
    return;
  }
  // a * b can overflow; the prover insists on this check.
  if b != 0 && a > 18446744073709551615 / b {
    print_str(con, "overflow: the product does not fit in 64 bits\r\n");
    return;
  }
  print_u64(con, a * b);
  print_str(con, "\r\n");
}

fn cmd_kill(con: &Serial, line: &Buf, n: u64)
  requires n < len(line)
  requires n >= 4
{
  let a0 = skip_spaces(line, n, 5);
  let a1 = digits_end(line, n, a0);
  if a0 == a1 || a1 != n + 1 {
    print_str(con, "usage: kill PID\r\n");
    return;
  }
  let pid = parse_num(line, a0, a1);
  if sys_kill(pid) != 0 {
    print_str(con, "no such process\r\n");
    return;
  }
  // Collect it if it was ours, so it does not linger as a zombie.
  sys_wait(pid);
}

// `ping [A.B.C.D]`: one ICMP echo through the kernel's network stack (the
// gateway, 10.0.2.2, if no address is given).
const NOT_IP: u64 = 18446744073709551615;
const IP_END: u64 = 4294967296;
const SYS_REBOOT: u64 = 25;
const SYS_PING: u64 = 40;
const SYS_SOCKET: u64 = 41;
const SYS_BIND: u64 = 42;
const SYS_SENDTO: u64 = 43;
const SYS_RECVFROM: u64 = 44;
const SYS_PEER: u64 = 45;
const SYS_SCLOSE: u64 = 46;
const SYS_NETINFO: u64 = 47;
const SYS_TCP_LISTEN: u64 = 48;
const SYS_TCP_ACCEPT: u64 = 49;
const SYS_TCP_CONNECT: u64 = 50;
const SYS_TCP_SEND: u64 = 51;
const SYS_TCP_RECV: u64 = 52;
const SYS_TCP_CLOSE: u64 = 53;
const SYS_TCP_STATUS: u64 = 54;
const SYS_TCP_PEER: u64 = 55;
const TCP_AGAIN: u64 = 18446744073709551614;
const UDP_WAIT: u64 = 1500;          // udpecho gives up after 15 s of ticks

// Parses an address A.B.C.D starting at line[i]. Returns the address plus
// IP_END times the index just past it, or NOT_IP if there is none there.
fn parse_ip(line: &Buf, n: u64, start: u64) -> u64
  requires n < len(line) && start <= n + 1
  ensures result == NOT_IP || (result % IP_END <= 4294967295 && result / IP_END <= n + 1)
{
  let mut i = start;
  let mut ip = 0;
  let mut part = 0;
  while part < 4
    invariant part <= 4 && i <= n + 1 && ip <= 4294967295
    invariant part < 4 ==> ip <= 16777215
    invariant part < 3 ==> ip <= 65535
    invariant part < 2 ==> ip <= 255
    invariant part == 0 ==> ip == 0
  {
    let e = digits_end(line, n, i);
    if e == i || e > i + 3 {
      return NOT_IP;
    }
    let v = parse_num(line, i, e);
    if v > 255 {
      return NOT_IP;
    }
    ip = ip * 256 + v;
    part = part + 1;
    i = e;
    if part < 4 {
      if i > n || get(line, i) != 46 {
        return NOT_IP;
      }
      i = i + 1;
    }
  }
  if i >= 65536 {
    return NOT_IP;                    // longer than any line
  }
  return i * IP_END + ip;
}

fn put_ip(con: &Serial, ip: u64) {
  print_u64(con, ip / 16777216 % 256);
  print_str(con, ".");
  print_u64(con, ip / 65536 % 256);
  print_str(con, ".");
  print_u64(con, ip / 256 % 256);
  print_str(con, ".");
  print_u64(con, ip % 256);
}

fn cmd_ping(con: &Serial, line: &Buf, n: u64)
  requires n < len(line)
  requires n >= 4
{
  let mut ip = sys_call(SYS_NETINFO, 1, 0);   // the gateway
  let i = skip_spaces(line, n, 5);
  if i <= n {
    let r = parse_ip(line, n, i);
    if r == NOT_IP || r / IP_END != n + 1 {
      print_str(con, "usage: ping [A.B.C.D]\r\n");
      return;
    }
    ip = r % IP_END;
  }
  let r = sys_call(SYS_PING, ip, 0);
  if r == 1 {
    print_str(con, "reply from ");
  } else if r == 2 {
    print_str(con, "no answer to ARP for ");
  } else if r == 3 {
    print_str(con, "no network\r\n");
    return;
  } else if r == 4 {
    print_str(con, "another ping is in flight\r\n");
    return;
  } else {
    print_str(con, "no reply from ");
  }
  put_ip(con, ip);
  print_str(con, "\r\n");
}

// ifconfig: the address, netmask and gateway, and where they came from.
fn cmd_ifconfig(con: &Serial) {
  let how = sys_call(SYS_NETINFO, 3, 0);
  if how == 0 {
    print_str(con, "no address\r\n");
    return;
  }
  put_ip(con, sys_call(SYS_NETINFO, 0, 0));
  print_str(con, " netmask ");
  put_ip(con, sys_call(SYS_NETINFO, 2, 0));
  print_str(con, " gateway ");
  put_ip(con, sys_call(SYS_NETINFO, 1, 0));
  if how == 1 {
    print_str(con, " (DHCP)\r\n");
  } else {
    print_str(con, " (static)\r\n");
  }
}

// The first n bytes of b, with anything unprintable shown as a dot.
fn put_text(con: &Serial, b: &Bytes, n: u64)
  requires n <= blen(b)
{
  let mut i = 0;
  while i < n
    invariant i <= n
  {
    let c = bget(b, i);
    if c < 32 || c > 126 {
      serial_write(con, 46);
    } else {
      serial_write(con, c);
    }
    i = i + 1;
  }
}

// Waits (yielding) for ticks timer ticks.
fn sleep_ticks(ticks: u64) {
  let t0 = sys_info(1);
  let mut waiting = true;
  while waiting {
    let now = sys_info(1);
    if now < t0 || now - t0 >= ticks {
      waiting = false;
    } else {
      sys_yield();
    }
  }
}

// Waits up to UDP_WAIT ticks for a datagram on socket s, prints it and
// sends it back to its sender. False if none came.
fn echo_one(con: &Serial, s: u64, buf: &mut Bytes) -> bool
  ensures blen(buf) == old(blen(buf))
{
  let t0 = sys_info(1);
  let bl = blen(buf);
  let mut got = NOT_OK;
  let mut waiting = true;
  while waiting
    invariant blen(buf) == bl
  {
    got = sys_recv(SYS_RECVFROM, s, &mut buf);
    if got != NOT_OK {
      waiting = false;
    } else {
      let now = sys_info(1);
      if now >= t0 && now - t0 > UDP_WAIT {
        waiting = false;
      }
      sys_yield();
    }
  }
  if got == NOT_OK || got > blen(buf) {
    return false;
  }
  let peer = sys_call(SYS_PEER, s, 0);
  print_str(con, "from ");
  put_ip(con, peer / 65536);
  print_str(con, ":");
  print_u64(con, peer % 65536);
  print_str(con, ": ");
  put_text(con, buf, got);
  print_str(con, "\r\n");
  // Back to the sender, from the bound port.
  if peer / 65536 <= 4294967295 && s < 256 {
    let to = s + 256 * (peer % 65536) + 16777216 * (peer / 65536);
    if sys_send(SYS_SENDTO, to, buf, got) == got {
      print_str(con, "sent it back\r\n");
    }
  }
  return true;
}

// udpecho PORT [N]: waits for N datagrams (default 1) on a UDP port,
// printing each and sending it back. With N > 1 it first sleeps a second,
// so that datagrams sent meanwhile queue up on the socket.
fn cmd_udpecho(con: &Serial, line: &Buf, n: u64)
  requires n < len(line) && n >= 7
{
  let i = skip_spaces(line, n, 8);
  let e = digits_end(line, n, i);
  let port = parse_num(line, i, e);
  let j = skip_spaces(line, n, e);
  let f = digits_end(line, n, j);
  let mut count = 1;
  if f > j {
    count = parse_num(line, j, f);
  }
  if e == i || f != n + 1 || (f == j && j != e) || port == 0 || port > 65535 || count == 0 || count > 9 {
    print_str(con, "usage: udpecho PORT [N]\r\n");
    return;
  }
  let s = sys_call(SYS_SOCKET, 0, 0);
  if s == NOT_OK {
    print_str(con, "no network\r\n");
    return;
  }
  if sys_call(SYS_BIND, s, port) != 0 {
    print_str(con, "port in use\r\n");
    sys_call(SYS_SCLOSE, s, 0);
    return;
  }
  print_str(con, "listening on udp port ");
  print_u64(con, port);
  print_str(con, "\r\n");
  if count > 1 {
    sleep_ticks(100);
  }
  let mut buf = balloc(1472);
  let mut k = 0;
  while k < count {
    if echo_one(con, s, &mut buf) {
      k = k + 1;
    } else {
      print_str(con, "nothing arrived\r\n");
      k = count;
    }
  }
  bfree(buf);
  sys_call(SYS_SCLOSE, s, 0);
}

// Sends bytes 0..k of buf on TCP connection t, waiting while the send
// buffer is full. False if the connection fails or stalls for UDP_WAIT ticks.
fn tcp_send_all(t: u64, buf: &mut Bytes, k: u64) -> bool
  requires k <= blen(buf)
  ensures blen(buf) == old(blen(buf))
{
  let bl = blen(buf);
  let mut left = k;
  let mut t0 = sys_info(1);
  while left > 0
    invariant left <= k && blen(buf) == bl
  {
    let r = sys_send(SYS_TCP_SEND, t, buf, left);
    if r == NOT_OK || r > left {
      return false;
    }
    if r == 0 {
      let now = sys_info(1);
      if now >= t0 && now - t0 > UDP_WAIT {
        return false;
      }
      sys_yield();
    } else {
      // Move what is left to the front.
      let mut i = 0;
      while i + r < left
        invariant i + r <= left && blen(buf) == bl
      {
        bset(&mut buf, i, bget(buf, i + r));
        i = i + 1;
      }
      left = left - r;
      t0 = sys_info(1);
    }
  }
  return true;
}

// tcpecho PORT: accepts one TCP connection on PORT and sends back
// everything it receives until the other side closes.
fn cmd_tcpecho(con: &Serial, line: &Buf, n: u64)
  requires n < len(line) && n >= 7
{
  let i = skip_spaces(line, n, 8);
  let e = digits_end(line, n, i);
  let port = parse_num(line, i, e);
  if e == i || e != n + 1 || port == 0 || port > 65535 {
    print_str(con, "usage: tcpecho PORT\r\n");
    return;
  }
  let lis = sys_call(SYS_TCP_LISTEN, port, 0);
  if lis == NOT_OK {
    print_str(con, "cannot listen\r\n");
    return;
  }
  print_str(con, "listening on tcp port ");
  print_u64(con, port);
  print_str(con, "\r\n");
  let mut t = NOT_OK;
  let t0 = sys_info(1);
  let mut waiting = true;
  while waiting {
    t = sys_call(SYS_TCP_ACCEPT, lis, 0);
    let now = sys_info(1);
    if t != NOT_OK || now < t0 || now - t0 > UDP_WAIT {
      waiting = false;
    } else {
      sys_yield();
    }
  }
  sys_call(SYS_TCP_CLOSE, lis, 0);
  if t == NOT_OK {
    print_str(con, "nobody connected\r\n");
    return;
  }
  let peer = sys_call(SYS_TCP_PEER, t, 0);
  print_str(con, "connection from ");
  put_ip(con, peer / 65536);
  print_str(con, ":");
  print_u64(con, peer % 65536);
  print_str(con, "\r\n");
  let mut buf = balloc(2048);
  let mut total = 0;
  let mut going = true;
  let mut idle = sys_info(1);
  while going {
    let r = sys_recv(SYS_TCP_RECV, t, &mut buf);
    if r == TCP_AGAIN {
      let now = sys_info(1);
      if now >= idle && now - idle > UDP_WAIT {
        print_str(con, "timed out\r\n");
        going = false;
      } else {
        sys_yield();
      }
    } else if r == 0 {
      going = false;                  // the other side closed
    } else if r > blen(buf) {
      print_str(con, "connection reset\r\n");
      going = false;
    } else {
      if !tcp_send_all(t, &mut buf, r) {
        print_str(con, "send failed\r\n");
        going = false;
      }
      if total < 1000000000 {
        total = total + r;
      }
      idle = sys_info(1);
    }
  }
  bfree(buf);
  sys_call(SYS_TCP_CLOSE, t, 0);
  print_str(con, "echoed ");
  print_u64(con, total);
  print_str(con, " bytes\r\n");
}

// tcpget A.B.C.D PORT TEXT: connects, sends TEXT and a newline, and prints
// what comes back until the other side closes.
fn cmd_tcpget(con: &Serial, line: &Buf, n: u64)
  requires n < len(line) && n >= 6
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let i = skip_spaces(line, n, 7);
  let r = parse_ip(line, n, i);
  if r == NOT_IP || r / IP_END > n {
    print_str(con, "usage: tcpget A.B.C.D PORT TEXT\r\n");
    return;
  }
  let ip = r % IP_END;
  let a = skip_spaces(line, n, r / IP_END);
  let e = digits_end(line, n, a);
  let port = parse_num(line, a, e);
  let x = skip_spaces(line, n, e);
  if a == r / IP_END || e == a || port == 0 || port > 65535 || x > n || x == e {
    print_str(con, "usage: tcpget A.B.C.D PORT TEXT\r\n");
    return;
  }
  let t = sys_call(SYS_TCP_CONNECT, ip * 65536 + port, 0);
  if t == NOT_OK {
    print_str(con, "no network\r\n");
    return;
  }
  let t0 = sys_info(1);
  let mut st = 0;
  while st == 0 {
    st = sys_call(SYS_TCP_STATUS, t, 0);
    let now = sys_info(1);
    if st == 0 && (now < t0 || now - t0 > UDP_WAIT) {
      st = 2;
    } else if st == 0 {
      sys_yield();
    }
  }
  if st != 1 {
    print_str(con, "connection refused\r\n");
    sys_call(SYS_TCP_CLOSE, t, 0);
    return;
  }
  print_str(con, "connected\r\n");
  let mut text = balloc(n + 2 - x);
  let mut j = 0;
  while j < n + 1 - x
    invariant j <= n + 1 - x && blen(text) == n + 2 - x
  {
    bset(&mut text, j, cast[u8](get(line, x + j)));
    j = j + 1;
  }
  bset(&mut text, n + 1 - x, 10);
  let tl = blen(text);
  if !tcp_send_all(t, &mut text, tl) {
    print_str(con, "send failed\r\n");
  }
  bfree(text);
  let mut buf = balloc(1024);
  let mut going = true;
  let mut idle = sys_info(1);
  while going {
    let got = sys_recv(SYS_TCP_RECV, t, &mut buf);
    if got == TCP_AGAIN {
      let now = sys_info(1);
      if now >= idle && now - idle > UDP_WAIT {
        print_str(con, "timed out\r\n");
        going = false;
      } else {
        sys_yield();
      }
    } else if got == 0 {
      going = false;
    } else if got > blen(buf) {
      print_str(con, "connection reset\r\n");
      going = false;
    } else {
      put_bytes(con, buf, got);
      idle = sys_info(1);
    }
  }
  bfree(buf);
  sys_call(SYS_TCP_CLOSE, t, 0);
  print_str(con, "closed\r\n");
}

// udpsend A.B.C.D PORT TEXT: sends TEXT as one datagram, from an
// ephemeral port.
fn cmd_udpsend(con: &Serial, line: &Buf, n: u64)
  requires n < len(line) && n >= 7
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  let i = skip_spaces(line, n, 8);
  let r = parse_ip(line, n, i);
  if r == NOT_IP || r / IP_END > n {
    print_str(con, "usage: udpsend A.B.C.D PORT TEXT\r\n");
    return;
  }
  let ip = r % IP_END;
  let a = skip_spaces(line, n, r / IP_END);
  let e = digits_end(line, n, a);
  let port = parse_num(line, a, e);
  let t = skip_spaces(line, n, e);
  if a == r / IP_END || e == a || port == 0 || port > 65535 || t > n || t == e {
    print_str(con, "usage: udpsend A.B.C.D PORT TEXT\r\n");
    return;
  }
  let s = sys_call(SYS_SOCKET, 0, 0);
  if s == NOT_OK || s >= 256 {
    print_str(con, "no network\r\n");
    return;
  }
  let text = line_bytes(line, t, n + 1);
  let sent = sys_send(SYS_SENDTO, s + 256 * port + 16777216 * ip, text, blen(text));
  if sent == blen(text) {
    print_str(con, "sent ");
    print_u64(con, sent);
    print_str(con, " bytes to ");
    put_ip(con, ip);
    print_str(con, ":");
    print_u64(con, port);
    print_str(con, "\r\n");
  } else {
    print_str(con, "could not send\r\n");
  }
  bfree(text);
  sys_call(SYS_SCLOSE, s, 0);
}

// Runs the program named by the line, or reports that there is none.
fn cmd_run(con: &Serial, line: &Buf, n: u64)
  requires n < len(line)
  requires n >= 1
  requires forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
{
  // The name ends at the first space; a final `&` means "don't wait".
  let mut e = 1;
  while e <= n && get(line, e) != 32
    invariant 1 <= e && e <= n + 1
  {
    e = e + 1;
  }
  let bg = get(line, n) == 38 && n > 1;
  let pid = sys_spawn(line, 1, e);
  if pid == 0 {
    print_str(con, "unknown command: ");
    put_range(con, line, 1, n);
    print_str(con, "\r\n");
    return;
  }
  if bg {
    print_str(con, "[");
    print_u64(con, pid);
    print_str(con, "]\r\n");
    return;
  }
  let code = sys_wait(pid);
  if code != 0 {
    print_str(con, "[exit ");
    print_u64(con, code);
    print_str(con, "]\r\n");
  }
}

// ---------------------------------------------------------------- main

fn main(con: &mut Serial) -> u64 {
  print_str(con, "\r\nBastiOS 0.2 -- type `help`\r\n");
  let mut line = alloc(128);
  let mut running = true;
  let mut code = 0;
  while running
    invariant len(line) == 128
    invariant forall j: u64 :: 1 <= j && j < len(line) ==> get(line, j) <= 255
  {
    print_str(con, "bastios> ");
    line = read_line(con, line);
    let n = get(line, 0);
    if n == len(line) {
      print_str(con, "\r\nbye\r\n");
      running = false;
    } else if is_cmd(line, n, "help") {
      cmd_help(con);
    } else if is_cmd(line, n, "about") {
      cmd_about(con);
    } else if is_cmd(line, n, "echo") {
      let g = find_gt(line, n);
      if g != 0 {
        echo_to(con, line, n, g);
      } else {
        if n >= 6 {
          put_range(con, line, 6, n);
        }
        print_str(con, "\r\n");
      }
    } else if is_cmd(line, n, "ls") {
      cmd_ls(con, line, n);
    } else if is_cmd(line, n, "mkdir") {
      cmd_dir(con, line, n, true);
    } else if is_cmd(line, n, "rmdir") {
      cmd_dir(con, line, n, false);
    } else if is_cmd(line, n, "mv") {
      cmd_mv(con, line, n);
    } else if is_cmd(line, n, "cat") {
      cmd_cat(con, line, n);
    } else if is_cmd(line, n, "rm") {
      cmd_rm(con, line, n);
    } else if is_cmd(line, n, "add") {
      cmd_arith(con, line, n, 0);
    } else if is_cmd(line, n, "mul") {
      cmd_arith(con, line, n, 1);
    } else if is_cmd(line, n, "ps") {
      sys_ps();
    } else if is_cmd(line, n, "mem") {
      print_u64(con, sys_info(0));
      print_str(con, " free pages\r\n");
    } else if is_cmd(line, n, "uptime") {
      let t = sys_info(1);
      print_u64(con, t);
      print_str(con, " ticks, ");
      print_u64(con, t / 100);
      print_str(con, " s\r\n");
    } else if is_cmd(line, n, "clock") {
      print_u64(con, sys_info(3));
      print_str(con, " ns since boot\r\n");
    } else if is_cmd(line, n, "cpus") {
      print_str(con, "processors running: ");
      print_u64(con, sys_info(2));
      print_str(con, "\r\n");
    } else if is_cmd(line, n, "kill") {
      cmd_kill(con, line, n);
    } else if is_cmd(line, n, "ping") {
      cmd_ping(con, line, n);
    } else if is_cmd(line, n, "tcpecho") {
      cmd_tcpecho(con, line, n);
    } else if is_cmd(line, n, "tcpget") {
      cmd_tcpget(con, line, n);
    } else if is_cmd(line, n, "ifconfig") {
      cmd_ifconfig(con);
    } else if is_cmd(line, n, "udpecho") {
      cmd_udpecho(con, line, n);
    } else if is_cmd(line, n, "udpsend") {
      cmd_udpsend(con, line, n);
    } else if is_cmd(line, n, "exit") {
      running = false;
    } else if is_cmd(line, n, "halt") {
      print_str(con, "bye\r\n");
      sys_poweroff();
      running = false;
    } else if is_cmd(line, n, "reboot") {
      print_str(con, "restarting\r\n");
      sys_call(SYS_REBOOT, 0, 0);
      running = false;
    } else if n > 0 {
      cmd_run(con, line, n);
    }
  }
  free(line);
  return code;
}
