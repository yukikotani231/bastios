// A workload for the power-cut test (test/shell_test.sh). It first checks
// what an earlier run, possibly cut off at any point, left on the disk:
//
//   disk/log   records of REC bytes, record i being "r", i in 14 decimal
//              digits, "\n": the size is a whole number of records and
//              every record is the right one, in order;
//   disk/snap  empty, or SNAP bytes all equal to one digit;
//   disk/t     absent, or empty;
//   disk/ow    absent, empty, OW_A bytes "x" (cut while it was made), or
//              OW bytes: "x" except bytes OW_AT..OW_AT + OW_N, which are
//              all "x" or all one digit. Those are rewritten in place by
//              single write calls that cross a block boundary, so a mix
//              of two digits would be a torn write;
//   disk/tr    absent, empty, or TR_SMALL bytes "a" possibly followed by
//              zeros up to TR_BIG: it is cut to TR_SMALL and grown back to
//              TR_BIG by ftruncate, so the bytes past TR_SMALL must read
//              as zeros every time;
//   disk/ra,rb one of them, never both (once made): renamed back and
//              forth, holding PAY bytes "R" (or nothing, cut while made);
//   disk/la,lb one or both, never neither (once made): linked and
//              unlinked in turn, each name holding PAY bytes "L" (or
//              nothing, cut while made). Removing the name a file was made
//              under while the other remains is the case diskfs commits
//              with one sector write (disk_take_name).
//   disk/mK/f  (K a digit) a directory and a file in it, made together (step_dir):
//              fsck must find no file whose directory is missing.
//   disk/g/    files 000, 001, ... up to some count and none past it, each
//              holding its own three digits (the last may be empty, cut
//              while made). Three more each 16 records, up to GMAX, so
//              runs keep growing the directory past its first 64 entries
//              (dir_grow) while the power is cut.
//
// It prints "crashme: clean, N records" (or what was wrong, and exits
// with 1), then appends PER_RUN more records. Every 16 records it rewrites
// disk/snap (truncate, then SNAP bytes over several sectors) and creates
// and removes disk/t; between, it overwrites the middle of disk/ow,
// truncates disk/tr, renames disk/ra or disk/rb and links or unlinks
// disk/la or disk/lb. It
// prints "crashme: N" every 64 records and
// "crashme: done N" at the end.

import "lib/file.bastio";
import "core/print.bastio";

const REC: u64 = 16;
const SNAP: u64 = 2000;
const PER_RUN: u64 = 1024;
const MAX_RECS: u64 = 65536;           // 1 MiB of records
const OW: u64 = 6000;
const OW_A: u64 = 4096;                 // the first of the two writes making it
const OW_AT: u64 = 1000;
const OW_N: u64 = 4000;
const TR_SMALL: u64 = 3000;
const TR_BIG: u64 = 9000;              // three blocks: the shrink drops two and zeroes a tail
const PAY: u64 = 100;
const GMAX: u64 = 600;                 // the most files in disk/g

/// Byte j (0 to REC - 1) of record i.
fn rec_byte(i: u64, j: u64) -> u8
  requires j < REC
{
  if j == 0 {
    return 114;                         // 'r'
  }
  if j == REC - 1 {
    return 10;
  }
  let mut p = 1;
  let mut k = j;
  while k < REC - 2
    invariant k <= REC - 2 && p >= 1 && p <= 10000000000000
  {
    if p <= 1000000000000 {
      p = p * 10;
    }
    k = k + 1;
  }
  return cast[u8](48 + i / p % 10);
}

/// Checks disk/log. Returns its record count, or NOT_OK.
fn check_log(log: &Bytes, buf: &mut Bytes) -> u64
  requires blen(log) >= 8 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let size = f_stat(log, 8);
  if size == NOT_OK {
    return 0;
  }
  if size % REC != 0 || size > MAX_RECS * REC {
    return NOT_OK;
  }
  let fd = f_open(log, 8, O_READ);
  if fd == NOT_OK {
    return NOT_OK;
  }
  let mut at = 0;
  let mut ok = true;
  while ok && at < size
    invariant blen(buf) == 4096 && at <= size && size <= MAX_RECS * REC
  {
    let r = f_read(fd, &mut buf);
    if r == 0 || r > 4096 || r > size - at {
      ok = false;
    } else {
      let mut j = 0;
      while ok && j < r
        invariant j <= r && r <= 4096 && blen(buf) == 4096
      {
        if bget(buf, j) != rec_byte((at + j) / REC, (at + j) % REC) {
          ok = false;
        }
        j = j + 1;
      }
      at = at + r;
    }
  }
  f_close(fd);
  if !ok {
    return NOT_OK;
  }
  return size / REC;
}

/// Is disk/snap absent, empty, or SNAP copies of one digit?
fn check_snap(snap: &Bytes, buf: &mut Bytes) -> bool
  requires blen(snap) >= 9 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let size = f_stat(snap, 9);
  if size == NOT_OK || size == 0 {
    return true;
  }
  if size != SNAP {
    return false;
  }
  let fd = f_open(snap, 9, O_READ);
  if fd == NOT_OK {
    return false;
  }
  let r = f_read(fd, &mut buf);
  f_close(fd);
  if r != SNAP {
    return false;
  }
  let d = bget(buf, 0);
  if d < 48 || d > 57 {
    return false;
  }
  let mut j = 0;
  while j < SNAP
    invariant j <= SNAP && blen(buf) == 4096
  {
    if bget(buf, j) != d {
      return false;
    }
    j = j + 1;
  }
  return true;
}

/// Truncates disk/snap and writes SNAP copies of digit d.
fn write_snap(snap: &Bytes, buf: &mut Bytes, d: u8) -> bool
  requires blen(snap) >= 9 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let fd = f_open(snap, 9, O_WRITE + O_CREATE + O_TRUNC);
  if fd == NOT_OK {
    return false;
  }
  let mut j = 0;
  while j < SNAP
    invariant j <= SNAP && blen(buf) == 4096
  {
    bset(&mut buf, j, d);
    j = j + 1;
  }
  let w = f_write(fd, buf, SNAP);
  f_close(fd);
  return w == SNAP;
}

/// Is disk/ow in one of the states the header lists?
fn check_ow(ow: &Bytes, buf: &mut Bytes) -> bool
  requires blen(ow) >= 7 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let size = f_stat(ow, 7);
  if size == NOT_OK || size == 0 {
    return true;
  }
  if size != OW && size != OW_A {
    return false;
  }
  let fd = f_open(ow, 7, O_READ);
  if fd == NOT_OK {
    return false;
  }
  let mut at = 0;
  let mut mid = 0;
  let mut ok = true;
  while ok && at < size
    invariant blen(buf) == 4096 && at <= size && size <= OW
  {
    let r = f_read(fd, &mut buf);
    if r == 0 || r > 4096 || r > size - at {
      ok = false;
    } else {
      let mut j = 0;
      while ok && j < r
        invariant j <= r && r <= 4096 && blen(buf) == 4096
      {
        let p = at + j;
        let c = cast[u64](bget(buf, j));
        if size == OW && p >= OW_AT && p < OW_AT + OW_N {
          if p == OW_AT {
            mid = c;
          }
          if c != mid || (c != 120 && (c < 48 || c > 57)) {
            ok = false;
          }
        } else if c != 120 {
          ok = false;
        }
        j = j + 1;
      }
      at = at + r;
    }
  }
  f_close(fd);
  return ok;
}

/// Makes disk/ow afresh: OW bytes "x", in two writes.
fn make_ow(ow: &Bytes, buf: &mut Bytes) -> bool
  requires blen(ow) >= 7 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let fd = f_open(ow, 7, O_WRITE + O_CREATE + O_TRUNC);
  if fd == NOT_OK {
    return false;
  }
  let mut j = 0;
  while j < 4096
    invariant j <= 4096 && blen(buf) == 4096
  {
    bset(&mut buf, j, 120);
    j = j + 1;
  }
  let ok = f_write(fd, buf, OW_A) == OW_A && f_write(fd, buf, OW - OW_A) == OW - OW_A;
  f_close(fd);
  return ok;
}

/// Overwrites bytes OW_AT..OW_AT + OW_N of disk/ow with digit d, in one
/// write call.
fn rewrite_ow(ow: &Bytes, buf: &mut Bytes, d: u8) -> bool
  requires blen(ow) >= 7 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let fd = f_open(ow, 7, O_WRITE);
  if fd == NOT_OK {
    return false;
  }
  let mut j = 0;
  while j < OW_N
    invariant j <= OW_N && blen(buf) == 4096
  {
    bset(&mut buf, j, d);
    j = j + 1;
  }
  let ok = f_seek(fd, OW_AT) == 0 && f_write(fd, buf, OW_N) == OW_N;
  f_close(fd);
  return ok;
}

/// Is disk/tr in one of the states the header lists?
fn check_tr(tr: &Bytes, buf: &mut Bytes) -> bool
  requires blen(tr) >= 7 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let size = f_stat(tr, 7);
  if size == NOT_OK || size == 0 {
    return true;
  }
  if size != TR_SMALL && size != TR_BIG {
    return false;
  }
  let fd = f_open(tr, 7, O_READ);
  if fd == NOT_OK {
    return false;
  }
  let mut at = 0;
  let mut ok = true;
  while ok && at < size
    invariant blen(buf) == 4096 && at <= size && size <= TR_BIG
  {
    let r = f_read(fd, &mut buf);
    if r == 0 || r > 4096 || r > size - at {
      ok = false;
    } else {
      let mut j = 0;
      while ok && j < r
        invariant j <= r && r <= 4096 && blen(buf) == 4096
      {
        let c = bget(buf, j);
        if (at + j < TR_SMALL && c != 97) || (at + j >= TR_SMALL && c != 0) {
          ok = false;
        }
        j = j + 1;
      }
      at = at + r;
    }
  }
  f_close(fd);
  return ok;
}

/// Makes disk/tr if it is absent or empty, otherwise cuts it to TR_SMALL
/// or grows it to TR_BIG (when `grow`).
fn step_tr(tr: &Bytes, buf: &mut Bytes, grow: bool) -> bool
  requires blen(tr) >= 7 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let size = f_stat(tr, 7);
  if size == NOT_OK || size == 0 {
    let fd = f_open(tr, 7, O_WRITE + O_CREATE + O_TRUNC);
    if fd == NOT_OK {
      return false;
    }
    let mut j = 0;
    while j < TR_SMALL
      invariant j <= TR_SMALL && blen(buf) == 4096
    {
      bset(&mut buf, j, 97);
      j = j + 1;
    }
    let ok = f_write(fd, buf, TR_SMALL) == TR_SMALL;
    f_close(fd);
    return ok;
  }
  let fd = f_open(tr, 7, O_WRITE);
  if fd == NOT_OK {
    return false;
  }
  let mut to = TR_SMALL;
  if grow {
    to = TR_BIG;
  }
  let ok = f_truncate(fd, to) == 0;
  f_close(fd);
  return ok;
}

/// The size of names[at..at + 7], checked to be 0 or PAY bytes of c:
/// NOT_OK if absent, NOT_OK - 1 if wrong.
fn pay_size(names: &Bytes, at: u64, buf: &mut Bytes, c: u8) -> u64
  requires blen(names) == 14 && at <= 7 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let mut nm = balloc(7);
  let mut j = 0;
  while j < 7
    invariant j <= 7 && blen(nm) == 7 && blen(names) == 14 && at <= 7
  {
    bset(&mut nm, j, bget(names, at + j));
    j = j + 1;
  }
  let size = f_stat(nm, 7);
  let mut r = size;
  if size != NOT_OK && size != 0 {
    r = NOT_OK - 1;
    if size == PAY {
      let fd = f_open(nm, 7, O_READ);
      if fd != NOT_OK {
        if f_read(fd, &mut buf) == PAY {
          r = PAY;
          let mut k = 0;
          while k < PAY
            invariant k <= PAY && blen(buf) == 4096
          {
            if bget(buf, k) != c {
              r = NOT_OK - 1;
            }
            k = k + 1;
          }
        }
        f_close(fd);
      }
    }
  }
  bfree(nm);
  return r;
}

/// Writes PAY bytes of c to names[at..at + 7], making it if needed.
fn put_pay(names: &Bytes, at: u64, buf: &mut Bytes, c: u8) -> bool
  requires blen(names) == 14 && at <= 7 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let mut nm = balloc(7);
  let mut j = 0;
  while j < 7
    invariant j <= 7 && blen(nm) == 7 && blen(names) == 14 && at <= 7
  {
    bset(&mut nm, j, bget(names, at + j));
    j = j + 1;
  }
  let mut k = 0;
  while k < PAY
    invariant k <= PAY && blen(buf) == 4096
  {
    bset(&mut buf, k, c);
    k = k + 1;
  }
  let fd = f_open(nm, 7, O_WRITE + O_CREATE + O_TRUNC);
  let ok = fd != NOT_OK && f_write(fd, buf, PAY) == PAY;
  f_close(fd);
  bfree(nm);
  return ok;
}

/// Are disk/ra and disk/rb (in `rn`) as the header says? `made` once
/// the first step has finished.
fn check_ren(rn: &Bytes, buf: &mut Bytes, made: bool) -> bool
  requires blen(rn) == 14 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let a = pay_size(rn, 0, &mut buf, 82);
  let b = pay_size(rn, 7, &mut buf, 82);
  return a != NOT_OK - 1 && b != NOT_OK - 1 && (a == NOT_OK || b == NOT_OK) && (!made || a != NOT_OK || b != NOT_OK);
}

/// Renames whichever of disk/ra and disk/rb exists to the other, making
/// disk/ra if neither does (or rewriting an empty one).
fn step_ren(rn: &mut Bytes, buf: &mut Bytes) -> bool
  requires blen(rn) == 14 && blen(buf) == 4096
  ensures blen(rn) == 14 && blen(buf) == 4096
{
  let a = pay_size(rn, 0, &mut buf, 82);
  let b = pay_size(rn, 7, &mut buf, 82);
  if a == 0 || (a == NOT_OK && b == NOT_OK) {
    return put_pay(rn, 0, &mut buf, 82);
  }
  if b == 0 {
    return put_pay(rn, 7, &mut buf, 82);
  }
  if a == PAY {
    return f_rename(rn, 7, 7) == 0;
  }
  // rb to ra: swap the halves, rename, swap back.
  swap7(&mut rn);
  let ok = f_rename(rn, 7, 7) == 0;
  swap7(&mut rn);
  return ok;
}

fn swap7(x: &mut Bytes)
  requires blen(x) == 14
  ensures blen(x) == 14
{
  let mut j = 0;
  while j < 7
    invariant j <= 7 && blen(x) == 14
  {
    let c = bget(x, j);
    bset(&mut x, j, bget(x, j + 7));
    bset(&mut x, j + 7, c);
    j = j + 1;
  }
}

/// Are disk/la and disk/lb (in `ln`) as the header says? `made` once
/// the first step has finished.
fn check_links(ln: &Bytes, buf: &mut Bytes, made: bool) -> bool
  requires blen(ln) == 14 && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let a = pay_size(ln, 0, &mut buf, 76);
  let b = pay_size(ln, 7, &mut buf, 76);
  return a != NOT_OK - 1 && b != NOT_OK - 1 && (!made || a != NOT_OK || b != NOT_OK);
}

/// One step of la -> la+lb -> lb -> lb+la -> la: links the one name to
/// the other, or removes one of two (the first when `first`). Makes
/// disk/la if neither exists, and rewrites an empty one.
fn step_links(ln: &mut Bytes, buf: &mut Bytes, first: bool) -> bool
  requires blen(ln) == 14 && blen(buf) == 4096
  ensures blen(ln) == 14 && blen(buf) == 4096
{
  let a = pay_size(ln, 0, &mut buf, 76);
  let b = pay_size(ln, 7, &mut buf, 76);
  if a == 0 || (a == NOT_OK && b == NOT_OK) {
    return put_pay(ln, 0, &mut buf, 76);
  }
  if b == 0 {
    return put_pay(ln, 7, &mut buf, 76);
  }
  if a == PAY && b == PAY {
    let mut nm = balloc(7);
    let mut at = 7;
    if first {
      at = 0;
    }
    let mut j = 0;
    while j < 7
      invariant j <= 7 && blen(nm) == 7 && blen(ln) == 14 && at <= 7
    {
      bset(&mut nm, j, bget(ln, at + j));
      j = j + 1;
    }
    let ok = f_unlink(nm, 7) == 0;
    bfree(nm);
    return ok;
  }
  if a == PAY {
    return f_link(ln, 7, 7) == 0;
  }
  swap7(&mut ln);
  let ok = f_link(ln, 7, 7) == 0;
  swap7(&mut ln);
  return ok;
}

/// Sets nm, "disk/g/NNN", to name file k of disk/g.
fn g_name(nm: &mut Bytes, k: u64)
  requires blen(nm) == 10 && k < 1000
  ensures blen(nm) == 10
{
  bset(&mut nm, 7, cast[u8](48 + k / 100));
  bset(&mut nm, 8, cast[u8](48 + k / 10 % 10));
  bset(&mut nm, 9, cast[u8](48 + k % 10));
}

/// Checks disk/g as the header says. Returns 2 * the count of files, plus
/// 1 if the last is empty, or NOT_OK.
fn check_g(nm: &mut Bytes, buf: &mut Bytes) -> u64
  requires blen(nm) == 10 && blen(buf) == 4096
  ensures blen(nm) == 10 && blen(buf) == 4096
  ensures result == NOT_OK || result <= 2 * GMAX + 1
{
  let mut m = 0;
  let mut gap = false;
  let mut empty = false;
  let mut k = 0;
  while k < GMAX
    invariant k <= GMAX && m <= k && blen(nm) == 10 && blen(buf) == 4096
  {
    g_name(&mut nm, k);
    let s = f_stat(nm, 10);
    if s == NOT_OK {
      gap = true;
    } else if gap || empty {
      return NOT_OK;                    // a file past a missing or an empty one
    } else if s == 0 {
      empty = true;
      m = k + 1;
    } else {
      let fd = f_open(nm, 10, O_READ);
      let got = f_read(fd, &mut buf);
      f_close(fd);
      if s != 3 || got != 3 || bget(buf, 0) != bget(nm, 7) || bget(buf, 1) != bget(nm, 8) || bget(buf, 2) != bget(nm, 9) {
        return NOT_OK;
      }
      m = k + 1;
    }
    k = k + 1;
  }
  if empty {
    return 2 * m + 1;
  }
  return 2 * m;
}

/// Writes file k of disk/g: its three digits.
fn put_g(nm: &mut Bytes, buf: &mut Bytes, k: u64) -> bool
  requires blen(nm) == 10 && blen(buf) == 4096 && k < 1000
  ensures blen(nm) == 10 && blen(buf) == 4096
{
  g_name(&mut nm, k);
  bset(&mut buf, 0, bget(nm, 7));
  bset(&mut buf, 1, bget(nm, 8));
  bset(&mut buf, 2, bget(nm, 9));
  let fd = f_open(nm, 10, O_WRITE + O_CREATE + O_TRUNC);
  let ok = fd != NOT_OK && f_write(fd, buf, 3) == 3;
  f_close(fd);
  return ok;
}

/// Makes directory disk/mK (K = k % 10) and a file in it, after removing
/// the ones left by ten steps ago. The directory's entry and the file's
/// entry inside it wait for the same commit, which must write the
/// directory's block first: a power cut may leave the directory empty or
/// absent, never the file without its directory (fsck says "parent ... is
/// not a directory" if it does).
fn step_dir(buf: &mut Bytes, k: u64) -> bool
  requires blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let mut d = bfrom("disk/m0");
  let mut f = bfrom("disk/m0/f");
  let dg = cast[u8](48 + k % 10);
  let mut ok = blen(d) == 7 && blen(f) == 9;
  if ok {
    bset(&mut d, 6, dg);
    bset(&mut f, 6, dg);
    f_unlink(f, 9);
    f_rmdir(d, 7);
    ok = f_mkdir(d, 7) != NOT_OK;
  }
  if ok {
    let fd = f_open(f, 9, O_WRITE + O_CREATE + O_TRUNC);
    ok = fd != NOT_OK && f_write(fd, buf, 3) == 3;
    f_close(fd);
  }
  bfree(d);
  bfree(f);
  return ok;
}

fn bad(con: &Serial, what: Str) -> u64 {
  print_str(con, "crashme: bad ");
  print_str(con, what);
  print_str(con, "\r\n");
  return 1;
}

fn main(con: &mut Serial) -> u64 {
  let mut buf = balloc(4096);
  let mut rec = balloc(REC);
  let log = bfrom("disk/log");
  let snap = bfrom("disk/snap");
  let t = bfrom("disk/t");
  let ow = bfrom("disk/ow");
  let tr = bfrom("disk/tr");
  let mut rn = bfrom("disk/radisk/rb");
  let mut ln = bfrom("disk/ladisk/lb");
  let gd = bfrom("disk/g");
  let mut gn = bfrom("disk/g/000");
  let mut code = 0;
  let n = check_log(log, &mut buf);
  let gs = check_g(&mut gn, &mut buf);
  let tsize = f_stat(t, 6);
  if n == NOT_OK {
    code = bad(con, "log");
  } else if !check_snap(snap, &mut buf) {
    code = bad(con, "snap");
  } else if tsize != NOT_OK && tsize != 0 {
    code = bad(con, "t");
  } else if !check_ow(ow, &mut buf) {
    code = bad(con, "ow");
  } else if !check_tr(tr, &mut buf) {
    code = bad(con, "tr");
  } else if blen(rn) != 14 || !check_ren(rn, &mut buf, n != NOT_OK && n > 6) {
    code = bad(con, "ra/rb");
  } else if blen(ln) != 14 || !check_links(ln, &mut buf, n != NOT_OK && n > 12) {
    code = bad(con, "la/lb");
  } else if gs == NOT_OK {
    code = bad(con, "g");
  } else {
    print_str(con, "crashme: clean, ");
    print_u64(con, n);
    print_str(con, " records\r\n");
  }
  // A cut-off run may have left disk/t behind.
  f_unlink(t, 6);
  f_mkdir(gd, 6);
  let mut g = 0;
  let mut gempty = false;
  if gs != NOT_OK {
    g = gs / 2;
    gempty = gs % 2 == 1;
  }
  let mut base = 0;
  if n != NOT_OK && n <= MAX_RECS {
    base = n;
  }
  if code == 0 && f_stat(ow, 7) != OW && !make_ow(ow, &mut buf) {
    code = bad(con, "ow make");
  }
  let fd = f_open(log, 8, O_WRITE + O_CREATE + O_APPEND);
  if code == 0 && fd == NOT_OK {
    code = bad(con, "open");
  }
  let mut k = 0;
  while code == 0 && k < PER_RUN && base + k < MAX_RECS && blen(rn) == 14 && blen(ln) == 14 && blen(gn) == 10
    invariant k <= PER_RUN && blen(buf) == 4096 && blen(rec) == REC && base <= MAX_RECS && g <= GMAX
  {
    let i = base + k;
    let mut j = 0;
    while j < REC
      invariant j <= REC && blen(rec) == REC
    {
      bset(&mut rec, j, rec_byte(i, j));
      j = j + 1;
    }
    if f_write(fd, rec, REC) != REC {
      code = bad(con, "append");
    } else if i % 16 == 15 {
      if !write_snap(snap, &mut buf, cast[u8](48 + i / 16 % 10)) {
        code = bad(con, "snap write");
      }
      let tf = f_open(t, 6, O_WRITE + O_CREATE);
      f_close(tf);
      f_unlink(t, 6);
    } else if i % 16 == 7 {
      if !rewrite_ow(ow, &mut buf, cast[u8](48 + i / 16 % 10)) {
        code = bad(con, "ow write");
      }
    } else if i % 16 == 3 {
      if !step_tr(tr, &mut buf, i / 16 % 2 == 0) {
        code = bad(con, "tr step");
      }
    } else if i % 16 == 5 {
      if !step_ren(&mut rn, &mut buf) {
        code = bad(con, "rename");
      }
    } else if i % 16 == 11 {
      if !step_links(&mut ln, &mut buf, i / 32 % 2 == 0) {
        code = bad(con, "link");
      }
    }
    if code == 0 && i % 16 == 14 {
      if !step_dir(&mut buf, i / 16) {
        code = bad(con, "dir");
      }
    }
    if code == 0 && (i % 16 == 1 || i % 16 == 9 || i % 16 == 13) && g < GMAX {
      let mut gk = g;
      if gempty && g > 0 {
        gk = g - 1;                     // a cut left the last one empty
      } else {
        g = g + 1;
      }
      gempty = false;
      if !put_g(&mut gn, &mut buf, gk) {
        code = bad(con, "g write");
      }
    }
    if i % 64 == 63 {
      print_str(con, "crashme: ");
      print_u64(con, i + 1);
      print_str(con, "\r\n");
    }
    k = k + 1;
  }
  f_close(fd);
  if code == 0 {
    print_str(con, "crashme: done ");
    print_u64(con, base + k);
    print_str(con, "\r\n");
  }
  bfree(buf);
  bfree(rec);
  bfree(log);
  bfree(snap);
  bfree(t);
  bfree(ow);
  bfree(tr);
  bfree(rn);
  bfree(ln);
  bfree(gd);
  bfree(gn);
  return code;
}
