// Exercises the file system calls: writing and reading back a file that
// spans several pages, seeking, appending, a hole that reads as zeros,
// removing, running out of descriptors, descriptors that are not open, and
// offsets past 3 MiB, and truncating to a length.
// It runs once on the disk ("disk/big", if there is a disk) and once in
// memory ("big"), and ends by leaving "big" open, to show that exiting
// closes it. Prints "fstest: ok", or the step that failed (also the exit
// code; 20 is added for the disk run).

import "lib/file.bastio";

fn puts(con: &Serial, s: Str) {
  let mut i = 0;
  while i < slen(s)
    invariant i <= slen(s)
  {
    serial_write(con, sget(s, i));
    i = i + 1;
  }
}

fn put_num(con: &Serial, n: u64) {
  let mut p = 1;
  while p <= n / 10
    invariant p >= 1
  {
    p = p * 10;
  }
  let mut q = p;
  while q > 0 {
    serial_write(con, cast[u8](48 + (n / q) % 10));
    q = q / 10;
  }
}

fn fail(con: &Serial, step: u64) -> u64 {
  puts(con, "fstest: step ");
  put_num(con, step);
  puts(con, " failed\r\n");
  return step;
}

const BIG: u64 = 10000;

/// Byte i of the test file.
fn pat(i: u64) -> u64
  ensures result <= 255
{
  return (i % 251 * 7 + 3) % 251;
}

fn smaller(a: u64, b: u64) -> u64
  ensures result <= a && result <= b
{
  if a < b {
    return a;
  }
  return b;
}

/// Writes BIG bytes of the pattern to fd. Returns false on a short write.
fn write_big(fd: u64, buf: &mut Bytes) -> bool
  requires blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let mut done = 0;
  while done < BIG
    invariant blen(buf) == 4096
  {
    let m = smaller(BIG - done, 4096);
    let mut j = 0;
    while j < m
      invariant j <= m && blen(buf) == 4096
    {
      bset(&mut buf, j, cast[u8](pat(done + j)));
      j = j + 1;
    }
    if f_write(fd, buf, m) != m {
      return false;
    }
    done = done + m;
  }
  return true;
}

/// Reads fd to its end, checking every byte against the pattern from
/// offset `from`. Returns the count read, or NOT_OK on a wrong byte.
fn read_check(fd: u64, buf: &mut Bytes, from: u64) -> u64
  requires blen(buf) == 4096 && from <= BIG
  ensures blen(buf) == 4096
{
  let mut total = 0;
  let mut more = true;
  while more && total <= BIG
    invariant blen(buf) == 4096
  {
    let r = f_read(fd, &mut buf);
    if r == 0 {
      more = false;
    } else if r > 4096 {
      return NOT_OK;
    } else {
      let mut j = 0;
      while j < r
        invariant j <= r && r <= 4096 && blen(buf) == 4096
      {
        if cast[u64](bget(buf, j)) != pat(from + total + j) {
          return NOT_OK;
        }
        j = j + 1;
      }
      total = total + r;
    }
  }
  return total;
}

const AT1: u64 = 2097052;              // 2 MiB - 100
const AT2: u64 = 3149728;              // 3 MiB + 4000

/// Writes m bytes of the pattern at `at` through fd.
fn write_at(fd: u64, buf: &mut Bytes, at: u64, m: u64) -> bool
  requires blen(buf) == 4096 && m <= 4096 && at <= 1073741824
  ensures blen(buf) == 4096
{
  let mut j = 0;
  while j < m
    invariant j <= m && blen(buf) == 4096
  {
    bset(&mut buf, j, cast[u8](pat(at + j)));
    j = j + 1;
  }
  return f_seek(fd, at) == 0 && f_write(fd, buf, m) == m;
}

/// Reads m bytes at `at` through fd: the pattern, or zeros if `hole`.
fn check_at(fd: u64, buf: &mut Bytes, at: u64, m: u64, hole: bool) -> bool
  requires blen(buf) == 4096 && m <= 4096 && at <= 1073741824
  ensures blen(buf) == 4096
{
  if f_seek(fd, at) != 0 || f_read(fd, &mut buf) < m {
    return false;
  }
  let mut j = 0;
  while j < m
    invariant j <= m && blen(buf) == 4096
  {
    let mut want = 0;
    if !hole {
      want = pat(at + j);
    }
    if cast[u64](bget(buf, j)) != want {
      return false;
    }
    j = j + 1;
  }
  return true;
}

/// Steps 15 and 16. Returns 0 or the step that failed.
fn large(big: &Bytes, nl: u64, buf: &mut Bytes) -> u64
  requires nl <= blen(big) && blen(buf) == 4096
  ensures blen(buf) == 4096 && result <= 16
{
  let fd = f_open(big, nl, O_WRITE + O_CREATE + O_TRUNC);
  let ok = fd != NOT_OK && write_at(fd, &mut buf, AT1, 200) && write_at(fd, &mut buf, AT2, 4096);
  f_close(fd);
  if !ok || f_stat(big, nl) != AT2 + 4096 {
    return 15;
  }
  let rd = f_open(big, nl, O_READ);
  let good = rd != NOT_OK && check_at(rd, &mut buf, AT1, 200, false) && check_at(rd, &mut buf, AT2, 4096, false)
    && check_at(rd, &mut buf, 1048576, 4096, true) && check_at(rd, &mut buf, AT1 - 4096, 4096, true);
  f_close(rd);
  if !good {
    return 16;
  }
  return 0;
}

/// Step 17: truncating the file from step 15 (AT2 + 4096 bytes) to just
/// past AT1 and growing it back: the cut bytes and blocks read as zeros.
fn resize(big: &Bytes, nl: u64, buf: &mut Bytes) -> bool
  requires nl <= blen(big) && blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let rd = f_open(big, nl, O_READ);
  let refused = f_truncate(rd, 0) == NOT_OK;
  f_close(rd);
  let fd = f_open(big, nl, O_READ + O_WRITE);
  let ok = refused && fd != NOT_OK && f_truncate(fd, AT1 + 50) == 0 && f_stat(big, nl) == AT1 + 50
    && check_at(fd, &mut buf, AT1, 50, false) && f_read(fd, &mut buf) == 0
    && f_truncate(fd, AT2 + 4096) == 0 && f_stat(big, nl) == AT2 + 4096
    && check_at(fd, &mut buf, AT1 + 50, 150, true) && check_at(fd, &mut buf, AT2, 4096, true)
    && check_at(fd, &mut buf, AT1, 50, false);
  f_close(fd);
  return ok;
}

/// Runs every step on the file named by the first nl bytes of `big`.
/// Returns 0, or the step that failed.
fn run(big: &Bytes, nl: u64, buf: &mut Bytes, keep_open: bool) -> u64
  requires nl <= blen(big) && blen(buf) == 4096
  ensures blen(buf) == 4096 && result <= 17
{
  let mut step = 0;

  // 1-2. Create the file and write BIG bytes, more than two pages.
  let fd = f_open(big, nl, O_WRITE + O_CREATE + O_TRUNC);
  if fd == NOT_OK {
    step = 1;
  } else if !write_big(fd, &mut buf) {
    step = 2;
  }
  f_close(fd);
  // 3. Its size.
  if step == 0 && f_stat(big, nl) != BIG {
    step = 3;
  }
  // 4. Read it all back.
  let rd = f_open(big, nl, O_READ);
  if step == 0 && read_check(rd, &mut buf, 0) != BIG {
    step = 4;
  }
  // 5. Seek into the second page and read from there.
  if step == 0 && (f_seek(rd, 5000) != 0 || read_check(rd, &mut buf, 5000) != BIG - 5000) {
    step = 5;
  }
  // 6. A descriptor opened for reading cannot write.
  if step == 0 && f_write(rd, buf, 1) != NOT_OK {
    step = 6;
  }
  // 7. A second descriptor reads the same bytes (step 11 removes the
  // file while one is open).
  let rd2 = f_open(big, nl, O_READ);
  if step == 0 && read_check(rd2, &mut buf, 0) != BIG {
    step = 7;
  }
  f_close(rd2);
  f_close(rd);
  // 8. Appending lands at the end, wherever the offset is.
  let ap = f_open(big, nl, O_WRITE + O_APPEND);
  bset(&mut buf, 0, 33);
  if step == 0 && (f_write(ap, buf, 1) != 1 || f_stat(big, nl) != BIG + 1) {
    step = 8;
  }
  f_close(ap);
  // 9. Writing past the end leaves a hole that reads as zeros.
  let wr = f_open(big, nl, O_WRITE);
  f_seek(wr, 20000);
  if step == 0 && (f_write(wr, buf, 1) != 1 || f_stat(big, nl) != 20001) {
    step = 9;
  }
  f_close(wr);
  let ho = f_open(big, nl, O_READ);
  f_seek(ho, 15000);
  let r = f_read(ho, &mut buf);
  if step == 0 && (r != 4096 || bget(buf, 0) != 0 || bget(buf, 4095) != 0) {
    step = 10;
  }
  f_close(ho);
  // 11. Removing it while it is open: the name is gone at once, and the
  // open descriptor still reads the data until it is closed (as on Linux).
  let op = f_open(big, nl, O_READ);
  if step == 0 && (f_unlink(big, nl) != 0 || f_stat(big, nl) != NOT_OK || f_open(big, nl, O_READ) != NOT_OK) {
    step = 11;
  }
  if step == 0 && (f_read(op, &mut buf) != 4096 || cast[u64](bget(buf, 0)) != pat(0)) {
    step = 11;
  }
  f_close(op);
  // 12. Eight descriptors per process, then no more.
  let mut i = 0;
  let mut opened = 0;
  while i < 9
    invariant i <= 9 && opened <= i
  {
    if f_open(big, nl, O_WRITE + O_CREATE) != NOT_OK {
      opened = opened + 1;
    }
    i = i + 1;
  }
  if step == 0 && opened != 8 {
    step = 12;
  }
  i = 0;
  while i < 8 {
    f_close(i);
    i = i + 1;
  }
  // 13. Descriptors that are not open.
  if step == 0 && (f_close(3) != NOT_OK || f_read(3, &mut buf) != NOT_OK || f_close(99) != NOT_OK) {
    step = 13;
  }
  f_unlink(big, nl);
  // 15-16. Large offsets: across the 2 MiB mark (a second map block on the
  // disk) and past 3 MiB, with a hole in between that reads as zeros.
  if step == 0 {
    step = large(big, nl, &mut buf);
  }
  if step == 0 && !resize(big, nl, &mut buf) {
    step = 17;
  }
  f_unlink(big, nl);
  // 14. Leave the file open for writing: exiting must close it, so the
  // shell can remove it afterwards.
  if step == 0 && keep_open && f_open(big, nl, O_WRITE + O_CREATE) == NOT_OK {
    step = 14;
  }
  return step;
}

fn main(con: &mut Serial) -> u64 {
  let mut buf = balloc(4096);
  // On the disk first (when there is one), then in memory.
  let disk = bfrom("disk/big");
  let mut step = 0;
  let probe = f_open(disk, 8, O_WRITE + O_CREATE);
  if probe != NOT_OK {
    f_close(probe);
    step = run(disk, 8, &mut buf, false);
    if step != 0 {
      step = step + 20;
    } else {
      puts(con, "fstest: disk ok\r\n");
    }
  }
  bfree(disk);
  let big = bfrom("big");
  if step == 0 {
    step = run(big, 3, &mut buf, true);
  }
  bfree(big);
  bfree(buf);
  if step != 0 {
    return fail(con, step);
  }
  puts(con, "fstest: ok\r\n");
  return 0;
}
