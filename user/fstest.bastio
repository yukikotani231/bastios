// Exercises the file system calls: writing and reading back a file that
// spans several pages, seeking, appending, a hole that reads as zeros,
// removing, running out of descriptors, and descriptors that are not open.
// It ends by leaving a file open, to show that exiting closes it. Prints
// "fstest: ok", or the step that failed (also the exit code).

import "lib/file.bastio";

fn puts(con: &Serial, s: Str) {
  let mut i = 0;
  while i < slen(s)
    invariant i <= slen(s)
  {
    serial_write(con, sget(s, i));
    i = i + 1;
  }
}

fn put_num(con: &Serial, n: u64) {
  let mut p = 1;
  while p <= n / 10
    invariant p >= 1
  {
    p = p * 10;
  }
  let mut q = p;
  while q > 0 {
    serial_write(con, 48 + (n / q) % 10);
    q = q / 10;
  }
}

fn fail(con: &Serial, step: u64) -> u64 {
  puts(con, "fstest: step ");
  put_num(con, step);
  puts(con, " failed\r\n");
  return step;
}

const BIG: u64 = 10000;

/// Byte i of the test file.
fn pat(i: u64) -> u64
  ensures result <= 255
{
  return (i % 251 * 7 + 3) % 251;
}

fn smaller(a: u64, b: u64) -> u64
  ensures result <= a && result <= b
{
  if a < b {
    return a;
  }
  return b;
}

/// Writes BIG bytes of the pattern to fd. Returns false on a short write.
fn write_big(fd: u64, buf: &mut Bytes) -> bool
  requires blen(buf) == 4096
  ensures blen(buf) == 4096
{
  let mut done = 0;
  while done < BIG
    invariant blen(buf) == 4096
  {
    let m = smaller(BIG - done, 4096);
    let mut j = 0;
    while j < m
      invariant j <= m && blen(buf) == 4096
    {
      bset(&mut buf, j, pat(done + j));
      j = j + 1;
    }
    if f_write(fd, buf, m) != m {
      return false;
    }
    done = done + m;
  }
  return true;
}

/// Reads fd to its end, checking every byte against the pattern from
/// offset `from`. Returns the count read, or NOT_OK on a wrong byte.
fn read_check(fd: u64, buf: &mut Bytes, from: u64) -> u64
  requires blen(buf) == 4096 && from <= BIG
  ensures blen(buf) == 4096
{
  let mut total = 0;
  let mut more = true;
  while more && total <= BIG
    invariant blen(buf) == 4096
  {
    let r = f_read(fd, &mut buf);
    if r == 0 {
      more = false;
    } else if r > 4096 {
      return NOT_OK;
    } else {
      let mut j = 0;
      while j < r
        invariant j <= r && r <= 4096 && blen(buf) == 4096
      {
        if bget(buf, j) != pat(from + total + j) {
          return NOT_OK;
        }
        j = j + 1;
      }
      total = total + r;
    }
  }
  return total;
}

fn main(con: &mut Serial) -> u64 {
  let big = bfrom("big");
  let mut buf = balloc(4096);
  let mut step = 0;

  // 1-2. Create the file and write BIG bytes, more than two pages.
  let fd = f_open(big, 3, O_WRITE + O_CREATE + O_TRUNC);
  if fd == NOT_OK {
    step = 1;
  } else if !write_big(fd, &mut buf) {
    step = 2;
  }
  f_close(fd);
  // 3. Its size.
  if step == 0 && f_stat(big, 3) != BIG {
    step = 3;
  }
  // 4. Read it all back.
  let rd = f_open(big, 3, O_READ);
  if step == 0 && read_check(rd, &mut buf, 0) != BIG {
    step = 4;
  }
  // 5. Seek into the second page and read from there.
  if step == 0 && (f_seek(rd, 5000) != 0 || read_check(rd, &mut buf, 5000) != BIG - 5000) {
    step = 5;
  }
  // 6. A descriptor opened for reading cannot write.
  if step == 0 && f_write(rd, buf, 1) != NOT_OK {
    step = 6;
  }
  // 7. A file that is open cannot be removed.
  if step == 0 && f_unlink(big, 3) != NOT_OK {
    step = 7;
  }
  f_close(rd);
  // 8. Appending lands at the end, wherever the offset is.
  let ap = f_open(big, 3, O_WRITE + O_APPEND);
  bset(&mut buf, 0, 33);
  if step == 0 && (f_write(ap, buf, 1) != 1 || f_stat(big, 3) != BIG + 1) {
    step = 8;
  }
  f_close(ap);
  // 9. Writing past the end leaves a hole that reads as zeros.
  let wr = f_open(big, 3, O_WRITE);
  f_seek(wr, 20000);
  if step == 0 && (f_write(wr, buf, 1) != 1 || f_stat(big, 3) != 20001) {
    step = 9;
  }
  f_close(wr);
  let ho = f_open(big, 3, O_READ);
  f_seek(ho, 15000);
  let r = f_read(ho, &mut buf);
  if step == 0 && (r != 4096 || bget(buf, 0) != 0 || bget(buf, 4095) != 0) {
    step = 10;
  }
  f_close(ho);
  // 11. Removing it; then it is gone.
  if step == 0 && (f_unlink(big, 3) != 0 || f_stat(big, 3) != NOT_OK || f_open(big, 3, O_READ) != NOT_OK) {
    step = 11;
  }
  // 12. Eight descriptors per process, then no more.
  let mut i = 0;
  let mut opened = 0;
  while i < 9
    invariant i <= 9 && opened <= i
  {
    if f_open(big, 3, O_WRITE + O_CREATE) != NOT_OK {
      opened = opened + 1;
    }
    i = i + 1;
  }
  if step == 0 && opened != 8 {
    step = 12;
  }
  i = 0;
  while i < 8 {
    f_close(i);
    i = i + 1;
  }
  // 13. Descriptors that are not open.
  if step == 0 && (f_close(3) != NOT_OK || f_read(3, &mut buf) != NOT_OK || f_close(99) != NOT_OK) {
    step = 13;
  }
  f_unlink(big, 3);
  // 14. Leave "big" open for writing: exiting must close it, so the shell
  // can remove it afterwards.
  if step == 0 && f_open(big, 3, O_WRITE + O_CREATE) == NOT_OK {
    step = 14;
  }
  bfree(buf);
  bfree(big);
  if step != 0 {
    return fail(con, step);
  }
  puts(con, "fstest: ok\r\n");
  return 0;
}
